  system
  all
)

domain_description() {
  case "$1" in
    fast) printf "Common non-system suite" ;;
    bookings) printf "Public/manual booking + lifecycle" ;;
    hotel_management) printf "Profile, rooms, staff, roles, corporate, plans, knowledge" ;;
    hotel_operations) printf "Business date, night audit, inventory, room status, requests" ;;
    financials) printf "Folios, taxes, transaction codes, GL, journal batches" ;;
    payments) printf "Gateways, refunds, deposits, payouts" ;;
    reports) printf "Hotel reports and exports" ;;
    hotel_concierge) printf "QR concierge, pre-checkin, guest requests" ;;
    ai_concierge) printf "AI agents, tools, knowledge search" ;;
    channels) printf "Channex and channel manager sync" ;;
    guest_portal) printf "Guest login, dashboard, refunds, search" ;;
    admin_platform) printf "Superadmin and platform controls" ;;
    system) printf "Browser/system specs" ;;
    all) printf "Full suite" ;;
  esac
}

