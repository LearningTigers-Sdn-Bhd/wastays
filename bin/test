      ;;
    hotel_management)
      printf "%s\n" profile settings room_types knowledge staff roles corporate policies system
      ;;
    hotel_operations)
      printf "%s\n" business_dates night_audits rooms inventory requests notifications arrivals system
      ;;
    financials)
      printf "%s\n" folios transactions taxes_fees codes gl_maps journals controls deposits models
      ;;
    payments)
      printf "%s\n" gateways verification webhooks refunds payouts deposits settings models
      ;;
    reports)
      printf "%s\n" hotel_reports exports booking_exports folio_ledger pdfs requests
      ;;
    hotel_concierge)
      printf "%s\n" qr_concierge pre_checkin check_in check_out guest_requests lookup
      ;;
    ai_concierge)
      printf "%s\n" agents orchestration tools matching knowledge api jobs
      ;;
    channels)
      printf "%s\n" channel_managers channex webhooks ari_sync jobs
      ;;
    guest_portal)
      printf "%s\n" sessions dashboard bookings refunds search guest_models system
      ;;
    admin_platform)
      printf "%s\n" dashboard hotels plans margins payouts refunds integrations api_keys system
      ;;
    system)
      printf "%s\n" admin guest hotel public
      ;;
    all)
      printf "%s\n" full_suite
      ;;
  esac
}

parallel_process_count() {
  if [[ -n "${PARALLEL_TEST_PROCESSORS:-}" ]]; then
    printf "%s" "$PARALLEL_TEST_PROCESSORS"
  else
    ruby -retc -e 'print Etc.nprocessors' 2>/dev/null || printf "auto"
  fi
}

runtime_log_path() {
  printf "tmp/parallel_runtime_rspec_%s.log" "$1"
}

# Headless Chrome is far heavier per-process than a plain RSpec worker, so
# running one Cuprite/Chrome instance per CPU core saturates the machine and
# produces flaky Ferrum timeouts. Halve the worker count whenever the run
# includes spec/system, unless the caller explicitly pins a count.
worker_count_for_paths() {
  local base_count
  base_count=$(parallel_process_count)

  if [[ -n "${PARALLEL_TEST_PROCESSORS:-}" ]]; then
    printf "%s" "$base_count"
    return
  fi

  local path
  for path in "$@"; do
    if [[ "$path" == spec/system* ]]; then
      local half=$(( base_count / 2 ))
      (( half < 2 )) && half=2
      printf "%s" "$half"
      return
    fi
  done

  printf "%s" "$base_count"
}

runtime_group_by() {
  local domain="$1"

  if [[ -s "$(runtime_log_path "$domain")" ]]; then
    printf "runtime"
  else
    printf "filesize"
  fi
}

balance_label() {
  local group_by="$1"

  if [[ "$group_by" == "runtime" ]]; then
    printf "runtime log"
  else
    printf "filesize fallback"
  fi
}

print_kv() {
  local key="$1"
  local value="$2"

  printf "${BOLD}${BLUE}│${RESET} ${DIM}%-11s${RESET} %s\n" "$key" "$value"
}

print_run_card() {
  local icon="$1"
  local domain="$2"
  local mode="$3"
  local group_by="${4:-}"
  local target="${5:-}"
  local worker_count="${6:-}"

  printf "\n${BOLD}${CYAN}╭─ %s WASTAYS TEST RUN ─────────────────────────────${RESET}\n" "$icon"
  if [[ -n "$domain" ]]; then
    print_kv "Domain" "${BOLD}${domain}${RESET}"
    print_kv "Suite" "$(domain_description "$domain")"
  fi
  print_kv "Mode" "$mode"
  if [[ "$mode" == "parallel" ]]; then
    print_kv "Processes" "${worker_count:-$(parallel_process_count)}"
    print_kv "Balance" "$(balance_label "$group_by")"
  fi
  if [[ -n "$target" ]]; then
    print_kv "Target" "$target"
  fi
  printf "${BOLD}${CYAN}╰───────────────────────────────────────────────────${RESET}\n"
}

print_groups_card() {
  local domain="$1"
  local labels=()
  local label
  local count=0

  while IFS= read -r label; do
    labels+=("$label")
  done < <(domain_group_labels "$domain")

  printf "\n${BOLD}${CYAN}╭─ 📦 Spec Groups ──────────────────────────────────${RESET}\n"
  for label in "${labels[@]}"; do
    if (( count % 3 == 0 )); then
      printf "${BOLD}${BLUE}│${RESET} "
    fi

    printf "%-17s" "$label"
    count=$((count + 1))

    if (( count % 3 == 0 )); then
      printf "\n"
    fi
  done

  if (( count % 3 != 0 )); then
    printf "\n"
  fi
  printf "${BOLD}${CYAN}╰───────────────────────────────────────────────────${RESET}\n\n"
}

now_seconds() {
  date +%s
}

format_duration() {
  local seconds="$1"
  local minutes

  if (( seconds < 60 )); then
    printf "%ss" "$seconds"
  else
    minutes=$((seconds / 60))
    seconds=$((seconds % 60))
    printf "%sm %ss" "$minutes" "$seconds"
  fi
}

failure_count() {
  local output_file="$1"

  BOLD="$BOLD" BLUE="$BLUE" CYAN="$CYAN" RESET="$RESET" ruby -e '
    text = File.read(ARGV.fetch(0), encoding: "UTF-8").scrub
    matches = text.scan(/(\d+)\s+failures?/)
    errors = text.scan(/(\d+)\s+errors? occurred outside of examples/)
    if !errors.empty? && errors.last.first.to_i > 0
      print("#{matches.empty? ? 0 : matches.last.first} failure(s), #{errors.last.first} error(s)")
    else
      print(matches.empty? ? "unknown" : matches.last.first)
    end
  ' "$output_file"
}

print_result_card() {
  local status="$1"
  local started_at="$2"
  local finished_at="$3"
  local domain="$4"
  local mode="$5"
  local group_by="$6"
  local runtime_log="$7"
  local target="$8"
  local output_file="$9"
  local icon="🏁"
  local status_label="${BOLD}${GREEN}PASSED${RESET}"
  local duration
  local failures

  duration=$(format_duration $((finished_at - started_at)))

  if (( status != 0 )); then
    icon="💥"
    status_label="${BOLD}${YELLOW}FAILED${RESET}"
  fi

  printf "\n${BOLD}${CYAN}╭─ %s TEST RESULT ──────────────────────────────────${RESET}\n" "$icon"
  if [[ -n "$domain" ]]; then
    print_kv "Domain" "${BOLD}${domain}${RESET}"
  fi
  print_kv "Mode" "$mode"
  print_kv "Status" "$status_label"
  if (( status != 0 )); then
    print_kv "Exit Code" "$status"
    failures=$(failure_count "$output_file")
    print_kv "Failed" "$failures"
  fi
  print_kv "Duration" "$duration"
  if [[ "$mode" == "parallel" ]]; then
    print_kv "Balance" "$(balance_label "$group_by")"
    print_kv "Runtime Log" "$runtime_log"
  fi
  if [[ -n "$target" ]]; then
    print_kv "Target" "$target"
  fi
  printf "${BOLD}${CYAN}╰───────────────────────────────────────────────────${RESET}\n"
}

print_failure_digest() {
  local output_file="$1"
  local digest

  # Ruby parses the RSpec log into plain ASCII-safe rows; all decorative
  # box drawing stays in bash printf below so the Ruby source needs no
  # non-ASCII characters (which fail to parse under a non-UTF-8 locale).
  digest=$(ruby -e '
    text = File.read(ARGV.fetch(0), encoding: "UTF-8").scrub
    blocks = text.split(/^\s*(?=\d+\)\s)/).select { |block| block.match?(/^\s*\d+\)\s/) }
    failures = blocks.map do |block|
      number, title = block.match(/^\s*(\d+)\)\s+(.+)$/)&.captures
      next unless number

      location = block[/# \.\/(spec\/[^:\n]+_spec\.rb:\d+)/, 1] ||
        block[/\.\/(spec\/[^:\n]+_spec\.rb:\d+)/, 1] ||
        block[/(spec\/[^:\n]+_spec\.rb:\d+)/, 1]

      error = nil
      lines = block.lines.map(&:rstrip)
      lines.each_with_index do |line, index|
        if line =~ /^\s*Failure\/Error:\s*(.*)$/
          error = Regexp.last_match(1).strip
          ((index + 1)...lines.length).each do |next_index|
            candidate = lines[next_index].strip
            next if candidate.empty? || candidate.start_with?("#")
            error = candidate
            break
          end
          break
        end
      end

      error ||= lines.find do |line|
        stripped = line.strip
        !stripped.empty? &&
          stripped !~ /^\d+\)/ &&
          !stripped.start_with?("#") &&
          stripped !~ /^Finished in / &&
          stripped !~ /^Failed examples:/
      end&.strip

      {
        number: number,
        title: title.strip,
        location: location,
        error: error
      }
    end.compact

    if failures.empty?
      location = text[/An error occurred while loading \.\/(spec\/[^\n]+_spec\.rb)/, 1]
      error_type, error_message = text.match(/\n([A-Za-z:]+Error):\n\s+([^\n]+)/)&.captures
      if location || error_message
        failures << {
          number: "1",
          title: location || "Error outside examples",
          location: location,
          error: [error_type, error_message].compact.join(": ")
        }
      end
    end

    if failures.empty?
      puts "Failure details could not be summarized."
      puts "See RSpec output above."
    else
      failures.first(5).each_with_index do |failure, index|
        location = failure[:location] || failure[:title]
        error = failure[:error] || "See RSpec output above."
        location = location.length > 47 ? "#{location[0, 44]}..." : location
        error = error.length > 47 ? "#{error[0, 44]}..." : error
        puts "#{index + 1}. #{location}"
        puts "   #{error}"
      end
      puts "... #{failures.length - 5} more failure(s) in RSpec output above" if failures.length > 5
    end
  ' "$output_file")

  printf "${BOLD}${CYAN}╭─ 🔎 Failures ─────────────────────────────────────${RESET}\n"
  while IFS= read -r line; do
    printf "${BOLD}${BLUE}│${RESET} %s\n" "$line"
  done <<< "$digest"
  printf "${BOLD}${CYAN}╰───────────────────────────────────────────────────${RESET}\n"
}

run_and_report() {
  local domain="$1"
  local mode="$2"
  local group_by="$3"
  local runtime_log="$4"
  local target="$5"
  shift 5

  local output_file
  local started_at
  local finished_at
  local status

  output_file=$(mktemp)
  started_at=$(now_seconds)

  set +e
  BOLD="$BOLD" BLUE="$BLUE" CYAN="$CYAN" RESET="$RESET" "$@" 2>&1 | tee "$output_file"
  status=${PIPESTATUS[0]}
  set -e

  finished_at=$(now_seconds)
  print_result_card "$status" "$started_at" "$finished_at" "$domain" "$mode" "$group_by" "$runtime_log" "$target" "$output_file"

  if (( status != 0 )); then
    print_failure_digest "$output_file"
  fi

  rm -f "$output_file"
  return "$status"
}

usage() {
  cat <<USAGE
Usage: bin/test [domain] [--serial] [rspec options]
       bin/test --menu
       bin/test --list
       bin/test spec/path/to/example_spec.rb[:line] [rspec options]

Default domain: fast

Domains:
USAGE
  list_domains
}

list_domains() {
  local index=1
  local domain

  for domain in "${DOMAINS[@]}"; do
    printf "  %2d. %s ${BOLD}%-17s${RESET} %s\n" "$index" "$(domain_icon "$domain")" "$domain" "$(domain_description "$domain")"
    index=$((index + 1))
  done
}

print_domain_grid() {
  local index=1
  local domain

  printf "${BOLD}${CYAN}╭─ 🕹️  Test Domains${RESET}\n"
  for domain in "${DOMAINS[@]}"; do
    print_domain_card "$index" "$domain"
    index=$((index + 1))
  done
  printf "${BOLD}${CYAN}└────────────────────────────────────────────────────────────────────${RESET}\n"
}

print_domain_paths() {
  local domain="$1"
  local path

  printf "${BOLD}%s${RESET} ${DIM}%s${RESET}\n" "$domain" "$(domain_description "$domain")"
  while IFS= read -r path; do
    [[ -e "$path" ]] && printf "  %s\n" "$path"
  done < <(domain_paths "$domain")
}

known_domain() {
  local domain

  for domain in "${DOMAINS[@]}"; do
    [[ "$domain" == "$1" ]] && return 0
  done

  return 1
}

select_domain() {
  local choice
  local count="${#DOMAINS[@]}"

  print_banner >&2
  print_domain_grid >&2
  printf "\n${BOLD}${CYAN}▶${RESET} Domain ${DIM}[1-%d, name, default fast]${RESET}: " "$count" >&2
  read -r choice

  if [[ -z "$choice" ]]; then
    printf "fast\n"
    return
  fi

  if [[ "$choice" =~ ^[0-9]+$ ]] && (( choice >= 1 && choice <= count )); then
    printf "%s\n" "${DOMAINS[choice - 1]}"
    return
  fi

  if known_domain "$choice"; then
    printf "%s\n" "$choice"
    return
  fi

  printf "Unknown selection: %s\n" "$choice" >&2
  exit 1
}

existing_domain_paths() {
  local domain="$1"
  local path
  local found=0

  while IFS= read -r path; do
    if [[ -e "$path" ]]; then
      printf "%s\n" "$path"
      found=1
    fi
  done < <(domain_paths "$domain")

  if (( found == 0 )); then
    printf "No spec paths found for domain: %s\n" "$domain" >&2
    exit 1
  fi
}

looks_like_spec_target() {
  [[ "$1" == spec/* || "$1" == ./*spec/* || "$1" == /*spec/* || "$1" == *_spec.rb* ]]
}

run_serial() {
  local target="${1:-selected specs}"

  print_run_card "🎯" "" "serial" "" "$target"
  run_and_report "" "serial" "" "" "$target" bundle exec rspec "$@"
}

run_parallel() {
  local domain="$1"
  shift
  local group_by
  local runtime_log

  local paths=()
  local path

  while IFS= read -r path; do
    paths+=("$path")
  done < <(existing_domain_paths "$domain")

  runtime_log=$(runtime_log_path "$domain")
  group_by=$(runtime_group_by "$domain")

  local worker_count
  worker_count=$(worker_count_for_paths "${paths[@]}")

  mkdir -p tmp

  print_run_card "$(domain_icon "$domain")" "$domain" "parallel" "$group_by" "" "$worker_count"
  print_groups_card "$domain"

  if (( $# > 0 )); then
    run_and_report "$domain" "parallel" "$group_by" "$runtime_log" "" \
      bundle exec parallel_rspec \
      -n "$worker_count" \
      --runtime-log "$runtime_log" \
      --group-by "$group_by" \
      --allowed-missing 100 \
      -- \
      --format progress \
      --format ParallelTests::RSpec::RuntimeLogger \
      --out "$runtime_log" \
      "$@" \
      -- \
      "${paths[@]}"
  else
    run_and_report "$domain" "parallel" "$group_by" "$runtime_log" "" \
      bundle exec parallel_rspec \
      -n "$worker_count" \
      --runtime-log "$runtime_log" \
      --group-by "$group_by" \
      --allowed-missing 100 \
      -- \
      --format progress \
      --format ParallelTests::RSpec::RuntimeLogger \
      --out "$runtime_log" \
      -- \
      "${paths[@]}"
  fi
}

domain=fast
serial=0
menu=0
print_list=0
print_paths=0
rspec_args=()

while (( $# > 0 )); do
  case "$1" in
    --help|-h)
      usage
      exit 0
      ;;
    --list)
      print_list=1
      shift
      ;;
    --paths)
      print_paths=1
      shift
      ;;
    --menu)
      menu=1
      shift
      ;;
    --serial)
      serial=1
      shift
      ;;
    --)
      shift
      while (( $# > 0 )); do
        rspec_args+=("$1")
        shift
      done
      ;;
    *)
      if known_domain "$1"; then
        domain="$1"
      else
        rspec_args+=("$1")
      fi
      shift
      ;;
  esac
done

if (( print_list )); then
  list_domains
  exit 0
fi

if (( menu )); then
  domain=$(select_domain)
fi

if (( print_paths )); then
  print_domain_paths "$domain"
  exit 0
fi

if (( ${#rspec_args[@]} > 0 )) && looks_like_spec_target "${rspec_args[0]}"; then
  run_serial "${rspec_args[@]}"
elif (( serial )); then
  paths=()
  while IFS= read -r path; do
    paths+=("$path")
  done < <(existing_domain_paths "$domain")
  if (( ${#rspec_args[@]} > 0 )); then
    run_serial "${paths[@]}" "${rspec_args[@]}"
  else
    run_serial "${paths[@]}"
  fi
else
  if (( ${#rspec_args[@]} > 0 )); then
    run_parallel "$domain" "${rspec_args[@]}"
  else
    run_parallel "$domain"
  fi
fi
