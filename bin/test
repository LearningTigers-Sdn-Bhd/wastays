    ai_concierge) printf "🤖" ;;
    channels) printf "🔌" ;;
    guest_portal) printf "🧳" ;;
    admin_platform) printf "👑" ;;
    system) printf "🖥️" ;;
    all) printf "🌐" ;;
  esac
}

print_banner() {
  printf "\n${BOLD}${MAGENTA}█╗    ██╗ █████╗ ███████╗████████╗ █████╗ ██╗   ██╗███████╗${RESET}\n"
  printf "${BOLD}${MAGENTA}██║    ██║██╔══██╗██╔════╝╚══██╔══╝██╔══██╗╚██╗ ██╔╝██╔════╝${RESET}\n"
  printf "${BOLD}${MAGENTA}██║ █╗ ██║███████║███████╗   ██║   ███████║ ╚████╔╝ ███████╗${RESET}\n"
  printf "${BOLD}${MAGENTA}██║███╗██║██╔══██║╚════██║   ██║   ██╔══██║  ╚██╔╝  ╚════██║${RESET}\n"
  printf "${BOLD}${MAGENTA}╚███╔███╔╝██║  ██║███████║   ██║   ██║  ██║   ██║   ███████║${RESET}\n"
  printf "${BOLD}${MAGENTA} ╚══╝╚══╝ ╚═╝  ╚═╝╚══════╝   ╚═╝   ╚═╝  ╚═╝   ╚═╝   ╚══════╝${RESET}\n"
  printf "${BOLD}${YELLOW}         DOMAIN TEST MODE${RESET} ${DIM}Choose your stage...${RESET}\n\n"
}

print_domain_card() {
  local index="$1"
  local domain="$2"
  local icon
  icon=$(domain_icon "$domain")

  printf "${BOLD}${BLUE}│${RESET} ${YELLOW}%2d${RESET} ${icon} ${BOLD}%-17s${RESET} ${DIM}%s${RESET}\n" \
    "$index" \
    "$domain" \
    "$(domain_description "$domain")"
}

