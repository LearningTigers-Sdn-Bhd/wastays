# Ignore all logfiles and tempfiles.
/log/*
/tmp/*
!/log/.keep
!/tmp/.keep

# Ignore pidfiles, but keep the directory.
/tmp/pids/*
!/tmp/pids/
!/tmp/pids/.keep

# Ignore storage (uploaded files in development and any SQLite databases).
/storage/*
!/storage/.keep
/tmp/storage/*
!/tmp/storage/
!/tmp/storage/.keep

# Ignore any uploaded files.
/tmp/uploads/*
!/tmp/uploads/
!/tmp/uploads/.keep
/config/credentials/development.key
/coverage/
/CLAUDE.md
/AGENTS.md
/config/credentials/production.key
/app/assets/builds/tailwind.css
/public/assets
/config/credentials/demo.key

# Parallel tests logs
/spec/parallel_runtime_rspec.log
/tmp/parallel_*.log
/db/test*.db
/db/test*.sqlite3
.aider*
.antigravitycli/

# Gemini CLI / Agent Skills
.agents/

# OS files
.DS_Store

channex_doc_index.md
