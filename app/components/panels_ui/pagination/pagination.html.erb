<nav class="panel-pagination" aria-label="<%= @aria_label %>" data-single-page="<%= single_page? %>">
  <% unless single_page? %>
    <%= control(:first, "First page", "chevrons-left", desktop_only: true) %>
  <% end %>
  <%= control(:previous, "Previous page", "chevron-left") %>

  <% if single_page? %>
    <span class="panel-pagination__item panel-pagination__single" aria-current="page" aria-label="Page 1">1</span>
  <% else %>
    <% page_series.each do |item| %>
      <% if item == :gap %>
        <span class="panel-pagination__item panel-pagination__desktop panel-pagination__gap" aria-hidden="true">&hellip;</span>
      <% elsif item.is_a?(String) %>
        <span class="panel-pagination__item panel-pagination__desktop" aria-current="page" aria-label="Page <%= item %>"><%= item %></span>
      <% else %>
        <%= link_to item, @pagy.page_url(item), class: "panel-pagination__item panel-pagination__desktop", aria: { label: "Page #{item}" }, data: @link_data %>
      <% end %>
    <% end %>
    <span class="panel-pagination__mobile">
      <span class="panel-pagination__item" aria-current="page" aria-label="Page <%= @pagy.page %>"><%= @pagy.page %></span>
      <span>of</span>
      <span><%= @pagy.pages %></span>
    </span>
  <% end %>

  <%= control(:next, "Next page", "chevron-right") %>
  <% unless single_page? %>
    <%= control(:last, "Last page", "chevrons-right", desktop_only: true) %>
  <% end %>
</nav>
