<dialog id="<%= @id %>"
        class="<%= class_for(size: @size, class_override: @class) %>"
        aria-modal="true"
        <% if @title.present? %>aria-labelledby="<%= title_id %>"<% end %>
        <% if @title.blank? %>aria-label="<%= @aria_label %>"<% end %>
        <% if @description.present? %>aria-describedby="<%= desc_id %>"<% end %>
        data-controller="panels-ui--dialog"
        data-panels-ui--dialog-dismissible-value="<%= @dismissible %>"
        data-action="close->panels-ui--dialog#onClose cancel->panels-ui--dialog#onCancel click->panels-ui--dialog#backdropClose">
  <div class="flex flex-1 min-h-0 flex-col focus:outline-none"
       tabindex="-1"
       data-panels-ui--dialog-target="panel">
    <% if @title.present? || @description.present? || @dismissible %>
      <header class="flex items-start justify-between gap-3 px-4 pt-4 pb-3">
        <div class="min-w-0">
          <% if @title.present? %>
            <h2 id="<%= title_id %>"
                class="text-base font-semibold leading-5 focus:outline-none"
                tabindex="-1"
                data-panels-ui--dialog-target="initialFocus"><%= @title %></h2>
          <% end %>
          <% if @description.present? %>
            <p id="<%= desc_id %>" class="mt-1 text-sm text-muted-foreground"><%= @description %></p>
          <% end %>
        </div>
        <% if @dismissible %>
          <button type="button"
                  class="panel-dialog__dismiss ml-auto -mr-1 -mt-1 inline-flex size-8 shrink-0 items-center justify-center rounded-md text-muted-foreground hover:bg-muted focus:outline-none focus:ring-2 focus:ring-ring"
                  aria-label="Close"
                  data-action="panels-ui--dialog#close">
            <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M6 6l12 12M6 18L18 6" />
            </svg>
          </button>
        <% end %>
      </header>
    <% end %>

    <% if body? %>
      <div class="flex-1 min-h-0 overflow-y-auto px-4 py-2 text-sm text-card-foreground">
        <%= body %>
      </div>
    <% end %>

    <% if footer? %>
      <footer class="flex shrink-0 items-center justify-end gap-2 border-t border-border bg-muted/50 px-4 py-3">
        <%= footer %>
      </footer>
    <% end %>
  </div>
</dialog>
