<div <%= tag.attributes(root_attributes) %>>
  <div class="flex items-center gap-1.5">
    <span class="text-sm font-medium text-foreground" aria-live="polite" <%= tag.attributes(data: count_data) %>><%= empty_label %></span>
    <%= render PanelsUI::Button.new(as: :button, type: :button, variant: :ghost, size: :icon_xs, aria: { label: "Clear selection" }, data: clear_data) do %>
      <%= helpers.app_icon "x", class: "size-3.5", aria: { hidden: true } %>
    <% end %>
  </div>

  <% if actions.any? %>
    <div class="h-4 w-px bg-border" aria-hidden="true"></div>
    <div class="flex flex-wrap items-center gap-2">
      <% actions.each do |action| %><%= action %><% end %>
    </div>
  <% end %>
</div>
