<%= tag.div(**root_attributes) do %>
  <%= @form.file_field(@attribute, **input_attributes) %>

  <div class="panel-dropzone__surface"
       data-panels-ui--dropzone-target="surface"
       data-state="idle">
    <div class="panel-dropzone__icon" aria-hidden="true">
      <%= helpers.app_icon("upload", class: "size-5", aria: { hidden: "true" }) %>
    </div>
    <p class="panel-dropzone__prompt">
      <span><%= @prompt %></span>
      <%= tag.label("Browse", for: @id, class: "panel-dropzone__browse") %>
    </p>
    <% if @description.present? %>
      <p class="panel-dropzone__description"><%= @description %></p>
    <% end %>
  </div>

  <p id="<%= client_error_id %>"
     class="panel-dropzone__error"
     data-panels-ui--dropzone-target="error"
     role="alert"
     aria-live="polite"
     hidden></p>

  <div class="panel-dropzone__selection"
       data-panels-ui--dropzone-target="selection"
       hidden>
    <div class="panel-dropzone__selection-header">
      <p class="panel-dropzone__selection-title" data-panels-ui--dropzone-target="count">Selected files</p>
      <%= render PanelsUI::Button.new(
            label: "Clear all",
            variant: :ghost,
            size: :xs,
            data: { action: "panels-ui--dropzone#clear" }
          ) %>
    </div>
    <%= render PanelsUI::AttachmentGroup.new(
          layout: (@preview == :image ? :grid : :list),
          data: { panels_ui__dropzone_target: "attachments" }
        ) %>
  </div>

  <template data-panels-ui--dropzone-target="template">
    <%= render PanelsUI::Attachment.new(title: "Selected file", description: "File details", role: "listitem") do |attachment| %>
      <% attachment.with_media(variant: :icon) do %>
        <span class="panel-dropzone__file-icon" aria-hidden="true">
          <%= helpers.app_icon("clock", class: "size-4", aria: { hidden: "true" }) %>
        </span>
        <img class="panel-dropzone__thumbnail" alt="" hidden>
      <% end %>
      <% attachment.with_actions do %>
        <%= render PanelsUI::Button.new(
              variant: :ghost,
              size: :icon_xs,
              icon_only: true,
              aria_label: "Remove selected file",
              data: { action: "panels-ui--dropzone#remove" }
            ) do %>
          <%= helpers.app_icon("x", class: "size-3.5", aria: { hidden: "true" }) %>
        <% end %>
      <% end %>
    <% end %>
  </template>
<% end %>
