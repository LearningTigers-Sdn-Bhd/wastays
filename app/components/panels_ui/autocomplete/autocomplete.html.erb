<%= tag.div(**root_attributes) do %>
  <%= render input_component %>
  <div id="<%= listbox_id %>"
       class="panel-autocomplete__listbox"
       role="listbox"
       hidden
       data-ui--autocomplete-target="listbox"
       data-action="pointerdown->ui--autocomplete#onOptionPointerDown click->ui--autocomplete#choose">
  </div>
  <p id="<%= status_id %>"
     class="sr-only"
     role="status"
     aria-live="polite"
     data-ui--autocomplete-target="status"></p>
<% end %>
