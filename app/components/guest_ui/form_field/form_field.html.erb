<%= tag.div(**field_attributes) do %>
  <% if label.present? %>
    <%= tag.label(id: label_id, for: control_id, class: label_classes) do %>
      <%= label %>
      <% if @required %>
        <span class="guest-field__required" aria-hidden="true">*</span>
        <span class="sr-only">(required)</span>
      <% end %>
    <% end %>
  <% end %>

  <div class="guest-field__control"><%= control %></div>

  <% if invalid? %>
    <p id="<%= error_id %>" class="guest-field__error"><%= error_message %></p>
  <% elsif hint? %>
    <p id="<%= hint_id %>" class="guest-field__hint"><%= hint %></p>
  <% end %>
<% end %>
