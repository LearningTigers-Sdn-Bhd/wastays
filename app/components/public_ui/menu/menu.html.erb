<%= tag.div(**root_attributes) do %>
  <button type="button"
          class="public-menu__trigger"
          aria-haspopup="menu"
          aria-expanded="false"
          aria-label="<%= label %>"
          data-public-menu-target="trigger"
          data-action="public-menu#toggle">
    <%= helpers.app_icon icon, class: "size-5", aria: { hidden: "true" } %>
  </button>

  <div class="public-menu__list" role="menu" hidden data-public-menu-target="menu">
    <%= safe_join(items) %>
  </div>
<% end %>
