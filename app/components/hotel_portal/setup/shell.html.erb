<div class="flex min-h-0 flex-1 flex-col">
  <header class="shrink-0">
    <%= render HotelPortal::Setup::Stepper.new(presenter: presenter) %>
  </header>

  <div class="min-h-0 flex-1 overflow-y-auto overscroll-contain px-4 py-5 custom-scrollbar [scrollbar-gutter:stable]">
    <%= body %>
  </div>

  <% if footer? %>
    <footer class="shrink-0 border-t border-border px-4 py-3" data-slot="setup-actions">
      <%= footer %>
    </footer>
  <% end %>
</div>
