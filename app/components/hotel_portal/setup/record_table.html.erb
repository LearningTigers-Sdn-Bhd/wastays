<% table_markup = capture do %>
<%= render PanelsUI::Table.new(
      caption: caption,
      header_style: :sentence,
      density: (spreadsheet? ? :compact : :default),
      sticky_header: spreadsheet?,
      wrapper_class: "rounded-md border border-border bg-card",
      class: table_classes,
      data: { controller: HotelPortal::Setup::RecordTable::CONTROLLER }) do |table| %>
  <% table.with_header do %>
    <tr>
      <% if removable? %><th scope="col" class="panel-record-table__control">Remove</th><% end %>
      <%= safe_join(columns) %>
      <% if actions? %><th scope="col" class="panel-record-table__actions">Actions</th><% end %>
    </tr>
  <% end %>

  <% table.with_body do %>
    <%= safe_join(rows) %>

    <% if addable? %><template data-record-table-target="template"><%= blank_row %></template><% end %>

    <%= tag.tr(class: "panel-record-table__empty", hidden: records?,
               data: { "record-table-target": "empty" }) do %>
      <td colspan="<%= column_count %>"><%= empty %></td>
    <% end %>
  <% end %>

  <% if addable? || footer_message.present? %><% table.with_footer do %>
    <tr>
      <td colspan="<%= column_count %>">
        <% if addable? %><%= render PanelsUI::Button.new(as: :button, variant: :ghost, size: :sm,
              data: { action: "#{HotelPortal::Setup::RecordTable::CONTROLLER}#add" }) do %>
          <%= helpers.app_icon "plus", class: "size-4", aria: { hidden: "true" } %>
          <span><%= add_label %></span>
        <% end %><% else %><span class="text-xs text-muted-foreground"><%= footer_message %></span><% end %>
      </td>
    </tr>
  <% end %><% end %>
<% end %>
<% end %>

<% if spreadsheet? %>
  <%= tag.div(table_markup,
              class: "panel-record-table__spreadsheet-region",
              role: "region",
              tabindex: 0,
              aria: { label: caption }) %>
<% else %>
  <%= table_markup %>
<% end %>
