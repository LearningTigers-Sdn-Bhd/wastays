<%# One density for every record table. Compact is what an editable grid wants —
    the row is a line of controls, and the controls carry their own height — and a
    table that pins its columns is not a different kind of table from one that
    does not, so it should not be a different size either. %>
<% table_markup = capture do %>
<%= render PanelsUI::Table.new(
      caption: caption,
      header_style: :sentence,
      density: :compact,
      sticky_header: spreadsheet?,
      class: table_classes,
      data: { controller: HotelPortal::Setup::RecordTable::CONTROLLER }) do |table| %>
  <% table.with_header do %>
    <tr>
      <%# The column holds an icon button, so it is sized for one. Its name is for
          assistive tech and for the row that stacks below 48rem. %>
      <% if removable? %><th scope="col" class="panel-record-table__control"><span class="sr-only">Remove</span></th><% end %>
      <%= safe_join(columns) %>
      <% if actions? %><th scope="col" class="panel-record-table__actions">Actions</th><% end %>
    </tr>
  <% end %>

  <% table.with_body do %>
    <%= safe_join(rows) %>

    <% if addable? %><template data-record-table-target="template"><%= blank_row %></template><% end %>

    <%= tag.tr(class: "panel-record-table__empty", hidden: records?,
               data: { "record-table-target": "empty" }) do %>
      <td colspan="<%= column_count %>"><%= empty %></td>
    <% end %>
  <% end %>

  <% if addable? || footer_message.present? %><% table.with_footer do %>
    <tr>
      <td colspan="<%= column_count %>">
        <% if addable? %><%= render PanelsUI::Button.new(as: :button, variant: :ghost, size: :sm,
              data: { action: "#{HotelPortal::Setup::RecordTable::CONTROLLER}#add" }) do %>
          <%= helpers.app_icon "plus", class: "size-4", aria: { hidden: "true" } %>
          <span><%= add_label %></span>
        <% end %><% else %><span class="text-xs text-muted-foreground"><%= footer_message %></span><% end %>
      </td>
    </tr>
  <% end %><% end %>
<% end %>
<% end %>

<%# Every record table can outgrow its container — the pinned ones by design, the
    rest between 48rem and their own minimum. The region is what makes that scroll
    reachable from the keyboard and gives it a name, so it is not the pinned
    tables' privilege. %>
<%= tag.div(table_markup,
            class: "panel-record-table__region",
            role: "region",
            tabindex: 0,
            aria: { label: caption }) %>
