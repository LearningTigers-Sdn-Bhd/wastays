<%= render PanelsUI::Tabs.new(
      id: "onboarding-steps",
      variant: :line,
      active: current_step_name,
      aria_label: "#{presenter.phase_label} steps",
      list_class: "px-4"
    ) do |tabs| %>
  <% steps.each_with_index do |entry, index| %>
    <% tabs.with_tab(
         name: step_name(entry),
         label: step_label(entry, index),
         href: (step_path(entry) if entry.available),
         disabled: !entry.available
       ) %>
  <% end %>
<% end %>
