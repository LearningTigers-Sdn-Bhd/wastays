<%# app/components/hotel_portal/reservation_board/legend_component.html.erb %>
<div class="rounded-xl border border-slate-200 bg-white p-2 shadow-sm overflow-x-auto whitespace-nowrap scrollbar-hide">
  <div class="flex items-center gap-2">
    <% status_list.each do |status| %>
      <span class="inline-flex items-center gap-1.5 rounded-full border px-2.5 py-1 text-[10px] font-bold uppercase tracking-wide <%= style_for(status) %> transition-all hover:shadow-sm">
        <%= icon_for(status) %>
        <%= status.humanize.titleize %>
        <span class="opacity-60 font-black">(<%= count_for(status) %>)</span>
      </span>
    <% end %>
  </div>
</div>
