<%# app/components/hotel_portal/reservation_board/action_modal_component.html.erb %>
<div id="reservation-board-action-modal-container" 
     data-controller="reservation-board-modal"
     data-action="reservation-board:open-modal->reservation-board-modal#open">
  <dialog id="reservation-board-action-modal" 
          class="fixed inset-0 m-auto rounded-2xl p-0 w-[min(92vw,28rem)] max-w-md shadow-2xl backdrop:bg-slate-900/50 overflow-hidden" 
          data-reservation-board-modal-target="dialog"
          onclick="if(event.target===this){this.close()}">
    <div class="bg-white text-left" onclick="event.stopPropagation()">
      <turbo-frame id="reservation_board_modal_content" loading="lazy">
        <div class="p-20 flex items-center justify-center">
          <div class="animate-spin rounded-full h-8 w-8 border-b-2 border-slate-900"></div>
        </div>
      </turbo-frame>
    </div>
  </dialog>

  <%# Global Guest Notes Dialog %>
  <dialog id="reservation-board-notes-modal" 
          class="fixed inset-0 m-auto w-[min(92vw,36rem)] rounded-2xl p-0 shadow-2xl backdrop:bg-slate-900/50" 
          onclick="if(event.target===this){this.close()}">
    <div class="flex flex-col h-full bg-white overflow-hidden" onclick="event.stopPropagation()">
      <div class="flex items-center justify-between px-6 py-4 border-b border-slate-100">
        <div class="flex items-center gap-3">
          <div class="size-8 rounded-lg bg-amber-50 flex items-center justify-center text-amber-600">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M15 14h.01"/><path d="M15 18h.01"/><path d="M15 10h.01"/><path d="M11 14h.01"/><path d="M11 18h.01"/><path d="M11 10h.01"/><path d="M7 14h.01"/><path d="M7 18h.01"/><path d="M7 10h.01"/><rect width="18" height="20" x="3" y="2" rx="2"/></svg>
          </div>
          <h3 class="text-base font-bold text-slate-900">Guest Notes</h3>
        </div>
        <button onclick="this.closest('dialog').close()" class="p-2 rounded-lg hover:bg-slate-50 text-slate-400 transition-colors">
          <svg class="size-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" /></svg>
        </button>
      </div>
      <div id="reservation-board-notes-list" class="px-6 py-6 overflow-y-auto max-h-[60vh] space-y-4">
      </div>
      <div class="px-6 py-4 bg-slate-50 border-t border-slate-100 flex justify-end">
        <button onclick="this.closest('dialog').close()" class="px-4 py-2 bg-white border border-slate-200 rounded-xl text-sm font-bold text-slate-700 hover:bg-slate-50 transition-colors">Close</button>
      </div>
    </div>
  </dialog>
</div>
