<%# app/components/hotel_portal/reservation_board/timeline_header_component.html.erb %>
<div class="grid border-b border-slate-200 bg-slate-50 sticky top-0 z-40" style="grid-template-columns: <%= grid_template_columns %>;">
  <div class="sticky left-0 z-50 border-r border-slate-200 bg-slate-50 shadow-[4px_0_12px_rgba(0,0,0,0.03)] <%= card_padding %> text-left text-sm font-semibold uppercase tracking-[0.08em] text-slate-600">
    Rooms
  </div>

  <% board_dates.each_with_index do |date, index| %>
    <div class="border-l <%= 'border-r' if index == board_dates.size - 1 %> border-slate-200 <%= summary_padding %> flex flex-col items-center justify-center <%= 'bg-slate-100' if date == Date.current %>">
      <p class="text-[10px] font-bold uppercase tracking-wide text-slate-500"><%= date.strftime('%a') %></p>
      <p class="text-xl font-black leading-none text-slate-900"><%= date.day %></p>
      <p class="text-[10px] font-bold uppercase tracking-wide text-slate-400"><%= date.strftime('%b') %></p>
    </div>
  <% end %>
</div>
