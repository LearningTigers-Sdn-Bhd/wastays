<div class="w-full space-y-8">
  <%= render PanelsUI::PageHeader.new(
        title: "Audit Logs",
        description: "Review platform activity and operational changes across all hotels.") %>

  <div class="overflow-hidden rounded-2xl border border-border bg-card shadow-sm">
    <div class="flex flex-col gap-4 border-b border-border bg-muted/70 px-6 py-4 sm:px-8 xl:flex-row xl:items-end">
      <%= form_with url: admin_audit_logs_path, method: :get, class: "grid w-full gap-4 md:grid-cols-2 xl:grid-cols-[repeat(4,minmax(0,1fr))_auto]" do |f| %>
        <div>
          <label class="mb-2 block text-sm font-medium text-muted-foreground">Hotel</label>
          <%= f.select :hotel_id, @hotels.map { |hotel| [hotel.name, hotel.id] }, { include_blank: "All Hotels", selected: params[:hotel_id] }, class: "w-full rounded-xl border border-border bg-card px-3 py-2.5 text-sm font-medium text-foreground focus:border-border-interactive focus:outline-none focus:ring-0" %>
        </div>
        <div>
          <label class="mb-2 block text-sm font-medium text-muted-foreground">Action Type</label>
          <%= f.select :action_type, [["Bulk Rate Update", "bulk_rate_update"], ["Bulk Inventory Update", "bulk_inventory_update"]], { include_blank: "All Actions", selected: params[:action_type] }, class: "w-full rounded-xl border border-border bg-card px-3 py-2.5 text-sm font-medium text-foreground focus:border-border-interactive focus:outline-none focus:ring-0" %>
        </div>
        <div>
          <label class="mb-2 block text-sm font-medium text-muted-foreground">Start Date</label>
          <%= f.date_field :start_date, value: params[:start_date], class: "w-full rounded-xl border border-border bg-card px-3 py-2.5 text-sm font-medium text-foreground focus:border-border-interactive focus:outline-none focus:ring-0" %>
        </div>
        <div>
          <label class="mb-2 block text-sm font-medium text-muted-foreground">End Date</label>
          <%= f.date_field :end_date, value: params[:end_date], class: "w-full rounded-xl border border-border bg-card px-3 py-2.5 text-sm font-medium text-foreground focus:border-border-interactive focus:outline-none focus:ring-0" %>
        </div>
        <div class="flex items-center gap-3 xl:self-end xl:justify-end">
          <% if params[:hotel_id].present? || params[:action_type].present? || params[:start_date].present? || params[:end_date].present? %>
            <%= link_to "Clear", admin_audit_logs_path, class: "text-sm font-semibold text-muted-foreground hover:text-foreground" %>
          <% end %>
          <%= f.submit "Apply Filters", class: "inline-flex items-center justify-center rounded-xl bg-primary px-4 py-2.5 text-sm font-semibold text-primary-foreground transition hover:bg-primary-hover" %>
        </div>
      <% end %>
    </div>

    <div class="flex items-center justify-between border-b border-border px-6 py-5 sm:px-8">
      <div>
        <h2 class="text-lg font-bold tracking-tight text-foreground sm:text-xl">Activity Feed</h2>
        <p class="mt-1 text-sm font-medium text-muted-foreground">Recent admin-visible changes recorded across hotels and operational workflows.</p>
      </div>
    </div>

    <div id="admin-audit-logs-mobile-list" class="space-y-4 p-4 sm:p-6 lg:hidden">
      <% if @logs.any? %>
        <% @logs.each do |log| %>
          <% action_class = case log.action_type
             when 'bulk_rate_update'
               'bg-violet-50 text-violet-700 ring-1 ring-inset ring-violet-200'
             when 'bulk_inventory_update'
               'bg-blue-50 text-blue-700 ring-1 ring-inset ring-blue-200'
             else
               'bg-muted text-foreground ring-1 ring-inset ring-ring'
             end %>

          <div class="rounded-2xl border border-border bg-muted/60 p-4 shadow-sm">
            <div class="flex items-start justify-between gap-3">
              <div>
                <p class="text-sm font-semibold text-foreground"><%= log.hotel.name %></p>
                <p class="mt-1 text-sm text-muted-foreground"><%= log.user.name %></p>
              </div>
              <span class="inline-flex items-center rounded-full px-3 py-1 text-xs font-semibold <%= action_class %>"><%= log.action_type.titleize %></span>
            </div>

            <dl class="mt-4 space-y-3 text-sm">
              <div>
                <dt class="text-xs font-semibold uppercase tracking-[0.08em] text-muted-foreground">Time</dt>
                <dd class="mt-1 text-foreground"><%= log.created_at.strftime("%d %b %Y, %H:%M") %></dd>
              </div>
              <div>
                <dt class="text-xs font-semibold uppercase tracking-[0.08em] text-muted-foreground">Details</dt>
                <dd class="mt-1 font-medium text-foreground"><%= log.display_details %></dd>
              </div>
              <div>
                <dt class="text-xs font-semibold uppercase tracking-[0.08em] text-muted-foreground">Value</dt>
                <dd class="mt-1 text-muted-foreground"><%= log.display_value_change %></dd>
              </div>
            </dl>
          </div>
        <% end %>
      <% else %>
        <div class="rounded-2xl border border-dashed border-border bg-muted/60 px-4 py-8 text-center">
          <p class="text-sm font-semibold text-foreground">No audit logs found.</p>
          <p class="mt-2 text-sm text-muted-foreground">Try adjusting the filters to review a broader activity window.</p>
        </div>
      <% end %>
    </div>

    <div class="hidden lg:block overflow-x-auto">
      <table class="min-w-full">
        <thead class="bg-muted">
          <tr>
            <th scope="col" class="px-6 py-4 text-left text-[11px] font-semibold uppercase tracking-[0.1em] text-muted-foreground sm:px-8">Time</th>
            <th scope="col" class="px-6 py-4 text-left text-[11px] font-semibold uppercase tracking-[0.1em] text-muted-foreground">Hotel</th>
            <th scope="col" class="px-6 py-4 text-left text-[11px] font-semibold uppercase tracking-[0.1em] text-muted-foreground">User</th>
            <th scope="col" class="px-6 py-4 text-left text-[11px] font-semibold uppercase tracking-[0.1em] text-muted-foreground">Action</th>
            <th scope="col" class="px-6 py-4 text-left text-[11px] font-semibold uppercase tracking-[0.1em] text-muted-foreground">Details</th>
            <th scope="col" class="px-6 py-4 text-left text-[11px] font-semibold uppercase tracking-[0.1em] text-muted-foreground sm:px-8">Value</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-border bg-card">
          <% if @logs.any? %>
            <% @logs.each_with_index do |log, index| %>
              <% action_class = case log.action_type
                 when 'bulk_rate_update'
                   'bg-violet-50 text-violet-700 ring-1 ring-inset ring-violet-200'
                 when 'bulk_inventory_update'
                   'bg-blue-50 text-blue-700 ring-1 ring-inset ring-blue-200'
                 else
                   'bg-muted text-foreground ring-1 ring-inset ring-ring'
                 end %>
              <tr class="transition-colors hover:bg-muted/80 <%= index.even? ? 'bg-card' : 'bg-muted/55' %>">
                <td class="whitespace-nowrap px-6 py-4 text-sm font-medium text-muted-foreground sm:px-8"><%= log.created_at.strftime("%d %b %Y, %H:%M") %></td>
                <td class="whitespace-nowrap px-6 py-4 text-sm font-semibold text-foreground"><%= log.hotel.name %></td>
                <td class="whitespace-nowrap px-6 py-4 text-sm text-foreground"><%= log.user.name %></td>
                <td class="whitespace-nowrap px-6 py-4">
                  <span class="inline-flex items-center rounded-full px-3 py-1 text-xs font-semibold <%= action_class %>"><%= log.action_type.titleize %></span>
                </td>
                <td class="px-6 py-4 text-sm text-foreground"><span class="font-medium"><%= log.display_details %></span></td>
                <td class="whitespace-nowrap px-6 py-4 text-sm text-muted-foreground sm:px-8"><%= log.display_value_change %></td>
              </tr>
            <% end %>
          <% else %>
            <tr>
              <td colspan="6" class="px-6 py-12 text-center sm:px-8">
                <div class="mx-auto max-w-sm space-y-2">
                  <p class="text-sm font-semibold text-foreground">No audit logs found.</p>
                  <p class="text-sm text-muted-foreground">Try adjusting the filters to review a broader activity window.</p>
                </div>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>

    <div class="px-6 py-5 border-t border-border bg-muted/50 flex justify-center sm:px-8">
      <%= paginate @logs %>
    </div>
  </div>
</div>
