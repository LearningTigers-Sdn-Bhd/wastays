<div class="max-w-[1600px] mx-auto pb-20 space-y-8">
  <%= render "shared/components/page_header", title: "Audit Logs", subtitle: "Review platform activity and operational changes across all hotels." %>

  <div class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">
    <div class="flex flex-col gap-4 border-b border-slate-200 bg-slate-50/70 px-6 py-4 sm:px-8 xl:flex-row xl:items-end">
      <%= form_with url: admin_audit_logs_path, method: :get, class: "grid w-full gap-4 md:grid-cols-2 xl:grid-cols-[repeat(4,minmax(0,1fr))_auto]" do |f| %>
        <div>
          <label class="mb-2 block text-sm font-medium text-slate-600">Hotel</label>
          <%= f.select :hotel_id, @hotels.map { |hotel| [hotel.name, hotel.id] }, { include_blank: "All Hotels", selected: params[:hotel_id] }, class: "w-full rounded-xl border border-slate-200 bg-white px-3 py-2.5 text-sm font-medium text-slate-700 focus:border-slate-300 focus:outline-none focus:ring-0" %>
        </div>
        <div>
          <label class="mb-2 block text-sm font-medium text-slate-600">Action Type</label>
          <%= f.select :action_type, [["Bulk Rate Update", "bulk_rate_update"], ["Bulk Inventory Update", "bulk_inventory_update"]], { include_blank: "All Actions", selected: params[:action_type] }, class: "w-full rounded-xl border border-slate-200 bg-white px-3 py-2.5 text-sm font-medium text-slate-700 focus:border-slate-300 focus:outline-none focus:ring-0" %>
        </div>
        <div>
          <label class="mb-2 block text-sm font-medium text-slate-600">Start Date</label>
          <%= f.date_field :start_date, value: params[:start_date], class: "w-full rounded-xl border border-slate-200 bg-white px-3 py-2.5 text-sm font-medium text-slate-700 focus:border-slate-300 focus:outline-none focus:ring-0" %>
        </div>
        <div>
          <label class="mb-2 block text-sm font-medium text-slate-600">End Date</label>
          <%= f.date_field :end_date, value: params[:end_date], class: "w-full rounded-xl border border-slate-200 bg-white px-3 py-2.5 text-sm font-medium text-slate-700 focus:border-slate-300 focus:outline-none focus:ring-0" %>
        </div>
        <div class="flex items-center gap-3 xl:self-end xl:justify-end">
          <% if params[:hotel_id].present? || params[:action_type].present? || params[:start_date].present? || params[:end_date].present? %>
            <%= link_to "Clear", admin_audit_logs_path, class: "text-sm font-semibold text-slate-600 hover:text-slate-900" %>
          <% end %>
          <%= f.submit "Apply Filters", class: "inline-flex items-center justify-center rounded-xl bg-slate-900 px-4 py-2.5 text-sm font-semibold text-white transition hover:bg-slate-800" %>
        </div>
      <% end %>
    </div>

    <div class="flex items-center justify-between border-b border-slate-200 px-6 py-5 sm:px-8">
      <div>
        <h2 class="text-lg font-bold tracking-tight text-slate-950 sm:text-xl">Activity Feed</h2>
        <p class="mt-1 text-sm font-medium text-slate-600">Recent admin-visible changes recorded across hotels and operational workflows.</p>
      </div>
    </div>

    <div id="admin-audit-logs-mobile-list" class="space-y-4 p-4 sm:p-6 lg:hidden">
      <% if @logs.any? %>
        <% @logs.each do |log| %>
          <% action_class = case log.action_type
             when 'bulk_rate_update'
               'bg-violet-50 text-violet-700 ring-1 ring-inset ring-violet-200'
             when 'bulk_inventory_update'
               'bg-blue-50 text-blue-700 ring-1 ring-inset ring-blue-200'
             else
               'bg-slate-100 text-slate-700 ring-1 ring-inset ring-slate-200'
             end %>

          <div class="rounded-2xl border border-slate-200 bg-slate-50/60 p-4 shadow-sm">
            <div class="flex items-start justify-between gap-3">
              <div>
                <p class="text-sm font-semibold text-slate-900"><%= log.hotel.name %></p>
                <p class="mt-1 text-sm text-slate-600"><%= log.user.name %></p>
              </div>
              <span class="inline-flex items-center rounded-full px-3 py-1 text-xs font-semibold <%= action_class %>"><%= log.action_type.titleize %></span>
            </div>

            <dl class="mt-4 space-y-3 text-sm">
              <div>
                <dt class="text-xs font-semibold uppercase tracking-[0.08em] text-slate-500">Time</dt>
                <dd class="mt-1 text-slate-700"><%= log.created_at.strftime("%d %b %Y, %H:%M") %></dd>
              </div>
              <div>
                <dt class="text-xs font-semibold uppercase tracking-[0.08em] text-slate-500">Details</dt>
                <dd class="mt-1 font-medium text-slate-700"><%= log.display_details %></dd>
              </div>
              <div>
                <dt class="text-xs font-semibold uppercase tracking-[0.08em] text-slate-500">Value</dt>
                <dd class="mt-1 text-slate-600"><%= log.display_value_change %></dd>
              </div>
            </dl>
          </div>
        <% end %>
      <% else %>
        <div class="rounded-2xl border border-dashed border-slate-200 bg-slate-50/60 px-4 py-8 text-center">
          <p class="text-sm font-semibold text-slate-900">No audit logs found.</p>
          <p class="mt-2 text-sm text-slate-500">Try adjusting the filters to review a broader activity window.</p>
        </div>
      <% end %>
    </div>

    <div class="hidden lg:block overflow-x-auto">
      <table class="min-w-full">
        <thead class="bg-slate-100">
          <tr>
            <th scope="col" class="px-6 py-4 text-left text-[11px] font-semibold uppercase tracking-[0.1em] text-slate-600 sm:px-8">Time</th>
            <th scope="col" class="px-6 py-4 text-left text-[11px] font-semibold uppercase tracking-[0.1em] text-slate-600">Hotel</th>
            <th scope="col" class="px-6 py-4 text-left text-[11px] font-semibold uppercase tracking-[0.1em] text-slate-600">User</th>
            <th scope="col" class="px-6 py-4 text-left text-[11px] font-semibold uppercase tracking-[0.1em] text-slate-600">Action</th>
            <th scope="col" class="px-6 py-4 text-left text-[11px] font-semibold uppercase tracking-[0.1em] text-slate-600">Details</th>
            <th scope="col" class="px-6 py-4 text-left text-[11px] font-semibold uppercase tracking-[0.1em] text-slate-600 sm:px-8">Value</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-200 bg-white">
          <% if @logs.any? %>
            <% @logs.each_with_index do |log, index| %>
              <% action_class = case log.action_type
                 when 'bulk_rate_update'
                   'bg-violet-50 text-violet-700 ring-1 ring-inset ring-violet-200'
                 when 'bulk_inventory_update'
                   'bg-blue-50 text-blue-700 ring-1 ring-inset ring-blue-200'
                 else
                   'bg-slate-100 text-slate-700 ring-1 ring-inset ring-slate-200'
                 end %>
              <tr class="transition-colors hover:bg-slate-100/80 <%= index.even? ? 'bg-white' : 'bg-slate-50/55' %>">
                <td class="whitespace-nowrap px-6 py-4 text-sm font-medium text-slate-600 sm:px-8"><%= log.created_at.strftime("%d %b %Y, %H:%M") %></td>
                <td class="whitespace-nowrap px-6 py-4 text-sm font-semibold text-slate-900"><%= log.hotel.name %></td>
                <td class="whitespace-nowrap px-6 py-4 text-sm text-slate-700"><%= log.user.name %></td>
                <td class="whitespace-nowrap px-6 py-4">
                  <span class="inline-flex items-center rounded-full px-3 py-1 text-xs font-semibold <%= action_class %>"><%= log.action_type.titleize %></span>
                </td>
                <td class="px-6 py-4 text-sm text-slate-700"><span class="font-medium"><%= log.display_details %></span></td>
                <td class="whitespace-nowrap px-6 py-4 text-sm text-slate-600 sm:px-8"><%= log.display_value_change %></td>
              </tr>
            <% end %>
          <% else %>
            <tr>
              <td colspan="6" class="px-6 py-12 text-center sm:px-8">
                <div class="mx-auto max-w-sm space-y-2">
                  <p class="text-sm font-semibold text-slate-900">No audit logs found.</p>
                  <p class="text-sm text-slate-500">Try adjusting the filters to review a broader activity window.</p>
                </div>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>

    <div class="px-6 py-5 border-t border-slate-200 bg-slate-50/50 flex justify-center sm:px-8">
      <%= paginate @logs %>
    </div>
  </div>
</div>
