<% content_for :breadcrumbs do %>
  <%= render "shared/navigation/admin_breadcrumbs", current: "Setup Fee Settings" %>
<% end %>

<% all_rules = @all_setup_fee_rules.to_a %>
<% hotels = Array(@hotels) %>
<% total_rules = all_rules.size %>
<% active_rules = all_rules.count { |rule| rule.status == "active" } %>
<% global_defaults = all_rules.count { |rule| rule.settable_type.blank? } %>
<% hotel_overrides = total_rules - global_defaults %>

<div class="max-w-[1600px] mx-auto pb-20 space-y-8">
  <div class="px-4 md:px-0">
    <div class="mt-5 flex flex-col gap-4 xl:flex-row xl:items-end xl:justify-between">
      <div>
        <h1 class="text-2xl font-bold tracking-tight text-slate-950 sm:text-3xl">Setup Fee Settings</h1>
        <p class="mt-1 text-sm font-medium text-slate-600">Set the one-time hotel onboarding fees WAStays applies across global defaults and hotel overrides.</p>
      </div>

      <div class="inline-flex items-center gap-2 rounded-xl border border-slate-200 bg-white px-4 py-2.5 text-sm font-semibold text-slate-700 shadow-sm">
        <span class="size-2.5 rounded-full bg-blue-500"></span>
        <%= pluralize(global_defaults, "global default") %> in coverage
      </div>
    </div>
  </div>

  <div class="grid grid-cols-1 overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm md:grid-cols-4">
    <div class="p-6 md:border-r md:border-slate-200 md:p-8">
      <p class="mb-2 text-[11px] font-semibold uppercase tracking-[0.08em] text-slate-500">Total Rules</p>
      <h2 class="text-3xl font-bold tabular-nums tracking-tight text-slate-950"><%= total_rules %></h2>
      <p class="mt-2 text-sm font-medium text-slate-600">All setup fee rules in the admin registry</p>
    </div>

    <div class="bg-slate-50/30 p-6 md:border-r md:border-slate-200 md:p-8">
      <p class="mb-2 text-[11px] font-semibold uppercase tracking-[0.08em] text-slate-500">Active Rules</p>
      <h2 class="text-3xl font-bold tabular-nums tracking-tight text-emerald-600"><%= active_rules %></h2>
      <p class="mt-2 text-sm font-medium text-slate-600">Rules currently used for hotel setup pricing</p>
    </div>

    <div class="p-6 md:border-r md:border-slate-200 md:p-8">
      <p class="mb-2 text-[11px] font-semibold uppercase tracking-[0.08em] text-slate-500">Global Defaults</p>
      <h2 class="text-3xl font-bold tabular-nums tracking-tight text-blue-600"><%= global_defaults %></h2>
      <p class="mt-2 text-sm font-medium text-slate-600">Fallback fee when no hotel override exists</p>
    </div>

    <div class="p-6 md:p-8">
      <p class="mb-2 text-[11px] font-semibold uppercase tracking-[0.08em] text-slate-500">Hotel Overrides</p>
      <h2 class="text-3xl font-bold tabular-nums tracking-tight text-violet-600"><%= hotel_overrides %></h2>
      <p class="mt-2 text-sm font-medium text-slate-600">Hotel-level exceptions to the global default</p>
    </div>
  </div>

  <div class="grid grid-cols-1 gap-8 xl:grid-cols-[minmax(0,380px)_minmax(0,1fr)] xl:items-start">
    <div class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm xl:sticky xl:top-6">
      <div class="border-b border-slate-200 px-6 py-5 sm:px-8">
        <h2 class="text-lg font-bold tracking-tight text-slate-950 sm:text-xl">Add New Rule</h2>
        <p class="mt-1 text-sm font-medium text-slate-600">Create a global setup fee or a targeted override for a specific hotel.</p>
      </div>

      <div class="p-6 sm:p-8">
        <% if @new_rule.errors.any? %>
          <div class="mb-5 rounded-xl border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-700">
            <p class="font-semibold"><%= pluralize(@new_rule.errors.count, "issue") %> blocked this rule.</p>
            <ul class="mt-2 space-y-1 text-sm">
              <% @new_rule.errors.full_messages.each do |message| %>
                <li><%= message %></li>
              <% end %>
            </ul>
          </div>
        <% end %>

        <%= form_with model: [:admin, @new_rule], local: true, class: "space-y-5", data: { controller: "margin-rule-form" } do |f| %>
          <div>
            <label class="mb-2 block text-sm font-medium text-slate-600">Setup Fee Amount (MYR)</label>
            <%= f.number_field :amount, step: 0.01, min: 0, class: "w-full rounded-xl border border-slate-200 bg-white px-3 py-2.5 text-sm font-medium text-slate-700 focus:border-slate-300 focus:outline-none focus:ring-0" %>
          </div>

          <div>
            <label class="mb-2 block text-sm font-medium text-slate-600">Applies To</label>
            <%= f.select :settable_type, [["Global Default", nil], ["Specific Hotel", "Hotel"]], {}, class: "w-full rounded-xl border border-slate-200 bg-white px-3 py-2.5 text-sm font-medium text-slate-700 focus:border-slate-300 focus:outline-none focus:ring-0", data: { margin_rule_form_target: "appliesTo", action: "change->margin-rule-form#toggle" } %>
          </div>

          <div data-margin-rule-form-target="targetField" class="<%= @new_rule.settable_type.blank? ? 'hidden' : '' %>">
            <label class="mb-2 block text-sm font-medium text-slate-600">Hotel</label>
            <%= f.select :settable_id,
                         options_from_collection_for_select(hotels, :id, :name, @new_rule.settable_id),
                         { include_blank: "Select a hotel" },
                         class: "w-full rounded-xl border border-slate-200 bg-white px-3 py-2.5 text-sm font-medium text-slate-700 focus:border-slate-300 focus:outline-none focus:ring-0",
                         data: { margin_rule_form_target: "targetInput" },
                         disabled: @new_rule.settable_type.blank? %>
            <p class="mt-2 text-xs font-medium text-slate-500">Choose the hotel that should use a custom one-time setup fee.</p>
          </div>

          <div class="pt-2">
            <%= f.submit "Create Rule", class: "inline-flex w-full items-center justify-center rounded-xl bg-red-600 px-4 py-2.5 text-sm font-semibold text-white transition hover:bg-red-700" %>
          </div>
        <% end %>
      </div>
    </div>

    <div class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">
      <div class="flex flex-col gap-4 border-b border-slate-200 px-6 py-5 sm:px-8 lg:flex-row lg:items-center lg:justify-between">
        <div>
          <h2 class="text-lg font-bold tracking-tight text-slate-950 sm:text-xl">Rule Registry</h2>
          <p class="mt-1 text-sm font-medium text-slate-600">Create and manage fixed setup fee rules for default coverage or hotel overrides.</p>
        </div>

        <span class="text-sm font-medium text-slate-500">Total <span class="font-semibold text-slate-900"><%= total_rules %></span></span>
      </div>

      <div id="admin-setup-fee-rules-mobile-list" class="space-y-4 p-4 sm:p-6 lg:hidden">
        <% if @setup_fee_rules.any? %>
          <% @setup_fee_rules.each do |rule| %>
            <% status_classes = rule.status == "active" ? "bg-emerald-50 text-emerald-700 ring-1 ring-inset ring-emerald-200" : "bg-slate-100 text-slate-700 ring-1 ring-inset ring-slate-200" %>
            <% target_title, target_caption, target_title_classes = if rule.settable_type.blank?
                 ["Global Default", "Applied when no hotel override exists", "text-blue-700"]
               else
                 hotel_name = hotels.find { |hotel| hotel.id == rule.settable_id }&.name
                 ["Hotel Override", hotel_name.present? ? hotel_name : "Applies to hotel ##{rule.settable_id}", "text-slate-900"]
               end %>

            <div class="rounded-2xl border border-slate-200 bg-slate-50/60 p-4 shadow-sm">
              <div class="flex items-start justify-between gap-3">
                <div>
                  <p class="text-sm font-semibold <%= target_title_classes %>"><%= target_title %></p>
                  <p class="mt-1 text-sm text-slate-600"><%= target_caption %></p>
                </div>
                <span class="inline-flex items-center rounded-full px-3 py-1 text-xs font-semibold <%= status_classes %>"><%= rule.status.titleize %></span>
              </div>

              <div class="mt-4 flex items-center justify-between gap-3">
                <div>
                  <p class="text-xs font-semibold uppercase tracking-[0.08em] text-slate-500">Fee Amount</p>
                  <p class="mt-1 text-lg font-semibold text-slate-900"><%= number_to_currency(rule.amount, unit: "#{rule.currency} ", precision: 2) %></p>
                </div>
                <%= button_to admin_setup_fee_rule_path(rule), method: :delete, data: { turbo_confirm: "Are you sure you want to delete this setup fee rule?", turbo_confirm_title: "Delete Setup Fee Rule", turbo_confirm_color: "red" }, class: "inline-flex items-center gap-x-1.5 rounded-lg bg-red-50 px-3 py-1.5 text-xs font-semibold text-red-700 transition hover:bg-red-100" do %>
                  <svg class="size-3.5" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 6h18"/><path d="M8 6V4a1 1 0 0 1 1-1h6a1 1 0 0 1 1 1v2"/><path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6"/><path d="M10 11v6"/><path d="M14 11v6"/></svg>
                  Delete
                <% end %>
              </div>
            </div>
          <% end %>
        <% else %>
          <div class="rounded-2xl border border-dashed border-slate-200 bg-slate-50/60 px-4 py-8 text-center">
            <p class="text-sm font-semibold text-slate-900">No setup fee rules yet.</p>
            <p class="mt-2 text-sm text-slate-500">Create the first global default or hotel override to start controlling onboarding fees.</p>
          </div>
        <% end %>
      </div>

      <div class="hidden overflow-x-auto lg:block">
        <table class="min-w-full">
          <thead class="bg-slate-100">
            <tr>
              <th scope="col" class="px-6 py-4 text-left text-[11px] font-semibold uppercase tracking-[0.1em] text-slate-600 sm:px-8">Target</th>
              <th scope="col" class="px-6 py-4 text-left text-[11px] font-semibold uppercase tracking-[0.1em] text-slate-600">Fee Amount</th>
              <th scope="col" class="px-6 py-4 text-left text-[11px] font-semibold uppercase tracking-[0.1em] text-slate-600">Status</th>
              <th scope="col" class="px-6 py-4 text-right text-[11px] font-semibold uppercase tracking-[0.1em] text-slate-600 sm:px-8">Action</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-200 bg-white">
            <% if @setup_fee_rules.any? %>
              <% @setup_fee_rules.each_with_index do |rule, index| %>
                <% status_classes = rule.status == "active" ? "bg-emerald-50 text-emerald-700 ring-1 ring-inset ring-emerald-200" : "bg-slate-100 text-slate-700 ring-1 ring-inset ring-slate-200" %>
                <% target_title, target_caption, target_title_classes = if rule.settable_type.blank?
                     ["Global Default", "Applied when no hotel override exists", "text-blue-700"]
                   else
                     hotel_name = hotels.find { |hotel| hotel.id == rule.settable_id }&.name
                     ["Hotel Override", hotel_name.present? ? hotel_name : "Applies to hotel ##{rule.settable_id}", "text-slate-900"]
                   end %>

                <tr class="transition-colors hover:bg-slate-100/80 <%= index.even? ? 'bg-white' : 'bg-slate-50/55' %>">
                  <td class="px-6 py-4 sm:px-8">
                    <div class="min-w-[14rem]">
                      <p class="text-sm font-semibold <%= target_title_classes %>"><%= target_title %></p>
                      <p class="mt-1 text-sm text-slate-600"><%= target_caption %></p>
                    </div>
                  </td>
                  <td class="whitespace-nowrap px-6 py-4 text-sm font-semibold text-slate-900"><%= number_to_currency(rule.amount, unit: "#{rule.currency} ", precision: 2) %></td>
                  <td class="whitespace-nowrap px-6 py-4">
                    <span class="inline-flex items-center rounded-full px-3 py-1 text-xs font-semibold <%= status_classes %>"><%= rule.status.titleize %></span>
                  </td>
                  <td class="px-6 py-4 text-right sm:px-8">
                    <%= button_to admin_setup_fee_rule_path(rule), method: :delete, data: { turbo_confirm: "Are you sure you want to delete this setup fee rule?", turbo_confirm_title: "Delete Setup Fee Rule", turbo_confirm_color: "red" }, class: "inline-flex items-center gap-x-1.5 rounded-lg bg-red-50 px-3 py-1.5 text-xs font-semibold text-red-700 transition hover:bg-red-100" do %>
                      <svg class="size-3.5" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 6h18"/><path d="M8 6V4a1 1 0 0 1 1-1h6a1 1 0 0 1 1 1v2"/><path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6"/><path d="M10 11v6"/><path d="M14 11v6"/></svg>
                      Delete
                    <% end %>
                  </td>
                </tr>
              <% end %>
            <% else %>
              <tr>
                <td colspan="4" class="px-6 py-12 text-center sm:px-8">
                  <div class="mx-auto max-w-sm space-y-2">
                    <p class="text-sm font-semibold text-slate-900">No setup fee rules yet.</p>
                    <p class="text-sm text-slate-500">Create the first global default or hotel override to start controlling onboarding fees.</p>
                  </div>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
        </div>

        <div class="px-6 py-5 border-t border-slate-200 bg-slate-50/50 flex justify-center sm:px-8">
        <%= paginate @setup_fee_rules %>
        </div>
        </div>
        </div>

</div>
