<% if (credentials = flash[:agent_credentials]).present? %>
  <%= render "admin/hotels/owner_credentials", credentials: credentials, recipient: "agent", reset_hint: false %>
<% end %>

<%= render PanelsUI::PageHeader.new(
      title: "Super agents",
      description: "Super agents bring in hotels with their invite link. Turn on \"Can create hotels\" to let an agent also create hotels themselves.") do |header| %>
  <% header.with_actions do %>
    <%= render PanelsUI::Button.new(
          as: :a,
          href: new_admin_super_agent_path,
          data: { turbo_frame: "admin_super_agent_action_sheet" }) do %>
      <%= app_icon "plus", class: "size-4", aria: { hidden: true } %>
      Add super agent
    <% end %>
  <% end %>
<% end %>

<section aria-labelledby="super-agents-heading" class="space-y-3">
  <h2 id="super-agents-heading" class="sr-only">Super agents</h2>

  <% if @agents.empty? %>
    <%= render PanelsUI::EmptyState.new(
          icon: "briefcase",
          title: "No super agents yet",
          description: "Add a super agent to start bringing in hotels.") %>
  <% else %>
    <%= render PanelsUI::Table.new(
          caption: "Super agents",
          density: :compact,
          header_style: :sentence,
          hoverable: true,
          wrapper_class: "rounded-md border border-border bg-card") do |table| %>
      <% table.with_header do %>
        <tr>
          <th scope="col">Name</th>
          <th scope="col" class="hidden md:table-cell">Email</th>
          <th scope="col">Code</th>
          <th scope="col">Hotels</th>
          <th scope="col">Can create hotels</th>
          <th scope="col" class="text-right"><span class="sr-only">Actions</span></th>
        </tr>
      <% end %>

      <% table.with_body do %>
        <% @agents.each do |agent| %>
          <tr>
            <td class="font-medium text-foreground"><%= agent.name %></td>
            <td class="hidden text-muted-foreground md:table-cell"><%= agent.email %></td>
            <td class="font-mono"><%= agent.agent_code %></td>
            <td class="tabular-nums"><%= agent.created_hotels.size %></td>
            <td>
              <%= form_with model: agent, url: admin_super_agent_path(agent), method: :patch, id: "super-agent-#{agent.id}-create-hotels",
                    data: { controller: "auto-submit" } do |builder| %>
                <%= render PanelsUI::Switch.new(
                      form: builder,
                      attribute: :can_create_hotels,
                      id: "super_agent_#{agent.id}_can_create_hotels",
                      label: "#{agent.name} can create hotels",
                      label_hidden: true,
                      size: :sm,
                      tone: :success,
                      data: { action: "change->auto-submit#submitNow" }) %>
              <% end %>
            </td>
            <td class="text-right">
              <%= form_with url: admin_super_agent_path(agent), method: :delete, class: "inline",
                    data: {
                      turbo_confirm: "Remove #{agent.name}? They lose access to the hotels they created. The hotels stay.",
                      turbo_confirm_title: "Remove super agent",
                      turbo_confirm_color: "red"
                    } do %>
                <%= render PanelsUI::Button.new(as: :button, type: :submit, variant: :destructive, size: :sm) do %>
                  Remove
                <% end %>
              <% end %>
            </td>
          </tr>
        <% end %>
      <% end %>
    <% end %>
  <% end %>
</section>

<%= turbo_frame_tag "admin_super_agent_action_sheet" %>
