<div class="w-full space-y-6">
  <%= render PanelsUI::PageHeader.new(
        title: "Import reservations",
        description: "Bring #{@hotel.name}'s unarrived reservations across from its previous PMS. Nothing is created until you review what the file contains.") %>

  <section class="rounded-2xl border border-border bg-card p-6 shadow-sm">
    <%= form_with url: admin_hotel_reservation_imports_path(@hotel), method: :post,
                  multipart: true, class: "space-y-5" do %>
      <div>
        <label for="file" class="block text-sm font-bold text-foreground">Reservation list export</label>
        <p class="mt-1 text-xs text-muted-foreground">
          An eZee <span class="font-semibold">Reservation List</span> report, as
          <code>.xls</code>, <code>.xlsx</code> or <code>.csv</code>. Export it filtered to
          active reservations.
        </p>
        <input type="file" name="file" id="file" required
               accept=".xls,.xlsx,.csv"
               class="mt-3 block w-full rounded-xl border border-border bg-background px-4 py-2.5 text-sm text-foreground file:mr-4 file:rounded-lg file:border-0 file:bg-muted file:px-3 file:py-1.5 file:text-sm file:font-bold file:text-foreground">
      </div>

      <div class="rounded-xl border border-border bg-muted/40 p-4 text-xs text-muted-foreground">
        <p class="font-bold text-foreground">What the import will and will not do</p>
        <ul class="mt-2 list-disc space-y-1 pl-4">
          <li>Only reservations arriving on or after the property's business date are imported. Past arrivals are reported and skipped.</li>
          <li>The amount printed on the export is the amount charged. Tourism tax is not added, because the export carries no nationality.</li>
          <li>Money already collected in the old system is recorded as a note, not as a payment here.</li>
          <li>Rows already imported are matched on their old reservation number and left alone, so the file can be re-uploaded safely.</li>
        </ul>
      </div>

      <%= render PanelsUI::Button.new(as: :button, type: :submit, variant: :primary) do %>
        Review the file
      <% end %>
    <% end %>
  </section>
</div>
