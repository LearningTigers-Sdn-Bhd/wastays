<% importable = @counts["importable"].to_i %>
<div class="w-full space-y-6">
  <%= render PanelsUI::PageHeader.new(
        title: "Review this import",
        description: "#{@hotel.name} — nothing has been created yet.") %>

  <section class="grid grid-cols-2 gap-4 lg:grid-cols-5">
    <% [ [ "Total detected", @total_rows, "text-foreground" ],
         [ "Will import", importable, "text-foreground" ],
         [ "Needs attention", @attention_count, @attention_count.positive? ? "text-red-700" : "text-muted-foreground" ],
         [ "Already imported", @counts["imported"].to_i, "text-muted-foreground" ],
         [ "Arrival in the past", @counts["past"].to_i, "text-muted-foreground" ] ].each do |label, value, tone| %>
      <div class="rounded-2xl border border-border bg-card p-5 shadow-sm">
        <p class="text-xs font-bold uppercase tracking-wide text-muted-foreground"><%= label %></p>
        <p class="mt-1 text-3xl font-bold tabular-nums <%= tone %>"><%= number_with_delimiter(value) %></p>
      </div>
    <% end %>
  </section>

  <section class="rounded-2xl border border-border bg-card p-6 shadow-sm">
    <dl class="grid grid-cols-2 gap-4 text-sm lg:grid-cols-5">
      <div>
        <dt class="text-xs font-bold uppercase tracking-wide text-muted-foreground">Imported by</dt>
        <dd class="mt-1 font-bold text-foreground"><%= @import.user.name %></dd>
      </div>
      <div>
        <dt class="text-xs font-bold uppercase tracking-wide text-muted-foreground">Business date</dt>
        <dd class="mt-1 font-bold text-foreground"><%= @business_date %></dd>
      </div>
      <div>
        <dt class="text-xs font-bold uppercase tracking-wide text-muted-foreground">Value imported</dt>
        <dd class="mt-1 font-bold text-foreground"><%= number_to_currency(@total_value, unit: "RM ") %></dd>
      </div>
      <div>
        <dt class="text-xs font-bold uppercase tracking-wide text-muted-foreground">Multi-room groups</dt>
        <dd class="mt-1 font-bold text-foreground"><%= @group_count %></dd>
      </div>
      <div>
        <dt class="text-xs font-bold uppercase tracking-wide text-muted-foreground">Agencies</dt>
        <dd class="mt-1 font-bold text-foreground">
          <%= @matched_agencies.size %> matched, <%= @new_agencies.size %> new
        </dd>
      </div>
    </dl>
  </section>

  <% if @agency_collisions.any? %>
    <section class="rounded-2xl border border-amber-200 bg-amber-50 p-5 text-sm text-amber-900">
      <p class="font-bold">Spellings that will share one agency account</p>
      <p class="mt-1 text-xs">
        The export writes these differently; the import treats them as the same agency
        and names the account after the marked spelling.
      </p>
      <ul class="mt-3 space-y-3">
        <% @agency_collisions.each do |collision| %>
          <li>
            <ul class="space-y-1">
              <% collision.spellings.each do |spelling| %>
                <%# Whitespace is preserved on purpose: one pair differs only by
                    a double space, which HTML would collapse into an apparent
                    duplicate. %>
                <% chosen = spelling == collision.canonical %>
                <li class="flex flex-wrap items-baseline gap-2">
                  <code class="whitespace-pre-wrap rounded px-1.5 py-0.5 font-mono text-xs <%= chosen ? "bg-amber-200 font-bold" : "bg-amber-100" %>"><%= spelling %></code>
                  <% if chosen %>
                    <span class="rounded-full bg-amber-900 px-2 py-0.5 text-xs font-bold text-amber-50">account name</span>
                  <% end %>
                  <% if collision.whitespace_only?(spelling) %>
                    <span class="text-xs italic">differs only in spacing</span>
                  <% end %>
                </li>
              <% end %>
            </ul>
          </li>
        <% end %>
      </ul>
    </section>
  <% end %>

  <% if @new_agencies.any? %>
    <section class="rounded-2xl border border-border bg-card p-6 shadow-sm">
      <h2 class="text-sm font-bold text-foreground"><%= pluralize(@new_agencies.size, "agency") %> will be created</h2>
      <p class="mt-1 text-xs text-muted-foreground">
        Created without credit terms or direct billing — set those deliberately afterwards.
      </p>
      <ul class="mt-3 grid gap-1 text-sm text-foreground lg:grid-cols-2">
        <% @new_agencies.sort.each do |name| %>
          <li class="truncate"><%= name %></li>
        <% end %>
      </ul>
    </section>
  <% end %>

  <section class="overflow-hidden rounded-2xl border border-border bg-card shadow-sm">
    <div class="flex flex-wrap items-center justify-between gap-3 border-b border-border px-4 py-3">
      <h2 class="text-sm font-bold text-foreground">Reservations</h2>
      <%# Rows are neutral by default and coloured only where something is
          wrong. At this size almost every row is fine, so painting those green
          would bury the handful that are not. %>
      <nav class="flex flex-wrap gap-1.5">
        <% [ [ "attention", "Needs attention", @attention_count ],
             [ "all", "All", @import.rows.size ],
             [ "importable", "Will import", importable ],
             [ "imported", "Already imported", @counts["imported"].to_i ],
             [ "past", "Past", @counts["past"].to_i ] ].each do |key, label, count| %>
          <% next if count.to_i.zero? && key != "all" %>
          <% on = @filter == key %>
          <%= link_to admin_hotel_reservation_import_path(@hotel, @import, filter: key, q: @q),
                class: "rounded-full px-3 py-1.5 text-xs font-bold #{on ? 'bg-primary text-primary-foreground' : 'border border-border text-foreground hover:bg-muted'}",
                data: { turbo_frame: "import_reservations_results", turbo_action: "advance" } do %>
            <%= label %> <span class="tabular-nums opacity-70"><%= number_with_delimiter(count) %></span>
          <% end %>
        <% end %>
      </nav>
    </div>

    <%# Deliberately no filter field here -- a search looks across every
        status. Carrying whatever tab happened to be active in would make a
        match outside that tab look like the search found nothing. The
        status tabs below still narrow a search once it is running.
        auto-submit debounces and resubmits as the operator types, and
        turbo_frame scopes the response to just the table below, so the
        page does not jump or need Enter pressed. %>
    <%= form_with url: admin_hotel_reservation_import_path(@hotel, @import), method: :get,
          class: "flex flex-wrap items-center gap-3 border-b border-border px-4 py-3",
          data: { controller: "auto-submit", turbo_frame: "import_reservations_results", turbo_action: "advance" } do %>
      <div class="relative max-w-xl flex-1">
        <%= cached_icon "search", class: "pointer-events-none absolute left-3.5 top-1/2 size-4 -translate-y-1/2 text-muted-foreground", aria: { hidden: true } %>
        <%= text_field_tag :q, @q, placeholder: "Search…",
              class: "form-input w-full py-2.5 pl-10 text-sm", autocomplete: "off",
              data: { action: "input->auto-submit#submit" } %>
      </div>
      <% if @q.present? %>
        <%= link_to "Clear", admin_hotel_reservation_import_path(@hotel, @import),
              class: "text-xs font-bold text-muted-foreground hover:text-foreground",
              data: { turbo_frame: "import_reservations_results" } %>
      <% end %>
    <% end %>

    <%= turbo_frame_tag "import_reservations_results" do %>
      <div class="overflow-x-auto">
        <div class="min-w-[74rem]">
          <div class="grid grid-cols-[6rem_minmax(11rem,1fr)_8rem_14rem_4rem_6rem_7.5rem_7rem_10rem] bg-muted/40 text-xs font-bold uppercase tracking-wide text-muted-foreground">
            <div class="px-3 py-2.5">Rsrv. no</div>
            <div class="px-3 py-2.5">Booked by</div>
            <div class="px-3 py-2.5">Source</div>
            <div class="px-3 py-2.5">Stay</div>
            <div class="px-3 py-2.5">Pax</div>
            <div class="px-3 py-2.5">Room</div>
            <div class="px-3 py-2.5">Category</div>
            <div class="px-3 py-2.5 text-right">Amount</div>
            <div class="px-3 py-2.5">Status</div>
          </div>
          <%= render "admin/hotels/reservation_imports/rows_page",
                     hotel: @hotel, import: @import, rows: @rows,
                     filter: @filter, q: @q, page: @page, more: @more %>
        </div>
      </div>
    <% end %>
  </section>

  <div class="flex flex-wrap items-center gap-3">
    <%= form_with url: commit_admin_hotel_reservation_import_path(@hotel, @import), method: :post do %>
      <%= render PanelsUI::Button.new(as: :button, type: :submit, variant: :primary,
                                      disabled: importable.zero?) do %>
        Import <%= pluralize(importable, "reservation") %>
      <% end %>
    <% end %>
    <%= link_to "Choose a different file", new_admin_hotel_reservation_import_path(@hotel),
                class: "rounded-xl border border-border px-4 py-2.5 text-sm font-bold text-foreground hover:bg-muted" %>
  </div>
</div>
