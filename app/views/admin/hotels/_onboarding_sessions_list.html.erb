<div id="onboarding_sessions_list" class="space-y-4">
  <% if sessions.any? %>
    <h3 class="text-xs font-bold uppercase tracking-[0.1em] text-muted-foreground">Session History</h3>
    <% sessions.each do |session| %>
      <div class="mt-3">
        <%= render "admin/hotels/onboarding_session", session: session, hotel: hotel %>
      </div>
    <% end %>
  <% else %>
    <p class="text-sm text-muted-foreground italic py-4">No onboarding info saved yet.</p>
  <% end %>
</div>
