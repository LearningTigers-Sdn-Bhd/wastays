<%= form_with model: [:admin, hotel], local: true, class: "space-y-0" do |f| %>
  <% cancel_path = admin_hotel_form_cancel_path(hotel) %>
  <% input_classes = "w-full rounded-xl border border-slate-200 bg-white px-4 py-2.5 text-sm font-medium text-slate-700 placeholder:text-slate-400 focus:border-slate-300 focus:outline-none focus:ring-0" %>

  <div class="px-6 py-6 sm:px-8">
    <% if hotel.errors.any? %>
      <div class="mb-6 rounded-2xl border border-red-200 bg-red-50 px-4 py-4 text-sm text-red-700">
        <h3 class="font-semibold text-red-900"><%= pluralize(hotel.errors.count, 'issue') %> blocked this hotel from being saved.</h3>
        <ul class="mt-3 list-disc space-y-1 pl-5">
          <% hotel.errors.full_messages.each do |msg| %>
            <li><%= msg %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <div class="space-y-8">
      <section class="space-y-5">
        <div>
          <h2 class="text-lg font-bold tracking-tight text-slate-950 sm:text-xl">Property Profile</h2>
          <p class="mt-1 text-sm font-medium text-slate-600">Capture the hotel identity, location, and basic commercial profile.</p>
        </div>

        <div class="grid gap-5 sm:grid-cols-2">
          <div>
            <label for="hotel_name" class="mb-2 block text-sm font-medium text-slate-700">Hotel Name</label>
            <%= f.text_field :name, id: "hotel_name", class: input_classes %>
          </div>

          <div>
            <label for="star_rating" class="mb-2 flex items-center gap-2 text-sm font-medium text-slate-700">
              <%= cached_icon "star", class: "size-4 text-amber-500", fill: "currentColor", stroke: "none" %>
              Star Rating
            </label>
            <%= f.select :star_rating, (1..5).map { |rating| ["#{rating} #{'★' * rating}", rating] }, { include_blank: "Select Rating" }, class: input_classes %>
          </div>

          <div>
            <label for="hotel_prefix" class="mb-2 block text-sm font-medium text-slate-700">Hotel Prefix</label>
            <%= f.text_field :hotel_prefix, placeholder: "e.g. SPH", maxlength: 6, minlength: 3, class: input_classes %>
            <p class="mt-1 text-xs text-slate-400">3-6 uppercase letters/numbers. Prefixes receipt, folio, invoice, reservation, and guest registration numbers (e.g. SPH-10000001). Must be unique.</p>
          </div>

          <% if hotel.persisted? %>
            <div>
              <label for="hotel_plan_id" class="mb-2 block text-sm font-medium text-slate-700">Subscription Plan</label>
              <%= select_tag "hotel[plan_id]",
                    options_from_collection_for_select(@plans, :id, :name, hotel.plan_id),
                    include_blank: "— No plan —",
                    id: "hotel_plan_id",
                    class: input_classes %>
              <p class="mt-1 text-xs text-slate-400">Controls which features this hotel can access. Manage feature gating in Plan Access.</p>
            </div>
          <% end %>

          <div class="sm:col-span-2">
            <label for="address" class="mb-2 block text-sm font-medium text-slate-700">Address</label>
            <%= f.text_area :address, rows: 3, class: "#{input_classes} min-h-[112px]" %>
          </div>

          <div>
            <label for="city" class="mb-2 block text-sm font-medium text-slate-700">City</label>
            <%= f.text_field :city, class: input_classes %>
          </div>

          <div>
            <label for="country" class="mb-2 block text-sm font-medium text-slate-700">Country</label>
            <%= f.text_field :country, class: input_classes %>
          </div>

          <div class="sm:col-span-2">
            <div data-controller="multi-select-dropdown"
                 data-multi-select-dropdown-selected-value="<%= (hotel.amenities || []).to_json %>"
                 data-multi-select-dropdown-all-value="<%= Hotel::HOTEL_AMENITIES.to_json %>"
                 data-action="click@window->multi-select-dropdown#hideDropdown">
              <label class="mb-2 block text-sm font-medium text-slate-700">Property Amenities</label>

              <div class="relative">
                <input type="hidden" name="hotel[amenities][]" value="">
                <div class="min-h-[52px] w-full rounded-xl border border-slate-200 bg-white p-2 flex flex-wrap items-center gap-2 focus-within:border-slate-400 focus-within:ring-2 focus-within:ring-slate-300 transition-all cursor-text"
                     data-action="click->multi-select-dropdown#focusInput">
                  <div class="flex flex-wrap gap-2" data-multi-select-dropdown-target="pillsContainer">
                    <!-- Pills will be rendered here by Stimulus -->
                  </div>
                  
                  <input type="text" 
                         class="flex-grow min-w-[150px] border-none bg-transparent focus:ring-0 focus:outline-none text-sm text-slate-900 placeholder:text-slate-400" 
                         data-multi-select-dropdown-target="input"
                         data-action="input->multi-select-dropdown#filterOptions focus->multi-select-dropdown#openDropdown click->multi-select-dropdown#stopProp keydown->multi-select-dropdown#navigate">

                  <div class="ml-auto pr-2">
                    <%= cached_icon "chevron-down", class: "w-4 h-4 text-slate-400 transition-transform duration-200", data: { multi_select_dropdown_target: "chevron" } %>
                  </div>
                </div>

                <!-- Dropdown Options with Categories -->
                <div class="absolute z-50 mt-2 w-full max-h-80 overflow-y-auto rounded-xl border border-slate-200 bg-white shadow-xl hidden custom-scrollbar" 
                     data-multi-select-dropdown-target="dropdown">
                  <% categorized_hotel_amenities.each do |cat| %>
                    <div data-category-container data-category-name="<%= cat[:category] %>" class="border-b border-slate-100 last:border-0">
                      <button type="button" 
                              class="w-full flex items-center justify-between px-4 py-3 text-xs font-black uppercase tracking-widest text-slate-500 bg-slate-50/50 hover:bg-slate-50 transition-colors"
                              data-action="click->multi-select-dropdown#toggleCategory">
                        <span><%= cat[:category] %></span>
                        <%= cached_icon "chevron-down", stroke_width: 2.5, class: "size-3.5 text-slate-400 transition-transform duration-200", "data-category-chevron" => true %>
                      </button>
                      
                      <div class="hidden bg-white" data-category-content>
                       <% cat[:items].each do |amenity| %>
                          <label class="w-full flex items-center px-6 py-3 text-sm text-slate-700 hover:bg-slate-50 transition-colors border-b border-slate-50 last:border-0 cursor-pointer"
                                  data-multi-select-dropdown-target="option"
                                  data-name="<%= amenity[:name] %>"
                                  data-id="<%= amenity[:id] %>">
                             <input type="checkbox" 
                                    class="rounded border-slate-300 text-slate-900 focus:ring-slate-400 mr-3"
                                    data-id="<%= amenity[:id] %>"
                                    data-action="change->multi-select-dropdown#toggle"
                                    data-multi-select-dropdown-target="checkbox">
                             <span><%= amenity[:name] %></span>
                          </label>
                        <% end %>
                      </div>
                    </div>
                  <% end %>
                  <div class="p-8 text-center hidden" data-multi-select-dropdown-target="placeholder">
                    <p class="text-sm text-slate-400 italic">No amenities found matching your search.</p>
                  </div>
                </div>
              </div>

              <!-- Template for Pills -->
              <template data-multi-select-dropdown-target="template">
                <div class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-slate-900 text-white text-xs font-semibold">
                  <span data-name></span>
                  <button type="button" 
                          class="hover:text-slate-300 transition-colors"
                          data-remove-id
                          data-action="click->multi-select-dropdown#remove">
                    <%= cached_icon "x", class: "size-3.5" %>
                  </button>
                  <input type="hidden" name="hotel[amenities][]" value="">
                </div>
              </template>
            </div>
          </div>

          <div>
            <label for="preferred_channel_manager" class="mb-2 block text-sm font-medium text-slate-700">Preferred Channel Manager</label>
            <%= f.select :preferred_channel_manager, [["None", ""], ["Channel Manager", "channex"]], {}, class: input_classes %>
          </div>

          <div>
            <label for="hotel_default_currency" class="mb-2 block text-sm font-medium text-slate-700">Default Currency</label>
            <%= f.select :default_currency, CurrencyCatalog.options, {}, class: input_classes %>
            <p class="mt-1 text-xs text-slate-400">The primary accounting and sell currency for this property.</p>
          </div>

          <div>
            <span class="mb-2 block text-sm font-medium text-slate-700">Per-Pax Pricing Feature</span>
            <label class="flex h-[46px] w-full items-center justify-between rounded-xl border border-slate-200 bg-white px-4 cursor-pointer">
              <span class="text-xs text-slate-600">Allow Hotel to Use Per-Pax Pricing</span>
              <span class="relative inline-flex items-center">
                <%= f.check_box :allow_pax_pricing, class: "sr-only peer" %>
                <span class="peer h-6 w-11 rounded-full bg-gray-200 transition after:absolute after:left-[2px] after:top-[2px] after:h-5 after:w-5 after:rounded-full after:bg-white after:transition-all after:content-[''] peer-checked:bg-blue-600 peer-checked:after:translate-x-full"></span>
              </span>
            </label>
            <p class="mt-1 text-xs text-slate-400">If enabled, the hotel portal can choose to restrict bookings to per-person rates.</p>
          </div>

          <div>
            <span class="mb-2 block text-sm font-medium text-slate-700">Boat Information Feature</span>
            <label class="flex h-[46px] w-full items-center justify-between rounded-xl border border-slate-200 bg-white px-4 cursor-pointer">
              <span class="text-xs text-slate-600">Allow Boat Information Record</span>
              <span class="relative inline-flex items-center">
                <%= f.check_box :allow_boat_information, class: "sr-only peer" %>
                <span class="peer h-6 w-11 rounded-full bg-gray-200 transition after:absolute after:left-[2px] after:top-[2px] after:h-5 after:w-5 after:rounded-full after:bg-white after:transition-all after:content-[''] peer-checked:bg-blue-600 peer-checked:after:translate-x-full"></span>
              </span>
            </label>
            <p class="mt-1 text-xs text-slate-400">If enabled, the hotel can record boat arrivals and departures for stayed guests.</p>
          </div>

          <% if hotel.persisted? %>
            <div class="sm:col-span-2">
              <div class="grid gap-5 sm:grid-cols-2">
                <div>
                  <label for="hotel_salesperson_name" class="mb-2 block text-sm font-medium text-slate-700">Salesperson Name</label>
                  <%= text_field_tag "hotel[salesperson_name]", hotel.salesperson&.name, id: "hotel_salesperson_name", class: input_classes, placeholder: "Enter salesperson name" %>
                </div>

                <div>
                  <label for="hotel_salesperson_email" class="mb-2 block text-sm font-medium text-slate-700">Salesperson Email</label>
                  <%= email_field_tag "hotel[salesperson_email]", hotel.salesperson&.email, id: "hotel_salesperson_email", class: input_classes, placeholder: "email@example.com" %>
                </div>
              </div>
            </div>
          <% end %>
        </div>
      </section>

      <% unless hotel.persisted? %>
        <section class="space-y-5 border-t border-slate-200 pt-8">
          <div>
            <h2 class="text-lg font-bold tracking-tight text-slate-950 sm:text-xl">Account Credentials</h2>
            <p class="mt-1 text-sm font-medium text-slate-600">A dedicated account will be created for this hotel.</p>
          </div>

          <div class="grid gap-5 sm:grid-cols-2">
            <div class="sm:col-span-2">
              <label for="account_name" class="mb-2 block text-sm font-medium text-slate-700">Company / Group Name</label>
              <%= text_field_tag "account[name]", params.dig(:account, :name), id: "account_name", required: true, class: input_classes %>
            </div>

            <div>
              <label for="user_name" class="mb-2 block text-sm font-medium text-slate-700">Owner Full Name</label>
              <%= text_field_tag "user[name]", params.dig(:user, :name), id: "user_name", required: true, class: input_classes %>
            </div>

            <div>
              <label for="user_email" class="mb-2 block text-sm font-medium text-slate-700">Account Email</label>
              <%= email_field_tag "user[email]", params.dig(:user, :email), id: "user_email", required: true, class: input_classes %>
            </div>

            <div class="sm:col-span-2">
              <label for="default_password" class="mb-2 block text-sm font-medium text-slate-700">Default Password</label>
              <%= password_field_tag :default_password, HotelOps::CreateHotel::DEFAULT_PASSWORD, id: "default_password", readonly: true, class: "w-full rounded-xl border border-slate-200 bg-slate-100 px-4 py-2.5 text-sm font-medium text-slate-500" %>
              <p class="mt-2 text-sm text-slate-500">This password is assigned automatically when the hotel account is created.</p>
            </div>
          </div>
        </section>
      <% end %>
    </div>
  </div>

  <div class="flex flex-col gap-3 border-t border-slate-200 bg-slate-50/70 px-6 py-5 sm:flex-row sm:items-center sm:justify-end sm:px-8">
    <%= link_to "Cancel", cancel_path, class: "inline-flex items-center justify-center rounded-xl border border-slate-200 bg-white px-4 py-2.5 text-sm font-semibold text-slate-700 shadow-sm transition hover:border-slate-300 hover:bg-slate-100" %>
    <%= f.submit hotel.persisted? ? "Update Hotel" : "Create Hotel", class: "inline-flex items-center justify-center rounded-xl bg-blue-600 px-4 py-2.5 text-sm font-semibold text-white transition hover:bg-blue-700 disabled:opacity-50 disabled:pointer-events-none" %>
  </div>
<% end %>
