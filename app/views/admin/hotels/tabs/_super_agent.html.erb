<div class="space-y-8 py-4">
  <div>
    <h2 class="text-base font-semibold">Super agent</h2>
    <p class="text-sm text-muted-foreground">Link this hotel to a super agent. The agent sees it in their list and can open it as General Manager. A changed or removed agent loses access.</p>
  </div>

  <%= form_with url: update_super_agent_admin_hotel_path(@hotel), method: :patch, scope: :super_agent, class: "space-y-4" do |form| %>
    <%= render PanelsUI::FieldSet.new(legend: "Linked super agent") do %>
      <%= render PanelsUI::FieldGroup.new do %>
        <%= render PanelsUI::FormField.new(form:, attribute: :id, label: "Super agent") do |field| %>
          <% field.with_select_menu(
               [ { label: "No super agent", value: "" } ] + @super_agents.map { |agent| { label: "#{agent.name} · #{agent.agent_code}", value: agent.id } },
               selected: (@hotel.created_by_user_id if @hotel.created_by_user&.super_agent?),
               prompt: "Select super agent") %>
        <% end %>
      <% end %>
    <% end %>
    <%= render PanelsUI::Button.new(as: :button, type: :submit) do %>Save super agent<% end %>
  <% end %>
</div>
