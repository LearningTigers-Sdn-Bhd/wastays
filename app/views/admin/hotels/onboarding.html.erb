<% content_for :breadcrumbs do %>
  <%= render "shared/navigation/admin_breadcrumbs", current: "Hotel Onboarding" %>
<% end %>

<div class="max-w-[1600px] mx-auto pb-20 space-y-6">
  <div>
    <%= link_to onboarding_admin_hotels_path, class: "inline-flex items-center gap-x-1.5 text-sm font-medium text-slate-500 transition hover:text-slate-900" do %>
      <svg class="size-4" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg>
      Back to Onboarding Tracker
    <% end %>
  </div>

  <div class="grid grid-cols-1 gap-6 xl:grid-cols-12">
    <!-- Main Column: Training Sessions -->
    <div class="space-y-6 xl:col-span-12">
      <!-- Hotel Header -->
      <section class="rounded-2xl border border-slate-200 bg-white shadow-sm">
        <div class="px-6 py-6 sm:px-8">
          <div class="flex items-center gap-3">
            <h1 class="text-2xl font-bold tracking-tight text-slate-950 sm:text-3xl"><%= @hotel.name %></h1>
            <span class="inline-flex items-center gap-x-1.5 rounded-full px-2.5 py-1 text-xs font-semibold bg-amber-50 text-amber-700 ring-1 ring-inset ring-amber-200">
              <%= @hotel.status.titleize %>
            </span>
          </div>
          <p class="mt-2 text-sm font-medium text-slate-600"><%= @hotel.city %>, <%= @hotel.country %></p>
        </div>
      </section>

      <!-- Training Sessions -->
      <section class="rounded-2xl border border-slate-200 bg-white shadow-sm">
        <div class="border-b border-slate-200 px-6 py-5 sm:px-8 flex items-center justify-between">
          <div>
            <h2 class="text-lg font-bold tracking-tight text-slate-950 sm:text-xl">Onboarding & Training</h2>
            <p class="mt-1 text-sm text-slate-500">Assign a team member, set a meeting link, and track the completion of the training session.</p>
          </div>
        </div>

        <div class="px-6 py-6 sm:px-8 space-y-6">
          <!-- Add Session Form -->
          <div class="rounded-xl border border-slate-200 bg-slate-50/50 p-4 sm:p-6">
            <h3 class="text-sm font-bold uppercase tracking-wider text-slate-700 mb-4">Schedule Training Session</h3>
            <%= form_with url: create_onboarding_session_admin_hotel_path(@hotel), class: "grid gap-4 sm:grid-cols-2 lg:grid-cols-4 items-end" do |f| %>
              <div class="sm:col-span-1">
                <label class="block text-xs font-semibold text-slate-600 mb-1">Onboarding Team Member</label>
                <%= f.text_field :trainer_name, placeholder: "Type name...", required: true, class: "w-full rounded-lg border-slate-200 text-sm" %>
              </div>
              <div class="sm:col-span-1">
                <label class="block text-xs font-semibold text-slate-600 mb-1">Date & Time</label>
                <%= f.datetime_field :scheduled_at, class: "w-full rounded-lg border-slate-200 text-sm" %>
              </div>
              <div class="lg:col-span-1">
                <label class="block text-xs font-semibold text-slate-600 mb-1">Meeting Link</label>
                <%= f.text_field :meeting_link, placeholder: "https://zoom.us/...", class: "w-full rounded-lg border-slate-200 text-sm" %>
              </div>
              <div>
                <%= f.submit "Save Training Info", class: "w-full inline-flex items-center justify-center rounded-lg bg-slate-900 px-4 py-2 text-sm font-semibold text-white transition hover:bg-slate-800" %>
              </div>
            <% end %>
          </div>

          <!-- Sessions List -->
          <div class="space-y-4">
            <% if @sessions.any? %>
              <h3 class="text-xs font-bold uppercase tracking-[0.1em] text-slate-500">Session History</h3>
              <% @sessions.each do |session| %>
                <div class="flex flex-col sm:flex-row sm:items-center justify-between p-4 rounded-xl border border-slate-200 gap-4">
                  <div class="flex items-center gap-4">
                    <div class="size-10 rounded-full bg-slate-100 flex items-center justify-center text-slate-600">
                      <svg class="size-5" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
                    </div>
                    <div>
                      <p class="text-sm font-bold text-slate-900"><%= session.trainer_name.capitalize %></p>
                      <p class="text-xs text-slate-500">Scheduled: <%= session.scheduled_at.strftime("%d %b %Y at %I:%M %p") %></p>
                    </div>
                  </div>

                  <div class="flex flex-wrap items-center gap-3">
                    <% if session.meeting_link.present? %>
                      <%= link_to session.formatted_meeting_link, target: "_blank", class: "inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-blue-50 text-blue-700 text-xs font-semibold border border-blue-100 hover:bg-blue-100 transition" do %>
                        <svg class="size-3.5" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/></svg>
                        Join Call
                      <% end %>
                    <% end %>

                    <% if session.status == 'scheduled' %>
                      <%= button_to complete_onboarding_session_admin_hotel_path(@hotel, session_id: session.id), class: "inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-emerald-50 text-emerald-700 text-xs font-semibold border border-emerald-100 hover:bg-emerald-100 transition" do %>
                        <svg class="size-3.5" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>
                        Mark Completed
                      <% end %>
                    <% else %>
                      <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-emerald-500 text-white text-xs font-semibold border border-emerald-600">
                        Completed at <%= session.completed_at&.strftime("%d %b, %H:%M") %>
                      </span>
                    <% end %>
                  </div>
                </div>
              <% end %>
            <% else %>
              <p class="text-sm text-slate-500 italic py-4">No onboarding info saved yet.</p>
            <% end %>
          </div>
          <%= render "onboarding_sessions_list", sessions: @sessions, hotel: @hotel %>
        </div>
      </section>
    </div>
  </div>
</div>
