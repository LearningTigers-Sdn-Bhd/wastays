<div class="max-w-[1600px] mx-auto pb-20 space-y-8">
  <div class="px-4 md:px-0">
    <div class="mt-5 flex flex-col gap-4 lg:flex-row lg:items-end lg:justify-between">
      <div>
        <h1 class="text-2xl font-bold tracking-tight text-slate-950 sm:text-3xl">Onboarding Tracker</h1>
        <p class="mt-1 text-sm font-medium text-slate-600">Track training and readiness for hotels to go live.</p>
      </div>
    </div>
  </div>

  <div data-controller="onboarding-tracker-filter" class="space-y-4">
    <div class="rounded-2xl border border-slate-200 bg-white p-4 shadow-sm">
      <div class="grid gap-4 lg:grid-cols-12">
        <div class="lg:col-span-5">
          <label class="mb-1.5 block text-[10px] font-bold uppercase tracking-widest text-slate-500">
            Search hotels, city, trainer
          </label>
          <input type="search"
                 placeholder="Type hotel, city, or trainer name..."
                 autocomplete="off"
                 data-onboarding-tracker-filter-target="search"
                 data-action="input->onboarding-tracker-filter#filter"
                 class="w-full rounded-2xl border-slate-200 bg-slate-50 px-4 py-3 text-sm font-medium text-slate-900 placeholder:text-slate-400 focus:border-blue-500 focus:bg-white focus:ring-0">
        </div>

        <div class="lg:col-span-2">
          <label class="mb-1.5 block text-[10px] font-bold uppercase tracking-widest text-slate-500">
            Sort onboarding period
          </label>
          <select data-onboarding-tracker-filter-target="sort"
                  data-action="change->onboarding-tracker-filter#sort"
                  class="w-full appearance-none rounded-2xl border-slate-200 bg-slate-50 px-4 py-2 text-sm font-medium text-slate-900 focus:border-blue-500 focus:bg-white focus:ring-0">
            <option value="shortest_first" selected>Shortest to Longest</option>
            <option value="longest_first">Longest to Shortest</option>
          </select>
        </div>

        <div class="grid gap-4 sm:grid-cols-2 lg:col-span-4">
          <div>
            <label class="mb-1.5 block text-[10px] font-bold uppercase tracking-widest text-slate-500">
              From date
            </label>
            <input type="date"
                   data-onboarding-tracker-filter-target="startDate"
                   data-action="change->onboarding-tracker-filter#filter input->onboarding-tracker-filter#filter"
                   class="w-full rounded-2xl border-slate-200 bg-slate-50 px-4 py-3 text-sm font-medium text-slate-900 focus:border-blue-500 focus:bg-white focus:ring-0">
          </div>

          <div>
            <label class="mb-1.5 block text-[10px] font-bold uppercase tracking-widest text-slate-500">
              To date
            </label>
            <input type="date"
                   data-onboarding-tracker-filter-target="endDate"
                   data-action="change->onboarding-tracker-filter#filter input->onboarding-tracker-filter#filter"
                   class="w-full rounded-2xl border-slate-200 bg-slate-50 px-4 py-3 text-sm font-medium text-slate-900 focus:border-blue-500 focus:bg-white focus:ring-0">
          </div>
        </div>

        <div class="flex items-end lg:col-span-1">
          <button type="button"
                  data-action="click->onboarding-tracker-filter#clear"
                  class="inline-flex w-full items-center justify-center rounded-2xl border border-slate-200 bg-white px-4 py-3 text-sm font-semibold text-slate-700 transition hover:bg-slate-50">
            Clear
          </button>
        </div>
      </div>
    </div>

    <div class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">
      <%= render "admin/hotels/onboarding_tracker_table", hotels: @hotels %>
    </div>
  </div>
</div>
