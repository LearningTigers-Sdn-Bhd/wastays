<div class="w-full space-y-6">
  <div>
    <%= link_to onboarding_admin_hotels_path, class: "inline-flex items-center gap-x-1.5 text-sm font-medium text-muted-foreground transition hover:text-foreground" do %>
      <svg class="size-4" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg>
      Back to Onboarding Tracker
    <% end %>
  </div>

  <div class="grid grid-cols-1 gap-6 xl:grid-cols-12">
    <!-- Main Column: Training Sessions -->
    <div class="space-y-6 xl:col-span-12">
      <!-- Hotel Header -->
      <section class="rounded-2xl border border-border bg-card shadow-sm">
        <div class="px-6 py-6 sm:px-8">
          <%= render PanelsUI::PageHeader.new(
                title: safe_join([
                  @hotel.name,
                  tag.span(@hotel.status.titleize, class: "inline-flex items-center gap-x-1.5 rounded-full px-2.5 py-1 text-xs font-semibold bg-amber-50 text-amber-700 ring-1 ring-inset ring-amber-200")
                ], " ")) do |header| %>
            <% header.with_caption do %>
              <%= @hotel.city %>, <%= @hotel.country %>
            <% end %>
          <% end %>
        </div>
      </section>

      <!-- Training Sessions -->
      <section class="rounded-2xl border border-border bg-card shadow-sm">
        <div class="border-b border-border px-6 py-5 sm:px-8 flex items-center justify-between">
          <div>
            <h2 class="text-lg font-bold tracking-tight text-foreground sm:text-xl">Onboarding & Training</h2>
            <p class="mt-1 text-sm text-muted-foreground">Assign a team member, set a meeting link, and track the completion of the training session.</p>
          </div>
        </div>

        <div class="px-6 py-6 sm:px-8 space-y-6">
          <!-- Add Session Form -->
          <%= render "admin/hotels/onboarding_session_form", session: OnboardingSession.new %>

          <!-- Sessions List -->
          <%= render "admin/hotels/onboarding_sessions_list", sessions: @sessions, hotel: @hotel %>
        </div>
      </section>
    </div>
  </div>
</div>
