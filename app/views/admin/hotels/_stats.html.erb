<% pending_hotels = all_hotels.count { |hotel| hotel.status == "pending_review" } %>
<% active_hotels = all_hotels.count { |hotel| ["approved", "live"].include?(hotel.status) } %>
<% suspended_hotels = all_hotels.count { |hotel| hotel.status == "suspended" } %>

<div class="grid grid-cols-1 overflow-hidden rounded-2xl border border-border bg-card shadow-sm md:grid-cols-4">
  <div class="p-6 md:border-r md:border-border md:p-8">
    <p class="mb-2 text-[11px] font-semibold uppercase tracking-[0.08em] text-muted-foreground">Total Hotels</p>
    <h2 class="text-3xl font-bold tabular-nums tracking-tight text-foreground"><%= all_hotels.size %></h2>
    <p class="mt-2 text-sm font-medium text-muted-foreground">All registered hotel accounts</p>
  </div>

  <div class="bg-muted/30 p-6 md:border-r md:border-border md:p-8">
    <p class="mb-2 text-[11px] font-semibold uppercase tracking-[0.08em] text-muted-foreground">Pending Review</p>
    <h2 class="text-3xl font-bold tabular-nums tracking-tight text-amber-600"><%= pending_hotels %></h2>
    <p class="mt-2 text-sm font-medium text-muted-foreground">Waiting for admin action</p>
  </div>

  <div class="p-6 md:border-r md:border-border md:p-8">
    <p class="mb-2 text-[11px] font-semibold uppercase tracking-[0.08em] text-muted-foreground">Approved / Live</p>
    <h2 class="text-3xl font-bold tabular-nums tracking-tight text-emerald-600"><%= active_hotels %></h2>
    <p class="mt-2 text-sm font-medium text-muted-foreground">Operational hotel accounts</p>
  </div>

  <div class="p-6 md:p-8">
    <p class="mb-2 text-[11px] font-semibold uppercase tracking-[0.08em] text-muted-foreground">Suspended</p>
    <h2 class="text-3xl font-bold tabular-nums tracking-tight text-rose-600"><%= suspended_hotels %></h2>
    <p class="mt-2 text-sm font-medium text-muted-foreground">Accounts needing follow-up</p>
  </div>
</div>
