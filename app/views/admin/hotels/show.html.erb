<% content_for :full_height_page, true %>
<div class="flex min-h-0 w-full flex-1 flex-col gap-4 overflow-hidden px-5 py-4">
  <% if (credentials = flash[:owner_credentials]).present? %>
    <%= render "admin/hotels/owner_credentials", credentials: credentials %>
  <% end %>
  <header class="flex flex-col gap-4 sm:flex-row sm:items-start sm:justify-between">
    <div class="flex min-w-0 items-start gap-3">
      <%= link_to admin_hotels_path, class: "mt-0.5 inline-flex size-8 shrink-0 items-center justify-center rounded-md border border-border text-muted-foreground hover:bg-muted focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring", aria: { label: "Back to hotels" } do %>
        <%= app_icon "arrow-left", class: "size-4", aria: { hidden: "true" } %>
      <% end %>
      <div class="min-w-0 space-y-1">
        <div class="flex flex-wrap items-center gap-2">
          <h1 class="min-w-0 truncate text-base font-semibold tracking-tight"><%= @hotel.name %></h1>
          <%= render PanelsUI::Badge.new(label: @hotel.status.humanize, variant: @hotel.status.in?(%w[live ready_to_launch]) ? :success : :warning, size: :sm) %>
        </div>
        <p class="text-xs text-muted-foreground"><%= [@hotel.city, @hotel.country].compact_blank.join(", ") %></p>
      </div>
    </div>
    <div class="flex flex-wrap items-center gap-2">
      <%= render PanelsUI::Button.new(href: hotel_dashboard_path(@hotel), variant: :secondary, target: "_blank", rel: "noopener") do %>
        Go to dashboard <%= app_icon "external-link", class: "size-4", aria: { hidden: "true" } %>
      <% end %>
      <%= render PanelsUI::DropdownMenu.new(id: "admin-hotel-actions", placement: :bottom_end, class: "w-64") do |menu| %>
        <% menu.with_trigger(variant: :primary, size: :md, aria_label: "More hotel actions") do %>
          More actions <%= app_icon "chevron-down", class: "size-4", aria: { hidden: "true" } %>
        <% end %>
        <% menu.with_item(href: admin_hotel_reservation_imports_path(@hotel)) { "Import reservations (eZee)" } %>
        <% if @hotel.status == "pending_review" %>
          <% menu.with_item(href: onboarding_admin_hotel_path(@hotel)) { "Review onboarding" } %>
          <% menu.with_item(href: approve_admin_hotel_path(@hotel), method: :post, variant: :success, form: { data: { turbo_confirm: "Approve #{@hotel.name}?" } }) { "Approve hotel" } %>
        <% elsif @hotel.status == "suspended" %>
          <% menu.with_item(href: approve_admin_hotel_path(@hotel), method: :post, variant: :success, form: { data: { turbo_confirm: "Reactivate #{@hotel.name} and its account?" } }) { "Reactivate" } %>
        <% else %>
          <% menu.with_item(href: suspend_admin_hotel_path(@hotel), method: :post, variant: :danger, form: { data: { turbo_confirm: "Suspend #{@hotel.name} and its account? It will no longer be bookable." } }) { "Suspend" } %>
        <% end %>
      <% end %>
    </div>
  </header>

  <%= render PanelsUI::Tabs.new(id: "admin-hotel-tabs", active: @active_tab, variant: :line, aria_label: "Hotel sections") do |tabs| %>
    <% Admin::HotelsController::TAB_LABELS.each do |tab, label| %>
      <% tabs.with_tab(name: tab, label:, icon: Admin::HotelsController::TAB_ICONS.fetch(tab), href: admin_hotel_path(@hotel, tab:)) %>
    <% end %>
  <% end %>
  <div class="min-h-0 flex-1 overflow-y-auto overscroll-contain custom-scrollbar" data-testid="admin-hotel-tab-content">
    <% case @active_tab %>
    <% when "room_inventory" %>
      <%= render "admin/hotels/tabs/room_inventory" %>
    <% when "channel_manager" %>
      <%= render "admin/hotels/tabs/channel_manager" %>
    <% when "account_information" %>
      <%= render "admin/hotels/tabs/account_information" %>
    <% when "banking_details" %>
      <%= render "admin/hotels/tabs/banking_details" %>
    <% when "salesperson" %>
      <%= render "admin/hotels/tabs/salesperson" %>
    <% else %>
      <%= render "admin/hotels/tabs/hotel_details" %>
    <% end %>
  </div>
</div>
