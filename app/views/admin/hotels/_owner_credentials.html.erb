<section class="rounded-2xl border border-amber-200 bg-amber-50/70 p-6 shadow-sm"
         data-controller="clipboard"
         aria-labelledby="owner-credentials-heading">
  <h2 id="owner-credentials-heading" class="text-base font-semibold text-amber-900">
    Owner sign-in details
  </h2>
  <p class="mt-1 text-sm text-amber-800">
    Copy these now and pass them to the owner. The password is shown once and cannot be
    retrieved later — if it is lost, create a new one from the owner's staff record.
  </p>

  <dl class="mt-4 grid gap-3 sm:grid-cols-2">
    <div class="rounded-xl border border-amber-200 bg-card px-4 py-3">
      <dt class="text-[11px] font-semibold uppercase tracking-[0.1em] text-muted-foreground">Email</dt>
      <dd class="mt-1 font-mono text-sm font-medium text-foreground"><%= credentials["email"] %></dd>
    </div>
    <div class="rounded-xl border border-amber-200 bg-card px-4 py-3">
      <dt class="text-[11px] font-semibold uppercase tracking-[0.1em] text-muted-foreground">Temporary password</dt>
      <dd class="mt-1 font-mono text-sm font-medium text-foreground"><%= credentials["password"] %></dd>
    </div>
  </dl>

  <div class="mt-4 flex flex-wrap items-center gap-3">
    <%= render PanelsUI::Button.new(
          as: :button,
          type: :button,
          variant: :secondary,
          size: :sm,
          data: {
            action: "click->clipboard#copy",
            clipboard_text_value: "#{credentials['email']} / #{credentials['password']}"
          }) do %>
      Copy email and password
    <% end %>
    <p class="text-sm text-amber-800" role="status" data-clipboard-target="status"></p>
  </div>

  <p class="mt-4 text-sm text-amber-800">
    Ask the owner to change it after their first sign-in, from
    <span class="font-medium">Account &rarr; My Profile</span>.
  </p>
</section>
