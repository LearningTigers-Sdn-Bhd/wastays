<%# recipient names who receives the details. reset_hint says whether this %>
<%# reader can set a new password later, in Account information. %>
<% recipient = local_assigns.fetch(:recipient, "owner") %>
<% reset_hint = local_assigns.fetch(:reset_hint, true) %>
<section class="rounded-md border border-border bg-card p-5"
         data-controller="clipboard"
         aria-labelledby="owner-credentials-heading">
  <h2 id="owner-credentials-heading" class="text-base font-semibold">
    <%= recipient.capitalize %> sign-in details
  </h2>
  <p class="mt-1 text-sm text-muted-foreground">
    Copy these now and pass them to the <%= recipient %>. The password is shown once and cannot be
    retrieved later.<% if reset_hint %> You can set a new password in Account information.<% end %>
  </p>

  <dl class="mt-4 grid gap-3 sm:grid-cols-3">
    <div class="rounded-md border border-border px-4 py-3">
      <dt class="text-sm font-medium text-muted-foreground">Sign-in link</dt>
      <dd class="mt-1 break-all font-mono text-sm font-medium text-foreground"><%= login_url %></dd>
    </div>
    <div class="rounded-md border border-border px-4 py-3">
      <dt class="text-sm font-medium text-muted-foreground">Email</dt>
      <dd class="mt-1 break-all font-mono text-sm font-medium text-foreground"><%= credentials["email"] %></dd>
    </div>
    <div class="rounded-md border border-border px-4 py-3">
      <dt class="text-sm font-medium text-muted-foreground">Temporary password</dt>
      <dd class="mt-1 font-mono text-sm font-medium text-foreground"><%= credentials["password"] %></dd>
    </div>
  </dl>

  <div class="mt-4 flex flex-wrap items-center gap-3">
    <%= render PanelsUI::Button.new(
          as: :button,
          type: :button,
          variant: :secondary,
          size: :sm,
          data: {
            action: "click->clipboard#copy",
            clipboard_text_value: "#{login_url}\n#{credentials['email']} / #{credentials['password']}"
          }) do %>
      Copy sign-in details
    <% end %>
    <p class="text-sm text-muted-foreground" role="status" data-clipboard-target="status"></p>
  </div>

  <p class="mt-4 text-sm text-muted-foreground">
    Ask the <%= recipient %> to change it after their first sign-in, from
    <span class="font-medium"><%= recipient == "owner" ? "Account → My Profile" : "My account" %></span>.
  </p>
</section>
