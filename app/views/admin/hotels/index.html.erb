<% content_for :breadcrumbs do %>
  <%= render "shared/navigation/admin_breadcrumbs", current: "Hotels" %>
<% end %>

<% total_hotels = @hotels.size %>
<% pending_hotels = @hotels.count { |hotel| hotel.status == "pending_review" } %>
<% active_hotels = @hotels.count { |hotel| ["approved", "live"].include?(hotel.status) } %>
<% suspended_hotels = @hotels.count { |hotel| hotel.status == "suspended" } %>

<div class="max-w-[1600px] mx-auto pb-20 space-y-8">
  <div class="px-4 md:px-0">
    <div class="mt-5 flex flex-col gap-4 lg:flex-row lg:items-end lg:justify-between">
      <div>
        <h1 class="text-2xl font-bold tracking-tight text-slate-950 sm:text-3xl">Manage Hotels</h1>
        <p class="mt-1 text-sm font-medium text-slate-600">Review hotel registrations, approvals, and account status across the platform.</p>
      </div>

      <%= link_to new_admin_hotel_path, class: "inline-flex items-center justify-center gap-x-2 rounded-xl bg-red-600 px-4 py-2.5 text-sm font-semibold text-white transition hover:bg-red-700" do %>
        <svg class="size-4" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="M12 5v14"/></svg>
        Add New Hotel
      <% end %>
    </div>
  </div>

  <div class="grid grid-cols-1 overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm md:grid-cols-4">
    <div class="p-6 md:border-r md:border-slate-200 md:p-8">
      <p class="mb-2 text-[11px] font-semibold uppercase tracking-[0.08em] text-slate-500">Total Hotels</p>
      <h2 class="text-3xl font-bold tabular-nums tracking-tight text-slate-950"><%= total_hotels %></h2>
      <p class="mt-2 text-sm font-medium text-slate-600">All registered hotel accounts</p>
    </div>

    <div class="bg-slate-50/30 p-6 md:border-r md:border-slate-200 md:p-8">
      <p class="mb-2 text-[11px] font-semibold uppercase tracking-[0.08em] text-slate-500">Pending Review</p>
      <h2 class="text-3xl font-bold tabular-nums tracking-tight text-amber-600"><%= pending_hotels %></h2>
      <p class="mt-2 text-sm font-medium text-slate-600">Waiting for admin action</p>
    </div>

    <div class="p-6 md:border-r md:border-slate-200 md:p-8">
      <p class="mb-2 text-[11px] font-semibold uppercase tracking-[0.08em] text-slate-500">Approved / Live</p>
      <h2 class="text-3xl font-bold tabular-nums tracking-tight text-emerald-600"><%= active_hotels %></h2>
      <p class="mt-2 text-sm font-medium text-slate-600">Operational hotel accounts</p>
    </div>

    <div class="p-6 md:p-8">
      <p class="mb-2 text-[11px] font-semibold uppercase tracking-[0.08em] text-slate-500">Suspended</p>
      <h2 class="text-3xl font-bold tabular-nums tracking-tight text-rose-600"><%= suspended_hotels %></h2>
      <p class="mt-2 text-sm font-medium text-slate-600">Accounts needing follow-up</p>
    </div>
  </div>

  <div class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">
    <div class="flex items-center justify-between border-b border-slate-200 px-6 py-5 sm:px-8">
      <div>
        <h2 class="text-lg font-bold tracking-tight text-slate-950 sm:text-xl">Hotel Registry</h2>
        <p class="mt-1 text-sm font-medium text-slate-600">Current hotel records with registration and status visibility.</p>
      </div>

      <span class="text-sm font-medium text-slate-500">Total <span class="font-semibold text-slate-900"><%= total_hotels %></span></span>
    </div>

    <div class="flex flex-col gap-4 border-b border-slate-200 bg-slate-50/70 px-6 py-4 sm:px-8 lg:flex-row lg:items-center lg:justify-between">
      <label class="relative block w-full max-w-xl">
        <span class="pointer-events-none absolute inset-y-0 left-0 flex items-center pl-4 text-slate-400">
          <svg class="size-4" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
        </span>
        <input type="text" placeholder="Search hotels..." class="w-full rounded-xl border border-slate-200 bg-white py-2.5 pl-11 pr-4 text-sm text-slate-700 placeholder:text-slate-400 focus:border-slate-300 focus:outline-none focus:ring-0">
      </label>

      <div class="flex items-center gap-3">
        <label for="hotel-status-filter" class="text-sm font-medium text-slate-600">Status</label>
        <select id="hotel-status-filter" class="rounded-xl border border-slate-200 bg-white px-3 py-2.5 text-sm font-medium text-slate-700 focus:border-slate-300 focus:outline-none focus:ring-0">
          <option>All Status</option>
          <option>Pending Review</option>
          <option>Approved</option>
          <option>Live</option>
          <option>Suspended</option>
        </select>
      </div>
    </div>

    <div id="admin-hotels-mobile-list" class="space-y-4 p-4 sm:p-6 lg:hidden">
      <% @hotels.each do |hotel| %>
        <% status_dot_classes = case hotel.status
           when "approved", "live"
             "bg-emerald-500"
           when "pending_review"
             "bg-amber-500"
           when "suspended"
             "bg-rose-500"
           else
             "bg-slate-400"
           end %>
        <% status_text_classes = case hotel.status
           when "approved", "live"
             "text-emerald-700"
           when "pending_review"
             "text-amber-700"
           when "suspended"
             "text-rose-700"
           else
             "text-slate-600"
           end %>

        <div class="rounded-2xl border border-slate-200 bg-slate-50/60 p-4 shadow-sm">
          <div class="flex items-start justify-between gap-3">
            <div>
              <%= link_to admin_hotel_path(hotel), class: "group inline-flex items-center gap-1 text-base font-semibold text-slate-950 hover:text-red-700" do %>
                <span class="underline decoration-slate-300 underline-offset-2 group-hover:decoration-red-400"><%= hotel.name %></span>
                <svg class="size-3.5 text-slate-400 group-hover:text-red-600" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M7 17L17 7"/><path d="M7 7h10v10"/></svg>
              <% end %>
              <p class="mt-1 text-sm text-slate-600"><%= hotel.city.presence || "City not set" %></p>
            </div>
            <div class="inline-flex items-center gap-2 text-sm font-medium <%= status_text_classes %>">
              <span class="size-2.5 rounded-sm <%= status_dot_classes %>"></span>
              <%= hotel.status.titleize %>
            </div>
          </div>

          <div class="mt-4 text-sm text-slate-600">
            <span>Registered <%= hotel.created_at.strftime("%d %b %Y") %></span>
          </div>
        </div>
      <% end %>
    </div>

    <div class="hidden lg:block overflow-x-auto">
      <table class="min-w-full">
        <thead class="bg-slate-100">
          <tr>
            <th class="px-6 py-4 text-left text-[11px] font-semibold uppercase tracking-[0.1em] text-slate-600 sm:px-8">Hotel Name</th>
            <th class="px-6 py-4 text-left text-[11px] font-semibold uppercase tracking-[0.1em] text-slate-600">City</th>
            <th class="px-6 py-4 text-left text-[11px] font-semibold uppercase tracking-[0.1em] text-slate-600">Status</th>
            <th class="px-6 py-4 text-left text-[11px] font-semibold uppercase tracking-[0.1em] text-slate-600">Registered</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-200 bg-white">
          <% @hotels.each_with_index do |hotel, index| %>
            <% status_dot_classes = case hotel.status
               when "approved", "live"
                 "bg-emerald-500"
               when "pending_review"
                 "bg-amber-500"
               when "suspended"
                 "bg-rose-500"
               else
                 "bg-slate-400"
               end %>
            <% status_text_classes = case hotel.status
               when "approved", "live"
                 "text-emerald-700"
               when "pending_review"
                 "text-amber-700"
               when "suspended"
                 "text-rose-700"
               else
                 "text-slate-600"
               end %>

            <tr class="transition-colors hover:bg-slate-100/80 <%= index.even? ? 'bg-white' : 'bg-slate-50/55' %>">
              <td class="px-6 py-4 whitespace-nowrap text-sm font-medium sm:px-8">
                <%= link_to admin_hotel_path(hotel), class: "group inline-flex items-center gap-1 text-slate-900 hover:text-red-700" do %>
                  <span class="underline decoration-slate-300 underline-offset-2 group-hover:decoration-red-400"><%= hotel.name %></span>
                  <svg class="size-3.5 text-slate-400 group-hover:text-red-600" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M7 17L17 7"/><path d="M7 7h10v10"/></svg>
                <% end %>
              </td>
              <td class="px-6 py-4 whitespace-nowrap text-sm text-slate-600"><%= hotel.city %></td>
              <td class="px-6 py-4 whitespace-nowrap">
                <div class="inline-flex items-center gap-2 text-sm font-medium <%= status_text_classes %>">
                  <span class="size-2.5 rounded-sm <%= status_dot_classes %>"></span>
                  <%= hotel.status.titleize %>
                </div>
              </td>
              <td class="px-6 py-4 whitespace-nowrap text-sm text-slate-600"><%= hotel.created_at.strftime("%d %b %Y") %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
</div>
