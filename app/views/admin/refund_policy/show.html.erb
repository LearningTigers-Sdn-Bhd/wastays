
<% policy_configured = @refund_policy.persisted? %>
<% min_days_value = @refund_policy.min_days_before_checkin %>
<% refund_percentage_value = @refund_policy.refund_percentage %>
<% example_refund = refund_percentage_value.present? ? (200.0 * (refund_percentage_value / 100.0)).round(2) : nil %>

<div class="w-full space-y-8">
  <%= render PanelsUI::PageHeader.new(
        title: "Refund Policy",
        description: "Set the global rules for guest refund eligibility across the platform.") %>

  <% unless policy_configured %>
    <div class="rounded-2xl border border-amber-200 bg-amber-50 px-6 py-4">
      <div class="flex items-start gap-3">
        <svg class="mt-0.5 size-5 shrink-0 text-amber-600" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m0 3.75h.007v.008H12v-.008ZM3.94 19.5h16.12c1.42 0 2.31-1.53 1.6-2.76L13.6 3.26c-.71-1.23-2.49-1.23-3.2 0L2.34 16.74c-.71 1.23.18 2.76 1.6 2.76Z" />
        </svg>
        <div>
          <p class="text-sm font-semibold text-amber-800">Refund policy is not configured yet.</p>
          <p class="mt-1 text-sm text-amber-700">Set minimum days and refund percentage, then click Save Policy to activate global refund rules.</p>
        </div>
      </div>
    </div>
  <% end %>

  <div class="grid grid-cols-1 overflow-hidden rounded-2xl border border-border bg-card shadow-sm md:grid-cols-2 xl:grid-cols-3">
    <div class="p-6 md:border-r md:border-border md:p-8">
      <p class="mb-2 text-[11px] font-semibold uppercase tracking-[0.08em] text-muted-foreground">Minimum Days</p>
      <h2 class="text-3xl font-bold tabular-nums tracking-tight text-foreground"><%= min_days_value.present? ? min_days_value : "—" %></h2>
      <p class="mt-2 text-sm font-medium text-muted-foreground">Before check-in to request online</p>
    </div>

    <div class="bg-muted/30 p-6 md:border-r md:border-border md:p-8">
      <p class="mb-2 text-[11px] font-semibold uppercase tracking-[0.08em] text-muted-foreground">Refund Percentage</p>
      <h2 class="text-3xl font-bold tabular-nums tracking-tight text-emerald-600"><%= refund_percentage_value.present? ? number_to_percentage(refund_percentage_value, precision: 0) : "—" %></h2>
      <p class="mt-2 text-sm font-medium text-muted-foreground">Applied to eligible bookings</p>
    </div>

    <div class="p-6 md:p-8">
      <p class="mb-2 text-[11px] font-semibold uppercase tracking-[0.08em] text-muted-foreground">Example</p>
      <% if example_refund.present? %>
        <h2 class="text-3xl font-bold tabular-nums tracking-tight text-foreground">RM <%= number_with_precision(example_refund, precision: 2) %></h2>
        <p class="mt-2 text-sm font-medium text-muted-foreground">Estimated refund from RM 200.00</p>
      <% else %>
        <h2 class="text-3xl font-bold tabular-nums tracking-tight text-foreground">—</h2>
        <p class="mt-2 text-sm font-medium text-muted-foreground">Set percentage to preview estimate</p>
      <% end %>
    </div>
  </div>

  <div class="grid grid-cols-1 gap-8 xl:grid-cols-[minmax(0,1fr)_minmax(0,350px)] xl:items-start">
    <div>
      <div class="overflow-hidden rounded-2xl border border-border bg-card shadow-sm">
        <div class="border-b border-border px-6 py-5 sm:px-8">
          <h2 class="text-lg font-bold tracking-tight text-foreground sm:text-xl">Policy Configuration</h2>
          <p class="mt-1 text-sm font-medium text-muted-foreground">Adjust eligibility window and refund percentage.</p>
        </div>

        <%= form_with model: @refund_policy, url: admin_refund_policy_path, method: :patch, local: true, class: "space-y-6 p-6 sm:p-8" do |f| %>
          <% if @refund_policy.errors.any? %>
            <div class="rounded-xl border border-red-200 bg-red-50 p-4">
              <ul class="list-inside list-disc space-y-1 text-sm text-red-700">
                <% @refund_policy.errors.full_messages.each do |msg| %>
                  <li><%= msg %></li>
                <% end %>
              </ul>
            </div>
          <% end %>

          <div>
            <%= f.label :min_days_before_checkin, "Minimum Days Before Check-in", class: "mb-1.5 block text-sm font-semibold text-foreground" %>
            <p class="mb-2 text-sm text-muted-foreground">Guest must submit their refund request at least this many days before their check-in date.</p>
            <%= f.number_field :min_days_before_checkin, min: 0, step: 1, required: true,
                class: "w-full rounded-xl border border-border px-3 py-2.5 text-sm focus:border-border-interactive focus:outline-none focus:ring-2 focus:ring-ring/20" %>
          </div>

          <div>
            <%= f.label :refund_percentage, "Refund Percentage (%)", class: "mb-1.5 block text-sm font-semibold text-foreground" %>
            <p class="mb-2 text-sm text-muted-foreground">Percentage of the total booking amount to refund. E.g. 80 means the guest receives 80% back.</p>
            <%= f.number_field :refund_percentage, min: 0, max: 100, step: 0.01, required: true,
                class: "w-full rounded-xl border border-border px-3 py-2.5 text-sm focus:border-border-interactive focus:outline-none focus:ring-2 focus:ring-ring/20" %>
          </div>

          <div class="flex items-center justify-end gap-3 border-t border-border pt-4">
            <% if policy_configured %>
              <%= link_to "Clear Policy", admin_refund_policy_path,
                  data: { turbo_method: :delete,
                          turbo_confirm: "This will remove the current refund policy. Are you sure?",
                          turbo_confirm_title: "Clear Refund Policy",
                          turbo_confirm_color: "red" },
                  class: "cursor-pointer rounded-xl border border-red-200 bg-red-50 px-4 py-2.5 text-sm font-semibold text-red-700 hover:bg-red-100" %>
            <% end %>
            <%= f.submit "Save Policy", class: "cursor-pointer rounded-xl bg-primary px-6 py-2.5 text-sm font-bold text-primary-foreground hover:bg-primary-hover" %>
          </div>
        <% end %>
      </div>
    </div>

    <div>
      <div class="overflow-hidden rounded-2xl border border-border bg-card shadow-sm">
        <div class="border-b border-border bg-muted/70 px-6 py-5">
          <h2 class="text-base font-bold text-foreground">How It Works</h2>
          <p class="mt-1 text-sm font-medium text-muted-foreground">Guest refund journey under this policy.</p>
        </div>
        <div class="space-y-4 p-6">
          <div class="rounded-xl border border-border bg-card p-4">
            <div class="flex items-start gap-3">
              <span class="inline-flex h-6 min-w-6 items-center justify-center rounded-full bg-primary px-2 text-xs font-bold text-primary-foreground">1</span>
              <div>
                <p class="text-sm font-semibold text-foreground">Eligibility Check</p>
                <p class="mt-1 text-sm text-muted-foreground">Guest must submit before the minimum-day cutoff.</p>
              </div>
            </div>
          </div>

          <div class="rounded-xl border border-emerald-200 bg-emerald-50/40 p-4">
            <div class="flex items-start gap-3">
              <span class="inline-flex h-6 min-w-6 items-center justify-center rounded-full bg-emerald-600 px-2 text-xs font-bold text-primary-foreground">2</span>
              <div>
                <p class="text-sm font-semibold text-emerald-800">Approval & Calculation</p>
                <p class="mt-1 text-sm text-emerald-700">Approved requests use the configured refund percentage.</p>
              </div>
            </div>
          </div>

          <div class="rounded-xl border border-amber-200 bg-amber-50/50 p-4">
            <div class="flex items-start gap-3">
              <span class="inline-flex h-6 min-w-6 items-center justify-center rounded-full bg-amber-500 px-2 text-xs font-bold text-primary-foreground">3</span>
              <div>
                <p class="text-sm font-semibold text-amber-800">Resubmission Path</p>
                <p class="mt-1 text-sm text-amber-700">Rejected requests can be resubmitted with updated details.</p>
              </div>
            </div>
          </div>

        </div>
      </div>
    </div>
  </div>
</div>
