<div class="w-full space-y-6">
  <%= render PanelsUI::PageHeader.new(
        title: "Exchange Rates",
        description: "Manage global exchange rates. Hotels will use these for display conversion and OTA sync.") do |header| %>
    <% header.with_caption do %>
      <div class="rounded-xl border border-border bg-card px-4 py-2.5 text-sm font-semibold text-foreground shadow-sm">
        Enterprise Multi-Base Support Enabled
      </div>
    <% end %>
  <% end %>

  <div class="grid gap-6 xl:grid-cols-[360px_1fr]">
    <section class="rounded-2xl border border-border bg-card p-6 shadow-sm">
      <h2 class="text-lg font-bold text-foreground">Add Rate</h2>
      <p class="mt-1 text-sm text-muted-foreground">
        Define a direct conversion between two currencies.<br>
        <span class="text-[11px] font-medium text-muted-foreground italic">Example: If 1 USD = 4.75 MYR, set Base as USD and Target as MYR with rate 4.75</span>
      </p>

      <% if @exchange_rate.errors.any? %>
        <div class="mt-4 rounded-xl border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-700">
          <%= @exchange_rate.errors.full_messages.to_sentence %>
        </div>
      <% end %>

      <div data-controller="exchange-rate-calculator">
        <%= form_with model: [:admin, @exchange_rate], local: true, class: "mt-5 space-y-4" do |f| %>
          <!-- Base Currency -->
          <div data-controller="searchable-select" class="relative">
            <%= f.label :base_currency, "Base Currency", class: "mb-2 block text-sm font-semibold text-foreground" %>
            <div class="relative group">
              <input type="text"
                     data-searchable-select-target="input"
                     data-action="input->searchable-select#filter click->searchable-select#open"
                     class="w-full rounded-xl border border-border bg-card px-3 py-2.5 pr-10 text-sm font-semibold text-foreground transition-all placeholder:text-muted-foreground focus:border-border-interactive focus:outline-none focus:ring-4 focus:ring-ring"
                     placeholder="Search base (e.g. USD)"
                     autocomplete="off"
                     value="<%= @exchange_rate.base_currency %>">
              <div class="absolute inset-y-0 right-0 flex items-center pr-3 pointer-events-none text-muted-foreground group-focus-within:text-muted-foreground">
                <svg class="size-4" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" d="m19.5 8.25-7.5 7.5-7.5-7.5" />
                </svg>
              </div>
              <%= f.hidden_field :base_currency,
                  data: {
                    searchable_select_target: "hiddenInput",
                    exchange_rate_calculator_target: "baseCurrency",
                    action: "input->exchange-rate-calculator#update"
                  } %>
              <div data-searchable-select-target="options" class="absolute z-[100] hidden w-full overflow-hidden rounded-2xl border border-border bg-card shadow-xl ring-1 ring-ring/5">
                <div class="max-height-[240px] overflow-y-auto p-1 custom-scrollbar" style="max-height: 240px;">
                  <% @currency_options.each do |label, value| %>
                    <button type="button" data-searchable-select-target="option" data-action="click->searchable-select#select" data-value="<%= value %>" data-label="<%= label %>" class="flex w-full items-center gap-3 rounded-xl px-3 py-2 text-left text-sm font-semibold text-foreground hover:bg-muted">
                      <span class="flex size-7 shrink-0 items-center justify-center rounded-lg bg-muted text-[10px] font-bold text-muted-foreground"><%= value %></span>
                      <span class="truncate"><%= label %></span>
                    </button>
                  <% end %>
                </div>
              </div>
            </div>
          </div>

          <!-- Target Currency -->
          <div data-controller="searchable-select" class="relative">
            <%= f.label :currency_code, "Target Currency", class: "mb-2 block text-sm font-semibold text-foreground" %>
            <div class="relative group">
              <input type="text"
                     data-searchable-select-target="input"
                     data-action="input->searchable-select#filter click->searchable-select#open"
                     class="w-full rounded-xl border border-border bg-card px-3 py-2.5 pr-10 text-sm font-semibold text-foreground transition-all placeholder:text-muted-foreground focus:border-border-interactive focus:outline-none focus:ring-4 focus:ring-ring"
                     placeholder="Search target (e.g. MYR)"
                     autocomplete="off"
                     value="<%= @exchange_rate.currency_code %>">
              <div class="absolute inset-y-0 right-0 flex items-center pr-3 pointer-events-none text-muted-foreground group-focus-within:text-muted-foreground">
                <svg class="size-4" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" d="m19.5 8.25-7.5 7.5-7.5-7.5" />
                </svg>
              </div>
              <%= f.hidden_field :currency_code,
                  data: {
                    searchable_select_target: "hiddenInput",
                    exchange_rate_calculator_target: "targetCurrency",
                    action: "input->exchange-rate-calculator#update"
                  } %>
              <div data-searchable-select-target="options" class="absolute z-[100] hidden w-full overflow-hidden rounded-2xl border border-border bg-card shadow-xl ring-1 ring-ring/5">
                <div class="max-height-[240px] overflow-y-auto p-1 custom-scrollbar" style="max-height: 240px;">
                  <% @currency_options.each do |label, value| %>
                    <button type="button" data-searchable-select-target="option" data-action="click->searchable-select#select" data-value="<%= value %>" data-label="<%= label %>" class="flex w-full items-center gap-3 rounded-xl px-3 py-2 text-left text-sm font-semibold text-foreground hover:bg-muted">
                      <span class="flex size-7 shrink-0 items-center justify-center rounded-lg bg-muted text-[10px] font-bold text-muted-foreground"><%= value %></span>
                      <span class="truncate"><%= label %></span>
                    </button>
                  <% end %>
                </div>
              </div>
            </div>
          </div>

          <div>
            <div class="flex items-center justify-between">
              <%= f.label :rate, "Conversion Rate", class: "mb-2 block text-sm font-semibold text-foreground" %>
              <span class="mb-2 text-[10px] font-bold uppercase text-muted-foreground">1 <span data-exchange-rate-calculator-target="baseLabel">BASE</span> = ? <span data-exchange-rate-calculator-target="targetLabel">TARGET</span></span>
            </div>
            <%= f.number_field :rate,
                step: 0.00000001,
                min: 0,
                class: "w-full rounded-xl border border-border px-3 py-2.5 text-sm font-semibold text-foreground focus:border-border-interactive focus:outline-none focus:ring-0",
                placeholder: "0.0000",
                data: {
                  action: "input->exchange-rate-calculator#update",
                  exchange_rate_calculator_target: "rate"
                } %>
          </div>

          <!-- Dynamic Calculation Display -->
          <div class="rounded-xl border border-border bg-muted p-4 space-y-2 hidden" data-exchange-rate-calculator-target="calculation">
            <div class="flex justify-between items-center text-sm">
              <span class="text-muted-foreground font-medium">Forward Rate:</span>
              <span class="text-foreground font-bold">1 <span data-exchange-rate-calculator-target="curr1">BASE</span> = <span data-exchange-rate-calculator-target="forwardRate">1.0000</span> <span data-exchange-rate-calculator-target="targetLabel">TARGET</span></span>
            </div>
            <div class="flex justify-between items-center text-sm border-t border-border pt-2">
              <span class="text-muted-foreground font-medium">Inverse Rate:</span>
              <span class="text-foreground font-bold">1 <span data-exchange-rate-calculator-target="targetLabel">TARGET</span> = <span data-exchange-rate-calculator-target="inverseRate">1.0000</span> <span data-exchange-rate-calculator-target="curr2">BASE</span></span>
            </div>
          </div>

          <div>
            <%= f.label :effective_at, "Effective At", class: "mb-2 block text-sm font-semibold text-foreground" %>
            <%= f.datetime_field :effective_at, value: (@exchange_rate.effective_at || Time.current).strftime("%Y-%m-%dT%H:%M"), class: "w-full rounded-xl border border-border px-3 py-2.5 text-sm font-semibold text-foreground focus:border-border-interactive focus:outline-none focus:ring-0" %>
          </div>
          <div>
            <%= f.label :source, class: "mb-2 block text-sm font-semibold text-foreground" %>
            <%= f.text_field :source, value: @exchange_rate.source.presence || "manual", class: "w-full rounded-xl border border-border px-3 py-2.5 text-sm font-semibold text-foreground focus:border-border-interactive focus:outline-none focus:ring-0" %>
          </div>
          <label class="flex items-center gap-2 text-sm font-semibold text-foreground">
            <%= f.check_box :active, checked: @exchange_rate.active != false, class: "size-4 rounded border-border-interactive text-foreground focus:ring-0" %>
            Active for display conversion
          </label>
          <%= f.submit "Save Rate", class: "w-full rounded-xl bg-primary px-4 py-2.5 text-sm font-bold text-primary-foreground hover:bg-primary-hover" %>
        <% end %>
      </div>
    </section>

    <section class="overflow-hidden rounded-2xl border border-border bg-card shadow-sm">
      <div class="border-b border-border px-6 py-5">
        <h2 class="text-lg font-bold text-foreground">Managed Rates</h2>
      </div>

      <div class="overflow-x-auto">
        <table class="min-w-full">
          <thead class="bg-muted">
            <tr>
              <th class="px-6 py-3 text-left text-[11px] font-bold uppercase tracking-[0.1em] text-muted-foreground">Pair</th>
              <th class="px-6 py-3 text-left text-[11px] font-bold uppercase tracking-[0.1em] text-muted-foreground">Rate</th>
              <th class="px-6 py-3 text-left text-[11px] font-bold uppercase tracking-[0.1em] text-muted-foreground">Inverse</th>
              <th class="px-6 py-3 text-left text-[11px] font-bold uppercase tracking-[0.1em] text-muted-foreground">Status</th>
              <th class="px-6 py-3 text-right text-[11px] font-bold uppercase tracking-[0.1em] text-muted-foreground">Action</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-border">
            <% @exchange_rates.each do |rate| %>
              <tr>
                <td class="px-6 py-4 text-sm font-bold text-foreground">
                  <%= rate.base_currency %> → <%= rate.currency_code %>
                </td>
                <td class="px-6 py-4 text-sm font-semibold text-foreground">
                  1 <%= rate.base_currency %> = <%= rate.rate %> <%= rate.currency_code %>
                </td>
                <td class="px-6 py-4 text-sm font-medium text-muted-foreground italic">
                  1 <%= rate.currency_code %> = <%= (1.0 / rate.rate).round(8) %> <%= rate.base_currency %>
                </td>
                <td class="px-6 py-4">
                  <span class="rounded-full px-2.5 py-1 text-xs font-bold <%= rate.active? ? 'bg-emerald-50 text-emerald-700' : 'bg-muted text-muted-foreground' %>"><%= rate.active? ? "Active" : "Inactive" %></span>
                </td>
                <td class="px-6 py-4 text-right">
                  <%= button_to "Remove", admin_exchange_rate_path(rate), method: :delete, class: "rounded-lg bg-red-50 px-3 py-1.5 text-xs font-bold text-red-700 hover:bg-red-100", data: { turbo_confirm: "Remove this exchange rate?" } %>
                </td>
              </tr>
            <% end %>
            <% if @exchange_rates.empty? %>
              <tr>
                <td colspan="5" class="px-6 py-12 text-center text-sm font-semibold text-muted-foreground">No managed exchange rates yet.</td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </section>
  </div>
</div>
