<% content_for :title, "Webhook Endpoints | WAStays Admin" %>

<div class="w-full space-y-8">
  <%= render PanelsUI::PageHeader.new(
        title: "Webhook Endpoints",
        description: "Manage outgoing webhooks to external services.") do |header| %>
    <% header.with_actions do %>
       <%= render PanelsUI::Button.new(as: :button, type: :button, onclick: "document.getElementById('new-webhook-form').classList.toggle('hidden')") do %>
         <svg class="mr-2 h-4 w-4" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
           <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" />
         </svg>
         Add Webhook
       <% end %>
    <% end %>
  <% end %>

  <div class="grid grid-cols-1 gap-8">
    <!-- New Webhook Form (Hidden by default) -->
    <div id="new-webhook-form" class="hidden overflow-hidden rounded-2xl border border-border bg-card shadow-sm">
      <div class="border-b border-border px-6 py-5 sm:px-8">
        <h2 class="text-lg font-bold tracking-tight text-foreground sm:text-xl">New Webhook</h2>
        <p class="mt-1 text-sm font-medium text-muted-foreground">Create a new connection to an external service.</p>
      </div>
      <%= form_with model: [:admin, WebhookEndpoint.new], local: true, class: "p-6 sm:p-8 space-y-6" do |f| %>
        <div class="grid gap-6 md:grid-cols-2">
          <div>
            <%= f.label :name, "Friendly Name", class: "mb-1.5 block text-sm font-semibold text-foreground" %>
            <%= f.text_field :name, placeholder: "e.g. WhatsApp Bot Middleman", class: "w-full rounded-xl border border-border px-3 py-2.5 text-sm focus:border-border-interactive focus:outline-none focus:ring-2 focus:ring-ring/20" %>
          </div>
          <div>
            <%= f.label :url, "Webhook URL", class: "mb-1.5 block text-sm font-semibold text-foreground" %>
            <%= f.text_field :url, placeholder: "https://...", class: "w-full rounded-xl border border-border px-3 py-2.5 text-sm focus:border-border-interactive focus:outline-none focus:ring-2 focus:ring-ring/20" %>
          </div>
        </div>
        <%= render "scope_fields", f: f, hotel_choices: @hotel_choices %>
        <div class="flex items-center gap-2">
          <%= f.check_box :enabled, checked: true, class: "h-4 w-4 rounded border-border-interactive text-foreground focus:ring-ring" %>
          <%= f.label :enabled, "Enabled", class: "text-sm font-medium text-foreground" %>
        </div>
        <div class="flex justify-end gap-3 border-t border-border pt-4">
          <button type="button" onclick="document.getElementById('new-webhook-form').classList.add('hidden')" class="rounded-xl border border-border px-4 py-2.5 text-sm font-bold text-foreground hover:bg-muted">Cancel</button>
          <%= f.submit "Create Webhook", class: "rounded-xl bg-primary px-6 py-2.5 text-sm font-bold text-primary-foreground hover:bg-primary-hover" %>
        </div>
      <% end %>
    </div>

    <!-- Webhooks List -->
    <div class="overflow-hidden rounded-2xl border border-border bg-card shadow-sm">
      <div class="overflow-x-auto">
        <table class="w-full text-left text-sm text-muted-foreground">
          <thead class="bg-muted text-xs font-semibold uppercase tracking-wider text-foreground">
            <tr>
              <th class="px-6 py-4">Name</th>
              <th class="px-6 py-4">URL</th>
              <th class="px-6 py-4">Scope</th>
              <th class="px-6 py-4">Status</th>
              <th class="px-6 py-4">Created</th>
              <th class="px-6 py-4 text-right">Actions</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-border">
            <% if @webhook_endpoints.any? %>
              <% @webhook_endpoints.each do |endpoint| %>
                <tr class="hover:bg-muted">
                  <td class="px-6 py-4 font-semibold text-foreground"><%= endpoint.name %></td>
                  <td class="px-6 py-4 font-mono text-xs truncate max-w-[300px]"><%= endpoint.url %></td>
                  <td class="px-6 py-4">
                    <div class="text-foreground"><%= endpoint.hotel&.name || "All hotels" %></div>
                    <div class="text-xs text-muted-foreground">
                      <%= endpoint.all_events? ? "All events" : endpoint.event_types.map(&:humanize).to_sentence %>
                    </div>
                  </td>
                  <td class="px-6 py-4">
                    <% if endpoint.enabled %>
                      <span class="inline-flex items-center rounded-full bg-emerald-50 px-2.5 py-1 text-xs font-medium text-emerald-700 ring-1 ring-inset ring-emerald-600/20">Enabled</span>
                    <% else %>
                      <span class="inline-flex items-center rounded-full bg-muted px-2.5 py-1 text-xs font-medium text-muted-foreground ring-1 ring-inset ring-ring/10">Disabled</span>
                    <% end %>
                  </td>
                  <td class="px-6 py-4 whitespace-nowrap"><%= endpoint.created_at.strftime("%b %d, %Y") %></td>
                  <td class="px-6 py-4 text-right whitespace-nowrap font-medium">
                    <div class="flex items-center justify-end gap-3">
                      <%= button_to test_ping_admin_webhook_endpoint_path(endpoint), method: :post, class: "p-2 text-muted-foreground hover:text-blue-600 transition-colors", title: "Test Ping" do %>
                        <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                          <path stroke-linecap="round" stroke-linejoin="round" d="M6 12 3.269 3.125A59.769 59.769 0 0 1 21.485 12 59.768 59.768 0 0 1 3.27 20.875L5.999 12Zm0 0h7.5" />
                        </svg>
                      <% end %>

                      <button type="button" onclick="document.getElementById('edit-modal-<%= endpoint.id %>').classList.remove('hidden')" class="p-2 text-muted-foreground hover:text-foreground transition-colors" title="Edit Webhook">
                        <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                          <path stroke-linecap="round" stroke-linejoin="round" d="m16.862 4.487 1.687-1.688a1.875 1.875 0 1 1 2.652 2.652L10.582 16.07a4.5 4.5 0 0 1-1.897 1.13L6 18l.8-2.685a4.5 4.5 0 0 1 1.13-1.897l8.932-8.931Zm0 0L19.5 7.125M18 14v4.75A2.25 2.25 0 0 1 15.75 21H5.25A2.25 2.25 0 0 1 3 18.75V8.25A2.25 2.25 0 0 1 5.25 6H10" />
                        </svg>
                      </button>
                    </div>
                  </td>
                </tr>
              <% end %>
            <% else %>
              <tr>
                <td colspan="6" class="px-6 py-10 text-center italic text-muted-foreground">No webhooks configured.</td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>

<!-- Modals rendered outside of table for better reliable layering -->
<% @webhook_endpoints.each do |endpoint| %>
  <div id="edit-modal-<%= endpoint.id %>" class="hidden fixed inset-0 z-50 overflow-y-auto" aria-labelledby="modal-title-<%= endpoint.id %>" role="dialog" aria-modal="true">
    <div class="flex min-h-screen items-center justify-center px-4 pt-4 pb-20 text-center sm:block sm:p-0">
      <div class="fixed inset-0 bg-muted bg-opacity-75 transition-opacity" aria-hidden="true" onclick="document.getElementById('edit-modal-<%= endpoint.id %>').classList.add('hidden')"></div>

      <span class="hidden sm:inline-block sm:h-screen sm:align-middle" aria-hidden="true">&#8203;</span>

      <div class="relative inline-block transform overflow-hidden rounded-2xl bg-card text-left align-middle shadow-xl transition-all sm:my-8 sm:w-full sm:max-w-lg">
        <div class="bg-card px-4 pt-5 pb-4 sm:p-6 sm:pb-4">
          <div class="flex items-center justify-between border-b border-border pb-4 mb-6">
            <h3 class="text-lg font-bold leading-6 text-foreground" id="modal-title-<%= endpoint.id %>">Edit Webhook</h3>
            <button type="button" onclick="document.getElementById('edit-modal-<%= endpoint.id %>').classList.add('hidden')" class="text-muted-foreground hover:text-muted-foreground">
              <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
              </svg>
            </button>
          </div>

          <%= form_with model: [:admin, endpoint], local: true, class: "space-y-6" do |f| %>
            <div>
              <%= f.label :name, "Friendly Name", class: "mb-1.5 block text-sm font-semibold text-foreground" %>
              <%= f.text_field :name, class: "w-full rounded-xl border border-border px-3 py-2.5 text-sm focus:border-border-interactive focus:outline-none focus:ring-2 focus:ring-ring/20" %>
            </div>
            <div>
              <%= f.label :url, "Webhook URL", class: "mb-1.5 block text-sm font-semibold text-foreground" %>
              <%= f.text_field :url, class: "w-full rounded-xl border border-border px-3 py-2.5 text-sm focus:border-border-interactive focus:outline-none focus:ring-2 focus:ring-ring/20" %>
            </div>
            <%= render "scope_fields", f: f, hotel_choices: @hotel_choices %>
            <div class="flex items-center gap-2">
              <%= f.check_box :enabled, class: "h-4 w-4 rounded border-border-interactive text-foreground focus:ring-ring" %>
              <%= f.label :enabled, "Enabled", class: "text-sm font-medium text-foreground" %>
            </div>
            <div class="flex flex-col gap-3 pt-4 border-t border-border">
              <%= f.submit "Update Webhook", class: "w-full rounded-xl bg-primary py-2.5 text-sm font-bold text-primary-foreground hover:bg-primary-hover transition-colors shadow-sm" %>

              <%= link_to admin_webhook_endpoint_path(endpoint),
                  data: { turbo_method: :delete, turbo_confirm: "Are you sure? This cannot be undone." },
                  class: "w-full rounded-xl border border-red-200 bg-card py-2.5 text-center text-sm font-bold text-red-600 hover:bg-red-50 transition-colors" do %>
                Delete Webhook
              <% end %>

              <button type="button" onclick="document.getElementById('edit-modal-<%= endpoint.id %>').classList.add('hidden')" class="w-full rounded-xl border border-border bg-card py-2.5 text-sm font-bold text-foreground hover:bg-muted transition-colors">
                Cancel
              </button>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  </div>
<% end %>
