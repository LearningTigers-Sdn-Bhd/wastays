<div class="max-w-[85rem] px-4 py-10 sm:px-6 lg:px-8 lg:py-14 mx-auto">
  <div class="flex flex-col md:flex-row justify-between items-center mb-8 gap-4">
    <div>
      <h1 class="text-3xl font-bold text-gray-800">Platform Margin Rules</h1>
      <p class="text-sm text-gray-600">Define platform commission rates at global, hotel, or room type levels.</p>
    </div>
  </div>

  <div class="grid lg:grid-cols-3 gap-8">
    <!-- Create Form -->
    <div class="lg:col-span-1">
      <div class="bg-white border border-gray-200 rounded-xl shadow-sm p-6 sticky top-4">
        <h2 class="text-lg font-bold text-gray-800 mb-4">Add New Rule</h2>
        <%= form_with model: [:admin, @new_rule], local: true, class: "space-y-4" do |f| %>
          <div>
            <label class="block text-sm font-medium mb-2 text-gray-700">Commission Rate (%)</label>
            <%= f.number_field :rate, step: 0.1, class: "py-3 px-4 block w-full border-gray-200 rounded-lg text-sm focus:border-blue-500 focus:ring-blue-500 border" %>
          </div>
          
          <div>
            <label class="block text-sm font-medium mb-2 text-gray-700">Applies To</label>
            <%= f.select :settable_type, [['Global Default', nil], ['Specific Hotel', 'Hotel'], ['Specific Room Type', 'RoomType']], {}, class: "py-3 px-4 block w-full border-gray-200 rounded-lg text-sm focus:border-blue-500 focus:ring-blue-500 border" %>
          </div>

          <div>
            <label class="block text-sm font-medium mb-2 text-gray-700">Target ID (Only if not Global)</label>
            <%= f.number_field :settable_id, class: "py-3 px-4 block w-full border-gray-200 rounded-lg text-sm focus:border-blue-500 focus:ring-blue-500 border" %>
          </div>

          <div class="pt-2">
            <%= f.submit "Create Rule", class: "w-full py-3 px-4 inline-flex justify-center items-center gap-x-2 text-sm font-semibold rounded-lg border border-transparent bg-blue-600 text-white hover:bg-blue-700 transition" %>
          </div>
        <% end %>
      </div>
    </div>

    <!-- List -->
    <div class="lg:col-span-2">
      <div class="bg-white border border-gray-200 rounded-xl shadow-sm overflow-hidden">
        <table class="min-w-full divide-y divide-gray-200">
          <thead class="bg-gray-50">
            <tr>
              <th scope="col" class="px-6 py-3 text-start text-xs font-semibold uppercase tracking-wide text-gray-800">Target</th>
              <th scope="col" class="px-6 py-3 text-start text-xs font-semibold uppercase tracking-wide text-gray-800">Rate</th>
              <th scope="col" class="px-6 py-3 text-start text-xs font-semibold uppercase tracking-wide text-gray-800">Status</th>
              <th scope="col" class="px-6 py-3 text-end"></th>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-200">
            <% @margin_rules.each do |rule| %>
              <tr>
                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-800">
                  <% if rule.settable_type.nil? %>
                    <span class="font-bold text-blue-600">Global Default</span>
                  <% else %>
                    <%= rule.settable_type %> #<%= rule.settable_id %>
                  <% end %>
                </td>
                <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-gray-800">
                  <%= rule.rate %>%
                </td>
                <td class="px-6 py-4 whitespace-nowrap">
                  <span class="py-1 px-2 inline-flex items-center gap-x-1 text-xs font-medium rounded-full bg-green-100 text-green-800">
                    <%= rule.status.titleize %>
                  </span>
                </td>
                <td class="px-6 py-4 whitespace-nowrap text-end text-sm font-medium">
                  <%= button_to "Delete", admin_margin_rule_path(rule), method: :delete, data: { confirm: "Are you sure?" }, class: "text-red-600 hover:text-red-800 font-semibold" %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>
