<div class="w-full space-y-8">
  <%= render PanelsUI::PageHeader.new(
        title: "Margin Settings",
        description: "Set the commission rules WAStays applies across the platform, hotels, and room types.") do |header| %>
    <% header.with_caption do %>
      <div class="inline-flex items-center gap-2 rounded-xl border border-border bg-card px-4 py-2.5 text-sm font-semibold text-foreground shadow-sm">
        <span class="size-2.5 rounded-full bg-blue-500"></span>
        <%= pluralize(@global_defaults, "global default") %> in coverage
      </div>
    <% end %>
  <% end %>

  <div class="grid grid-cols-1 overflow-hidden rounded-2xl border border-border bg-card shadow-sm md:grid-cols-4">
    <div class="p-6 md:border-r md:border-border md:p-8">
      <p class="mb-2 text-[11px] font-semibold uppercase tracking-[0.08em] text-muted-foreground">Total Rules</p>
      <h2 class="text-3xl font-bold tabular-nums tracking-tight text-foreground"><%= @total_rules %></h2>
      <p class="mt-2 text-sm font-medium text-muted-foreground">All commission rules in the admin registry</p>
    </div>

    <div class="bg-muted/30 p-6 md:border-r md:border-border md:p-8">
      <p class="mb-2 text-[11px] font-semibold uppercase tracking-[0.08em] text-muted-foreground">Active Rules</p>
      <h2 class="text-3xl font-bold tabular-nums tracking-tight text-emerald-600"><%= @active_rules %></h2>
      <p class="mt-2 text-sm font-medium text-muted-foreground">Rules currently used for pricing margins</p>
    </div>

    <div class="p-6 md:border-r md:border-border md:p-8">
      <p class="mb-2 text-[11px] font-semibold uppercase tracking-[0.08em] text-muted-foreground">Global Defaults</p>
      <h2 class="text-3xl font-bold tabular-nums tracking-tight text-blue-600"><%= @global_defaults %></h2>
      <p class="mt-2 text-sm font-medium text-muted-foreground">Base rules used when no override exists</p>
    </div>

    <div class="p-6 md:p-8">
      <p class="mb-2 text-[11px] font-semibold uppercase tracking-[0.08em] text-muted-foreground">Overrides</p>
      <h2 class="text-3xl font-bold tabular-nums tracking-tight text-violet-600"><%= @override_rules %></h2>
      <p class="mt-2 text-sm font-medium text-muted-foreground">Hotel or room-level exceptions to the default</p>
    </div>
  </div>

  <div class="grid grid-cols-1 gap-8 xl:grid-cols-[minmax(0,380px)_minmax(0,1fr)] xl:items-start">
    <div class="overflow-hidden rounded-2xl border border-border bg-card shadow-sm xl:sticky xl:top-6">
      <div class="border-b border-border px-6 py-5 sm:px-8">
        <h2 class="text-lg font-bold tracking-tight text-foreground sm:text-xl">Add New Rule</h2>
        <p class="mt-1 text-sm font-medium text-muted-foreground">Create a default rule or a targeted override for a hotel or room type.</p>
      </div>

      <div class="p-6 sm:p-8">
        <% if @new_rule.errors.any? %>
          <div class="mb-5 rounded-xl border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-700">
            <p class="font-semibold"><%= pluralize(@new_rule.errors.count, "issue") %> blocked this rule.</p>
            <ul class="mt-2 space-y-1 text-sm">
              <% @new_rule.errors.full_messages.each do |message| %>
                <li><%= message %></li>
              <% end %>
            </ul>
          </div>
        <% end %>

        <%= form_with model: [:admin, @new_rule], local: true, class: "space-y-5", data: { controller: "margin-rule-form" } do |f| %>
          <div>
            <label class="mb-2 block text-sm font-medium text-muted-foreground">Commission Rate (%)</label>
            <%= f.number_field :rate, step: 0.1, class: "w-full rounded-xl border border-border bg-card px-3 py-2.5 text-sm font-medium text-foreground focus:border-border-interactive focus:outline-none focus:ring-0" %>
          </div>

          <div>
            <label class="mb-2 block text-sm font-medium text-muted-foreground">Applies To</label>
            <%= f.select :settable_type, [["Global Default", nil], ["Specific Hotel", "Hotel"], ["Specific Room Type", "RoomType"]], {}, class: "w-full rounded-xl border border-border bg-card px-3 py-2.5 text-sm font-medium text-foreground focus:border-border-interactive focus:outline-none focus:ring-0", data: { margin_rule_form_target: "appliesTo", action: "change->margin-rule-form#toggle" } %>
          </div>

          <div data-margin-rule-form-target="hotelField" class="<%= @new_rule.settable_type == 'Hotel' ? '' : 'hidden' %>">
            <label class="mb-2 block text-sm font-medium text-muted-foreground">Hotel</label>
            <%= f.select :settable_id,
                         options_from_collection_for_select(@hotels || [], :id, :name, @new_rule.settable_type == 'Hotel' ? @new_rule.settable_id : nil),
                         { include_blank: "Select a hotel" },
                         class: "w-full rounded-xl border border-border bg-card px-3 py-2.5 text-sm font-medium text-foreground focus:border-border-interactive focus:outline-none focus:ring-0",
                         data: { margin_rule_form_target: "hotelInput" },
                         disabled: @new_rule.settable_type != 'Hotel' %>
            <p class="mt-2 text-xs font-medium text-muted-foreground">Choose the hotel that should use a custom margin rate.</p>
          </div>

          <div data-margin-rule-form-target="roomTypeField" class="<%= @new_rule.settable_type == 'RoomType' ? '' : 'hidden' %>">
            <label class="mb-2 block text-sm font-medium text-muted-foreground">Room Type</label>
            <%= f.select :settable_id,
                         room_type_select_options(@room_types),
                         { include_blank: "Select a room type", selected: @new_rule.settable_type == 'RoomType' ? @new_rule.settable_id : nil },
                         class: "w-full rounded-xl border border-border bg-card px-3 py-2.5 text-sm font-medium text-foreground focus:border-border-interactive focus:outline-none focus:ring-0",
                         data: { margin_rule_form_target: "roomTypeInput" },
                         disabled: @new_rule.settable_type != 'RoomType' %>
            <p class="mt-2 text-xs font-medium text-muted-foreground">Choose the room type that should use a custom margin rate.</p>
          </div>

          <div class="pt-2">
            <%= f.submit "Create Rule", class: "inline-flex w-full items-center justify-center rounded-xl bg-red-600 px-4 py-2.5 text-sm font-semibold text-primary-foreground transition hover:bg-red-700" %>
          </div>
        <% end %>
      </div>
    </div>

    <div class="overflow-hidden rounded-2xl border border-border bg-card shadow-sm">
      <div class="flex flex-col gap-4 border-b border-border px-6 py-5 sm:px-8 lg:flex-row lg:items-center lg:justify-between">
        <div>
          <h2 class="text-lg font-bold tracking-tight text-foreground sm:text-xl">Rule Registry</h2>
          <p class="mt-1 text-sm font-medium text-muted-foreground">Create and manage commission rules for default coverage or targeted overrides.</p>
        </div>

        <span class="text-sm font-medium text-muted-foreground">Total <span class="font-semibold text-foreground"><%= @total_rules %></span></span>
      </div>

      <div id="admin-margin-rules-mobile-list" class="space-y-4 p-4 sm:p-6 lg:hidden">
        <% if @margin_rules.any? %>
          <% @margin_rules.each do |rule| %>
            <% status_classes = rule.status == "active" ? "bg-emerald-50 text-emerald-700 ring-1 ring-inset ring-emerald-200" : "bg-muted text-foreground ring-1 ring-inset ring-ring" %>
            <% target_title, target_caption, target_title_classes = margin_rule_target_info(rule, @hotels) %>

            <div class="rounded-2xl border border-border bg-muted/60 p-4 shadow-sm">
              <div class="flex items-start justify-between gap-3">
                <div>
                  <p class="text-sm font-semibold <%= target_title_classes %>"><%= target_title %></p>
                  <p class="mt-1 text-sm text-muted-foreground"><%= target_caption %></p>
                </div>
                <span class="inline-flex items-center rounded-full px-3 py-1 text-xs font-semibold <%= status_classes %>"><%= rule.status.titleize %></span>
              </div>

              <div class="mt-4 flex items-center justify-between gap-3">
                <div>
                  <p class="text-xs font-semibold uppercase tracking-[0.08em] text-muted-foreground">Rate</p>
                  <p class="mt-1 text-lg font-semibold text-foreground"><%= rule.rate %>%</p>
                </div>
                <%= button_to admin_margin_rule_path(rule), method: :delete, data: { turbo_confirm: "Are you sure you want to delete this margin rule?", turbo_confirm_title: "Delete Margin Rule", turbo_confirm_color: "red" }, class: "inline-flex items-center gap-x-1.5 rounded-lg bg-red-50 px-3 py-1.5 text-xs font-semibold text-red-700 transition hover:bg-red-100" do %>
                  <svg class="size-3.5" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 6h18"/><path d="M8 6V4a1 1 0 0 1 1-1h6a1 1 0 0 1 1 1v2"/><path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6"/><path d="M10 11v6"/><path d="M14 11v6"/></svg>
                  Delete
                <% end %>
              </div>
            </div>
          <% end %>
        <% else %>
          <div class="rounded-2xl border border-dashed border-border bg-muted/60 px-4 py-8 text-center">
            <p class="text-sm font-semibold text-foreground">No margin rules yet.</p>
            <p class="mt-2 text-sm text-muted-foreground">Create the first default or override rule to start controlling platform commission settings.</p>
          </div>
        <% end %>
      </div>

      <div class="hidden lg:block overflow-x-auto">
        <table class="min-w-full">
          <thead class="bg-muted">
            <tr>
              <th scope="col" class="px-6 py-4 text-left text-[11px] font-semibold uppercase tracking-[0.1em] text-muted-foreground sm:px-8">Target</th>
              <th scope="col" class="px-6 py-4 text-left text-[11px] font-semibold uppercase tracking-[0.1em] text-muted-foreground">Rate</th>
              <th scope="col" class="px-6 py-4 text-left text-[11px] font-semibold uppercase tracking-[0.1em] text-muted-foreground">Status</th>
              <th scope="col" class="px-6 py-4 text-right text-[11px] font-semibold uppercase tracking-[0.1em] text-muted-foreground sm:px-8">Action</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-border bg-card">
            <% if @margin_rules.any? %>
              <% @margin_rules.each_with_index do |rule, index| %>
                <% status_classes = rule.status == "active" ? "bg-emerald-50 text-emerald-700 ring-1 ring-inset ring-emerald-200" : "bg-muted text-foreground ring-1 ring-inset ring-ring" %>
                <% target_title, target_caption, target_title_classes = margin_rule_target_info(rule, @hotels) %>

                <tr class="transition-colors hover:bg-muted/80 <%= index.even? ? 'bg-card' : 'bg-muted/55' %>">
                  <td class="px-6 py-4 sm:px-8">
                    <div class="min-w-[14rem]">
                      <p class="text-sm font-semibold <%= target_title_classes %>"><%= target_title %></p>
                      <p class="mt-1 text-sm text-muted-foreground"><%= target_caption %></p>
                    </div>
                  </td>
                  <td class="whitespace-nowrap px-6 py-4 text-sm font-semibold text-foreground"><%= rule.rate %>%</td>
                  <td class="whitespace-nowrap px-6 py-4">
                    <span class="inline-flex items-center rounded-full px-3 py-1 text-xs font-semibold <%= status_classes %>"><%= rule.status.titleize %></span>
                  </td>
                  <td class="px-6 py-4 text-right sm:px-8">
                    <%= button_to admin_margin_rule_path(rule), method: :delete, data: { turbo_confirm: "Are you sure you want to delete this margin rule?", turbo_confirm_title: "Delete Margin Rule", turbo_confirm_color: "red" }, class: "inline-flex items-center gap-x-1.5 rounded-lg bg-red-50 px-3 py-1.5 text-xs font-semibold text-red-700 transition hover:bg-red-100" do %>
                      <svg class="size-3.5" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 6h18"/><path d="M8 6V4a1 1 0 0 1 1-1h6a1 1 0 0 1 1 1v2"/><path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6"/><path d="M10 11v6"/><path d="M14 11v6"/></svg>
                      Delete
                    <% end %>
                  </td>
                </tr>
              <% end %>
            <% else %>
              <tr>
                <td colspan="4" class="px-6 py-12 text-center sm:px-8">
                  <div class="mx-auto max-w-sm space-y-2">
                    <p class="text-sm font-semibold text-foreground">No margin rules yet.</p>
                    <p class="text-sm text-muted-foreground">Create the first default or override rule to start controlling platform commission settings.</p>
                  </div>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
        </div>

        <div class="px-6 py-5 border-t border-border bg-muted/50 flex justify-center sm:px-8">
        <%= render PanelsUI::Pagination.new(pagy: @pagy, hide_when_single_page: true) %>
        </div>
        </div>
        </div>

</div>
