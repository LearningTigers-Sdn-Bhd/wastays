<% content_for :title, "Observation Deck" %>

<div class="observation-deck" data-controller="observation-deck" data-action="turbo:before-fetch-request@document->observation-deck#startLoading turbo:frame-load@document->observation-deck#stopLoading">
  <%= render "app_bar" %>
  <%= render "health_strip" %>

  <main class="observation-deck__main">
    <%= render ObservationDeck::FilterBar.new(params: @filter_params, clear_path: admin_observation_deck_index_path) %>

    <div class="observation-deck__workspace">
      <%= render "entries_frame" %>

      <aside class="observation-deck__inspector" aria-label="Selected event inspector" data-observation-deck-target="desktopInspector">
        <header class="observation-deck__section-header"><div><h2>Selected event inspector</h2><p>Select an event to inspect evidence.</p></div></header>
        <turbo-frame id="entry_detail_frame" class="observation-deck__detail-frame" data-observation-deck-target="frame">
          <div class="observation-deck__empty-state">
            <%= app_icon "mouse-pointer-click", class: "size-5", aria: { hidden: true } %>
            <h3>No event selected</h3>
            <p>Select a row to inspect its summary, trace, payload, and generated analysis.</p>
          </div>
        </turbo-frame>
      </aside>
    </div>
  </main>

  <dialog id="observation-inspector" class="observation-deck__mobile-inspector" aria-label="Selected event inspector" data-observation-deck-target="inspectorDialog" data-action="close->observation-deck#restoreFocus cancel->observation-deck#closeInspector">
    <div class="observation-deck__mobile-inspector-body" data-observation-deck-target="mobileInspector"></div>
  </dialog>

  <dialog id="observation-settings" class="observation-deck__settings" aria-labelledby="observation-settings-title" data-observation-deck-target="settingsDialog" data-action="close->observation-deck#restoreFocus cancel->observation-deck#closeSettings">
    <header><div><h2 id="observation-settings-title">Settings</h2><p>AI configuration and maintenance.</p></div><button type="button" class="observation-deck__icon-button" aria-label="Close settings" data-action="observation-deck#closeSettings"><%= app_icon "x", class: "size-4", aria: { hidden: true } %></button></header>
    <div class="observation-deck__settings-body">
      <section aria-labelledby="observation-theme-settings-heading">
        <h3 id="observation-theme-settings-heading">Theme</h3>
        <p>System follows your device setting. This browser remembers your selection.</p>
        <fieldset class="observation-deck__theme-options">
          <legend class="sr-only">Observation Deck theme</legend>
          <% [["System", "system"], ["Light", "light"], ["Dark", "dark"]].each do |label, value| %>
            <label><input type="radio" name="observation-deck-theme" value="<%= value %>" data-observation-deck-target="themeOption" data-action="change->observation-deck#setTheme"> <span><%= label %></span></label>
          <% end %>
        </fieldset>
      </section>

      <section aria-labelledby="observation-ai-settings-heading">
        <h3 id="observation-ai-settings-heading">AI provider</h3>
        <p>Analysis uses configured integration keys. Generated analysis never replaces captured evidence.</p>
        <% if @configured_ai_providers.any? %>
          <%= form_with url: update_config_admin_observation_deck_index_path, method: :post, class: "observation-deck__provider-form" do |f| %>
            <%= render PanelsUI::FormField.new(form: f, attribute: :observation_deck_ai_provider, label: "Provider", size: :sm) do |field| %>
              <% field.with_select_menu(@configured_ai_providers, selected: @observation_deck_ai_provider) %>
            <% end %>
            <%= f.submit "Save provider", class: "observation-deck__primary-button" %>
          <% end %>
          <%= link_to "Manage keys in Integrations", admin_integrations_path, class: "observation-deck__text-action" %>
        <% else %>
          <p>No AI provider has a configured key.</p>
          <%= link_to "Configure AI Providers", admin_integrations_path, class: "observation-deck__text-action" %>
        <% end %>
      </section>

      <section class="observation-deck__danger-zone" aria-labelledby="observation-maintenance-heading">
        <h3 id="observation-maintenance-heading">Data maintenance</h3>
        <div class="observation-deck__retention-notice" role="note">
          <%= app_icon "calendar-clock", class: "size-4", aria: { hidden: true } %>
          <div>
            <strong>Automatic retention</strong>
            <p>Runs daily at 3:00 AM server time. Entries older than seven days are removed in batches; recent incidents remain available for investigation.</p>
          </div>
        </div>
        <%= button_to "Delete all observations", clear_admin_observation_deck_index_path, method: :delete,
                      data: { turbo_confirm: "Delete all captured observations? This cannot be undone.", turbo_confirm_title: "Delete all observations", turbo_confirm_color: "red" },
                      class: "observation-deck__danger-button" %>
      </section>
    </div>
  </dialog>

  <div class="sr-only" aria-live="polite" data-observation-deck-target="announcer"></div>
</div>
