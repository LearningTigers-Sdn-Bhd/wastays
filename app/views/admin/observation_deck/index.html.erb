<% content_for :title, "Observation Deck | Mission Control" %>

<div class="min-h-screen h-screen flex flex-col bg-slate-50 text-slate-900 font-sans antialiased overflow-hidden"
     data-controller="observation-deck">
  
  <div class="flex-1 overflow-y-auto custom-scrollbar">
    <div class="max-w-[1600px] mx-auto px-4 py-8 space-y-6">
      
      <!-- Header -->
      <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-6 bg-white p-6 rounded-2xl border border-slate-200 shadow-sm">
        <div>
          <div class="flex items-center gap-3">
            <div class="p-2 bg-indigo-50 rounded-lg border border-indigo-100">
              <svg class="size-6 text-indigo-600" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" d="M2.036 12.322a1.012 1.012 0 0 1 0-.639C3.423 7.51 7.36 4.5 12 4.5c4.638 0 8.573 3.007 9.963 7.178.07.207.07.431 0 .639C20.577 16.49 16.64 19.5 12 19.5c-4.638 0-8.573-3.007-9.963-7.178Z" />
                <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z" />
              </svg>
            </div>
            <h1 class="text-xl font-bold tracking-tight text-slate-900 uppercase">Observation Deck</h1>
            <% if @error_count > 0 %>
              <div class="flex items-center gap-2">
                <div class="flex items-center gap-1.5 px-2 py-0.5 bg-rose-50 text-rose-600 rounded-full border border-rose-100 animate-pulse">
                  <span class="relative flex h-2 w-2">
                    <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-rose-400 opacity-75"></span>
                    <span class="relative inline-flex rounded-full h-2 w-2 bg-rose-500"></span>
                  </span>
                  <span class="text-[10px] font-black uppercase tracking-widest"><%= @error_count %> New Errors</span>
                </div>
                <%= button_to acknowledge_admin_observation_deck_index_path, 
                    method: :post,
                    class: "text-[10px] font-bold text-slate-400 hover:text-slate-600 transition-colors uppercase tracking-tight" do %>
                  Acknowledge All
                <% end %>
              </div>
            <% end %>

          </div>
          <p class="mt-1 text-sm font-medium text-slate-500">System internals, requests, and background jobs.</p>
        </div>

        <div class="flex items-center gap-4">
          <%= link_to "/letter_opener", target: "_blank", class: "px-4 py-2 text-sm font-bold text-slate-500 hover:text-slate-900 transition-colors flex items-center gap-2" do %>
            <svg class="size-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
            Letter Opener
          <% end %>

          <%= button_to test_email_admin_observation_deck_index_path, 
              method: :post,
              class: "px-4 py-2 text-sm font-bold text-indigo-600 bg-indigo-50 hover:bg-indigo-100 rounded-xl transition border border-indigo-100" do %>
            Send Test Email
          <% end %>

          <%= link_to admin_dashboard_path, class: "px-4 py-2 text-sm font-bold text-slate-500 hover:text-slate-900 transition-colors" do %>
            Exit
          <% end %>
          <%= button_to clear_admin_observation_deck_index_path, 
              method: :delete,
              data: { turbo_confirm: "Purge all records?" },
              class: "px-5 py-2.5 bg-rose-600 hover:bg-rose-700 text-white text-sm font-bold rounded-xl transition shadow-lg shadow-rose-200" do %>
            Clear All
          <% end %>
        </div>
      </div>

      <!-- Pulse Metrics (MVP) -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <div class="bg-white p-6 rounded-2xl border border-slate-200 shadow-sm flex items-center gap-4">
          <div class="size-12 bg-emerald-50 rounded-xl flex items-center justify-center text-emerald-600">
            <svg class="size-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6"/></svg>
          </div>
          <div>
            <p class="text-[10px] font-black uppercase tracking-widest text-slate-400">24h Throughput</p>
            <div class="flex items-baseline gap-2">
              <span class="text-2xl font-black text-slate-900"><%= number_with_delimiter(@total_requests_24h) %></span>
              <span class="text-xs font-bold text-slate-400">Requests</span>
            </div>
          </div>
        </div>

        <div class="bg-white p-6 rounded-2xl border border-slate-200 shadow-sm flex items-center gap-4">
          <div class="size-12 bg-indigo-50 rounded-xl flex items-center justify-center text-indigo-600">
            <svg class="size-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
          </div>
          <div>
            <p class="text-[10px] font-black uppercase tracking-widest text-slate-400">Avg Latency</p>
            <div class="flex items-baseline gap-2">
              <span class="text-2xl font-black text-slate-900"><%= @avg_latency_24h %></span>
              <span class="text-xs font-bold text-slate-400">ms / req</span>
            </div>
          </div>
        </div>

        <div class="bg-white p-6 rounded-2xl border border-slate-200 shadow-sm flex items-center gap-4">
          <div class="size-12 <%= @error_rate_24h > 5 ? 'bg-rose-50 text-rose-600' : 'bg-emerald-50 text-emerald-600' %> rounded-xl flex items-center justify-center">
            <svg class="size-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
          </div>
          <div>
            <p class="text-[10px] font-black uppercase tracking-widest text-slate-400">Error Rate</p>
            <div class="flex items-baseline gap-2">
              <span class="text-2xl font-black <%= @error_rate_24h > 5 ? 'text-rose-600' : 'text-slate-900' %>"><%= @error_rate_24h %>%</span>
              <span class="text-xs font-bold text-slate-400">Failures</span>
            </div>
          </div>
        </div>
      </div>

    <!-- Toolbar -->
    <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-4 bg-white p-4 rounded-xl border border-slate-200 shadow-sm">
      <div class="flex flex-wrap items-center gap-2">
        <% effective_status_group = @effective_status_group.presence || params[:status_group].presence %>
        <% all_active = params[:entry_type].blank? && params[:status].blank? && (effective_status_group.blank? || effective_status_group == "all") %>
        <%= link_to "All", admin_observation_deck_index_path, 
            class: "px-4 py-1.5 rounded-full text-xs font-bold uppercase tracking-wider transition #{all_active ? 'bg-slate-900 text-white shadow-md' : 'bg-slate-100 text-slate-500 hover:bg-slate-200'}" %>
        
        <% %w[request sql job mail api].each do |type| %>
          <%= link_to type, admin_observation_deck_index_path(entry_type: type), 
              class: "px-4 py-1.5 rounded-full text-xs font-bold uppercase tracking-wider transition #{params[:entry_type] == type ? 'bg-indigo-600 text-white shadow-md' : 'bg-slate-100 text-slate-500 hover:bg-slate-200'}" %>
        <% end %>

        <div class="w-px h-6 bg-slate-200 mx-2"></div>

        <%= link_to "Errors", admin_observation_deck_index_path(status_group: 'error'), 
            class: "px-4 py-1.5 rounded-full text-xs font-bold uppercase tracking-wider transition #{effective_status_group == 'error' ? 'bg-rose-600 text-white shadow-md' : 'bg-rose-50 text-rose-600 hover:bg-rose-100 border border-rose-100'}" %>
      </div>

      <div class="relative flex-1 max-w-md">
        <%= form_with url: admin_observation_deck_index_path, method: :get, data: { turbo_frame: "entries_table", observation_deck_target: "form" } do |f| %>
          <%= hidden_field_tag :status_group, effective_status_group if effective_status_group.present? %>
          <%= f.text_field :query, value: params[:query],
                 placeholder: "Search path, tags, or IDs...",
                 class: "w-full pl-10 pr-4 py-2 text-sm bg-slate-50 border border-slate-200 rounded-xl focus:bg-white focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500 outline-none transition-all",
                 data: { action: "input->observation-deck#search", observation_deck_target: "input" } %>
          <svg class="absolute left-3 top-2.5 size-4 text-slate-400" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="m21 21-5.197-5.197m0 0A7.5 7.5 0 1 0 5.196 5.196a7.5 7.5 0 0 0 10.607 10.607Z" />
          </svg>
        <% end %>
      </div>
    </div>

    <!-- Entries Table -->
    <%= turbo_frame_tag "entries_table", class: "block overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm" do %>
      <div class="overflow-x-auto">
        <table class="w-full text-left border-collapse">
          <thead>
            <tr class="bg-slate-50 border-b border-slate-200">
              <th class="px-6 py-4 text-[11px] font-bold uppercase tracking-widest text-slate-500">Type</th>
              <th class="px-6 py-4 text-[11px] font-bold uppercase tracking-widest text-slate-500">Path / Class</th>
              <th class="px-6 py-4 text-[11px] font-bold uppercase tracking-widest text-slate-500">Status</th>
              <th class="px-6 py-4 text-[11px] font-bold uppercase tracking-widest text-slate-500 text-right">Duration</th>
              <th class="px-6 py-4 text-[11px] font-bold uppercase tracking-widest text-slate-500">Timestamp</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-100">
            <% @entries.each do |entry| %>
              <tr class="hover:bg-slate-50 transition-colors cursor-pointer group <%= entry.status.to_i >= 400 ? 'bg-rose-50/50' : '' %>"
                  data-action="click->observation-deck#open"
                  data-entry-id="<%= entry.id %>">
                <td class="px-6 py-4">
                  <span class="inline-flex px-2 py-0.5 rounded text-[10px] font-black uppercase tracking-tighter <%= case entry.entry_type
                      when 'request' then 'bg-emerald-50 text-emerald-700 border border-emerald-100'
                      when 'job' then 'bg-amber-50 text-amber-700 border border-amber-100'
                      when 'sql' then 'bg-indigo-50 text-indigo-700 border border-indigo-100'
                      when 'mail' then 'bg-blue-50 text-blue-700 border border-blue-100'
                      when 'api' then 'bg-purple-50 text-purple-700 border border-purple-100'
                      else 'bg-slate-50 text-slate-700 border border-slate-100'
                      end %>">
                    <%= entry.entry_type %>
                  </span>
                </td>
                <td class="px-6 py-4">
                  <div class="text-sm font-bold text-slate-900 truncate max-w-2xl">
                    <%= entry.human_title %>
                  </div>
                  <div class="text-[10px] font-mono text-slate-400 truncate max-w-2xl mt-0.5">
                    <%= entry.path %>
                  </div>
                  <div class="flex items-center gap-2 mt-2">
                    <span class="text-[10px] bg-indigo-50 text-indigo-700 px-1.5 py-0.5 rounded font-black uppercase tracking-tighter border border-indigo-100"><%= entry.human_identity %></span>
                    <% 
                      tags = entry.tags
                      tags = JSON.parse(tags) if tags.is_a?(String)
                    %>
                    <% Array(tags).each do |tag| %>
                      <% next if tag.start_with?('user:') || tag.start_with?('booking:') %>
                      <span class="text-[10px] bg-slate-100 text-slate-600 px-1.5 py-0.5 rounded font-bold"><%= tag %></span>
                    <% end %>
                    <% if entry.request_id.present? && entry.request_id != "none" %>
                      <span class="text-[10px] font-mono text-slate-400">#<%= entry.request_id.first(8) %></span>
                    <% end %>
                  </div>
                </td>
                <td class="px-6 py-4">
                  <% if entry.status.present? %>
                    <span class="text-sm font-bold <%= entry.status.to_i >= 400 ? 'text-rose-600' : 'text-slate-600' %>">
                      <%= entry.status %>
                    </span>
                  <% else %>
                    <span class="text-slate-300">-</span>
                  <% end %>
                </td>
                <td class="px-6 py-4 text-right">
                  <div class="text-sm font-mono text-slate-600">
                    <%= number_with_precision(entry.duration, precision: 1) %> <span class="text-[10px] opacity-50">ms</span>
                  </div>
                </td>
                <td class="px-6 py-4">
                  <div class="text-xs text-slate-500 tabular-nums">
                    <%= entry.created_at.strftime("%H:%M:%S") %>
                    <div class="text-[10px] opacity-50"><%= entry.created_at.strftime("%b %d") %></div>
                  </div>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>

        <% if @entries.total_pages > 1 %>
          <div class="px-6 py-6 border-t border-slate-100 bg-slate-50/50">
            <%= paginate @entries %>
          </div>
        <% end %>
      </div>
    <% end %>
  </div>

  <!-- Detail Slide-over -->
  <div class="fixed inset-0 z-50 overflow-hidden hidden"
       data-observation-deck-target="panel">
    
    <div class="absolute inset-0 bg-slate-900/40 backdrop-blur-sm"
         data-action="click->observation-deck#closeOnBackdrop"></div>
    
    <div class="absolute inset-y-0 right-0 max-w-full flex">
      <div class="w-screen max-w-4xl bg-white shadow-2xl flex flex-col">
        <div class="p-6 border-b border-slate-200 flex items-center justify-between bg-slate-50">
          <div class="flex items-center gap-3">
             <h3 class="text-lg font-bold text-slate-900 tracking-tight">Entry Details</h3>
          </div>
          <button data-action="click->observation-deck#close" class="text-slate-400 hover:text-slate-900 transition-colors p-2 hover:bg-slate-200 rounded-lg">
            <svg class="size-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
          </button>
        </div>
        
        <div class="flex-1 overflow-y-auto custom-scrollbar bg-white">
          <turbo-frame id="entry_detail_frame"
                       src=""
                       class="block"
                       data-observation-deck-target="frame">
            <div class="p-12 flex justify-center">
              <div class="animate-spin rounded-full h-8 w-8 border-b-2 border-indigo-600"></div>
            </div>
          </turbo-frame>
        </div>
      </div>
    </div>
  </div>
</div>

<style>
  .custom-scrollbar::-webkit-scrollbar {
    width: 8px;
    height: 8px;
  }
  .custom-scrollbar::-webkit-scrollbar-track {
    background: #f8fafc;
  }
  .custom-scrollbar::-webkit-scrollbar-thumb {
    background: #e2e8f0;
    border-radius: 4px;
  }
  .custom-scrollbar::-webkit-scrollbar-thumb:hover {
    background: #cbd5e1;
  }

  /* Kaminari Light Theme */
  .pagination {
    display: flex;
    gap: 0.25rem;
    align-items: center;
  }
  .pagination a, .pagination span {
    padding: 0.5rem 0.875rem;
    font-size: 0.75rem;
    font-weight: 700;
    border-radius: 0.75rem;
    background: white;
    color: #64748b;
    border: 1px solid #e2e8f0;
    transition: all 0.2s;
  }
  .pagination .current {
    background: #4f46e5;
    color: white;
    border-color: #4f46e5;
    box-shadow: 0 4px 6px -1px rgb(79 70 229 / 0.1), 0 2px 4px -2px rgb(79 70 229 / 0.1);
  }
  .pagination a:hover {
    background: #f8fafc;
    color: #0f172a;
    border-color: #cbd5e1;
  }
</style>
