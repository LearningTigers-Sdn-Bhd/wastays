<% content_for :title, "Observation Deck | Mission Control" %>

<div class="min-h-screen bg-slate-950 text-slate-200 font-sans antialiased">
  <div class="max-w-[1600px] mx-auto px-4 py-8 space-y-8">
    
    <!-- Header -->
    <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-6 bg-slate-900/50 p-6 rounded-2xl border border-slate-800 shadow-2xl backdrop-blur-sm">
      <div>
        <div class="flex items-center gap-3">
          <div class="p-2 bg-indigo-500/10 rounded-lg border border-indigo-500/20">
            <svg class="size-6 text-indigo-400" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" d="M2.036 12.322a1.012 1.012 0 0 1 0-.639C3.423 7.51 7.36 4.5 12 4.5c4.638 0 8.573 3.007 9.963 7.178.07.207.07.431 0 .639C20.577 16.49 16.64 19.5 12 19.5c-4.638 0-8.573-3.007-9.963-7.178Z" />
              <path stroke-linecap="round" stroke-linejoin="round" d="M15 12.a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z" />
            </svg>
          </div>
          <h1 class="text-2xl font-bold tracking-tight text-white uppercase">Observation Deck</h1>
        </div>
        <p class="mt-2 text-sm font-medium text-slate-400">System internals, requests, and background jobs in real-time.</p>
      </div>

      <div class="flex items-center gap-4">
        <%= link_to admin_dashboard_path, class: "px-4 py-2 text-sm font-bold text-slate-400 hover:text-white transition-colors" do %>
          Exit Mission Control
        <% end %>
        <%= button_to clear_admin_observation_deck_index_path, 
            method: :delete,
            data: { turbo_confirm: "Are you sure you want to purge all observation records? This cannot be undone." },
            class: "px-5 py-2.5 bg-rose-600 hover:bg-rose-500 text-white text-sm font-bold rounded-xl transition shadow-lg shadow-rose-900/20" do %>
          Clear All
        <% end %>
      </div>
    </div>

    <!-- Filters -->
    <div class="flex flex-wrap items-center gap-3 bg-slate-900/30 p-4 rounded-xl border border-slate-800/50">
      <% %w[request sql job cache].each do |type| %>
        <%= link_to admin_observation_deck_index_path(entry_type: type), 
            class: "px-4 py-1.5 rounded-full text-xs font-bold uppercase tracking-wider transition #{params[:entry_type] == type ? 'bg-indigo-600 text-white shadow-lg shadow-indigo-900/40' : 'bg-slate-800 text-slate-400 hover:bg-slate-700'}" do %>
          <%= type %>
        <% end %>
      <% end %>
      <% if params[:entry_type].present? %>
        <%= link_to "Reset", admin_observation_deck_index_path, class: "text-xs font-bold text-slate-500 hover:text-slate-300 ml-2" %>
      <% end %>
    </div>

    <!-- Entries Table -->
    <div class="overflow-hidden rounded-2xl border border-slate-800 bg-slate-900 shadow-2xl">
      <div class="overflow-x-auto">
        <table class="w-full text-left border-collapse">
          <thead>
            <tr class="bg-slate-800/50 border-b border-slate-800">
              <th class="px-6 py-4 text-[11px] font-bold uppercase tracking-widest text-slate-400">Type</th>
              <th class="px-6 py-4 text-[11px] font-bold uppercase tracking-widest text-slate-400">Path / Class</th>
              <th class="px-6 py-4 text-[11px] font-bold uppercase tracking-widest text-slate-400">Status</th>
              <th class="px-6 py-4 text-[11px] font-bold uppercase tracking-widest text-slate-400">Duration</th>
              <th class="px-6 py-4 text-[11px] font-bold uppercase tracking-widest text-slate-400">Timestamp</th>
              <th class="px-6 py-4"></th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-800/50">
            <% @entries.each do |entry| %>
              <tr class="hover:bg-slate-800/30 transition-colors group">
                <td class="px-6 py-4">
                  <span class="inline-flex px-2 py-0.5 rounded text-[10px] font-black uppercase tracking-tighter <%= case entry.entry_type
                      when 'request' then 'bg-emerald-500/10 text-emerald-400 border border-emerald-500/20'
                      when 'job' then 'bg-amber-500/10 text-amber-400 border border-amber-500/20'
                      when 'sql' then 'bg-indigo-500/10 text-indigo-400 border border-indigo-500/20'
                      else 'bg-slate-500/10 text-slate-400 border border-slate-500/20'
                      end %>">
                    <%= entry.entry_type %>
                  </span>
                </td>
                <td class="px-6 py-4">
                  <div class="text-sm font-mono text-slate-300 truncate max-w-md group-hover:text-white transition-colors" title="<%= entry.path %>">
                    <%= entry.path %>
                  </div>
                  <div class="text-[10px] font-mono text-slate-600 mt-1"><%= entry.request_id %></div>
                </td>
                <td class="px-6 py-4">
                  <span class="text-sm font-bold <%= entry.status.to_i >= 400 ? 'text-rose-500' : 'text-slate-400' %>">
                    <%= entry.status || '-' %>
                  </span>
                </td>
                <td class="px-6 py-4">
                  <div class="text-sm font-mono text-slate-400 italic">
                    <%= number_with_precision(entry.duration, precision: 2) %> <span class="text-[10px] opacity-50">ms</span>
                  </div>
                </td>
                <td class="px-6 py-4">
                  <div class="text-xs text-slate-500 tabular-nums">
                    <%= entry.created_at.strftime("%H:%M:%S.%L") %>
                    <div class="text-[10px] opacity-50 mt-0.5"><%= entry.created_at.strftime("%b %d") %></div>
                  </div>
                </td>
                <td class="px-6 py-4 text-right">
                  <div x-data="{ open: false }">
                    <button @click="open = !open" class="text-slate-500 hover:text-white transition-colors p-2 hover:bg-slate-700 rounded-lg">
                      <svg class="size-5" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M12 6.75a.75.75 0 1 1 0-1.5.75.75 0 0 1 0 1.5ZM12 12.75a.75.75 0 1 1 0-1.5.75.75 0 0 1 0 1.5ZM12 18.75a.75.75 0 1 1 0-1.5.75.75 0 0 1 0 1.5Z" />
                      </svg>
                    </button>
                    
                    <div x-show="open" @click.away="open = false" 
                         class="fixed inset-0 z-50 flex items-center justify-center bg-slate-950/80 backdrop-blur-sm p-4 md:p-8" 
                         style="display: none;">
                      <div class="bg-slate-900 border border-slate-800 rounded-2xl w-full max-w-4xl max-h-[80vh] overflow-hidden flex flex-col shadow-2xl ring-1 ring-white/10">
                        <div class="p-6 border-b border-slate-800 flex items-center justify-between bg-slate-800/30">
                          <div class="flex items-center gap-3">
                            <span class="px-2 py-0.5 rounded bg-indigo-500/10 text-indigo-400 text-[10px] font-black uppercase tracking-widest border border-indigo-500/20"><%= entry.entry_type %></span>
                            <h3 class="text-lg font-bold text-white font-mono truncate max-w-xl"><%= entry.path %></h3>
                          </div>
                          <button @click="open = false" class="text-slate-400 hover:text-white transition-colors">
                            <svg class="size-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
                          </button>
                        </div>
                        <div class="p-8 overflow-y-auto custom-scrollbar flex-1 bg-[#0d1117]">
                           <pre class="text-sm font-mono leading-relaxed"><code class="text-emerald-400"><%= JSON.pretty_generate(entry.payload) %></code></pre>
                        </div>
                      </div>
                    </div>
                  </div>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>

      <% if @entries.total_pages > 1 %>
        <div class="px-6 py-6 border-t border-slate-800 bg-slate-800/20">
          <%= paginate @entries %>
        </div>
      <% end %>
    </div>
  </div>
</div>

<style>
  .custom-scrollbar::-webkit-scrollbar {
    width: 10px;
    height: 10px;
  }
  .custom-scrollbar::-webkit-scrollbar-track {
    background: #0d1117;
  }
  .custom-scrollbar::-webkit-scrollbar-thumb {
    background: #21262d;
    border-radius: 5px;
    border: 2px solid #0d1117;
  }
  .custom-scrollbar::-webkit-scrollbar-thumb:hover {
    background: #30363d;
  }

  /* Kaminari Overrides for Dark Theme */
  .pagination {
    display: flex;
    gap: 0.25rem;
    align-items: center;
  }
  .pagination a, .pagination span {
    padding: 0.5rem 0.75rem;
    font-size: 0.75rem;
    font-weight: 700;
    border-radius: 0.5rem;
    background: #1e293b;
    color: #94a3b8;
    transition: all 0.2s;
  }
  .pagination .current {
    background: #4f46e5;
    color: white;
  }
  .pagination a:hover {
    background: #334155;
    color: white;
  }
</style>
