<%= turbo_frame_tag "entry_detail_#{@entry.id}" do %>
  <div class="p-6 space-y-8 animate-in fade-in slide-in-from-right-4 duration-300">
    
    <!-- Core Details -->
    <div class="grid grid-cols-2 gap-6">
      <div class="space-y-1">
        <p class="text-[10px] font-bold uppercase tracking-widest text-slate-500">Entry ID</p>
        <p class="text-sm font-mono text-slate-900 font-medium select-all"><%= @entry.id %></p>
      </div>
      <div class="space-y-1">
        <p class="text-[10px] font-bold uppercase tracking-widest text-slate-500">Timestamp</p>
        <p class="text-sm text-slate-900 font-medium"><%= @entry.created_at.strftime("%B %d, %Y at %H:%M:%S.%L") %></p>
      </div>
      <div class="space-y-1">
        <p class="text-[10px] font-bold uppercase tracking-widest text-slate-500">Request ID</p>
        <% if @entry.request_id.present? && @entry.request_id != "none" %>
          <%= link_to admin_observation_deck_index_path(request_id: @entry.request_id), 
              class: "text-sm font-mono text-indigo-600 hover:text-indigo-700 font-bold border-b border-indigo-200 border-dotted", 
              data: { turbo_frame: "entries_table" } do %>
            <%= @entry.request_id %>
          <% end %>
        <% else %>
          <p class="text-sm text-slate-400 italic">None</p>
        <% end %>
      </div>
      <div class="space-y-1">
        <p class="text-[10px] font-bold uppercase tracking-widest text-slate-500">Duration</p>
        <p class="text-sm text-slate-900 font-bold font-mono"><%= number_with_precision(@entry.duration, precision: 2) %> ms</p>
      </div>
    </div>

    <!-- Request Metadata -->
    <% if @entry.entry_type == 'request' %>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 pt-6 border-t border-slate-100">
        <div class="space-y-3">
          <p class="text-[10px] font-bold uppercase tracking-widest text-slate-500">User Identity</p>
          <% 
            user_id_tag = @entry.tags.find { |t| t.start_with?("user:") }
            user = User.find_by(id: user_id_tag.split(":").last) if user_id_tag
          %>
          <% if user %>
            <div class="flex items-center gap-3 bg-slate-50 p-3 rounded-xl border border-slate-100">
              <div class="size-8 rounded-full bg-indigo-100 flex items-center justify-center text-indigo-700 font-bold text-xs uppercase">
                <%= user.name.first %>
              </div>
              <div>
                <p class="text-sm font-bold text-slate-900"><%= user.name %></p>
                <p class="text-[11px] text-slate-500"><%= user.email %></p>
              </div>
            </div>
          <% else %>
            <p class="text-sm text-slate-400 italic">Guest / Unauthenticated</p>
          <% end %>
        </div>

        <div class="space-y-3">
          <p class="text-[10px] font-bold uppercase tracking-widest text-slate-500">Network Info</p>
          <div class="bg-slate-50 p-3 rounded-xl border border-slate-100 space-y-2">
            <div class="flex justify-between items-center">
              <span class="text-xs text-slate-500">IP Address</span>
              <span class="text-xs font-mono text-slate-900 font-bold"><%= @entry.payload['remote_ip'] || 'Unknown' %></span>
            </div>
            <div class="flex flex-col gap-1">
              <span class="text-xs text-slate-500">User Agent</span>
              <span class="text-[10px] font-mono text-slate-400 leading-tight truncate" title="<%= @entry.payload['user_agent'] %>">
                <%= @entry.payload['user_agent'] %>
              </span>
            </div>
          </div>
        </div>
      </div>
    <% end %>

    <!-- Error Callout for Failures -->
    <% if @entry.status.to_i >= 400 %>
      <div class="bg-rose-50 border border-rose-100 rounded-2xl p-6 space-y-3">
        <div class="flex items-center gap-2 text-rose-700">
          <svg class="size-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
          <h4 class="text-sm font-bold uppercase tracking-tight">Execution Failure</h4>
        </div>
        <% if @entry.payload['exception'] || @entry.payload['exception_object'] %>
          <pre class="text-xs font-mono text-rose-800 bg-rose-100/50 p-4 rounded-xl overflow-x-auto whitespace-pre-wrap"><%= @entry.payload['exception'] || @entry.payload['exception_object'] %></pre>
        <% end %>
      </div>
    <% end %>

    <!-- Tags -->
    <% if @entry.tags.present? %>
      <div class="space-y-2">
        <p class="text-[10px] font-bold uppercase tracking-widest text-slate-500">Context Tags</p>
        <div class="flex flex-wrap gap-2">
          <% @entry.tags.each do |tag| %>
            <%= link_to admin_observation_deck_index_path(query: tag), 
                class: "px-2 py-1 bg-slate-100 text-slate-700 text-xs font-bold rounded-lg border border-slate-200 hover:bg-slate-200 transition-colors",
                data: { turbo_frame: "entries_table" } do %>
              <%= tag %>
            <% end %>
          <% end %>
        </div>
      </div>
    <% end %>

    <!-- Special Viewers -->
    <% if @entry.entry_type == 'mail' %>
      <div class="space-y-4" x-data="{ view: 'html' }">
        <div class="flex items-center justify-between">
          <p class="text-[10px] font-bold uppercase tracking-widest text-slate-500">Mail Content</p>
          <div class="flex bg-slate-100 p-1 rounded-lg">
            <button @click="view = 'html'" :class="view === 'html' ? 'bg-white shadow-sm text-indigo-600' : 'text-slate-500'" class="px-3 py-1 text-xs font-bold rounded-md transition-all">HTML</button>
            <button @click="view = 'text'" :class="view === 'text' ? 'bg-white shadow-sm text-indigo-600' : 'text-slate-500'" class="px-3 py-1 text-xs font-bold rounded-md transition-all">Text</button>
            <button @click="view = 'raw'" :class="view === 'raw' ? 'bg-white shadow-sm text-indigo-600' : 'text-slate-500'" class="px-3 py-1 text-xs font-bold rounded-md transition-all">Raw JSON</button>
          </div>
        </div>

        <div x-show="view === 'html'" class="border border-slate-200 rounded-2xl overflow-hidden bg-white shadow-inner ring-1 ring-slate-100">
          <iframe srcdoc="<%= @entry.payload['html_body'] %>" 
                  class="w-full min-h-[600px] bg-white" 
                  sandbox="allow-popups allow-popups-to-escape-sandbox"
                  frameborder="0"></iframe>
        </div>

        <div x-show="view === 'text'" class="border border-slate-200 rounded-2xl p-6 bg-slate-50 font-mono text-sm text-slate-700 whitespace-pre-wrap">
          <%= @entry.payload['text_body'] %>
        </div>
        
        <div x-show="view === 'raw'">
           <pre class="bg-slate-900 rounded-2xl p-6 overflow-x-auto"><code class="text-indigo-300 text-xs"><%= JSON.pretty_generate(@entry.payload) %></code></pre>
        </div>
      </div>
    <% elsif @entry.entry_type == 'sql' %>
       <div class="space-y-2">
        <p class="text-[10px] font-bold uppercase tracking-widest text-slate-500">SQL Query</p>
        <div class="bg-slate-900 rounded-2xl p-6 border border-slate-800 shadow-inner group relative">
          <pre class="whitespace-pre-wrap font-mono text-sm leading-relaxed"><code class="text-emerald-400"><%= @entry.payload['sql'] %></code></pre>
          <button class="absolute top-4 right-4 p-2 bg-slate-800 text-slate-400 rounded-lg opacity-0 group-hover:opacity-100 transition-opacity hover:text-white"
                  onclick="navigator.clipboard.writeText('<%= j @entry.payload['sql'] %>')">
            <svg class="size-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7v8a2 2 0 002 2h6M8 7V5a2 2 0 012-2h4.586a1 1 0 011.414.172l3.828 3.828a1 1 0 01.172 1.414V17a2 2 0 01-2 2H10a2 2 0 01-2-2V7z"/></svg>
          </button>
        </div>
      </div>
    <% else %>
      <!-- Default JSON Tree View -->
      <div class="space-y-2">
        <p class="text-[10px] font-bold uppercase tracking-widest text-slate-500">Payload Data</p>
        <div class="bg-slate-900 rounded-2xl p-6 overflow-x-auto border border-slate-800 shadow-2xl">
          <pre class="text-sm font-mono leading-relaxed"><code class="text-indigo-300"><%= JSON.pretty_generate(@entry.payload) %></code></pre>
        </div>
      </div>
    <% end %>

    <!-- Sibling Traceability -->
    <% if @siblings.present? %>
      <div class="space-y-4 pt-6 border-t border-slate-100">
        <p class="text-[10px] font-bold uppercase tracking-widest text-slate-500">Trace Timeline (Request ID: <%= @entry.request_id.first(8) %>)</p>
        <div class="space-y-2">
          <% @siblings.each do |sibling| %>
            <div class="flex items-center justify-between p-3 rounded-xl border border-slate-100 bg-slate-50 hover:bg-white hover:shadow-sm transition-all group cursor-pointer"
                 @click="openEntry('<%= sibling.id %>')">
              <div class="flex items-center gap-3">
                <span class="text-[9px] font-black uppercase px-1.5 py-0.5 rounded <%= case sibling.entry_type
                    when 'request' then 'bg-emerald-100 text-emerald-700'
                    when 'job' then 'bg-amber-100 text-amber-700'
                    when 'sql' then 'bg-indigo-100 text-indigo-700'
                    else 'bg-slate-200 text-slate-600'
                    end %>">
                  <%= sibling.entry_type %>
                </span>
                <span class="text-xs font-mono text-slate-600 truncate max-w-md"><%= sibling.path %></span>
              </div>
              <div class="flex items-center gap-3">
                <% if sibling.status.present? %>
                  <span class="text-[10px] font-bold <%= sibling.status.to_i >= 400 ? 'text-rose-600' : 'text-slate-400' %>"><%= sibling.status %></span>
                <% end %>
                <span class="text-[10px] font-mono text-slate-400"><%= number_with_precision(sibling.duration, precision: 1) %>ms</span>
              </div>
            </div>
          <% end %>
        </div>
      </div>
    <% end %>

  </div>
<% end %>
