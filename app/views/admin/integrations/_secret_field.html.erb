<%# A credential field with a reveal toggle. The rest of the portal uses a plain
    password input, but an API key is pasted rather than typed, so the admin
    needs to see what actually landed in the field. %>
<%= render PanelsUI::FormField.new(
      form: form,
      attribute: name,
      label: label,
      hint: local_assigns[:hint],
      data: { controller: "password-toggle" }) do |field| %>
  <% field.with_input(
       type: :password,
       value: value,
       autocomplete: "off",
       placeholder: local_assigns[:placeholder],
       data: { password_toggle_target: "input" }) %>
  <% field.with_addon(align: :inline_end, variant: :bare) do %>
    <%= render PanelsUI::Button.new(
          variant: :ghost,
          size: :icon_sm,
          aria_label: "Show password",
          aria: { pressed: "false" },
          data: {
            password_toggle_target: "button",
            action: "click->password-toggle#toggle"
          }) do %>
      <%= app_icon "eye", class: "size-4", aria: { hidden: "true" }, data: { password_toggle_target: "showIcon" } %>
      <%= app_icon "eye-off", class: "hidden size-4", aria: { hidden: "true" }, data: { password_toggle_target: "hideIcon" } %>
    <% end %>
  <% end %>
<% end %>
