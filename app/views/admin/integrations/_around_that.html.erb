<%= render "section_shell",
    title: "AroundThat",
    description: "Nearby experiences and activities pulled into concierge recommendations.",
    icon_name: "map-pin" do %>
  <%= form_with url: admin_integrations_path, method: :patch, local: true, class: "space-y-5" do |form| %>
    <div class="grid grid-cols-1 gap-5 md:grid-cols-2">
      <%= render PanelsUI::FormField.new(
            form: form,
            attribute: :aroundthat_environment,
            label: "Environment",
            hint: "Staging keeps test bookings out of the live catalogue.") do |field| %>
        <% field.with_select_menu(
             Admin::IntegrationsController::AROUND_THAT_ENVIRONMENTS,
             selected: @around_that_values["aroundthat_environment"]) %>
      <% end %>

      <%= render "secret_field",
          name: :aroundthat_api_key,
          label: "API Key",
          value: @around_that_values["aroundthat_api_key"],
          placeholder: "Enter AroundThat API key" %>

      <div class="md:col-span-2">
        <%= label_tag :aroundthat_base_url, "Base URL", class: "mb-1.5 block text-sm font-semibold text-foreground" %>
        <%= text_field_tag :aroundthat_base_url, @around_that_values["aroundthat_base_url"],
            placeholder: "https://api.aroundthat.example/v1",
            class: "w-full rounded-lg border border-border bg-card px-3 py-2.5 text-sm text-foreground shadow-sm focus:border-border-interactive focus:outline-none focus:ring-2 focus:ring-ring/10" %>
        <p class="mt-1.5 text-xs text-muted-foreground">The host for the selected environment. Change it when you switch environment.</p>
      </div>
    </div>

    <div class="flex flex-col gap-3 border-t border-border pt-4 sm:flex-row sm:items-center sm:justify-between">
      <button
        type="button"
        id="test-around-that-btn"
        data-url="<%= test_around_that_connection_admin_integrations_path %>"
        onclick="testAroundThatConnection()"
        class="cursor-pointer rounded-lg border border-border bg-card px-5 py-2.5 text-sm font-bold text-foreground shadow-sm transition hover:bg-muted"
      >
        Test Connection
      </button>
      <%= submit_tag "Save AroundThat", class: "cursor-pointer rounded-lg bg-brand-primary px-5 py-2.5 text-sm font-bold text-primary-foreground shadow-sm transition hover:bg-brand-secondary" %>
    </div>
  <% end %>

  <p id="test-around-that-status" class="mt-3 text-sm text-muted-foreground" role="status" aria-live="polite"></p>

  <script>
    async function testAroundThatConnection() {
      const btn = document.getElementById("test-around-that-btn");
      const status = document.getElementById("test-around-that-status");
      const originalText = btn.innerText;

      btn.disabled = true;
      btn.innerText = "Testing...";
      btn.classList.add("opacity-50");
      status.textContent = "Testing the saved AroundThat settings...";

      try {
        const response = await fetch(btn.dataset.url, {
          method: "POST",
          headers: {
            "X-CSRF-Token": document.querySelector("meta[name='csrf-token']").content,
            "Content-Type": "application/json",
            "Accept": "application/json"
          }
        });

        const data = await response.json();
        status.textContent = data.message;
      } catch (error) {
        status.textContent = "Could not reach the server.";
      } finally {
        btn.disabled = false;
        btn.innerText = originalText;
        btn.classList.remove("opacity-50");
      }
    }
  </script>
<% end %>
