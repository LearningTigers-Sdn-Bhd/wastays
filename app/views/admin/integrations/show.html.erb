<% content_for :title, "Integrations | WAStays Admin" %>

<div class="w-full space-y-6">
  <div class="space-y-2">
    <p class="text-xs font-black uppercase tracking-[0.22em] text-brand-primary">Platform Control</p>
    <%= render PanelsUI::PageHeader.new(
          title: "Integrations",
          description: "Configure external connections and global AI services for WAStays.") %>
  </div>

  <div class="grid min-h-0 flex-1 grid-cols-1 gap-6 xl:grid-cols-3 xl:items-start">
    <aside class="xl:col-span-1 xl:sticky xl:top-6">
      <%= render "how_it_works" %>
    </aside>

    <div class="min-h-0 space-y-6 xl:col-span-2 xl:max-h-[calc(100vh-12rem)] xl:overflow-y-auto xl:pr-2">
      <%= render "channel_manager" %>
      <%= render "storage" %>
      <%= render "ai_providers" %>
    </div>
  </div>
</div>
