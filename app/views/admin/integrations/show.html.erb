<% content_for :title, "Integrations | WAStays Admin" %>

<% content_for :breadcrumbs do %>
  <%= render "shared/navigation/admin_breadcrumbs", current: "Integrations" %>
<% end %>

<div class="max-w-[1600px] mx-auto pb-20 space-y-8">
  <div class="px-4 md:px-0">
    <div class="mt-5">
      <h1 class="text-2xl font-bold tracking-tight text-slate-950 sm:text-3xl">Integrations</h1>
      <p class="mt-1 text-sm font-medium text-slate-600">Configure external connections via webhook for WAStays.</p>
    </div>
  </div>

  <div class="grid grid-cols-1 gap-8 xl:grid-cols-[minmax(0,1fr)_minmax(0,350px)] xl:items-start">
    <div class="space-y-8">
      <!-- Webhook Card -->
      <div class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">
        <div class="border-b border-slate-200 px-6 py-5 sm:px-8">
          <h2 class="text-lg font-bold tracking-tight text-slate-950 sm:text-xl">Webhook</h2>
          <p class="mt-1 text-sm font-medium text-slate-600">Connect WAStays to external services via webhook.</p>
        </div>

        <%= form_with url: admin_integrations_path, method: :patch, local: true, class: "space-y-6 p-6 sm:p-8" do |f| %>
          <div>
            <%= label_tag :webhook_url, "Webhook URL", class: "mb-1.5 block text-sm font-semibold text-slate-700" %>
            <p class="mb-2 text-sm text-slate-500">Paste your webhook endpoint URL. WAStays will send a POST request to this URL when events occur.</p>
            <%= text_field_tag :webhook_url, @webhook_url,
                placeholder: "https://your-webhook-endpoint.com/...",
                class: "w-full rounded-xl border border-slate-200 px-3 py-2.5 text-sm focus:border-slate-900 focus:outline-none focus:ring-2 focus:ring-slate-900/20" %>
          </div>

          <% if @webhook_url.present? %>
            <div class="flex items-center justify-between rounded-xl border border-slate-200 bg-slate-50 px-4 py-3">
              <div>
                <p class="text-sm font-semibold text-slate-700">Test your connection</p>
                <p class="text-xs text-slate-500">Send a sample payload to verify your webhook is receiving requests correctly.</p>
              </div>
              <%= link_to "Send Test Ping", test_ping_admin_integrations_path,
                  data: { turbo_method: :post },
                  class: "shrink-0 rounded-xl border border-slate-200 bg-white px-4 py-2 text-sm font-semibold text-slate-700 hover:bg-slate-100 ml-4" %>
            </div>
          <% end %>

          <div class="flex items-center justify-end gap-3 border-t border-slate-200 pt-4">
            <% if @webhook_url.present? %>
              <%= link_to "Remove", admin_integrations_path,
                  data: { turbo_method: :delete, turbo_confirm: "Remove the configured webhook URL?" },
                  class: "cursor-pointer rounded-xl bg-red-600 hover:bg-red-700 px-4 py-2.5 text-sm font-bold text-white" %>
            <% end %>
            <%= submit_tag "Save Webhook", class: "cursor-pointer rounded-xl bg-slate-900 px-6 py-2.5 text-sm font-bold text-white hover:bg-slate-700" %>
          </div>
        <% end %>
      </div>

      <!-- Channel Manager Card -->
      <div class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">
        <div class="border-b border-slate-200 px-6 py-5 sm:px-8 bg-brand-secondary/5">
          <h2 class="text-lg font-bold tracking-tight text-slate-950 sm:text-xl text-brand-primary">Channel Manager (Channex)</h2>
          <p class="mt-1 text-sm font-medium text-slate-600">Configure global connectivity to OTAs through Channex.</p>
        </div>

        <%= form_with url: admin_integrations_path, method: :patch, local: true, class: "space-y-6 p-6 sm:p-8" do |f| %>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <div>
              <%= label_tag :channex_environment, "Environment", class: "mb-1.5 block text-sm font-semibold text-slate-700" %>
              <%= select_tag :channex_environment, options_for_select([["Staging", "staging"], ["Production", "production"]], @channex_environment),
                  class: "w-full rounded-xl border border-slate-200 px-3 py-2.5 text-sm focus:border-slate-900 focus:outline-none focus:ring-2 focus:ring-slate-900/20" %>
            </div>
            
            <div>
              <%= label_tag :channex_api_key, "User API Key", class: "mb-1.5 block text-sm font-semibold text-slate-700" %>
              <%= password_field_tag :channex_api_key, @channex_api_key,
                  placeholder: "Enter Channex User API Key",
                  class: "w-full rounded-xl border border-slate-200 px-3 py-2.5 text-sm focus:border-slate-900 focus:outline-none focus:ring-2 focus:ring-slate-900/20" %>
            </div>
          </div>

          <div class="bg-blue-50 rounded-xl p-4 border border-blue-100">
            <h4 class="text-xs font-bold text-blue-900 uppercase tracking-widest mb-1">Webhook Configuration</h4>
            <p class="text-xs text-blue-700 leading-relaxed">
              Ensure you have configured the following webhook URL in your Channex dashboard for real-time booking delivery:
              <code class="block mt-2 font-mono bg-white/50 p-2 rounded border border-blue-200 text-blue-900 select-all"><%= root_url %>webhooks/channex</code>
            </p>
          </div>

          <div class="flex items-center justify-end gap-3 border-t border-slate-200 pt-4">
            <%= submit_tag "Save CM Settings", class: "cursor-pointer rounded-xl bg-brand-primary px-6 py-2.5 text-sm font-bold text-white hover:bg-brand-secondary transition-colors shadow-lg shadow-brand-primary/20" %>
          </div>
        <% end %>
      </div>
    </div>

    <div>
      <div class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">
        <div class="border-b border-slate-200 bg-slate-50/70 px-6 py-5">
          <h2 class="text-base font-bold text-slate-950">How It Works</h2>
          <p class="mt-1 text-sm font-medium text-slate-600">How WAStays communicates with your external service.</p>
        </div>
        <div class="space-y-4 p-6">
          <div class="rounded-xl border border-slate-200 bg-white p-4">
            <div class="flex items-start gap-3">
              <span class="inline-flex h-6 min-w-6 items-center justify-center rounded-full bg-slate-900 px-2 text-xs font-bold text-white">1</span>
              <div>
                <p class="text-sm font-semibold text-slate-900">Event Triggered</p>
                <p class="mt-1 text-sm text-slate-600">An event occurs in WAStays (e.g. booking confirmed).</p>
              </div>
            </div>
          </div>

          <div class="rounded-xl border border-emerald-200 bg-emerald-50/40 p-4">
            <div class="flex items-start gap-3">
              <span class="inline-flex h-6 min-w-6 items-center justify-center rounded-full bg-emerald-600 px-2 text-xs font-bold text-white">2</span>
              <div>
                <p class="text-sm font-semibold text-emerald-800">POST Request Sent</p>
                <p class="mt-1 text-sm text-emerald-700">WAStays sends a JSON payload to your configured webhook URL.</p>
              </div>
            </div>
          </div>

          <div class="rounded-xl border border-amber-200 bg-amber-50/50 p-4">
            <div class="flex items-start gap-3">
              <span class="inline-flex h-6 min-w-6 items-center justify-center rounded-full bg-amber-500 px-2 text-xs font-bold text-white">3</span>
              <div>
                <p class="text-sm font-semibold text-amber-800">Your Service Responds</p>
                <p class="mt-1 text-sm text-amber-700">Your external service receives the payload and takes action.</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
