<% content_for :title, "Integrations | WAStays Admin" %>

<div class="w-full space-y-6">
  <%= render PanelsUI::PageHeader.new(
        title: "Integrations",
        description: "Configure external connections and global AI services for WAStays.") %>

  <div class="grid grid-cols-1 gap-6 xl:grid-cols-4 xl:items-start">
    <aside class="xl:sticky xl:top-6 xl:col-span-1">
      <%= render "how_it_works" %>
    </aside>

    <div class="xl:col-span-3">
      <%= render PanelsUI::Tabs.new(
            id: "integrations",
            active: @active_tab,
            variant: :line,
            url: { param: "tab" },
            aria_label: "Integration settings") do |tabs| %>
        <% Admin::IntegrationsController::TABS.each do |tab| %>
          <% tabs.with_tab(name: tab[:name], label: tab[:label], icon: tab[:icon]) %>
        <% end %>

        <% Admin::IntegrationsController::TABS.each do |tab| %>
          <% tabs.with_panel(name: tab[:name]) do %>
            <%= render tab[:name] %>
          <% end %>
        <% end %>
      <% end %>
    </div>
  </div>
</div>
