<% content_for :title, "Integrations | WAStays Admin" %>

<% content_for :breadcrumbs do %>
  <%= render "shared/navigation/admin_breadcrumbs", current: "Integrations" %>
<% end %>

<div class="mx-auto flex min-h-screen max-w-[1600px] flex-col space-y-6 pb-6">
  <div class="px-4 md:px-0">
    <div class="mt-5">
      <p class="text-xs font-black uppercase tracking-[0.22em] text-brand-primary">Platform Control</p>
      <h1 class="mt-2 text-2xl font-bold tracking-tight text-slate-950 sm:text-3xl">Integrations</h1>
      <p class="mt-1 text-sm font-medium text-slate-600">Configure external connections and global AI services for WAStays.</p>
    </div>
  </div>

  <div class="grid min-h-0 flex-1 grid-cols-1 gap-6 xl:grid-cols-3 xl:items-start">
    <aside class="xl:col-span-1 xl:sticky xl:top-6">
      <%= render "how_it_works" %>
    </aside>

    <div class="min-h-0 space-y-6 xl:col-span-2 xl:max-h-[calc(100vh-12rem)] xl:overflow-y-auto xl:pr-2">
      <%= render "channel_manager" %>
      <%= render "storage" %>
      <%= render "ai_providers" %>
    </div>
  </div>
</div>
