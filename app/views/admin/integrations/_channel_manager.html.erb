<%= render "panel_intro", title: "Channel manager", description: "Global connectivity to OTAs through Channex." %>

<%= form_with url: admin_integrations_path, method: :patch, class: "mt-6 space-y-6 md:max-w-2xl" do |form| %>
  <%= hidden_field_tag :tab, "channel_manager" %>

  <div class="grid grid-cols-1 gap-5 md:grid-cols-2">
    <%= render PanelsUI::FormField.new(
          form: form,
          attribute: :channex_environment,
          label: "Environment") do |field| %>
      <% field.with_select_menu(
           Admin::IntegrationsController::CHANNEX_ENVIRONMENTS,
           selected: @channex_environment) %>
    <% end %>

    <%= render "secret_field",
        form: form,
        name: :channex_api_key,
        label: "User API key",
        value: @channex_api_key,
        placeholder: "Enter the Channex user API key" %>
  </div>

  <%= render PanelsUI::Alert.new(tone: :info, title: "Webhook configuration") do |alert| %>
    <% alert.with_description do %>
      <p>Set this URL in Channex to receive bookings as they happen.</p>
      <code class="mt-2 block select-all overflow-x-auto rounded-md border border-border bg-card p-2 font-mono text-xs text-foreground"><%= root_url %>webhooks/channex</code>
    <% end %>
  <% end %>

  <div class="flex justify-end">
    <%= render PanelsUI::Button.new(label: "Save channel manager", type: "submit") %>
  </div>
<% end %>
