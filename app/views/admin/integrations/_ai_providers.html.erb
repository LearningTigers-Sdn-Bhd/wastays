<%= render "panel_intro", title: "AI providers", description: "Global keys used by Observation Deck and platform-level AI tools." %>

<%= form_with url: admin_integrations_path, method: :patch, class: "mt-6 space-y-6 md:max-w-2xl" do |form| %>
  <%= hidden_field_tag :tab, "ai_providers" %>

  <div class="grid grid-cols-1 gap-5 md:grid-cols-2">
    <% Admin::IntegrationsController::AI_PROVIDERS.each do |provider| %>
      <%= render "secret_field",
          form: form,
          name: provider[:key],
          label: "#{provider[:label]} API key",
          hint: provider[:key],
          value: @ai_provider_keys[provider[:key]],
          placeholder: "Enter the #{provider[:label]} API key" %>
    <% end %>
  </div>

  <div class="flex justify-end">
    <%= render PanelsUI::Button.new(label: "Save AI providers", type: "submit") %>
  </div>
<% end %>
