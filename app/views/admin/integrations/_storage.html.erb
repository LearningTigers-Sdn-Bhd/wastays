<%= render "panel_intro", title: "Storage", description: "S3-compatible Cloudflare R2 storage for uploads and public file links." %>

<%= form_with url: admin_integrations_path, method: :patch,
      class: "mt-6 space-y-6 md:max-w-2xl",
      data: {
        controller: "connection-test",
        connection_test_url_value: test_r2_connection_admin_integrations_path
      } do |form| %>
  <%= hidden_field_tag :tab, "storage" %>

  <div class="grid grid-cols-1 gap-5 md:grid-cols-2">
    <%= render "secret_field",
        form: form,
        name: :r2_access_key_id,
        label: "Access key ID",
        value: @r2_access_key_id,
        placeholder: "Enter the R2 access key ID" %>

    <%= render "secret_field",
        form: form,
        name: :r2_secret_access_key,
        label: "Secret access key",
        value: @r2_secret_access_key,
        placeholder: "Enter the R2 secret access key" %>

    <%= render PanelsUI::FormField.new(form: form, attribute: :r2_bucket, label: "Bucket name") do |field| %>
      <% field.with_input(value: @r2_bucket, placeholder: "wastays-production") %>
    <% end %>

    <%= render PanelsUI::FormField.new(form: form, attribute: :r2_region, label: "Region") do |field| %>
      <% field.with_input(value: @r2_region, placeholder: "auto") %>
    <% end %>

    <div class="md:col-span-2">
      <%= render PanelsUI::FormField.new(
            form: form,
            attribute: :r2_endpoint,
            label: "Endpoint URL",
            hint: "The account host, for example https://0123456789abcdef.r2.cloudflarestorage.com") do |field| %>
        <% field.with_input(type: :url, value: @r2_endpoint, placeholder: "https://<account-id>.r2.cloudflarestorage.com") %>
      <% end %>
    </div>

    <div class="md:col-span-2">
      <%= render PanelsUI::FormField.new(
            form: form,
            attribute: :r2_public_url,
            label: "Public URL or CDN",
            hint: "When set, file links use this base URL instead of signed S3 URLs.") do |field| %>
        <% field.with_input(type: :url, value: @r2_public_url, placeholder: "https://pub-xyz.r2.dev or your custom domain") %>
      <% end %>
    </div>
  </div>

  <%= render "connection_test_footer", save_label: "Save storage" %>
<% end %>
