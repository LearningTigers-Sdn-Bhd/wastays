<%= render PanelsUI::Card.new(as: :section, density: :compact) do |card| %>
  <% card.with_header(title: "How it works",
                      description: "Global integrations are stored as encrypted app config values.",
                      title_as: :h2) %>
  <% card.with_card_content do %>
    <ol class="mb-3 space-y-4">
      <% [
        [ "1", "Configure", "Save the credentials and endpoints once for the whole platform." ],
        [ "2", "Connect", "Services read the encrypted values from AppConfig at runtime." ],
        [ "3", "Verify", "Run the connection test, or use a focused tool such as Observation Deck." ]
      ].each do |number, title, body| %>
        <li class="flex items-start gap-3">
          <span class="w-4 shrink-0 text-sm font-semibold tabular-nums text-primary" aria-hidden="true"><%= number %></span>
          <div class="space-y-1">
            <p class="text-sm font-medium text-primary"><%= title %></p>
            <p class="text-sm text-muted-foreground"><%= body %></p>
          </div>
        </li>
      <% end %>
    </ol>
  <% end %>
  <%# The card's own footer slot carries the divider, so the rule runs the full
      width instead of stopping at the content padding. %>
  <% card.with_footer(align: :start) do %>
    <p class="text-sm text-muted-foreground">
      Outgoing webhooks live in
      <%= link_to "Webhooks management", admin_webhook_endpoints_path, class: "font-medium text-foreground underline underline-offset-4" %>.
    </p>
  <% end %>
<% end %>
