<%# The tab strip names the section too. The heading repeats it on purpose, so
    the panel reads as a titled region on its own. %>
<div class="space-y-1">
  <h2 class="text-base font-semibold tracking-tight text-foreground"><%= title %></h2>
  <p class="text-sm text-muted-foreground"><%= description %></p>
</div>
