<section class="overflow-hidden rounded-lg border border-slate-200 bg-white shadow-sm">
  <div class="border-b border-slate-200 bg-slate-50/80 px-5 py-4 sm:px-6">
    <div class="flex items-start gap-3">
      <% if local_assigns[:icon_name].present? %>
        <span class="inline-flex size-9 shrink-0 items-center justify-center rounded-lg bg-white text-brand-primary ring-1 ring-slate-200">
          <%= lucide_icon icon_name, stroke_width: 2.25, class: "size-4" %>
        </span>
      <% end %>
      <div>
        <h2 class="text-base font-bold tracking-tight text-slate-950"><%= title %></h2>
        <% if local_assigns[:description].present? %>
          <p class="mt-1 text-sm font-medium leading-6 text-slate-600"><%= description %></p>
        <% end %>
      </div>
    </div>
  </div>

  <div class="p-5 sm:p-6">
    <%= yield %>
  </div>
</section>
