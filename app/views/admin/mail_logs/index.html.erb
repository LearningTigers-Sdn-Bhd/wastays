<% input_class = "w-full rounded-xl border border-border bg-card px-3 py-2.5 text-sm font-medium text-foreground focus:border-border-interactive focus:outline-none focus:ring-0" %>
<% filtered = %i[status q start_date end_date].any? { |key| params[key].present? } %>
<div class="w-full space-y-8">
  <%= render PanelsUI::PageHeader.new(
        title: "Mail Log",
        description: "Review every email that the platform sent, and which emails failed.") %>

  <div class="grid gap-4 sm:grid-cols-2">
    <%= render PanelsUI::MetricCard.new(label: "Sent, last 24 hours", value: @status_counts.fetch("sent", 0)) %>
    <%= render PanelsUI::MetricCard.new(label: "Failed, last 24 hours", value: @status_counts.fetch("failed", 0)) %>
  </div>

  <div class="overflow-hidden rounded-2xl border border-border bg-card shadow-sm">
    <div class="border-b border-border bg-muted/70 px-6 py-4 sm:px-8">
      <%= form_with url: admin_mail_logs_path, method: :get, class: "grid w-full gap-4 md:grid-cols-2 xl:grid-cols-[repeat(4,minmax(0,1fr))_auto] xl:items-end" do |f| %>
        <div>
          <label for="q" class="mb-2 block text-sm font-medium text-muted-foreground">Recipient or subject</label>
          <%= f.search_field :q, value: params[:q], placeholder: "Search", class: input_class %>
        </div>
        <div>
          <label for="status" class="mb-2 block text-sm font-medium text-muted-foreground">Status</label>
          <%= render PanelsUI::SelectMenu.new(
                form: f, attribute: :status, include_blank: "All statuses", selected: params[:status],
                choices: MailEvent::STATUSES.map { |status| [ status.titleize, status ] }) %>
        </div>
        <div>
          <label for="start_date" class="mb-2 block text-sm font-medium text-muted-foreground">Start Date</label>
          <%= f.date_field :start_date, value: params[:start_date], class: input_class %>
        </div>
        <div>
          <label for="end_date" class="mb-2 block text-sm font-medium text-muted-foreground">End Date</label>
          <%= f.date_field :end_date, value: params[:end_date], class: input_class %>
        </div>
        <div class="flex items-center gap-3 xl:justify-end">
          <% if filtered %>
            <%= link_to "Clear", admin_mail_logs_path, class: "text-sm font-semibold text-muted-foreground hover:text-foreground" %>
          <% end %>
          <%= f.submit "Apply Filters", class: "inline-flex items-center justify-center rounded-xl bg-primary px-4 py-2.5 text-sm font-semibold text-primary-foreground transition hover:bg-primary-hover" %>
        </div>
      <% end %>
    </div>

    <div class="overflow-x-auto">
      <table class="min-w-full">
        <thead class="bg-muted">
          <tr>
            <% %w[Time Email Recipients Subject Status].each do |heading| %>
              <th scope="col" class="px-6 py-4 text-left text-[11px] font-semibold uppercase tracking-[0.1em] text-muted-foreground"><%= heading %></th>
            <% end %>
          </tr>
        </thead>
        <tbody class="divide-y divide-border bg-card">
          <% if @events.any? %>
            <% @events.each do |event| %>
              <tr class="transition-colors hover:bg-muted/80">
                <td class="whitespace-nowrap px-6 py-4 text-sm font-medium text-muted-foreground"><%= event.sent_at.strftime("%d %b %Y, %H:%M") %></td>
                <td class="whitespace-nowrap px-6 py-4 text-sm font-semibold text-foreground">
                  <%= event.mailer.delete_suffix("Mailer").titleize %>
                  <% if event.mail_action.present? %>
                    <span class="block text-xs font-medium text-muted-foreground"><%= event.mail_action.humanize %></span>
                  <% end %>
                </td>
                <td class="px-6 py-4 text-sm text-foreground"><%= event.recipients.presence || "-" %></td>
                <td class="px-6 py-4 text-sm text-foreground"><%= event.subject.presence || "-" %></td>
                <td class="px-6 py-4 text-sm">
                  <%= render PanelsUI::Badge.new(label: event.status.titleize, variant: event.status == "failed" ? :destructive : :success) %>
                  <% if event.error_message.present? %>
                    <p class="mt-1 max-w-xs text-xs text-muted-foreground"><%= event.error_message.truncate(120) %></p>
                  <% end %>
                </td>
              </tr>
            <% end %>
          <% else %>
            <tr>
              <td colspan="5" class="px-6 py-12 text-center">
                <p class="text-sm font-semibold text-foreground">No emails found.</p>
                <p class="mt-2 text-sm text-muted-foreground">Change the filters to see more emails.</p>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>

    <div class="flex justify-center border-t border-border bg-muted/50 px-6 py-5 sm:px-8">
      <%= render PanelsUI::Pagination.new(pagy: @pagy, hide_when_single_page: true) %>
    </div>
  </div>
</div>
