<div class="w-full space-y-8">
  <%= render PanelsUI::PageHeader.new(
        title: "Revenue & Margin Analytics",
        description: "Detailed superadmin analytics across all revenue-generating bookings.") %>

  <%= turbo_frame_tag "analytics_content" do %>
    <div class="grid grid-cols-1 overflow-hidden rounded-2xl border border-border bg-card shadow-sm sm:grid-cols-2 xl:grid-cols-5 mb-8">
      <div class="p-6 md:border-r md:border-border md:p-8">
        <p class="mb-2 text-[11px] font-semibold uppercase tracking-[0.08em] text-muted-foreground">Revenue</p>
        <h2 class="text-3xl font-bold tabular-nums tracking-tight text-foreground"><%= number_to_currency(@total_revenue, unit: "RM ", precision: 2) %></h2>
        <p class="mt-2 text-sm font-medium text-muted-foreground">Gross booking value in range</p>
      </div>
      <div class="bg-muted/30 p-6 md:border-r md:border-border md:p-8">
        <p class="mb-2 text-[11px] font-semibold uppercase tracking-[0.08em] text-muted-foreground">Margin</p>
        <h2 class="text-3xl font-bold tabular-nums tracking-tight text-emerald-600"><%= number_to_currency(@total_margin, unit: "RM ", precision: 2) %></h2>
        <p class="mt-2 text-sm font-medium text-muted-foreground">Platform margin captured</p>
      </div>
      <div class="p-6 md:border-r md:border-border md:p-8">
        <p class="mb-2 text-[11px] font-semibold uppercase tracking-[0.08em] text-muted-foreground">Net</p>
        <h2 class="text-3xl font-bold tabular-nums tracking-tight text-blue-600"><%= number_to_currency(@total_net, unit: "RM ", precision: 2) %></h2>
        <p class="mt-2 text-sm font-medium text-muted-foreground">Net earnings across bookings</p>
      </div>
      <div class="bg-muted/30 p-6 md:border-r md:border-border md:p-8">
        <p class="mb-2 text-[11px] font-semibold uppercase tracking-[0.08em] text-muted-foreground">Bookings</p>
        <h2 class="text-3xl font-bold tabular-nums tracking-tight text-foreground"><%= @booking_count %></h2>
        <p class="mt-2 text-sm font-medium text-muted-foreground">Revenue-generating bookings</p>
      </div>
      <div class="p-6 md:p-8">
        <p class="mb-2 text-[11px] font-semibold uppercase tracking-[0.08em] text-muted-foreground">Active Hotels</p>
        <h2 class="text-3xl font-bold tabular-nums tracking-tight text-violet-600"><%= @active_hotels_count %></h2>
        <p class="mt-2 text-sm font-medium text-muted-foreground">Hotels contributing data</p>
      </div>
    </div>

    <div class="overflow-hidden rounded-2xl border border-border bg-card shadow-sm">
      <div class="border-b border-border px-6 py-5 sm:px-8">
        <div id="admin-analytics-filters-toolbar" class="flex flex-col gap-4 xl:flex-row xl:items-end xl:justify-between">
          <div class="max-w-xl">
            <h2 class="text-lg font-bold tracking-tight text-foreground sm:text-xl">Daily Breakdown</h2>
            <p class="mt-1 text-sm font-medium text-muted-foreground">Daily revenue, margin, net earnings, and booking volume.</p>
          </div>

          <div id="admin-analytics-filters" class="w-full xl:w-auto">
            <%= form_with url: admin_analytics_path, method: :get, class: "flex flex-col gap-3 sm:flex-row sm:flex-wrap sm:items-end xl:flex-nowrap", data: { controller: "auto-submit", turbo_frame: "analytics_content" } do |f| %>
              <div class="w-full sm:w-[150px]">
                <label class="mb-2 block text-xs font-semibold uppercase tracking-[0.08em] text-muted-foreground">Time Period</label>
                <%= f.select :date_preset, options_for_select(date_preset_options, @date_preset), {}, class: "w-full rounded-xl border border-border bg-card px-3 py-2.5 text-sm font-medium text-foreground focus:border-border-interactive focus:outline-none focus:ring-0", data: { action: "change->auto-submit#submitNow" } %>
              </div>

              <div id="custom-date-range" class="<%= @date_preset == 'custom' ? 'flex' : 'hidden' %> flex-col gap-3 sm:flex-row">
                <div class="w-full sm:w-[150px]">
                  <label class="mb-2 block text-xs font-semibold uppercase tracking-[0.08em] text-muted-foreground">From</label>
                  <%= f.date_field :start_date, value: @start_date, class: "w-full rounded-xl border border-border bg-card px-3 py-2.5 text-sm font-medium text-foreground focus:border-border-interactive focus:outline-none focus:ring-0", data: { action: "change->auto-submit#submitNow" } %>
                </div>
                <div class="w-full sm:w-[150px]">
                  <label class="mb-2 block text-xs font-semibold uppercase tracking-[0.08em] text-muted-foreground">To</label>
                  <%= f.date_field :end_date, value: @end_date, class: "w-full rounded-xl border border-border bg-card px-3 py-2.5 text-sm font-medium text-foreground focus:border-border-interactive focus:outline-none focus:ring-0", data: { action: "change->auto-submit#submitNow" } %>
                </div>
              </div>

              <div class="w-full sm:w-[200px]">
                <label class="mb-2 block text-xs font-semibold uppercase tracking-[0.08em] text-muted-foreground">Search</label>
                <div class="relative">
                  <%= f.text_field :q, value: params[:q], placeholder: "Search hotels/guests...", class: "w-full rounded-xl border border-border bg-card px-3 py-2.5 text-sm font-medium text-foreground focus:border-border-interactive focus:outline-none focus:ring-0", data: { action: "input->auto-submit#submit" } %>
                </div>
              </div>
            <% end %>
          </div>
        </div>
      </div>

      <div id="admin-analytics-mobile-list" class="space-y-4 p-4 sm:p-6 xl:hidden">
        <% if @daily_rows.any? %>
          <% @daily_rows.each do |row| %>
            <div class="rounded-2xl border border-border bg-muted/60 p-4 shadow-sm">
              <div class="flex items-start justify-between gap-3">
                <div>
                  <p class="text-xs font-semibold uppercase tracking-[0.08em] text-muted-foreground">Date</p>
                  <p class="mt-1 text-sm font-semibold text-foreground"><%= row[:date].strftime("%d %b %Y") %></p>
                </div>
                <div class="text-right">
                  <p class="text-xs font-semibold uppercase tracking-[0.08em] text-muted-foreground">Bookings</p>
                  <p class="mt-1 text-sm font-semibold text-foreground"><%= row[:booking_count] %></p>
                </div>
              </div>

              <dl class="mt-4 grid grid-cols-1 gap-3 text-sm sm:grid-cols-3">
                <div>
                  <dt class="text-xs font-semibold uppercase tracking-[0.08em] text-muted-foreground">Revenue</dt>
                  <dd class="mt-1 text-foreground"><%= number_to_currency(row[:revenue], unit: "RM ", precision: 2) %></dd>
                </div>
                <div>
                  <dt class="text-xs font-semibold uppercase tracking-[0.08em] text-muted-foreground">Margin</dt>
                  <dd class="mt-1 text-emerald-700"><%= number_to_currency(row[:margin], unit: "RM ", precision: 2) %></dd>
                </div>
                <div>
                  <dt class="text-xs font-semibold uppercase tracking-[0.08em] text-muted-foreground">Net</dt>
                  <dd class="mt-1 font-medium text-blue-700"><%= number_to_currency(row[:net], unit: "RM ", precision: 2) %></dd>
                </div>
              </dl>
            </div>
          <% end %>
        <% else %>
          <div class="rounded-2xl border border-dashed border-border bg-muted/60 px-4 py-8 text-center">
            <p class="text-sm font-semibold text-foreground">No analytics data found.</p>
            <p class="mt-2 text-sm text-muted-foreground">Try adjusting the selected date range.</p>
          </div>
        <% end %>
      </div>

      <div class="hidden xl:block overflow-x-auto">
        <table class="min-w-full">
          <thead class="bg-muted">
            <tr>
              <th class="px-6 py-4 text-left text-[11px] font-semibold uppercase tracking-[0.1em] text-muted-foreground sm:px-8">Date</th>
              <th class="px-6 py-4 text-left text-[11px] font-semibold uppercase tracking-[0.1em] text-muted-foreground">Bookings</th>
              <th class="px-6 py-4 text-left text-[11px] font-semibold uppercase tracking-[0.1em] text-muted-foreground">Revenue</th>
              <th class="px-6 py-4 text-left text-[11px] font-semibold uppercase tracking-[0.1em] text-muted-foreground">Margin</th>
              <th class="px-6 py-4 text-left text-[11px] font-semibold uppercase tracking-[0.1em] text-muted-foreground sm:px-8">Net</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-border bg-card">
            <% if @daily_rows.any? %>
              <% @daily_rows.each_with_index do |row, index| %>
                <tr class="transition-colors hover:bg-muted/80 <%= index.even? ? 'bg-card' : 'bg-muted/55' %>">
                  <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-foreground sm:px-8"><%= row[:date].strftime("%d %b %Y") %></td>
                  <td class="px-6 py-4 whitespace-nowrap text-sm text-muted-foreground"><%= row[:booking_count] %></td>
                  <td class="px-6 py-4 whitespace-nowrap text-sm text-foreground"><%= number_to_currency(row[:revenue], unit: "RM ", precision: 2) %></td>
                  <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-emerald-700"><%= number_to_currency(row[:margin], unit: "RM ", precision: 2) %></td>
                  <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-blue-700 sm:px-8"><%= number_to_currency(row[:net], unit: "RM ", precision: 2) %></td>
                </tr>
              <% end %>
            <% else %>
              <tr>
                <td colspan="5" class="px-6 py-12 text-center sm:px-8">
                  <div class="mx-auto max-w-sm space-y-2">
                    <p class="text-sm font-semibold text-foreground">No analytics data found.</p>
                    <p class="text-sm text-muted-foreground">Try adjusting the selected date range.</p>
                  </div>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>
  <% end %>
</div>

<script>
  document.querySelector('select[name="date_preset"]')?.addEventListener('change', function(e) {
    const customRange = document.getElementById('custom-date-range');
    if (!customRange) return;
    if (e.target.value === 'custom') {
      customRange.classList.remove('hidden');
      customRange.classList.add('flex');
    } else {
      customRange.classList.add('hidden');
      customRange.classList.remove('flex');
    }
  });
</script>
