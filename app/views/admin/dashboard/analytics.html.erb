<div class="max-w-[85rem] px-4 py-10 sm:px-6 lg:px-8 lg:py-14 mx-auto">
  <div class="flex flex-col md:flex-row justify-between items-center mb-8 gap-4">
    <div>
      <h1 class="text-3xl font-bold text-gray-800">Financial Analytics</h1>
      <p class="text-sm text-gray-600">Platform-wide revenue, margin, and net payout performance.</p>
    </div>
  </div>

  <%= turbo_frame_tag "analytics_content" do %>
    <!-- Filters & Search -->
    <div class="bg-white border border-gray-200 rounded-xl p-4 md:p-6 mb-8 shadow-sm">
      <%= form_with url: admin_analytics_path, method: :get, class: "space-y-4", data: { controller: "auto-submit", turbo_frame: "analytics_content" } do |f| %>
        <div class="grid grid-cols-1 md:grid-cols-12 gap-4 items-end">
          <div class="md:col-span-3">
            <label class="block text-xs font-bold text-gray-500 uppercase mb-1">Time Period</label>
            <%= f.select :date_preset, options_for_select(date_preset_options, @date_preset), {}, class: "form-select py-2 px-3 text-sm", data: { action: "change->auto-submit#submitNow" } %>
          </div>

          <div id="custom-date-range" class="<%= @date_preset == 'custom' ? 'grid' : 'hidden' %> md:col-span-4 grid-cols-2 gap-2">
            <div>
              <label class="block text-[10px] font-bold text-gray-400 uppercase mb-1">From</label>
              <%= f.date_field :start_date, value: @start_date, class: "form-input py-2 px-2 text-xs", data: { action: "change->auto-submit#submitNow" } %>
            </div>
            <div>
              <label class="block text-[10px] font-bold text-gray-400 uppercase mb-1">To</label>
              <%= f.date_field :end_date, value: @end_date, class: "form-input py-2 px-2 text-xs", data: { action: "change->auto-submit#submitNow" } %>
            </div>
          </div>

          <div class="md:col-span-5">
            <label class="block text-xs font-bold text-gray-500 uppercase mb-1">Search Hotels/Guests</label>
            <div class="relative">
              <%= f.text_field :q, value: params[:q], placeholder: "Search as you type...", class: "form-input py-2 pl-9 pr-3 text-sm", data: { action: "input->auto-submit#submit" } %>
              <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                <svg class="size-4 text-gray-400" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
              </div>
            </div>
          </div>
        </div>
      <% end %>
    </div>

    <!-- Quick Stats -->
    <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-4 sm:gap-6 mb-8">
      <div class="flex flex-col bg-white border border-gray-200 rounded-xl shadow-sm">
        <div class="p-4 md:p-5">
          <p class="text-xs uppercase tracking-wide text-gray-500">Gross Revenue</p>
          <div class="mt-1 flex items-center gap-x-2">
            <h3 class="text-xl sm:text-2xl font-bold text-gray-800">MYR <%= number_with_precision(@total_revenue, precision: 2) %></h3>
          </div>
        </div>
      </div>

      <div class="flex flex-col bg-red-50 border border-red-200 rounded-xl shadow-sm">
        <div class="p-4 md:p-5">
          <p class="text-xs uppercase tracking-wide text-red-600 font-bold">Platform Margin</p>
          <div class="mt-1 flex items-center gap-x-2">
            <h3 class="text-xl sm:text-2xl font-bold text-red-800">MYR <%= number_with_precision(@total_margin, precision: 2) %></h3>
          </div>
        </div>
      </div>

      <div class="flex flex-col bg-green-50 border border-green-200 rounded-xl shadow-sm">
        <div class="p-4 md:p-5">
          <p class="text-xs uppercase tracking-wide text-green-600 font-bold">Net Payouts</p>
          <div class="mt-1 flex items-center gap-x-2">
            <h3 class="text-xl sm:text-2xl font-bold text-green-800">MYR <%= number_with_precision(@total_net, precision: 2) %></h3>
          </div>
        </div>
      </div>

      <div class="flex flex-col bg-white border border-gray-200 rounded-xl shadow-sm">
        <div class="p-4 md:p-5">
          <p class="text-xs uppercase tracking-wide text-gray-500">Activity</p>
          <div class="mt-1 flex items-center gap-x-2">
            <h3 class="text-xl sm:text-2xl font-medium text-gray-800"><%= @booking_count %> bookings</h3>
          </div>
          <p class="mt-1 text-xs text-gray-500">Across <%= @active_hotels_count %> hotels</p>
        </div>
      </div>
    </div>

    <div class="bg-white border border-gray-200 rounded-xl shadow-sm overflow-hidden">
      <div class="px-6 py-4 border-b border-gray-200 bg-gray-50">
        <h2 class="text-lg font-semibold text-gray-800">Daily Aggregates</h2>
      </div>
      <table class="min-w-full divide-y divide-gray-200">
        <thead class="bg-gray-50">
          <tr>
            <th class="px-6 py-3 text-start text-xs font-semibold uppercase text-gray-800">Date</th>
            <th class="px-6 py-3 text-center text-xs font-semibold uppercase text-gray-800">Bookings</th>
            <th class="px-6 py-3 text-end text-xs font-semibold uppercase text-gray-800">Gross Revenue</th>
            <th class="px-6 py-3 text-end text-xs font-semibold uppercase text-gray-800 text-red-600">Platform Margin</th>
            <th class="px-6 py-3 text-end text-xs font-semibold uppercase text-gray-800 text-green-600 font-bold">Net Payouts</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-gray-200">
          <% if @daily_rows.any? %>
            <% @daily_rows.each do |row| %>
              <tr>
                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-800 font-medium"><%= row[:date].strftime("%d %b %Y") %></td>
                <td class="px-6 py-4 whitespace-nowrap text-sm text-center text-gray-800"><%= row[:booking_count] %></td>
                <td class="px-6 py-4 whitespace-nowrap text-sm text-end text-gray-800">MYR <%= number_with_precision(row[:revenue], precision: 2) %></td>
                <td class="px-6 py-4 whitespace-nowrap text-sm text-end text-red-500">- <%= number_with_precision(row[:margin], precision: 2) %></td>
                <td class="px-6 py-4 whitespace-nowrap text-sm text-end font-bold text-gray-900">MYR <%= number_with_precision(row[:net], precision: 2) %></td>
              </tr>
            <% end %>
          <% else %>
            <tr>
              <td colspan="5" class="px-6 py-10 text-center text-sm text-gray-500 italic">No data found for this period.</td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% end %>
</div>

<script>
  document.querySelector('select[name="date_preset"]')?.addEventListener('change', function(e) {
    const customRange = document.getElementById('custom-date-range');
    if (!customRange) return;
    if (e.target.value === 'custom') {
      customRange.classList.remove('hidden');
      customRange.classList.add('grid');
    } else {
      customRange.classList.add('hidden');
      customRange.classList.remove('grid');
    }
  });
</script>
