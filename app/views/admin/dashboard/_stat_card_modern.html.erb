<div class="group relative flex flex-col bg-card border border-border/60 shadow-sm hover:shadow-md rounded-2xl p-5 transition-all duration-300 overflow-hidden">
  <%# Subtle background glow %>
  <div class="absolute -right-4 -top-4 w-24 h-24 bg-<%= color %>-50/50 rounded-full blur-3xl group-hover:bg-<%= color %>-100/50 transition-colors"></div>

  <div class="relative flex items-start justify-between">
    <div class="inline-flex justify-center items-center w-12 h-12 rounded-xl bg-<%= color %>-50 text-<%= color %>-600 ring-4 ring-<%= color %>-50/30">
      <%= icon %>
    </div>

    <% if local_assigns[:trend].present? %>
      <span class="inline-flex items-center py-1 px-2 rounded-lg bg-green-50 text-[10px] font-bold text-green-700 uppercase tracking-tight">
        <svg class="w-3 h-3 mr-0.5" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="m5 12 7-7 7 7"/><path d="M12 19V5"/></svg>
        <%= trend %>
      </span>
    <% end %>
  </div>

  <div class="relative mt-5">
    <p class="text-[11px] uppercase tracking-[0.05em] text-muted-foreground font-bold opacity-70">
      <%= label %>
    </p>
    <div class="mt-1.5 flex items-baseline gap-x-2">
      <h3 class="text-2xl font-black text-foreground tracking-tight">
        <%= value %>
      </h3>
    </div>
  </div>

  <%# Bottom accent line %>
  <div class="absolute bottom-0 left-0 right-0 h-1 bg-<%= color %>-500/10 group-hover:h-1.5 group-hover:bg-<%= color %>-500/20 transition-all"></div>
</div>
