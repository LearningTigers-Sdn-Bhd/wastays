<% content_for :title, "Dashboard | WAStays Admin" %>

<% content_for :breadcrumbs do %>
  <nav class="flex items-center whitespace-nowrap min-w-0" aria-label="Breadcrumb">
    <ol class="flex items-center">
      <li class="flex items-center text-sm text-neutral-text-secondary">
        Superadmin
        <span class="mx-2 text-muted-foreground-2">/</span>
      </li>
      <li class="text-sm font-bold text-neutral-text-primary truncate" aria-current="page">
        Dashboard
      </li>
    </ol>
  </nav>
<% end %>

<div class="space-y-6">
  <div class="flex justify-between items-center">
    <div>
      <h2 class="text-xl font-bold text-neutral-text-primary tracking-tight">Operational Control Center</h2>
      <p class="text-xs text-neutral-text-secondary mt-0.5 opacity-80">Platform status and overview</p>
    </div>
  </div>

  <% if @failed_webhooks_count > 0 || @pending_hotels_count > 0 %>
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
      <% if @failed_webhooks_count > 0 %>
        <div class="bg-red-50 border border-red-200 rounded-lg p-4 flex items-center justify-between">
          <div class="flex items-center gap-x-3">
            <span class="flex-shrink-0 inline-flex justify-center items-center w-8 h-8 rounded-full bg-red-100 text-status-error">
              <svg class="w-4 h-4" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3Z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
            </span>
            <div>
              <p class="text-sm font-semibold text-status-error"><%= @failed_webhooks_count %> Webhook Failures</p>
              <p class="text-xs text-red-700">Payment processing errors detected</p>
            </div>
          </div>
          <a class="text-sm font-medium text-status-error hover:underline" href="<%= admin_reconciliations_path %>">Review now</a>
        </div>
      <% end %>

      <% if @pending_hotels_count > 0 %>
        <div class="bg-amber-50 border border-amber-200 rounded-lg p-4 flex items-center justify-between">
          <div class="flex items-center gap-x-3">
            <span class="flex-shrink-0 inline-flex justify-center items-center w-8 h-8 rounded-full bg-amber-100 text-status-warning">
              <svg class="w-4 h-4" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
            </span>
            <div>
              <p class="text-sm font-semibold text-status-warning"><%= @pending_hotels_count %> Hotels Pending Review</p>
              <p class="text-xs text-amber-700">Waiting for platform approval</p>
            </div>
          </div>
          <a class="text-sm font-medium text-status-warning hover:underline" href="<%= admin_hotels_path %>">Review now</a>
        </div>
      <% end %>
    </div>
  <% end %>

  <% revenue_margin_body = capture do %>
    <div class="grid grid-cols-2 gap-3">
      <div class="p-3 bg-neutral-bg rounded-2xl">
        <p class="text-[10px] uppercase text-neutral-text-secondary tracking-wider">Revenue</p>
        <p class="text-xl font-bold text-neutral-text-primary mt-1">RM <%= number_with_precision(@revenue_this_month, precision: 2) %></p>
      </div>
      <div class="p-3 bg-neutral-bg rounded-2xl">
        <p class="text-[10px] uppercase text-neutral-text-secondary tracking-wider">Margin</p>
        <p class="text-xl font-bold text-neutral-text-primary mt-1">RM <%= number_with_precision(@margin_this_month, precision: 2) %></p>
      </div>
    </div>
  <% end %>

  <% bookings_hotels_body = capture do %>
    <div class="grid grid-cols-2 gap-3">
      <div class="p-3 bg-neutral-bg rounded-2xl">
        <p class="text-[10px] uppercase text-neutral-text-secondary tracking-wider">Confirmed Bookings</p>
        <p class="text-xl font-bold text-neutral-text-primary mt-1"><%= @total_bookings_count %></p>
      </div>
      <div class="p-3 bg-neutral-bg rounded-2xl">
        <p class="text-[10px] uppercase text-neutral-text-secondary tracking-wider">Active Hotels</p>
        <p class="text-xl font-bold text-neutral-text-primary mt-1"><%= @hotels_count %></p>
      </div>
    </div>
  <% end %>

  <div class="grid sm:grid-cols-2 gap-4 sm:gap-6">
    <%= render "shared/dashboard/stat_card",
      label: "Revenue & Margin (MTD)",
      action: link_to("View analytics", admin_analytics_path, class: "text-sm font-medium text-brand-primary hover:underline"),
      body: revenue_margin_body %>

    <%= render "shared/dashboard/stat_card",
      label: "Bookings & Hotels",
      body: bookings_hotels_body %>
  </div>

  <% pending_hotels_body = capture do %>
    <% if @pending_hotels.any? %>
      <table class="table-container">
        <thead class="table-header">
          <tr>
            <th class="px-3 py-2">Hotel</th>
            <th class="px-3 py-2">Account</th>
            <th class="px-3 py-2">Applied</th>
            <th class="px-3 py-2"></th>
          </tr>
        </thead>
        <tbody class="divide-y divide-neutral-border">
          <% @pending_hotels.each do |hotel| %>
            <tr>
              <td class="px-3 py-3 text-sm font-medium text-neutral-text-primary"><%= hotel.name %></td>
              <td class="px-3 py-3 text-sm text-neutral-text-secondary"><%= hotel.account.name %></td>
              <td class="px-3 py-3 text-sm text-neutral-text-secondary"><%= hotel.created_at.strftime("%b %d") %></td>
              <td class="px-3 py-3 text-right">
                <%= link_to "Review", admin_hotel_path(hotel), class: "text-brand-primary hover:text-red-700 font-medium" %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    <% else %>
      <%= render "shared/dashboard/empty_state", message: "No hotels currently pending review." %>
    <% end %>
  <% end %>

  <% failed_webhooks_body = capture do %>
    <% if @failed_webhooks.any? %>
      <table class="table-container">
        <thead class="table-header">
          <tr>
            <th class="px-3 py-2">Gateway</th>
            <th class="px-3 py-2">ID</th>
            <th class="px-3 py-2">Time</th>
            <th class="px-3 py-2"></th>
          </tr>
        </thead>
        <tbody class="divide-y divide-neutral-border">
          <% @failed_webhooks.each do |event| %>
            <tr>
              <td class="px-3 py-3 text-sm font-medium text-neutral-text-primary"><%= event.gateway.capitalize %></td>
              <td class="px-3 py-3 text-sm text-neutral-text-secondary"><%= event.external_id.to_s.truncate(12) %></td>
              <td class="px-3 py-3 text-sm text-neutral-text-secondary"><%= time_ago_in_words(event.created_at) %> ago</td>
              <td class="px-3 py-3 text-right">
                <%= link_to "Retry", retry_admin_reconciliation_path(event), data: { turbo_method: :post }, class: "text-brand-primary hover:text-red-700 font-medium" %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    <% else %>
      <%= render "shared/dashboard/empty_state", message: "System is healthy. No failed webhooks." %>
    <% end %>
  <% end %>

  <% recent_bookings_body = capture do %>
    <% if @recent_bookings.any? %>
      <table class="table-container">
        <thead class="table-header">
          <tr>
            <th class="px-3 py-2">Ref</th>
            <th class="px-3 py-2">Guest</th>
            <th class="px-3 py-2">Hotel</th>
            <th class="px-3 py-2">Stay Dates</th>
            <th class="px-3 py-2 text-right">Amount</th>
            <th class="px-3 py-2"></th>
          </tr>
        </thead>
        <tbody class="divide-y divide-neutral-border">
          <% @recent_bookings.each do |booking| %>
            <tr>
              <td class="px-3 py-3 text-sm font-semibold text-neutral-text-primary">#<%= booking.confirmation_token %></td>
              <td class="px-3 py-3 text-sm text-neutral-text-primary"><%= booking.guest_name %></td>
              <td class="px-3 py-3 text-sm text-neutral-text-secondary"><%= booking.hotel.name %></td>
              <td class="px-3 py-3 text-sm text-neutral-text-secondary">
                <%= booking.check_in.strftime("%b %d") %> - <%= booking.check_out.strftime("%b %d") %>
              </td>
              <td class="px-3 py-3 text-sm font-medium text-neutral-text-primary text-right">RM <%= number_with_precision(booking.total_amount, precision: 2) %></td>
              <td class="px-3 py-3 text-right">
                <%= link_to "View", admin_booking_path(booking), class: "text-brand-primary hover:text-red-700 font-medium" %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    <% else %>
      <%= render "shared/dashboard/empty_state", message: "No confirmed bookings yet." %>
    <% end %>
  <% end %>

  <div class="grid lg:grid-cols-2 gap-6">
    <%= render "shared/dashboard/panel",
      title: "Hotels Pending Review",
      action: link_to("View all", admin_hotels_path, class: "text-sm font-medium text-brand-primary hover:underline"),
      body_classes: "overflow-x-auto",
      body: pending_hotels_body %>

    <%= render "shared/dashboard/panel",
      title: "Failed Webhooks",
      action: link_to("Reconcile", admin_reconciliations_path, class: "text-sm font-medium text-brand-primary hover:underline"),
      body_classes: "overflow-x-auto",
      body: failed_webhooks_body %>
<%= render "shared/dashboard/panel",
  title: "Recent Confirmed Bookings",
  action: link_to("View all", admin_bookings_path, class: "text-sm font-medium text-brand-primary hover:underline"),
  panel_classes: "flex flex-col h-full lg:col-span-2",
  body_classes: "overflow-x-auto",
  body: recent_bookings_body %>
</div>
</div>
