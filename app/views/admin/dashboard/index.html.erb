<div class="max-w-[85rem] mx-auto py-10 px-4 sm:px-6 lg:px-8">
  <div class="text-center">
    <h1 class="text-3xl font-bold text-gray-800">Superadmin Dashboard</h1>
    <p class="mt-2 text-sm text-gray-600">Platform Control Plane</p>
  </div>

  <div class="mt-10 grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
    <!-- Manage Accounts -->
    <div class="bg-white border border-gray-200 rounded-xl p-6 shadow-sm">
      <h3 class="text-lg font-semibold text-gray-800 mb-2">Accounts</h3>
      <p class="text-gray-600 mb-4">Manage hotel accounts and approvals.</p>
      <%= link_to "View all accounts", admin_hotels_path, class: "text-blue-600 font-medium hover:underline" %>
    </div>

    <!-- Payouts & Margin -->
    <div class="bg-white border border-gray-200 rounded-xl p-6 shadow-sm">
      <h3 class="text-lg font-semibold text-gray-800 mb-2">Payouts & Margin</h3>
      <p class="text-gray-600 mb-4">Set margin rules and reconciliation.</p>
      <%= link_to "Margin settings", admin_margin_rules_path, class: "text-blue-600 font-medium hover:underline" %>
    </div>

    <!-- System Logs -->
    <div class="bg-white border border-gray-200 rounded-xl p-6 shadow-sm">
      <h3 class="text-lg font-semibold text-gray-800 mb-2">System Audit</h3>
      <p class="text-gray-600 mb-4">Review platform-wide activity logs.</p>
      <%= link_to "Audit logs", admin_audit_logs_path, class: "text-blue-600 font-medium hover:underline" %>
    </div>
    <!-- Reconciliation -->
    <div class="bg-white border border-gray-200 rounded-xl p-6 shadow-sm">
      <h3 class="text-lg font-semibold text-gray-800 mb-2">Reconciliation</h3>
      <p class="text-gray-600 mb-4">Monitor payment webhooks and retry failures.</p>
      <%= link_to "View reconciliation", admin_reconciliations_path, class: "text-blue-600 font-medium hover:underline block mb-1" %>
      <%= link_to "Platform Guides", help_center_path, class: "text-purple-600 font-medium hover:underline" %>
    </div>
  </div>
</div>
