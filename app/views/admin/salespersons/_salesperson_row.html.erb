<% form_id = "salesperson-form-#{salesperson.id}" %>
<% assigned_hotels = salesperson.assigned_hotels %>
<% query = local_assigns[:query].presence || @query.presence %>
<tr id="<%= dom_id(salesperson, :row) %>" data-controller="salesperson-inline-edit" data-salesperson-inline-edit-start-editing-value="<%= local_assigns.fetch(:editing, false) %>" class="transition-colors hover:bg-muted/80 <%= local_assigns.fetch(:index, 0).even? ? 'bg-card' : 'bg-muted/55' %>">
  <td class="px-6 py-4 align-top sm:px-8">
    <div data-salesperson-inline-edit-target="nameDisplay" class="text-sm font-medium text-foreground">
      <%= salesperson.name.split.map(&:capitalize).join(' ') %>
    </div>
    <%= text_field_tag "user[name]", salesperson.name, form: form_id, disabled: true, data: { salesperson_inline_edit_target: "nameInput" }, class: "hidden w-full rounded-xl border border-border bg-muted px-4 py-2.5 text-sm text-muted-foreground shadow-sm focus:border-border-interactive focus:outline-none focus:ring-0 cursor-not-allowed" %>
  </td>
  <td class="px-6 py-4 align-top">
    <div data-salesperson-inline-edit-target="emailDisplay" class="text-sm text-muted-foreground">
      <%= salesperson.email %>
    </div>
    <%= email_field_tag "user[email]", salesperson.email, form: form_id, disabled: true, data: { salesperson_inline_edit_target: "emailInput" }, class: "hidden w-full rounded-xl border border-border bg-muted px-4 py-2.5 text-sm text-muted-foreground shadow-sm focus:border-border-interactive focus:outline-none focus:ring-0 cursor-not-allowed" %>
  </td>
  <td class="px-6 py-4 align-top">
    <div data-salesperson-inline-edit-target="hotelDisplay" class="flex flex-col gap-2 text-xs text-muted-foreground">
      <% if assigned_hotels.any? %>
        <% assigned_hotels.sort_by(&:name).each do |hotel| %>
          <span class="rounded-xl bg-muted px-3 py-2 font-medium text-foreground"><%= hotel.name %></span>
        <% end %>
      <% else %>
        <span>No hotels assigned</span>
      <% end %>
    </div>
    <%= render "hotel_dropdown", hotels: @hotels, selected_hotel_ids: assigned_hotels.map(&:id), field_name: "hotel_ids", form_id: form_id, hidden: true %>
  </td>
  <td class="px-6 py-4 align-top text-right">
    <div data-salesperson-inline-edit-target="readonlyActions" class="flex items-center justify-end gap-3">
      <%= button_tag "Edit", type: "button", data: { action: "click->salesperson-inline-edit#primaryAction", salesperson_inline_edit_target: "primaryButton" }, class: "inline-flex items-center justify-center rounded-xl bg-primary px-4 py-2.5 text-sm font-semibold text-primary-foreground transition hover:bg-primary-hover" %>
      <%= link_to admin_salesperson_path(salesperson), data: { turbo_method: :delete, turbo_confirm: "Delete this salesperson?" }, class: "inline-flex items-center justify-center rounded-xl border border-rose-200 bg-rose-50 px-4 py-2.5 text-sm font-semibold text-rose-700 transition hover:bg-rose-100" do %>
        Delete
      <% end %>
    </div>
    <div data-salesperson-inline-edit-target="editActions" class="hidden flex items-center justify-end gap-3">
      <%= button_tag "Save", type: "button", data: { action: "click->salesperson-inline-edit#primaryAction", salesperson_inline_edit_target: "primaryButton" }, class: "inline-flex items-center justify-center rounded-xl bg-primary px-4 py-2.5 text-sm font-semibold text-primary-foreground transition hover:bg-primary-hover" %>
      <%= button_tag "Cancel", type: "button", data: { action: "click->salesperson-inline-edit#cancel" }, class: "inline-flex items-center justify-center rounded-xl border border-border bg-card px-4 py-2.5 text-sm font-semibold text-foreground transition hover:bg-muted" %>
    </div>

    <%= form_tag admin_salesperson_path(salesperson), method: :patch, id: form_id, class: "hidden", data: { salesperson_inline_edit_target: "form", turbo_stream: true } do %>
      <%= hidden_field_tag :authenticity_token, form_authenticity_token %>
      <%= hidden_field_tag :query, query if query.present? %>
    <% end %>
  </td>
</tr>
