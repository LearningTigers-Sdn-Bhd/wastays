<% content_for :breadcrumbs do %>
  <%= render "shared/navigation/admin_breadcrumbs", current: "Salespersons" %>
<% end %>

<div class="mx-auto max-w-[1600px] space-y-8 pb-20">
  <div class="px-4 md:px-0">
    <div class="mt-5 flex flex-col gap-4 lg:flex-row lg:items-end lg:justify-between">
      <div>
        <h1 class="text-2xl font-bold tracking-tight text-slate-950 sm:text-3xl">Salespersons</h1>
        <p class="mt-1 text-sm font-medium text-slate-600">Salesperson management for hotels.</p>
      </div>
    </div>
  </div>

  <div class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">
    <div class="border-b border-slate-200 px-6 py-5 sm:px-8">
      <h2 class="text-lg font-bold tracking-tight text-slate-950 sm:text-xl">Add Salesperson</h2>
      <p class="mt-1 text-sm font-medium text-slate-600">Create a new salesperson user for the hotels.</p>

      <%= form_with model: [:admin, @new_salesperson], url: admin_salespersons_path, class: "mt-5 grid gap-4 lg:grid-cols-[minmax(0,1fr)_minmax(0,1.4fr)_auto]" do |f| %>
        <div>
          <%= f.label :name, "Name", class: "mb-2 block text-sm font-semibold text-slate-700" %>
          <%= f.text_field :name, class: "block w-full rounded-xl border border-slate-200 bg-white px-4 py-3 text-sm text-slate-700 shadow-sm focus:border-slate-300 focus:outline-none focus:ring-0", placeholder: "Full name" %>
        </div>

        <div>
          <label class="mb-2 block text-sm font-semibold text-slate-700">Hotels</label>
          <%= render "hotel_dropdown", hotels: @hotels, selected_hotel_ids: @selected_hotel_ids, field_name: "hotel_ids" %>
        </div>

        <div class="flex items-end">
          <%= f.submit "Add Salesperson", class: "inline-flex w-full items-center justify-center rounded-xl bg-red-600 px-4 py-3 text-sm font-semibold text-white transition hover:bg-red-700" %>
        </div>
      <% end %>
    </div>

    <div class="overflow-x-auto">
      <table class="min-w-full">
        <thead class="bg-slate-100">
          <tr>
            <th class="px-6 py-4 text-left text-[11px] font-semibold uppercase tracking-[0.1em] text-slate-600 sm:px-8">Salesperson</th>
            <th class="px-6 py-4 text-left text-[11px] font-semibold uppercase tracking-[0.1em] text-slate-600">Hotels</th>
            <th class="px-6 py-4 text-right text-[11px] font-semibold uppercase tracking-[0.1em] text-slate-600">Actions</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-200 bg-white">
          <% if @salespersons.any? %>
            <% @salespersons.each_with_index do |salesperson, index| %>
              <% form_id = "salesperson-form-#{salesperson.id}" %>
              <% assigned_hotels = salesperson.assigned_hotels %>
              <tr data-controller="salesperson-inline-edit" data-salesperson-inline-edit-start-editing-value="<%= @editing_salesperson_id == salesperson.id %>" class="transition-colors hover:bg-slate-100/80 <%= index.even? ? 'bg-white' : 'bg-slate-50/55' %>">
                <td class="px-6 py-4 align-top sm:px-8">
                  <div data-salesperson-inline-edit-target="nameDisplay" class="text-sm font-medium text-slate-700">
                    <%= salesperson.name %>
                  </div>
                  <%= text_field_tag "user[name]", salesperson.name, form: form_id, disabled: true, data: { salesperson_inline_edit_target: "nameInput" }, class: "hidden w-full rounded-xl border border-slate-200 bg-slate-50 px-4 py-2.5 text-sm text-slate-500 shadow-sm focus:border-slate-300 focus:outline-none focus:ring-0 cursor-not-allowed" %>
                </td>
                <td class="px-6 py-4 align-top">
                  <div data-salesperson-inline-edit-target="hotelDisplay" class="flex flex-col gap-2 text-xs text-slate-500">
                    <% if assigned_hotels.any? %>
                      <% assigned_hotels.sort_by(&:name).each do |hotel| %>
                        <span class="rounded-xl bg-slate-100 px-3 py-2 font-medium text-slate-700"><%= hotel.name %></span>
                      <% end %>
                    <% else %>
                      <span>No hotels assigned</span>
                    <% end %>
                  </div>
                  <%= render "hotel_dropdown", hotels: @hotels, selected_hotel_ids: assigned_hotels.map(&:id), field_name: "hotel_ids", form_id: form_id %>
                </td>
                <td class="px-6 py-4 align-top text-right">
                  <div data-salesperson-inline-edit-target="readonlyActions" class="flex items-center justify-end gap-3">
                    <%= button_tag "Edit", type: "button", data: { action: "click->salesperson-inline-edit#primaryAction", salesperson_inline_edit_target: "primaryButton" }, class: "inline-flex items-center justify-center rounded-xl bg-slate-900 px-4 py-2.5 text-sm font-semibold text-white transition hover:bg-slate-800" %>
                    <%= link_to admin_salesperson_path(salesperson), data: { turbo_method: :delete, turbo_confirm: "Delete this salesperson?" }, class: "inline-flex items-center justify-center rounded-xl border border-rose-200 bg-rose-50 px-4 py-2.5 text-sm font-semibold text-rose-700 transition hover:bg-rose-100" do %>
                      Delete
                    <% end %>
                  </div>
                  <div data-salesperson-inline-edit-target="editActions" class="hidden flex items-center justify-end gap-3">
                    <%= button_tag "Save", type: "button", data: { action: "click->salesperson-inline-edit#primaryAction", salesperson_inline_edit_target: "primaryButton" }, class: "inline-flex items-center justify-center rounded-xl bg-slate-900 px-4 py-2.5 text-sm font-semibold text-white transition hover:bg-slate-800" %>
                    <%= button_tag "Cancel", type: "button", data: { action: "click->salesperson-inline-edit#cancel" }, class: "inline-flex items-center justify-center rounded-xl border border-slate-200 bg-white px-4 py-2.5 text-sm font-semibold text-slate-700 transition hover:bg-slate-50" %>
                  </div>
                  <%= form_tag admin_salesperson_path(salesperson), method: :patch, id: form_id, class: "hidden", data: { salesperson_inline_edit_target: "form" } do %>
                    <%= hidden_field_tag :authenticity_token, form_authenticity_token %>
                  <% end %>
                </td>
              </tr>
            <% end %>
          <% else %>
            <tr>
              <td colspan="3" class="px-6 py-20 text-center">
                <div class="mx-auto mb-4 flex size-12 items-center justify-center rounded-full bg-slate-100 text-slate-500">
                  <svg class="size-6" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H7a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/></svg>
                </div>
                <h3 class="text-lg font-bold text-slate-950">No salespersons yet</h3>
                <p class="mt-1 text-sm text-slate-600">Create your first salesperson and assign the hotels they manage.</p>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
</div>
