<div class="max-w-[85rem] px-4 py-10 sm:px-6 lg:px-8 lg:py-14 mx-auto">
  <!-- Header -->
  <div class="flex flex-col md:flex-row justify-between items-center mb-8 gap-4">
    <div>
      <h1 class="text-3xl font-bold text-gray-800">Reconciliation Dashboard</h1>
      <p class="text-sm text-gray-600">Monitor and resolve payment webhook failures.</p>
    </div>
  </div>

  <!-- Filters -->
  <div class="bg-white border border-gray-200 rounded-xl shadow-sm p-4 md:p-6 mb-6">
    <%= form_with url: admin_reconciliations_path, method: :get, class: "flex gap-x-4 items-end" do |f| %>
      <div class="grow">
        <label class="block text-sm font-medium mb-2 text-gray-700">Status</label>
        <%= f.select :status, WebhookEvent::STATUSES.map { |s| [s.titleize, s] }, { include_blank: "All Statuses", selected: params[:status] }, class: "py-2 px-3 block w-full border-gray-200 rounded-lg text-sm focus:border-blue-500 focus:ring-blue-500 border" %>
      </div>
      <div>
        <%= f.submit "Filter", class: "py-2 px-4 inline-flex items-center gap-x-2 text-sm font-semibold rounded-lg border border-transparent bg-blue-600 text-white hover:bg-blue-700" %>
      </div>
    <% end %>
  </div>

  <!-- Table -->
  <div class="bg-white border border-gray-200 rounded-xl shadow-sm overflow-hidden">
    <table class="min-w-full divide-y divide-gray-200">
      <thead class="bg-gray-50">
        <tr>
          <th scope="col" class="px-6 py-3 text-start text-xs font-semibold uppercase tracking-wide text-gray-800">Time</th>
          <th scope="col" class="px-6 py-3 text-start text-xs font-semibold uppercase tracking-wide text-gray-800">Gateway</th>
          <th scope="col" class="px-6 py-3 text-start text-xs font-semibold uppercase tracking-wide text-gray-800">External ID</th>
          <th scope="col" class="px-6 py-3 text-start text-xs font-semibold uppercase tracking-wide text-gray-800">Status</th>
          <th scope="col" class="px-6 py-3 text-start text-xs font-semibold uppercase tracking-wide text-gray-800">Error</th>
          <th scope="col" class="px-6 py-3 text-end"></th>
        </tr>
      </thead>
      <tbody class="divide-y divide-gray-200">
        <% if @events.any? %>
          <% @events.each do |event| %>
            <tr>
              <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                <%= event.created_at.strftime("%d %b, %H:%M:%S") %>
              </td>
              <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-gray-800">
                <%= event.gateway.titleize %>
              </td>
              <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500 font-mono">
                <%= event.external_id %>
              </td>
              <td class="px-6 py-4 whitespace-nowrap">
                <% 
                  status_class = case event.status
                  when 'processed' then 'bg-green-100 text-green-800'
                  when 'failed' then 'bg-red-100 text-red-800'
                  else 'bg-yellow-100 text-yellow-800'
                  end
                %>
                <span class="py-1 px-2 inline-flex items-center gap-x-1 text-xs font-medium rounded-full <%= status_class %>">
                  <%= event.status.titleize %>
                </span>
              </td>
              <td class="px-6 py-4 text-sm text-red-600 truncate max-w-xs">
                <%= event.error_message %>
              </td>
              <td class="px-6 py-4 whitespace-nowrap text-end text-sm font-medium">
                <%= link_to "View", admin_reconciliation_path(event), class: "text-blue-600 hover:text-blue-800 mr-3" %>
                <% if event.status == 'failed' %>
                  <%= button_to "Retry", retry_admin_reconciliation_path(event), method: :post, class: "inline text-purple-600 hover:text-purple-800 font-semibold" %>
                <% end %>
              </td>
            </tr>
          <% end %>
              <% else %>
                <tr>
                  <td colspan="6" class="px-6 py-10 text-center">
                    <div class="flex flex-col items-center">
                      <svg class="size-10 text-gray-400 mb-2" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" />
                      </svg>
                      <p class="text-sm text-gray-500 italic">No webhook events found matching your criteria.</p>
                    </div>
                  </td>
                </tr>
              <% end %>
      </tbody>
    </table>
  </div>
</div>
