<div class="max-w-[85rem] px-4 py-10 sm:px-6 lg:px-8 lg:py-14 mx-auto">
  <!-- Back link -->
  <div class="mb-5">
    <%= link_to admin_reconciliations_path, class: "inline-flex items-center gap-x-1.5 text-sm font-medium text-gray-500 hover:text-blue-600" do %>
      <svg class="flex-shrink-0 w-4 h-4" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg>
      Back to Reconciliation
    <% end %>
  </div>

  <div class="grid lg:grid-cols-3 gap-6">
    <div class="lg:col-span-2 space-y-6">
      <!-- Event Details -->
      <div class="bg-white border border-gray-200 rounded-xl shadow-sm overflow-hidden">
        <div class="px-6 py-4 border-b border-gray-200 bg-gray-50 flex justify-between items-center">
          <h2 class="text-lg font-semibold text-gray-800">Webhook Payload</h2>
          <span class="text-xs font-mono text-gray-500"><%= @event.external_id %></span>
        </div>
        <div class="p-6">
          <pre class="bg-gray-900 text-green-400 p-4 rounded-lg overflow-x-auto text-xs font-mono">
<%= JSON.pretty_generate(@event.payload) %>
          </pre>
        </div>
      </div>

      <% if @event.error_message.present? %>
        <!-- Error Details -->
        <div class="bg-red-50 border border-red-200 rounded-xl shadow-sm overflow-hidden">
          <div class="px-6 py-4 border-b border-red-200">
            <h2 class="text-lg font-semibold text-red-800">Processing Error</h2>
          </div>
          <div class="p-6">
            <p class="text-red-700 font-mono text-sm"><%= @event.error_message %></p>
          </div>
        </div>
      <% end %>
    </div>

    <!-- Sidebar -->
    <div class="space-y-6">
      <div class="bg-white border border-gray-200 rounded-xl shadow-sm p-6">
        <h3 class="text-sm font-bold text-gray-800 uppercase tracking-wider mb-4">Event Status</h3>
        <div class="space-y-4">
          <div class="flex justify-between items-center">
            <span class="text-sm text-gray-500">Current Status</span>
            <% 
              status_class = case @event.status
              when 'processed' then 'bg-green-100 text-green-800'
              when 'failed' then 'bg-red-100 text-red-800'
              else 'bg-yellow-100 text-yellow-800'
              end
            %>
            <span class="py-1 px-2 inline-flex items-center gap-x-1 text-xs font-medium rounded-full <%= status_class %>">
              <%= @event.status.titleize %>
            </span>
          </div>
          <div class="flex justify-between items-center">
            <span class="text-sm text-gray-500">Gateway</span>
            <span class="text-sm font-medium text-gray-800"><%= @event.gateway.titleize %></span>
          </div>
          <div class="flex justify-between items-center">
            <span class="text-sm text-gray-500">Received At</span>
            <span class="text-sm font-medium text-gray-800"><%= @event.created_at.strftime("%d %b %Y, %H:%M:%S") %></span>
          </div>
          <% if @event.processed_at %>
            <div class="flex justify-between items-center">
              <span class="text-sm text-gray-500">Processed At</span>
              <span class="text-sm font-medium text-gray-800"><%= @event.processed_at.strftime("%d %b %Y, %H:%M:%S") %></span>
            </div>
          <% end %>
        </div>

        <% if @event.status == 'failed' %>
          <div class="mt-6 pt-6 border-t border-gray-100 space-y-3">
            <%= button_to "Retry Confirmation", retry_admin_reconciliation_path(@event), method: :post, class: "w-full py-3 px-4 inline-flex justify-center items-center gap-x-2 text-sm font-semibold rounded-lg border border-transparent bg-blue-600 text-white hover:bg-blue-700 transition" %>
            <%= button_to "Mark as Resolved", resolve_admin_reconciliation_path(@event), method: :post, class: "w-full py-3 px-4 inline-flex justify-center items-center gap-x-2 text-sm font-semibold rounded-lg border border-gray-200 bg-white text-gray-800 shadow-sm hover:bg-gray-50 transition" %>
            <p class="mt-2 text-[10px] text-gray-500 text-center italic">
              Retrying will attempt to create the booking and send notifications if successful. Mark as resolved if the issue was handled manually.
            </p>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</div>
