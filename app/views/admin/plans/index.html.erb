<% wired_slugs = %w[daily_occupancy_revenue arrivals_departures_list outstanding_balance_noshow housekeeper_productivity booking_source_analysis revenue_allocation_per_night task_assignment_minibar_log room_status_board unified_guest_profile role_based_access_control full_audit_trail no_show_auto_handling excel_pdf_export automated_prearrival checkin_confirmation welcoming_instay_messaging checkout_receipt_review manage_40_otas auto_sync_availability ai_concierge_page].to_set %>
<% coming_soon_slugs = %w[backdated_checkin_rate internal_staff_alerts preference_tagging complaint_history vip_blacklist_flag whatsapp_linked_to_profile maintenance_request_tracking priority_room_flagging multi_property_view shift_handover_log min_max_stay_rules last_minute_rate_automation rate_override_reason_code instant_rate_sync live_chat e_invoice accounting_integration per_pax_booking].to_set %>
<% locked_slugs = %w[payment_system billing_invoicing_system direct_booking_flow folio_management_billing].to_set %>
<% external_aic_slugs = Admin::PlansController::EXTERNAL_AIC_SLUGS.to_set %>
<% content_for :breadcrumbs do %>
  <%= render "shared/navigation/admin_breadcrumbs", current: "Plan Access" %>
<% end %>

<div class="w-full space-y-8">
  <%= render PanelsUI::PageHeader.new(
        title: "Plan Access",
        description: "Manage feature access across plan tiers. Changes apply immediately to all hotels on that plan.") %>

  <%= form_with url: update_matrix_admin_plans_path, method: :patch do |f| %>
    <div class="overflow-hidden rounded-2xl border border-border bg-card shadow-sm">
      <div class="flex items-center justify-between border-b border-border px-6 py-5 sm:px-8">
        <div>
          <h2 class="text-lg font-bold tracking-tight text-foreground sm:text-xl">Feature Matrix</h2>
          <p class="mt-1 text-sm font-medium text-muted-foreground">
            Toggle features per plan.
            <span class="inline-flex items-center gap-1 text-amber-600 font-semibold">+</span>
            indicates optional add-on. Level dropdown appears for tiered rows.
          </p>
        </div>
      </div>

      <div class="overflow-x-auto">
        <table class="min-w-full text-sm">
          <thead>
            <tr class="border-b border-border bg-muted">
              <th class="sticky left-0 z-10 bg-muted min-w-64 px-6 py-3 text-left text-xs font-semibold uppercase tracking-wide text-muted-foreground border-r border-border">
                Feature
              </th>
              <% @plans.each do |plan| %>
                <th class="min-w-36 px-4 py-3 text-center text-xs font-semibold uppercase tracking-wide text-muted-foreground">
                  <div class="flex flex-col items-center gap-1">
                    <span class="text-foreground font-bold text-sm normal-case"><%= plan.name %></span>
                    <% if plan.most_popular %>
                      <span class="rounded-full bg-amber-100 px-2 py-0.5 text-[10px] font-semibold text-amber-700 normal-case">Most Popular</span>
                    <% end %>
                  </div>
                </th>
              <% end %>
            </tr>
          </thead>
          <tbody>
            <% idx = 0 %>
            <% @feature_groups.each do |group| %>
              <tr>
                <td colspan="<%= @plans.size + 1 %>" class="bg-primary px-6 py-2">
                  <span class="text-xs font-bold uppercase tracking-widest text-primary-foreground"><%= group.name %></span>
                </td>
              </tr>
              <% if group.slug == "aic" %>
                <tr>
                  <td colspan="<%= @plans.size + 1 %>" class="bg-amber-50 px-6 py-2 border-b border-amber-100">
                    <span class="text-[11px] text-amber-700">Some AIC rows are managed outside WAStays today. These controls are disabled until the flows are wired inside WAStays.</span>
                  </td>
                </tr>
              <% end %>
              <% if group.slug == "cm" %>
                <tr>
                  <td colspan="<%= @plans.size + 1 %>" class="bg-amber-50 px-6 py-2 border-b border-amber-100">
                    <span class="text-[11px] text-amber-700">Note: both CM features share one gate at connection (onboarding). Auto-sync only runs once connected, so blocking connection covers both. On downgrade of an already-connected hotel, disconnect manually.</span>
                  </td>
                </tr>
              <% end %>
              <% group.features.each do |feature| %>
                <tr class="border-b border-border hover:bg-muted/60 transition-colors">
                  <td class="sticky left-0 z-10 bg-card px-6 py-3 font-medium text-foreground min-w-64 border-r border-border">
                    <%= feature.name %>
                    <% if external_aic_slugs.include?(feature.slug) %>
                      <span class="ml-2 inline-block rounded-full bg-amber-50 px-2 py-0.5 text-[10px] font-semibold text-amber-700 align-middle">External</span>
                    <% elsif coming_soon_slugs.include?(feature.slug) %>
                      <span class="ml-2 inline-block rounded-full bg-muted px-2 py-0.5 text-[10px] font-semibold text-muted-foreground align-middle">Coming Soon</span>
                    <% elsif locked_slugs.include?(feature.slug) %>
                      <span class="ml-2 inline-block rounded-full bg-blue-50 px-2 py-0.5 text-[10px] font-semibold text-blue-500 align-middle">Plan default</span>
                    <% elsif !wired_slugs.include?(feature.slug) %>
                      <span class="text-amber-400 font-bold ml-1" title="Feature exists but gating is blocked (level-logic / guest-context / external)">*</span>
                    <% end %>
                  </td>
                  <% @plans.each do |plan| %>
                    <% pf = @plan_features[[ plan.id, feature.id ]] %>
                    <% cs = coming_soon_slugs.include?(feature.slug) %>
                    <% locked = locked_slugs.include?(feature.slug) %>
                    <% external = external_aic_slugs.include?(feature.slug) %>
                    <% disabled = cs || locked || external %>
                    <td class="px-4 py-3 text-center align-middle">
                      <input type="hidden" name="cells[<%= idx %>][plan_id]" value="<%= plan.id %>">
                      <input type="hidden" name="cells[<%= idx %>][feature_id]" value="<%= feature.id %>">
                      <input type="hidden" name="cells[<%= idx %>][enabled]" value="<%= disabled && pf&.enabled ? '1' : '0' %>">
                      <input type="hidden" name="cells[<%= idx %>][addon]" value="<%= disabled && pf&.addon ? '1' : '0' %>">
                      <div class="flex flex-col items-center gap-1.5">
                        <% unless feature.addon %>
                          <input type="checkbox" name="cells[<%= idx %>][enabled]" value="1"
                                 class="size-4 rounded border-border-interactive text-teal-600 focus:ring-teal-500 <%= disabled ? 'cursor-not-allowed opacity-40' : 'cursor-pointer' %>"
                                 <%= "checked" if pf&.enabled %> <%= "disabled" if disabled %>>
                        <% end %>
                        <input type="hidden" name="cells[<%= idx %>][level]" value="<%= pf&.level %>">
                        <% if feature.addon %>
                          <input type="checkbox" name="cells[<%= idx %>][addon]" value="1"
                                 class="size-4 rounded border-border-interactive text-teal-600 focus:ring-teal-500 <%= cs ? 'cursor-not-allowed opacity-40' : 'cursor-pointer' %>"
                                 <%= "checked" if pf&.addon %> <%= "disabled" if cs %>>
                        <% end %>
                      </div>
                      <% idx += 1 %>
                    </td>
                  <% end %>
                </tr>
              <% end %>
            <% end %>
          </tbody>
        </table>
      </div>

      <div class="flex items-center justify-end border-t border-border bg-muted/50 px-6 py-4">
        <%= f.submit "Save changes",
              class: "inline-flex items-center justify-center gap-x-2 rounded-xl bg-teal-700 px-4 py-2.5 text-sm font-semibold text-primary-foreground transition hover:bg-teal-800 cursor-pointer" %>
      </div>
    </div>
  <% end %>
</div>
