<% wired_slugs = %w[daily_occupancy_revenue arrivals_departures_list outstanding_balance_noshow housekeeper_productivity booking_source_analysis revenue_allocation_per_night task_assignment_minibar_log room_status_board unified_guest_profile role_based_access_control full_audit_trail no_show_auto_handling excel_pdf_export automated_prearrival checkin_confirmation welcoming_instay_messaging checkout_receipt_review].to_set %>
<% content_for :breadcrumbs do %>
  <%= render "shared/navigation/admin_breadcrumbs", current: "Plans" %>
<% end %>

<div class="max-w-[1600px] mx-auto pb-20 space-y-8">
  <div class="px-4 md:px-0">
    <div class="mt-5 flex flex-col gap-4 lg:flex-row lg:items-end lg:justify-between">
      <div>
        <h1 class="text-2xl font-bold tracking-tight text-slate-950 sm:text-3xl">Subscription Plans</h1>
        <p class="mt-1 text-sm font-medium text-slate-600">Manage feature access across plan tiers. Changes apply immediately to all hotels on that plan.</p>
      </div>
    </div>
  </div>

  <%= form_with url: update_matrix_admin_plans_path, method: :patch do |f| %>
    <div class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">
      <div class="flex items-center justify-between border-b border-slate-200 px-6 py-5 sm:px-8">
        <div>
          <h2 class="text-lg font-bold tracking-tight text-slate-950 sm:text-xl">Feature Matrix</h2>
          <p class="mt-1 text-sm font-medium text-slate-600">
            Toggle features per plan.
            <span class="inline-flex items-center gap-1 text-amber-600 font-semibold">+</span>
            indicates optional add-on. Level dropdown appears for tiered rows.
          </p>
        </div>
      </div>

      <div class="overflow-x-auto">
        <table class="min-w-full text-sm">
          <thead>
            <tr class="border-b border-slate-200 bg-slate-50">
              <th class="sticky left-0 z-10 bg-slate-50 min-w-64 px-6 py-3 text-left text-xs font-semibold uppercase tracking-wide text-slate-500 border-r border-slate-200">
                Feature
              </th>
              <% @plans.each do |plan| %>
                <th class="min-w-36 px-4 py-3 text-center text-xs font-semibold uppercase tracking-wide text-slate-500">
                  <div class="flex flex-col items-center gap-1">
                    <span class="text-slate-900 font-bold text-sm normal-case"><%= plan.name %></span>
                    <% if plan.most_popular %>
                      <span class="rounded-full bg-amber-100 px-2 py-0.5 text-[10px] font-semibold text-amber-700 normal-case">Most Popular</span>
                    <% end %>
                  </div>
                </th>
              <% end %>
            </tr>
          </thead>
          <tbody>
            <% idx = 0 %>
            <% @feature_groups.each do |group| %>
              <tr>
                <td colspan="<%= @plans.size + 1 %>" class="bg-slate-800 px-6 py-2">
                  <span class="text-xs font-bold uppercase tracking-widest text-slate-200"><%= group.name %></span>
                </td>
              </tr>
              <% group.features.each do |feature| %>
                <tr class="border-b border-slate-100 hover:bg-slate-50/60 transition-colors">
                  <td class="sticky left-0 z-10 bg-white px-6 py-3 font-medium text-slate-700 min-w-64 border-r border-slate-100">
                    <%= feature.name %>
                    <% unless wired_slugs.include?(feature.slug) %>
                      <span class="text-amber-400 font-bold ml-1" title="Not wired to controller/sidebar yet">*</span>
                    <% end %>
                  </td>
                  <% @plans.each do |plan| %>
                    <% pf = @plan_features[[ plan.id, feature.id ]] %>
                    <td class="px-4 py-3 text-center align-middle">
                      <input type="hidden" name="cells[<%= idx %>][plan_id]" value="<%= plan.id %>">
                      <input type="hidden" name="cells[<%= idx %>][feature_id]" value="<%= feature.id %>">
                      <input type="hidden" name="cells[<%= idx %>][enabled]" value="0">
                      <input type="hidden" name="cells[<%= idx %>][addon]" value="0">
                      <div class="flex flex-col items-center gap-1.5">
                        <% unless feature.addon %>
                          <input type="checkbox" name="cells[<%= idx %>][enabled]" value="1"
                                 class="size-4 rounded border-slate-300 text-teal-600 focus:ring-teal-500 cursor-pointer"
                                 <%= "checked" if pf&.enabled %>>
                        <% end %>
                        <input type="hidden" name="cells[<%= idx %>][level]" value="<%= pf&.level %>">
                        <% if feature.addon %>
                          <input type="checkbox" name="cells[<%= idx %>][addon]" value="1"
                                 class="size-4 rounded border-slate-300 text-teal-600 focus:ring-teal-500 cursor-pointer"
                                 <%= "checked" if pf&.addon %>>
                        <% end %>
                      </div>
                      <% idx += 1 %>
                    </td>
                  <% end %>
                </tr>
              <% end %>
            <% end %>
          </tbody>
        </table>
      </div>

      <div class="flex items-center justify-end border-t border-slate-200 bg-slate-50/50 px-6 py-4">
        <%= f.submit "Save changes",
              class: "inline-flex items-center justify-center gap-x-2 rounded-xl bg-teal-700 px-4 py-2.5 text-sm font-semibold text-white transition hover:bg-teal-800 cursor-pointer" %>
      </div>
    </div>
  <% end %>
</div>
