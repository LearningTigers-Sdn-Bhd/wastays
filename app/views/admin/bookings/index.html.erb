<% total_bookings = @all_bookings.size %>
<% pending_bookings = @all_bookings.count { |booking| booking.status == 'pending' } %>
<% confirmed_bookings = @all_bookings.count { |booking| booking.status == 'confirmed' } %>
<% checked_in_bookings = @all_bookings.count { |booking| booking.status == 'checked_in' } %>
<% completed_bookings = @all_bookings.count { |booking| booking.status == 'completed' } %>
<% cancelled_bookings = @all_bookings.count { |booking| booking.status == 'cancelled' } %>

<div class="w-full space-y-8">
  <%= render PanelsUI::PageHeader.new(
        title: "Platform Bookings",
        description: "Review all bookings across all hotels on the platform.") %>

  <div id="booking_stats">
    <%= render "stats", all_bookings: @all_bookings %>
  </div>

  <div class="overflow-hidden rounded-2xl border border-border bg-card shadow-sm">
    <div class="flex items-center justify-between border-b border-border px-6 py-5 sm:px-8">
      <div>
        <h2 class="text-lg font-bold tracking-tight text-foreground sm:text-xl">Booking Registry</h2>
        <p class="mt-1 text-sm font-medium text-muted-foreground">Current booking records across the platform.</p>
      </div>
      <span class="text-sm font-medium text-muted-foreground">Total <span class="font-semibold text-foreground"><%= @all_bookings.size %></span></span>
    </div>

    <div class="flex flex-col gap-4 border-b border-border bg-muted/70 px-6 py-4 sm:px-8 lg:flex-row lg:items-center lg:justify-between">
      <%= form_with url: admin_bookings_path, method: :get, class: "contents", data: { controller: "auto-submit", turbo_frame: "bookings_list", turbo_action: "advance" } do |f| %>
        <label class="relative block w-full max-w-xl">
          <span class="pointer-events-none absolute inset-y-0 left-0 flex items-center pl-4 text-muted-foreground">
            <svg class="size-4" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
          </span>
          <%= f.text_field :q, value: params[:q], placeholder: "Search bookings...", class: "w-full rounded-xl border border-border bg-card py-2.5 pl-11 pr-4 text-sm text-foreground placeholder:text-muted-foreground focus:border-border-interactive focus:outline-none focus:ring-0", data: { action: "input->auto-submit#submit" } %>
        </label>

        <div class="flex items-center gap-3">
          <label for="booking-status-filter" class="text-sm font-medium text-muted-foreground">Status</label>
          <%= f.select :status, options_for_select(["All Status", "Pending", "Confirmed", "Review No Show", "No Show", "Checked In", "Completed", "Cancelled"], params[:status]), {}, id: "booking-status-filter", class: "rounded-xl border border-border bg-card px-3 py-2.5 text-sm font-medium text-foreground focus:border-border-interactive focus:outline-none focus:ring-0", data: { action: "change->auto-submit#submitNow" } %>
        </div>
      <% end %>
    </div>

    <%= turbo_frame_tag "bookings_list" do %>
      <div id="admin-bookings-mobile-list" class="space-y-4 p-4 sm:p-6 lg:hidden">
      <% @bookings.each do |booking| %>
        <% status_classes = case booking.status
           when 'confirmed'
             'text-emerald-700'
           when 'pending'
             'text-amber-700'
           when 'checked_in'
             'text-indigo-700'
           when 'completed'
             'text-blue-700'
           when 'cancelled'
             'text-red-700'
           else
             'text-muted-foreground'
           end %>
        <% status_dot_classes = case booking.status
           when 'confirmed'
             'bg-emerald-500'
           when 'pending'
             'bg-amber-500'
           when 'checked_in'
             'bg-indigo-500'
           when 'completed'
             'bg-blue-500'
           when 'cancelled'
             'bg-red-500'
           else
             'bg-muted'
           end %>

        <div class="rounded-2xl border border-border bg-muted/60 p-4 shadow-sm">
          <div class="flex items-start justify-between gap-3">
            <div>
              <p class="text-xs font-semibold uppercase tracking-[0.08em] text-muted-foreground">Confirmation</p>
              <%= link_to booking.confirmation_token, admin_booking_path(booking), class: 'mt-1 inline-flex font-mono text-sm font-semibold text-blue-700 hover:text-blue-800', data: { turbo_frame: "_top" } %>
            </div>
            <div class="inline-flex items-center gap-2 text-sm font-medium <%= status_classes %>">
              <span class="size-2.5 rounded-sm <%= status_dot_classes %>"></span>
              <%= booking.status.titleize %>
            </div>
          </div>

          <dl class="mt-4 space-y-3 text-sm">
            <div>
              <dt class="text-xs font-semibold uppercase tracking-[0.08em] text-muted-foreground">Hotel</dt>
              <dd class="mt-1 text-foreground"><%= booking.hotel.name %></dd>
            </div>
            <div>
              <dt class="text-xs font-semibold uppercase tracking-[0.08em] text-muted-foreground">Guest</dt>
              <dd class="mt-1 font-semibold text-foreground"><%= booking.guest_name %></dd>
            </div>
            <div class="flex items-center justify-between gap-3">
              <div>
                <dt class="text-xs font-semibold uppercase tracking-[0.08em] text-muted-foreground">Check-in</dt>
                <dd class="mt-1 text-foreground"><%= booking.check_in.strftime("%d %b %Y") %></dd>
              </div>
              <div class="text-right">
                <dt class="text-xs font-semibold uppercase tracking-[0.08em] text-muted-foreground">Amount</dt>
                <dd class="mt-1 font-semibold text-foreground"><%= number_to_currency(booking.total_amount, unit: 'RM ') %></dd>
              </div>
            </div>
          </dl>

          <div class="mt-4 flex justify-end">
            <%= link_to admin_booking_path(booking), class: "inline-flex items-center gap-x-1.5 rounded-lg border border-border bg-card px-3 py-1.5 text-xs font-semibold text-foreground shadow-sm transition hover:border-border-interactive hover:bg-muted", data: { turbo_frame: "_top" } do %>
              <svg class="size-3.5" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z"/><circle cx="12" cy="12" r="3"/></svg>
              View
            <% end %>
          </div>
        </div>
      <% end %>
    </div>

    <div class="hidden lg:block overflow-x-auto">
      <table class="min-w-full">
        <thead class="bg-muted">
          <tr>
            <th scope="col" class="px-6 py-4 text-left text-[11px] font-semibold uppercase tracking-[0.1em] text-muted-foreground sm:px-8">Confirmation</th>
            <th scope="col" class="px-6 py-4 text-left text-[11px] font-semibold uppercase tracking-[0.1em] text-muted-foreground">Hotel</th>
            <th scope="col" class="px-6 py-4 text-left text-[11px] font-semibold uppercase tracking-[0.1em] text-muted-foreground">Guest</th>
            <th scope="col" class="px-6 py-4 text-left text-[11px] font-semibold uppercase tracking-[0.1em] text-muted-foreground">Check-in</th>
            <th scope="col" class="px-6 py-4 text-left text-[11px] font-semibold uppercase tracking-[0.1em] text-muted-foreground">Status</th>
            <th scope="col" class="px-6 py-4 text-left text-[11px] font-semibold uppercase tracking-[0.1em] text-muted-foreground">Amount</th>
            <th scope="col" class="px-6 py-4 text-right text-[11px] font-semibold uppercase tracking-[0.1em] text-muted-foreground sm:px-8">Action</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-border bg-card">
          <% @bookings.each_with_index do |booking, index| %>
            <% status_classes = case booking.status
               when 'confirmed'
                 'text-emerald-700'
               when 'pending'
                 'text-amber-700'
               when 'checked_in'
                 'text-indigo-700'
               when 'completed'
                 'text-blue-700'
               when 'cancelled'
                 'text-red-700'
               else
                 'text-muted-foreground'
               end %>
            <% status_dot_classes = case booking.status
               when 'confirmed'
                 'bg-emerald-500'
               when 'pending'
                 'bg-amber-500'
               when 'checked_in'
                 'bg-indigo-500'
               when 'completed'
                 'bg-blue-500'
               when 'cancelled'
                 'bg-red-500'
               else
                 'bg-muted'
               end %>

            <tr class="transition-colors hover:bg-muted/80 <%= index.even? ? 'bg-card' : 'bg-muted/55' %>">
              <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-foreground sm:px-8">
                <%= link_to booking.confirmation_token, admin_booking_path(booking), class: 'text-blue-700 hover:text-blue-800', data: { turbo_frame: "_top" } %>
              </td>
              <td class="px-6 py-4 whitespace-nowrap text-sm text-foreground"><%= booking.hotel.name %></td>
              <td class="px-6 py-4 whitespace-nowrap text-sm text-foreground"><%= booking.guest_name %></td>
              <td class="px-6 py-4 whitespace-nowrap text-sm text-muted-foreground"><%= booking.check_in.strftime("%d %b %Y") %></td>
              <td class="px-6 py-4 whitespace-nowrap">
                <div class="inline-flex items-center gap-2 text-sm font-medium <%= status_classes %>">
                  <span class="size-2.5 rounded-sm <%= status_dot_classes %>"></span>
                  <%= booking.status.titleize %>
                </div>
              </td>
              <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-foreground"><%= number_to_currency(booking.total_amount, unit: 'RM ') %></td>
              <td class="px-6 py-4 text-right sm:px-8">
                <%= link_to admin_booking_path(booking), class: "inline-flex items-center gap-x-1.5 rounded-lg border border-border bg-card px-3 py-1.5 text-xs font-semibold text-foreground shadow-sm transition hover:border-border-interactive hover:bg-muted", data: { turbo_frame: "_top" } do %>
                  <svg class="size-3.5" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z"/><circle cx="12" cy="12" r="3"/></svg>
                  View
                <% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>

    <div class="px-6 py-5 border-t border-border bg-muted/50 flex justify-center sm:px-8">
      <%= paginate @bookings %>
    </div>
    <% end %>
  </div>
</div>
