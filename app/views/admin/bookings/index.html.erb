<% content_for :breadcrumbs do %>
  <%= render "shared/navigation/admin_breadcrumbs", current: "Bookings" %>
<% end %>

<% total_bookings = @all_bookings.size %>
<% pending_bookings = @all_bookings.count { |booking| booking.status == 'pending' } %>
<% confirmed_bookings = @all_bookings.count { |booking| booking.status == 'confirmed' } %>
<% checked_in_bookings = @all_bookings.count { |booking| booking.status == 'checked_in' } %>
<% completed_bookings = @all_bookings.count { |booking| booking.status == 'completed' } %>
<% cancelled_bookings = @all_bookings.count { |booking| booking.status == 'cancelled' } %>

<div class="max-w-[1600px] mx-auto pb-20 space-y-8">
  <div class="px-4 md:px-0">
    <div class="mt-5">
      <h1 class="text-2xl font-bold tracking-tight text-slate-950 sm:text-3xl">Platform Bookings</h1>
      <p class="mt-1 text-sm font-medium text-slate-600">Review all bookings across all hotels on the platform.</p>
    </div>
  </div>

  <div id="booking_stats">
    <%= render "stats", all_bookings: @all_bookings %>
  </div>

  <div class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">
    <div class="flex items-center justify-between border-b border-slate-200 px-6 py-5 sm:px-8">
      <div>
        <h2 class="text-lg font-bold tracking-tight text-slate-950 sm:text-xl">Booking Registry</h2>
        <p class="mt-1 text-sm font-medium text-slate-600">Current booking records across the platform.</p>
      </div>
      <span class="text-sm font-medium text-slate-500">Total <span class="font-semibold text-slate-900"><%= @all_bookings.size %></span></span>
    </div>

    <div class="flex flex-col gap-4 border-b border-slate-200 bg-slate-50/70 px-6 py-4 sm:px-8 lg:flex-row lg:items-center lg:justify-between">
      <%= form_with url: admin_bookings_path, method: :get, class: "contents", data: { controller: "auto-submit", turbo_frame: "bookings_list", turbo_action: "advance" } do |f| %>
        <label class="relative block w-full max-w-xl">
          <span class="pointer-events-none absolute inset-y-0 left-0 flex items-center pl-4 text-slate-400">
            <svg class="size-4" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
          </span>
          <%= f.text_field :q, value: params[:q], placeholder: "Search bookings...", class: "w-full rounded-xl border border-slate-200 bg-white py-2.5 pl-11 pr-4 text-sm text-slate-700 placeholder:text-slate-400 focus:border-slate-300 focus:outline-none focus:ring-0", data: { action: "input->auto-submit#submit" } %>
        </label>

        <div class="flex items-center gap-3">
          <label for="booking-status-filter" class="text-sm font-medium text-slate-600">Status</label>
          <%= f.select :status, options_for_select(["All Status", "Pending", "Confirmed", "Checked In", "Completed", "Cancelled"], params[:status]), {}, id: "booking-status-filter", class: "rounded-xl border border-slate-200 bg-white px-3 py-2.5 text-sm font-medium text-slate-700 focus:border-slate-300 focus:outline-none focus:ring-0", data: { action: "change->auto-submit#submitNow" } %>
        </div>
      <% end %>
    </div>

    <%= turbo_frame_tag "bookings_list" do %>
      <div id="admin-bookings-mobile-list" class="space-y-4 p-4 sm:p-6 lg:hidden">
      <% @bookings.each do |booking| %>
        <% status_classes = case booking.status
           when 'confirmed'
             'text-emerald-700'
           when 'pending'
             'text-amber-700'
           when 'checked_in'
             'text-indigo-700'
           when 'completed'
             'text-blue-700'
           when 'cancelled'
             'text-red-700'
           else
             'text-slate-600'
           end %>
        <% status_dot_classes = case booking.status
           when 'confirmed'
             'bg-emerald-500'
           when 'pending'
             'bg-amber-500'
           when 'checked_in'
             'bg-indigo-500'
           when 'completed'
             'bg-blue-500'
           when 'cancelled'
             'bg-red-500'
           else
             'bg-slate-400'
           end %>

        <div class="rounded-2xl border border-slate-200 bg-slate-50/60 p-4 shadow-sm">
          <div class="flex items-start justify-between gap-3">
            <div>
              <p class="text-xs font-semibold uppercase tracking-[0.08em] text-slate-500">Confirmation</p>
              <%= link_to booking.confirmation_token, admin_booking_path(booking), class: 'mt-1 inline-flex font-mono text-sm font-semibold text-blue-700 hover:text-blue-800', data: { turbo_frame: "_top" } %>
            </div>
            <div class="inline-flex items-center gap-2 text-sm font-medium <%= status_classes %>">
              <span class="size-2.5 rounded-sm <%= status_dot_classes %>"></span>
              <%= booking.status.titleize %>
            </div>
          </div>

          <dl class="mt-4 space-y-3 text-sm">
            <div>
              <dt class="text-xs font-semibold uppercase tracking-[0.08em] text-slate-500">Hotel</dt>
              <dd class="mt-1 text-slate-700"><%= booking.hotel.name %></dd>
            </div>
            <div>
              <dt class="text-xs font-semibold uppercase tracking-[0.08em] text-slate-500">Guest</dt>
              <dd class="mt-1 font-semibold text-slate-900"><%= booking.guest_name %></dd>
            </div>
            <div class="flex items-center justify-between gap-3">
              <div>
                <dt class="text-xs font-semibold uppercase tracking-[0.08em] text-slate-500">Check-in</dt>
                <dd class="mt-1 text-slate-700"><%= booking.check_in.strftime("%d %b %Y") %></dd>
              </div>
              <div class="text-right">
                <dt class="text-xs font-semibold uppercase tracking-[0.08em] text-slate-500">Amount</dt>
                <dd class="mt-1 font-semibold text-slate-900"><%= number_to_currency(booking.total_amount, unit: 'RM ') %></dd>
              </div>
            </div>
          </dl>

          <div class="mt-4 flex justify-end">
            <%= link_to admin_booking_path(booking), class: "inline-flex items-center gap-x-1.5 rounded-lg border border-slate-200 bg-white px-3 py-1.5 text-xs font-semibold text-slate-700 shadow-sm transition hover:border-slate-900 hover:bg-slate-50", data: { turbo_frame: "_top" } do %>
              <svg class="size-3.5" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z"/><circle cx="12" cy="12" r="3"/></svg>
              View
            <% end %>
          </div>
        </div>
      <% end %>
    </div>

    <div class="hidden lg:block overflow-x-auto">
      <table class="min-w-full">
        <thead class="bg-slate-100">
          <tr>
            <th scope="col" class="px-6 py-4 text-left text-[11px] font-semibold uppercase tracking-[0.1em] text-slate-600 sm:px-8">Confirmation</th>
            <th scope="col" class="px-6 py-4 text-left text-[11px] font-semibold uppercase tracking-[0.1em] text-slate-600">Hotel</th>
            <th scope="col" class="px-6 py-4 text-left text-[11px] font-semibold uppercase tracking-[0.1em] text-slate-600">Guest</th>
            <th scope="col" class="px-6 py-4 text-left text-[11px] font-semibold uppercase tracking-[0.1em] text-slate-600">Check-in</th>
            <th scope="col" class="px-6 py-4 text-left text-[11px] font-semibold uppercase tracking-[0.1em] text-slate-600">Status</th>
            <th scope="col" class="px-6 py-4 text-left text-[11px] font-semibold uppercase tracking-[0.1em] text-slate-600">Amount</th>
            <th scope="col" class="px-6 py-4 text-right text-[11px] font-semibold uppercase tracking-[0.1em] text-slate-600 sm:px-8">Action</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-200 bg-white">
          <% @bookings.each_with_index do |booking, index| %>
            <% status_classes = case booking.status
               when 'confirmed'
                 'text-emerald-700'
               when 'pending'
                 'text-amber-700'
               when 'checked_in'
                 'text-indigo-700'
               when 'completed'
                 'text-blue-700'
               when 'cancelled'
                 'text-red-700'
               else
                 'text-slate-600'
               end %>
            <% status_dot_classes = case booking.status
               when 'confirmed'
                 'bg-emerald-500'
               when 'pending'
                 'bg-amber-500'
               when 'checked_in'
                 'bg-indigo-500'
               when 'completed'
                 'bg-blue-500'
               when 'cancelled'
                 'bg-red-500'
               else
                 'bg-slate-400'
               end %>

            <tr class="transition-colors hover:bg-slate-100/80 <%= index.even? ? 'bg-white' : 'bg-slate-50/55' %>">
              <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-slate-900 sm:px-8">
                <%= link_to booking.confirmation_token, admin_booking_path(booking), class: 'text-blue-700 hover:text-blue-800', data: { turbo_frame: "_top" } %>
              </td>
              <td class="px-6 py-4 whitespace-nowrap text-sm text-slate-700"><%= booking.hotel.name %></td>
              <td class="px-6 py-4 whitespace-nowrap text-sm text-slate-700"><%= booking.guest_name %></td>
              <td class="px-6 py-4 whitespace-nowrap text-sm text-slate-600"><%= booking.check_in.strftime("%d %b %Y") %></td>
              <td class="px-6 py-4 whitespace-nowrap">
                <div class="inline-flex items-center gap-2 text-sm font-medium <%= status_classes %>">
                  <span class="size-2.5 rounded-sm <%= status_dot_classes %>"></span>
                  <%= booking.status.titleize %>
                </div>
              </td>
              <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-slate-900"><%= number_to_currency(booking.total_amount, unit: 'RM ') %></td>
              <td class="px-6 py-4 text-right sm:px-8">
                <%= link_to admin_booking_path(booking), class: "inline-flex items-center gap-x-1.5 rounded-lg border border-slate-200 bg-white px-3 py-1.5 text-xs font-semibold text-slate-700 shadow-sm transition hover:border-slate-900 hover:bg-slate-50", data: { turbo_frame: "_top" } do %>
                  <svg class="size-3.5" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z"/><circle cx="12" cy="12" r="3"/></svg>
                  View
                <% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>

    <div class="px-6 py-5 border-t border-slate-200 bg-slate-50/50 flex justify-center sm:px-8">
      <%= paginate @bookings %>
    </div>
    <% end %>
  </div>
</div>
