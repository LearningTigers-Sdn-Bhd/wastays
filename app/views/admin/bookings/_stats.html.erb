<% total_bookings = all_bookings.size %>
<% pending_bookings = all_bookings.count { |booking| booking.status == 'pending' } %>
<% confirmed_bookings = all_bookings.count { |booking| booking.status == 'confirmed' } %>
<% checked_in_bookings = all_bookings.count { |booking| booking.status == 'checked_in' } %>
<% completed_bookings = all_bookings.count { |booking| booking.status == 'completed' } %>
<% cancelled_bookings = all_bookings.count { |booking| booking.status == 'cancelled' } %>

<div class="grid grid-cols-1 overflow-hidden rounded-2xl border border-border bg-card shadow-sm md:grid-cols-3 xl:grid-cols-6">
  <div class="p-6 md:border-r md:border-border md:p-8">
    <p class="mb-2 text-[11px] font-semibold uppercase tracking-[0.08em] text-muted-foreground">Total Bookings</p>
    <h2 class="text-3xl font-bold tabular-nums tracking-tight text-foreground"><%= total_bookings %></h2>
    <p class="mt-2 text-sm font-medium text-muted-foreground">All bookings on platform</p>
  </div>

  <div class="bg-muted/30 p-6 md:border-r md:border-border md:p-8">
    <p class="mb-2 text-[11px] font-semibold uppercase tracking-[0.08em] text-muted-foreground">Pending</p>
    <h2 class="text-3xl font-bold tabular-nums tracking-tight text-amber-600"><%= pending_bookings %></h2>
    <p class="mt-2 text-sm font-medium text-muted-foreground">Awaiting confirmation</p>
  </div>

  <div class="p-6 md:border-r md:border-border md:p-8">
    <p class="mb-2 text-[11px] font-semibold uppercase tracking-[0.08em] text-muted-foreground">Confirmed</p>
    <h2 class="text-3xl font-bold tabular-nums tracking-tight text-emerald-600"><%= confirmed_bookings %></h2>
    <p class="mt-2 text-sm font-medium text-muted-foreground">Upcoming confirmed stays</p>
  </div>

  <div class="bg-muted/30 p-6 md:border-r md:border-border md:p-8">
    <p class="mb-2 text-[11px] font-semibold uppercase tracking-[0.08em] text-muted-foreground">Checked In</p>
    <h2 class="text-3xl font-bold tabular-nums tracking-tight text-indigo-600"><%= checked_in_bookings %></h2>
    <p class="mt-2 text-sm font-medium text-muted-foreground">Guests currently staying</p>
  </div>

  <div class="p-6 md:border-r md:border-border md:p-8">
    <p class="mb-2 text-[11px] font-semibold uppercase tracking-[0.08em] text-muted-foreground">Completed</p>
    <h2 class="text-3xl font-bold tabular-nums tracking-tight text-blue-600"><%= completed_bookings %></h2>
    <p class="mt-2 text-sm font-medium text-muted-foreground">Checked-out bookings</p>
  </div>

  <div class="p-6 md:p-8">
    <p class="mb-2 text-[11px] font-semibold uppercase tracking-[0.08em] text-muted-foreground">Cancelled</p>
    <h2 class="text-3xl font-bold tabular-nums tracking-tight text-red-600"><%= cancelled_bookings %></h2>
    <p class="mt-2 text-sm font-medium text-muted-foreground">Cancelled reservations</p>
  </div>
</div>
