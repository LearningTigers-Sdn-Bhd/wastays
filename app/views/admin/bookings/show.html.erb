<% content_for :breadcrumbs do %>
  <%= render "shared/navigation/admin_breadcrumbs", current: "Booking Details" %>
<% end %>

<div class="max-w-[1600px] mx-auto pb-20 space-y-6">
  <div>
    <%= link_to admin_bookings_path, class: "inline-flex items-center gap-x-1.5 text-sm font-medium text-slate-500 transition hover:text-slate-900" do %>
      <svg class="size-4" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg>
      Back to All Bookings
    <% end %>
  </div>

  <div class="grid grid-cols-1 gap-6 xl:grid-cols-12">
    <div class="space-y-6 xl:col-span-8">
      <section class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">
        <div class="border-b border-slate-200 px-6 py-6 sm:px-8">
          <div class="flex flex-wrap items-start justify-between gap-4">
            <div>
              <h1 class="text-2xl font-bold tracking-tight text-slate-950 sm:text-3xl">Booking <%= @booking.confirmation_token %></h1>
              <p class="mt-2 text-sm font-medium text-slate-600 sm:text-base">Review booking details, guest information, and payment status for this reservation.</p>
              <p class="mt-2 text-sm font-medium text-slate-500">Created on <%= @booking.created_at.strftime("%d %b %Y at %H:%M") %></p>
              <p class="mt-1 text-sm font-medium text-blue-700">Hotel: <%= @booking.hotel.name %></p>
            </div>
          </div>
        </div>

        <div class="px-6 py-6 sm:px-8">
          <div class="grid gap-4 sm:grid-cols-2 xl:grid-cols-3">
            <div class="rounded-xl border border-slate-200 bg-slate-50/60 px-4 py-4">
              <p class="text-[11px] font-semibold uppercase tracking-[0.1em] text-slate-500">Guest Name</p>
              <p class="mt-2 text-sm font-medium text-slate-900"><%= @booking.guest_name %></p>
            </div>
            <div class="rounded-xl border border-slate-200 bg-slate-50/60 px-4 py-4">
              <p class="text-[11px] font-semibold uppercase tracking-[0.1em] text-slate-500">Email Address</p>
              <p class="mt-2 text-sm font-medium text-slate-900"><%= @booking.guest_email %></p>
            </div>
            <div class="rounded-xl border border-slate-200 bg-slate-50/60 px-4 py-4">
              <p class="text-[11px] font-semibold uppercase tracking-[0.1em] text-slate-500">Phone Number</p>
              <p class="mt-2 text-sm font-medium text-slate-900"><%= @booking.guest_phone %></p>
            </div>
          </div>
        </div>
      </section>

      <section class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">
        <div class="border-b border-slate-200 px-6 py-5 sm:px-8">
          <h2 class="text-lg font-bold tracking-tight text-slate-950 sm:text-xl">Stay & Room Details</h2>
        </div>

        <div class="space-y-6 px-6 py-6 sm:px-8">
          <div class="grid grid-cols-2 gap-4 sm:grid-cols-4">
            <div class="rounded-xl border border-slate-200 bg-slate-50/60 px-4 py-4">
              <p class="text-[11px] font-semibold uppercase tracking-[0.1em] text-slate-500">Check-in</p>
              <p class="mt-2 text-sm font-medium text-slate-900"><%= @booking.check_in.strftime("%d %b %Y") %></p>
            </div>
            <div class="rounded-xl border border-slate-200 bg-slate-50/60 px-4 py-4">
              <p class="text-[11px] font-semibold uppercase tracking-[0.1em] text-slate-500">Check-out</p>
              <p class="mt-2 text-sm font-medium text-slate-900"><%= @booking.check_out.strftime("%d %b %Y") %></p>
            </div>
            <div class="rounded-xl border border-slate-200 bg-slate-50/60 px-4 py-4">
              <p class="text-[11px] font-semibold uppercase tracking-[0.1em] text-slate-500">Adults</p>
              <p class="mt-2 text-sm font-medium text-slate-900"><%= @booking.adults %></p>
            </div>
            <div class="rounded-xl border border-slate-200 bg-slate-50/60 px-4 py-4">
              <p class="text-[11px] font-semibold uppercase tracking-[0.1em] text-slate-500">Children</p>
              <p class="mt-2 text-sm font-medium text-slate-900"><%= @booking.children %></p>
            </div>
          </div>

          <div>
            <h3 class="text-sm font-bold uppercase tracking-[0.18em] text-slate-700">Rooms</h3>
            <div class="mt-4 space-y-3">
              <% @booking.booking_rooms.each do |room| %>
                <div class="flex items-center justify-between gap-4 rounded-xl border border-slate-200 bg-slate-50/60 px-4 py-4">
                  <div>
                    <p class="font-semibold text-slate-900"><%= room.room_type.name %></p>
                    <p class="mt-1 text-xs text-slate-500"><%= room.quantity %> room(s)</p>
                  </div>
                  <div class="text-right">
                    <p class="font-semibold text-blue-700">RM <%= room.subtotal %></p>
                  </div>
                </div>
              <% end %>
            </div>
          </div>
        </div>
      </section>
    </div>

    <aside class="space-y-6 xl:col-span-4">
      <section class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
        <h2 class="mb-4 text-lg font-bold tracking-tight text-slate-950 sm:text-xl">Status Summary</h2>
        <div class="space-y-4">
          <div class="flex items-center justify-between gap-4">
            <span class="text-sm font-medium text-slate-500">Booking Status</span>
            <span class="inline-flex items-center gap-x-1.5 rounded-full px-3 py-1.5 text-xs font-semibold <%= case @booking.status
                when 'confirmed' then 'bg-emerald-50 text-emerald-700 ring-1 ring-inset ring-emerald-200'
                when 'pending' then 'bg-amber-50 text-amber-700 ring-1 ring-inset ring-amber-200'
                when 'cancelled' then 'bg-red-50 text-red-700 ring-1 ring-inset ring-red-200'
                else 'bg-slate-100 text-slate-700 ring-1 ring-inset ring-slate-200'
                end %>">
              <%= @booking.status.titleize %>
            </span>
          </div>
          <div class="flex items-center justify-between gap-4">
            <span class="text-sm font-medium text-slate-500">Payment Status</span>
            <span class="inline-flex items-center gap-x-1.5 rounded-full px-3 py-1.5 text-xs font-semibold <%= case @booking.payment_status
                when 'captured' then 'bg-emerald-50 text-emerald-700 ring-1 ring-inset ring-emerald-200'
                when 'pending' then 'bg-amber-50 text-amber-700 ring-1 ring-inset ring-amber-200'
                when 'failed' then 'bg-red-50 text-red-700 ring-1 ring-inset ring-red-200'
                else 'bg-slate-100 text-slate-700 ring-1 ring-inset ring-slate-200'
                end %>">
              <%= @booking.payment_status&.titleize || 'N/A' %>
            </span>
          </div>
          <div class="flex items-center justify-between gap-4">
            <span class="text-sm font-medium text-slate-500">Pre Check-In Status</span>
            <% admin_pre_checkin_status = pre_checkin_display_status(@booking) %>
            <span class="inline-flex items-center gap-x-1.5 rounded-full px-3 py-1.5 text-xs font-semibold <%= case admin_pre_checkin_status
                when 'completed' then 'bg-emerald-50 text-emerald-700 ring-1 ring-inset ring-emerald-200'
                when 'in_progress' then 'bg-blue-50 text-blue-700 ring-1 ring-inset ring-blue-200'
                when 'pending' then 'bg-amber-50 text-amber-700 ring-1 ring-inset ring-amber-200'
                when 'failed' then 'bg-red-50 text-red-700 ring-1 ring-inset ring-red-200'
                else 'bg-slate-100 text-slate-700 ring-1 ring-inset ring-slate-200'
                end %>">
              <%= admin_pre_checkin_status.titleize %>
            </span>
          </div>
          <div class="border-t border-slate-200 pt-4">
            <div class="flex items-center justify-between gap-4">
              <span class="text-base font-semibold text-slate-900">Total Amount</span>
              <span class="text-2xl font-bold tracking-tight text-blue-700">RM <%= @booking.total_amount %></span>
            </div>
          </div>
        </div>
      </section>
    </aside>
  </div>
</div>
