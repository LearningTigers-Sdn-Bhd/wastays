<div class="space-y-6 pb-12">
  <!-- Page Header -->
  <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-y-4">
    <div>
      <nav class="flex mb-2" aria-label="Breadcrumb">
        <ol class="flex items-center whitespace-nowrap min-w-0">
          <li class="flex items-center text-sm text-neutral-text-secondary">
            Superadmin
            <svg class="flex-shrink-0 mx-2 overflow-visible h-4 w-4 text-gray-400" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg>
          </li>
          <li class="text-sm font-semibold text-brand-primary truncate" aria-current="page">
            API Keys
          </li>
        </ol>
      </nav>

      <div class="mb-6 flex items-center gap-x-3">
        <div class="flex-shrink-0 w-8 h-8 rounded-lg bg-brand-primary/10 text-brand-primary flex items-center justify-center">
          <svg class="w-4 h-4" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
        </div>
        <%= link_to "View Documentation", docs_admin_api_keys_path, class: "text-sm font-bold text-neutral-text-primary underline hover:text-brand-primary transition-colors" %>
      </div>

      <h1 class="text-2xl font-bold text-neutral-text-primary">API Access Management</h1>
      <p class="text-sm text-neutral-text-secondary">Manage programmatic access for chatbots and external integrations.</p>
    </div>

    <div>
      <%= link_to new_admin_api_key_path, class: "btn btn-primary" do %>
        <svg class="w-4 h-4 me-2" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="M12 5v14"/></svg>
        Generate New Key
      <% end %>
    </div>
  </div>

  <div class="card overflow-hidden">
    <div class="overflow-x-auto">
      <table class="w-full text-left border-collapse">
        <thead class="bg-neutral-bg/50">
          <tr>
            <th class="px-6 py-4 text-[10px] font-black text-neutral-text-secondary uppercase tracking-widest border-b border-neutral-border">Name</th>
            <th class="px-6 py-4 text-[10px] font-black text-neutral-text-secondary uppercase tracking-widest border-b border-neutral-border">Bearer / Scope</th>
            <th class="px-6 py-4 text-[10px] font-black text-neutral-text-secondary uppercase tracking-widest border-b border-neutral-border">Token (Last 8)</th>
            <th class="px-6 py-4 text-[10px] font-black text-neutral-text-secondary uppercase tracking-widest border-b border-neutral-border">Status</th>
            <th class="px-6 py-4 text-[10px] font-black text-neutral-text-secondary uppercase tracking-widest border-b border-neutral-border">Last Used</th>
            <th class="px-6 py-4 border-b border-neutral-border"></th>
          </tr>
        </thead>
        <tbody class="divide-y divide-neutral-border">
          <% @api_keys.each do |key| %>
            <tr class="hover:bg-neutral-bg/30 transition-colors">
              <td class="px-6 py-4">
                <span class="text-sm font-bold text-neutral-text-primary"><%= key.name %></span>
              </td>
              <td class="px-6 py-4">
                <% if key.superadmin? %>
                  <span class="inline-flex items-center gap-x-1.5 py-1.5 px-3 rounded-full text-xs font-medium bg-purple-100 text-purple-800">
                    Global (Superadmin)
                  </span>
                <% else %>
                  <div class="flex flex-col">
                    <span class="text-xs font-semibold text-neutral-text-primary"><%= key.bearer&.name %></span>
                    <span class="text-[10px] text-neutral-text-secondary uppercase font-bold"><%= key.bearer_type %> Restriction</span>
                  </div>
                <% end %>
              </td>
              <td class="px-6 py-4">
                <code class="text-xs bg-neutral-bg px-2 py-1 rounded border border-neutral-border">...<%= key.token.last(8) %></code>
              </td>
              <td class="px-6 py-4">
                <% if key.status == 'active' %>
                  <span class="inline-flex items-center gap-x-1.5 py-1 px-2.5 rounded-full text-xs font-medium bg-green-100 text-green-800">
                    <span class="w-1.5 h-1.5 inline-block rounded-full bg-green-600"></span>
                    Active
                  </span>
                <% else %>
                  <span class="inline-flex items-center gap-x-1.5 py-1 px-2.5 rounded-full text-xs font-medium bg-red-100 text-red-800">
                    Revoked
                  </span>
                <% end %>
              </td>
              <td class="px-6 py-4">
                <span class="text-xs text-neutral-text-secondary">
                  <%= key.last_used_at ? "#{time_ago_in_words(key.last_used_at)} ago" : "Never" %>
                </span>
              </td>
              <td class="px-6 py-4 text-right">
                <% if key.status == 'active' %>
                  <%= link_to admin_api_key_path(key), data: { turbo_method: :delete, turbo_confirm: "Are you sure? This will immediately disable all API requests using this key." }, class: "text-status-error hover:text-red-700 text-xs font-bold uppercase tracking-widest" do %>
                    Revoke
                  <% end %>
                <% end %>
              </td>
            </tr>
          <% end %>
          <% if @api_keys.empty? %>
            <tr>
              <td colspan="6" class="px-6 py-12 text-center">
                <p class="text-sm text-neutral-text-secondary">No API keys generated yet.</p>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
</div>
