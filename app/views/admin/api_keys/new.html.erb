<div class="max-w-2xl mx-auto space-y-6 pb-12">
  <!-- Page Header -->
  <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-y-4">
    <div>
      <nav class="flex mb-2" aria-label="Breadcrumb">
        <ol class="flex items-center whitespace-nowrap min-w-0">
          <li class="flex items-center text-sm text-neutral-text-secondary">
            Superadmin
            <svg class="flex-shrink-0 mx-2 overflow-visible h-4 w-4 text-gray-400" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg>
          </li>
          <li class="flex items-center text-sm text-neutral-text-secondary">
            <%= link_to "API Keys", admin_api_keys_path, class: "hover:text-brand-primary" %>
            <svg class="flex-shrink-0 mx-2 overflow-visible h-4 w-4 text-gray-400" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg>
          </li>
          <li class="text-sm font-semibold text-brand-primary truncate" aria-current="page">
            Generate New Key
          </li>
        </ol>
      </nav>
      <h1 class="text-2xl font-bold text-neutral-text-primary">New API Access Key</h1>
    </div>
  </div>

  <div class="card p-6 md:p-8">
    <%= form_with model: [:admin, @api_key], local: true, class: "space-y-6" do |f| %>
      <% if @api_key.errors.any? %>
        <div class="p-4 rounded-lg bg-red-50 text-status-error text-sm border border-red-200">
          <ul class="list-disc list-inside">
            <% @api_key.errors.full_messages.each do |msg| %>
              <li><%= msg %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <div class="space-y-2">
        <%= f.label :name, "Key Identifier", class: "block text-[10px] font-black uppercase tracking-widest text-neutral-text-secondary" %>
        <%= f.text_field :name, placeholder: "e.g. WhatsApp Chatbot - Main", class: "form-input", required: true %>
        <p class="text-[10px] text-neutral-text-secondary">A friendly name to help you remember what this key is used for.</p>
      </div>

      <div class="space-y-2 border-t border-neutral-border pt-6">
        <label class="block text-[10px] font-black uppercase tracking-widest text-neutral-text-secondary">Scope & Restriction</label>
        
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <div class="space-y-2">
            <%= f.label :bearer_type, "Restriction Level", class: "text-xs font-bold text-neutral-text-primary" %>
            <%= f.select :bearer_type, [["Global (Superadmin)", ""], ["Hotel Specific", "Hotel"], ["Account Specific", "Account"]], {}, class: "form-input", id: "bearer_type_select" %>
          </div>

          <div class="space-y-2" id="bearer_id_container" style="display: none;">
            <%= f.label :bearer_id, "Target Entity ID", class: "text-xs font-bold text-neutral-text-primary" %>
            <%= f.number_field :bearer_id, class: "form-input", placeholder: "Enter ID" %>
          </div>
        </div>
        
        <div class="p-4 rounded-lg bg-neutral-bg border border-neutral-border mt-4">
          <p class="text-xs text-neutral-text-secondary leading-relaxed" id="scope_explanation">
            <strong>Global Key:</strong> Can access all hotels and bookings in the entire system.
          </p>
        </div>
      </div>

      <div class="pt-6 border-t border-neutral-border flex gap-x-3">
        <%= f.submit "Generate API Key", class: "btn btn-primary" %>
        <%= link_to "Cancel", admin_api_keys_path, class: "btn btn-secondary" %>
      </div>
    <% end %>
  </div>
</div>

<script>
  document.addEventListener('turbo:load', () => {
    const typeSelect = document.getElementById('bearer_type_select');
    const idContainer = document.getElementById('bearer_id_container');
    const explanation = document.getElementById('scope_explanation');

    const updateUI = () => {
      const type = typeSelect.value;
      if (type === "") {
        idContainer.style.display = 'none';
        explanation.innerHTML = '<strong>Global Key:</strong> Can access all hotels and bookings in the entire system.';
      } else if (type === "Hotel") {
        idContainer.style.display = 'block';
        explanation.innerHTML = '<strong>Hotel Restriction:</strong> This key will <u>only</u> be able to fetch data for the specific Hotel ID provided.';
      } else if (type === "Account") {
        idContainer.style.display = 'block';
        explanation.innerHTML = '<strong>Account Restriction:</strong> This key can access all hotels belonging to the specified Account ID.';
      }
    };

    if (typeSelect) {
      typeSelect.addEventListener('change', updateUI);
      updateUI();
    }
  });
</script>
