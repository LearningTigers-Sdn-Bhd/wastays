<% frame_id = turbo_frame_request_id.presence || "admin_attraction_action_sheet" %>
<% update_form_id = "update-admin-attraction-form" %>

<%= turbo_frame_tag frame_id do %>
  <div data-controller="panels-ui--sheet-frame">
    <%= render PanelsUI::Sheet.new(
          id: "review-attraction-sheet",
          side: :right,
          size: :xl,
          title: "Review attraction",
          description: "Review the shared place, its source, and possible duplicates.") do |sheet| %>
      <% sheet.with_body do %>
        <div class="space-y-6 py-2">
          <% if @attraction.errors.any? %>
            <div class="rounded-md border border-destructive/40 bg-destructive/10 px-3 py-2 text-sm text-destructive" role="alert" tabindex="-1">
              <h3 class="font-semibold"><%= pluralize(@attraction.errors.count, "issue") %> needs attention.</h3>
              <ul class="mt-2 list-disc space-y-1 pl-5">
                <% @attraction.errors.full_messages.each do |message| %>
                  <li><%= message %></li>
                <% end %>
              </ul>
            </div>
          <% end %>

          <section class="space-y-4" aria-labelledby="attraction-review-heading">
            <div class="flex flex-wrap items-start justify-between gap-3">
              <div>
                <h3 id="attraction-review-heading" class="text-base font-semibold"><%= @attraction.name %></h3>
                <p class="mt-1 text-sm text-muted-foreground"><%= attraction_location(@attraction) %></p>
              </div>
              <%= attraction_status_badge(@attraction) %>
            </div>

            <dl class="grid gap-4 rounded-md border border-border bg-muted/30 p-4 text-sm sm:grid-cols-2">
              <div>
                <dt class="text-xs text-muted-foreground">Coordinates</dt>
                <dd class="mt-0.5 font-mono text-xs"><%= attraction_coordinates(@attraction) %></dd>
              </div>
              <div>
                <dt class="text-xs text-muted-foreground">Linked hotels</dt>
                <dd class="mt-0.5"><%= @attraction.hotels.size %></dd>
              </div>
              <div>
                <dt class="text-xs text-muted-foreground">Source hotel</dt>
                <dd class="mt-0.5">
                  <% if @attraction.source_hotel.present? %>
                    <%= link_to @attraction.source_hotel.name, admin_hotel_path(@attraction.source_hotel), class: "text-foreground underline decoration-border-interactive underline-offset-2 hover:text-primary", data: { turbo_frame: "_top" } %>
                  <% else %>
                    Admin
                  <% end %>
                </dd>
              </div>
              <div>
                <dt class="text-xs text-muted-foreground">Submitted by</dt>
                <dd class="mt-0.5"><%= @attraction.submitted_by&.name || "Unknown" %></dd>
              </div>
              <% if @attraction.review_note.present? %>
                <div class="sm:col-span-2">
                  <dt class="text-xs text-muted-foreground">Review note</dt>
                  <dd class="mt-0.5"><%= @attraction.review_note %></dd>
                </div>
              <% end %>
            </dl>

            <% if @attraction.google_maps_url.present? %>
              <%= render PanelsUI::Button.new(
                    as: :a,
                    href: @attraction.google_maps_url,
                    target: "_blank",
                    rel: "noopener",
                    variant: :secondary,
                    size: :sm) do %>
                <%= app_icon "external-link", class: "size-4", aria: { hidden: true } %>
                Open in Google Maps
              <% end %>
            <% else %>
              <p class="text-sm text-muted-foreground">This legacy attraction does not have a Google Maps URL.</p>
            <% end %>
          </section>

          <section class="space-y-4 border-t border-border pt-5" aria-labelledby="shared-details-heading">
            <div>
              <h3 id="shared-details-heading" class="text-base font-semibold">Shared details</h3>
              <p class="mt-1 text-sm text-muted-foreground">Hotels can add their own guest description after they link this attraction.</p>
            </div>

            <%= form_with model: [ :admin, @attraction ], id: update_form_id, class: "space-y-4" do |form| %>
              <%= render PanelsUI::FormField.new(form:, attribute: :name, label: "Name", required: true) do |field| %>
                <% field.with_input %>
              <% end %>

              <%= render PanelsUI::FormField.new(
                    form:,
                    attribute: :shared_summary,
                    label: "Shared summary",
                    hint: "Hotels use this text when they do not add a hotel-specific description.") do |field| %>
                <% field.with_text_area(rows: 4) %>
              <% end %>

              <%= render PanelsUI::FormField.new(form:, attribute: :address, label: "Address") do |field| %>
                <% field.with_input(autocomplete: "street-address") %>
              <% end %>

              <div class="grid items-start gap-4 sm:grid-cols-2">
                <%= render PanelsUI::FormField.new(form:, attribute: :city, label: "City") do |field| %>
                  <% field.with_input(autocomplete: "address-level2") %>
                <% end %>
                <%= render PanelsUI::FormField.new(form:, attribute: :country, label: "Country") do |field| %>
                  <% field.with_input(autocomplete: "country-name") %>
                <% end %>
              </div>
            <% end %>
          </section>

          <% if @possible_duplicates.any? %>
            <section class="space-y-3 border-t border-border pt-5" aria-labelledby="possible-duplicates-heading">
              <div>
                <h3 id="possible-duplicates-heading" class="text-base font-semibold">Possible duplicates</h3>
                <p class="mt-1 text-sm text-muted-foreground">These records have a matching name or coordinates within approximately one kilometer.</p>
              </div>
              <ul class="divide-y divide-border rounded-md border border-border bg-card">
                <% @possible_duplicates.each do |candidate| %>
                  <li class="flex items-start justify-between gap-3 p-3">
                    <div class="min-w-0">
                      <p class="truncate text-sm font-medium"><%= candidate.name %></p>
                      <p class="mt-0.5 font-mono text-xs text-muted-foreground"><%= attraction_coordinates(candidate) %></p>
                    </div>
                    <%= attraction_status_badge(candidate) %>
                  </li>
                <% end %>
              </ul>
            </section>
          <% end %>

          <% if @merge_targets.any? && !@attraction.status_archived? %>
            <section class="space-y-4 border-t border-border pt-5" aria-labelledby="merge-attraction-heading">
              <div>
                <h3 id="merge-attraction-heading" class="text-base font-semibold">Merge duplicate</h3>
                <p class="mt-1 text-sm text-muted-foreground">Hotel links move to the target. This record becomes archived.</p>
              </div>
              <%= form_with url: merge_admin_attraction_path(@attraction), scope: :merge, method: :patch, class: "space-y-3" do |form| %>
                <%= render PanelsUI::FormField.new(form:, attribute: :target_id, label: "Target attraction", required: true) do |field| %>
                  <% field.with_select_menu(
                       @merge_targets.map { |candidate| { label: "#{candidate.name} (#{candidate.status.titleize})", value: candidate.id } },
                       prompt: "Select the record to keep") %>
                <% end %>
                <%= render PanelsUI::Button.new(
                      as: :button,
                      type: :submit,
                      variant: :destructive,
                      size: :sm,
                      data: { turbo_confirm: "Merge this attraction into the selected record?" }) do %>
                  Merge attraction
                <% end %>
              <% end %>
            </section>
          <% end %>

          <section class="space-y-4 border-t border-border pt-5" aria-labelledby="review-decision-heading">
            <div>
              <h3 id="review-decision-heading" class="text-base font-semibold">Registry status</h3>
              <p class="mt-1 text-sm text-muted-foreground">Approved records appear in suggestions for all hotels.</p>
            </div>

            <div class="flex flex-wrap gap-2">
              <% unless @attraction.status_approved? %>
                <%= form_with url: approve_admin_attraction_path(@attraction), method: :patch, class: "inline-flex" do %>
                  <%= render PanelsUI::Button.new(as: :button, type: :submit, variant: :success, size: :sm) do %>
                    Approve
                  <% end %>
                <% end %>
              <% end %>

              <% if @attraction.status_archived? %>
                <%= form_with url: restore_admin_attraction_path(@attraction), method: :patch, class: "inline-flex" do %>
                  <%= render PanelsUI::Button.new(as: :button, type: :submit, variant: :secondary, size: :sm) do %>
                    Restore
                  <% end %>
                <% end %>
              <% else %>
                <%= form_with url: archive_admin_attraction_path(@attraction), method: :patch,
                      class: "inline-flex", data: { turbo_confirm: "Archive this attraction for all hotels?" } do %>
                  <%= render PanelsUI::Button.new(as: :button, type: :submit, variant: :secondary, size: :sm) do %>
                    Archive
                  <% end %>
                <% end %>
              <% end %>
            </div>

            <% unless @attraction.status_archived? %>
              <%= form_with url: reject_admin_attraction_path(@attraction), scope: :attraction, method: :patch, class: "space-y-3" do |form| %>
                <%= render PanelsUI::FormField.new(
                      form:,
                      attribute: :review_note,
                      label: "Rejection reason",
                      hint: "The submitting hotel can see this reason.",
                      required: true) do |field| %>
                  <% field.with_text_area(rows: 3, value: @attraction.review_note) %>
                <% end %>
                <%= render PanelsUI::Button.new(
                      as: :button,
                      type: :submit,
                      variant: :destructive,
                      size: :sm,
                      data: { turbo_confirm: "Reject this attraction?" }) do %>
                  Reject attraction
                <% end %>
              <% end %>
            <% end %>
          </section>
        </div>
      <% end %>

      <% sheet.with_footer do %>
        <%= render PanelsUI::Button.new(
              as: :button,
              type: :button,
              variant: :secondary,
              size: :sm,
              data: { action: "click->panels-ui--sheet#close" }) do %>
          Close
        <% end %>
        <%= render PanelsUI::Button.new(
              as: :button,
              type: :submit,
              form: update_form_id,
              size: :sm,
              data: { turbo_submits_with: "Saving…" }) do %>
          Save changes
        <% end %>
      <% end %>
    <% end %>
  </div>
<% end %>
