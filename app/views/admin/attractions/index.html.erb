<div class="space-y-4">
  <%= render PanelsUI::PageHeader.new(
        title: "Attraction Registry",
        description: "Review shared attractions and control which places hotels can add.") do |header| %>
    <% header.with_actions do %>
      <%= render PanelsUI::Button.new(
            as: :a,
            href: new_admin_attraction_path,
            data: { turbo_frame: "admin_attraction_action_sheet" }) do %>
        <%= app_icon "plus", class: "size-4", aria: { hidden: true } %>
        Add attraction
      <% end %>
    <% end %>
  <% end %>

  <%= turbo_frame_tag "attractions_list", aria: { live: "polite" } do %>
    <%= render "registry" %>
  <% end %>
</div>

<%= turbo_frame_tag "admin_attraction_action_sheet" %>
