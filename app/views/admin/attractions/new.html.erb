<% frame_id = turbo_frame_request_id.presence || "admin_attraction_action_sheet" %>
<% create_form_id = "create-admin-attraction-form" %>

<%= turbo_frame_tag frame_id do %>
  <div data-controller="panels-ui--sheet-frame">
    <%= render PanelsUI::Sheet.new(
          id: "add-attraction-sheet",
          side: :right,
          size: :lg,
          title: "Add attraction",
          description: "Paste the full Google Maps URL from the browser address bar.") do |sheet| %>
      <% sheet.with_body do %>
        <div class="space-y-6 py-2">
          <% if @attraction&.errors&.any? %>
            <div class="rounded-md border border-destructive/40 bg-destructive/10 px-3 py-2 text-sm text-destructive" role="alert" tabindex="-1">
              <h3 class="font-semibold">The attraction could not be added.</h3>
              <ul class="mt-2 list-disc space-y-1 pl-5">
                <% @attraction.errors.full_messages.each do |message| %>
                  <li><%= message %></li>
                <% end %>
              </ul>
            </div>
          <% end %>

          <%= form_with url: preview_admin_attractions_path, scope: :attraction, method: :post, class: "space-y-4" do |form| %>
            <%= render PanelsUI::FormField.new(
                  form:,
                  attribute: :google_maps_url,
                  label: "Google Maps URL",
                  hint: "Open the attraction in Google Maps and copy the full URL from the browser address bar.",
                  required: true) do |field| %>
              <% field.with_input(
                   type: :url,
                   value: @google_maps_url,
                   autocomplete: "url",
                   aria: { describedby: ("google-maps-url-error" if @parser_error.present?) }) %>
            <% end %>
            <% if @parser_error.present? %>
              <p id="google-maps-url-error" class="text-sm text-destructive" role="alert"><%= @parser_error %></p>
            <% end %>

            <%= render PanelsUI::Button.new(as: :button, type: :submit, variant: :secondary, size: :sm, data: { turbo_submits_with: "Finding…" }) do %>
              <%= app_icon "search", class: "size-4", aria: { hidden: true } %>
              Find attraction
            <% end %>
          <% end %>

          <% if @parsed.present? %>
            <section class="space-y-4 border-t border-border pt-5" aria-labelledby="detected-attraction-heading">
              <div>
                <h3 id="detected-attraction-heading" class="text-base font-semibold">Detected attraction</h3>
                <p class="mt-1 text-sm text-muted-foreground">Examine the detected place before you add it to the registry.</p>
              </div>

              <dl class="grid gap-3 rounded-md border border-border bg-muted/30 p-4 text-sm sm:grid-cols-2">
                <div class="sm:col-span-2">
                  <dt class="text-xs text-muted-foreground">Name</dt>
                  <dd class="mt-0.5 font-medium"><%= @parsed.name %></dd>
                </div>
                <div>
                  <dt class="text-xs text-muted-foreground">Latitude</dt>
                  <dd class="mt-0.5 font-mono text-xs"><%= number_with_precision(@parsed.latitude, precision: 5) %></dd>
                </div>
                <div>
                  <dt class="text-xs text-muted-foreground">Longitude</dt>
                  <dd class="mt-0.5 font-mono text-xs"><%= number_with_precision(@parsed.longitude, precision: 5) %></dd>
                </div>
              </dl>

              <% if @duplicate.present? %>
                <div class="rounded-md border border-warning/40 bg-warning/10 px-3 py-2 text-sm">
                  <p class="font-medium">This attraction already exists.</p>
                  <p class="mt-1 text-muted-foreground"><%= @duplicate.name %> will be approved and reused.</p>
                </div>
              <% end %>

              <%= form_with url: admin_attractions_path, scope: :attraction, id: create_form_id do |form| %>
                <%= form.hidden_field :google_maps_url, value: @google_maps_url %>
              <% end %>
            </section>
          <% end %>
        </div>
      <% end %>

      <% sheet.with_footer do %>
        <%= render PanelsUI::Button.new(
              as: :button,
              type: :button,
              variant: :secondary,
              size: :sm,
              data: { action: "click->panels-ui--sheet#close" }) do %>
          Cancel
        <% end %>
        <% if @parsed.present? %>
          <%= render PanelsUI::Button.new(
                as: :button,
                type: :submit,
                form: create_form_id,
                size: :sm,
                data: { turbo_submits_with: "Adding…" }) do %>
            <%= @duplicate.present? ? "Approve existing" : "Create and approve" %>
          <% end %>
        <% end %>
      <% end %>
    <% end %>
  </div>
<% end %>
