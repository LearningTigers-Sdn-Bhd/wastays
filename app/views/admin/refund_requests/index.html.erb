<% content_for :title, "Refund Requests | WAStays Admin" %>
<div class="w-full space-y-8">
  <%= render PanelsUI::PageHeader.new(
        title: "Refund Requests",
        description: "Review and manage guest refund requests across all properties.") %>

  <div class="grid grid-cols-1 overflow-hidden rounded-2xl border border-border bg-card shadow-sm md:grid-cols-2 xl:grid-cols-5">
    <div class="p-6 md:border-r md:border-border md:p-8">
      <p class="mb-2 text-[11px] font-semibold uppercase tracking-[0.08em] text-muted-foreground">Total Requests</p>
      <h2 class="text-3xl font-bold tabular-nums tracking-tight text-foreground"><%= @total_refunds %></h2>
      <p class="mt-2 text-sm font-medium text-muted-foreground">All refund requests</p>
    </div>
    <div class="bg-muted/30 p-6 md:border-r md:border-border md:p-8">
      <p class="mb-2 text-[11px] font-semibold uppercase tracking-[0.08em] text-muted-foreground">Pending</p>
      <h2 class="text-3xl font-bold tabular-nums tracking-tight text-amber-600"><%= @pending_count %></h2>
      <p class="mt-2 text-sm font-medium text-muted-foreground">Awaiting review</p>
    </div>
    <div class="p-6 md:border-r md:border-border md:p-8">
      <p class="mb-2 text-[11px] font-semibold uppercase tracking-[0.08em] text-muted-foreground">Approved</p>
      <h2 class="text-3xl font-bold tabular-nums tracking-tight text-blue-600"><%= @approved_count %></h2>
      <p class="mt-2 text-sm font-medium text-muted-foreground">Ready to transfer</p>
    </div>
    <div class="bg-muted/30 p-6 xl:border-r xl:border-border md:p-8">
      <p class="mb-2 text-[11px] font-semibold uppercase tracking-[0.08em] text-muted-foreground">Completed</p>
      <h2 class="text-3xl font-bold tabular-nums tracking-tight text-emerald-600"><%= @completed_count %></h2>
      <p class="mt-2 text-sm font-medium text-muted-foreground">Paid to guests</p>
    </div>
    <div class="p-6 md:p-8">
      <p class="mb-2 text-[11px] font-semibold uppercase tracking-[0.08em] text-muted-foreground">Rejected</p>
      <h2 class="text-3xl font-bold tabular-nums tracking-tight text-red-600"><%= @rejected_count %></h2>
      <p class="mt-2 text-sm font-medium text-muted-foreground">Not approved</p>
    </div>
  </div>

  <div class="overflow-hidden rounded-2xl border border-border bg-card shadow-sm">
    <div class="flex items-center justify-between border-b border-border px-6 py-5 sm:px-8">
      <div>
        <h2 class="text-lg font-bold tracking-tight text-foreground sm:text-xl">Refund Registry</h2>
        <p class="mt-1 text-sm font-medium text-muted-foreground">All refund requests across every property.</p>
      </div>
      <span class="text-sm font-medium text-muted-foreground">Total <span class="font-semibold text-foreground"><%= @total_refunds %></span></span>
    </div>

    <% if @refund_requests.any? %>
      <div class="hidden lg:block overflow-x-auto">
        <table class="min-w-full">
          <thead class="bg-muted">
            <tr>
              <th scope="col" class="px-6 py-4 text-left text-[11px] font-semibold uppercase tracking-[0.1em] text-muted-foreground sm:px-8">Booking</th>
              <th scope="col" class="px-6 py-4 text-left text-[11px] font-semibold uppercase tracking-[0.1em] text-muted-foreground">Hotel</th>
              <th scope="col" class="px-6 py-4 text-left text-[11px] font-semibold uppercase tracking-[0.1em] text-muted-foreground">Guest</th>
              <th scope="col" class="px-6 py-4 text-left text-[11px] font-semibold uppercase tracking-[0.1em] text-muted-foreground">Submitted</th>
              <th scope="col" class="px-6 py-4 text-left text-[11px] font-semibold uppercase tracking-[0.1em] text-muted-foreground">Refund Amount</th>
              <th scope="col" class="px-6 py-4 text-left text-[11px] font-semibold uppercase tracking-[0.1em] text-muted-foreground">Status</th>
              <th scope="col" class="px-6 py-4 text-right text-[11px] font-semibold uppercase tracking-[0.1em] text-muted-foreground sm:px-8">Action</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-border bg-card">
            <% @refund_requests.each_with_index do |rr, index| %>
              <% status_classes = case rr.status
                 when "pending" then "text-amber-700"
                 when "approved" then "text-blue-700"
                 when "completed" then "text-emerald-700"
                 when "rejected" then "text-red-700"
                 else "text-muted-foreground"
                 end %>
              <% status_dot_classes = case rr.status
                 when "pending" then "bg-amber-500"
                 when "approved" then "bg-blue-500"
                 when "completed" then "bg-emerald-500"
                 when "rejected" then "bg-red-500"
                 else "bg-muted"
                 end %>
              <tr class="transition-colors hover:bg-muted/80 <%= index.even? ? 'bg-card' : 'bg-muted/55' %>">
                <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-foreground sm:px-8">
                  <%= link_to rr.booking.confirmation_token, admin_refund_request_path(rr), class: "text-blue-700 hover:text-blue-800" %>
                </td>
                <td class="px-6 py-4 whitespace-nowrap text-sm text-foreground"><%= rr.booking.hotel.name %></td>
                <td class="px-6 py-4 whitespace-nowrap text-sm text-foreground"><%= rr.booking.guest_name %></td>
                <td class="px-6 py-4 whitespace-nowrap text-sm text-muted-foreground"><%= rr.created_at.strftime("%d %b %Y") %></td>
                <td class="px-6 py-4 whitespace-nowrap text-sm font-semibold text-foreground"><%= number_to_currency(rr.refund_amount, unit: rr.booking.currency + " ") %></td>
                <td class="px-6 py-4 whitespace-nowrap">
                  <div class="inline-flex items-center gap-2 text-sm font-medium <%= status_classes %>">
                    <span class="size-2.5 rounded-sm <%= status_dot_classes %>"></span>
                    <%= rr.status.humanize %>
                  </div>
                </td>
                <td class="px-6 py-4 text-right sm:px-8">
                  <%= link_to admin_refund_request_path(rr), class: "inline-flex items-center gap-x-1.5 rounded-lg border border-border bg-card px-3 py-1.5 text-xs font-semibold text-foreground shadow-sm transition hover:border-border-interactive hover:bg-muted" do %>
                    <svg class="size-3.5" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.2" stroke="currentColor"><path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z"/><circle cx="12" cy="12" r="3"/></svg>
                    View
                  <% end %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>

      <div class="space-y-4 p-4 sm:p-6 lg:hidden">
        <% @refund_requests.each do |rr| %>
          <% status_classes = case rr.status
             when "pending" then "text-amber-700"
             when "approved" then "text-blue-700"
             when "completed" then "text-emerald-700"
             when "rejected" then "text-red-700"
             else "text-muted-foreground"
             end %>
          <div class="rounded-2xl border border-border bg-muted/60 p-4 shadow-sm">
            <div class="flex items-start justify-between gap-3">
              <%= link_to rr.booking.confirmation_token, admin_refund_request_path(rr), class: "font-mono text-sm font-semibold text-blue-700 hover:text-blue-800" %>
              <span class="text-sm font-medium <%= status_classes %>"><%= rr.status.humanize %></span>
            </div>
            <dl class="mt-3 space-y-2 text-sm">
              <div><dt class="text-xs font-semibold uppercase tracking-[0.08em] text-muted-foreground">Hotel</dt><dd class="mt-1 text-foreground"><%= rr.booking.hotel.name %></dd></div>
              <div><dt class="text-xs font-semibold uppercase tracking-[0.08em] text-muted-foreground">Guest</dt><dd class="mt-1 text-foreground"><%= rr.booking.guest_name %></dd></div>
              <div class="flex justify-between">
                <div><dt class="text-xs font-semibold uppercase tracking-[0.08em] text-muted-foreground">Submitted</dt><dd class="mt-1 text-foreground"><%= rr.created_at.strftime("%d %b %Y") %></dd></div>
                <div class="text-right"><dt class="text-xs font-semibold uppercase tracking-[0.08em] text-muted-foreground">Amount</dt><dd class="mt-1 font-semibold text-foreground"><%= number_to_currency(rr.refund_amount, unit: rr.booking.currency + " ") %></dd></div>
              </div>
            </dl>
          </div>
        <% end %>
      </div>

      <div class="px-6 py-5 border-t border-border bg-muted/50 flex justify-center sm:px-8">
        <%= render PanelsUI::Pagination.new(pagy: @pagy, hide_when_single_page: true) %>
      </div>
    <% else %>
      <div class="px-6 py-12 text-center sm:px-8">
        <p class="text-sm font-medium text-muted-foreground">No refund requests yet.</p>
      </div>
    <% end %>
  </div>
</div>
