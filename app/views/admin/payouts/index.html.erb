<div class="w-full space-y-8">
  <%= render PanelsUI::PageHeader.new(
        title: "Superadmin: Hotel Payouts",
        description: "Review and generate payment batches for hotels.") do |header| %>
    <% header.with_actions do %>
    <div class="inline-flex gap-x-2">
      <%= render PanelsUI::Button.new(as: :a, href: export_payouts_csv_admin_payouts_path, data: { turbo: false }) do %>
        <svg class="size-4" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
        Export Payouts CSV
      <% end %>

      <%= form_with url: mark_as_paid_admin_payouts_path, method: :post, class: "contents" do %>
        <%= render PanelsUI::Button.new(as: :button, type: :submit, variant: :success, data: { turbo_confirm: "Are you sure you want to mark these as paid?" }) do %>
          <svg class="size-4" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
          Mark All as Paid
        <% end %>
      <% end %>
    </div>
    <% end %>
  <% end %>

  <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4 sm:gap-6">
    <div class="flex flex-col bg-card border border-border rounded-xl shadow-sm">
      <div class="p-4 md:p-5">
        <p class="text-xs uppercase tracking-wide text-muted-foreground">Current Batch Payout</p>
        <div class="mt-1 flex items-center gap-x-2">
          <h3 class="text-xl sm:text-2xl font-bold text-foreground">MYR <%= number_with_precision(@eligible_bookings.sum(&:net_amount), precision: 2) %></h3>
        </div>
        <p class="mt-1 text-xs text-muted-foreground">Cut-off: Last Friday</p>
      </div>
    </div>

    <div class="flex flex-col bg-card border border-border rounded-xl shadow-sm">
      <div class="p-4 md:p-5">
        <p class="text-xs uppercase tracking-wide text-muted-foreground">Eligible Hotels</p>
        <div class="mt-1 flex items-center gap-x-2">
          <h3 class="text-xl sm:text-2xl font-bold text-foreground"><%= @payout_summary.count %></h3>
        </div>
      </div>
    </div>
  </div>

  <div class="bg-card border border-border rounded-xl shadow-sm overflow-hidden">
    <div class="px-6 py-4 border-b border-border bg-muted">
      <h2 class="text-lg font-semibold text-foreground">Payment Breakdown per Hotel</h2>
    </div>
    <table class="min-w-full divide-y divide-border">
      <thead class="bg-muted">
        <tr>
          <th class="px-6 py-3 text-start text-xs font-semibold uppercase text-foreground">Hotel</th>
          <th class="px-6 py-3 text-start text-xs font-semibold uppercase text-foreground">Bank Details</th>
          <th class="px-6 py-3 text-center text-xs font-semibold uppercase text-foreground">Bookings</th>
          <th class="px-6 py-3 text-end text-xs font-semibold uppercase text-foreground">Total Net Amount</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-border">
        <% if @payout_summary.any? %>
          <% @payout_summary.each do |summary| %>
            <% banking = summary[:hotel].account.banking_detail %>
            <tr>
              <td class="px-6 py-4 whitespace-nowrap text-sm">
                <div class="font-bold text-foreground"><%= summary[:hotel].name %></div>
                <div class="text-muted-foreground text-xs"><%= summary[:hotel].city %></div>
              </td>
              <td class="px-6 py-4 whitespace-nowrap text-sm">
                <% if banking %>
                  <div class="font-medium text-foreground"><%= banking.account_holder_name %></div>
                  <div class="text-muted-foreground text-xs"><%= banking.bank_name %>: <%= banking.account_number %></div>
                <% else %>
                  <span class="text-red-500 italic">No banking details!</span>
                <% end %>
              </td>
              <td class="px-6 py-4 whitespace-nowrap text-sm text-center font-medium text-foreground"><%= summary[:booking_count] %></td>
              <td class="px-6 py-4 whitespace-nowrap text-sm text-end font-bold text-brand-primary">MYR <%= number_with_precision(summary[:total_net], precision: 2) %></td>
            </tr>
          <% end %>
        <% else %>
          <tr>
            <td colspan="4" class="px-6 py-10 text-center text-sm text-muted-foreground italic">No payouts currently due.</td>
          </tr>
        <% end %>
      </tbody>
    </table>

    <div class="px-6 py-5 border-t border-border bg-muted/50 flex justify-center sm:px-8">
      <%= paginate @payout_summary %>
    </div>
  </div>
</div>
