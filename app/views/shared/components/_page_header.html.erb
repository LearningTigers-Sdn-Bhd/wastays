<%# app/views/shared/components/_page_header.html.erb %>
<%
  title = local_assigns[:title]
  subtitle = local_assigns[:subtitle]
  actions = local_assigns[:actions]
  has_actions = block_given? || actions.present?
%>

<div class="px-4 md:px-0">
  <div class="mt-5 flex flex-col gap-4 lg:flex-row lg:items-end lg:justify-between">
    <div>
      <% if title.present? %>
        <h1 class="text-2xl font-bold tracking-tight text-slate-950 sm:text-3xl">
          <%= title %>
        </h1>
      <% end %>
      <% if subtitle.present? %>
        <p class="mt-1 text-sm font-medium text-slate-600">
          <%= subtitle %>
        </p>
      <% end %>
    </div>

    <% if has_actions %>
      <div class="flex flex-col gap-3 sm:flex-row sm:items-center shrink-0">
        <% if block_given? %>
          <%= yield %>
        <% else %>
          <%= actions %>
        <% end %>
      </div>
    <% end %>
  </div>
</div>
