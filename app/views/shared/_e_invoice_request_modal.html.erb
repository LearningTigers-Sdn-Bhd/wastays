<dialog
  data-e-invoice-request-modal-target="dialog"
  data-action="click->e-invoice-request-modal#closeOnBackdrop"
  class="backdrop:bg-slate-950/50 backdrop:backdrop-blur-[2px] fixed inset-0 m-auto w-full max-w-xl rounded-2xl border border-slate-200 p-0 shadow-2xl">
    <div class="rounded-2xl bg-white">
      <div class="flex items-start justify-between gap-4 border-b border-slate-200 px-6 py-5">
        <div>
          <p class="text-xs font-semibold uppercase tracking-[0.18em] text-slate-500">E-Invoice Request</p>
          <h3 class="mt-1 text-xl font-semibold text-slate-900">Please review your details first</h3>
        </div>
        <button type="button" data-action="e-invoice-request-modal#close" class="inline-flex h-9 w-9 items-center justify-center rounded-full border border-slate-200 text-slate-500 hover:bg-slate-50">
          <span class="sr-only">Close</span>
          <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18 18 6M6 6l12 12"/></svg>
        </button>
      </div>

      <div class="px-6 py-5">
        <div data-e-invoice-request-modal-target="review">
          <p class="text-sm leading-6 text-slate-600">
            We are glad to help with this. Please take a moment to review the details below before we submit your e-invoice request to LHDN. Incorrect or incomplete information may delay validation or stop the e-invoice from being generated.
          </p>

          <div class="mt-5 rounded-2xl border border-amber-200 bg-amber-50 px-4 py-3 text-sm text-amber-900">
            A quick double-check now helps us prepare your e-invoice smoothly and avoid avoidable rejection later.
          </div>

          <dl class="mt-5 grid gap-4 rounded-2xl border border-slate-200 bg-slate-50 p-4 sm:grid-cols-2">
            <div>
              <dt class="text-xs font-semibold uppercase tracking-[0.14em] text-slate-500">Guest Name</dt>
              <dd class="mt-1 text-sm font-medium text-slate-900"><%= booking.guest_name %></dd>
            </div>
            <div>
              <dt class="text-xs font-semibold uppercase tracking-[0.14em] text-slate-500">Email</dt>
              <dd class="mt-1 text-sm font-medium text-slate-900 break-all"><%= booking.guest_email %></dd>
            </div>
            <div>
              <dt class="text-xs font-semibold uppercase tracking-[0.14em] text-slate-500">Phone</dt>
              <dd class="mt-1 text-sm font-medium text-slate-900"><%= booking.guest_phone %></dd>
            </div>
            <div>
              <dt class="text-xs font-semibold uppercase tracking-[0.14em] text-slate-500">Document</dt>
              <dd class="mt-1 text-sm font-medium text-slate-900"><%= [booking.guest_document_type&.upcase, booking.guest_government_id].compact.join(" • ") %></dd>
            </div>
            <div class="sm:col-span-2">
              <dt class="text-xs font-semibold uppercase tracking-[0.14em] text-slate-500">Address</dt>
              <dd class="mt-1 text-sm font-medium text-slate-900"><%= [booking.guest_home_address, booking.guest_city, booking.guest_country].compact.reject(&:blank?).join(", ") %></dd>
            </div>
          </dl>

          <form data-action="submit->e-invoice-request-modal#submit" class="mt-6 flex flex-col gap-3 sm:flex-row sm:justify-end">
            <button type="button" data-action="e-invoice-request-modal#close" class="inline-flex items-center justify-center rounded-xl border border-slate-300 px-4 py-2.5 text-sm font-semibold text-slate-700 hover:bg-slate-50">
              Review Later
            </button>
            <button type="submit" data-e-invoice-request-modal-target="submitButton" class="inline-flex items-center justify-center rounded-xl bg-[#0a2e29] px-4 py-2.5 text-sm font-semibold text-[#d9c5a0] hover:bg-[#0d3d35]">
              Confirm and Request E-Invoice
            </button>
          </form>
        </div>

        <div data-e-invoice-request-modal-target="progress" class="hidden">
          <div class="flex flex-col items-center text-center">
            <div class="mx-auto flex h-14 w-14 items-center justify-center rounded-full bg-blue-50 text-blue-600 shadow-sm">
              <svg class="h-7 w-7 animate-spin" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"></path></svg>
            </div>
            <p class="mt-4 text-[11px] font-semibold uppercase tracking-[0.16em] text-blue-600">Auto-checking status</p>
            <h4 data-e-invoice-request-modal-target="progressLabel" class="mt-2 text-2xl font-semibold tracking-tight text-slate-900">Preparing your e-invoice</h4>
            <p data-e-invoice-request-modal-target="message" class="mt-3 max-w-md text-sm leading-6 text-slate-600">We are preparing your e-invoice now.</p>
            <p data-e-invoice-request-modal-target="progressMeta" class="mt-3 text-xs font-medium text-slate-500">Checking with LHDN now.</p>
          </div>

          <div class="mt-6 rounded-2xl border border-slate-200 bg-slate-50 px-4 py-4">
            <div class="flex items-start gap-3">
              <div class="mt-0.5 flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-white text-slate-500 shadow-sm">
                <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
              </div>
              <div class="text-left">
                <p class="text-sm font-semibold text-slate-900">What happens next</p>
                <p data-e-invoice-request-modal-target="progressHint" class="mt-1 text-sm leading-6 text-slate-600">We will keep checking automatically and show the document here once it is ready.</p>
              </div>
            </div>
          </div>

          <div class="mt-6 flex flex-col gap-3 sm:flex-row sm:justify-end">
            <button type="button" data-action="e-invoice-request-modal#close" class="inline-flex items-center justify-center rounded-xl border border-slate-300 px-4 py-2.5 text-sm font-semibold text-slate-700 hover:bg-slate-50">
              Close for now
            </button>
          </div>
        </div>

        <div data-e-invoice-request-modal-target="ready" class="hidden text-center">
          <div class="mx-auto flex h-12 w-12 items-center justify-center rounded-full bg-emerald-50 text-emerald-600">
            <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m5 13 4 4L19 7"/></svg>
          </div>
          <h4 class="mt-4 text-lg font-semibold text-slate-900">Your e-invoice is ready</h4>
          <p data-e-invoice-request-modal-target="message" class="mt-2 text-sm leading-6 text-slate-600">Your e-invoice is ready.</p>
          <a data-e-invoice-request-modal-target="downloadLink" href="#" target="_blank" rel="noopener" class="mt-6 inline-flex items-center justify-center rounded-xl bg-[#0a2e29] px-4 py-2.5 text-sm font-semibold text-[#d9c5a0] hover:bg-[#0d3d35]">
            View E-Invoice
          </a>
        </div>

        <div data-e-invoice-request-modal-target="failed" class="hidden text-center">
          <div class="mx-auto flex h-12 w-12 items-center justify-center rounded-full bg-red-50 text-red-600">
            <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v4m0 4h.01M4.93 19h14.14c1.54 0 2.5-1.67 1.73-3L13.73 4c-.77-1.33-2.69-1.33-3.46 0L3.2 16c-.77 1.33.19 3 1.73 3Z"/></svg>
          </div>
          <h4 class="mt-4 text-lg font-semibold text-slate-900">We need a little help to finish this</h4>
          <p data-e-invoice-request-modal-target="message" class="mt-2 text-sm leading-6 text-slate-600">We could not generate the e-invoice yet. Our hotel team can help retry it for you.</p>
        </div>
      </div>
    </div>
  </dialog>
