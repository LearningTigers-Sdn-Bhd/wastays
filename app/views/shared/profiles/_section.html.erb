<%# One "My profile" block with its own form and Save. Save stays disabled and %>
<%# Cancel stays hidden until a field in this block changes (form-dirty). %>
<%= form_with model: user,
              url: url,
              method: :patch,
              id: "#{id}-form",
              data: {
                controller: "form-dirty",
                action: "input->form-dirty#refresh change->form-dirty#refresh reset->form-dirty#restore"
              } do |builder| %>
  <%# The block fills 80% of its column on large screens, so the fields and %>
  <%# the Save button end on the same edge. %>
  <section id="<%= id %>" class="space-y-4 lg:w-4/5" aria-labelledby="<%= id %>-heading">
    <div>
      <h2 id="<%= id %>-heading" class="text-base font-semibold"><%= title %></h2>
      <p class="mt-1 text-sm text-muted-foreground"><%= description %></p>
    </div>

    <%= yield builder %>

    <footer class="flex justify-end gap-3">
      <%= render PanelsUI::Button.new(
            as: :button,
            type: :reset,
            variant: :secondary,
            size: :sm,
            hidden: true,
            data: { form_dirty_target: "cancel" }) do %>
        Cancel
      <% end %>
      <%= render PanelsUI::Button.new(
            as: :button,
            type: :submit,
            size: :sm,
            disabled: true,
            data: { form_dirty_target: "submit", turbo_submits_with: "Saving…" }) do %>
        Save
      <% end %>
    </footer>
  </section>
<% end %>
