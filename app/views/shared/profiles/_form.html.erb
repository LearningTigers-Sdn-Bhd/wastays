<%# The "My profile" page for every portal. Details sit on the left and the %>
<%# password on the right; each saves on its own. The agent portal hides the %>
<%# time zone and keeps the email read-only. %>
<% editable_email = local_assigns.fetch(:editable_email, true) %>
<% time_zone = local_assigns.fetch(:time_zone, true) %>

<div class="space-y-8">
  <%= render PanelsUI::PageHeader.new(
        title: "My profile",
        description: "Change your details or your password.") %>

  <% if user.errors.any? %>
    <div class="rounded-md border border-destructive/40 bg-destructive/10 px-3 py-2 text-sm text-destructive" role="alert" tabindex="-1">
      <h2 class="font-semibold"><%= pluralize(user.errors.count, "issue") %> prevented your profile from being saved.</h2>
      <ul class="mt-2 list-disc space-y-1 pl-5">
        <% user.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="grid items-start gap-8 lg:grid-cols-2">
    <%= render layout: "shared/profiles/section",
               locals: { user: user, url: url, id: "profile-details", title: "Details", description: "Your name and how you sign in." } do |builder| %>
      <%= render PanelsUI::FormField.new(form: builder, attribute: :name, label: "Name", required: true) do |field| %>
        <% field.with_input(autocomplete: "name", placeholder: "Your full name") %>
      <% end %>

      <% if editable_email %>
        <%= render PanelsUI::FormField.new(form: builder, attribute: :email, label: "Email", hint: "You sign in with this email.", required: true) do |field| %>
          <% field.with_input(type: :email, autocomplete: "email", placeholder: "name@example.com") %>
        <% end %>
      <% else %>
        <%= render PanelsUI::FormField.new(form: builder, attribute: :email, label: "Email", hint: "You sign in with this email. Ask a superadmin to change it.") do |field| %>
          <% field.with_input(type: :email, readonly: true) %>
        <% end %>
      <% end %>

      <% if time_zone %>
        <%= render PanelsUI::FormField.new(form: builder, attribute: :time_zone, label: "Time zone", hint: "The default is #{User::DEFAULT_TIME_ZONE} (UTC+8).") do |field| %>
          <% field.with_combobox(
               ActiveSupport::TimeZone.all.map { |zone| [ zone.to_s, zone.name ] },
               prompt: "Search and select a time zone",
               selected: user.time_zone.presence || User::DEFAULT_TIME_ZONE,
               max_options: 50,
               empty_text: "No time zones found") %>
        <% end %>
      <% end %>
    <% end %>

    <%= render layout: "shared/profiles/section",
               locals: { user: user, url: url, id: "profile-password", title: "Change password", description: "Type your current password, then the new password twice." } do |builder| %>
      <%= render PanelsUI::FormField.new(form: builder, attribute: :current_password, label: "Current password") do |field| %>
        <% field.with_input(type: :password, autocomplete: "current-password", value: "", placeholder: "Your current password") %>
      <% end %>

      <%= render PanelsUI::FormField.new(form: builder, attribute: :password, label: "New password") do |field| %>
        <% field.with_input(type: :password, autocomplete: "new-password", value: "", placeholder: "Your new password") %>
      <% end %>

      <%= render PanelsUI::FormField.new(form: builder, attribute: :password_confirmation, label: "Confirm new password") do |field| %>
        <% field.with_input(type: :password, autocomplete: "new-password", value: "", placeholder: "Type the new password again") %>
      <% end %>
    <% end %>
  </div>
</div>
