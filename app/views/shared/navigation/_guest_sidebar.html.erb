<%= render PanelsUI::Sidebar.new(
      key: "guest",
      home_path: guest_dashboard_path,
      sections: guest_sidebar_sections,
      footer_items: guest_sidebar_footer_items,
      collapsible: true,
      searchable: false,
      permanent: true
    ) do |sidebar| %>
  <% sidebar.with_header do %>
    <div class="w-full space-y-0.5 px-2 py-1">
      <%= render PanelsUI::Tooltip.new(text: current_guest.name, placement: :top, root_class: "w-full") do %>
        <a href="<%= guest_dashboard_path %>" class="panel-sidebar__link" aria-label="Guest: <%= current_guest.name %>">
          <%= cached_icon "user", class: "panel-sidebar__icon" %>
          <span class="panel-sidebar__label truncate text-xs"><%= current_guest.name.truncate(24) %></span>
        </a>
      <% end %>
    </div>
  <% end %>
<% end %>
