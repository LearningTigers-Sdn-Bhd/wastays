<%= render PanelsUI::Sidebar.new(
      key: "guest",
      home_path: guest_dashboard_path,
      sections: guest_sidebar_sections,
      footer_items: guest_sidebar_footer_items,
      collapsible: true,
      searchable: false,
      permanent: true
    ) do |sidebar| %>
  <% sidebar.with_header do %>
    <%= render PanelsUI::Tooltip.new(text: current_guest.name, placement: :top, root_class: "w-full") do %>
      <div class="flex items-center gap-x-2.5 px-4 py-1" aria-label="Guest: <%= current_guest.name %>">
        <span class="inline-flex size-7 shrink-0 items-center justify-center rounded-lg bg-brand-primary/10 text-brand-primary shadow-xs ring-1 ring-brand-primary/20">
          <%= cached_icon "user", class: "size-4 shrink-0" %>
        </span>
        <span class="panel-sidebar__label truncate text-sm font-semibold text-foreground"><%= current_guest.name.truncate(24) %></span>
      </div>
    <% end %>
  <% end %>
<% end %>
