<% hotel_sidebar_footer_items = [
  { label: "Homepage", path: root_path, search_text: "Homepage Website", icon: '<path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/>' },
  { label: "Help & support", path: help_center_path, search_text: "Help Support", icon: '<circle cx="12" cy="12" r="10"/><path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"/><line x1="12" y1="17" x2="12.01" y2="17"/>' }
] %>
<% render_hotel_sidebar_nav = lambda do %>
  <nav class="flex-1 px-4 py-3 space-y-6">
    <% hotel_sidebar_sections.each do |section| %>
      <% visible_items = section[:items].select do |item| %>
        <% permissions = Array(item[:permission]).compact %>
        <% hotel_permissions_only = item[:permission_scope] == :hotel %>
        <% permissions.blank? || permissions.any? { |permission| hotel_permissions_only ? current_user.has_permission?(permission, hotel: current_hotel) : current_user.has_permission?(permission, hotel: current_hotel) || current_user.has_permission?(permission) } %>
      <% end %>
      <% next if visible_items.blank? %>

      <div class="sidebar-nav-group">
        <span class="sidebar-section-label"><%= section[:label] %></span>
        <div class="space-y-0.5">
          <% visible_items.each do |item| %>
            <% if item[:children].present? %>
              <details class="group" <%= "open" if item[:active] %>>
                <summary class="sidebar-nav-link list-none cursor-pointer <%= item[:active] ? 'sidebar-nav-link-active' : 'sidebar-nav-link-default' %>">
                  <svg class="size-4 shrink-0" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><%= item[:icon].html_safe %></svg>
                  <span class="flex-1"><%= item[:label] %></span>
                  <svg class="size-4 shrink-0 transition-transform group-open:rotate-180" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <path d="m6 9 6 6 6-6"/>
                  </svg>
                </summary>
                <div class="ms-6 mt-1 space-y-0.5 border-s border-slate-200 ps-3">
                  <% item[:children].each do |child| %>
                    <a class="sidebar-nav-link <%= child[:active] ? 'sidebar-nav-link-active' : 'sidebar-nav-link-default' %>" href="<%= child[:path] %>">
                      <span class="text-sm"><%= child[:label] %></span>
                    </a>
                  <% end %>
                </div>
              </details>
            <% else %>
              <a class="sidebar-nav-link <%= item[:active] ? 'sidebar-nav-link-active' : 'sidebar-nav-link-default' %>" href="<%= item[:path] %>">
                <svg class="size-4 shrink-0" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><%= item[:icon].html_safe %></svg>
                <span><%= item[:label] %></span>
              </a>
            <% end %>
          <% end %>
        </div>
      </div>
    <% end %>
  </nav>
<% end %>

<% hotel_nav_html = capture(&render_hotel_sidebar_nav) %>
<% hotel_footer_html = capture do %>
  <% hotel_sidebar_footer_items.each do |item| %>
    <a class="sidebar-nav-link sidebar-nav-link-default" href="<%= item[:path] %>">
      <svg class="size-4 shrink-0" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><%= item[:icon].html_safe %></svg>
      <span><%= item[:label] %></span>
    </a>
  <% end %>
<% end %>

<%= render "shared/navigation/sidebar_shell",
           sidebar_key: "hotel",
           home_path: hotel_dashboard_path(current_hotel),
           nav_html: hotel_nav_html,
           footer_html: hotel_footer_html %>

<script>
  (() => {
    const ACTIVE = "sidebar-nav-link-active";
    const INACTIVE = "sidebar-nav-link-default";
    const DESKTOP_SCROLL_KEY = "hotelSidebarDesktopScrollTop";
    const MOBILE_SCROLL_KEY = "hotelSidebarMobileScrollTop";

    const normalize = (path) => {
      if (!path) return "/";
      return path.endsWith("/") && path.length > 1 ? path.slice(0, -1) : path;
    };

    const syncHotelSidebar = () => {
      const sidebar = document.getElementById("hotel-sidebar");
      if (!sidebar) return;

      const currentPath = normalize(window.location.pathname);
      const links = sidebar.querySelectorAll("a.sidebar-nav-link[href]");

      links.forEach((link) => {
        let linkPath;
        try {
          linkPath = normalize(new URL(link.href, window.location.origin).pathname);
        } catch (_) {
          linkPath = null;
        }
        if (!linkPath) return;

        const active = currentPath === linkPath;
        link.classList.toggle(ACTIVE, active);
        link.classList.toggle(INACTIVE, !active);
      });

      sidebar.querySelectorAll("details.group").forEach((details) => {
        const hasActiveChild = details.querySelector(".sidebar-nav-link." + ACTIVE);
        if (hasActiveChild) details.setAttribute("open", "open");
      });
    };

    const persistSidebarScroll = () => {
      const desktop = document.getElementById("hotel-sidebar");
      const mobile = document.getElementById("hotel-sidebar-mobile");
      if (desktop) sessionStorage.setItem(DESKTOP_SCROLL_KEY, String(desktop.scrollTop || 0));
      if (mobile) sessionStorage.setItem(MOBILE_SCROLL_KEY, String(mobile.scrollTop || 0));
    };

    const restoreSidebarScroll = () => {
      const desktop = document.getElementById("hotel-sidebar");
      const mobile = document.getElementById("hotel-sidebar-mobile");

      if (desktop) {
        const savedDesktop = Number(sessionStorage.getItem(DESKTOP_SCROLL_KEY) || 0);
        desktop.scrollTop = Number.isFinite(savedDesktop) ? savedDesktop : 0;
      }

      if (mobile) {
        const savedMobile = Number(sessionStorage.getItem(MOBILE_SCROLL_KEY) || 0);
        mobile.scrollTop = Number.isFinite(savedMobile) ? savedMobile : 0;
      }
    };

    document.addEventListener("turbo:before-visit", persistSidebarScroll);
    document.addEventListener("turbo:load", () => {
      syncHotelSidebar();
      restoreSidebarScroll();
    });
    document.addEventListener("DOMContentLoaded", () => {
      syncHotelSidebar();
      restoreSidebarScroll();
    });
  })();
</script>
