<%= render PanelsUI::Sidebar.new(
      key: "hotel",
      home_path: hotel_dashboard_path(current_hotel),
      sections: hotel_visible_sidebar_sections,
      footer_items: hotel_sidebar_footer_items,
      mode: hotel_sidebar_mode,
      collapsible: true,
      searchable: false,
      permanent: true
    ) do |sidebar| %>
  <% sidebar.with_header do %>
    <div class="space-y-0.5 p-2">
      <%= render PanelsUI::Tooltip.new(text: current_hotel.name, placement: :top, root_class: "w-full") do %>
        <a href="<%= hotel_dashboard_path(current_hotel) %>" class="panel-sidebar__link" aria-label="Hotel: <%= current_hotel.name %>">
          <%= cached_icon "building-2", class: "panel-sidebar__icon" %>
          <span class="panel-sidebar__label truncate"><%= current_hotel.name.truncate(24) %></span>
        </a>
      <% end %>
      <% if current_user.superadmin? %>
        <%= render PanelsUI::Tooltip.new(text: "Go to Admin Panel", placement: :right, root_class: "w-full") do %>
          <a href="<%= admin_dashboard_path %>" target="_blank" rel="noopener noreferrer" class="panel-sidebar__link" aria-label="Go to Admin Panel">
            <%= cached_icon "external-link", class: "panel-sidebar__icon" %>
            <span class="panel-sidebar__label">Go to Admin Panel</span>
          </a>
        <% end %>
      <% end %>
      <% if settings_sidebar_mode? %>
        <%= render PanelsUI::Tooltip.new(text: "Back to previous page", placement: :right, root_class: "w-full") do %>
          <a href="<%= hotel_settings_back_path %>" class="panel-sidebar__link" aria-label="Back to previous page">
            <%= cached_icon "arrow-left", class: "panel-sidebar__icon" %>
            <span class="panel-sidebar__label">Back to previous page</span>
          </a>
        <% end %>
      <% end %>
    </div>
  <% end %>
<% end %>
