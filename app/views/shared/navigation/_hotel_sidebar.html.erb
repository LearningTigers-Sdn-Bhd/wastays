<% hotel_sidebar_footer_items = [
  { label: "Homepage", path: root_path, search_text: "Homepage Website", icon: '<path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/>' },
  { label: "Help & support", path: help_center_path, search_text: "Help Support", icon: '<circle cx="12" cy="12" r="10"/><path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"/><line x1="12" y1="17" x2="12.01" y2="17"/>' }
] %>
<% render_hotel_sidebar_nav = lambda do %>
  <nav class="flex-1 px-4 py-3 space-y-6">
    <% hotel_sidebar_sections.each do |section| %>
      <div class="sidebar-nav-group">
        <span class="sidebar-section-label"><%= section[:label] %></span>
        <div class="space-y-0.5">
          <% section[:items].each do |item| %>
            <a class="sidebar-nav-link <%= item[:active] ? 'sidebar-nav-link-active' : 'sidebar-nav-link-default' %>" href="<%= item[:path] %>">
              <svg class="size-4 shrink-0" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><%= item[:icon].html_safe %></svg>
              <span><%= item[:label] %></span>
            </a>
          <% end %>
        </div>
      </div>
    <% end %>
  </nav>
<% end %>

<% hotel_nav_html = capture(&render_hotel_sidebar_nav) %>
<% hotel_footer_html = capture do %>
  <% hotel_sidebar_footer_items.each do |item| %>
    <a class="sidebar-nav-link sidebar-nav-link-default" href="<%= item[:path] %>">
      <svg class="size-4 shrink-0" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><%= item[:icon].html_safe %></svg>
      <span><%= item[:label] %></span>
    </a>
  <% end %>
<% end %>

<%= render "shared/navigation/sidebar_shell",
           sidebar_key: "hotel",
           home_path: hotel_dashboard_path(current_hotel),
           nav_html: hotel_nav_html,
           footer_html: hotel_footer_html %>
