<% sections = hotel_sidebar_sections %>
<% footer_items = hotel_sidebar_footer_items %>

<% hotel_sidebar_header = capture do %>
  <div class="flex flex-col gap-y-2 px-4 py-3 min-h-12">
    <div class="flex items-center gap-x-2.5 min-w-0" title="<%= current_hotel.name %>" aria-label="Hotel: <%= current_hotel.name %>">
      <span class="inline-flex justify-center items-center size-7 rounded-lg bg-slate-100 text-slate-700 shadow-xs ring-1 ring-slate-200 shrink-0">
        <%= cached_icon "building-2", class: "size-4 shrink-0" %>
      </span>
      <span class="text-sm font-semibold text-neutral-text-primary truncate"><%= current_hotel.name.truncate(24) %></span>
    </div>
    <% if current_user.admin_panel_user? %>
      <a href="<%= admin_dashboard_path %>" target="_blank" rel="noopener noreferrer" class="sidebar-nav-link sidebar-nav-link-default">
        <%= cached_icon "external-link", class: "size-4 shrink-0" %>
        <span>Go to Admin Panel</span>
      </a>
    <% end %>
  </div>
<% end %>

<% render_hotel_sidebar_nav = lambda do %>
  <nav class="flex-1 px-4 py-3 space-y-6">
    <% sections.each do |section| %>
      <% visible_items = hotel_visible_items(section.items) %>
      <% next if visible_items.blank? %>

      <div class="sidebar-nav-group">
        <span class="sidebar-section-label"><%= section.label %></span>
        <div class="space-y-0.5">
          <% visible_items.each do |item| %>
            <% if item.children.present? %>
              <% visible_children = hotel_visible_items(item.children) %>
              <% next if visible_children.blank? %>
              <details class="group" <%= "open" if item.active %>>
                <summary class="sidebar-nav-link list-none cursor-pointer <%= item.active ? 'sidebar-nav-link-active' : 'sidebar-nav-link-default' %>">
                  <%= cached_icon item.icon, class: "size-4 shrink-0" %>
                  <span class="flex-1"><%= item.label %></span>
                  <%= cached_icon "chevron-down", class: "size-4 shrink-0 transition-transform group-open:rotate-180" %>
                </summary>
                <div class="ms-6 mt-1 space-y-0.5 border-s border-slate-200 ps-3">
                  <% visible_children.each do |child| %>
                    <a class="sidebar-nav-link <%= child.active ? 'sidebar-nav-link-active' : 'sidebar-nav-link-default' %>" href="<%= child.path %>">
                      <span class="text-sm"><%= child.label %></span>
                    </a>
                  <% end %>
                </div>
              </details>
            <% else %>
              <a class="sidebar-nav-link <%= item.active ? 'sidebar-nav-link-active' : 'sidebar-nav-link-default' %>" href="<%= item.path %>">
                <%= cached_icon item.icon, class: "size-4 shrink-0" %>
                <span><%= item.label %></span>
              </a>
            <% end %>
          <% end %>
        </div>
      </div>
    <% end %>
  </nav>
<% end %>

<% hotel_nav_html = capture(&render_hotel_sidebar_nav) %>
<% hotel_footer_html = capture do %>
  <% footer_items.each do |item| %>
    <a class="sidebar-nav-link sidebar-nav-link-default" href="<%= item.path %>">
      <%= cached_icon item.icon, class: "size-4 shrink-0" %>
      <span><%= item.label %></span>
    </a>
  <% end %>
<% end %>

<%= render "shared/navigation/sidebar_shell",
           sidebar_key: "hotel",
           home_path: hotel_dashboard_path(current_hotel),
           header_html: hotel_sidebar_header,
           nav_html: hotel_nav_html,
           footer_html: hotel_footer_html %>
