<div class="relative inline-flex" data-controller="dropdown">
  <button type="button" class="p-0.5 inline-flex items-center gap-x-2 rounded-full hover:bg-muted transition-colors" data-action="click->dropdown#toggle" aria-label="Open corporate profile menu">
    <span class="inline-flex shrink-0 justify-center items-center size-8 rounded-full bg-brand-primary/10 border border-brand-primary/20">
      <%= cached_icon "building-2", class: "size-4 text-brand-primary" %>
    </span>
  </button>

  <div class="absolute right-0 top-full mt-2 w-[260px] bg-card shadow-dropdown rounded-xl hidden z-[100] border border-border" data-dropdown-target="menu">
    <div class="py-3 px-4 border-b border-border">
      <div class="flex items-center gap-x-3">
        <span class="inline-flex shrink-0 justify-center items-center size-10 rounded-full bg-brand-primary/10 border border-brand-primary/20">
          <%= cached_icon "building-2", class: "size-5 text-brand-primary" %>
        </span>
        <div class="grow min-w-0">
          <p class="text-sm font-semibold text-foreground truncate"><%= current_user.account.name %></p>
          <p class="text-xs text-muted-foreground truncate"><%= current_user.email %></p>
        </div>
      </div>
    </div>

    <div class="p-1.5">
      <%= button_to logout_path, method: :delete, class: "flex items-center gap-x-3 w-full py-2 px-3 rounded-lg text-sm text-foreground hover:bg-muted transition-colors text-left" do %>
        <%= cached_icon "log-out", class: "shrink-0 size-4 text-muted-foreground" %>
        Sign out
      <% end %>
    </div>
  </div>
</div>
