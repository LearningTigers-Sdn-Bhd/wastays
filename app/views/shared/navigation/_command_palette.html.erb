<div data-controller="command-palette" data-command-palette-endpoint-value="<%= endpoint %>">
  <button type="button"
          class="inline-flex sm:hidden items-center justify-center size-9 rounded-lg border border-layer-line bg-layer text-neutral-text-primary hover:bg-surface-hover transition-colors"
          data-action="click->command-palette#open"
          aria-label="Open global search">
    <%= cached_icon "search", class: "size-4 text-muted-foreground" %>
  </button>

  <button type="button"
          class="hidden sm:inline-flex items-center justify-between gap-x-2 w-[260px] md:w-[320px] lg:w-[420px] rounded-xl border border-layer-line bg-layer-alt/80 px-3.5 py-2 text-sm text-neutral-text-primary shadow-xs hover:bg-surface-hover transition-colors"
          data-action="click->command-palette#open"
          aria-label="Open global search">
    <span class="inline-flex items-center gap-x-2.5 min-w-0">
      <%= cached_icon "search", class: "size-4 text-muted-foreground" %>
      <span class="truncate text-muted-foreground"><%= local_assigns[:placeholder] || "Search pages and records..." %></span>
    </span>
    <span class="rounded-md border border-layer-line bg-layer px-1.5 py-0.5 text-[11px] text-muted-foreground" data-command-palette-target="shortcut">⌘K</span>
  </button>

  <div class="hidden fixed inset-0 z-[120] bg-slate-900/40 backdrop-blur-sm p-4 sm:p-6"
       data-command-palette-target="overlay"
       data-action="click->command-palette#closeOnBackdrop">
    <div class="mx-auto mt-8 w-full max-w-3xl rounded-2xl border border-layer-line bg-layer shadow-dropdown">
      <div class="border-b border-layer-line p-3 sm:p-4">
        <input type="text"
               placeholder="<%= local_assigns[:placeholder] || 'Search pages and records...' %>"
               autocomplete="off"
               class="w-full rounded-lg border border-layer-line bg-layer-alt px-3 py-2.5 text-sm text-neutral-text-primary placeholder:text-muted-foreground-2 focus:border-slate-300 focus:outline-none focus:ring-0"
               data-command-palette-target="input"
               data-action="input->command-palette#search keydown->command-palette#navigateResults">
      </div>

      <div class="max-h-[60vh] overflow-y-auto p-2 sm:p-3">
        <div class="hidden rounded-lg border border-dashed border-layer-line bg-layer-alt px-4 py-5 text-sm text-muted-foreground-2"
             data-command-palette-target="empty">
          No matches found.
        </div>
        <div class="space-y-1" data-command-palette-target="results"></div>
      </div>
    </div>
  </div>
</div>
