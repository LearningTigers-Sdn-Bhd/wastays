<%# Sidebar header shared by every portal: the portal's own name and its mark.
    It stays an anchor because the settings sidebar has no other route back to
    the dashboard — the label reads as chrome but earns its keep as a link.
    The label hides at 48px like every other sidebar label; the icon is what
    still identifies the portal once the rail is collapsed. %>
<div class="w-full space-y-0.5 px-2 py-1">
  <a href="<%= href %>" class="panel-sidebar__link" aria-label="<%= label %>">
    <%= cached_icon icon, class: "panel-sidebar__icon" %>
    <span class="panel-sidebar__label truncate text-xs font-semibold"><%= label %></span>
  </a>
</div>
