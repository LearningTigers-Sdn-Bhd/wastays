<%# Navbar notification bell. There is no per-user notification feed in the
    schema yet — notification_deliveries is guest-facing booking messaging, keyed
    by hotel and booking — so the panel renders its empty state and nothing
    else. The shell is here so the feed has somewhere to land.

    Tooltip wraps Popover rather than the other way round: the popover
    announces itself on the shared `panels-ui:layer-open` channel when it opens,
    which is exactly what makes the tooltip dismiss itself. %>
<%= render PanelsUI::Tooltip.new(text: "Notifications", placement: :bottom) do %>
  <%= render PanelsUI::Popover.new(
        id: "notifications",
        placement: :bottom_end,
        offset: 8,
        class: "w-72"
      ) do |popover| %>
    <% popover.with_trigger(
         unstyled: true,
         aria_label: "Notifications",
         class: "panel-navbar__action panel-navbar__action--icon"
       ) do %>
      <%= cached_icon "bell", class: "size-4" %>
    <% end %>

    <div class="text-left">
      <p class="text-sm font-semibold text-foreground">Notifications</p>
      <p class="mt-2 text-xs text-muted-foreground">You have no notifications right now.</p>
    </div>
  <% end %>
<% end %>
