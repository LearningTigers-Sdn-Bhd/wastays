<!-- Preline CMS-style Hotel Profile Dropdown -->
<div class="relative inline-flex" data-controller="dropdown">
  <button id="hotel-profile-toggle" type="button" class="p-0.5 inline-flex items-center gap-x-2 rounded-full hover:bg-surface-hover transition-colors" data-action="click->dropdown#toggle">
    <span class="inline-flex shrink-0 justify-center items-center size-8 rounded-full bg-brand-primary/10 border border-brand-primary/20">
      <svg class="size-4 text-brand-primary" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
    </span>
  </button>

  <div class="absolute right-0 top-full mt-2 w-[280px] bg-layer shadow-dropdown rounded-xl hidden z-[100] border border-layer-line" data-dropdown-target="menu">

    <!-- User Info -->
    <div class="py-3 px-4 border-b border-layer-line">
      <div class="flex items-center gap-x-3">
        <span class="inline-flex shrink-0 justify-center items-center size-10 rounded-full bg-brand-primary/10 border border-brand-primary/20">
          <svg class="size-5 text-brand-primary" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
        </span>
        <div class="grow min-w-0">
          <p class="text-sm font-semibold text-neutral-text-primary truncate"><%= current_user.name || "Hotel Admin" %></p>
          <p class="text-xs text-muted-foreground truncate"><%= current_user.email %></p>
        </div>
      </div>
    </div>

    <div class="p-1.5 space-y-0.5">
      <!-- Account links -->
      <a class="flex items-center gap-x-3 py-2 px-3 rounded-lg text-sm text-neutral-text-primary hover:bg-surface-hover focus:outline-none transition-colors" href="<%= edit_hotel_user_profile_path(current_hotel) %>">
        <svg class="shrink-0 size-4 text-muted-foreground" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
        My account
      </a>
      <a class="flex items-center gap-x-3 py-2 px-3 rounded-lg text-sm text-neutral-text-primary hover:bg-surface-hover focus:outline-none transition-colors" href="<%= edit_hotel_user_profile_path(current_hotel) %>">
        <svg class="shrink-0 size-4 text-muted-foreground" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12.22 2h-.44a2 2 0 0 0-2 2v.18a2 2 0 0 1-1 1.73l-.43.25a2 2 0 0 1-2 0l-.15-.08a2 2 0 0 0-2.73.73l-.22.38a2 2 0 0 0 .73 2.73l.15.1a2 2 0 0 1 1 1.72v.51a2 2 0 0 1-1 1.74l-.15.09a2 2 0 0 0-.73 2.73l.22.38a2 2 0 0 0 2.73.73l.15-.08a2 2 0 0 1 2 0l.43.25a2 2 0 0 1 1 1.73V20a2 2 0 0 0 2 2h.44a2 2 0 0 0 2-2v-.18a2 2 0 0 1 1-1.73l.43-.25a2 2 0 0 1 2 0l.15.08a2 2 0 0 0 2.73-.73l.22-.39a2 2 0 0 0-.73-2.73l-.15-.08a2 2 0 0 1-1-1.74v-.5a2 2 0 0 1 1-1.74l.15-.09a2 2 0 0 0 .73-2.73l-.22-.38a2 2 0 0 0-2.73-.73l-.15.08a2 2 0 0 1-2 0l-.43-.25a2 2 0 0 1-1-1.73V4a2 2 0 0 0-2-2z"/><circle cx="12" cy="12" r="3"/></svg>
        Settings
      </a>

      <!-- Theme Switcher -->
      <div class="py-2 border-t border-layer-line mt-1">
        <div class="flex items-center justify-between py-2 px-3 rounded-lg text-sm text-neutral-text-primary">
          <span class="flex items-center gap-x-3">
            <svg class="shrink-0 size-4 text-muted-foreground" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"/></svg>
            Dark mode
          </span>
          <div class="relative inline-block w-8 h-4">
            <input type="checkbox" id="hotel-dark-mode-toggle" class="peer appearance-none w-8 h-4 bg-gray-200 rounded-full cursor-pointer checked:bg-brand-primary transition-colors duration-200">
            <span class="absolute top-0.5 start-0.5 w-3 h-3 bg-white rounded-full transition-all duration-200 peer-checked:start-4.5"></span>
          </div>
        </div>
      </div>

      <!-- Sign out -->
      <div class="py-1 border-t border-layer-line">
        <%= button_to logout_path, method: :delete, class: "flex items-center gap-x-3 w-full py-2 px-3 rounded-lg text-sm text-neutral-text-primary hover:bg-surface-hover transition-colors text-left" do %>
          <svg class="shrink-0 size-4 text-muted-foreground" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
          Sign out
        <% end %>
      </div>
    </div>
  </div>
</div>
