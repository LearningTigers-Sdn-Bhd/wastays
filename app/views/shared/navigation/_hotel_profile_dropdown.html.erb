<!-- Preline CMS-style Hotel Profile Dropdown -->
<div class="relative inline-flex" data-controller="dropdown">
  <button id="hotel-profile-toggle" type="button" aria-label="Open profile menu" aria-haspopup="menu" aria-expanded="false" aria-controls="hotel-profile-menu-actions" class="p-0.5 inline-flex items-center gap-x-2 rounded-full hover:bg-muted transition-colors" data-action="click->dropdown#toggle keydown->dropdown#handleKeydown">
    <span class="inline-flex shrink-0 justify-center items-center size-8 rounded-full bg-brand-primary/10 border border-brand-primary/20">
      <%= cached_icon "user", class: "size-4 text-brand-primary" %>
    </span>
  </button>

  <div id="hotel-profile-menu" class="absolute right-0 top-full mt-2 w-[280px] bg-card shadow-dropdown rounded-xl hidden z-[100] border border-border" data-dropdown-target="menu">

    <!-- User Info -->
    <div class="py-3 px-4 border-b border-border">
      <div class="flex items-center gap-x-3">
        <span class="inline-flex shrink-0 justify-center items-center size-10 rounded-full bg-brand-primary/10 border border-brand-primary/20">
          <%= cached_icon "user", class: "size-5 text-brand-primary" %>
        </span>
        <div class="grow min-w-0">
          <p class="text-sm font-semibold text-foreground truncate"><%= current_user.name || "Hotel Admin" %></p>
          <p class="text-xs text-muted-foreground truncate"><%= current_user.email %></p>
        </div>
      </div>
    </div>

    <div id="hotel-profile-menu-actions" role="menu" class="p-1.5 space-y-0.5" data-action="keydown->dropdown#handleMenuKeydown">
      <!-- Account links -->
      <a role="menuitem" class="flex items-center gap-x-3 py-2 px-3 rounded-lg text-sm text-foreground hover:bg-muted focus:outline-none transition-colors" href="<%= edit_hotel_user_profile_path(current_hotel) %>">
        <%= cached_icon "user", class: "shrink-0 size-4 text-muted-foreground" %>
        My account
      </a>
      <% if current_user.has_permission?("manage_hotel_profile", hotel: current_hotel) || current_user.has_permission?("manage_account") %>
        <a role="menuitem" class="flex items-center gap-x-3 py-2 px-3 rounded-lg text-sm text-foreground hover:bg-muted focus:outline-none transition-colors" href="<%= hotel_general_settings_path(current_hotel) %>">
          <%= cached_icon "settings", class: "shrink-0 size-4 text-muted-foreground" %>
          Settings
        </a>
      <% end %>

      <!-- Sign out -->
      <div role="none" class="py-1 border-t border-border">
        <%= button_to logout_path, method: :delete, class: "flex items-center gap-x-3 w-full py-2 px-3 rounded-lg text-sm text-foreground hover:bg-muted transition-colors text-left", form: { role: "none" }, role: "menuitem" do %>
          <%= cached_icon "log-out", class: "shrink-0 size-4 text-muted-foreground" %>
          Sign out
        <% end %>
      </div>
    </div>
  </div>
</div>
