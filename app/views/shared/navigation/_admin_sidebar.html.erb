<% dashboard_active = controller_name == 'dashboard' && action_name != 'analytics' %>
<% analytics_active = controller_name == 'dashboard' && action_name == 'analytics' %>
<% hotels_active = controller_name == 'hotels' %>
<% bookings_active = controller_name == 'bookings' %>
<% margin_rules_active = controller_name == 'margin_rules' %>
<% reconciliations_active = controller_name == 'reconciliations' %>
<% audit_logs_active = controller_name == 'audit_logs' %>
<% api_keys_active = controller_name == 'api_keys' && action_name != 'docs' %>
<% api_docs_active = controller_name == 'api_keys' && action_name == 'docs' %>
<% admin_sidebar_sections = [
  {
    label: 'Home',
    items: [
      { label: 'Dashboard', path: admin_dashboard_path, search_text: 'Dashboard', active: dashboard_active, icon: '<path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/>' },
      { label: 'Analytics', path: admin_analytics_path, search_text: 'Analytics Revenue Margin Reports', active: analytics_active, icon: '<path d="M3 3v18h18"/><path d="m19 9-5 5-4-4-3 3"/>' }
    ]
  },
  {
    label: 'Operations',
    items: [
      { label: 'Hotels', path: admin_hotels_path, search_text: 'Hotels Manage Hotels', active: hotels_active, icon: '<path d="M6 22V4a2 2 0 0 1 2-2h8a2 2 0 0 1 2 2v18Z"/><path d="M6 12H4a2 2 0 0 0-2 2v6a2 2 0 0 0 2 2h2"/><path d="M18 9h2a2 2 0 0 1 2 2v9a2 2 0 0 1-2 2h-2"/><path d="M10 6h4"/><path d="M10 10h4"/><path d="M10 14h4"/><path d="M10 18h4"/>' },
      { label: 'Bookings', path: admin_bookings_path, search_text: 'Bookings Platform Bookings', active: bookings_active, icon: '<rect width="18" height="18" x="3" y="4" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/>' }
    ]
  },
  {
    label: 'Finance',
    items: [
      { label: 'Margin Settings', path: admin_margin_rules_path, search_text: 'Margin Settings Margin Rules', active: margin_rules_active, icon: '<circle cx="12" cy="12" r="10"/><path d="M12 8v8"/><path d="M8 12h8"/>' },
      { label: 'Payment Issues', path: admin_reconciliation_dashboard_path, search_text: 'Payment Issues Reconciliations', active: reconciliations_active, icon: '<line x1="12" y1="1" x2="12" y2="23"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/>' }
    ]
  },
  {
    label: 'System',
    items: [
      { label: 'Audit Logs', path: admin_audit_logs_path, search_text: 'Audit Logs System Activity', active: audit_logs_active, icon: '<path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/><polyline points="10 9 9 9 8 9"/>' }
    ]
  },
  {
    label: 'Developers',
    items: [
      { label: 'API Access', path: admin_api_keys_path, search_text: 'API Access Keys Integrations', active: api_keys_active, icon: '<path d="M21 2l-2 2"/><path d="M7.61 11.39a5.5 5.5 0 1 1 7.78 7.78 5.5 5.5 0 0 1-7.78-7.78z"/><path d="m15.5 7.5 3 3L22 7l-3-3-3.5 3.5"/>' },
      { label: 'Developer Guide', path: docs_admin_api_keys_path, search_text: 'API Developer Guide Docs', active: api_docs_active, icon: '<path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/>' }
    ]
  }
] %>
<% admin_sidebar_footer_items = [
  { label: 'Homepage', path: root_path, search_text: 'Homepage Website', icon: '<path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/>' },
  { label: 'Help & support', path: help_center_path, search_text: 'Help Support', icon: '<circle cx="12" cy="12" r="10"/><path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"/><line x1="12" y1="17" x2="12.01" y2="17"/>' }
] %>
<% render_sidebar_nav = lambda do %>
  <nav class="flex-1 px-4 py-2 space-y-6">
    <% admin_sidebar_sections.each do |section| %>
      <div data-admin-sidebar-search-target="section">
        <span class="sidebar-section-label"><%= section[:label] %></span>
        <div class="space-y-0.5">
          <% section[:items].each do |item| %>
            <a data-admin-sidebar-search-target="item" data-search-text="<%= item[:search_text] %>" class="sidebar-nav-link <%= item[:active] ? 'sidebar-nav-link-active' : 'sidebar-nav-link-default' %>" href="<%= item[:path] %>">
              <svg class="size-4 shrink-0" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><%= item[:icon].html_safe %></svg>
              <span><%= item[:label] %></span>
            </a>
          <% end %>
        </div>
      </div>
    <% end %>
  </nav>
<% end %>

<!-- Preline CMS-style Sidebar -->
<!-- Desktop sidebar -->
<aside id="admin-sidebar" data-controller="admin-sidebar-search" class="hidden lg:flex lg:flex-col w-[260px] border-e border-layer-line bg-sidebar-bg shrink-0 h-full overflow-y-auto custom-scrollbar">
  <div class="p-4 pb-2">
    <label class="block" for="admin-sidebar-search-desktop">
      <span class="sr-only">Search navigation</span>
      <span class="relative block">
        <span class="pointer-events-none absolute inset-y-0 left-0 flex items-center pl-3 text-muted-foreground-2">
          <svg class="size-4 shrink-0" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
        </span>
        <input id="admin-sidebar-search-desktop" type="search" placeholder="Search navigation" autocomplete="off" data-admin-sidebar-search-target="input" data-action="input->admin-sidebar-search#filter" class="w-full rounded-lg border border-layer-line bg-layer-alt py-2 pl-10 pr-3 text-sm text-neutral-text-primary placeholder:text-muted-foreground-2 shadow-xs focus:border-slate-300 focus:outline-none focus:ring-0">
      </span>
    </label>
  </div>

  <%= capture(&render_sidebar_nav) %>

  <div data-admin-sidebar-search-target="section" class="px-4 py-4 mt-auto border-t border-layer-line space-y-0.5">
    <% admin_sidebar_footer_items.each do |item| %>
      <a data-admin-sidebar-search-target="item" data-search-text="<%= item[:search_text] %>" class="sidebar-nav-link sidebar-nav-link-default" href="<%= item[:path] %>">
        <svg class="size-4 shrink-0" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><%= item[:icon].html_safe %></svg>
        <span><%= item[:label] %></span>
      </a>
    <% end %>
  </div>

  <div data-admin-sidebar-search-target="empty" class="hidden mx-4 mb-4 rounded-xl border border-dashed border-layer-line bg-layer-alt px-4 py-5 text-center text-sm text-muted-foreground-2">
    No navigation matches that search.
  </div>
</aside>

<!-- Mobile sidebar overlay -->
<div id="admin-sidebar-overlay" class="fixed inset-0 z-[79] bg-black/50 hidden lg:hidden" data-controller="sidebar-toggle" data-action="click->sidebar-toggle#close"></div>
<aside id="admin-sidebar-mobile" data-controller="admin-sidebar-search sidebar-toggle" class="fixed top-0 start-0 bottom-0 z-[80] w-[260px] bg-sidebar-bg border-e border-layer-line transform -translate-x-full transition-transform duration-300 lg:hidden overflow-y-auto custom-scrollbar">
  <div class="flex items-center justify-between p-4 border-b border-layer-line">
    <a href="<%= admin_dashboard_path %>" class="flex items-center gap-x-2.5">
      <span class="inline-flex justify-center items-center size-8 bg-brand-primary rounded-lg text-white font-bold text-sm shadow-xs">W</span>
      <span class="text-sm font-semibold text-neutral-text-primary">WAStays</span>
    </a>
    <button type="button" class="inline-flex justify-center items-center size-8 rounded-lg text-neutral-text-secondary hover:bg-surface-hover transition-colors" data-action="click->sidebar-toggle#close">
      <svg class="size-4" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg>
    </button>
  </div>

  <div class="p-4 pb-2">
    <label class="block" for="admin-sidebar-search-mobile">
      <span class="sr-only">Search navigation</span>
      <span class="relative block">
        <span class="pointer-events-none absolute inset-y-0 left-0 flex items-center pl-3 text-muted-foreground-2">
          <svg class="size-4 shrink-0" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
        </span>
        <input id="admin-sidebar-search-mobile" type="search" placeholder="Search navigation" autocomplete="off" data-admin-sidebar-search-target="input" data-action="input->admin-sidebar-search#filter" class="w-full rounded-lg border border-layer-line bg-layer-alt py-2 pl-10 pr-3 text-sm text-neutral-text-primary placeholder:text-muted-foreground-2 shadow-xs focus:border-slate-300 focus:outline-none focus:ring-0">
      </span>
    </label>
  </div>

  <%= capture(&render_sidebar_nav) %>

  <div data-admin-sidebar-search-target="section" class="px-4 py-4 mt-auto border-t border-layer-line space-y-0.5">
    <% admin_sidebar_footer_items.each do |item| %>
      <a data-admin-sidebar-search-target="item" data-search-text="<%= item[:search_text] %>" class="sidebar-nav-link sidebar-nav-link-default" href="<%= item[:path] %>">
        <svg class="size-4 shrink-0" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><%= item[:icon].html_safe %></svg>
        <span><%= item[:label] %></span>
      </a>
    <% end %>
  </div>

  <div data-admin-sidebar-search-target="empty" class="hidden mx-4 mb-4 rounded-xl border border-dashed border-layer-line bg-layer-alt px-4 py-5 text-center text-sm text-muted-foreground-2">
    No navigation matches that search.
  </div>
</aside>
