<%= render PanelsUI::Sidebar.new(
      key: "admin",
      home_path: admin_dashboard_path,
      sections: admin_sidebar_sections,
      footer_items: admin_sidebar_footer_items,
      collapsible: true,
      searchable: false,
      permanent: true
    ) do |sidebar| %>
  <% sidebar.with_header do %>
    <div class="flex items-center gap-x-2.5 px-4 py-3">
      <span class="inline-flex size-7 shrink-0 items-center justify-center rounded-lg bg-slate-100 text-slate-700 shadow-xs ring-1 ring-slate-200">
        <%= cached_icon "settings", class: "size-4 shrink-0" %>
      </span>
      <span class="panel-sidebar__label text-sm font-semibold text-neutral-text-primary">Admin Panel</span>
    </div>
  <% end %>
<% end %>
