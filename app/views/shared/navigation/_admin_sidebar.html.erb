<%= render PanelsUI::Sidebar.new(
      key: "admin",
      home_path: admin_dashboard_path,
      sections: admin_sidebar_sections,
      footer_items: admin_sidebar_footer_items,
      collapsible: true,
      searchable: false,
      permanent: true
    ) do |sidebar| %>
  <% sidebar.with_header do %>
    <%= render PanelsUI::Tooltip.new(text: "Admin Panel", placement: :top, root_class: "w-full") do %>
      <div class="flex items-center gap-x-2.5 px-4 py-3">
        <span class="inline-flex size-7 shrink-0 items-center justify-center rounded-lg bg-muted text-foreground shadow-xs ring-1 ring-ring">
          <%= cached_icon "settings", class: "size-4 shrink-0" %>
        </span>
        <span class="panel-sidebar__label text-sm font-semibold text-foreground">Admin Panel</span>
      </div>
    <% end %>
  <% end %>
<% end %>
