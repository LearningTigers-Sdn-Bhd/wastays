<% sections = admin_sidebar_sections %>
<% footer_items = admin_sidebar_footer_items %>

<% admin_sidebar_header = capture do %>
  <div class="flex items-center gap-x-2.5 px-4 py-3">
    <span class="inline-flex justify-center items-center size-7 bg-brand-primary rounded-lg text-white font-bold text-xs shadow-xs">W</span>
    <span class="text-sm font-semibold text-neutral-text-primary">Superadmin</span>
  </div>
<% end %>

<% render_sidebar_nav = lambda do %>
  <nav class="flex-1 px-4 py-3 space-y-6">
    <% sections.each do |section| %>
      <div class="sidebar-nav-group">
        <span class="sidebar-section-label"><%= section.label %></span>
        <div class="space-y-0.5">
          <% section.items.each do |item| %>
            <a class="sidebar-nav-link <%= item.active ? 'sidebar-nav-link-active' : 'sidebar-nav-link-default' %>"
               href="<%= item.path %>"
               <%= 'target="_blank" rel="noopener noreferrer"'.html_safe if item.external %>>
              <%= cached_icon item.icon, class: "size-4 shrink-0" %>
              <span><%= item.label %></span>
            </a>
          <% end %>
        </div>
      </div>
    <% end %>
  </nav>
<% end %>

<% admin_nav_html = capture(&render_sidebar_nav) %>
<% admin_footer_html = capture do %>
  <% footer_items.each do |item| %>
    <a class="sidebar-nav-link sidebar-nav-link-default" href="<%= item.path %>">
      <%= cached_icon item.icon, class: "size-4 shrink-0" %>
      <span><%= item.label %></span>
    </a>
  <% end %>
<% end %>

<%= render "shared/navigation/sidebar_shell",
           sidebar_key: "admin",
           home_path: admin_dashboard_path,
           header_html: admin_sidebar_header,
           nav_html: admin_nav_html,
           footer_html: admin_footer_html %>
