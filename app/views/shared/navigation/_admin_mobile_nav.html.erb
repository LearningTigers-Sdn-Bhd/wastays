  <nav class="flex items-center justify-around py-2.5 text-[11px] font-medium text-muted-foreground">
    <a href="<%= admin_dashboard_path %>" class="flex flex-col items-center gap-y-1 px-2 py-1 rounded-lg transition-colors <%= controller_name == 'dashboard' ? 'text-sidebar-nav-active-text' : 'hover:text-neutral-text-primary' %>">
      <%= cached_icon "layout-dashboard", class: "w-5 h-5" %>
      <span>Dashboard</span>
    </a>
    <a href="<%= admin_hotels_path %>" class="flex flex-col items-center gap-y-1 px-2 py-1 rounded-lg transition-colors <%= controller_name == 'hotels' ? 'text-sidebar-nav-active-text' : 'hover:text-neutral-text-primary' %>">
