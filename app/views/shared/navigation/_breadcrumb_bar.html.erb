<%# locals: parts - array of { type: :section|:menu|:menu_group|:breakdown, label:, path:, siblings: }
   # :section     → unclickable text
   # :menu        → clickable dropdown showing other menus under same section
   # :menu_group  → unclickable text (parent of nested children)
   # :breakdown   → clickable dropdown showing other breakdowns under same menu group
%>
<div class="flex w-max min-w-0 items-center gap-x-2 text-sm" data-controller="breadcrumb-dropdown">
  <% parts.each_with_index do |part, index| %>
    <% if index > 0 %>
      <span class="text-slate-400">/</span>
    <% end %>

    <% case part[:type] %>
    <% when :section %>
      <span class="cursor-default font-medium text-slate-600"><%= part[:label] %></span>

    <% when :menu_group %>
      <span class="cursor-default font-medium text-slate-600"><%= part[:label] %></span>

    <% when :menu, :breakdown %>
      <% if part[:siblings].present? %>
        <div class="relative inline-flex items-center gap-x-1" data-breadcrumb-dropdown-target="item">
          <% if part[:path].present? %>
            <%= link_to part[:label], part[:path], class: "font-semibold text-slate-900 hover:text-brand-primary transition-colors" %>
          <% else %>
            <span class="cursor-default font-semibold text-slate-900"><%= part[:label] %></span>
          <% end %>
          <button type="button"
                  class="inline-flex size-5 shrink-0 items-center justify-center rounded text-slate-600 transition-colors hover:bg-slate-100 hover:text-brand-primary"
                  aria-label="Open <%= part[:label] %> navigation"
                  aria-expanded="false"
                  data-action="click->breadcrumb-dropdown#toggle">
            <%= cached_icon "chevron-down", class: "size-3 shrink-0" %>
          </button>
          <div class="fixed w-56 bg-layer shadow-dropdown rounded-lg hidden z-50 border border-layer-line py-1" data-breadcrumb-dropdown-target="menu">
            <% part[:siblings].each do |sibling| %>
              <%= link_to sibling[:label], sibling[:path],
                          class: "block px-3 py-2 text-sm text-neutral-text-primary hover:bg-surface-hover transition-colors",
                          data: { action: "click->breadcrumb-dropdown#close" } %>
            <% end %>
          </div>
        </div>
      <% elsif part[:path].present? && index < parts.size - 1 %>
        <%= link_to part[:label], part[:path], class: "font-medium text-slate-600 hover:text-brand-primary transition-colors" %>
      <% else %>
        <span class="cursor-default font-semibold text-slate-900"><%= part[:label] %></span>
      <% end %>
    <% else %>
      <% if part[:siblings].present? %>
        <div class="relative inline-flex items-center gap-x-1" data-breadcrumb-dropdown-target="item">
          <% if part[:path].present? %>
            <%= link_to part[:label], part[:path], class: "font-semibold text-slate-900 hover:text-brand-primary transition-colors" %>
          <% else %>
            <span class="cursor-default font-semibold text-slate-900"><%= part[:label] %></span>
          <% end %>
          <button type="button"
                  class="inline-flex size-5 shrink-0 items-center justify-center rounded text-slate-600 transition-colors hover:bg-slate-100 hover:text-brand-primary"
                  aria-label="Open <%= part[:label] %> navigation"
                  aria-expanded="false"
                  data-action="click->breadcrumb-dropdown#toggle">
            <%= cached_icon "chevron-down", class: "size-3 shrink-0" %>
          </button>
          <div class="fixed w-56 bg-layer shadow-dropdown rounded-lg hidden z-50 border border-layer-line py-1" data-breadcrumb-dropdown-target="menu">
            <% part[:siblings].each do |sibling| %>
              <%= link_to sibling[:label], sibling[:path],
                          class: "block px-3 py-2 text-sm text-neutral-text-primary hover:bg-surface-hover transition-colors",
                          data: { action: "click->breadcrumb-dropdown#close" } %>
            <% end %>
          </div>
        </div>
      <% elsif index < parts.size - 1 %>
        <% if part[:path].present? %>
          <%= link_to part[:label], part[:path], class: "font-medium text-slate-600 hover:text-brand-primary transition-colors" %>
        <% else %>
          <span class="cursor-default font-medium text-slate-600"><%= part[:label] %></span>
        <% end %>
      <% else %>
        <span class="cursor-default font-semibold text-slate-900">
          <% if part[:tab_breadcrumb] %>
            <span data-tab-breadcrumb-label><%= part[:label] %></span>
          <% else %>
            <%= part[:label] %>
          <% end %>
        </span>
      <% end %>
    <% end %>
  <% end %>
</div>
