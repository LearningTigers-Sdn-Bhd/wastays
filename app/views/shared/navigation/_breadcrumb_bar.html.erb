<%# locals: parts - array of { type: :section|:menu|:menu_group|:breakdown, label:, path:, siblings: }
   # :section     → unclickable text
   # :menu        → clickable dropdown showing other menus under same section
   # :menu_group  → unclickable text (parent of nested children)
   # :breakdown   → clickable dropdown showing other breakdowns under same menu group
%>
<div class="flex w-max min-w-0 items-center gap-x-2 text-sm" data-controller="breadcrumb-dropdown">
  <% parts.each_with_index do |part, index| %>
    <% if index > 0 %>
      <span class="text-slate-400">/</span>
    <% end %>

    <% case part[:type] %>
    <% when :section %>
      <span class="font-medium text-slate-600"><%= part[:label] %></span>

    <% when :menu_group %>
      <span class="font-medium text-slate-600"><%= part[:label] %></span>

    <% when :menu, :breakdown %>
      <div class="relative" data-breadcrumb-dropdown-target="item">
        <button type="button"
                class="font-semibold text-slate-900 inline-flex items-center gap-x-1 hover:text-brand-primary transition-colors"
                data-action="click->breadcrumb-dropdown#toggle">
          <%= part[:label] %>
          <%= cached_icon "chevron-down", class: "size-3 shrink-0" %>
        </button>
        <div class="fixed w-56 bg-layer shadow-dropdown rounded-lg hidden z-50 border border-layer-line py-1" data-breadcrumb-dropdown-target="menu">
          <% (part[:siblings] || []).each do |sibling| %>
            <%= link_to sibling[:label], sibling[:path],
                        class: "block px-3 py-2 text-sm text-neutral-text-primary hover:bg-surface-hover transition-colors",
                        data: { action: "click->breadcrumb-dropdown#close" } %>
          <% end %>
        </div>
      </div>
    <% end %>
  <% end %>
</div>
