<div class="relative inline-flex" data-controller="dropdown">
  <button type="button" class="p-0.5 inline-flex items-center gap-x-2 rounded-full hover:bg-surface-hover transition-colors" data-action="click->dropdown#toggle">
    <span class="inline-flex shrink-0 justify-center items-center size-8 rounded-full bg-brand-primary/10 border border-brand-primary/20">
      <svg class="size-4 text-brand-primary" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
    </span>
  </button>

  <div class="absolute right-0 top-full mt-2 w-[240px] bg-layer shadow-dropdown rounded-xl hidden z-[100] border border-layer-line" data-dropdown-target="menu">
    <div class="py-3 px-4 border-b border-layer-line">
      <div class="flex items-center gap-x-3">
        <span class="inline-flex shrink-0 justify-center items-center size-10 rounded-full bg-brand-primary/10 border border-brand-primary/20">
          <svg class="size-5 text-brand-primary" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
        </span>
        <div class="grow min-w-0">
          <p class="text-sm font-semibold text-neutral-text-primary truncate"><%= current_guest.name %></p>
          <p class="text-xs text-muted-foreground truncate"><%= current_guest.phone %></p>
        </div>
      </div>
    </div>

    <div class="p-1.5">
      <%= button_to guest_logout_path, method: :delete, class: "flex items-center gap-x-3 w-full py-2 px-3 rounded-lg text-sm text-neutral-text-primary hover:bg-surface-hover transition-colors text-left" do %>
        <svg class="shrink-0 size-4 text-muted-foreground" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
        Sign out
      <% end %>
    </div>
  </div>
</div>
