<!-- Preline CMS-style Hotel Mobile Bottom Nav -->
<div class="lg:hidden fixed inset-x-0 bottom-0 z-100 border-t border-layer-line bg-layer shadow-lg pb-safe">
  <nav class="flex items-center justify-around py-2.5 text-[11px] font-medium text-muted-foreground">
    <a href="<%= hotel_dashboard_path(current_hotel) %>" class="flex flex-col items-center gap-y-1 px-2 py-1 rounded-lg transition-colors <%= current_page?(hotel_dashboard_path(current_hotel)) ? 'text-sidebar-nav-active-text' : 'hover:text-neutral-text-primary' %>">
      <%= cached_icon "layout-dashboard", class: "w-5 h-5" %>
      <span>Dashboard</span>
    </a>
    <a href="<%= hotel_front_desk_path(current_hotel) %>" class="flex flex-col items-center gap-y-1 px-2 py-1 rounded-lg transition-colors <%= controller_name == "front_desk" ? 'text-sidebar-nav-active-text' : 'hover:text-neutral-text-primary' %>">
      <%= cached_icon "monitor", class: "w-5 h-5" %>
      <span>Reservations</span>
    </a>
    <a href="<%= hotel_room_types_path(current_hotel) %>" class="flex flex-col items-center gap-y-1 px-2 py-1 rounded-lg transition-colors <%= current_page?(hotel_room_types_path(current_hotel)) ? 'text-sidebar-nav-active-text' : 'hover:text-neutral-text-primary' %>">
      <%= cached_icon "users", class: "w-5 h-5" %>
      <span>Rooms</span>
    </a>
  </nav>
</div>
