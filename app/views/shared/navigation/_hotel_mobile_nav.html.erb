<!-- Preline CMS-style Hotel Mobile Bottom Nav -->
<div class="lg:hidden fixed inset-x-0 bottom-0 z-100 border-t border-border bg-card shadow-lg pb-safe">
  <nav class="flex items-center justify-around py-2.5 text-[11px] font-medium text-muted-foreground">
    <a href="<%= hotel_dashboard_path(current_hotel) %>" class="flex flex-col items-center gap-y-1 px-2 py-1 rounded-lg transition-colors <%= current_page?(hotel_dashboard_path(current_hotel)) ? 'text-sidebar-nav-active-text' : 'hover:text-foreground' %>">
      <%= cached_icon "layout-dashboard", class: "w-5 h-5" %>
      <span>Dashboard</span>
    </a>
    <a href="<%= hotel_arrivals_path(current_hotel) %>" class="flex flex-col items-center gap-y-1 px-2 py-1 rounded-lg transition-colors <%= current_page?(hotel_arrivals_path(current_hotel)) ? 'text-sidebar-nav-active-text' : 'hover:text-foreground' %>">
      <%= cached_icon "user-plus", class: "w-5 h-5" %>
      <span>Arrivals</span>
    </a>
    <a href="<%= hotel_bookings_path(current_hotel) %>" class="flex flex-col items-center gap-y-1 px-2 py-1 rounded-lg transition-colors <%= current_page?(hotel_bookings_path(current_hotel)) ? 'text-sidebar-nav-active-text' : 'hover:text-foreground' %>">
      <svg class="w-5 h-5" xmlns="http://www.w3.org/2000/svg" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/></svg>
      <span>Bookings</span>
    </a>
    <a href="<%= hotel_room_types_path(current_hotel) %>" class="flex flex-col items-center gap-y-1 px-2 py-1 rounded-lg transition-colors <%= current_page?(hotel_room_types_path(current_hotel)) ? 'text-sidebar-nav-active-text' : 'hover:text-foreground' %>">
      <%= cached_icon "users", class: "w-5 h-5" %>
      <span>Rooms</span>
    </a>
  </nav>
</div>
