<%# The refund form's fields, shared by the stay page and the Guest Portal.
    The submit button and the frame around it belong to each page.

    Locals: form, booking, and mode (:pre_stay or :post_stay, as
    Refunds::ModeFor names them). Post-stay asks for the amount; pre-stay
    does not, because the cancellation policy sets it. %>
<% if mode.to_sym == :post_stay %>
  <%= render GuestUI::FormField.new(form: form, attribute: :refund_amount,
                                    label: "Refund amount (#{booking.currency})",
                                    required: true,
                                    hint: "You paid #{booking.currency} #{number_with_precision(booking.total_amount, precision: 2, delimiter: ",")} for this stay.") do |field| %>
    <% field.with_input(type: :number,
                        value: params.dig(:refund_request, :refund_amount),
                        step: "0.01", min: "0.01", max: booking.total_amount,
                        inputmode: "decimal", placeholder: "0.00") %>
  <% end %>
<% end %>

<%= render GuestUI::FormField.new(form: form, attribute: :reason,
                                  label: (mode.to_sym == :post_stay ? "Reason (optional)" : "Why are you asking for a refund?")) do |field| %>
  <% field.with_text_area(rows: 4, placeholder: (mode.to_sym == :post_stay ? "For example: we left one night early" : "For example: change of travel plans")) %>
<% end %>

<%# The bank details. Their own group, because a guest who has finished
    saying what happened is now copying digits off a bank card. A fieldset,
    so a screen reader names the group with each field in it. %>
<fieldset class="guest-fieldset" aria-describedby="refund-bank-details-description">
  <legend class="guest-fieldset__legend">Bank details</legend>
  <p id="refund-bank-details-description" class="guest-fieldset__description">
    The property pays your refund into this account. Check the details against your bank card or app.
  </p>

  <%# A bank that is not listed is "Other bank" in the select, and its name
      goes in the field under it. Refunds::RequestParams stores that name. %>
  <%
    bank_name = form.object&.bank_name.to_s.strip
    other_bank = bank_name.present? && !BankCatalog.listed?(bank_name)
  %>
  <div class="grid gap-5" data-controller="other-choice"
       data-other-choice-other-value="<%= BankCatalog::OTHER %>"
       data-action="change->other-choice#toggle">
    <%= render GuestUI::FormField.new(form: form, attribute: :bank_name, label: "Bank name", required: true) do |field| %>
      <% field.with_select(choices: BankCatalog::MALAYSIAN_BANKS + [ [ "Other bank", BankCatalog::OTHER ] ],
                           prompt: "Choose your bank",
                           selected: (other_bank ? BankCatalog::OTHER : bank_name)) %>
    <% end %>

    <%= render GuestUI::FormField.new(form: form, attribute: :other_bank_name, label: "Name of your bank",
                                      required: true, disabled: !other_bank, hidden: !other_bank,
                                      data: { other_choice_target: "field" }) do |field| %>
      <% field.with_input(value: (bank_name if other_bank), placeholder: "For example: DBS Bank",
                          autocomplete: "off", data: { other_choice_target: "input" }) %>
    <% end %>
  </div>

  <%
    bank_fields = {
      account_holder_name: { label: "Account holder name", placeholder: "The name on the account", autocomplete: "name" },
      account_number: { label: "Account number", placeholder: "For example: 1234 5678 9012", autocomplete: "off" }
    }
  %>
  <% bank_fields.each do |attribute, options| %>
    <%= render GuestUI::FormField.new(form: form, attribute: attribute, label: options[:label], required: true) do |field| %>
      <% field.with_input(autocomplete: options[:autocomplete], placeholder: options[:placeholder]) %>
    <% end %>
  <% end %>

  <%= render GuestUI::FormField.new(form: form, attribute: :account_type,
                                    label: "Account type", required: true) do |field| %>
    <% field.with_radio_group(layout: :stacked, choices: [
         { label: "Savings", value: "savings", hint: "Most personal accounts" },
         { label: "Current", value: "current", hint: "Business or cheque accounts" }
       ]) %>
  <% end %>
</fieldset>
