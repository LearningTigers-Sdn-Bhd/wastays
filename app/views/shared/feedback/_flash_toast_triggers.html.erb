<% toast_flash_messages(flash).each do |toast| %>
  <noscript>
    <p role="<%= toast.dig(:options, :type).in?(%w[error danger]) ? "alert" : "status" %>">
      <%= toast[:message] %>
      <%= toast.dig(:options, :description) %>
    </p>
  </noscript>
  <%= tag.div hidden: true, data: {
    controller: "toast-trigger",
    toast_trigger_message_value: toast[:message],
    toast_trigger_options_value: toast[:options].to_json
  } %>
<% end %>
