<%# locals: (image_url: nil, title:, subtitle: nil, metadata: [], action_url: nil, action_label: "View") %>

<div class="group flex flex-col sm:flex-row items-start sm:items-center gap-4 p-4 rounded-xl border border-transparent hover:border-neutral-border hover:bg-white transition-all duration-200">
  <% if image_url %>
    <div class="shrink-0">
      <img class="size-16 rounded-lg object-cover" src="<%= image_url %>" alt="<%= title %>">
    </div>
  <% else %>
    <div class="shrink-0 size-16 rounded-lg bg-neutral-bg flex items-center justify-center">
      <%= cached_icon "image", class: "size-8 text-neutral-text-secondary opacity-40" %>
    </div>
  <% end %>

  <div class="grow min-w-0">
    <div class="flex items-center gap-x-2">
      <h4 class="text-sm font-bold text-neutral-text-primary truncate">
        <%= title %>
      </h4>
    </div>
    <% if subtitle %>
      <p class="text-xs text-neutral-text-secondary">
        <%= subtitle %>
      </p>
    <% end %>

    <% if metadata.any? %>
      <div class="mt-2 flex flex-wrap gap-x-4 gap-y-1">
        <% metadata.each do |item| %>
          <div class="flex items-center gap-x-1.5">
            <% if item[:icon] %>
              <svg class="size-3 text-neutral-text-secondary opacity-60" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <%= raw item[:icon] %>
              </svg>
            <% end %>
            <span class="text-[10px] font-medium text-neutral-text-secondary">
              <%= item[:label] %>: <span class="text-neutral-text-primary"><%= item[:value] %></span>
            </span>
          </div>
        <% end %>
      </div>
    <% end %>
  </div>

  <% if action_url %>
    <div class="shrink-0 sm:ms-auto">
      <a class="py-1.5 px-3 inline-flex items-center gap-x-2 text-xs font-semibold rounded-lg border border-neutral-border bg-white text-neutral-text-primary shadow-sm hover:bg-neutral-bg disabled:opacity-50 disabled:pointer-events-none transition-all" href="<%= action_url %>">
        <%= action_label %>
        <%= cached_icon "chevron-right", class: "shrink-0 size-3" %>
      </a>
    </div>
  <% end %>
</div>
