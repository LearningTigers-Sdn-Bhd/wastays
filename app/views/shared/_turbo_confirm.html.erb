<%= render PanelsUI::AlertDialog.new(
      id: "turbo-confirm-dialog",
      size: :sm,
      tone: :default,
      title: "Confirm action",
      description: "Are you sure you want to continue?",
      data: {
        controller: "panels-ui--turbo-confirm",
        action: "close->panels-ui--turbo-confirm#closed"
      }
    ) do |dialog| %>
  <% dialog.with_icon do %>
    <% {
         default: "circle-question-mark",
         info: "info",
         warning: "triangle-alert",
         success: "circle-check",
         destructive: "circle-alert"
       }.each do |tone, icon| %>
      <span class="panel-turbo-confirm__icon" data-tone="<%= tone %>">
        <%= app_icon icon, aria: { hidden: "true" } %>
      </span>
    <% end %>
  <% end %>

  <% dialog.with_cancel(
       label: "Cancel",
       id: "turbo-cancel-button",
       data: { action: "panels-ui--turbo-confirm#cancel" }
     ) %>
  <% dialog.with_action(
       label: "Confirm",
       id: "turbo-confirm-button",
       data: { action: "panels-ui--turbo-confirm#confirm" }
     ) %>
<% end %>
