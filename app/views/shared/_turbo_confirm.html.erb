<div id="turbo-confirm-modal" class="hidden fixed inset-0 z-[100] overflow-y-auto bg-gray-900/50 backdrop-blur-sm items-center justify-center p-4">
  <div class="bg-white border shadow-sm rounded-xl w-full max-w-md animate-in fade-in zoom-in duration-200">
    <div class="flex justify-between items-center py-3 px-4 border-b">
      <h3 id="turbo-confirm-title" class="font-bold text-gray-800">
        Confirm Action
      </h3>
    </div>
    <div class="p-4 overflow-y-auto">
      <p id="turbo-confirm-message" class="text-gray-700">
        Are you sure you want to perform this action?
      </p>
    </div>
    <div class="flex justify-end items-center gap-x-2 py-3 px-4 border-t">
      <button id="turbo-cancel-button" type="button" class="py-2 px-3 inline-flex items-center gap-x-2 text-sm font-medium rounded-lg border border-gray-200 bg-white text-gray-800 shadow-sm hover:bg-gray-50">
        Cancel
      </button>
      <button id="turbo-confirm-button" type="button" class="py-2 px-3 inline-flex items-center gap-x-2 text-sm font-semibold rounded-lg border border-transparent bg-blue-600 text-white hover:bg-blue-700">
        Confirm
      </button>
    </div>
  </div>
</div>
