<% content_for :title, "My Bookings | WAStays" %>

<div class="space-y-1">
  <h1 class="font-guest-display text-2xl font-semibold text-foreground md:text-3xl">My Bookings</h1>
  <p class="text-sm text-muted-foreground"><%= pluralize(@all_bookings.count, "booking") %></p>
</div>

<%= render "guest/shared/filters",
      path: ->(**params) { guest_bookings_path(**params) },
      frame: "guest_bookings_results",
      placeholder: "Search by property, Ref, or Code",
      label: "Search bookings",
      labels: Guest::StatusBadges::BOOKING.transform_values(&:label) %>

<%# target _top: a booking opens as its own page, not inside the frame. %>
<%= turbo_frame_tag "guest_bookings_results", target: "_top", class: "block space-y-6" do %>
  <% if @bookings.any? %>
    <div class="guest-booking-grid">
      <% @bookings.each do |booking| %>
        <%= render guest_booking_card(booking) %>
      <% end %>
    </div>
  <% else %>
    <% if @search_query.present? || @status_filter.present? %>
      <%= render GuestUI::EmptyState.new(icon: "search-x", title: "No bookings match",
                                         description: "Try another search, or pick a different status.") do |empty| %>
        <% empty.with_action do %>
          <%= render GuestUI::Button.new(label: "Clear filters", variant: :secondary, href: guest_bookings_path) %>
        <% end %>
      <% end %>
    <% else %>
      <%= render "guest/shared/no_bookings" %>
    <% end %>
  <% end %>

  <%= render GuestUI::Pagination.new(pagy: @pagy) %>
<% end %>
