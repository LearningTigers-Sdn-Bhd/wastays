<% content_for :title, "My Bookings | WAStays" %>

<div class="space-y-1">
  <h1 class="font-guest-display text-2xl font-semibold text-foreground md:text-3xl">My Bookings</h1>
  <p class="text-sm text-muted-foreground"><%= pluralize(@all_bookings.count, "booking") %></p>
</div>

<div class="space-y-3">
  <%# The search fills only the results frame, so the field keeps its focus
      while the guest types. A chip is a plain link: it changes the whole
      view, so the page reloads with it marked. %>
  <%= form_with url: guest_bookings_path, method: :get,
        data: { controller: "auto-submit", turbo_frame: "guest_bookings_results", turbo_action: "advance" } do |form| %>
    <%= hidden_field_tag :status, @status_filter, id: nil if @status_filter.present? %>
    <%= render GuestUI::Input.new(form:, attribute: :q, type: :search, value: @search_query,
                                  placeholder: "Search by property or booking code", autocomplete: "off",
                                  aria: { label: "Search bookings" },
                                  data: { action: "input->auto-submit#submit" }) %>
  <% end %>

  <nav class="guest-chips" aria-label="Filter by status">
    <%= link_to "All", guest_bookings_path(q: @search_query.presence),
          class: "guest-chip", aria: { current: ("page" if @status_filter.blank?) } %>
    <% @status_options.each do |status| %>
      <%= link_to status.humanize, guest_bookings_path(q: @search_query.presence, status:),
            class: "guest-chip", aria: { current: ("page" if @status_filter == status) } %>
    <% end %>
  </nav>
</div>

<%# target _top: a booking opens as its own page, not inside the frame. %>
<%= turbo_frame_tag "guest_bookings_results", target: "_top", class: "block space-y-6" do %>
  <% if @bookings.any? %>
    <%= render GuestUI::Card.new(padding: :tight, class: "py-0") do |card| %>
      <% @bookings.each do |booking| %>
        <% card.with_row(
             label: booking.hotel.name,
             hint: "#{guest_stay_dates(booking)} · #{guest_booking_status(booking).humanize} · #{booking.confirmation_token.upcase}",
             href: guest_booking_path(booking)
           ) %>
      <% end %>
    <% end %>
  <% else %>
    <%= render GuestUI::Card.new(variant: :dashed) do %>
      <p class="text-sm text-muted-foreground">No bookings found.</p>
    <% end %>
  <% end %>

  <%= render GuestUI::Pagination.new(pagy: @pagy) %>
<% end %>
