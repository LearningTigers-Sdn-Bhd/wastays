<% content_for :title, "Booking Details | WAStays" %>
<%
  hotel = @booking.hotel
  status = guest_booking_status(@booking)
  refund_request = @booking.refund_request
  ready_e_invoice = @booking.original_ready_guest_e_invoice_submission
  ready_adjustment = @booking.latest_ready_adjustment_guest_e_invoice_submission
  pending_e_invoice = @booking.pending_guest_e_invoice_submission
  failed_e_invoice = @booking.failed_guest_e_invoice_submission
  guests = pluralize(@booking.adults, "adult")
  guests += ", #{pluralize(@booking.children, 'child', plural: 'children')}" if @booking.children.to_i.positive?
%>

<%# The concierge's split: the stay at a third, what the guest does with it
    at two thirds. They stack on a phone, stay first. %>
<div class="guest-page__grid" data-columns="2">
  <div class="guest-page__context space-y-4">
    <%= render GuestUI::Card.new(class: "guest-stay-summary") do %>
      <div class="flex items-center justify-between gap-3">
        <h1 class="guest-card__title">Your Stay</h1>
        <span class="guest-stay-summary__status" data-state="<%= "in-house" if status == "checked_in" %>">
          <%= status.humanize %>
        </span>
      </div>

      <p class="mt-4 font-guest-display text-2xl font-semibold leading-tight text-foreground"><%= hotel.name %></p>
      <p class="mt-1 text-sm text-muted-foreground"><%= [ hotel.city, hotel.country ].compact_blank.join(", ") %></p>

      <p class="mt-4 flex flex-wrap items-center gap-2 text-sm font-semibold text-foreground">
        <span><%= @booking.check_in.strftime("%d %b %Y") %></span>
        <%= app_icon "arrow-right", class: "size-4 shrink-0 text-muted-foreground", aria: { hidden: "true" } %>
        <span><%= @booking.check_out.strftime("%d %b %Y") %></span>
      </p>
      <p class="mt-1 text-xs font-medium text-muted-foreground"><%= pluralize(@booking.duration_in_nights, "night") %></p>

      <dl class="guest-stay-summary__refs">
        <div class="flex items-baseline gap-1.5">
          <dt>Code</dt>
          <dd class="font-mono text-foreground"><%= @booking.confirmation_token.upcase %></dd>
        </div>
      </dl>
    <% end %>

    <%= render GuestUI::Button.new(
          label: "Open concierge", variant: :secondary, block: true,
          href: concierge_home_path(hotel_code: hotel.unique_id, public_id: hotel.public_id)
        ) %>
  </div>

  <div class="guest-page__content">
    <% if @booking.status == "checked_in" %>
      <% rooms = @booking.booking_rooms.where.not(room_number: [ nil, "" ]) %>
      <% if rooms.any? %>
        <%= render GuestUI::Card.new(title: "In-Stay Preferences") do %>
          <div class="space-y-4">
            <% rooms.each do |room| %>
              <% dnd = @room_statuses[[ room.room_type_id, room.room_number ]]&.active_dnd? %>
              <div class="flex items-center justify-between gap-4">
                <div class="min-w-0">
                  <p class="text-sm font-semibold text-foreground">Room <%= room.room_number %></p>
                  <p class="text-xs text-muted-foreground">
                    <%= dnd ? "Do Not Disturb is on." : "Turn on Do Not Disturb for privacy." %>
                  </p>
                </div>
                <%= render GuestUI::Button.new(
                      label: (dnd ? "Turn off" : "Turn on"), size: :sm,
                      variant: (dnd ? :primary : :secondary),
                      href: toggle_dnd_guest_booking_path(@booking), method: :patch,
                      aria_label: "#{dnd ? 'Turn off' : 'Turn on'} Do Not Disturb for room #{room.room_number}"
                    ) %>
              </div>
            <% end %>
          </div>
        <% end %>
      <% end %>
    <% end %>

    <%= render GuestUI::Card.new(title: "Reservation") do %>
      <%= render GuestUI::FactList.new(facts: [
            [ "Check-in", @booking.check_in.strftime("%d %b %Y") ],
            [ "Check-out", @booking.check_out.strftime("%d %b %Y") ],
            [ "Guests", guests ],
            [ "Room Category", @booking.room_type_summary ]
          ]) %>
    <% end %>

    <%= render GuestUI::Card.new(title: "Payment and Documents") do %>
      <%= render GuestUI::FactList.new(facts: [
            [ "Payment Status", @booking.payment_status.to_s.humanize ],
            [ "Total Amount", number_to_currency(@booking.total_amount, unit: "#{@booking.currency} ") ]
          ]) %>

      <% if pending_e_invoice && !(ready_e_invoice || ready_adjustment) %>
        <%= render GuestUI::Notice.new(message: "E-Invoice is being prepared…", class: "mt-4") %>
      <% elsif failed_e_invoice && !(ready_e_invoice || ready_adjustment) %>
        <%= render GuestUI::Notice.new(
              title: "E-Invoice submission failed.",
              message: failed_e_invoice.error_message.presence || "The submission to LHDN failed. The property can retry it for you.",
              variant: :danger, class: "mt-4"
            ) %>
      <% end %>

      <div class="mt-2">
        <%# Named for what the document is: it confirms the reservation. Payment
            receipts are issued per payment and delivered on their own. %>
        <% if @booking.status == "completed" %>
          <%= render GuestUI::Card::Row.new(label: "Invoice", hint: "Download the final PDF", icon: "download",
                           href: invoice_guest_booking_path(@booking), data: { turbo: false }) %>
        <% else %>
          <%= render GuestUI::Card::Row.new(label: "Booking Confirmation", hint: "Download a PDF copy", icon: "download",
                           href: receipt_guest_booking_path(@booking), data: { turbo: false }) %>
        <% end %>
        <%= render GuestUI::Card::Row.new(label: (@booking.group_booking_id? ? "Group Summary" : "Booking Summary"),
                         hint: "Download a PDF copy", icon: "download",
                         href: summary_guest_booking_path(@booking), data: { turbo: false }) %>
        <% if @booking.group_booking_id? %>
          <%= render GuestUI::Card::Row.new(label: "All Vouchers", hint: "Download one PDF for every room", icon: "download",
                           href: voucher_pack_guest_booking_path(@booking), data: { turbo: false }) %>
        <% end %>
        <% if ready_e_invoice %>
          <%= render GuestUI::Card::Row.new(label: "E-Invoice", hint: "Download the validated PDF", icon: "download",
                           href: e_invoice_guest_booking_path(@booking, submission_id: ready_e_invoice.id), data: { turbo: false }) %>
        <% end %>
        <% if ready_adjustment %>
          <%= render GuestUI::Card::Row.new(label: ready_adjustment.document_type_label, hint: "Download the validated PDF", icon: "download",
                           href: e_invoice_guest_booking_path(@booking, submission_id: ready_adjustment.id), data: { turbo: false }) %>
        <% end %>
      </div>

      <% if !(ready_e_invoice || ready_adjustment || pending_e_invoice || failed_e_invoice) && @booking.e_invoice_guest_request_possible? %>
        <div class="mt-4"
             data-controller="e-invoice-request-modal"
             data-e-invoice-request-modal-request-url-value="<%= request_e_invoice_guest_booking_path(@booking) %>"
             data-e-invoice-request-modal-status-url-value="<%= status_e_invoice_guest_booking_path(@booking) %>">
          <%= render GuestUI::Button.new(label: "Request E-Invoice", variant: :secondary, icon: "file-text", block: true,
                                         data: { action: "e-invoice-request-modal#open" }) %>
          <%= render "shared/e_invoice_request_modal", booking: @booking %>
        </div>
      <% end %>
    <% end %>

    <% if @booking.eligible_for_refund?(@refund_policy) %>
      <%= render GuestUI::Card.new(title: "Need a Refund?") do %>
        <p class="text-sm text-muted-foreground">
          You can ask for a refund below. Sending the request cancels this booking at once.
        </p>
        <%= render GuestUI::Button.new(label: "Request Refund", variant: :destructive, class: "mt-4",
                                       href: new_guest_booking_refund_request_path(@booking, return_to: "details")) %>
      <% end %>
    <% elsif @booking.status == "confirmed" && refund_request.nil? %>
      <%= render GuestUI::Card.new(title: "Refund Availability") do %>
        <% if @refund_policy.blank? %>
          <p class="text-sm text-muted-foreground">Online refund requests are not open for this booking yet. If you need help now, contact the property.</p>
        <% else %>
          <p class="text-sm text-muted-foreground">
            This booking is outside the online refund window. Requests close
            <%= pluralize(@refund_policy.min_days_before_checkin, "day") %> before check-in.
            If your plans changed, contact the property. They can tell you your options.
          </p>
        <% end %>
      <% end %>
    <% elsif refund_request.present? %>
      <%= render GuestUI::Card.new(title: "Refund Request") do %>
        <%= render GuestUI::FactList.new(facts: [
              [ "Status", refund_request.status.humanize ],
              [ "Refund Amount", number_to_currency(refund_request.refund_amount, unit: "#{@booking.currency} ") ],
              [ "Property Note", refund_request.hotel_note ]
            ]) %>
        <div class="mt-4 flex flex-wrap gap-3">
          <%= render GuestUI::Button.new(label: "View Request", variant: :secondary,
                                         href: guest_refund_request_path(refund_request)) %>
          <% if refund_request.rejected? %>
            <%= render GuestUI::Button.new(label: "Resubmit Request",
                                           href: new_guest_booking_refund_request_path(@booking, return_to: "details")) %>
          <% end %>
        </div>
      <% end %>
    <% end %>
  </div>
</div>
