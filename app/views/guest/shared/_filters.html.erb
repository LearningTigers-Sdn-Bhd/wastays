<%# Search and status chips above a guest portal list.

    The search fills only the results frame, so the field keeps its focus
    while the guest types. A chip is a plain link: it changes the whole view,
    so the page reloads with it marked.

    Locals: path (a lambda taking q: and status:), frame, placeholder, label,
    and labels (status => the word the guest sees).
    Reads @search_query, @status_filter and @status_options. %>
<div class="space-y-3">
  <%= form_with url: path.call, method: :get,
        data: { controller: "auto-submit", turbo_frame: frame, turbo_action: "advance" } do |form| %>
    <%= hidden_field_tag :status, @status_filter, id: nil if @status_filter.present? %>
    <%= render GuestUI::Input.new(form:, attribute: :q, type: :search, value: @search_query,
                                  placeholder:, autocomplete: "off", aria: { label: },
                                  data: { action: "input->auto-submit#submit" }) %>
  <% end %>

  <nav class="guest-chips" aria-label="Filter by status">
    <%= link_to "All", path.call(q: @search_query.presence),
          class: "guest-chip", aria: { current: ("page" if @status_filter.blank?) } %>
    <% @status_options.each do |status| %>
      <%= link_to labels.fetch(status) { status.humanize }, path.call(q: @search_query.presence, status:),
            class: "guest-chip", aria: { current: ("page" if @status_filter == status) } %>
    <% end %>
  </nav>
</div>
