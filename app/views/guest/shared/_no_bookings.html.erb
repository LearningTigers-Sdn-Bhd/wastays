<%# A guest with no bookings at all, on Home and on the Bookings list. %>
<%= render GuestUI::EmptyState.new(icon: "calendar-plus", title: "No bookings yet",
                                   description: "When you book a stay, it shows here with its documents and refunds.") do |empty| %>
  <% empty.with_action do %>
    <%= render GuestUI::Button.new(label: "Find a stay", href: root_path) %>
  <% end %>
<% end %>
