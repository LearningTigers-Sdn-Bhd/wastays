<% content_for :title, "Guest Login | WAStays" %>
<% content_for :hide_chrome, true %>

<div class="relative min-h-screen flex items-center justify-center bg-landing-bg overflow-hidden py-12 px-4">
  <!-- Decorative Background Glows -->
  <div class="absolute top-0 left-0 w-full h-full overflow-hidden pointer-events-none">
    <div class="absolute top-[-10%] left-[-10%] w-[40%] h-[40%] bg-brand-primary/5 rounded-full blur-[100px]"></div>
    <div class="absolute bottom-[-10%] right-[-10%] w-[40%] h-[40%] bg-brand-primary/5 rounded-full blur-[100px]"></div>
  </div>

  <div class="relative w-full max-w-[440px] z-10">
    <!-- Header Section -->
    <div class="text-center mb-10">
      <!-- Badge -->
      <div class="inline-flex items-center gap-x-2 bg-brand-accent/50 px-3 py-1 rounded-full mb-6">
        <span class="text-[10px] font-bold uppercase tracking-[0.15em] text-brand-accent-text">Guest Access</span>
      </div>

      <h1 class="text-4xl font-serif text-brand-primary leading-tight mb-3">
        View your <span class="italic">bookings</span>
      </h1>
      <p class="text-neutral-text-secondary max-w-[280px] mx-auto text-sm leading-relaxed">
        Enter the secure code we sent to your <span class="font-semibold text-brand-primary/80">WhatsApp</span>.
      </p>
    </div>

    <!-- Login Card -->
    <div class="bg-white rounded-[2rem] border border-neutral-border/40 p-8 sm:p-10 shadow-2xl shadow-brand-primary/5">
      <%= form_with url: guest_login_path, method: :post, class: "space-y-6" do |f| %>
        <div class="space-y-2">
          <%= f.label :phone, "WhatsApp number", class: "block text-xs font-bold uppercase tracking-wider text-neutral-text-secondary ml-1" %>
          <div class="relative">
            <div class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none text-neutral-text-secondary/50">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path></svg>
            </div>
            <%= f.telephone_field :phone, value: params[:phone],
                placeholder: "+6012 345 6789",
                class: "block w-full pl-11 pr-4 py-4 rounded-xl border border-neutral-border bg-white text-neutral-text-primary placeholder:text-neutral-text-secondary/40 focus:ring-4 focus:ring-brand-primary/5 focus:border-brand-primary/40 transition-all duration-300 text-sm",
                required: true, autocomplete: "tel", readonly: params[:phone].present? %>
            </div>
            </div>

            <div class="space-y-2">
            <%= f.label :otp, "Secure Code", class: "block text-xs font-bold uppercase tracking-wider text-neutral-text-secondary ml-1" %>
            <div class="relative">
            <div class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none text-neutral-text-secondary/50">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 00-2 2zm10-10V7a4 4 0 00-8 0v4h8z"></path></svg>
            </div>
            <%= f.text_field :otp, placeholder: "······",
                class: "block w-full pl-11 pr-4 py-4 rounded-xl border border-neutral-border bg-white text-neutral-text-primary placeholder:text-neutral-text-secondary/40 focus:ring-4 focus:ring-brand-primary/5 focus:border-brand-primary/40 tracking-[0.5em] text-center transition-all duration-300 font-mono text-lg",
                maxlength: 6, inputmode: "numeric", autocomplete: "one-time-code", autofocus: params[:phone].present? %>

          </div>
        </div>

        <%= f.submit "Access My Bookings", class: "w-full rounded-xl bg-brand-primary text-white text-sm font-bold py-4 hover:bg-brand-primary-hover shadow-lg shadow-brand-primary/10 hover:shadow-brand-primary/20 transition-all duration-300 cursor-pointer flex items-center justify-center gap-x-2 group" %>
      <% end %>

      <!-- Help Section -->
      <div class="mt-10 pt-8 border-t border-neutral-border/40 text-center">
        <p class="text-xs text-neutral-text-secondary mb-4">Don't have a code yet?</p>
        <a href="https://wa.me/601139278173" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-x-2 text-xs font-bold text-brand-primary hover:text-brand-primary-hover transition-colors group">
          <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/></svg>
          Request access via WhatsApp
          <svg class="w-3 h-3 group-hover:translate-x-0.5 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"></path></svg>
        </a>
      </div>
    </div>

    <!-- Footer link -->
    <div class="mt-8 text-center">
      <a href="<%= root_path %>" class="text-xs font-medium text-neutral-text-secondary hover:text-brand-primary transition-colors flex items-center justify-center gap-x-1.5">
        <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path></svg>
        Back to WAStays Home
      </a>
    </div>
  </div>
</div>
