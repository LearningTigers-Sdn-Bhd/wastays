<% content_for :title, "Guest Login | WAStays" %>
<% content_for :hide_chrome, true %>

<div class="relative min-h-screen flex items-center justify-center bg-landing-bg overflow-hidden py-12 px-4" data-controller="guest-login">
  <!-- Decorative glows -->
  <div class="absolute top-0 left-0 w-full h-full overflow-hidden pointer-events-none">
    <div class="absolute top-[-10%] left-[-10%] w-[40%] h-[40%] bg-brand-primary/5 rounded-full blur-[100px]"></div>
    <div class="absolute bottom-[-10%] right-[-10%] w-[40%] h-[40%] bg-brand-primary/5 rounded-full blur-[100px]"></div>
  </div>

  <div class="relative w-full max-w-[440px] z-10">
    <!-- Header -->
    <div class="text-center mb-10">
      <div class="inline-flex items-center gap-x-2 bg-brand-accent/50 px-3 py-1 rounded-full mb-6">
        <span class="text-[10px] font-bold uppercase tracking-[0.15em] text-brand-accent-text">Guest Access</span>
      </div>
      <h1 class="text-4xl font-serif text-brand-primary leading-tight mb-3">
        View your <span class="italic">bookings</span>
      </h1>
      <p class="text-neutral-text-secondary max-w-[280px] mx-auto text-sm leading-relaxed">
        Choose how you'd like to access your bookings.
      </p>
    </div>

    <!-- Choice Panel -->
    <div data-guest-login-target="choice" class="bg-white rounded-[2rem] border border-neutral-border/40 p-8 shadow-2xl shadow-brand-primary/5 space-y-3">
      <button data-action="click->guest-login#showWhatsapp"
        class="w-full flex items-center gap-x-4 p-4 rounded-xl border border-neutral-border hover:border-brand-primary/40 hover:bg-brand-primary/5 transition-all group">
        <div class="shrink-0 w-10 h-10 rounded-full bg-green-100 flex items-center justify-center">
          <svg class="w-5 h-5 text-green-600" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/></svg>
        </div>
        <div class="text-left">
          <p class="text-sm font-semibold text-neutral-text-primary">Continue with WhatsApp</p>
          <p class="text-xs text-neutral-text-secondary mt-0.5">Enter the code sent to your WhatsApp</p>
        </div>
        <svg class="w-4 h-4 text-neutral-text-secondary ml-auto group-hover:text-brand-primary transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
      </button>

      <button data-action="click->guest-login#showEmail"
        class="w-full flex items-center gap-x-4 p-4 rounded-xl border border-neutral-border hover:border-brand-primary/40 hover:bg-brand-primary/5 transition-all group">
        <div class="shrink-0 w-10 h-10 rounded-full bg-blue-50 flex items-center justify-center">
          <svg class="w-5 h-5 text-blue-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
        </div>
        <div class="text-left">
          <p class="text-sm font-semibold text-neutral-text-primary">Continue with Email</p>
          <p class="text-xs text-neutral-text-secondary mt-0.5">We'll send a magic link to your inbox</p>
        </div>
        <svg class="w-4 h-4 text-neutral-text-secondary ml-auto group-hover:text-brand-primary transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
      </button>
    </div>

    <!-- WhatsApp Panel -->
    <div data-guest-login-target="whatsapp" class="hidden bg-white rounded-[2rem] border border-neutral-border/40 p-8 shadow-2xl shadow-brand-primary/5">
      <button data-action="click->guest-login#back" class="flex items-center gap-x-1.5 text-xs text-neutral-text-secondary hover:text-brand-primary transition-colors mb-6">
        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/></svg>
        Back
      </button>

      <div class="flex items-center gap-x-3 mb-6">
        <div class="w-9 h-9 rounded-full bg-green-100 flex items-center justify-center shrink-0">
          <svg class="w-4 h-4 text-green-600" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/></svg>
        </div>
        <div>
          <p class="text-sm font-semibold text-neutral-text-primary">WhatsApp Login</p>
          <p class="text-xs text-neutral-text-secondary">We'll send a magic link to your WhatsApp</p>
        </div>
      </div>

      <p class="text-sm text-neutral-text-secondary leading-relaxed mb-6">
        Tap the button below to message us on WhatsApp. We'll send you a secure login link instantly.
      </p>

      <a href="https://wa.me/601139278173?text=%2Flogin" target="_blank" rel="noopener noreferrer"
        class="w-full flex items-center justify-center gap-x-2.5 rounded-xl bg-[#25D366] text-white text-sm font-bold py-3.5 hover:bg-[#22c55e] shadow-lg shadow-green-500/20 transition-all">
        <svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/></svg>
        Open WhatsApp
      </a>

      <p class="mt-4 text-center text-xs text-neutral-text-secondary">
        After messaging us, check WhatsApp for your login link.
      </p>
    </div>

    <!-- Email Panel -->
    <div data-guest-login-target="email" class="hidden bg-white rounded-[2rem] border border-neutral-border/40 p-8 shadow-2xl shadow-brand-primary/5">
      <button data-action="click->guest-login#back" class="flex items-center gap-x-1.5 text-xs text-neutral-text-secondary hover:text-brand-primary transition-colors mb-6">
        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/></svg>
        Back
      </button>

      <div class="flex items-center gap-x-3 mb-6">
        <div class="w-9 h-9 rounded-full bg-blue-50 flex items-center justify-center shrink-0">
          <svg class="w-4 h-4 text-blue-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
        </div>
        <div>
          <p class="text-sm font-semibold text-neutral-text-primary">Email Login</p>
          <p class="text-xs text-neutral-text-secondary">We'll send a magic link to your inbox</p>
        </div>
      </div>

      <%= form_with url: guest_request_magic_link_path, method: :post, class: "space-y-4" do |f| %>
        <div>
          <%= f.label :email, "Email Address", class: "block text-xs font-bold uppercase tracking-wider text-neutral-text-secondary mb-1.5 ml-1" %>
          <div class="relative">
            <div class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none text-neutral-text-secondary/50">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
            </div>
            <%= f.email_field :email,
                placeholder: "you@example.com",
                class: "block w-full pl-11 pr-4 py-3.5 rounded-xl border border-neutral-border bg-white text-sm text-neutral-text-primary placeholder:text-neutral-text-secondary/40 focus:ring-4 focus:ring-brand-primary/5 focus:border-brand-primary/40 transition-all",
                required: true, autocomplete: "email", autofocus: true %>
          </div>
        </div>

        <%= f.submit "Send Magic Link", class: "w-full rounded-xl bg-brand-primary text-white text-sm font-bold py-3.5 hover:bg-brand-primary/90 shadow-lg shadow-brand-primary/10 transition-all cursor-pointer" %>
      <% end %>

      <p class="mt-4 text-center text-xs text-neutral-text-secondary">
        Link expires in 24 hours. Check your spam folder if not received.
      </p>
    </div>

    <!-- Email Success Panel -->
    <div data-guest-login-target="emailSuccess" class="hidden bg-white rounded-[2rem] border border-neutral-border/40 p-8 shadow-2xl shadow-brand-primary/5 text-center">
      <div class="w-14 h-14 rounded-full bg-green-50 flex items-center justify-center mx-auto mb-5">
        <svg class="w-7 h-7 text-green-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 19v-8.93a2 2 0 01.89-1.664l7-4.666a2 2 0 012.22 0l7 4.666A2 2 0 0121 10.07V19M3 19a2 2 0 002 2h14a2 2 0 002-2M3 19l7-11 7 11"/></svg>
      </div>
      <h2 class="text-lg font-semibold text-neutral-text-primary mb-2">Check your inbox</h2>
      <p class="text-sm text-neutral-text-secondary leading-relaxed mb-6">
        We've sent a magic login link to your email. Click the link to access your bookings.<br>
        <span class="text-xs mt-1 block">Link expires in 24 hours. Check your spam folder if not received.</span>
      </p>
      <div class="flex items-center justify-center gap-x-3">
        <button data-action="click->guest-login#back" class="flex-1 rounded-xl border border-brand-primary text-brand-primary text-xs font-semibold py-3 hover:bg-brand-primary/5 transition-all">
          ← Try a different method
        </button>
        <a href="<%= root_path %>" class="flex-1 rounded-xl border border-neutral-border text-neutral-text-secondary text-xs font-semibold py-3 hover:bg-neutral-50 hover:border-neutral-400 transition-all text-center">
          Back to WAStays Home
        </a>
      </div>
    </div>
  </div>
</div>
