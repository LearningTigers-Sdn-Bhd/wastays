<% content_for :title, "My Refunds | WAStays" %>

<div class="max-w-[1600px] mx-auto pb-20 space-y-8">
  <div class="px-4 md:px-0">
    <div class="mt-5">
      <h1 class="text-2xl font-bold tracking-tight text-slate-950 sm:text-3xl">My Refunds</h1>
      <p class="mt-1 text-sm font-medium text-slate-600">Track the refund requests you have already submitted.</p>
    </div>
  </div>

  <div class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">
    <div class="flex items-center justify-between border-b border-slate-200 px-6 py-5 sm:px-8">
      <div>
        <h2 class="text-lg font-bold tracking-tight text-slate-950 sm:text-xl">Refund Requests</h2>
        <p class="mt-1 text-sm font-medium text-slate-600">Submitted refund requests linked to your bookings.</p>
      </div>
      <span class="text-sm font-medium text-slate-500">Total <span class="font-semibold text-slate-900"><%= @all_bookings.count %></span></span>
    </div>

    <div class="border-b border-slate-200 bg-slate-50/70 px-6 py-4 sm:px-8">
      <%= form_with url: guest_refund_requests_path, method: :get, local: true, class: "flex flex-col gap-3 xl:flex-row xl:items-center xl:justify-between", data: { controller: "auto-submit", turbo_frame: "guest_refunds_results" } do %>
        <div class="flex w-full flex-col gap-3 lg:flex-row">
          <label class="relative block flex-1">
            <span class="pointer-events-none absolute inset-y-0 left-0 flex items-center pl-4 text-slate-400">
              <svg class="size-4" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
            </span>
            <%= text_field_tag :q, @search_query, placeholder: "Search refunds", autocomplete: "off", class: "w-full rounded-xl border border-slate-200 bg-white py-2.5 pl-11 pr-4 text-sm text-slate-700 placeholder:text-slate-400 focus:border-slate-300 focus:outline-none focus:ring-0", data: { action: "input->auto-submit#submit" } %>
          </label>

          <%= select_tag :status, options_for_select([["All Status", ""]] + @status_options.map { |status| [status.humanize, status] }, @status_filter), id: "guest-refund-status-filter", class: "rounded-xl border border-slate-200 bg-white px-3 py-2.5 text-sm font-medium text-slate-700 focus:border-slate-300 focus:outline-none focus:ring-0", data: { action: "change->auto-submit#submitNow" } %>
        </div>

        <div class="flex items-center gap-2">
          <% if @search_query.present? || @status_filter.present? %>
            <%= link_to "Clear", guest_refund_requests_path, class: "inline-flex items-center rounded-lg border border-slate-200 bg-white px-3 py-2 text-sm font-semibold text-slate-700 shadow-sm transition hover:border-slate-900 hover:bg-slate-50" %>
          <% end %>
        </div>
      <% end %>
    </div>

    <%= turbo_frame_tag "guest_refunds_results" do %>
      <div id="guest-refunds-mobile-list" class="space-y-4 p-4 sm:p-6 lg:hidden">
        <% if @bookings.any? %>
          <% @bookings.each do |booking| %>
            <% rr = booking.refund_request %>
            <% status_classes = case rr.status
               when "pending" then "text-amber-700"
               when "approved" then "text-blue-700"
               when "completed" then "text-emerald-700"
               when "rejected" then "text-red-700"
               else "text-slate-600"
               end %>
            <% status_dot_classes = case rr.status
               when "pending" then "bg-amber-500"
               when "approved" then "bg-blue-500"
               when "completed" then "bg-emerald-500"
               when "rejected" then "bg-red-500"
               else "bg-slate-400"
               end %>

            <div class="rounded-2xl border border-slate-200 bg-slate-50/60 p-4 shadow-sm">
              <div class="flex items-start justify-between gap-3">
                <div>
                  <p class="text-xs font-semibold uppercase tracking-[0.08em] text-slate-500">Confirmation</p>
                  <%= link_to booking.confirmation_token, guest_refund_request_path(rr), class: "mt-1 inline-flex font-mono text-sm font-semibold text-blue-700 hover:text-blue-800", data: { turbo_frame: "_top" } %>
                </div>
                <div class="inline-flex items-center gap-2 text-sm font-medium <%= status_classes %>">
                  <span class="size-2.5 rounded-sm <%= status_dot_classes %>"></span>
                  <%= rr.status.humanize %>
                </div>
              </div>

              <dl class="mt-4 space-y-3 text-sm">
                <div>
                  <dt class="text-xs font-semibold uppercase tracking-[0.08em] text-slate-500">Hotel</dt>
                  <dd class="mt-1 text-slate-700"><%= booking.hotel.name %></dd>
                </div>
                <div>
                  <dt class="text-xs font-semibold uppercase tracking-[0.08em] text-slate-500">Stay Dates</dt>
                  <dd class="mt-1 text-slate-700"><%= booking.check_in.strftime("%d %b %Y") %> - <%= booking.check_out.strftime("%d %b %Y") %></dd>
                </div>
                <div>
                  <dt class="text-xs font-semibold uppercase tracking-[0.08em] text-slate-500">Requested</dt>
                  <dd class="mt-1 text-slate-700"><%= rr.created_at.strftime("%d %b %Y, %I:%M %p") %></dd>
                </div>
              </dl>

              <div class="mt-4 flex justify-end gap-2">
                <% if rr.rejected? %>
                  <%= link_to new_guest_booking_refund_request_path(booking, return_to: "list"), class: "inline-flex items-center gap-x-1.5 rounded-lg border border-red-200 bg-red-50 px-3 py-1.5 text-xs font-semibold text-red-700 shadow-sm transition hover:bg-red-100", data: { turbo_frame: "_top" } do %>
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="size-3.5"><path d="M12 18H4a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5"/><path d="m16 19 3 3 3-3"/><path d="M18 12h.01"/><path d="M19 16v6"/><path d="M6 12h.01"/><circle cx="12" cy="12" r="2"/></svg>
                    Resubmit
                  <% end %>
                <% end %>
                <%= link_to guest_refund_request_path(rr), class: "inline-flex items-center gap-x-1.5 rounded-lg border border-slate-200 bg-white px-3 py-1.5 text-xs font-semibold text-slate-700 shadow-sm transition hover:border-slate-900 hover:bg-slate-50", data: { turbo_frame: "_top" } do %>
                  <svg class="size-3.5" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z"/><circle cx="12" cy="12" r="3"/></svg>
                  View
                <% end %>
              </div>
            </div>
          <% end %>
        <% else %>
          <div class="rounded-2xl border border-dashed border-slate-300 bg-slate-50/50 p-8 text-center">
            <p class="text-sm font-medium text-slate-600">You have not submitted any refund requests yet.</p>
          </div>
        <% end %>
      </div>

      <div class="hidden lg:block overflow-x-auto">
        <table class="min-w-full">
          <thead class="bg-slate-100">
            <tr>
              <th scope="col" class="px-6 py-4 text-left text-[11px] font-semibold uppercase tracking-[0.1em] text-slate-600 sm:px-8">Confirmation</th>
              <th scope="col" class="px-6 py-4 text-left text-[11px] font-semibold uppercase tracking-[0.1em] text-slate-600">Hotel</th>
              <th scope="col" class="px-6 py-4 text-left text-[11px] font-semibold uppercase tracking-[0.1em] text-slate-600">Stay Dates</th>
              <th scope="col" class="px-6 py-4 text-left text-[11px] font-semibold uppercase tracking-[0.1em] text-slate-600">Requested</th>
              <th scope="col" class="px-6 py-4 text-left text-[11px] font-semibold uppercase tracking-[0.1em] text-slate-600">Status</th>
              <th scope="col" class="px-6 py-4 text-right text-[11px] font-semibold uppercase tracking-[0.1em] text-slate-600 sm:px-8">Action</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-200 bg-white">
            <% if @bookings.any? %>
              <% @bookings.each_with_index do |booking, index| %>
                <% rr = booking.refund_request %>
                <% status_classes = case rr.status
                   when "pending" then "text-amber-700"
                   when "approved" then "text-blue-700"
                   when "completed" then "text-emerald-700"
                   when "rejected" then "text-red-700"
                   else "text-slate-600"
                   end %>
                <% status_dot_classes = case rr.status
                   when "pending" then "bg-amber-500"
                   when "approved" then "bg-blue-500"
                   when "completed" then "bg-emerald-500"
                   when "rejected" then "bg-red-500"
                   else "bg-slate-400"
                   end %>

                <tr class="transition-colors hover:bg-slate-100/80 <%= index.even? ? 'bg-white' : 'bg-slate-50/55' %>">
                  <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-slate-900 sm:px-8">
                    <%= link_to booking.confirmation_token, guest_refund_request_path(rr), class: "text-blue-700 hover:text-blue-800", data: { turbo_frame: "_top" } %>
                  </td>
                  <td class="px-6 py-4 whitespace-nowrap text-sm text-slate-700"><%= booking.hotel.name %></td>
                  <td class="px-6 py-4 whitespace-nowrap text-sm text-slate-600"><%= booking.check_in.strftime("%d %b %Y") %> - <%= booking.check_out.strftime("%d %b %Y") %></td>
                  <td class="px-6 py-4 whitespace-nowrap text-sm text-slate-600"><%= rr.created_at.strftime("%d %b %Y, %I:%M %p") %></td>
                  <td class="px-6 py-4 whitespace-nowrap">
                    <div class="inline-flex items-center gap-2 text-sm font-medium <%= status_classes %>">
                      <span class="size-2.5 rounded-sm <%= status_dot_classes %>"></span>
                      <%= rr.status.humanize %>
                    </div>
                  </td>
                  <td class="px-6 py-4 text-right sm:px-8">
                    <div class="inline-flex items-center gap-2 justify-end">
                      <% if rr.rejected? %>
                        <%= link_to new_guest_booking_refund_request_path(booking, return_to: "list"), class: "inline-flex items-center gap-x-1.5 rounded-lg border border-red-200 bg-red-50 px-3 py-1.5 text-xs font-semibold text-red-700 shadow-sm transition hover:bg-red-100", data: { turbo_frame: "_top" } do %>
                          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="size-3.5"><path d="M12 18H4a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5"/><path d="m16 19 3 3 3-3"/><path d="M18 12h.01"/><path d="M19 16v6"/><path d="M6 12h.01"/><circle cx="12" cy="12" r="2"/></svg>
                          Resubmit
                        <% end %>
                      <% end %>
                      <%= link_to guest_refund_request_path(rr), class: "inline-flex items-center gap-x-1.5 rounded-lg border border-slate-200 bg-white px-3 py-1.5 text-xs font-semibold text-slate-700 shadow-sm transition hover:border-slate-900 hover:bg-slate-50", data: { turbo_frame: "_top" } do %>
                        <svg class="size-3.5" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z"/><circle cx="12" cy="12" r="3"/></svg>
                        View
                      <% end %>
                    </div>
                  </td>
                </tr>
              <% end %>
            <% else %>
              <tr>
                <td colspan="6" class="px-6 py-16 text-center text-sm font-medium text-slate-500 sm:px-8">You have not submitted any refund requests yet.</td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>

      <div class="px-6 py-5 border-t border-slate-200 bg-slate-50/50 flex justify-center sm:px-8">
        <%= paginate @bookings %>
      </div>
    <% end %>
  </div>
</div>
