<% content_for :title, "My Refunds | WAStays" %>

<div class="space-y-1">
  <h1 class="font-guest-display text-2xl font-semibold text-foreground md:text-3xl">My Refunds</h1>
  <p class="text-sm text-muted-foreground"><%= pluralize(@all_bookings.count, "refund request") %></p>
</div>

<%= render "guest/shared/filters",
      path: ->(**params) { guest_refund_requests_path(**params) },
      frame: "guest_refunds_results",
      placeholder: "Search by property, Ref, or Code",
      label: "Search refunds",
      labels: Guest::StatusBadges::REFUND.transform_values(&:label) %>

<%# target _top: a request opens as its own page, not inside the frame. %>
<%= turbo_frame_tag "guest_refunds_results", target: "_top", class: "block space-y-6" do %>
  <% if @bookings.any? %>
    <%= render GuestUI::Card.new(padding: :tight, class: "py-0") do |card| %>
      <% @bookings.each do |booking| %>
        <% refund_request = booking.refund_request %>
        <% card.with_row(
             label: booking.hotel.name,
             hint: "#{Guest::StatusBadges.refund(refund_request.status).label} · #{number_to_currency(refund_request.refund_amount, unit: "#{booking.currency} ")} · #{booking.confirmation_token.upcase} · Requested #{refund_request.created_at.strftime('%d %b %Y')}",
             href: guest_refund_request_path(refund_request)
           ) %>
      <% end %>
    <% end %>
  <% else %>
    <% if @search_query.present? || @status_filter.present? %>
      <%= render GuestUI::EmptyState.new(icon: "search-x", title: "No refund requests match",
                                         description: "Try another search, or pick a different status.") do |empty| %>
        <% empty.with_action do %>
          <%= render GuestUI::Button.new(label: "Clear filters", variant: :secondary, href: guest_refund_requests_path) %>
        <% end %>
      <% end %>
    <% else %>
      <%= render GuestUI::EmptyState.new(icon: "receipt", title: "No refund requests",
                                         description: "If a booking can be refunded, you can ask for it from that booking's page.") do |empty| %>
        <% empty.with_action do %>
          <%= render GuestUI::Button.new(label: "View bookings", variant: :secondary, href: guest_bookings_path) %>
        <% end %>
      <% end %>
    <% end %>
  <% end %>

  <%= render GuestUI::Pagination.new(pagy: @pagy) %>
<% end %>
