<% content_for :title, "My Refunds | WAStays" %>

<div class="space-y-1">
  <h1 class="font-guest-display text-2xl font-semibold text-foreground md:text-3xl">My Refunds</h1>
  <p class="text-sm text-muted-foreground"><%= pluralize(@all_bookings.count, "refund request") %></p>
</div>

<%= render "guest/shared/filters",
      path: ->(**params) { guest_refund_requests_path(**params) },
      frame: "guest_refunds_results",
      placeholder: "Search by property or booking code",
      label: "Search refunds" %>

<%# target _top: a request opens as its own page, not inside the frame. %>
<%= turbo_frame_tag "guest_refunds_results", target: "_top", class: "block space-y-6" do %>
  <% if @bookings.any? %>
    <%= render GuestUI::Card.new(padding: :tight, class: "py-0") do |card| %>
      <% @bookings.each do |booking| %>
        <% refund_request = booking.refund_request %>
        <% card.with_row(
             label: booking.hotel.name,
             hint: "#{refund_request.status.humanize} · #{number_to_currency(refund_request.refund_amount, unit: "#{booking.currency} ")} · #{booking.confirmation_token.upcase} · Requested #{refund_request.created_at.strftime('%d %b %Y')}",
             href: guest_refund_request_path(refund_request)
           ) %>
      <% end %>
    <% end %>
  <% else %>
    <%= render GuestUI::Card.new(variant: :dashed) do %>
      <p class="text-sm text-muted-foreground">No refund requests found.</p>
    <% end %>
  <% end %>

  <%= render GuestUI::Pagination.new(pagy: @pagy) %>
<% end %>
