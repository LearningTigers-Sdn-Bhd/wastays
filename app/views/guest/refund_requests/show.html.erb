<% content_for :title, "Refund Details | WAStays" %>
<%
  refund_status_messages = {
    "pending" => "Thanks for your patience. We have received your refund request and our team is reviewing it now.",
    "approved" => "Good news. Your refund request has been approved and we are preparing the payout.",
    "completed" => "Your refund is complete. The amount has been processed to your bank account.",
    "rejected" => "We are sorry. Your refund request could not be approved this time. Please check the property note for details."
  }
  notice_variants = { "approved" => :info, "completed" => :success, "rejected" => :danger }
  hotel = @booking.hotel
%>

<%# The concierge's split: the stay and where the request stands at a third,
    what the guest sent at two thirds. They stack on a phone, stay first. %>
<div class="guest-page__grid" data-columns="2">
  <div class="guest-page__context space-y-4">
    <%= render GuestUI::Card.new(class: "guest-stay-summary") do %>
      <div class="flex items-center justify-between gap-3">
        <h1 class="guest-card__title">Refund Status</h1>
        <span class="guest-stay-summary__status"><%= @refund_request.status.humanize %></span>
      </div>

      <p class="mt-4 font-guest-display text-2xl font-semibold leading-tight text-foreground"><%= hotel.name %></p>
      <p class="mt-1 text-sm font-semibold text-foreground"><%= guest_stay_dates(@booking) %></p>

      <dl class="guest-stay-summary__refs">
        <div class="flex items-baseline gap-1.5">
          <dt>Code</dt>
          <dd class="font-mono text-foreground"><%= @booking.confirmation_token.upcase %></dd>
        </div>
      </dl>
    <% end %>

    <%= render GuestUI::Notice.new(
          message: refund_status_messages[@refund_request.status] || "Your refund request is being processed. We will keep you updated.",
          variant: notice_variants.fetch(@refund_request.status, :info), alert: false
        ) %>

    <div class="flex flex-col gap-3">
      <% if @refund_request.rejected? %>
        <%= render GuestUI::Button.new(label: "Resubmit Refund Request", block: true,
                                       href: new_guest_booking_refund_request_path(@booking, return_to: "refund")) %>
      <% end %>
      <%= render GuestUI::Button.new(label: "View Booking", variant: :secondary, block: true,
                                     href: guest_booking_path(@booking)) %>
    </div>
  </div>

  <div class="guest-page__content">
    <% if @refund_request.hotel_note.present? %>
      <%= render GuestUI::Card.new(title: "Property Note") do %>
        <p class="text-sm text-foreground"><%= @refund_request.hotel_note %></p>
      <% end %>
    <% end %>

    <%= render GuestUI::Card.new(title: "Refund Request Summary") do %>
      <%= render GuestUI::FactList.new(facts: [
            [ "Requested On", @refund_request.created_at.strftime("%d %b %Y, %I:%M %p") ],
            [ "Refund Amount", number_to_currency(@refund_request.refund_amount, unit: "#{@booking.currency} ") ],
            [ "Check-in", @booking.check_in.strftime("%d %b %Y") ],
            [ "Check-out", @booking.check_out.strftime("%d %b %Y") ],
            [ "Original Booking Amount", number_to_currency(@booking.total_amount, unit: "#{@booking.currency} ") ]
          ]) %>
    <% end %>

    <%= render GuestUI::Card.new(title: "Submitted Details") do %>
      <%= render GuestUI::FactList.new(columns: 1, facts: [
            [ "Reason for Refund", @refund_request.reason.presence || "No reason provided." ]
          ]) %>
      <%= render GuestUI::FactList.new(class: "mt-4 border-t border-border/60 pt-4", facts: [
            [ "Bank Name", @refund_request.bank_name ],
            [ "Account Holder Name", @refund_request.account_holder_name ],
            [ "Account Number", @refund_request.account_number ],
            [ "Account Type", @refund_request.account_type.to_s.humanize ]
          ]) %>
    <% end %>
  </div>
</div>
