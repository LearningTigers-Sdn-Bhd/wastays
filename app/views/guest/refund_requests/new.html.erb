<% content_for :title, "Request Refund | WAStays" %>
<%
  post_stay = @refund_mode == :post_stay
  resubmission = @booking.refund_request&.rejected?
  go_back_path, go_back_label =
    if @return_to == "list"
      [ guest_bookings_path, "Back to bookings" ]
    elsif @return_to == "refund" && @booking.refund_request.present?
      [ guest_refund_request_path(@booking.refund_request), "Back to refund request" ]
    else
      [ guest_booking_path(@booking), "Back to booking" ]
    end

  title = if post_stay then "Ask for a refund"
          elsif resubmission then "Resubmit your request"
          else "Request a refund"
          end
  subtitle = if post_stay then "This is a request, not a payment. The property reads it and replies to you."
             elsif resubmission then "Check your details and send the request again. The property reviews it."
             else "Cancel this booking and ask for a refund under the property's policy."
             end
%>

<%# The concierge's form frame. On a phone: the compact stay card, which is
    also the way back, then the heading, then the form. From md: the back
    link and the heading across the top, the stay card beside the form. %>
<div class="guest-form-page" data-columns="2" data-width="form">
  <div class="guest-form-page__compact md:hidden">
    <%= render "public/concierge/shared/summary_compact",
               path: go_back_path, back_label: go_back_label,
               title: @booking.hotel.name, detail: guest_stay_dates(@booking),
               aside: Guest::StatusBadges.booking(@booking.status).label %>
  </div>

  <div class="guest-form-page__header">
    <%= render "public/concierge/stays/shared/page_heading",
               back_path: go_back_path, back_label: go_back_label, back_display: "hidden md:inline-flex",
               title:, subtitle: %>
  </div>

  <div class="guest-form-page__summary hidden md:block">
    <%= render guest_stay_summary(@booking, eyebrow: "Your Stay") %>
  </div>

  <div class="guest-form-page__body space-y-6">
    <% if resubmission && @booking.refund_request.hotel_note.present? %>
      <%= render GuestUI::Notice.new(title: "The property asked for a change", message: @booking.refund_request.hotel_note,
                                     variant: :warning) %>
    <% end %>

    <% if !post_stay && !resubmission %>
      <%= render GuestUI::Notice.new(
            title: "This cancels your booking",
            message: "You cannot undo it. The property releases your room and pays the refund into the bank account below.",
            variant: :danger, alert: false
          ) %>
    <% end %>

    <% if !post_stay && @refund_policy.present? && @estimated_refund_amount %>
      <%= render GuestUI::Notice.new(
            title: "You get #{number_to_percentage(@refund_percentage, precision: 0)} back, about #{number_to_currency(@estimated_refund_amount, unit: "#{@booking.currency} ")}",
            message: "Of the #{number_to_currency(@booking.total_amount, unit: "#{@booking.currency} ")} you paid. Requests close #{pluralize(@refund_policy.min_days_before_checkin, 'day')} before check-in."
          ) %>
    <% end %>

    <%= form_with model: @refund_request, url: guest_booking_refund_requests_path(@booking), scope: :refund_request,
          method: :post, local: true, class: "space-y-5" do |form| %>
      <%= hidden_field_tag :return_to, @return_to %>

      <%= render "shared/refunds/fields", form:, booking: @booking, mode: @refund_mode %>

      <% if post_stay %>
        <%= render GuestUI::Button.new(label: "Send my request", size: :lg, block: true, type: "submit",
                                       data: { turbo_submits_with: "Sending…" }) %>
      <% else %>
        <%= render GuestUI::Button.new(
              label: (resubmission ? "Resubmit Refund Request" : "Submit Request and Cancel Booking"),
              variant: (resubmission ? :primary : :destructive), size: :lg, block: true, type: "submit",
              confirm: (resubmission ? "Resubmit this refund request for review?" : "This cancels your booking at once and cannot be undone. Continue?"),
              data: { turbo_submits_with: "Sending…" }
            ) %>
      <% end %>
    <% end %>
  </div>
</div>
