<% content_for :title, "Request Refund | WAStays" %>
<%
  resubmission = @booking.refund_request&.rejected?
  go_back_path = if @return_to == "list"
    guest_bookings_path
  elsif @return_to == "refund" && @booking.refund_request.present?
    guest_refund_request_path(@booking.refund_request)
  else
    guest_booking_path(@booking)
  end
%>

<div class="mx-auto w-full max-w-2xl space-y-6">
  <div class="space-y-1">
    <h1 class="font-guest-display text-2xl font-semibold text-foreground md:text-3xl">Request Refund</h1>
    <p class="font-mono text-sm text-muted-foreground"><%= @booking.confirmation_token.upcase %></p>
  </div>

  <% if resubmission %>
    <%= render GuestUI::Notice.new(
          title: "You are resubmitting your refund request for review.",
          message: "Your booking is already cancelled. Please confirm your latest details before resubmitting.",
          variant: :warning
        ) %>
  <% else %>
    <%= render GuestUI::Notice.new(
          title: "Submitting this request will immediately cancel your booking.",
          message: "This action cannot be undone. Your room will be released. The refund will be processed manually to your bank account below.",
          variant: :danger, alert: false
        ) %>
  <% end %>

  <%= render GuestUI::Card.new(title: "Booking Summary") do %>
    <%= render GuestUI::FactList.new(facts: [
          [ "Property", @booking.hotel.name ],
          [ "Total Paid", number_to_currency(@booking.total_amount, unit: "#{@booking.currency} ") ],
          [ "Check-in", @booking.check_in.strftime("%d %b %Y") ],
          [ "Check-out", @booking.check_out.strftime("%d %b %Y") ]
        ]) %>

    <% if @refund_policy.present? %>
      <div class="mt-4 border-t border-border/60 pt-4">
        <p class="text-sm font-semibold text-foreground">
          You are eligible for <%= number_to_percentage(@refund_percentage, precision: 0) %> refund
          (<%= number_to_currency(@estimated_refund_amount, unit: "#{@booking.currency} ") %> estimated).
        </p>
        <p class="mt-1 text-xs text-muted-foreground">
          Request must be submitted at least <%= pluralize(@refund_policy.min_days_before_checkin, "day") %> before check-in.
        </p>
      </div>
    <% end %>
  <% end %>

  <%= form_with model: @refund_request, url: guest_booking_refund_requests_path(@booking), method: :post,
        local: true, class: "space-y-6" do |form| %>
    <%= hidden_field_tag :return_to, @return_to %>

    <%= render GuestUI::Card.new(title: "Reason for Refund") do %>
      <%= render GuestUI::FormField.new(form:, attribute: :reason,
                                        label: "Why are you asking for a refund?") do |field| %>
        <% field.with_text_area(rows: 4, placeholder: "For example: change of travel plans") %>
      <% end %>
    <% end %>

    <%= render GuestUI::Card.new do %>
      <%# A fieldset, so a screen reader names the group with each field in it. %>
      <fieldset class="guest-fieldset" aria-describedby="refund-bank-details-description">
        <legend class="guest-fieldset__legend">Bank Account Details</legend>
        <p id="refund-bank-details-description" class="guest-fieldset__description">
          The refund goes into this account. Check the details against your bank card or app.
        </p>

        <%
          bank_fields = {
            bank_name: { label: "Bank name", placeholder: "For example: Maybank", autocomplete: "off" },
            account_holder_name: { label: "Account holder name", placeholder: "The name on the account", autocomplete: "name" },
            account_number: { label: "Account number", placeholder: "For example: 1234 5678 9012", autocomplete: "off" }
          }
        %>
        <% bank_fields.each do |attribute, options| %>
          <%= render GuestUI::FormField.new(form:, attribute:, label: options[:label], required: true) do |field| %>
            <% field.with_input(autocomplete: options[:autocomplete], placeholder: options[:placeholder]) %>
          <% end %>
        <% end %>

        <%= render GuestUI::FormField.new(form:, attribute: :account_type, label: "Account type", required: true) do |field| %>
          <% field.with_radio_group(layout: :stacked,
                                    choices: @presenter.account_type_options.map { |label, value| { label:, value: } }) %>
        <% end %>
      </fieldset>
    <% end %>

    <div class="flex flex-col-reverse gap-3 sm:flex-row sm:justify-end">
      <%= render GuestUI::Button.new(label: "Go Back", variant: :secondary, href: go_back_path) %>
      <%= render GuestUI::Button.new(
            label: (resubmission ? "Resubmit Refund Request" : "Submit Request and Cancel Booking"),
            variant: (resubmission ? :primary : :destructive), type: "submit",
            confirm: (resubmission ? "Resubmit this refund request for review?" : "This cancels your booking at once and cannot be undone. Continue?"),
            data: { turbo_submits_with: "Sending…" }
          ) %>
    </div>
  <% end %>
</div>
