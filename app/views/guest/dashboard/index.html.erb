<% content_for :title, "Home | WAStays" %>

<div class="space-y-1">
  <h1 class="font-guest-display text-2xl font-semibold text-foreground md:text-3xl">
    Hello, <%= current_guest.name.split.first %>
  </h1>
  <p class="text-sm text-muted-foreground">
    <%= pluralize(@total_bookings, "booking") %> · <%= pluralize(@upcoming_bookings.size, "upcoming stay") %>
  </p>
</div>

<% if (next_stay = @upcoming_bookings.first) %>
  <%= render GuestUI::Card.new(class: "guest-stay-summary") do %>
    <div class="flex items-start justify-between gap-3">
      <p class="text-xs font-bold uppercase tracking-widest text-muted-foreground">
        <%= next_stay.check_in.to_date <= Date.current ? "Current stay" : "Next stay" %>
      </p>
      <span class="guest-stay-summary__status"><%= guest_booking_status(next_stay).humanize %></span>
    </div>
    <h2 class="mt-2 font-guest-display text-2xl font-semibold text-foreground"><%= next_stay.hotel.name %></h2>
    <p class="mt-1 text-sm text-muted-foreground">
      <%= next_stay.check_in.strftime("%d %b") %> – <%= next_stay.check_out.strftime("%d %b %Y") %>
      · <%= pluralize((next_stay.check_out.to_date - next_stay.check_in.to_date).to_i, "night") %>
    </p>
    <div class="mt-5 flex flex-wrap gap-3">
      <%= render GuestUI::Button.new(
            href: concierge_home_path(hotel_code: next_stay.hotel.unique_id, public_id: next_stay.hotel.public_id)
          ) { "Open concierge" } %>
      <%= render GuestUI::Button.new(href: guest_booking_path(next_stay), variant: :secondary) { "View booking" } %>
    </div>
  <% end %>
<% end %>

<%= render GuestUI::Card.new do |card| %>
  <div class="flex items-center justify-between gap-3">
    <h2 class="guest-card__title">Recent Bookings</h2>
    <%= link_to "See all", guest_bookings_path, class: "text-sm font-bold text-primary hover:underline" %>
  </div>

  <% recent = (@upcoming_bookings + @past_bookings).first(5) %>
  <% recent.each do |booking| %>
    <% card.with_row(
         label: booking.hotel.name,
         hint: "#{booking.check_in.strftime('%d %b')} – #{booking.check_out.strftime('%d %b %Y')} · #{guest_booking_status(booking).humanize}",
         href: guest_booking_path(booking)
       ) %>
  <% end %>
  <% if recent.empty? %>
    <p class="mt-4 text-sm text-muted-foreground">No bookings yet.</p>
  <% end %>
<% end %>
