<% content_for :title, "Home | WAStays" %>

<div class="space-y-1">
  <h1 class="font-guest-display text-2xl font-semibold text-foreground md:text-3xl">
    Hello, <span class="text-primary"><%= current_guest.name %></span>
  </h1>
  <p class="text-sm text-muted-foreground">Your stays, documents, and refunds, all in one place.</p>
</div>

<section class="guest-stat-grid" aria-label="Your stays at a glance">
  <%= render GuestUI::StatCard.new(label: "Total bookings", value: @stats[:total], icon: "calendar-days", tone: :info) %>
  <%= render GuestUI::StatCard.new(label: "Upcoming", value: @stats[:upcoming], icon: "calendar-clock", tone: :warning) %>
  <%= render GuestUI::StatCard.new(label: "In house", value: @stats[:in_house], icon: "door-open", tone: :success) %>
  <%= render GuestUI::StatCard.new(label: "Refunds requested", value: @stats[:refunds], icon: "receipt", tone: :destructive) %>
</section>

<% if (next_stay = @next_stay) %>
  <%= render guest_stay_summary(next_stay, eyebrow: (next_stay.check_in.to_date <= Date.current ? "Current stay" : "Next stay")) do |summary| %>
    <% summary.with_actions do %>
      <%= render "guest/bookings/concierge_button", booking: next_stay %>
      <%= render GuestUI::Button.new(label: "View booking", href: guest_booking_path(next_stay), variant: :secondary) %>
    <% end %>
  <% end %>
<% end %>

<% if @stats[:total].zero? %>
  <%= render "guest/shared/no_bookings" %>
<% elsif @recent_bookings.any? %>
  <section class="space-y-3" aria-labelledby="recent-bookings-title">
    <div class="flex items-center justify-between gap-3">
      <h2 id="recent-bookings-title" class="guest-card__title">Recent Bookings</h2>
      <%= link_to "See all", guest_bookings_path, class: "text-sm font-bold text-primary hover:underline" %>
    </div>
    <div class="guest-booking-grid">
      <% @recent_bookings.each do |booking| %>
        <%= render guest_booking_card(booking) %>
      <% end %>
    </div>
  </section>
<% end %>
