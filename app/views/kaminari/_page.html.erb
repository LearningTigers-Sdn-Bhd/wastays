<% if page.current? %>
  <span class="hidden sm:flex min-w-[38px] min-h-[38px] justify-center items-center bg-primary text-primary-foreground border border-border-interactive py-2 px-3 text-sm font-semibold z-10 shadow-sm" aria-current="page">
    <%= page %>
  </span>
<% else %>
  <%= link_to page, url, remote: remote, rel: page.rel, class: "hidden sm:flex min-w-[38px] min-h-[38px] justify-center items-center border border-border text-foreground hover:bg-muted-hover py-2 px-3 text-sm font-medium transition-colors" %>
<% end %>
