<% if page.current? %>
  <button type="button" class="min-w-[40px] flex justify-center items-center bg-blue-600 text-white py-2.5 px-3 text-sm font-medium rounded-lg focus:outline-none" aria-current="page">
    <%= page %>
  </button>
<% else %>
  <%= link_to page, url, remote: remote, rel: page.rel, class: "min-w-[40px] flex justify-center items-center text-gray-800 hover:bg-gray-100 py-2.5 px-3 text-sm font-medium rounded-lg focus:outline-none focus:bg-gray-100" %>
<% end %>
