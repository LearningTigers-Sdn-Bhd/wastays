<% if current_page.last? %>
  <span class="min-w-[38px] min-h-[38px] flex justify-center items-center border border-neutral-border text-muted-foreground-2 py-2 px-3 text-sm font-medium rounded-e-lg sm:rounded-none cursor-not-allowed">
    <svg class="size-3.5" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg>
  </span>
<% else %>
  <%= link_to url, remote: remote, rel: 'next', class: "min-w-[38px] min-h-[38px] flex justify-center items-center border border-neutral-border text-neutral-text-primary hover:bg-surface-hover py-2 px-3 text-sm font-medium rounded-e-lg sm:rounded-none transition-colors" do %>
    <svg class="size-3.5" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg>
  <% end %>
<% end %>
