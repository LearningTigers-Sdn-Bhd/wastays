<nav class="flex items-center sm:-space-x-px justify-center sm:justify-start gap-x-1 sm:gap-x-0" aria-label="Pagination">
  <%= paginator.render do %>
    <%= first_page_tag %>
    <%= prev_page_tag %>
    
    <% each_page do |page| %>
      <% if page.display_tag? %>
        <%= page_tag page %>
      <% elsif !page.was_truncated? %>
        <%= gap_tag %>
      <% end %>
    <% end %>

    <%# Mobile "1 of 3" style - hidden on sm and up %>
    <div class="flex sm:hidden items-center px-1 gap-x-1.5">
      <span class="min-h-[38px] min-w-[38px] flex justify-center items-center border border-border text-foreground py-2 px-3 text-sm rounded-lg">
        <%= current_page %>
      </span>
      <span class="text-muted-foreground text-sm">of</span>
      <span class="text-muted-foreground text-sm"><%= total_pages %></span>
    </div>

    <%= next_page_tag %>
    <%= last_page_tag %>
  <% end %>

  <% if total_pages <= 1 %>
    <div class="flex items-center sm:-space-x-px justify-center sm:justify-start gap-x-1 sm:gap-x-0">
      <span class="min-w-[38px] min-h-[38px] flex justify-center items-center border border-border text-muted-foreground rounded-lg sm:rounded-none sm:rounded-s-lg cursor-not-allowed">
        <svg class="size-3.5" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg>
      </span>
      <span class="min-w-[38px] min-h-[38px] flex justify-center items-center bg-muted text-foreground border border-border py-2 px-3 text-sm font-medium z-10 rounded-lg sm:rounded-none" aria-current="page">1</span>
      <span class="min-w-[38px] min-h-[38px] flex justify-center items-center border border-border text-muted-foreground rounded-lg sm:rounded-none sm:rounded-e-lg cursor-not-allowed">
        <svg class="size-3.5" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg>
      </span>
    </div>
  <% end %>
</nav>
