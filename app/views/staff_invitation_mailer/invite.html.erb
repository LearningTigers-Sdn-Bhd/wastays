<!DOCTYPE html>
<html>
  <head>
    <meta content="text/html; charset=UTF-8" http-equiv="Content-Type">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
  </head>
  <body style="margin:0;padding:0;background-color:#f5f4f0;font-family:'Inter',Arial,sans-serif;">
    <table width="100%" cellpadding="0" cellspacing="0" style="background-color:#f5f4f0;padding:40px 0;">
      <tr>
        <td align="center">
          <table width="520" cellpadding="0" cellspacing="0" style="background:#ffffff;border-radius:24px;overflow:hidden;border:1px solid #e8e5df;box-shadow:0 4px 6px -1px rgba(0,0,0,0.05);">
            <tr>
              <td style="background-color:#0f4a43;padding:40px;text-align:center;">
                <img src="<%= attachments['long-logo.png'].url %>" alt="WAStays" style="height:44px;width:auto;display:inline-block;">
              </td>
            </tr>
            <tr>
              <td style="padding:48px 40px;">
                <p style="margin:0 0 12px;font-size:24px;font-weight:700;color:#0f172a;letter-spacing:-0.02em;">Join <%= @hotel.name %> on WAStays</p>
                <p style="margin:0 0 28px;font-size:16px;color:#475569;line-height:1.7;">
                  <%= @inviter.name %> invited you to access <strong><%= @hotel.name %></strong> as <strong><%= @role.name %></strong>.
                </p>

                <table cellpadding="0" cellspacing="0" style="margin:0 auto 32px;">
                  <tr>
                    <td style="background-color:#0f4a43;border-radius:14px;text-align:center;">
                      <a href="<%= @accept_url %>" style="color:#ffffff;font-size:16px;font-weight:700;text-decoration:none;display:block;padding:18px 36px;letter-spacing:0.01em;">
                        Accept Invitation
                      </a>
                    </td>
                  </tr>
                </table>

                <p style="margin:0 0 32px;font-size:14px;color:#64748b;text-align:center;line-height:1.6;">
                  For security, this invitation expires on <%= l(@expires_at, format: :long) %>.
                </p>

                <div style="background-color:#f8fafc;border-radius:12px;padding:20px;text-align:center;">
                  <p style="margin:0 0 8px;font-size:12px;font-weight:600;color:#94a3b8;text-transform:uppercase;letter-spacing:0.05em;">Trouble with the button?</p>
                  <p style="margin:0;font-size:11px;color:#94a3b8;word-break:break-all;line-height:1.5;"><%= @accept_url %></p>
                </div>

                <hr style="border:none;border-top:1px solid #f1f5f9;margin:40px 0;">

                <p style="margin:0;font-size:13px;color:#94a3b8;line-height:1.6;text-align:center;">
                  If you were not expecting this invitation, you can safely ignore this email.
                </p>
              </td>
            </tr>
            <tr>
              <td style="background-color:#faf9f6;padding:24px 40px;text-align:center;border-top:1px solid #f1f5f9;">
                <p style="margin:0;font-size:12px;color:#94a3b8;">&copy; <%= Date.current.year %> WAStays. All rights reserved.</p>
              </td>
            </tr>
          </table>
        </td>
      </tr>
    </table>
  </body>
</html>
