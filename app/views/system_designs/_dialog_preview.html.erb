<section aria-labelledby="dialog-preview-heading" class="border-t border-border pt-8">
  <h2 id="dialog-preview-heading" class="text-lg font-semibold text-foreground">Dialog</h2>
  <p class="mt-1 mb-5 text-sm text-muted-foreground">
    Native <code>&lt;dialog&gt;</code> — focus trap, Escape, top-layer and backdrop are browser-native.
    The component renders only the dialog; triggers are external via the native
    <code>command="show-modal"</code> invoker attributes.
  </p>

  <div class="flex flex-wrap items-center gap-3">
    <%# Default dialog: string title + description, dismissible, content + footer slots %>
    <%= render PanelsUI::Button.new(variant: :primary, command: "show-modal", commandfor: "sd-dialog") do %>
      Open dialog
    <% end %>
    <%= render PanelsUI::Dialog.new(
          id: "sd-dialog",
          size: :md,
          title: "Invite teammate",
          description: "Send an invitation to collaborate on this property.") do |dialog| %>
      <% dialog.with_body do %>
        <div class="space-y-4">
          <p>They'll get an email with a join link. You can revoke access at any time.</p>
          <%= render PanelsUI::Button.new(
                id: "sd-dialog-stack-trigger",
                variant: :secondary,
                command: "show-modal",
                commandfor: "sd-dialog-confirm") do %>
            Review permissions
          <% end %>
        </div>
      <% end %>
      <% dialog.with_footer do %>
        <%= render PanelsUI::Button.new(variant: :secondary, data: { action: "panels-ui--dialog#close" }) do %>
          Cancel
        <% end %>
        <%= render PanelsUI::Button.new(variant: :primary) do %>
          Send invite
        <% end %>
      <% end %>
    <% end %>

    <%# Stacked child: a DOM sibling opened from inside the default dialog. %>
    <%= render PanelsUI::Dialog.new(
          id: "sd-dialog-confirm",
          size: :sm,
          title: "Confirm permissions",
          description: "This dialog is stacked above the invitation dialog.") do |dialog| %>
      <% dialog.with_body do %>
        <p>The invitation dialog remains open and inert underneath this confirmation.</p>
      <% end %>
      <% dialog.with_footer do %>
        <%= render PanelsUI::Button.new(variant: :primary, data: { action: "panels-ui--dialog#close" }) do %>
          Back to invitation
        <% end %>
      <% end %>
    <% end %>

    <%# almost-full: fills the viewport with a gap-6 frame, keeps rounding %>
    <%= render PanelsUI::Button.new(variant: :secondary, command: "show-modal", commandfor: "sd-dialog-almost") do %>
      Open almost-full
    <% end %>
    <%= render PanelsUI::Dialog.new(
          id: "sd-dialog-almost",
          size: :almost_full,
          title: "Almost-full",
          description: "Fills the viewport minus a 1.5rem frame; body scrolls.") do |dialog| %>
      <% dialog.with_body do %>
        <div class="space-y-3">
          <% 20.times do |i| %>
            <p>Scrollable row <%= i + 1 %> — the header and footer stay pinned while this region scrolls.</p>
          <% end %>
        </div>
      <% end %>
      <% dialog.with_footer do %>
        <%= render PanelsUI::Button.new(variant: :primary, data: { action: "panels-ui--dialog#close" }) do %>
          Done
        <% end %>
      <% end %>
    <% end %>

    <%# full: edge-to-edge, no rounding %>
    <%= render PanelsUI::Button.new(variant: :secondary, command: "show-modal", commandfor: "sd-dialog-full") do %>
      Open full
    <% end %>
    <%= render PanelsUI::Dialog.new(
          id: "sd-dialog-full",
          size: :full,
          title: "Full screen",
          description: "Edge-to-edge, no rounded corners.") do |dialog| %>
      <% dialog.with_body do %>
        <p>Occupies the whole viewport — useful for immersive editors or wizards.</p>
      <% end %>
      <% dialog.with_footer do %>
        <%= render PanelsUI::Button.new(variant: :primary, data: { action: "panels-ui--dialog#close" }) do %>
          Close
        <% end %>
      <% end %>
    <% end %>

    <%# Non-dismissible dialog: no close ✕, closes only via an explicit action %>
    <%= render PanelsUI::Button.new(variant: :secondary, command: "show-modal", commandfor: "sd-dialog-bare") do %>
      Open bare (non-dismissible)
    <% end %>
    <%= render PanelsUI::Dialog.new(
          id: "sd-dialog-bare",
          size: :sm,
          dismissible: false,
          title: "Heads up",
          description: "Not dismissible — closes only via an explicit action.") do |dialog| %>
      <% dialog.with_footer do %>
        <%= render PanelsUI::Button.new(variant: :primary, data: { action: "panels-ui--dialog#close" }) do %>
          Got it
        <% end %>
      <% end %>
    <% end %>
  </div>
</section>
