<section aria-labelledby="tabs-preview-heading" class="border-t border-border pt-8">
  <h2 id="tabs-preview-heading" class="text-lg font-semibold text-foreground">Tabs</h2>
  <p class="mt-1 mb-5 text-sm text-muted-foreground">
    WAI-ARIA APG tabs: roving tabindex, arrow/Home/End keys, and <code>?tab=</code> URL sync.
    The active tab drives the breadcrumb below through a Stimulus <strong>outlet</strong> —
    no global DOM query.
  </p>

  <div class="space-y-6">
    <%# Standalone tabs with panels %>
    <%= render PanelsUI::Tabs.new(id: "sd-tabs", default: "history", aria_label: "Night audit sections") do |t| %>
      <% t.with_tab(name: "history", label: "Audit History", icon: "history", count: 12) %>
      <% t.with_tab(name: "advanced", label: "Advanced Actions", icon: "settings-2") %>
      <% t.with_tab(name: "exports", label: "Exports", icon: "download", count: 3) %>

      <% t.with_panel(name: "history") do %>
        <div class="rounded-lg border border-border bg-card p-4 text-sm text-foreground">Audit history panel content.</div>
      <% end %>
      <% t.with_panel(name: "advanced") do %>
        <div class="rounded-lg border border-border bg-card p-4 text-sm text-foreground">Advanced actions panel content.</div>
      <% end %>
      <% t.with_panel(name: "exports") do %>
        <div class="rounded-lg border border-border bg-card p-4 text-sm text-foreground">Exports panel content.</div>
      <% end %>
    <% end %>

    <%# Outlet integration: switching tabs updates the tab label (and subtab segment) below %>
    <div data-testid="tabs-breadcrumb-demo" class="space-y-3">
      <%= render PanelsUI::Breadcrumb.new(id: "sd-tabs-bc", parts: [
        { type: :section, label: "Property" },
        { type: :menu, label: "Rates & Inventory", path: "#" },
        { label: "Calendar", tab_label: true },
        { label: "—", subtab_label: true, hidden: true }
      ]) %>

      <%= render PanelsUI::Tabs.new(id: "sd-tabs-linked", default: "calendar", breadcrumb_id: "sd-tabs-bc") do |t| %>
        <% t.with_tab(name: "calendar", label: "Calendar") %>
        <% t.with_tab(name: "bulk", label: "Bulk Edit", show_subtab_breadcrumb: true) %>
        <% t.with_tab(name: "restrictions", label: "Restrictions") %>
      <% end %>

      <%= render PanelsUI::Tabs.new(
            id: "sd-subtabs-linked",
            default: "pricing",
            param: "subtab",
            level: :secondary,
            breadcrumb_id: "sd-tabs-bc"
          ) do |t| %>
        <% t.with_tab(name: "pricing", label: "Pricing Rules") %>
        <% t.with_tab(name: "overrides", label: "Availability Overrides") %>
      <% end %>
    </div>
  </div>
</section>
