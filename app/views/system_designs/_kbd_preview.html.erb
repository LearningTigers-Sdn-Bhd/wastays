<section aria-labelledby="kbd-preview-heading" class="border-t border-border pt-8">
  <h2 id="kbd-preview-heading" class="text-lg font-semibold text-foreground">Keyboard shortcut</h2>
  <p class="mt-1 text-sm text-muted-foreground">
    Compact keycaps for displaying single keys and shortcut combinations.
  </p>

  <div class="mt-5 grid gap-5 lg:grid-cols-2">
    <% [ [ "panel-light", "Light" ], [ "panel-dark", "Dark" ] ].each do |theme, theme_label| %>
      <div class="rounded-2xl border border-border bg-card p-5 text-card-foreground shadow-sm" data-theme="<%= theme %>">
        <h3 class="text-sm font-semibold"><%= theme_label %> keycaps</h3>

        <div class="mt-4 flex flex-wrap items-center gap-2" aria-label="Keyboard shortcut examples">
          <kbd class="panel-kbd">⌘</kbd>
          <kbd class="panel-kbd">K</kbd>
          <kbd class="panel-kbd">Ctrl</kbd>
          <kbd class="panel-kbd">Shift</kbd>
          <kbd class="panel-kbd">P</kbd>
          <kbd class="panel-kbd">⇧</kbd>
          <kbd class="panel-kbd">Enter</kbd>
        </div>

        <div class="mt-5 flex flex-wrap items-center gap-3 text-sm text-muted-foreground">
          <span class="inline-flex items-center gap-1.5">
            <kbd class="panel-kbd" data-size="sm">⌘</kbd>
            <kbd class="panel-kbd" data-size="sm">K</kbd>
            <span>Search</span>
          </span>
          <span class="inline-flex items-center gap-1.5">
            <kbd class="panel-kbd" data-size="lg">Enter</kbd>
            <span>Confirm</span>
          </span>
        </div>
      </div>
    <% end %>
  </div>
</section>
