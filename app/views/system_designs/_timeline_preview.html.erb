<section aria-labelledby="timeline-preview-heading" class="border-t border-border pt-8">
  <h2 id="timeline-preview-heading" class="text-base font-semibold text-foreground">Timeline</h2>
  <p class="mb-5 mt-1 text-sm text-muted-foreground">
    A centre-anchored stay tape over reusable half-day tracks, with dated operational blocks on a separate visual lane.
  </p>

  <%
    dates = (Date.new(2026, 7, 16)..Date.new(2026, 7, 22)).map do |date|
      {
        label: date.strftime("%a"),
        metadata: date.strftime("%-d %b"),
        accessible_label: date.to_fs(:long),
        current: date == Date.new(2026, 7, 16)
      }
    end
    capabilities = ::StayView::Capabilities.new(
      **::StayView::Capabilities.members.index_with { false }.merge(view_board: true, view_booking: true)
    )
    cells_for = lambda do
      dates.each_with_index.map do |date, index|
        ::StayView::DayCell.new(
          date: Date.new(2026, 7, 16) + index.days,
          occupancies: [],
          operational_kinds: []
        )
      end
    end
    rooms = [
      ::StayView::RoomRow.new(
        key: "deluxe:101",
        dom_id: "timeline-preview-room-101",
        room_number: "101",
        room_type_id: 1,
        room_type_name: "Deluxe King",
        smoking_allowed: false,
        pets_allowed: false,
        current_physical_status: :ready,
        operational_flags: {},
        day_cells: cells_for.call,
        booking_segments: [
          ::StayView::BookingSegment.new(
            dom_id: "timeline-preview-booking-grace",
            booking_id: 2,
            booking_room_id: 12,
            guest_label: "Grace Hopper and the International Computing Society delegation",
            status: :checked_in,
            check_in: Date.new(2026, 7, 14),
            check_out: Date.new(2026, 7, 20),
            start_track: 1,
            end_track: 10,
            clipped_left: true,
            clipped_right: false,
            accessible_label: "Grace Hopper, checked in, continues from before this range, room 101, Deluxe King, 14 July 2026 to 20 July 2026",
            capabilities: capabilities
          ),
          ::StayView::BookingSegment.new(
            dom_id: "timeline-preview-booking-ada",
            booking_id: 1,
            booking_room_id: 11,
            guest_label: "Ada Lovelace",
            status: :confirmed,
            check_in: Date.new(2026, 7, 20),
            check_out: Date.new(2026, 7, 21),
            start_track: 10,
            end_track: 12,
            clipped_left: false,
            clipped_right: false,
            accessible_label: "Ada Lovelace, confirmed, room 101, Deluxe King, 20 July 2026 to 21 July 2026",
            capabilities: capabilities
          )
        ],
        operational_segments: [],
        capabilities: capabilities
      ),
      ::StayView::RoomRow.new(
        key: "deluxe:102",
        dom_id: "timeline-preview-room-102",
        room_number: "102",
        room_type_id: 1,
        room_type_name: "Deluxe King with an intentionally long room type name",
        smoking_allowed: false,
        pets_allowed: true,
        current_physical_status: :cleaning,
        operational_flags: {},
        day_cells: cells_for.call,
        booking_segments: [],
        operational_segments: [
          ::StayView::OperationalSegment.new(
            dom_id: "timeline-preview-block-102",
            kind: :maintenance,
            label: "Air-conditioning maintenance",
            start_date: Date.new(2026, 7, 18),
            end_date: Date.new(2026, 7, 20),
            start_track: 5,
            end_track: 9,
            clipped_left: false,
            clipped_right: false,
            accessible_label: "Air-conditioning maintenance, room 102, 18 July 2026 to 19 July 2026",
            capabilities: capabilities
          )
        ],
        capabilities: capabilities
      ),
      ::StayView::RoomRow.new(
        key: "deluxe:103",
        dom_id: "timeline-preview-room-103",
        room_number: "103",
        room_type_id: 1,
        room_type_name: "Deluxe King",
        smoking_allowed: false,
        pets_allowed: false,
        current_physical_status: :dirty,
        operational_flags: {},
        day_cells: cells_for.call,
        booking_segments: [],
        operational_segments: [],
        capabilities: capabilities
      )
    ]
  %>

  <div class="space-y-5">
    <% [ [ "panel-light", "Light" ], [ "panel-dark", "Dark" ] ].each do |theme, theme_label| %>
      <section aria-labelledby="timeline-<%= theme %>-heading" data-theme="<%= theme %>" class="space-y-3 bg-background text-foreground">
        <h3 id="timeline-<%= theme %>-heading" class="text-sm font-medium"><%= theme_label %> theme</h3>

        <%= render PanelsUI::Timeline::Table.new(
              id: "timeline-preview-#{theme}",
              caption: "Seven-day hotel stay timeline in #{theme_label.downcase} theme",
              track_count: dates.size * 2,
              density: :compact) do |timeline| %>
          <% timeline.with_header(room_label: "Room", dates: dates) %>
          <% group = timeline.with_group(label: "Deluxe King", count: rooms.size) %>
          <% rooms.each do |room| %>
            <% row = group.with_row(accessible_label: "Room #{room.room_number}, #{room.room_type_name}", id: "#{room.dom_id}-#{theme}") %>
            <% row.with_summary { render HotelPortal::StayView::RoomSummary.new(room: room) } %>
            <% room.day_cells.each_with_index do |cell, index| %>
              <% row.with_cell(
                   position: index + 1,
                   accessible_label: "Room #{room.room_number}, #{cell.date.to_fs(:long)}",
                   current: cell.date == Date.new(2026, 7, 16)) %>
            <% end %>
            <% room.booking_segments.each do |segment| %>
              <% row.with_segment do %>
                <%= render HotelPortal::StayView::BookingBar.new(
                      segment: segment,
                      href: "#timeline-preview-heading",
                      id: "#{segment.dom_id}-#{theme}") %>
              <% end %>
            <% end %>
            <% room.operational_segments.each do |segment| %>
              <% row.with_segment do %>
                <%= render HotelPortal::StayView::OperationalBar.new(
                      segment: segment,
                      id: "#{segment.dom_id}-#{theme}") %>
              <% end %>
            <% end %>
          <% end %>
        <% end %>
      </section>
    <% end %>
  </div>
</section>
