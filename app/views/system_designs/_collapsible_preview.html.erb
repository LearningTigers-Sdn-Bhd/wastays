<section aria-labelledby="collapsible-preview-heading" class="border-t border-border pt-8">
  <h2 id="collapsible-preview-heading" class="text-lg font-semibold text-foreground">Collapsible</h2>
  <p class="mt-1 mb-5 text-sm text-muted-foreground">
    A shadcn-style disclosure primitive with native button semantics, animated height,
    synchronized <code>data-state</code>, and an optional disabled state.
  </p>

  <div class="grid gap-5 lg:grid-cols-2">
    <% [ [ "panel-light", "Light" ], [ "panel-dark", "Dark" ] ].each do |theme, label| %>
      <div class="rounded-2xl border border-border bg-card p-5 text-card-foreground shadow-sm"
           data-theme="<%= theme %>"
           data-collapsible-preview-theme="<%= theme %>">
        <h3 class="text-sm font-semibold"><%= label %> collapsibles</h3>

        <div class="mt-4 space-y-3">
          <%= render PanelsUI::Collapsible.new(
                id: "sd-collapsible-#{theme}",
                class: "rounded-xl border border-border bg-background",
                trigger_class: "px-4") do |collapsible| %>
            <% collapsible.with_trigger do %>
              <span class="py-3 text-sm font-semibold">Guest preferences</span>
              <%= app_icon "chevron-down", class: "panel-collapsible__indicator size-4", aria: { hidden: "true" } %>
            <% end %>
            <% collapsible.with_body do %>
              <div class="border-t border-border px-4 py-4 text-sm text-muted-foreground">
                <p>High floor, away from the lift, with a late-arrival note.</p>
                <a href="#collapsible-preview-heading" class="mt-3 inline-flex font-medium text-primary hover:underline">
                  Review guest profile
                </a>
              </div>
            <% end %>
          <% end %>

          <%= render PanelsUI::Collapsible.new(
                id: "sd-collapsible-open-#{theme}",
                open: true,
                class: "rounded-xl border border-border bg-background",
                trigger_class: "px-4") do |collapsible| %>
            <% collapsible.with_trigger do %>
              <span class="py-3 text-sm font-semibold">Rate breakdown · initially open</span>
              <%= app_icon "chevron-down", class: "panel-collapsible__indicator size-4", aria: { hidden: "true" } %>
            <% end %>
            <% collapsible.with_body do %>
              <dl class="grid grid-cols-2 gap-2 border-t border-border px-4 py-4 text-sm">
                <dt class="text-muted-foreground">Room charge</dt><dd class="text-right">MYR 420.00</dd>
                <dt class="text-muted-foreground">Taxes</dt><dd class="text-right">MYR 33.60</dd>
              </dl>
            <% end %>
          <% end %>

          <%= render PanelsUI::Collapsible.new(
                id: "sd-collapsible-disabled-#{theme}",
                disabled: true,
                class: "rounded-xl border border-border bg-background",
                trigger_class: "px-4") do |collapsible| %>
            <% collapsible.with_trigger do %>
              <span class="py-3 text-sm font-semibold">Unavailable section</span>
              <%= app_icon "chevron-down", class: "panel-collapsible__indicator size-4", aria: { hidden: "true" } %>
            <% end %>
            <% collapsible.with_body { "This content cannot be opened." } %>
          <% end %>
        </div>
      </div>
    <% end %>
  </div>
</section>
