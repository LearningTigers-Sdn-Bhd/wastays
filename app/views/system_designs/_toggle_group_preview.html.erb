<section aria-labelledby="toggle-group-preview-heading" class="border-t border-border pt-8">
  <h2 id="toggle-group-preview-heading" class="text-lg font-semibold text-foreground">Toggle group</h2>
  <p class="mt-1 text-sm text-muted-foreground">
    Single- and multiple-selection controls with shared sizing, roving focus, and Rails-compatible values.
  </p>

  <div class="mt-5 grid gap-5 lg:grid-cols-2">
    <% [ [ "panel-light", "Light" ], [ "panel-dark", "Dark" ] ].each do |theme, label| %>
      <% scope = "toggle_group_#{theme.tr('-', '_')}" %>
      <div class="rounded-2xl border border-border bg-card p-5 text-card-foreground shadow-sm space-y-5"
           data-theme="<%= theme %>"
           data-controller="system-designs--toggle-preview"
           data-action="panels-ui--toggle-group:change->system-designs--toggle-preview#show">
        <div>
          <h3 class="text-sm font-semibold"><%= label %> single selection</h3>
          <div class="mt-3">
            <%= render PanelsUI::ToggleGroup.new(
                  id: "#{scope}-density",
                  type: :single,
                  value: "comfortable",
                  variant: :outline,
                  spacing: 0,
                  required: true,
                  name: "#{scope}[density]",
                  aria_label: "Display density") do |group| %>
              <% group.with_item(value: "compact") { "Compact" } %>
              <% group.with_item(value: "comfortable") { "Comfortable" } %>
              <% group.with_item(value: "spacious", disabled: true) { "Spacious" } %>
            <% end %>
          </div>
        </div>

        <div>
          <h3 class="text-sm font-semibold">Multiple selection</h3>
          <div class="mt-3">
            <%= render PanelsUI::ToggleGroup.new(
                  id: "#{scope}-formatting",
                  type: :multiple,
                  value: %w[bold],
                  size: :sm,
                  name: "#{scope}[formatting]",
                  aria_label: "Text formatting") do |group| %>
              <% group.with_item(value: "bold") { "Bold" } %>
              <% group.with_item(value: "italic") { "Italic" } %>
              <% group.with_item(value: "underline") { "Underline" } %>
            <% end %>
          </div>
        </div>

        <div>
          <h3 class="text-sm font-semibold">Vertical icon group</h3>
          <div class="mt-3">
            <%= render PanelsUI::ToggleGroup.new(
                  id: "#{scope}-alignment",
                  type: :single,
                  value: "start",
                  variant: :outline,
                  size: :icon_sm,
                  orientation: :vertical,
                  spacing: 0,
                  aria_label: "Text alignment") do |group| %>
              <% group.with_item(value: "start", aria_label: "Align start") { app_icon("text-align-start", class: "size-3.5", aria: { hidden: "true" }) } %>
              <% group.with_item(value: "center", aria_label: "Align center") { app_icon("text-align-center", class: "size-3.5", aria: { hidden: "true" }) } %>
              <% group.with_item(value: "end", aria_label: "Align end") { app_icon("text-align-end", class: "size-3.5", aria: { hidden: "true" }) } %>
            <% end %>
          </div>
        </div>

        <output class="block text-xs text-muted-foreground" data-system-designs--toggle-preview-target="output">
          Change a group to inspect its selected value.
        </output>
      </div>
    <% end %>
  </div>
</section>
