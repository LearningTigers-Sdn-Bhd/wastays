<section aria-labelledby="loading-preview-heading" class="border-t border-border pt-8">
  <h2 id="loading-preview-heading" class="text-lg font-semibold text-foreground">Loading states</h2>
  <p class="mt-1 text-sm text-muted-foreground">
    Skeletons, activity indicators, and progress bars. Utility classes control layout;
    data attributes control component states and variants.
  </p>

  <div class="mt-5 grid gap-5 lg:grid-cols-2">
    <% [ [ "panel-light", "Light" ], [ "panel-dark", "Dark" ] ].each do |theme, theme_label| %>
      <div class="rounded-2xl border border-border bg-card p-5 text-card-foreground shadow-sm" data-theme="<%= theme %>">
        <h3 class="text-sm font-semibold"><%= theme_label %> skeleton</h3>

        <div class="mt-4 rounded-xl border border-border p-4" aria-busy="true" aria-label="Loading guest profile">
          <span class="sr-only">Loading guest profile…</span>
          <div class="flex items-center gap-3" aria-hidden="true">
            <%= render PanelsUI::Skeleton.new(variant: :circle, class: "size-11 shrink-0") %>
            <div class="min-w-0 flex-1 space-y-2">
              <%= render PanelsUI::Skeleton.new(variant: :line, class: "h-3 w-2/5") %>
              <%= render PanelsUI::Skeleton.new(variant: :line, class: "h-3 w-4/5") %>
            </div>
          </div>
          <div class="mt-4 grid grid-cols-3 gap-3" aria-hidden="true">
            <%= render PanelsUI::Skeleton.new(variant: :square, class: "h-14") %>
            <%= render PanelsUI::Skeleton.new(variant: :square, class: "h-14") %>
            <%= render PanelsUI::Skeleton.new(variant: :square, class: "h-14") %>
          </div>
        </div>

        <p class="mt-3 text-xs text-muted-foreground">Every skeleton uses the same quiet opacity pulse.</p>
      </div>
    <% end %>
  </div>

  <div class="mt-5 grid gap-5 lg:grid-cols-2">
    <div class="rounded-2xl border border-border bg-card p-5 text-card-foreground shadow-sm">
      <h3 class="text-sm font-semibold">Spinner and loading label</h3>
      <p class="mt-1 text-sm text-muted-foreground">Use a visible label when the activity needs an explanation.</p>

      <div class="mt-5 flex flex-wrap items-center gap-5">
        <%= render PanelsUI::Spinner.new(size: :sm) %>
        <%= render PanelsUI::Spinner.new %>
        <%= render PanelsUI::Spinner.new(size: :lg) %>
      </div>

      <div class="mt-5 flex flex-wrap gap-x-5 gap-y-3">
        <%= render PanelsUI::Spinner.new(label: "Saving booking…", variant: :primary) %>
        <%= render PanelsUI::Spinner.new(label: "Confirming payment…", variant: :success) %>
        <%= render PanelsUI::Spinner.new(label: "Loading rooms…", variant: :info, orientation: :vertical) %>
      </div>
    </div>

    <div class="rounded-2xl border border-border bg-card p-5 text-card-foreground shadow-sm">
      <h3 class="text-sm font-semibold">Progress</h3>
      <p class="mt-1 text-sm text-muted-foreground">Native progress works for known values; the track pattern handles indeterminate work.</p>

      <div class="mt-5 space-y-5">
        <% [ [ "Profile setup", 25, nil ], [ "Data import", 62, "info" ], [ "Ready", 100, "success" ] ].each do |label, value, variant| %>
          <div>
            <div class="mb-2 flex items-center justify-between gap-4 text-xs font-medium">
              <span><%= label %></span>
              <span class="text-muted-foreground"><%= value %>%</span>
            </div>
            <%= render PanelsUI::Progress.new(value: value, variant: variant&.to_sym || :primary, label: label) %>
          </div>
        <% end %>

        <div>
          <div class="mb-2 flex items-center justify-between gap-4 text-xs font-medium">
            <span>Preparing night audit</span>
            <span class="text-muted-foreground">In progress</span>
          </div>
          <%= render PanelsUI::Progress.new(label: "Preparing night audit") %>
        </div>
      </div>
    </div>
  </div>

  <div class="mt-5 rounded-2xl border border-border bg-card p-5 text-card-foreground shadow-sm">
    <h3 class="text-sm font-semibold">Table skeleton</h3>
    <p class="mt-1 text-sm text-muted-foreground">Generate stable row and column placeholders for loading data sets.</p>
    <%= render PanelsUI::Skeleton.new(
          variant: :table,
          rows: 4,
          columns: ["w-3/4", "w-1/2", "w-2/3", "w-1/3"],
          label: "Loading bookings",
          class: "mt-5"
        ) %>
  </div>
</section>
