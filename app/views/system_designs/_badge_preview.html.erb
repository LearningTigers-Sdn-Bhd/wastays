<section aria-labelledby="badge-preview-heading" class="border-t border-border pt-8">
  <h2 id="badge-preview-heading" class="text-lg font-semibold text-foreground">Badges</h2>
  <p class="mt-1 text-sm text-muted-foreground">
    CSS-only metadata and status labels. Rectangular and pill shapes share semantic variants;
    an optional indicator dot identifies live operational states.
  </p>

  <% variants = %i[neutral primary accent info success warning destructive outline] %>

  <div class="mt-5 grid gap-5 lg:grid-cols-2">
    <% [ [ "panel-light", "Light" ], [ "panel-dark", "Dark" ] ].each do |theme, label| %>
      <div class="rounded-2xl border border-border bg-card p-5 text-card-foreground shadow-sm" data-theme="<%= theme %>">
        <h3 class="text-sm font-semibold"><%= label %> variants</h3>
        <div class="mt-4 flex flex-wrap gap-2">
          <% variants.each do |variant| %>
            <span class="panel-badge" data-variant="<%= variant %>"><%= variant.to_s.humanize %></span>
            <span class="panel-badge-rounded" data-variant="<%= variant %>" data-indicator="true"><%= variant.to_s.humanize %></span>
          <% end %>
        </div>
      </div>
    <% end %>
  </div>

  <div class="mt-5 rounded-2xl border border-border bg-card p-5 text-card-foreground shadow-sm">
    <h3 class="text-sm font-semibold">Sizes and hotel statuses</h3>
    <div class="mt-3 flex flex-wrap items-center gap-2">
      <span class="panel-badge-rounded" data-size="sm" data-variant="warning" data-indicator="true">Pending</span>
      <span class="panel-badge-rounded" data-size="md" data-variant="success" data-indicator="true">In house</span>
      <span class="panel-badge-rounded" data-size="lg" data-variant="destructive" data-indicator="true">Overbooked</span>
      <span class="panel-badge" data-variant="info" data-indicator="true">Open folio</span>
      <span class="panel-badge" data-variant="neutral">Closed folio</span>
      <span class="panel-badge-rounded" data-variant="info" data-indicator="true">Cleaning</span>
      <span class="panel-badge-rounded" data-variant="destructive" data-indicator="true">Inspection failed</span>
    </div>

    <div class="mt-4 flex flex-wrap items-center gap-2">
      <span class="panel-badge" data-variant="info">
        <%= app_icon("calendar-days", class: "size-3.5", aria: { hidden: "true" }) %>
        Confirmed
      </span>
      <span class="panel-badge" data-variant="destructive">
        <%= app_icon("circle-x", class: "size-3.5", aria: { hidden: "true" }) %>
        Voided
      </span>
    </div>
  </div>
</section>
