<% content_for :title, "System Design — PanelsUI" %>

<div class="mx-auto max-w-4xl px-6 py-12">
  <header class="mb-10">
    <h1 class="text-2xl font-bold text-foreground">PanelsUI</h1>
    <p class="mt-1 text-sm text-muted-foreground">
      Accessible, reactive, variant-based primitives. Each section below is a live component.
    </p>
  </header>

  <div class="space-y-12">
    <%= render "page_header_preview" %>
    <%= render "card_preview" %>
    <%= render "table_preview" %>
    <%= render "form_fields_preview" %>
    <%= render "native_select_preview" %>
    <%= render "select_menu_preview" %>
    <%= render "combobox_preview" %>
    <%= render "multi_select_preview" %>
    <%= render "date_picker_preview" %>
    <%= render "time_picker_preview" %>
    <%= render "date_time_picker_preview" %>
    <%= render "form_submission_preview" %>
    <%= render "checkbox_preview" %>
    <%= render "radio_preview" %>
    <%= render "switch_preview" %>
    <%= render "dropdown_menu_preview" %>
    <%= render "tooltip_preview" %>
    <%= render "popover_preview" %>
    <%= render "breadcrumb_preview" %>
    <%= render "tabs_preview" %>
    <%= render "collapsible_preview" %>
    <%= render "scroll_area_preview" %>
    <%= render "sidebar_preview" %>
    <%= render "navbar_preview" %>
    <%= render "button_preview" %>
    <%= render "badge_preview" %>
    <%= render "alert_preview" %>
    <%= render "banner_preview" %>
    <%= render "loading_preview" %>
    <%= render "separator_preview" %>
    <%= render "kbd_preview" %>
    <%= render "dialog_preview" %>
    <%= render "sheet_preview" %>
    <%= render "toast_preview" %>
  </div>
</div>
