<!DOCTYPE html>
<html class="h-full">
  <head>
    <title><%= content_for(:title) || "My Bookings | WAStays" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">

    <%= stylesheet_link_tag "tailwind", "data-turbo-track": (Rails.env.production? ? "reload" : nil) %>
    <%= stylesheet_link_tag :app, "data-turbo-track": (Rails.env.production? ? "reload" : nil) %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="h-full" data-theme="panel-light">
    <div class="flex flex-col h-screen bg-background">

      <%= render PanelsUI::Navbar.new(key: "guest", navigation: guest_logged_in?) do |navbar| %>
        <%# Signed out there is no sidebar, no profile and no palette, so the logo
            is all that keeps the bar from rendering empty. Signed in, the sidebar
            header names the portal and the brand would only repeat it. %>
        <% unless guest_logged_in? %>
          <% navbar.with_brand do %>
            <a href="<%= root_path %>" class="flex items-center" aria-label="WAStays">
              <%= image_tag "logo/long-logo.png", alt: "WAStays", width: 1000, height: 350, class: "h-9 w-auto" %>
            </a>
          <% end %>
        <% end %>
        <% if guest_logged_in? %>
          <% navbar.with_center do %>
            <%= render PanelsUI::CommandPalette.new(endpoint: guest_global_search_index_path, placeholder: "Search dashboard pages and bookings...") %>
          <% end %>
          <% navbar.with_profile do %>
            <%= render PanelsUI::ProfileMenu.new(
                  id: "guest-profile",
                  display_name: current_guest.name,
                  secondary_text: current_guest.phone,
                  trigger_label: "Open account menu"
                ) do |menu| %>
              <% menu.with_item(label: "Help", href: help_center_path, icon: "circle-question-mark") %>
              <% menu.with_sign_out(label: "Sign out", path: guest_logout_path) %>
            <% end %>
          <% end %>
        <% end %>
      <% end %>

      <!-- Body: Sidebar + Content -->
      <div class="flex flex-1 overflow-hidden">

        <% if guest_logged_in? %>
          <%= render 'shared/navigation/guest_sidebar' %>
        <% end %>

        <main class="flex-1 flex flex-col overflow-hidden">
          <% if guest_logged_in? && guest_breadcrumb_parts.present? %>
            <div class="flex h-[37px] shrink-0 items-center border-b border-sidebar-border bg-sidebar px-4 text-sidebar-foreground sm:px-6">
              <div class="w-full overflow-x-auto overscroll-x-contain whitespace-nowrap custom-scrollbar">
                <%= render_guest_breadcrumbs %>
              </div>
            </div>
          <% end %>

          <div class="flex-1 overflow-y-auto custom-scrollbar">
            <div class="panel-page space-y-5">
              <%= yield %>
            </div>
          </div>
        </main>
      </div>
    </div>
    <%= render "shared/turbo_confirm" %>
    <%= render PanelsUI::ToastViewport.new %>
    <%= render "shared/feedback/flash_toast_triggers", flash: flash %>
  </body>
</html>
