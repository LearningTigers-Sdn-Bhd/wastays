<!DOCTYPE html>
<html class="h-full">
  <head>
    <title><%= content_for(:title) || "My Bookings | WAStays" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">

    <%= stylesheet_link_tag "tailwind", "data-turbo-track": (Rails.env.production? ? "reload" : nil) %>
    <%= stylesheet_link_tag :app, "data-turbo-track": (Rails.env.production? ? "reload" : nil) %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="h-full" data-theme="panel-light">
    <div class="flex flex-col h-screen bg-background">

      <!-- Top Navbar -->
      <header class="sticky top-0 z-[60] w-full bg-sidebar text-sidebar-foreground border-b border-sidebar-border">
        <div class="flex items-center h-14 px-4 gap-x-3">

          <!-- Mobile hamburger -->
          <% if guest_logged_in? %>
            <button type="button" class="lg:hidden shrink-0 inline-flex justify-center items-center size-8 rounded-lg text-muted-foreground hover:bg-muted transition-colors" command="show-modal" commandfor="guest-sidebar-mobile" aria-label="Toggle navigation">
              <%= cached_icon "menu", class: "size-4" %>
            </button>
            <button type="button" class="hidden lg:inline-flex shrink-0 justify-center items-center size-8 rounded-lg text-muted-foreground hover:bg-muted transition-colors" data-controller="panels-ui--sidebar-toggle" data-panels-ui--sidebar-toggle-key-value="guest" data-action="click->panels-ui--sidebar-toggle#toggleDesktop" aria-label="Collapse sidebar">
              <%= cached_icon "panel-left-close", class: "size-4" %>
            </button>
          <% end %>

          <!-- Brand -->
          <a href="<%= guest_logged_in? ? guest_dashboard_path : root_path %>" class="shrink-0 flex items-center" aria-label="WAStays">
            <%= image_tag "logo/long-logo.png", alt: "WAStays", width: 1000, height: 350, class: "h-9 w-auto" %>
          </a>

          <div class="flex-1"></div>

          <div class="flex items-center gap-x-1">
            <% if guest_logged_in? %>
              <%= render PanelsUI::CommandPalette.new(endpoint: guest_global_search_index_path, placeholder: "Search dashboard pages and bookings...") %>

              <a class="navbar-link hidden sm:flex" href="<%= help_center_path %>">
                <%= cached_icon "circle-question-mark", class: "size-4" %>
                Help
              </a>

              <div class="w-px h-5 bg-border mx-1 hidden sm:block"></div>
              <%= render "shared/navigation/guest_profile_dropdown" %>
            <% end %>
          </div>
        </div>
      </header>

      <!-- Body: Sidebar + Content -->
      <div class="flex flex-1 overflow-hidden">

        <% if guest_logged_in? %>
          <%= render 'shared/navigation/guest_sidebar' %>
        <% end %>

        <main class="flex-1 flex flex-col overflow-hidden">
          <% if guest_logged_in? && guest_breadcrumb_parts.present? %>
            <div class="shrink-0 min-h-14 flex items-center border-b border-sidebar-border bg-sidebar text-sidebar-foreground px-4 sm:px-6">
              <div class="w-full overflow-x-auto overscroll-x-contain whitespace-nowrap custom-scrollbar">
                <%= render_guest_breadcrumbs %>
              </div>
            </div>
          <% end %>

          <div class="flex-1 overflow-y-auto custom-scrollbar">
            <div class="panel-page space-y-5">
              <%= yield %>
            </div>
          </div>
        </main>
      </div>
    </div>
    <%= render "shared/turbo_confirm" %>
    <%= render PanelsUI::ToastViewport.new %>
    <%= render "shared/feedback/flash_toast_triggers", flash: flash %>
  </body>
</html>
