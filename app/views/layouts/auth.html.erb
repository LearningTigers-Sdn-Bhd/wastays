<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "WAStays" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="icon" href="<%= asset_path('logo/favicon.png') %>" type="image/png">
    <link rel="apple-touch-icon" href="<%= asset_path('logo/favicon.png') %>">

    <%= stylesheet_link_tag "tailwind", "data-turbo-track": (Rails.env.production? ? "reload" : nil) %>
    <%= stylesheet_link_tag :app, "data-turbo-track": (Rails.env.production? ? "reload" : nil) %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="bg-background text-foreground font-sans antialiased">

    <main id="content" role="main">
      <%= yield %>
    </main>

    <%= render PanelsUI::ToastViewport.new %>
    <%= render "shared/feedback/flash_toast_triggers", flash: flash %>

  </body>
</html>
