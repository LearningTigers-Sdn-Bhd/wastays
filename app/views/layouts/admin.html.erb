<!DOCTYPE html>
<html class="h-full">
  <head>
    <title><%= content_for(:title) || "Admin Panel | WAStays" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">

    <%= stylesheet_link_tag "tailwind", "data-turbo-track": (Rails.env.production? ? "reload" : nil) %>
    <%= stylesheet_link_tag :app, "data-turbo-track": (Rails.env.production? ? "reload" : nil) %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="h-full" data-theme="panel-light" data-controller="<%= yield :body_controllers %>" <%= yield :body_attributes %>>
    <!-- Preline CMS-style layout: flex column (header + body row) -->
    <div class="flex flex-col h-screen bg-background">

      <%= render PanelsUI::Navbar.new(key: "admin") do |navbar| %>
        <% navbar.with_brand do %>
          <a href="<%= admin_dashboard_path %>" class="flex items-center" aria-label="WAStays">
            <%= image_tag "logo/long-logo.png", alt: "WAStays", width: 1000, height: 350, class: "h-9 w-auto" %>
          </a>
        <% end %>
        <% navbar.with_center do %>
          <%= render PanelsUI::CommandPalette.new(endpoint: admin_global_search_index_path, placeholder: "Search pages, bookings, hotels...") %>
        <% end %>
        <% navbar.with_actions do %>
          <a class="panel-navbar__action" href="<%= root_path %>" target="_blank" rel="noopener">
            <%= cached_icon "external-link", class: "size-3.5" %>
            Website
          </a>
          <%= render "shared/navigation/navbar_alerts" %>
        <% end %>
        <% navbar.with_profile do %>
          <%= render PanelsUI::ProfileMenu.new(
                id: "admin-profile",
                display_name: current_user.name || "Admin User",
                secondary_text: current_user.email,
                trigger_label: "Open account menu"
              ) do |menu| %>
            <% menu.with_item(label: "My account", href: edit_admin_profile_path, icon: "user") %>
            <% menu.with_item(label: "Settings", href: edit_admin_profile_path, icon: "settings") %>
            <% menu.with_item(label: "Help", href: help_center_path, icon: "circle-question-mark") %>
            <% menu.with_sign_out(label: "Sign out", path: logout_path) %>
          <% end %>
        <% end %>
      <% end %>

      <!-- ═══ Body: Sidebar + Content ═══ -->
      <div class="flex flex-1 overflow-hidden">

        <!-- Sidebar -->
        <%= render 'shared/navigation/admin_sidebar' %>

        <!-- Main Content -->
        <main class="flex-1 flex flex-col overflow-hidden">
          <!-- ═══ Breadcrumb Bar ═══ -->
          <% if admin_breadcrumb_parts.present? %>
            <div class="flex h-[37px] shrink-0 items-center border-b border-sidebar-border bg-sidebar px-4 text-sidebar-foreground sm:px-6">
              <div class="w-full overflow-x-auto overscroll-x-contain whitespace-nowrap custom-scrollbar">
                <%= render_admin_breadcrumbs %>
              </div>
            </div>
          <% end %>

          <div class="flex min-h-0 flex-1 flex-col <%= content_for?(:full_height_page) ? '' : 'overflow-y-auto' %> custom-scrollbar">
            <div class="panel-page <%= content_for?(:full_height_page) ? 'panel-page--workspace' : 'space-y-5' %>">
              <div class="<%= content_for?(:full_height_page) ? 'flex min-h-0 flex-1 flex-col' : 'grid grid-cols-1' %> <%= content_for?(:right_sidebar) ? 'xl:grid-cols-4 gap-6' : '' %>">
                <div class="<%= content_for?(:full_height_page) ? 'flex min-h-0 flex-1 flex-col' : '' %> <%= content_for?(:right_sidebar) ? 'xl:col-span-3' : '' %>">
                  <%= yield %>
                </div>

                <% if content_for?(:right_sidebar) %>
                  <div class="xl:col-span-1 space-y-6">
                    <%= yield :right_sidebar %>
                  </div>
                <% end %>
              </div>
            </div>
          </div>
        </main>
      </div>
    </div>

    <%= render 'shared/turbo_confirm' %>
    <%= render PanelsUI::ToastViewport.new %>
    <%= render "shared/feedback/flash_toast_triggers", flash: flash %>
  </body>
</html>
