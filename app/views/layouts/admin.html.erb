<!DOCTYPE html>
<html class="h-full">
  <head>
    <title><%= content_for(:title) || "Admin Panel | WAStays" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">

    <%= stylesheet_link_tag "tailwind", "data-turbo-track": (Rails.env.production? ? "reload" : nil) %>
    <%= stylesheet_link_tag :app, "data-turbo-track": (Rails.env.production? ? "reload" : nil) %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="h-full" data-theme="panel-light" data-controller="<%= yield :body_controllers %>" <%= yield :body_attributes %>>
    <!-- Preline CMS-style layout: flex column (header + body row) -->
    <div class="flex flex-col h-screen bg-layer-alt">

      <!-- ═══ Top Navbar ═══ -->
      <header class="sticky top-0 z-[60] w-full bg-layer border-b border-layer-line">
        <div class="flex items-center h-14 px-4 gap-x-3">

          <!-- Mobile hamburger -->
          <button type="button" class="lg:hidden shrink-0 inline-flex justify-center items-center size-8 rounded-lg text-neutral-text-secondary hover:bg-surface-hover transition-colors" command="show-modal" commandfor="admin-sidebar-mobile" aria-label="Toggle navigation">
            <%= cached_icon "menu", class: "size-4" %>
          </button>

          <!-- Desktop sidebar collapse -->
          <button type="button" class="hidden lg:inline-flex shrink-0 justify-center items-center size-8 rounded-lg text-neutral-text-secondary hover:bg-surface-hover transition-colors" data-controller="panels-ui--sidebar-toggle" data-panels-ui--sidebar-toggle-key-value="admin" data-action="click->panels-ui--sidebar-toggle#toggleDesktop" aria-label="Collapse sidebar">
            <%= cached_icon "panel-left-close", class: "size-4" %>
          </button>

          <!-- Brand -->
          <a href="<%= admin_dashboard_path %>" class="shrink-0 flex items-center" aria-label="WAStays">
            <%= image_tag "logo/long-logo.png", alt: "WAStays", width: 1000, height: 350, class: "h-9 w-auto" %>
          </a>

          <!-- Spacer -->
          <div class="flex-1"></div>

          <!-- Right Actions -->
          <div class="flex items-center gap-x-1">
            <% if content_for?(:header_actions) %>
              <%= yield :header_actions %>
            <% end %>

            <%= render "shared/navigation/command_palette", endpoint: admin_global_search_index_path, placeholder: "Search pages, bookings, hotels..." %>

            <!-- Help Link -->
            <a class="navbar-link hidden sm:flex" href="<%= help_center_path %>">
              <%= cached_icon "circle-question-mark", class: "size-4" %>
              Help
            </a>

            <!-- View Website -->
            <a class="hidden sm:flex items-center gap-x-1.5 py-1.5 px-2.5 text-sm text-navbar-nav-foreground rounded-lg hover:bg-navbar-nav-hover transition-colors duration-150" href="<%= root_path %>" target="_blank">
              <%= cached_icon "external-link", class: "size-3.5" %>
              Website
            </a>

            <!-- Divider -->
            <div class="w-px h-5 bg-layer-line mx-1 hidden sm:block"></div>

            <!-- Profile Dropdown -->
            <%= render "shared/navigation/admin_profile_dropdown" %>
          </div>
        </div>
      </header>

      <!-- ═══ Breadcrumb Bar ═══ -->
      <% if admin_breadcrumb_parts.present? %>
        <div class="relative border-b border-layer-line bg-layer py-2 overflow-visible">
          <div class="px-4 sm:px-6 overflow-x-auto overscroll-x-contain whitespace-nowrap custom-scrollbar">
            <%= render_admin_breadcrumbs %>
          </div>
        </div>
      <% end %>

      <!-- ═══ Body: Sidebar + Content ═══ -->
      <div class="flex flex-1 overflow-hidden">

        <!-- Sidebar -->
        <%= render 'shared/navigation/admin_sidebar' %>

        <!-- Main Content -->
        <main class="flex-1 flex flex-col overflow-hidden overflow-y-auto custom-scrollbar">
          <div class="p-5 sm:p-6 space-y-5">
            <div class="grid grid-cols-1 <%= content_for?(:right_sidebar) ? 'xl:grid-cols-4 gap-6' : '' %>">
              <div class="<%= content_for?(:right_sidebar) ? 'xl:col-span-3' : '' %>">
                <%= yield %>
              </div>

              <% if content_for?(:right_sidebar) %>
                <div class="xl:col-span-1 space-y-6">
                  <%= yield :right_sidebar %>
                </div>
              <% end %>
            </div>
          </div>
        </main>
      </div>
    </div>

    <%= render 'shared/navigation/admin_mobile_nav' %>
    <%= render 'shared/turbo_confirm' %>
    <%= render PanelsUI::ToastViewport.new %>
    <%= render "shared/feedback/flash_toast_triggers", flash: flash %>
  </body>
</html>
