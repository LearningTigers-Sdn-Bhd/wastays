<!DOCTYPE html>
<html class="h-full">
  <head>
    <title><%= content_for(:title) || "Corporate Portal | WAStays" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">

    <%= stylesheet_link_tag "tailwind", "data-turbo-track": (Rails.env.production? ? "reload" : nil) %>
    <%= stylesheet_link_tag :app, "data-turbo-track": (Rails.env.production? ? "reload" : nil) %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="h-full overflow-hidden" data-theme="panel-light" data-controller="<%= yield :body_controllers %>" <%= yield :body_attributes %>>
    <div class="flex flex-col h-screen h-dvh min-h-screen min-h-dvh bg-background">
      <%= render PanelsUI::Navbar.new(key: "corporate") do |navbar| %>
        <% navbar.with_brand do %>
          <a href="<%= corporate_dashboard_path %>" class="flex items-center" aria-label="WAStays">
            <%= image_tag "logo/long-logo.png", alt: "WAStays", width: 1000, height: 350, class: "h-9 w-auto" %>
          </a>
        <% end %>
        <% navbar.with_actions do %>
          <a class="panel-navbar__action" href="<%= help_center_path %>">
            <%= cached_icon "circle-question-mark", class: "size-4" %>
            Help
          </a>
        <% end %>
        <% navbar.with_profile do %>
          <%= render PanelsUI::ProfileMenu.new(
                id: "corporate-profile",
                display_name: current_user.account.name,
                secondary_text: current_user.email,
                trigger_label: "Open corporate account menu",
                trigger_icon: "building-2"
              ) do |menu| %>
            <% menu.with_sign_out(label: "Sign out", path: logout_path) %>
          <% end %>
        <% end %>
      <% end %>

      <div class="flex flex-1 overflow-hidden">
        <%= render "shared/navigation/corporate_sidebar" %>

        <main class="flex-1 flex flex-col overflow-hidden">
          <% if corporate_breadcrumb_parts.present? %>
            <div class="shrink-0 min-h-14 flex items-center border-b border-sidebar-border bg-sidebar text-sidebar-foreground px-4 sm:px-6">
              <div class="w-full overflow-x-auto overscroll-x-contain whitespace-nowrap custom-scrollbar">
                <%= render_corporate_breadcrumbs %>
              </div>
            </div>
          <% end %>

          <div class="flex-1 overflow-y-auto overscroll-contain custom-scrollbar">
            <div class="panel-page space-y-5">
              <div class="grid grid-cols-1 <%= content_for?(:right_sidebar) ? 'xl:grid-cols-4 gap-6' : '' %>">
                <div class="<%= content_for?(:right_sidebar) ? 'xl:col-span-3' : '' %>">
                  <%= yield %>
                </div>

                <% if content_for?(:right_sidebar) %>
                  <div class="xl:col-span-1 space-y-6">
                    <%= yield :right_sidebar %>
                  </div>
                <% end %>
              </div>
            </div>
          </div>
        </main>
      </div>
    </div>

    <%= render "shared/turbo_confirm" %>
    <%= yield :body_end %>
    <%= render PanelsUI::ToastViewport.new %>
    <%= render "shared/feedback/flash_toast_triggers", flash: flash %>
  </body>
</html>
