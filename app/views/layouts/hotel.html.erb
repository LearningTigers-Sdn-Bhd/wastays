<!DOCTYPE html>
<html class="h-full">
  <head>
    <title><%= content_for(:title) || "Hotel Admin | WAStays" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">

    <%= stylesheet_link_tag :tailwind, "data-turbo-track": (Rails.env.production? ? "reload" : nil) %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="h-full">
    <!-- Preline CMS-style layout: flex column (header + body row) -->
    <div class="flex flex-col h-screen bg-layer-alt">

      <!-- ═══ Top Navbar ═══ -->
      <header class="sticky top-0 z-[60] w-full bg-layer border-b border-layer-line">
        <div class="flex items-center h-14 px-4 gap-x-3">

          <!-- Mobile hamburger -->
          <% unless locked_hotel_portal_shell? %>
            <button type="button" class="lg:hidden shrink-0 inline-flex justify-center items-center size-8 rounded-lg text-neutral-text-secondary hover:bg-surface-hover transition-colors" data-controller="sidebar-toggle" data-action="click->sidebar-toggle#toggle" aria-label="Toggle navigation">
              <svg class="size-4" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
            </button>
          <% end %>

          <!-- Logo Icon -->
          <a href="<%= current_hotel ? hotel_dashboard_path(current_hotel) : '#' %>" class="shrink-0 flex items-center gap-x-2.5" aria-label="WAStays">
            <span class="inline-flex justify-center items-center size-8 bg-brand-primary rounded-lg text-white font-bold text-sm shadow-xs">W</span>
            <span class="hidden lg:block text-sm font-semibold text-neutral-text-primary">WAStays</span>
          </a>

          <!-- Divider -->
          <div class="hidden lg:block w-px h-5 bg-layer-line"></div>

          <!-- Hotel Name -->
          <% if current_hotel %>
            <div class="hidden lg:flex items-center gap-x-1.5 py-1 px-2 min-h-8 text-sm font-medium text-neutral-text-primary">
              <svg class="size-3.5 text-neutral-text-secondary" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 22V4a2 2 0 0 1 2-2h8a2 2 0 0 1 2-2v18Z"/><path d="M10 6h4"/><path d="M10 10h4"/><path d="M10 14h4"/><path d="M10 18h4"/></svg>
              <%= current_hotel.name.truncate(24) %>
            </div>
          <% end %>

          <!-- Separator -->
          <div class="hidden sm:block w-px h-5 bg-layer-line"></div>

          <!-- Breadcrumbs slot -->
          <div class="hidden sm:flex items-center">
            <% if content_for?(:breadcrumbs) %>
              <%= yield :breadcrumbs %>
            <% end %>
          </div>

          <!-- Spacer -->
          <div class="flex-1"></div>

          <!-- Right Actions -->
          <div class="flex items-center gap-x-1">
            <% if content_for?(:header_actions) %>
              <%= yield :header_actions %>
            <% elsif current_user.superadmin? %>
              <a class="hidden sm:flex items-center gap-x-1.5 py-1.5 px-2.5 text-sm text-navbar-nav-foreground rounded-lg hover:bg-navbar-nav-hover transition-colors duration-150" href="<%= admin_dashboard_path %>">
                <svg class="size-3.5" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12.22 2h-.44a2 2 0 0 0-2 2v.18a2 2 0 0 1-1 1.73l-.43.25a2 2 0 0 1-2 0l-.15-.08a2 2 0 0 0-2.73.73l-.22.38a2 2 0 0 0 .73 2.73l.15.1a2 2 0 0 1 1 1.72v.51a2 2 0 0 1-1 1.74l-.15.09a2 2 0 0 0-.73 2.73l.22.38a2 2 0 0 0 2.73.73l.15-.08a2 2 0 0 1 2 0l.43.25a2 2 0 0 1 1 1.73V20a2 2 0 0 0 2 2h.44a2 2 0 0 0 2-2v-.18a2 2 0 0 1 1-1.73l.43-.25a2 2 0 0 1 2 0l.15.08a2 2 0 0 0 2.73-.73l.22-.39a2 2 0 0 0-.73-2.73l-.15-.08a2 2 0 0 1-1-1.74v-.5a2 2 0 0 1 1-1.74l.15-.09a2 2 0 0 0 .73-2.73l-.22-.38a2 2 0 0 0-2.73-.73l-.15.08a2 2 0 0 1-2 0l-.43-.25a2 2 0 0 1-1-1.73V4a2 2 0 0 0-2-2z"/><circle cx="12" cy="12" r="3"/></svg>
                Admin Panel
              </a>
            <% end %>

            <!-- Help Link -->
            <a class="navbar-link hidden sm:flex" href="<%= help_center_path %>">
              <svg class="size-4" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
              Help
            </a>

            <% unless locked_hotel_portal_shell? %>
              <!-- Divider -->
              <div class="w-px h-5 bg-layer-line mx-1 hidden sm:block"></div>

              <!-- Profile Dropdown -->
              <%= render "shared/navigation/hotel_profile_dropdown" %>
            <% end %>
          </div>
        </div>
      </header>

      <!-- ═══ Body: Sidebar + Content ═══ -->
      <div class="flex flex-1 overflow-hidden">

        <% unless locked_hotel_portal_shell? %>
          <!-- Sidebar -->
          <%= render 'shared/navigation/hotel_sidebar' %>
        <% end %>

        <!-- Main Content -->
        <main class="flex-1 flex flex-col overflow-hidden overflow-y-auto custom-scrollbar">
          <div class="p-5 sm:p-6 space-y-5">
            <%= render "shared/feedback/flash_toasts", flash: flash %>

            <div class="grid grid-cols-1 <%= (!locked_hotel_portal_shell? && content_for?(:right_sidebar)) ? 'xl:grid-cols-4 gap-6' : '' %>">
              <div class="<%= (!locked_hotel_portal_shell? && content_for?(:right_sidebar)) ? 'xl:col-span-3' : '' %>">
                <%= yield %>
              </div>

              <% if !locked_hotel_portal_shell? && content_for?(:right_sidebar) %>
                <div class="xl:col-span-1 space-y-6">
                  <%= yield :right_sidebar %>
                </div>
              <% end %>
            </div>
          </div>
        </main>
      </div>
    </div>

    <% unless locked_hotel_portal_shell? %>
      <%= render 'shared/navigation/hotel_mobile_nav' %>
    <% end %>
    <%= render 'shared/turbo_confirm' %>
  </body>
</html>
