<!DOCTYPE html>
<html class="h-full">
  <head>
    <title><%= content_for(:title) || "Hotel Admin | WAStays" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">

    <%= stylesheet_link_tag :app, "data-turbo-track": (Rails.env.production? ? "reload" : nil) %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="h-full overflow-hidden" data-controller="<%= yield :body_controllers %>" <%= yield :body_attributes %>>
    <!-- Preline CMS-style layout: flex column (header + body row) -->
    <div class="flex flex-col h-screen h-dvh min-h-screen min-h-dvh bg-layer-alt">

      <!-- ═══ Top Navbar ═══ -->
      <header class="sticky top-0 z-[60] w-full bg-layer border-b border-layer-line">
        <div class="flex items-center h-14 px-4 gap-x-3">

          <!-- Mobile hamburger -->
          <% unless locked_hotel_portal_shell? %>
            <button type="button" class="lg:hidden shrink-0 inline-flex justify-center items-center size-8 rounded-lg text-neutral-text-secondary hover:bg-surface-hover transition-colors" data-controller="sidebar-toggle" data-action="click->sidebar-toggle#toggle" aria-label="Toggle navigation">
              <%= cached_icon "menu", class: "size-4" %>
            </button>
            <button type="button" class="hidden lg:inline-flex shrink-0 justify-center items-center size-8 rounded-lg text-neutral-text-secondary hover:bg-surface-hover transition-colors" data-controller="sidebar-toggle" data-action="click->sidebar-toggle#toggleDesktop" aria-label="Collapse sidebar">
              <%= cached_icon "panel-left-close", class: "size-4" %>
            </button>
          <% end %>

          <!-- Brand -->
          <a href="<%= current_hotel ? hotel_dashboard_path(current_hotel) : '#' %>" class="shrink-0 flex items-center" aria-label="WAStays">
            <%= image_tag "logo/long-logo.png", alt: "WAStays", width: 1000, height: 350, class: "h-9 w-auto" %>
          </a>

          <!-- Spacer -->
          <div class="flex-1"></div>

          <!-- Right Actions -->
          <div class="flex items-center gap-x-1">
            <% if content_for?(:header_actions) %>
              <%= yield :header_actions %>
            <% end %>

            <% unless locked_hotel_portal_shell? %>
              <%= render "shared/navigation/command_palette", endpoint: hotel_global_search_index_path(current_hotel), placeholder: "Search dashboard pages..." %>
            <% end %>

            <!-- Help Link -->
            <a class="navbar-link hidden sm:flex" href="<%= help_center_path %>">
              <%= cached_icon "circle-question-mark", class: "size-4" %>
              Help
            </a>

            <!-- Divider -->
            <div class="w-px h-5 bg-layer-line mx-1 hidden sm:block"></div>

            <!-- Profile Dropdown -->
            <%= render "shared/navigation/hotel_profile_dropdown" %>
            </div>
            </div>
            </header>

      <!-- ═══ Breadcrumb Bar ═══ -->
      <% if hotel_breadcrumb_parts.present? %>
        <div class="relative border-b border-layer-line bg-layer py-2 overflow-visible">
          <div class="px-4 sm:px-6 overflow-x-auto overscroll-x-contain whitespace-nowrap custom-scrollbar">
            <%= render_hotel_breadcrumbs %>
          </div>
        </div>
      <% end %>

      <!-- ═══ Body: Sidebar + Content ═══ -->
      <div class="flex flex-1 overflow-hidden">

        <% unless locked_hotel_portal_shell? %>
          <!-- Sidebar -->
          <%= render 'shared/navigation/hotel_sidebar' %>
        <% end %>

        <!-- Main Content -->
        <main class="flex-1 flex flex-col overflow-hidden overflow-y-auto overscroll-contain custom-scrollbar">
          <div class="p-5 sm:p-6 space-y-5">
            <%= render "shared/feedback/flash_toasts", flash: flash %>

            <div class="grid grid-cols-1 <%= (!locked_hotel_portal_shell? && content_for?(:right_sidebar)) ? 'xl:grid-cols-4 gap-6' : '' %>">
              <div class="<%= (!locked_hotel_portal_shell? && content_for?(:right_sidebar)) ? 'xl:col-span-3' : '' %>">
                <%= yield %>
              </div>

              <% if !locked_hotel_portal_shell? && content_for?(:right_sidebar) %>
                <div class="xl:col-span-1 space-y-6">
                  <%= yield :right_sidebar %>
                </div>
              <% end %>
            </div>
          </div>
        </main>
      </div>
    </div>

    <% unless locked_hotel_portal_shell? %>
      <%= render 'shared/navigation/hotel_mobile_nav' %>
    <% end %>
    <%= render 'shared/turbo_confirm' %>
    <%= render 'shared/room_lock_alert' %>
    <%= render 'shared/offcanvas_drawer' %>
  </body>
</html>
