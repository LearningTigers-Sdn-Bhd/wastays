<!DOCTYPE html>
<html class="h-full">
  <head>
    <title><%= content_for(:title) || "Hotel Admin | WAStays" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= content_for(:head) %>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">

    <%= stylesheet_link_tag "tailwind", "data-turbo-track": (Rails.env.production? ? "reload" : nil) %>
    <%= stylesheet_link_tag :app, "data-turbo-track": (Rails.env.production? ? "reload" : nil) %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="h-full overflow-hidden" data-theme="panel-light" data-controller="<%= content_for(:body_controllers) %>" <%= content_for(:body_attributes) %>>
    <div class="flex flex-col h-screen h-dvh min-h-screen min-h-dvh bg-background">
      <%= render PanelsUI::Navbar.new(key: navigation_key, sidebar_state_key: navigation_state_key, navigation: !locked_hotel_portal_shell?) do |navbar| %>
        <% navbar.with_brand do %>
          <% if current_hotel %>
            <%# The badge sits beside the identity rather than inside it: how the
                property sells is a fact about the tenant, not part of the link
                to its dashboard. Hidden below md so the name keeps the rail. %>
            <div class="flex items-center gap-2">
              <a href="<%= hotel_dashboard_path(current_hotel) %>" class="panel-navbar__identity" aria-label="<%= current_hotel.name %>">
                <span class="panel-navbar__identity-name"><%= current_hotel.name %></span>
                <%# Labelled, unlike the admin registry and the profile field: a bare
                    number under a hotel name reads as anything at all. %>
                <span class="panel-navbar__identity-meta">Code <%= current_hotel.unique_id %></span>
              </a>
              <%= render PanelsUI::Badge.new(
                    label: current_hotel.sell_mode_label,
                    variant: :outline,
                    size: :sm,
                    class: "hidden md:inline-flex",
                    data: { testid: "hotel-sell-mode-badge" }) %>
            </div>
          <% else %>
            <a href="<%= root_path %>" class="flex items-center" aria-label="WAStays">
              <%= image_tag "logo/long-logo.png", alt: "WAStays", width: 1000, height: 350, class: "h-9 w-auto" %>
            </a>
          <% end %>
        <% end %>
        <% unless locked_hotel_portal_shell? %>
          <% navbar.with_center do %>
            <%= render PanelsUI::CommandPalette.new(endpoint: hotel_global_search_index_path(current_hotel, layer: navigation_key), placeholder: "Search dashboard pages...") %>
          <% end %>
        <% end %>
        <% unless locked_hotel_portal_shell? %>
          <% navbar.with_actions do %>
            <%= render "shared/navigation/navbar_alerts" %>
          <% end %>
        <% end %>
        <% navbar.with_profile do %>
          <%= render PanelsUI::ProfileMenu.new(
                id: "hotel-profile",
                display_name: current_user.name || "Hotel Admin",
                secondary_text: current_user.email,
                trigger_label: "Open account menu"
              ) do |menu| %>
            <% menu.with_item(label: "My account", href: edit_hotel_user_profile_path(current_hotel), icon: "user") %>
            <% if (settings_path = hotel_settings_landing_path) %>
              <% menu.with_item(label: "Settings", href: settings_path, icon: "settings") %>
            <% end %>
            <% menu.with_item(label: "Help", href: help_center_path, icon: "circle-question-mark") %>
            <% menu.with_sign_out(label: "Sign out", path: logout_path) %>
          <% end %>
        <% end %>
      <% end %>

      <div class="flex flex-1 overflow-hidden">
        <% unless locked_hotel_portal_shell? %>
          <%= render "shared/navigation/layer_sidebar",
                     key: navigation_key,
                     home_path: sidebar_home_path,
                     sections: sidebar_sections %>
        <% end %>

        <main class="flex-1 flex flex-col overflow-hidden">
          <% if breadcrumb_parts.present? %>
            <div class="portal-breadcrumb-bar flex h-[37px] shrink-0 items-center border-b border-sidebar-border bg-sidebar px-4 text-sidebar-foreground sm:px-6">
              <div class="w-full overflow-x-auto overscroll-x-contain whitespace-nowrap custom-scrollbar">
                <%= breadcrumb_markup %>
              </div>
            </div>
          <% end %>

          <div class="flex min-h-0 flex-1 flex-col <%= content_for?(:full_height_page) ? '' : 'overflow-y-auto [scrollbar-gutter:stable]' %> <%= content_for?(:page_overscroll_class) ? content_for(:page_overscroll_class) : 'overscroll-contain' %> custom-scrollbar">
            <div class="panel-page <%= content_for?(:full_height_page) ? 'panel-page--workspace' : 'space-y-5' %>">
              <div class="<%= content_for?(:full_height_page) ? 'flex min-h-0 flex-1 flex-col' : 'grid grid-cols-1' %> <%= (!locked_hotel_portal_shell? && content_for?(:right_sidebar)) ? 'xl:grid-cols-4 gap-6' : '' %>">
                <div class="<%= content_for?(:full_height_page) ? 'flex min-h-0 flex-1 flex-col' : '' %> <%= (!locked_hotel_portal_shell? && content_for?(:right_sidebar)) ? 'xl:col-span-3' : '' %>">
                  <%= yield %>
                </div>

                <% if !locked_hotel_portal_shell? && content_for?(:right_sidebar) %>
                  <div class="xl:col-span-1 space-y-6">
                    <%= content_for(:right_sidebar) %>
                  </div>
                <% end %>
              </div>
            </div>
          </div>
        </main>
      </div>
    </div>

    <%= render "shared/turbo_confirm" %>
    <%= render "shared/room_lock_alert" %>
    <%= render "shared/offcanvas_drawer" %>
    <%= render "shared/offcanvas_drawer_secondary" %>
    <%= turbo_frame_tag "booking_action_sheet" %>
    <%= turbo_frame_tag "booking_action_sheet_secondary" %>
    <%= turbo_frame_tag "housekeeping_action_sheet" %>
    <%= turbo_frame_tag "requests_action_sheet" %>
    <%= turbo_frame_tag "folio_action_sheet" %>
    <%= turbo_frame_tag "folio_action_sheet_secondary" %>
    <%= turbo_frame_tag "external_account_sheet" %>
    <%= turbo_frame_tag "settings_action_sheet" %>
    <%= content_for(:body_end) %>
    <%= render PanelsUI::ToastViewport.new %>
    <%= render "shared/feedback/flash_toast_triggers", flash: flash %>
  </body>
</html>
