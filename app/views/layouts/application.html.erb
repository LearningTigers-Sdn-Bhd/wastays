<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Wastays" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <%= stylesheet_link_tag :app, "data-turbo-track": (Rails.env.production? ? "reload" : nil) %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="bg-neutral-bg text-neutral-text-primary font-sans antialiased">
    <!-- Desktop/Mobile Top Nav -->
    <header class="sticky top-0 z-50 w-full bg-white/80 backdrop-blur-md border-b border-neutral-border py-3">
      <nav class="max-w-[85rem] w-full mx-auto px-4 flex items-center justify-between" aria-label="Global">
        <div class="flex items-center gap-x-2">
          <a class="flex-none text-2xl font-bold text-brand-primary tracking-tight focus:outline-none focus:opacity-80" href="<%= root_path %>" aria-label="WAStays">
            WAStays
          </a>
        </div>

        <div class="flex items-center gap-x-5">
          <div class="hidden sm:flex items-center gap-x-5">
            <a class="font-medium text-neutral-text-secondary hover:text-brand-primary transition-colors focus:outline-none" href="<%= hotels_path %>">Hotels</a>
            <a class="font-medium text-neutral-text-secondary hover:text-brand-primary transition-colors focus:outline-none" href="<%= help_center_path %>">Help</a>
          </div>

          <div class="flex items-center gap-x-2 sm:border-s sm:border-neutral-border sm:ps-5">
            <% if logged_in? %>
              <div class="relative inline-flex" data-controller="dropdown">
                <button data-action="click->dropdown#toggle" type="button" class="inline-flex items-center gap-x-2 text-sm font-semibold text-neutral-text-primary hover:text-brand-primary focus:outline-none">
                  <span class="hidden sm:inline-block"><%= current_user.name.split.first %></span>
                  <svg class="w-4 h-4 text-neutral-text-secondary" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6"/></svg>
                </button>

                <div data-dropdown-target="menu" class="hidden absolute right-0 top-full min-w-[12rem] bg-white shadow-lg rounded-lg p-2 mt-2 z-70 border border-neutral-border animate-in fade-in zoom-in duration-200">
                  <% if current_user.superadmin? %>
                    <a class="flex items-center gap-x-3.5 py-2 px-3 rounded-lg text-sm text-neutral-text-primary hover:bg-neutral-bg focus:ring-2 focus:ring-brand-primary" href="<%= admin_dashboard_path %>">
                      Admin Panel
                    </a>
                  <% end %>
                  <a class="flex items-center gap-x-3.5 py-2 px-3 rounded-lg text-sm text-neutral-text-primary hover:bg-neutral-bg focus:ring-2 focus:ring-brand-primary" href="<%= hotel_dashboard_path %>">
                    Hotel Dashboard
                  </a>
                  <a class="flex items-center gap-x-3.5 py-2 px-3 rounded-lg text-sm text-neutral-text-primary hover:bg-neutral-bg focus:ring-2 focus:ring-brand-primary" href="<%= current_user.superadmin? ? edit_admin_profile_path : edit_hotel_user_profile_path %>">
                    My Profile
                  </a>
                  <div class="my-2 border-t border-neutral-border"></div>
                  <%= button_to logout_path, method: :delete, class: "flex items-center gap-x-3.5 py-2 px-3 rounded-lg text-sm text-status-error hover:bg-red-50 focus:ring-2 focus:ring-status-error w-full text-left" do %>
                    Logout
                  <% end %>
                </div>
              </div>
            <% else %>
              <a class="btn btn-secondary py-1.5 px-3" href="<%= login_path %>">Sign in</a>
              <a class="hidden sm:inline-flex btn btn-primary py-1.5 px-4" href="<%= for_hotels_path %>">Register Hotel</a>
            <% end %>
          </div>
        </div>
      </nav>
    </header>

    <% if flash.any? %>
      <div class="max-w-[85rem] mx-auto px-4 mt-4">
        <% flash.each do |key, value| %>
          <div class="p-4 rounded-lg <%= key == 'alert' ? 'bg-red-50 text-status-error border border-red-100' : 'bg-green-50 text-status-success border border-green-100' %>" role="alert">
            <span class="font-bold"><%= key.capitalize %>:</span> <%= value %>
          </div>
        <% end %>
      </div>
    <% end %>

    <main id="content" role="main">
      <%= yield %>
    </main>

    <!-- Mobile Bottom Nav (Phase 4 requirement) -->
    <div class="sm:hidden sticky bottom-0 z-50 w-full bg-white/95 backdrop-blur-md border-t border-neutral-border pb-safe">
      <nav class="flex items-center justify-around py-3 px-4">
        <a href="<%= root_path %>" class="flex flex-col items-center gap-y-1 text-neutral-text-secondary hover:text-brand-primary">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
          <span class="text-[10px] font-medium">Home</span>
        </a>
        <a href="<%= hotels_path %>" class="flex flex-col items-center gap-y-1 text-neutral-text-secondary hover:text-brand-primary">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
          <span class="text-[10px] font-medium">Search</span>
        </a>
        <a href="<%= help_center_path %>" class="flex flex-col items-center gap-y-1 text-neutral-text-secondary hover:text-brand-primary">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
          <span class="text-[10px] font-medium">Help</span>
        </a>
        <a href="<%= login_path %>" class="flex flex-col items-center gap-y-1 text-neutral-text-secondary hover:text-brand-primary">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
          <span class="text-[10px] font-medium">Account</span>
        </a>
      </nav>
    </div>

    <footer class="w-full max-w-[85rem] py-10 px-4 sm:px-6 lg:px-8 mx-auto border-t border-neutral-border mt-20">
      <div class="grid grid-cols-2 md:grid-cols-4 gap-6 mb-10">
        <div class="col-span-full lg:col-span-1">
          <a class="flex-none text-xl font-bold text-brand-primary tracking-tight" href="<%= root_path %>" aria-label="WAStays">WAStays</a>
          <p class="mt-3 text-sm text-neutral-text-secondary">Making budget hotel bookings seamless across Malaysia and Southeast Asia.</p>
        </div>
        <div>
          <h4 class="text-xs font-semibold text-neutral-text-primary uppercase tracking-wider">Support</h4>
          <div class="mt-3 grid space-y-3 text-sm">
            <p><a class="inline-flex gap-x-2 text-neutral-text-secondary hover:text-brand-primary transition-colors" href="mailto:support@wastays.com">Email Support</a></p>
            <p><a class="inline-flex gap-x-2 text-neutral-text-secondary hover:text-brand-primary transition-colors" href="<%= help_center_path %>">Help Center</a></p>
          </div>
        </div>
        <div>
          <h4 class="text-xs font-semibold text-neutral-text-primary uppercase tracking-wider">Company</h4>
          <div class="mt-3 grid space-y-3 text-sm">
            <p><a class="inline-flex gap-x-2 text-neutral-text-secondary hover:text-brand-primary transition-colors" href="#">About Us</a></p>
            <p><a class="inline-flex gap-x-2 text-neutral-text-secondary hover:text-brand-primary transition-colors" href="#">Privacy Policy</a></p>
          </div>
        </div>
        <div>
          <h4 class="text-xs font-semibold text-neutral-text-primary uppercase tracking-wider">Hotels</h4>
          <div class="mt-3 grid space-y-3 text-sm">
            <p><%= link_to "Hotel Partnerships", for_hotels_path, class: "inline-flex gap-x-2 text-neutral-text-secondary hover:text-brand-primary transition-colors font-bold" %></p>
            <p><%= link_to "Register Your Hotel", register_path, class: "inline-flex gap-x-2 text-neutral-text-secondary hover:text-brand-primary transition-colors" %></p>
            <p><%= link_to "Hotel Login", login_path, class: "inline-flex gap-x-2 text-neutral-text-secondary hover:text-brand-primary transition-colors" %></p>
          </div>
        </div>
      </div>
      <div class="pt-5 mt-5 border-t border-neutral-border">
        <p class="text-sm text-neutral-text-secondary text-center">© 2026 WAStays. All rights reserved.</p>
      </div>
    </footer>
  </body>
</html>
