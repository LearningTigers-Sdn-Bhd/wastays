<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Wastays" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <header class="flex flex-wrap sm:justify-start sm:flex-nowrap z-50 w-full bg-white border-b border-gray-200 text-sm py-3">
      <nav class="max-w-[85rem] w-full mx-auto px-4 sm:flex sm:items-center sm:justify-between" aria-label="Global">
        <div class="flex items-center justify-between">
          <a class="flex-none text-xl font-semibold focus:outline-none focus:opacity-80" href="<%= root_path %>" aria-label="WAStays">
            WAStays
          </a>
        </div>
        <div id="navbar-collapse-with-animation" class="hs-collapse hidden overflow-hidden transition-all duration-300 basis-full grow sm:block">
          <div class="flex flex-col gap-5 mt-5 sm:flex-row sm:items-center sm:justify-end sm:mt-0 sm:ps-5">
            <% if logged_in? %>
              <span class="text-gray-600">Logged in as <%= current_user.name %> (<%= current_user.role %>)</span>
              <% if current_user.superadmin? %>
                <a class="font-medium text-blue-600 focus:outline-none" href="<%= admin_dashboard_path %>">Admin Panel</a>
              <% end %>
              <a class="font-medium text-gray-600 hover:text-gray-400 focus:outline-none" href="<%= hotel_dashboard_path %>">Hotel Dashboard</a>
              <a class="font-medium text-gray-600 hover:text-gray-400 focus:outline-none" href="<%= help_center_path %>">Help Center</a>
              <%= button_to "Logout", logout_path, method: :delete, class: "font-medium text-red-600 focus:outline-none" %>
            <% else %>
              <a class="font-medium text-blue-600 focus:outline-none" href="<%= login_path %>">Login</a>
            <% end %>
          </div>
        </div>
      </nav>
    </header>

    <% if flash.any? %>
      <div class="max-w-[85rem] mx-auto px-4 mt-4">
        <% flash.each do |key, value| %>
          <div class="p-4 rounded-lg <%= key == 'alert' ? 'bg-red-50 text-red-800' : 'bg-green-50 text-green-800' %>" role="alert">
            <span class="font-bold"><%= key.capitalize %>:</span> <%= value %>
          </div>
        <% end %>
      </div>
    <% end %>

    <main class="w-full">
      <%= yield %>
    </main>

    <footer class="mt-auto w-full max-w-[85rem] py-10 px-4 sm:px-6 lg:px-8 mx-auto border-t border-gray-200">
      <div class="grid grid-cols-2 md:grid-cols-4 gap-6 mb-10">
        <div class="col-span-full lg:col-span-1">
          <a class="flex-none text-xl font-semibold text-gray-800" href="<%= root_path %>" aria-label="WAStays">WAStays</a>
          <p class="mt-3 text-sm text-gray-600">Making budget hotel bookings seamless across Malaysia and Southeast Asia.</p>
        </div>
        <div>
          <h4 class="text-xs font-semibold text-gray-900 uppercase">Support</h4>
          <div class="mt-3 grid space-y-3 text-sm">
            <p><a class="inline-flex gap-x-2 text-gray-600 hover:text-gray-800" href="mailto:support@wastays.com">Email Support</a></p>
            <p><a class="inline-flex gap-x-2 text-gray-600 hover:text-gray-800" href="#">Help Center</a></p>
          </div>
        </div>
        <div>
          <h4 class="text-xs font-semibold text-gray-900 uppercase">Company</h4>
          <div class="mt-3 grid space-y-3 text-sm">
            <p><a class="inline-flex gap-x-2 text-gray-600 hover:text-gray-800" href="#">About Us</a></p>
            <p><a class="inline-flex gap-x-2 text-gray-600 hover:text-gray-800" href="#">Privacy Policy</a></p>
          </div>
        </div>
        <div>
          <h4 class="text-xs font-semibold text-gray-900 uppercase">Hotels</h4>
          <div class="mt-3 grid space-y-3 text-sm">
            <p><%= link_to "Join WAStays", register_path, class: "inline-flex gap-x-2 text-gray-600 hover:text-gray-800" %></p>
            <p><%= link_to "Hotel Login", login_path, class: "inline-flex gap-x-2 text-gray-600 hover:text-gray-800" %></p>
          </div>
        </div>
      </div>
      <div class="pt-5 mt-5 border-t border-gray-200">
        <p class="text-sm text-gray-600 text-center">© 2026 WAStays. All rights reserved.</p>
      </div>
    </footer>
  </body>
</html>
