<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Wastays" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <link rel="icon" href="<%= asset_path('logo/icon-logo.png') %>" type="image/png">
    <link rel="apple-touch-icon" href="<%= asset_path('logo/icon-logo.png') %>">

    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <%= stylesheet_link_tag :app, "data-turbo-track": (Rails.env.production? ? "reload" : nil) %>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/preline@2.4.1/dist/preline.min.css">
    <%= javascript_importmap_tags %>
  </head>

  <body class="bg-neutral-bg text-neutral-text-primary font-sans antialiased">


    <% unless content_for?(:hide_chrome) %>
    <!-- Desktop/Mobile Top Nav -->
    <header class="sticky top-0 z-50 w-full bg-white/90 backdrop-blur-lg border-b border-neutral-border/60 shadow-sm shadow-black/[0.04]">
      <nav class="max-w-[85rem] w-full mx-auto px-4 sm:px-6 lg:px-8 flex items-center justify-between h-16" aria-label="Global">

        <!-- Logo -->
        <a class="flex items-center flex-none focus:outline-none group" href="<%= root_path %>" aria-label="WAStays">
          <%= image_tag "logo/long-logo.png", alt: "WAStays", class: "block h-11 w-auto" %>
        </a>

        <!-- Nav links (desktop) -->
        <div class="hidden md:flex items-center gap-x-1">
          <a class="relative px-4 py-2 rounded-full text-sm font-medium text-neutral-text-secondary hover:text-brand-primary hover:bg-brand-primary/5 transition-all duration-200 focus:outline-none" href="<%= root_path(anchor: "products") %>">How It Works</a>
          <a class="relative px-4 py-2 rounded-full text-sm font-medium text-neutral-text-secondary hover:text-brand-primary hover:bg-brand-primary/5 transition-all duration-200 focus:outline-none" href="<%= root_path(anchor: "whatsapp") %>">Why WhatsApp</a>
          <a class="relative px-4 py-2 rounded-full text-sm font-medium text-neutral-text-secondary hover:text-brand-primary hover:bg-brand-primary/5 transition-all duration-200 focus:outline-none" href="<%= root_path(anchor: "testimonials") %>">Testimonials</a>
          <a class="relative px-4 py-2 rounded-full text-sm font-medium text-neutral-text-secondary hover:text-brand-primary hover:bg-brand-primary/5 transition-all duration-200 focus:outline-none" href="<%= root_path(anchor: "faq") %>">FAQ</a>
        </div>

        <!-- CTAs -->
        <div class="flex items-center gap-x-2">
          <% if logged_in? %>
            <div class="relative inline-flex" data-controller="dropdown">

              <!-- Trigger: letter avatar + name -->
              <button data-action="click->dropdown#toggle" type="button"
                      class="inline-flex items-center gap-x-2.5 hover:opacity-80 transition-opacity duration-200 focus:outline-none">
                <div class="w-8 h-8 rounded-full bg-neutral-text-primary/10 border border-neutral-text-primary/20 flex items-center justify-center flex-none">
                  <svg class="w-4 h-4 text-neutral-text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path></svg>
                </div>
                <span class="hidden sm:inline-block text-sm font-semibold text-neutral-text-primary"><%= current_user.name %></span>
              </button>

              <!-- Dropdown panel -->
              <div data-dropdown-target="menu" class="hidden absolute right-0 top-full w-64 bg-white shadow-xl rounded-2xl mt-2 z-70 border border-neutral-border/50 overflow-hidden animate-in fade-in zoom-in duration-200">

                <!-- User info header -->
                <div class="flex items-center gap-x-3 px-4 py-4 border-b border-neutral-border/50">
                  <div class="w-10 h-10 rounded-full bg-brand-primary/10 border border-brand-primary/20 flex items-center justify-center flex-none">
                    <svg class="w-5 h-5 text-brand-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path></svg>
                  </div>
                  <div class="min-w-0">
                    <p class="text-sm font-bold text-neutral-text-primary truncate"><%= current_user.name %></p>
                    <p class="text-xs text-neutral-text-secondary truncate"><%= current_user.email %></p>
                  </div>
                </div>

                <!-- Menu items -->
                <div class="p-1.5 space-y-0.5">
                  <% if current_user.superadmin? %>
                    <a class="flex items-center gap-x-3 py-2.5 px-3 rounded-xl text-sm text-neutral-text-primary hover:bg-neutral-bg transition-colors" href="<%= admin_dashboard_path %>">
                      <svg class="w-4 h-4 text-neutral-text-secondary flex-none" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 3H5a2 2 0 00-2 2v4m6-6h10a2 2 0 012 2v4M9 3v18m0 0h10a2 2 0 002-2v-4M9 21H5a2 2 0 01-2-2v-4m0 0h18"></path></svg>
                      Admin Panel
                    </a>
                  <% end %>
                  <% if current_hotel.present? %>
                    <a class="flex items-center gap-x-3 py-2.5 px-3 rounded-xl text-sm text-neutral-text-primary hover:bg-neutral-bg transition-colors" href="<%= hotel_dashboard_path(current_hotel) %>">
                      <svg class="w-4 h-4 text-neutral-text-secondary flex-none" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"></path></svg>
                      Hotel Dashboard
                    </a>
                  <% end %>
                  <a class="flex items-center gap-x-3 py-2.5 px-3 rounded-xl text-sm text-neutral-text-primary hover:bg-neutral-bg transition-colors" href="<%= current_user.superadmin? ? edit_admin_profile_path : edit_hotel_user_profile_path(current_hotel) %>">
                    <svg class="w-4 h-4 text-neutral-text-secondary flex-none" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path></svg>
                    My Account
                  </a>
                  <a class="flex items-center gap-x-3 py-2.5 px-3 rounded-xl text-sm text-neutral-text-primary hover:bg-neutral-bg transition-colors" href="<%= current_user.superadmin? ? edit_admin_profile_path : edit_hotel_user_profile_path(current_hotel) %>">
                    <svg class="w-4 h-4 text-neutral-text-secondary flex-none" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"></path><circle cx="12" cy="12" r="3"></circle></svg>
                    Settings
                  </a>
                </div>

                <!-- Sign out -->
                <div class="p-1.5 border-t border-neutral-border/50">
                  <%= button_to logout_path, method: :delete, class: "flex items-center gap-x-3 py-2.5 px-3 rounded-xl text-sm text-status-error hover:bg-red-50 transition-colors w-full text-left" do %>
                    <svg class="w-4 h-4 flex-none" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"></path></svg>
                    Sign out
                  <% end %>
                </div>

              </div>
            </div>
          <% else %>
            <a class="inline-flex items-center px-5 py-2 rounded-full text-sm font-semibold text-white bg-brand-primary hover:bg-brand-primary/90 shadow-sm hover:shadow-md hover:shadow-brand-primary/20 transition-all duration-200" href="<%= login_path %>">
              Login
            </a>
          <% end %>
        </div>

      </nav>
    </header>
    <% end %>

    <% if flash.any? %>
      <div class="fixed bottom-6 right-6 z-[200] flex flex-col gap-y-3 pointer-events-none">
        <% flash.each do |key, value| %>
          <div data-controller="toast"
               class="pointer-events-auto flex items-start gap-x-3 w-80 bg-white rounded-2xl shadow-xl shadow-black/10 border border-neutral-border/60 px-4 py-3.5 transition-all duration-250"
               role="alert">
            <% if key == 'alert' %>
              <div class="flex-none w-8 h-8 rounded-full bg-red-50 flex items-center justify-center mt-0.5">
                <svg class="w-4 h-4 text-status-error" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
              </div>
            <% else %>
              <div class="flex-none w-8 h-8 rounded-full bg-green-50 flex items-center justify-center mt-0.5">
                <svg class="w-4 h-4 text-status-success" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
              </div>
            <% end %>
            <div class="flex-1 min-w-0 pt-0.5">
              <p class="text-sm font-semibold text-neutral-text-primary"><%= key == 'alert' ? 'Something went wrong' : 'Success' %></p>
              <p class="text-xs text-neutral-text-secondary mt-0.5 leading-relaxed"><%= value %></p>
            </div>
            <button data-action="click->toast#dismiss" class="flex-none text-neutral-text-secondary hover:text-neutral-text-primary transition-colors mt-0.5 focus:outline-none">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
            </button>
          </div>
        <% end %>
      </div>
    <% end %>

    <main id="content" role="main">
      <%= yield %>
    </main>

    <% unless controller_name == "static_pages" && (action_name == "home" || action_name == "explore") %>
      <!-- Mobile Bottom Nav (Phase 4 requirement) -->
      <div class="sm:hidden sticky bottom-0 z-50 w-full bg-white/95 backdrop-blur-md border-t border-neutral-border pb-safe">
        <nav class="flex items-center justify-around py-3 px-4">
          <a href="<%= root_path %>" class="flex flex-col items-center gap-y-1 text-neutral-text-secondary hover:text-brand-primary">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
            <span class="text-[10px] font-medium">Home</span>
          </a>
          <a href="<%= hotels_path %>" class="flex flex-col items-center gap-y-1 text-neutral-text-secondary hover:text-brand-primary">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
            <span class="text-[10px] font-medium">Search</span>
          </a>
          <a href="<%= help_center_path %>" class="flex flex-col items-center gap-y-1 text-neutral-text-secondary hover:text-brand-primary">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
            <span class="text-[10px] font-medium">Help</span>
          </a>
          <a href="<%= login_path %>" class="flex flex-col items-center gap-y-1 text-neutral-text-secondary hover:text-brand-primary">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
            <span class="text-[10px] font-medium">Account</span>
          </a>
        </nav>
      </div>
    <% end %>

    <% unless content_for?(:hide_chrome) %>
    <footer class="bg-[#0d1a17]">

      <!-- Top gradient rule -->
      <div class="h-px bg-gradient-to-r from-transparent via-[#d9c5a0]/20 to-transparent"></div>

      <div class="max-w-[85rem] px-4 sm:px-6 lg:px-8 mx-auto py-16 lg:py-20">

        <!-- Main grid -->
        <div class="grid grid-cols-1 lg:grid-cols-5 gap-12 pb-12 border-b border-white/5">

          <!-- Brand column -->
          <div class="lg:col-span-2">
            <a class="inline-block mb-4" href="<%= root_path %>" aria-label="WAStays">
              <%= image_tag "logo/long-logo.png", alt: "WAStays", class: "block h-12 w-auto -ml-2" %>
            </a>
            <p class="text-sm text-gray-400 leading-relaxed max-w-xs mb-8">
              Helping independent hotels automate guest communication, grow direct revenue, and deliver exceptional hospitality — through WhatsApp.
            </p>
            <a href="https://wa.me/601139278173" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-x-2.5 text-sm font-medium text-[#25D366] hover:text-[#25D366]/70 transition-colors group">
              <svg class="w-4 h-4 flex-none" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/></svg>
              Chat with us on WhatsApp
              <svg class="w-3 h-3 group-hover:translate-x-0.5 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"></path></svg>
            </a>
          </div>

          <!-- Support -->
          <div>
            <h4 class="text-[10px] font-bold uppercase tracking-[0.2em] text-[#d9c5a0] mb-6">Support</h4>
            <ul class="space-y-4">
              <li><a class="text-sm text-gray-300 hover:text-white transition-colors duration-200" href="mailto:support@wastays.com">Email Support</a></li>
              <li><a class="text-sm text-gray-300 hover:text-white transition-colors duration-200" href="<%= help_center_path %>">Help Center</a></li>
              <li><%= link_to "FAQ", root_path(anchor: "faq"), class: "text-sm text-gray-300 hover:text-white transition-colors duration-200" %></li>
            </ul>
          </div>

          <!-- Company -->
          <div>
            <h4 class="text-[10px] font-bold uppercase tracking-[0.2em] text-[#d9c5a0] mb-6">Company</h4>
            <ul class="space-y-4">
              <li><a class="text-sm text-gray-300 hover:text-white transition-colors duration-200" href="#">About Us</a></li>
            </ul>
          </div>

          <!-- For Hotels -->
          <div>
            <h4 class="text-[10px] font-bold uppercase tracking-[0.2em] text-[#d9c5a0] mb-6">For Hotels</h4>
            <ul class="space-y-4">
              <li><%= link_to "Explore Hotel", explore_path, class: "text-sm text-gray-300 hover:text-white transition-colors duration-200" %></li>
              <li><%= link_to "Register Your Hotel", register_path, class: "text-sm text-gray-300 hover:text-white transition-colors duration-200" %></li>
              <li><%= link_to "Hotel Login", login_path, class: "text-sm text-gray-300 hover:text-white transition-colors duration-200" %></li>
            </ul>
          </div>

        </div>

        <!-- Bottom bar -->
        <div class="pt-8 flex flex-col sm:flex-row items-center justify-between gap-4">
          <div class="flex items-center gap-x-3">
            <span class="text-sm font-semibold text-white/60 tracking-tight">WAStays</span>
            <span class="w-px h-3.5 bg-white/10"></span>
            <p class="text-sm text-gray-400">&copy; <%= Date.today.year %> WAStays. All rights reserved.</p>
          </div>
          <div class="flex items-center gap-x-4 text-xs text-gray-400">
            <a class="hover:text-white transition-colors duration-200" href="#">Privacy Policy</a>
            <span class="w-px h-3 bg-white/10"></span>
            <a class="hover:text-white transition-colors duration-200" href="#">Terms &amp; Conditions</a>
          </div>
        </div>

      </div>
    </footer>
    <% end %>
  </body>
</html>
