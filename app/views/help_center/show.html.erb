<div class="bg-neutral-bg min-h-screen">
  <!-- Article Header -->
  <div class="bg-white border-b border-neutral-border py-8">
    <div class="max-w-[85rem] mx-auto px-4 sm:px-6 lg:px-8">
      <nav class="flex mb-4" aria-label="Breadcrumb">
        <ol class="flex items-center whitespace-nowrap min-w-0">
          <li class="flex items-center text-sm text-neutral-text-secondary">
            <%= link_to "Knowledge Base", help_center_path, class: "hover:text-brand-primary font-medium" %>
            <svg class="flex-shrink-0 mx-2 overflow-visible h-4 w-4 text-gray-400" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg>
          </li>
          <li class="text-sm font-bold text-neutral-text-primary truncate" aria-current="page">
            <%= @title %>
          </li>
        </ol>
      </nav>

      <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
        <div>
          <div class="flex items-center gap-x-2 mb-2">
            <% if @audience == 'superadmin' %>
              <span class="inline-flex items-center gap-x-1.5 py-1 px-2 rounded-md text-[10px] font-black uppercase tracking-widest bg-red-50 text-brand-primary border border-red-100">
                Platform Operator
              </span>
            <% else %>
              <span class="inline-flex items-center gap-x-1.5 py-1 px-2 rounded-md text-[10px] font-black uppercase tracking-widest bg-orange-50 text-brand-secondary border border-orange-100">
                Hotel Admin
              </span>
            <% end %>
            <span class="text-[10px] font-bold text-neutral-text-secondary uppercase tracking-widest">• Updated March 2026</span>
          </div>
          <h1 class="text-3xl md:text-4xl font-black text-neutral-text-primary tracking-tight"><%= @title %></h1>
        </div>
        
        <div class="hidden md:block">
          <button onclick="window.print()" class="btn btn-secondary py-2 px-4 text-xs font-bold uppercase tracking-widest">
            Print Guide
          </button>
        </div>
      </div>
    </div>
  </div>

  <div class="max-w-[85rem] mx-auto px-4 py-10 sm:px-6 lg:px-8">
    <div class="grid lg:grid-cols-12 gap-12">
      <!-- Main Content -->
      <article class="lg:col-span-8">
        <div class="card p-6 md:p-10 shadow-sm">
          <div class="prose prose-neutral max-w-none 
            prose-headings:font-black prose-headings:tracking-tight prose-headings:text-neutral-text-primary
            prose-p:text-neutral-text-secondary prose-p:leading-relaxed
            prose-li:text-neutral-text-secondary prose-strong:text-neutral-text-primary
            prose-a:text-brand-primary prose-a:no-underline hover:prose-a:underline">
            <%= raw @html_content %>
          </div>
          
          <div class="mt-12 pt-8 border-t border-neutral-border flex flex-col sm:flex-row items-center justify-between gap-4">
            <p class="text-sm font-bold text-neutral-text-secondary italic">Was this guide helpful?</p>
            <div class="flex gap-x-2">
              <button class="btn btn-secondary py-1.5 px-4 text-xs">Yes, thanks!</button>
              <button class="btn btn-secondary py-1.5 px-4 text-xs">Not really</button>
            </div>
          </div>
        </div>
      </article>

      <!-- Sidebar -->
      <aside class="lg:col-span-4 space-y-8">
        <!-- Related Guides -->
        <div class="card p-6">
          <h3 class="text-xs font-black text-neutral-text-primary uppercase tracking-widest mb-6 border-b border-neutral-bg pb-4">Other Guides</h3>
          <ul class="space-y-4">
            <% list_guides(@audience).each do |guide| %>
              <% next if guide[:slug] == @slug %>
              <li>
                <%= link_to help_guide_path(audience: guide[:audience], id: guide[:slug]), class: "group flex items-start gap-x-3" do %>
                  <div class="w-1.5 h-1.5 rounded-full bg-neutral-border mt-1.5 group-hover:bg-brand-primary transition-colors"></div>
                  <span class="text-sm font-bold text-neutral-text-secondary group-hover:text-brand-primary transition-colors"><%= guide[:title] %></span>
                <% end %>
              </li>
            <% end %>
          </ul>
        </div>

        <!-- Sticky Help Card -->
        <div class="sticky top-[130px]">
          <div class="card p-6 bg-brand-gradient text-white border-none shadow-xl shadow-brand-primary/20">
            <div class="w-10 h-10 bg-white/20 rounded-xl flex items-center justify-center mb-4">
              <svg class="w-6 h-6" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/></svg>
            </div>
            <h4 class="text-lg font-black mb-2 leading-tight">Need immediate assistance?</h4>
            <p class="text-white/80 text-xs mb-6">Our support team is active on WhatsApp for urgent operational queries.</p>
            <a href="#" class="inline-flex items-center justify-center w-full bg-white text-brand-primary py-3 rounded-xl font-black text-xs uppercase tracking-widest hover:bg-neutral-bg transition-colors shadow-lg">
              Open WhatsApp
            </a>
          </div>
        </div>
      </aside>
    </div>
  </div>
</div>

<style>
  /* Local overrides for Commonmarker output */
  .prose h1, .prose h2, .prose h3 { scroll-margin-top: 100px; margin-bottom: 1.5rem; margin-top: 2.5rem; }
  .prose h1 { font-size: 2.25rem; border-bottom: 2px solid var(--color-neutral-border); padding-bottom: 1rem; }
  .prose h2 { font-size: 1.5rem; border-left: 4px solid var(--color-brand-primary); padding-left: 1rem; }
  .prose p { margin-bottom: 1.25rem; }
  .prose ul { list-style-type: disc; padding-left: 1.5rem; margin-bottom: 1.25rem; }
  .prose ol { list-style-type: decimal; padding-left: 1.5rem; margin-bottom: 1.25rem; }
  .prose li { margin-bottom: 0.5rem; }
  .prose hr { margin: 3rem 0; border: 0; border-top: 1px solid var(--color-neutral-border); }
  .prose img { @apply rounded-2xl shadow-lg border border-neutral-border; margin: 2rem 0; }
  .prose pre { @apply bg-neutral-text-primary text-white p-4 rounded-xl overflow-x-auto; margin: 1.5rem 0; }
  .prose code { @apply bg-neutral-bg text-brand-primary px-1.5 py-0.5 rounded font-mono text-sm; }
  .prose strong { @apply font-black text-neutral-text-primary; }
  .prose blockquote { border-left: 4px solid var(--color-neutral-border); padding-left: 1rem; font-style: italic; color: var(--color-neutral-text-secondary); margin: 1.5rem 0; }
</style>
