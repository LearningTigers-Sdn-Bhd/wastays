<div class="bg-neutral-bg min-h-screen">
  <!-- Knowledge Base Hero -->
  <div class="bg-brand-gradient py-16 sm:py-24 px-4 relative overflow-hidden">
    <div class="absolute inset-0 opacity-10">
      <svg class="w-full h-full" viewBox="0 0 100 100" preserveAspectRatio="none"><path d="M0 0 L100 0 L100 100 L0 100 Z" fill="url(#grid)"></path><defs><pattern id="grid" width="10" height="10" patternUnits="userSpaceOnUse"><path d="M 10 0 L 0 0 0 10" fill="none" stroke="white" stroke-width="0.5"/></pattern></defs></svg>
    </div>
    <div class="relative max-w-[85rem] mx-auto text-center">
      <h1 class="text-3xl sm:text-5xl font-black text-white tracking-tight mb-4">Knowledge Base</h1>
      <p class="text-white/80 text-lg max-w-2xl mx-auto mb-10">Find guides, operational notes, and troubleshooting tips for WAStays.</p>
      
      <!-- Search -->
      <div class="max-w-2xl mx-auto relative group">
        <div class="absolute inset-y-0 start-0 flex items-center ps-4 pointer-events-none group-focus-within:text-brand-primary transition-colors">
          <svg class="w-5 h-5 text-neutral-text-secondary" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
        </div>
        <input type="text" class="py-4 ps-12 pe-4 block w-full bg-white border-transparent rounded-2xl text-base focus:border-brand-primary focus:ring-brand-primary shadow-2xl" placeholder="Search for guides (e.g. 'how to update rates')...">
      </div>
    </div>
  </div>

  <div class="max-w-[85rem] mx-auto px-4 py-12 sm:px-6 lg:px-8">
    <div class="grid md:grid-cols-2 gap-8">
      <!-- Hotel Admin Section -->
      <div class="card p-0 overflow-hidden group hover:shadow-xl transition-all duration-300">
        <div class="h-2 bg-brand-secondary"></div>
        <div class="p-6 md:p-8">
          <div class="flex items-center gap-x-4 mb-6">
            <div class="w-12 h-12 rounded-2xl bg-orange-50 text-brand-secondary flex items-center justify-center">
              <svg class="w-6 h-6" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/></svg>
            </div>
            <div>
              <h2 class="text-xl font-black text-neutral-text-primary uppercase tracking-tight">Hotel Operators</h2>
              <p class="text-xs font-bold text-neutral-text-secondary uppercase tracking-widest">Management & Front Desk</p>
            </div>
          </div>

          <ul class="space-y-4">
            <% if @hotel_guides.any? %>
              <% @hotel_guides.each do |guide| %>
                <li>
                  <%= link_to help_guide_path(audience: guide[:audience], id: guide[:slug]), class: "flex items-center group/item" do %>
                    <div class="flex-1">
                      <h3 class="text-sm font-bold text-neutral-text-primary group-hover/item:text-brand-secondary transition-colors"><%= guide[:title] %></h3>
                    </div>
                    <svg class="w-4 h-4 text-neutral-border group-hover/item:text-brand-secondary transition-all transform group-hover/item:translate-x-1" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg>
                  <% end %>
                </li>
              <% end %>
            <% else %>
              <p class="text-sm text-neutral-text-secondary italic bg-neutral-bg p-4 rounded-xl border border-dashed border-neutral-border">No operator guides available yet.</p>
            <% end %>
          </ul>
        </div>
      </div>

      <!-- Superadmin Section -->
      <% if current_user.superadmin? %>
        <div class="card p-0 overflow-hidden group hover:shadow-xl transition-all duration-300">
          <div class="h-2 bg-brand-primary"></div>
          <div class="p-6 md:p-8">
            <div class="flex items-center gap-x-4 mb-6">
              <div class="w-12 h-12 rounded-2xl bg-red-50 text-brand-primary flex items-center justify-center">
                <svg class="w-6 h-6" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
              </div>
              <div>
                <h2 class="text-xl font-black text-neutral-text-primary uppercase tracking-tight">Platform Control</h2>
                <p class="text-xs font-bold text-neutral-text-secondary uppercase tracking-widest">Internal Operations</p>
              </div>
            </div>

            <ul class="space-y-4">
              <% if @superadmin_guides.any? %>
                <% @superadmin_guides.each do |guide| %>
                  <li>
                    <%= link_to help_guide_path(audience: guide[:audience], id: guide[:slug]), class: "flex items-center group/item" do %>
                      <div class="flex-1">
                        <h3 class="text-sm font-bold text-neutral-text-primary group-hover/item:text-brand-primary transition-colors"><%= guide[:title] %></h3>
                      </div>
                      <svg class="w-4 h-4 text-neutral-border group-hover/item:text-brand-primary transition-all transform group-hover/item:translate-x-1" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg>
                    <% end %>
                  </li>
                <% end %>
              <% else %>
                <p class="text-sm text-neutral-text-secondary italic bg-neutral-bg p-4 rounded-xl border border-dashed border-neutral-border">No platform guides available yet.</p>
              <% end %>
            </ul>
          </div>
        </div>
      <% else %>
        <div class="card p-8 bg-neutral-surface border-dashed border-2 flex flex-col items-center justify-center text-center opacity-60">
          <div class="w-16 h-16 rounded-full bg-neutral-bg text-neutral-border flex items-center justify-center mb-4">
            <svg class="w-8 h-8" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" d="M16.5 10.5V6.75a4.5 4.5 0 1 0-9 0v3.75m-.75 11.25h10.5a2.25 2.25 0 0 0 2.25-2.25v-6.75a2.25 2.25 0 0 0-2.25-2.25H6.75a2.25 2.25 0 0 0-2.25 2.25v6.75a2.25 2.25 0 0 0 2.25 2.25Z" />
            </svg>
          </div>
          <h3 class="text-sm font-bold text-neutral-text-primary uppercase tracking-widest mb-2">Internal Access Only</h3>
          <p class="text-xs text-neutral-text-secondary">Platform governance and technical documentation are restricted to Superadmins.</p>
        </div>
      <% end %>
    </div>

    <!-- Help Footer -->
    <div class="mt-16 bg-white rounded-3xl p-8 md:p-12 shadow-sm border border-neutral-border text-center">
      <h2 class="text-2xl font-black text-neutral-text-primary mb-4">Still need assistance?</h2>
      <p class="text-neutral-text-secondary mb-8 max-w-xl mx-auto">If you can't find what you're looking for, our support team is available via WhatsApp for immediate operational support.</p>
      <div class="flex flex-col sm:flex-row justify-center gap-4">
        <a href="#" class="btn btn-secondary border-green-200 text-green-700 hover:bg-green-50 px-8">
          <svg class="w-5 h-5 me-2" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/></svg>
          Operational Support
        </a>
        <a href="mailto:support@wastays.com" class="btn btn-secondary px-8">Email Desk</a>
      </div>
    </div>
  </div>
</div>
