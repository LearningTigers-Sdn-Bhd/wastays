<div class="max-w-[85rem] px-4 py-10 sm:px-6 lg:px-8 lg:py-14 mx-auto">
  <!-- Title -->
  <div class="max-w-2xl mx-auto text-center mb-10 lg:mb-14">
    <h2 class="text-3xl font-bold md:text-4xl md:leading-tight text-gray-800">Help Center</h2>
    <p class="mt-1 text-gray-600">Everything you need to know about operating the WAStays platform.</p>
  </div>
  <!-- End Title -->

  <div class="grid sm:grid-cols-2 lg:grid-cols-2 gap-6">
    <!-- Hotel Admin Section -->
    <div class="group flex flex-col h-full bg-white border border-gray-200 shadow-sm rounded-xl">
      <div class="h-2 bg-blue-600 rounded-t-xl"></div>
      <div class="p-4 md:p-6">
        <h3 class="text-xl font-semibold text-gray-800 mb-4">Hotel Administrator Guides</h3>
        <ul class="space-y-3">
          <% if @hotel_guides.any? %>
            <% @hotel_guides.each do |guide| %>
              <li>
                <%= link_to help_guide_path(audience: guide[:audience], id: guide[:slug]), class: "flex items-center gap-x-2 text-blue-600 hover:text-blue-800" do %>
                  <svg class="flex-shrink-0 size-4" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/></svg>
                  <%= guide[:title] %>
                <% end %>
              </li>
            <% end %>
          <% else %>
            <p class="text-sm text-gray-500 italic">No guides available yet.</p>
          <% end %>
        </ul>
      </div>
    </div>

    <!-- Superadmin Section -->
    <% if current_user.superadmin? %>
      <div class="group flex flex-col h-full bg-white border border-gray-200 shadow-sm rounded-xl">
        <div class="h-2 bg-purple-600 rounded-t-xl"></div>
        <div class="p-4 md:p-6">
          <h3 class="text-xl font-semibold text-gray-800 mb-4">Platform (Superadmin) Guides</h3>
          <ul class="space-y-3">
            <% if @superadmin_guides.any? %>
              <% @superadmin_guides.each do |guide| %>
                <li>
                  <%= link_to help_guide_path(audience: guide[:audience], id: guide[:slug]), class: "flex items-center gap-x-2 text-purple-600 hover:text-purple-800" do %>
                    <svg class="flex-shrink-0 size-4" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
                    <%= guide[:title] %>
                  <% end %>
                </li>
              <% end %>
            <% else %>
              <p class="text-sm text-gray-500 italic">No platform guides available yet.</p>
            <% end %>
          </ul>
        </div>
      </div>
    <% else %>
      <div class="bg-gray-50 border border-dashed border-gray-300 rounded-xl p-6 flex flex-col items-center justify-center text-center">
        <svg class="size-10 text-gray-400 mb-2" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" d="M16.5 10.5V6.75a4.5 4.5 0 1 0-9 0v3.75m-.75 11.25h10.5a2.25 2.25 0 0 0 2.25-2.25v-6.75a2.25 2.25 0 0 0-2.25-2.25H6.75a2.25 2.25 0 0 0-2.25 2.25v6.75a2.25 2.25 0 0 0 2.25 2.25Z" />
        </svg>
        <p class="text-sm text-gray-500">Platform operational guides are only visible to superadmins.</p>
      </div>
    <% end %>
  </div>
</div>
