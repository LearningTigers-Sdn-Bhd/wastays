<div class="bg-neutral-bg min-h-screen pb-16">
  <div class="max-w-5xl mx-auto px-4 py-10">
    <div class="mb-8">
      <p class="text-xs font-black uppercase tracking-widest text-brand-primary">Pre Check-In</p>
      <h1 class="mt-2 text-3xl font-black text-neutral-text-primary">Complete your arrival details</h1>
      <p class="mt-2 text-sm text-neutral-text-secondary">
        Review your booking details and fill in the missing information before you arrive at <%= @presenter.hotel_name %>.
      </p>
    </div>

    <div class="space-y-6">
      <div class="card p-6 md:p-8">
        <div class="mb-6">
          <h2 class="text-sm font-black uppercase tracking-widest text-neutral-text-primary">Booking Details</h2>
          <p class="mt-1 text-xs text-neutral-text-secondary">
            Review these details before completing your arrival information.
          </p>
        </div>

        <div class="grid gap-4 md:grid-cols-2">
          <div>
            <label class="block text-xs font-bold uppercase tracking-widest text-neutral-text-secondary mb-2">Reference</label>
            <div class="rounded-lg border border-neutral-border bg-neutral-bg px-4 py-3 min-h-[72px] flex items-center">
              <p class="font-mono font-semibold text-neutral-text-primary break-all"><%= @presenter.confirmation_token %></p>
            </div>
          </div>

          <div>
            <label class="block text-xs font-bold uppercase tracking-widest text-neutral-text-secondary mb-2">Hotel</label>
            <div class="rounded-lg border border-neutral-border bg-neutral-bg px-4 py-3 min-h-[72px] flex items-center">
              <div>
                <p class="font-semibold text-neutral-text-primary"><%= @presenter.hotel_name %></p>
                <p class="text-xs text-neutral-text-secondary"><%= @presenter.hotel_location %></p>
              </div>
            </div>
          </div>

          <div>
            <label class="block text-xs font-bold uppercase tracking-widest text-neutral-text-secondary mb-2">Stay</label>
            <div class="rounded-lg border border-neutral-border bg-neutral-bg px-4 py-3 min-h-[72px] flex items-center">
              <p class="font-semibold text-neutral-text-primary"><%= @presenter.stay_dates %></p>
            </div>
          </div>

          <div>
            <label class="block text-xs font-bold uppercase tracking-widest text-neutral-text-secondary mb-2">Rooms</label>
            <div class="rounded-lg border border-neutral-border bg-neutral-bg px-4 py-3 min-h-[72px] flex items-center">
              <p class="font-semibold text-neutral-text-primary"><%= @presenter.rooms_count_label %></p>
            </div>
          </div>
        </div>
      </div>

      <div class="card p-6 md:p-8" data-controller="scanner">
        <% if @presenter.completed? %>
          <div class="rounded-2xl border border-green-200 bg-green-50 p-6">
            <h2 class="text-xl font-black text-neutral-text-primary">Pre check-in completed</h2>
            <p class="mt-2 text-sm text-neutral-text-secondary">
              Your arrival details have been saved successfully.
            </p>
          </div>
        <% else %>
          <%= form_with model: @booking, url: pre_checkin_path(@pre_checkin.token), method: :patch, local: true, autocomplete: "off", class: "space-y-8" do |f| %>
            <% if @presenter.any_errors? %>
              <div class="rounded-2xl border border-red-200 bg-red-50 p-4 text-sm text-red-700">
                <p class="font-black uppercase tracking-widest text-xs">Please fix the following</p>
                <ul class="mt-2 list-disc space-y-1 ps-5">
                  <% @presenter.errors.each do |message| %>
                    <li><%= message %></li>
                  <% end %>
                </ul>
              </div>
            <% end %>

            <section class="space-y-4">
              <div>
                <h2 class="text-sm font-black uppercase tracking-widest text-neutral-text-primary">Guest Identification</h2>
                <p class="mt-1 text-xs text-neutral-text-secondary">Use the same details as shown on your identification document.</p>
              </div>

              <div class="grid gap-4 md:grid-cols-2">
                <div>
                  <%= f.label :guest_name, "Full Name", class: "block text-xs font-bold uppercase tracking-widest text-neutral-text-secondary mb-2" %>
                  <%= f.text_field :guest_name, class: "form-input py-3 px-5 border border-neutral-border", required: true %>
                </div>

                <div>
                  <%= f.label :guest_document_type, "Document Type", class: "block text-xs font-bold uppercase tracking-widest text-neutral-text-secondary mb-2" %>
                  <%= f.select :guest_document_type, [["Select Document", ""], ["Identity Card (IC)", "ic"], ["Passport", "passport"]], {}, class: "form-input py-3 px-5 border border-neutral-border", required: true %>
                </div>

                <div>
                  <%= f.label :guest_government_id, "ID / Passport Number", class: "block text-xs font-bold uppercase tracking-widest text-neutral-text-secondary mb-2" %>
                  <%= f.text_field :guest_government_id, class: "form-input py-3 px-5 border border-neutral-border", required: true, placeholder: "e.g. 900101011234" %>
                </div>
              </div>

              <div class="grid gap-6 md:grid-cols-2 mt-4">
                <div class="space-y-3" data-controller="id-upload">
                  <label class="block text-xs font-bold uppercase tracking-widest text-neutral-text-secondary">Front ID / Passport</label>
                  <div class="relative group h-44 w-full">
                    <!-- Upload Placeholder -->
                    <div data-action="click->id-upload#openGallery" data-id-upload-target="placeholder" class="flex flex-col items-center justify-center w-full h-full border-2 border-dashed border-slate-300 rounded-2xl cursor-pointer hover:bg-slate-50 transition bg-white overflow-hidden">
                      <div class="flex flex-col items-center justify-center">
                        <div class="mb-2 text-slate-400 group-hover:text-slate-500 transition-colors">
                          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-12 h-12">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 6a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0zM4.501 20.118a7.5 7.5 0 0114.998 0A17.933 17.933 0 0112 21.75c-2.676 0-5.216-.584-7.499-1.632z" />
                          </svg>
                          <div class="w-8 h-0.5 bg-current mx-auto mt-1 rounded-full opacity-50"></div>
                        </div>
                        <p class="text-[10px] font-bold text-slate-600 uppercase tracking-widest">Front Side</p>
                        <p class="text-[9px] text-slate-400 mt-1 uppercase tracking-widest">Click to upload</p>
                      </div>

                      <!-- Mobile Scanner Button Overlay -->
                      <button type="button" data-action="click->scanner#open" data-input-id="booking_id_front" class="absolute bottom-3 right-3 w-10 h-10 bg-slate-900 rounded-xl flex md:hidden items-center justify-center text-white shadow-lg hover:bg-slate-800 transition z-10">
                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-5 h-5">
                          <path stroke-linecap="round" stroke-linejoin="round" d="M6.827 6.175A2.31 2.31 0 015.186 7.23c-.38.054-.757.112-1.134.175C2.999 7.58 2.25 8.507 2.25 9.574V18a2.25 2.25 0 002.25 2.25h15A2.25 2.25 0 0021.75 18V9.574c0-1.067-.75-1.994-1.802-2.169a47.865 47.865 0 00-1.134-.175 2.31 2.31 0 01-1.64-1.055l-.822-1.316a2.192 2.192 0 00-1.736-1.039 48.774 48.774 0 00-5.232 0 2.192 2.192 0 00-1.736 1.039l-.821 1.316z" />
                          <path stroke-linecap="round" stroke-linejoin="round" d="M16.5 12.75a4.5 4.5 0 11-9 0 4.5 4.5 0 019 0zM18.75 10.5h.008v.008h-.008V10.5z" />
                        </svg>
                      </button>
                    </div>
                    
                    <!-- Image Preview Container -->
                    <div data-id-upload-target="previewContainer" class="hidden absolute inset-0 w-full h-full rounded-2xl overflow-hidden shadow-sm ring-1 ring-slate-200">
                      <img data-id-upload-target="preview" class="w-full h-full object-cover" />
                      <div class="absolute inset-0 bg-slate-900/40 opacity-0 group-hover:opacity-100 transition-opacity flex items-center justify-center gap-3">
                        <!-- Desktop Buttons -->
                        <button type="button" data-action="click->id-upload#openGallery" class="hidden md:inline-flex px-4 py-2 bg-white rounded-xl text-[10px] font-black uppercase tracking-widest text-slate-900 shadow-xl hover:bg-slate-200 transition">
                          Change Photo
                        </button>
                        
                        <!-- Mobile Button (Triggers Choice Menu) -->
                        <button type="button" data-action="click->id-upload#openChoiceMenu" class="md:hidden px-6 py-3 bg-white rounded-xl text-[11px] font-black uppercase tracking-widest text-slate-900 shadow-xl active:scale-95 transition">
                          Retake Photo
                        </button>
                      </div>
                    </div>

                    <!-- Choice Menu Action Sheet (Mobile Only) -->
                    <div data-id-upload-target="choiceMenu" class="hidden fixed inset-0 z-[110] bg-slate-900/60 backdrop-blur-sm transition-opacity" data-action="click->id-upload#closeChoiceMenu">
                      <div class="absolute bottom-0 inset-x-0 p-4 transform transition-transform translate-y-full bg-white rounded-t-[2.5rem] shadow-2xl" onclick="event.stopPropagation()">
                        <div class="w-12 h-1.5 bg-slate-200 rounded-full mx-auto mb-6"></div>
                        <h4 class="text-center text-sm font-black uppercase tracking-widest text-slate-900 mb-6">Retake ID Photo</h4>
                        
                        <div class="space-y-3 pb-8">
                          <button type="button" data-action="click->id-upload#closeChoiceMenu click->scanner#open" data-input-id="booking_id_front" class="w-full flex items-center gap-4 p-5 bg-slate-50 rounded-3xl hover:bg-slate-100 transition group">
                            <div class="w-12 h-12 bg-slate-900 rounded-2xl flex items-center justify-center text-white shadow-lg group-active:scale-90 transition">
                              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-6 h-6">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M6.827 6.175A2.31 2.31 0 015.186 7.23c-.38.054-.757.112-1.134.175C2.999 7.58 2.25 8.507 2.25 9.574V18a2.25 2.25 0 002.25 2.25h15A2.25 2.25 0 0021.75 18V9.574c0-1.067-.75-1.994-1.802-2.169a47.865 47.865 0 00-1.134-.175 2.31 2.31 0 01-1.64-1.055l-.822-1.316a2.192 2.192 0 00-1.736-1.039 48.774 48.774 0 00-5.232 0 2.192 2.192 0 00-1.736 1.039l-.821 1.316z" />
                                <path stroke-linecap="round" stroke-linejoin="round" d="M16.5 12.75a4.5 4.5 0 11-9 0 4.5 4.5 0 019 0zM18.75 10.5h.008v.008h-.008V10.5z" />
                              </svg>
                            </div>
                            <div class="text-left">
                              <p class="text-sm font-black text-slate-900 uppercase tracking-wider">Open Scanner</p>
                              <p class="text-[11px] text-slate-500 font-medium">Use your camera to scan ID</p>
                            </div>
                          </button>

                          <button type="button" data-action="click->id-upload#_openGallery" class="w-full flex items-center gap-4 p-5 bg-slate-50 rounded-3xl hover:bg-slate-100 transition group">
                            <div class="w-12 h-12 bg-emerald-500 rounded-2xl flex items-center justify-center text-white shadow-lg group-active:scale-90 transition">
                              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-6 h-6">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 15.75l5.159-5.159a2.25 2.25 0 013.182 0l5.159 5.159m-1.5-1.5l1.409-1.409a2.25 2.25 0 013.182 0l2.909 2.909m-18 3.75h16.5a1.5 1.5 0 001.5-1.5V6a1.5 1.5 0 00-1.5-1.5H3.75A1.5 1.5 0 002.25 6v12a1.5 1.5 0 001.5 1.5zm10.5-11.25h.008v.008h-.008V8.25zm.375 0a.375.375 0 11-.75 0 .375.375 0 01.75 0z" />
                              </svg>
                            </div>
                            <div class="text-left">
                              <p class="text-sm font-black text-slate-900 uppercase tracking-wider">Choose from Gallery</p>
                              <p class="text-[11px] text-slate-500 font-medium">Upload an existing photo</p>
                            </div>
                          </button>

                          <button type="button" data-action="click->id-upload#closeChoiceMenu" class="w-full p-5 text-sm font-black uppercase tracking-[0.2em] text-slate-400 hover:text-slate-600 transition">
                            Cancel
                          </button>
                        </div>
                      </div>
                    </div>

                    <%= f.file_field :id_front, class: "hidden", accept: "image/*", required: true, data: { id_upload_target: "input", action: "change->id-upload#updatePreview" } %>
                  </div>
                </div>

                <div class="space-y-3" data-controller="id-upload">
                  <label class="block text-xs font-bold uppercase tracking-widest text-neutral-text-secondary">Back ID / Passport</label>
                  <div class="relative group h-44 w-full">
                    <!-- Upload Placeholder -->
                    <div data-action="click->id-upload#openGallery" data-id-upload-target="placeholder" class="flex flex-col items-center justify-center w-full h-full border-2 border-dashed border-slate-300 rounded-2xl cursor-pointer hover:bg-slate-50 transition bg-white overflow-hidden">
                      <div class="flex flex-col items-center justify-center">
                        <div class="mb-2 text-slate-400 group-hover:text-slate-500 transition-colors">
                          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-12 h-12">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 8.25h19.5M2.25 9h19.5m-16.5 5.25h6m-6 2.25h3m-3.75 3h15a2.25 2.25 0 002.25-2.25V6.75A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25v10.5A2.25 2.25 0 004.5 19.5z" />
                          </svg>
                        </div>
                        <p class="text-[10px] font-bold text-slate-600 uppercase tracking-widest">Back Side</p>
                        <p class="text-[9px] text-slate-400 mt-1 uppercase tracking-widest">Click to upload</p>
                      </div>

                      <!-- Mobile Scanner Button Overlay -->
                      <button type="button" data-action="click->scanner#open" data-input-id="booking_id_back" class="absolute bottom-3 right-3 w-10 h-10 bg-slate-900 rounded-xl flex md:hidden items-center justify-center text-white shadow-lg hover:bg-slate-800 transition z-10">
                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-5 h-5">
                          <path stroke-linecap="round" stroke-linejoin="round" d="M6.827 6.175A2.31 2.31 0 015.186 7.23c-.38.054-.757.112-1.134.175C2.999 7.58 2.25 8.507 2.25 9.574V18a2.25 2.25 0 002.25 2.25h15A2.25 2.25 0 0021.75 18V9.574c0-1.067-.75-1.994-1.802-2.169a47.865 47.865 0 00-1.134-.175 2.31 2.31 0 01-1.64-1.055l-.822-1.316a2.192 2.192 0 00-1.736-1.039 48.774 48.774 0 00-5.232 0 2.192 2.192 0 00-1.736 1.039l-.821 1.316z" />
                          <path stroke-linecap="round" stroke-linejoin="round" d="M16.5 12.75a4.5 4.5 0 11-9 0 4.5 4.5 0 019 0zM18.75 10.5h.008v.008h-.008V10.5z" />
                        </svg>
                      </button>
                    </div>

                    <!-- Image Preview Container -->
                    <div data-id-upload-target="previewContainer" class="hidden absolute inset-0 w-full h-full rounded-2xl overflow-hidden shadow-sm ring-1 ring-slate-200">
                      <img data-id-upload-target="preview" class="w-full h-full object-cover" />
                      <div class="absolute inset-0 bg-slate-900/40 opacity-0 group-hover:opacity-100 transition-opacity flex items-center justify-center gap-3">
                        <!-- Desktop Buttons -->
                        <button type="button" data-action="click->id-upload#openGallery" class="hidden md:inline-flex px-4 py-2 bg-white rounded-xl text-[10px] font-black uppercase tracking-widest text-slate-900 shadow-xl hover:bg-slate-200 transition">
                          Change Photo
                        </button>
                        
                        <!-- Mobile Button (Triggers Choice Menu) -->
                        <button type="button" data-action="click->id-upload#openChoiceMenu" class="md:hidden px-6 py-3 bg-white rounded-xl text-[11px] font-black uppercase tracking-widest text-slate-900 shadow-xl active:scale-95 transition">
                          Retake Photo
                        </button>
                      </div>
                    </div>

                    <!-- Choice Menu Action Sheet (Mobile Only) -->
                    <div data-id-upload-target="choiceMenu" class="hidden fixed inset-0 z-[110] bg-slate-900/60 backdrop-blur-sm transition-opacity" data-action="click->id-upload#closeChoiceMenu">
                      <div class="absolute bottom-0 inset-x-0 p-4 transform transition-transform translate-y-full bg-white rounded-t-[2.5rem] shadow-2xl" onclick="event.stopPropagation()">
                        <div class="w-12 h-1.5 bg-slate-200 rounded-full mx-auto mb-6"></div>
                        <h4 class="text-center text-sm font-black uppercase tracking-widest text-slate-900 mb-6">Retake ID Photo</h4>
                        
                        <div class="space-y-3 pb-8">
                          <button type="button" data-action="click->id-upload#closeChoiceMenu click->scanner#open" data-input-id="booking_id_back" class="w-full flex items-center gap-4 p-5 bg-slate-50 rounded-3xl hover:bg-slate-100 transition group">
                            <div class="w-12 h-12 bg-slate-900 rounded-2xl flex items-center justify-center text-white shadow-lg group-active:scale-90 transition">
                              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-6 h-6">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M6.827 6.175A2.31 2.31 0 015.186 7.23c-.38.054-.757.112-1.134.175C2.999 7.58 2.25 8.507 2.25 9.574V18a2.25 2.25 0 002.25 2.25h15A2.25 2.25 0 0021.75 18V9.574c0-1.067-.75-1.994-1.802-2.169a47.865 47.865 0 00-1.134-.175 2.31 2.31 0 01-1.64-1.055l-.822-1.316a2.192 2.192 0 00-1.736-1.039 48.774 48.774 0 00-5.232 0 2.192 2.192 0 00-1.736 1.039l-.821 1.316z" />
                                <path stroke-linecap="round" stroke-linejoin="round" d="M16.5 12.75a4.5 4.5 0 11-9 0 4.5 4.5 0 019 0zM18.75 10.5h.008v.008h-.008V10.5z" />
                              </svg>
                            </div>
                            <div class="text-left">
                              <p class="text-sm font-black text-slate-900 uppercase tracking-wider">Open Scanner</p>
                              <p class="text-[11px] text-slate-500 font-medium">Use your camera to scan ID</p>
                            </div>
                          </button>

                          <button type="button" data-action="click->id-upload#_openGallery" class="w-full flex items-center gap-4 p-5 bg-slate-50 rounded-3xl hover:bg-slate-100 transition group">
                            <div class="w-12 h-12 bg-emerald-500 rounded-2xl flex items-center justify-center text-white shadow-lg group-active:scale-90 transition">
                              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-6 h-6">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 15.75l5.159-5.159a2.25 2.25 0 013.182 0l5.159 5.159m-1.5-1.5l1.409-1.409a2.25 2.25 0 013.182 0l2.909 2.909m-18 3.75h16.5a1.5 1.5 0 001.5-1.5V6a1.5 1.5 0 00-1.5-1.5H3.75A1.5 1.5 0 002.25 6v12a1.5 1.5 0 001.5 1.5zm10.5-11.25h.008v.008h-.008V8.25zm.375 0a.375.375 0 11-.75 0 .375.375 0 01.75 0z" />
                              </svg>
                            </div>
                            <div class="text-left">
                              <p class="text-sm font-black text-slate-900 uppercase tracking-wider">Choose from Gallery</p>
                              <p class="text-[11px] text-slate-500 font-medium">Upload an existing photo</p>
                            </div>
                          </button>

                          <button type="button" data-action="click->id-upload#closeChoiceMenu" class="w-full p-5 text-sm font-black uppercase tracking-[0.2em] text-slate-400 hover:text-slate-600 transition">
                            Cancel
                          </button>
                        </div>
                      </div>
                    </div>

                    <%= f.file_field :id_back, class: "hidden", accept: "image/*", required: true, data: { id_upload_target: "input", action: "change->id-upload#updatePreview" } %>
                  </div>
                </div>
              </div>
            </section>

            <section class="space-y-4 mt-8">
              <div>
                <h2 class="text-sm font-black uppercase tracking-widest text-neutral-text-primary">Contact Details</h2>
              </div>

              <div class="grid gap-4 md:grid-cols-2">
                <div>
                  <%= f.label :guest_email, "Email Address", class: "block text-xs font-bold uppercase tracking-widest text-neutral-text-secondary mb-2" %>
                  <%= f.email_field :guest_email, class: "form-input py-3 px-5 border border-neutral-border", required: true %>
                </div>

                <div>
                  <%= f.label :guest_phone, "Phone Number", class: "block text-xs font-bold uppercase tracking-widest text-neutral-text-secondary mb-2" %>
                  <%= f.telephone_field :guest_phone, class: "form-input py-3 px-5 border border-neutral-border", required: true %>
                </div>

                <div>
                  <%= f.label :guest_country, "Country", class: "block text-xs font-bold uppercase tracking-widest text-neutral-text-secondary mb-2" %>
                  <%= f.text_field :guest_country, class: "form-input py-3 px-5 border border-neutral-border", required: true, placeholder: "e.g. Malaysia" %>
                </div>

                <div data-controller="time-picker">
                  <%= f.label :estimated_arrival_time, "Estimated Arrival Time", class: "block text-xs font-bold uppercase tracking-widest text-neutral-text-secondary mb-2" %>
                  <div class="relative">
                    <button type="button" data-action="click->time-picker#toggle" class="form-input py-3 px-5 border border-neutral-border w-full flex items-center justify-between bg-white cursor-pointer transition sm:text-sm">
                      <span data-time-picker-target="display" class="text-neutral-text-secondary">Select Time</span>
                      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-4 h-4 text-neutral-text-secondary">
                        <path stroke-linecap="round" stroke-linejoin="round" d="m19.5 8.25-7.5 7.5-7.5-7.5" />
                      </svg>
                    </button>
                    
                    <div data-time-picker-target="popover" class="hidden absolute left-0 mt-2 w-72 bg-white rounded-2xl shadow-2xl border border-slate-200 z-[110] p-4">
                      <div class="grid grid-cols-3 gap-4">
                        <!-- Hours -->
                        <div class="space-y-1">
                          <p class="text-[10px] font-black uppercase tracking-widest text-slate-400 text-center mb-2">Hour</p>
                          <div class="h-48 overflow-y-auto custom-scrollbar space-y-1 pr-1">
                            <% (1..12).each do |h| %>
                              <button type="button" data-time-picker-target="hour" data-value="<%= h %>" data-action="click->time-picker#selectHour" class="w-full py-2 rounded-xl text-sm font-bold text-slate-600 hover:bg-blue-50 transition"><%= h %></button>
                            <% end %>
                          </div>
                        </div>
                        
                        <!-- Minutes -->
                        <div class="space-y-1">
                          <p class="text-[10px] font-black uppercase tracking-widest text-slate-400 text-center mb-2">Min</p>
                          <div class="h-48 overflow-y-auto custom-scrollbar space-y-1 pr-1">
                            <% (0..59).each do |m| %>
                              <% formatted_m = m.to_s.rjust(2, '0') %>
                              <button type="button" data-time-picker-target="minute" data-value="<%= formatted_m %>" data-action="click->time-picker#selectMinute" class="w-full py-2 rounded-xl text-sm font-bold text-slate-600 hover:bg-blue-50 transition"><%= formatted_m %></button>
                            <% end %>
                          </div>
                        </div>

                        <!-- AM/PM -->
                        <div class="space-y-1">
                          <p class="text-[10px] font-black uppercase tracking-widest text-slate-400 text-center mb-2">AM/PM</p>
                          <div class="space-y-1">
                            <button type="button" data-time-picker-target="period" data-value="AM" data-action="click->time-picker#selectPeriod" class="w-full py-2 rounded-xl text-sm font-bold text-slate-600 hover:bg-blue-50 transition">AM</button>
                            <button type="button" data-time-picker-target="period" data-value="PM" data-action="click->time-picker#selectPeriod" class="w-full py-2 rounded-xl text-sm font-bold text-slate-600 hover:bg-blue-50 transition">PM</button>
                          </div>
                        </div>
                      </div>

                      <div class="mt-4 pt-4 border-t border-slate-100">
                        <button type="button" data-action="click->time-picker#confirm" class="w-full py-3 bg-blue-600 text-white rounded-xl text-xs font-black uppercase tracking-widest hover:bg-blue-700 transition shadow-lg">
                          Set Time
                        </button>
                      </div>
                    </div>

                    <%= f.hidden_field :estimated_arrival_time, data: { time_picker_target: "input" }, required: true %>
                  </div>
                </div>
              </div>
            </section>

            <div class="rounded-xl border border-neutral-border bg-neutral-bg p-4 mt-8">
              <label class="flex items-start gap-3 text-sm text-neutral-text-secondary">
                <input type="checkbox" required autocomplete="off" class="mt-1 h-4 w-4 rounded border-neutral-border text-brand-primary focus:ring-brand-primary">
                <span>I confirm that the details above are accurate and match my identification document.</span>
              </label>
            </div>

            <div class="flex flex-col-reverse md:flex-row items-stretch md:items-center justify-end gap-3 mt-8">
              <%= button_tag "Cancel", type: "submit", formaction: cancel_pre_checkin_path(@pre_checkin.token), formmethod: :post, formnovalidate: true, class: "rounded-lg border border-neutral-border bg-gray-200 px-6 py-3 text-sm font-black uppercase tracking-widest text-neutral-text-secondary hover:bg-neutral-bg w-full md:w-auto" %>
              <%= f.submit "Complete Pre Check-In", class: "btn btn-primary px-6 py-3 text-sm font-black uppercase tracking-widest w-full md:w-auto" %>
            </div>          <% end %>
        <% end %>

        <!-- Scanner Modal -->
        <div data-scanner-target="modal" class="hidden fixed inset-0 z-[100] bg-black items-center justify-center flex-col overflow-hidden">
          <div class="relative w-full h-full flex items-center justify-center">
            <video data-scanner-target="video" class="w-full h-full object-cover" playsinline muted></video>
            <canvas data-scanner-target="canvas" class="hidden w-full h-full object-cover"></canvas>
            
            <!-- Viewfinder Overlay -->
            <div class="absolute inset-0 pointer-events-none flex items-start justify-center p-8 pt-16">
              <div class="w-full max-w-[280px] aspect-[1/1.6] border-2 border-white/30 rounded-3xl relative shadow-[0_0_0_100vw_rgba(0,0,0,0.7)]">
                <!-- Corners -->
                <div class="absolute -top-1 -left-1 w-10 h-10 border-t-4 border-l-4 border-emerald-400 rounded-tl-2xl"></div>
                <div class="absolute -top-1 -right-1 w-10 h-10 border-t-4 border-r-4 border-emerald-400 rounded-tr-2xl"></div>
                <div class="absolute -bottom-1 -left-1 w-10 h-10 border-b-4 border-l-4 border-emerald-400 rounded-bl-2xl"></div>
                <div class="absolute -bottom-1 -right-1 w-10 h-10 border-b-4 border-r-4 border-emerald-400 rounded-br-2xl"></div>
                
                <div class="absolute inset-x-0 -top-12 text-center">
                  <p class="text-white text-base font-black uppercase tracking-[0.2em] drop-shadow-lg">Scan ID Card</p>
                </div>
              </div>
            </div>

            <!-- Controls -->
            <div class="absolute bottom-12 inset-x-0 flex items-center justify-center gap-10">
              <button type="button" data-action="click->scanner#close" class="w-14 h-14 rounded-full bg-white/10 backdrop-blur-xl flex items-center justify-center text-white border border-white/20 hover:bg-white/20 transition">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" class="w-6 h-6">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
                </svg>
              </button>

              <button type="button" data-scanner-target="captureButton" data-action="click->scanner#capture" class="w-20 h-20 rounded-full border-4 border-white p-1.5 hover:scale-105 transition active:scale-95">
                <div class="w-full h-full rounded-full bg-white shadow-inner"></div>
              </button>

              <div class="flex gap-4">
                <button type="button" data-scanner-target="retakeButton" data-action="click->scanner#retake" class="hidden px-6 py-4 rounded-2xl bg-white/10 backdrop-blur-xl text-white text-xs font-black uppercase tracking-widest border border-white/20 hover:bg-white/20 transition">
                  Retake
                </button>
                <button type="button" data-scanner-target="useButton" data-action="click->scanner#use" class="hidden px-8 py-4 rounded-2xl bg-emerald-500 text-white text-xs font-black uppercase tracking-widest shadow-2xl hover:bg-emerald-400 transition">
                  Confirm Scan
                </button>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
