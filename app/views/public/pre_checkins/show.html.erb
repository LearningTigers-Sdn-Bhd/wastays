<div class="bg-muted min-h-screen pb-16">
  <div class="max-w-5xl mx-auto px-4 py-10">
    <div class="mb-8">
      <p class="text-xs font-black uppercase tracking-widest text-primary">Pre Check-In</p>
      <h1 class="mt-2 text-3xl font-black text-foreground">Complete your arrival details</h1>
      <p class="mt-2 text-sm text-muted-foreground">
        Review your booking details and fill in the missing information before you arrive at <%= @presenter.hotel_name %>.
      </p>
    </div>

    <div class="space-y-6">
      <div class="card p-6 md:p-8">
        <div class="mb-6">
          <h2 class="text-sm font-black uppercase tracking-widest text-foreground">Booking Details</h2>
          <p class="mt-1 text-xs text-muted-foreground">
            Review these details before completing your arrival information.
          </p>
        </div>

        <div class="grid gap-4 md:grid-cols-2">
          <div>
            <label class="block text-xs font-bold uppercase tracking-widest text-muted-foreground mb-2">Reference</label>
            <div class="rounded-lg border border-border bg-muted px-4 py-3 min-h-[72px] flex items-center">
              <p class="font-mono font-semibold text-foreground break-all"><%= @presenter.confirmation_token %></p>
            </div>
          </div>

          <div>
            <label class="block text-xs font-bold uppercase tracking-widest text-muted-foreground mb-2">Hotel</label>
            <div class="rounded-lg border border-border bg-muted px-4 py-3 min-h-[72px] flex items-center">
              <div>
                <p class="font-semibold text-foreground"><%= @presenter.hotel_name %></p>
                <p class="text-xs text-muted-foreground"><%= @presenter.hotel_location %></p>
              </div>
            </div>
          </div>

          <div>
            <label class="block text-xs font-bold uppercase tracking-widest text-muted-foreground mb-2">Stay</label>
            <div class="rounded-lg border border-border bg-muted px-4 py-3 min-h-[72px] flex items-center">
              <p class="font-semibold text-foreground"><%= @presenter.stay_dates %></p>
            </div>
          </div>

          <div>
            <label class="block text-xs font-bold uppercase tracking-widest text-muted-foreground mb-2">Rooms</label>
            <div class="rounded-lg border border-border bg-muted px-4 py-3 min-h-[72px] flex items-center">
              <p class="font-semibold text-foreground"><%= @presenter.rooms_count_label %></p>
            </div>
          </div>
        </div>
      </div>

      <div class="card p-6 md:p-8" data-controller="scanner guest-dob">
        <% if @presenter.completed? %>
          <div class="rounded-2xl border border-green-200 bg-green-50 p-6">
            <h2 class="text-xl font-black text-foreground">Pre check-in completed</h2>
            <p class="mt-2 text-sm text-muted-foreground">
              Your arrival details have been saved successfully.
            </p>
          </div>
        <% else %>
          <%= form_with model: @booking, url: pre_checkin_path(@pre_checkin.token), method: :patch, local: true, autocomplete: "off", class: "space-y-8" do |f| %>
            <% if @presenter.any_errors? %>
              <div class="rounded-2xl border border-red-200 bg-red-50 p-4 text-sm text-red-700">
                <p class="font-black uppercase tracking-widest text-xs">Please fix the following</p>
                <ul class="mt-2 list-disc space-y-1 ps-5">
                  <% @presenter.errors.each do |message| %>
                    <li><%= message %></li>
                  <% end %>
                </ul>
              </div>
            <% end %>

            <section class="space-y-4" data-controller="pre-checkin-document">
              <div>
                <h2 class="text-sm font-black uppercase tracking-widest text-foreground">Guest Identification</h2>
                <p class="mt-1 text-xs text-muted-foreground">Use the same details as shown on your identification document.</p>
              </div>

              <div class="grid gap-4 md:grid-cols-2">
                <div>
                  <%= f.label :guest_name, "Full Name", class: "block text-xs font-bold uppercase tracking-widest text-muted-foreground mb-2" %>
                  <%= f.text_field :guest_name, class: "form-input py-3 px-5 border border-border", required: true %>
                </div>

                <div>
                  <%= f.label :guest_document_type, "Document Type", class: "block text-xs font-bold uppercase tracking-widest text-muted-foreground mb-2" %>
                  <%= f.select :guest_document_type, @presenter.document_type_options, {}, class: "form-input py-3 px-5 border border-border", required: true, data: { guest_dob_target: "documentType", pre_checkin_document_target: "select", action: "change->guest-dob#autofill change->pre-checkin-document#toggleUploads" } %>
                </div>

                <div>
                  <%= f.label :guest_government_id, "ID / Passport Number", class: "block text-xs font-bold uppercase tracking-widest text-muted-foreground mb-2" %>
                  <%= f.text_field :guest_government_id, class: "form-input py-3 px-5 border border-border", required: true, placeholder: "e.g. 900101011234", data: { guest_dob_target: "governmentId", action: "input->guest-dob#autofill" } %>
                </div>

                <div>
                  <%= f.label :guest_date_of_birth, "Date of Birth", class: "block text-xs font-bold uppercase tracking-widest text-muted-foreground mb-2" %>
                  <%= f.date_field :guest_date_of_birth, class: "form-input py-3 px-5 border border-border", data: { guest_dob_target: "dateOfBirth" } %>
                </div>
              </div>

              <div class="grid gap-6 md:grid-cols-2 mt-4 transition-all duration-300 transform <%= @presenter.upload_section_class %>" data-pre-checkin-document-target="uploadSection">
                <div data-pre-checkin-document-target="frontContainer" class="transition-all duration-300 transform <%= @presenter.front_container_class %>">
                  <%= render "shared/id_scanner", f: f, field: :id_front, side: :front, label: @presenter.front_scanner_label, height_class: @presenter.front_scanner_height_class %>
                </div>
                <div data-pre-checkin-document-target="backContainer" class="transition-all duration-300 transform <%= @presenter.back_container_class %>">
                  <%= render "shared/id_scanner", f: f, field: :id_back, side: :back, label: "Back ID Card" %>
                </div>
              </div>
            </section>

            <section class="space-y-4 mt-8">
              <div>
                <h2 class="text-sm font-black uppercase tracking-widest text-foreground">Contact Details</h2>
              </div>

              <div class="grid gap-4 md:grid-cols-2">
                <div>
                  <%= f.label :guest_email, "Email Address", class: "block text-xs font-bold uppercase tracking-widest text-muted-foreground mb-2" %>
                  <%= f.email_field :guest_email, class: "form-input py-3 px-5 border border-border", required: true %>
                </div>

                <div>
                  <%= f.label :guest_phone, "Phone Number", class: "block text-xs font-bold uppercase tracking-widest text-muted-foreground mb-2" %>
                  <%= f.telephone_field :guest_phone, class: "form-input py-3 px-5 border border-border", required: true %>
                </div>

                <div>
                  <%= f.label :guest_country, "Nationality", class: "block text-xs font-bold uppercase tracking-widest text-muted-foreground mb-2" %>
                  <%= f.select :guest_country,
                        country_options,
                        { selected: @presenter.guest_country_default, prompt: "Select nationality" },
                        class: "form-input py-3 px-5 border border-border", required: true, data: { guest_dob_target: "country", action: "change->guest-dob#autofill" } %>
                </div>

                <div data-controller="time-picker">
                  <%= f.label :estimated_arrival_time, "Estimated Arrival Time", class: "block text-xs font-bold uppercase tracking-widest text-muted-foreground mb-2" %>
                  <div class="relative">
                    <button type="button" data-action="click->time-picker#toggle" class="form-input py-3 px-5 border border-border w-full flex items-center justify-between bg-white cursor-pointer transition sm:text-sm">
                      <span data-time-picker-target="display" class="text-muted-foreground">Select Time</span>
                      <%= cached_icon "chevron-down", stroke_width: 2.5, class: "w-4 h-4 text-black" %>
                    </button>
                    
                    <%= render "time_picker", presenter: @presenter %>

                    <%= f.hidden_field :estimated_arrival_time, data: { time_picker_target: "input" }, required: true %>
                  </div>
                </div>
              </div>

              <div>
                <%= f.label :guest_home_address, "Home Address", class: "block text-xs font-bold uppercase tracking-widest text-muted-foreground mb-2" %>
                <%= f.text_area :guest_home_address, class: "form-input py-3 px-5 border border-border", required: true, rows: 3, placeholder: "e.g. No. 12, Jalan Ampang, 50450 Kuala Lumpur, Malaysia" %>
              </div>
            </section>

            <section class="space-y-4 mt-8">
              <div>
                <h2 class="text-sm font-black uppercase tracking-widest text-foreground">Guest Signature</h2>
                <p class="mt-1 text-xs text-muted-foreground">Please provide your signature below to confirm your check-in details.</p>
              </div>

              <div data-controller="signature" class="relative space-y-2">
                <div class="rounded-xl border border-border bg-white p-2">
                  <canvas data-signature-target="canvas" class="w-full h-40 touch-none"></canvas>
                </div>
                <div class="flex justify-end">
                  <button type="button" data-action="click->signature#clear" class="text-xs font-bold uppercase tracking-widest text-primary hover:underline">
                    Clear Signature
                  </button>
                </div>
                <%= f.text_field :signature, 
                                  data: { signature_target: "input" }, 
                                  required: true, 
                                  oninvalid: "this.setCustomValidity('Please provide your signature')",
                                  oninput: "this.setCustomValidity('')",
                                  class: "absolute bottom-0 left-1/2 -z-10 h-px w-px opacity-0 pointer-events-none", 
                                  tabindex: "-1", 
                                  aria: { hidden: true } %>
              </div>
            </section>

            <div class="rounded-xl border border-border bg-muted p-4 mt-8">
              <label class="flex items-start gap-3 text-sm text-muted-foreground">
                <input type="checkbox" required autocomplete="off" class="mt-1 h-4 w-4 rounded border-border text-primary focus:ring-primary">
                <span>I confirm that the details above are accurate and match my identification document.</span>
              </label>
            </div>

            <div class="flex flex-col-reverse md:flex-row items-stretch md:items-center justify-end gap-3 mt-8">
              <%= button_tag "Cancel", type: "submit", formaction: cancel_pre_checkin_path(@pre_checkin.token), formmethod: :post, formnovalidate: true, class: "rounded-lg border border-border bg-gray-200 px-6 py-3 text-sm font-black uppercase tracking-widest text-muted-foreground hover:bg-muted w-full md:w-auto" %>
              <%= f.submit "Complete Pre Check-In", class: "btn btn-primary px-6 py-3 text-sm font-black uppercase tracking-widest w-full md:w-auto" %>
            </div>
          <% end %>
        <% end %>

        <%= render "shared/scanner_modal" %>
      </div>
    </div>
  </div>
</div>
