<div class="bg-neutral-bg min-h-screen flex items-center justify-center py-12 px-4 sm:px-6 lg:px-8">
  <div class="max-w-md w-full">
    <div class="text-center mb-10">
      <a class="text-3xl font-black tracking-tighter text-brand-primary" href="<%= root_path %>">WAStays</a>
      <h2 class="mt-6 text-3xl font-black text-neutral-text-primary tracking-tight">Sign in to your account</h2>
      <p class="mt-2 text-sm text-neutral-text-secondary">
        Don't have an account? 
        <%= link_to "Register your hotel", register_path, class: "font-bold text-brand-primary hover:underline" %>
      </p>
    </div>

    <div class="card p-8 md:p-10 shadow-2xl">
      <%= form_with url: login_path, local: true, class: "space-y-6" do |f| %>
        <div>
          <label for="email" class="block text-xs font-bold uppercase tracking-widest text-neutral-text-secondary mb-2">Email address</label>
          <div class="relative">
            <div class="absolute inset-y-0 start-0 flex items-center ps-3 pointer-events-none">
              <svg class="w-4 h-4 text-neutral-text-secondary" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
            </div>
            <%= f.email_field :email, id: "email", class: "form-input py-3 ps-10", required: true, placeholder: "you@example.com" %>
          </div>
        </div>

        <div>
          <div class="flex justify-between items-center mb-2">
            <label for="password" class="block text-xs font-bold uppercase tracking-widest text-neutral-text-secondary">Password</label>
            <a class="text-xs font-bold text-brand-primary hover:underline" href="mailto:support@wastays.com?subject=Password Reset Request">Forgot password?</a>
          </div>
          <div class="relative">
            <div class="absolute inset-y-0 start-0 flex items-center ps-3 pointer-events-none">
              <svg class="w-4 h-4 text-neutral-text-secondary" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="11" x="3" y="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
            </div>
            <%= f.password_field :password, id: "password", class: "form-input py-3 ps-10", required: true, placeholder: "••••••••" %>
          </div>
        </div>

        <div class="flex items-center justify-between">
          <div class="flex items-center">
            <%= f.check_box :remember_me, class: "h-4 w-4 rounded text-brand-primary focus:ring-brand-primary border-neutral-border" %>
            <label for="remember_me" class="ms-2 block text-xs font-bold text-neutral-text-secondary uppercase tracking-widest">Remember me</label>
          </div>
        </div>

        <div>
          <%= f.submit "Sign In", class: "btn btn-gradient w-full py-4 text-base font-black shadow-xl shadow-brand-primary/30" %>
        </div>
      <% end %>
    </div>

    <div class="mt-10 text-center">
      <p class="text-xs text-neutral-text-secondary uppercase tracking-widest font-bold">
        Security by WAStays Sentinel
      </p>
    </div>
  </div>
</div>
