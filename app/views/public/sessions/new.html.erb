<div class="bg-[#fdfbf7] min-h-screen flex flex-col md:flex-row">

  <!-- Left Panel: Dark Forest Branding -->
  <div class="hidden md:flex md:w-[45%] lg:w-2/5 bg-[#1e2e2a] flex-col justify-between relative overflow-hidden p-12 lg:p-16">

    <!-- Deep radial glow -->
    <div class="absolute inset-0 flex items-center justify-center pointer-events-none">
      <div class="w-[600px] h-[600px] bg-brand-primary/15 rounded-full blur-[120px]"></div>
    </div>



    <!-- Top: Logo -->
    <div class="relative z-10">
      <a href="<%= root_path %>" class="inline-block">
        <%= image_tag "logo/long-logo.png", alt: "WAStays", class: "h-14 w-auto" %>
      </a>
    </div>

    <!-- Middle: Headline + Features -->
    <div class="relative z-10 flex-1 flex flex-col justify-center py-16">

      <!-- Eyebrow -->
      <div class="inline-flex items-center gap-x-3 mb-8">
        <span class="w-8 h-px bg-[#d9c5a0]/30"></span>
        <span class="text-[10px] font-bold uppercase tracking-[0.3em] text-[#d9c5a0]">Hotel Partner Portal</span>
        <span class="w-8 h-px bg-[#d9c5a0]/30"></span>
      </div>

      <h1 class="text-4xl lg:text-5xl font-serif text-white leading-[1.1] mb-6">
        Welcome Back<br>
        <span class="italic text-[#d9c5a0]">to Your Dashboard</span>
      </h1>

      <p class="text-gray-400 text-base leading-relaxed mb-12 max-w-xs">
        Manage bookings, track revenue, and deliver exceptional guest experiences — all in one place.
      </p>

      <ul class="space-y-8">
        <li class="flex items-start gap-x-5">
          <div class="flex-none w-9 h-9 rounded-xl bg-[#d9c5a0]/10 border border-[#d9c5a0]/20 flex items-center justify-center">
            <svg class="w-4 h-4 text-[#d9c5a0]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"/></svg>
          </div>
          <div>
            <h3 class="text-sm font-bold text-white mb-0.5">Live Booking Dashboard</h3>
            <p class="text-xs text-gray-500 leading-relaxed">Monitor arrivals, occupancy, and revenue in real time.</p>
          </div>
        </li>
        <li class="flex items-start gap-x-5">
          <div class="flex-none w-9 h-9 rounded-xl bg-[#d9c5a0]/10 border border-[#d9c5a0]/20 flex items-center justify-center">
            <svg class="w-4 h-4 text-[#d9c5a0]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 10h.01M12 10h.01M16 10h.01M9 16H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-5l-5 5v-5z"/></svg>
          </div>
          <div>
            <h3 class="text-sm font-bold text-white mb-0.5">WhatsApp Guest Comms</h3>
            <p class="text-xs text-gray-500 leading-relaxed">Stay connected with guests before, during, and after their stay.</p>
          </div>
        </li>
        <li class="flex items-start gap-x-5">
          <div class="flex-none w-9 h-9 rounded-xl bg-[#d9c5a0]/10 border border-[#d9c5a0]/20 flex items-center justify-center">
            <svg class="w-4 h-4 text-[#d9c5a0]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6"/></svg>
          </div>
          <div>
            <h3 class="text-sm font-bold text-white mb-0.5">Revenue Intelligence</h3>
            <p class="text-xs text-gray-500 leading-relaxed">Smart upsells and performance insights to grow your earnings.</p>
          </div>
        </li>
      </ul>
    </div>

    <!-- Bottom: Trust line -->
    <div class="relative z-10 flex items-center gap-x-3">
      <span class="w-6 h-px bg-[#d9c5a0]/20"></span>
      <p class="text-xs text-gray-600">Trusted by 200+ hotels across Southeast Asia</p>
    </div>
  </div>

  <!-- Right Panel: Sign In Form -->
  <div class="flex-1 bg-[#fdfbf7] overflow-y-auto flex items-center justify-center px-6 py-10 sm:px-10 lg:px-8">
    <div class="w-full max-w-xl">

      <!-- Header -->
      <div class="mb-10 text-center">
        <!-- Mobile logo: centered above eyebrow -->
        <div class="md:hidden mb-8">
          <a href="<%= root_path %>" class="inline-block">
            <%= image_tag "logo/long-logo.png", alt: "WAStays", class: "h-10 w-auto mx-auto" %>
          </a>
        </div>

        <div class="flex items-center justify-center gap-x-3 mb-6">
          <span class="w-6 h-px bg-brand-primary/30"></span>
          <span class="text-[10px] font-bold uppercase tracking-[0.3em] text-brand-primary">Sign In</span>
          <span class="w-6 h-px bg-brand-primary/30"></span>
        </div>
        <h2 class="text-4xl font-serif text-neutral-text-primary leading-tight mb-3">
          Access Your <span class="italic text-brand-primary">Hotel Portal</span>
        </h2>
        <p class="text-neutral-text-secondary text-sm leading-relaxed">
          Don't have an account?
          <%= link_to "Register your hotel", register_path, class: "text-brand-primary font-semibold hover:underline underline-offset-2" %>
        </p>
      </div>

      <%= form_with url: login_path, local: true, class: "space-y-5" do |f| %>

        <!-- Email -->
        <div>
          <label for="email" class="block text-xs font-bold uppercase tracking-widest text-neutral-text-secondary mb-2">Email Address</label>
          <%= f.email_field :email,
              id: "email",
              class: "w-full bg-white border border-neutral-border rounded-xl px-4 py-3 text-sm text-neutral-text-primary placeholder:text-neutral-text-secondary/50 focus:outline-none focus:ring-2 focus:ring-brand-primary/20 focus:border-brand-primary transition-colors duration-200",
              required: true,
              placeholder: "you@example.com" %>
        </div>

        <!-- Password -->
        <div>
          <div class="flex items-center justify-between mb-2">
            <label for="password" class="block text-xs font-bold uppercase tracking-widest text-neutral-text-secondary">Password</label>
          </div>
          <div class="relative" data-controller="password-toggle">
            <%= f.password_field :password,
                id: "password",
                class: "w-full bg-white border border-neutral-border rounded-xl px-4 pe-12 py-3 text-sm text-neutral-text-primary placeholder:text-neutral-text-secondary/50 focus:outline-none focus:ring-2 focus:ring-brand-primary/20 focus:border-brand-primary transition-colors duration-200",
                required: true,
                placeholder: "••••••••",
                autocomplete: "current-password",
                data: { password_toggle_target: "input" } %>
            <button
              type="button"
              class="absolute inset-y-0 end-0 flex items-center pe-4 text-neutral-text-secondary/50 hover:text-brand-primary transition-colors"
              data-password-toggle-target="button"
              data-action="click->password-toggle#toggle"
              aria-label="Show password"
              aria-pressed="false"
            >
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path d="M2.062 12.348a1 1 0 0 1 0-.696 10.75 10.75 0 0 1 19.876 0 1 1 0 0 1 0 .696 10.75 10.75 0 0 1-19.876 0Z"/>
                <circle cx="12" cy="12" r="3"/>
                <path data-password-toggle-target="slash" class="hidden" d="M4 4l16 16"/>
              </svg>
            </button>
          </div>
        </div>

        <!-- Remember me -->
        <div class="flex items-center justify-between gap-4 pt-1">
          <div class="flex items-center gap-x-2.5 min-w-0">
            <%= f.check_box :remember_me,
                class: "h-4 w-4 rounded border-neutral-border text-brand-primary focus:ring-brand-primary/30 focus:ring-2 cursor-pointer" %>
            <label for="sessions_remember_me" class="text-xs font-medium text-neutral-text-secondary cursor-pointer select-none">
              Keep me signed in for 30 days
            </label>
          </div>
          <a href="mailto:support@wastays.com?subject=Password Reset Request" class="shrink-0 text-[11px] text-brand-primary font-semibold hover:underline underline-offset-2">Forgot password?</a>
        </div>

        <!-- Submit -->
        <div class="pt-3">
          <%= f.submit "Sign In to Portal",
              class: "w-full inline-flex items-center justify-center btn btn-primary py-4 rounded-xl text-base font-bold shadow-lg shadow-brand-primary/20 cursor-pointer hover:shadow-xl hover:shadow-brand-primary/30 transition-all duration-200" %>
        </div>

      <% end %>



    </div>
  </div>
</div>
