<div class="flex min-h-screen items-center justify-center bg-[#fdfbf7] px-6 py-10">
  <div class="w-full max-w-xl">
    <div class="mb-8 text-center">
      <%= image_tag "logo/long-logo.png", alt: "WAStays", class: "mx-auto h-12 w-auto" %>
      <p class="mt-8 text-xs font-bold uppercase tracking-[0.3em] text-brand-primary">Corporate invitation</p>
      <h1 class="mt-4 text-4xl font-serif text-neutral-text-primary">Connect your corporate account</h1>
      <p class="mt-3 text-sm text-neutral-text-secondary"><%= @invitation.hotel.name %> invited you to its corporate billing network.</p>
    </div>

    <div class="rounded-3xl border border-neutral-border bg-white p-8 shadow-sm">
      <% if @existing_user %>
        <p class="mb-6 text-sm leading-6 text-neutral-text-secondary">
          Accepting will connect <strong><%= @existing_user.account.name %></strong> to <strong><%= @invitation.hotel.name %></strong>. Your existing password will not change.
        </p>
        <%= form_with url: corporate_invitation_path(@token), method: :patch do |f| %>
          <%= f.submit "Accept invitation", class: "w-full rounded-xl bg-brand-primary px-5 py-3 text-sm font-bold text-white" %>
        <% end %>
      <% else %>
        <%= form_with model: @user, url: corporate_invitation_path(@token), method: :patch, class: "space-y-5" do |f| %>
          <% if @user.errors.any? %>
            <div class="rounded-xl border border-red-200 bg-red-50 p-4 text-sm text-red-700"><%= @user.errors.full_messages.to_sentence %></div>
          <% end %>
          <div>
            <%= label_tag "user_account_name", "Corporate account name", class: "mb-2 block text-xs font-bold uppercase tracking-wider" %>
            <%= text_field_tag "user[account_name]", params.dig(:user, :account_name), id: "user_account_name", required: true, class: "w-full rounded-xl border border-neutral-border px-4 py-3 text-sm" %>
          </div>
          <div>
            <%= f.label :name, "Full name", class: "mb-2 block text-xs font-bold uppercase tracking-wider" %>
            <%= f.text_field :name, required: true, class: "w-full rounded-xl border border-neutral-border px-4 py-3 text-sm" %>
          </div>
          <div>
            <%= f.label :password, class: "mb-2 block text-xs font-bold uppercase tracking-wider" %>
            <%= f.password_field :password, required: true, class: "w-full rounded-xl border border-neutral-border px-4 py-3 text-sm" %>
          </div>
          <div>
            <%= f.label :password_confirmation, "Confirm password", class: "mb-2 block text-xs font-bold uppercase tracking-wider" %>
            <%= f.password_field :password_confirmation, required: true, class: "w-full rounded-xl border border-neutral-border px-4 py-3 text-sm" %>
          </div>
          <%= f.submit "Create account and accept", class: "w-full rounded-xl bg-brand-primary px-5 py-3 text-sm font-bold text-white" %>
        <% end %>
      <% end %>
    </div>
  </div>
</div>
