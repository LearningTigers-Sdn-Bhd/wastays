
<div class="bg-landing-bg min-h-screen pb-20 sm:pb-24 font-sans text-neutral-text-primary">
  <!-- Status Banner (Dark & Elegant) -->
  <div class="relative bg-[#0a2e29] py-14 sm:py-16 lg:py-28 text-center text-white overflow-hidden print:hidden">
    <!-- Sophisticated Background Elements -->
    <div class="absolute inset-0">
      <div class="absolute inset-0 bg-gradient-to-b from-black/40 via-transparent to-[#0a2e29]"></div>
      <div class="absolute inset-0 opacity-10" style="background-image: radial-gradient(#d9c5a0 0.5px, transparent 0.5px); background-size: 24px 24px;"></div>
    </div>

    <!-- Deep radial glow -->
    <div class="absolute inset-0 flex items-center justify-center pointer-events-none">
      <div class="w-[600px] h-[400px] bg-brand-primary/20 rounded-full blur-[120px]"></div>
    </div>

    <div class="relative max-w-[85rem] mx-auto px-4">
      <!-- Eyebrow -->
      <div class="inline-flex items-center gap-x-3 mb-6 animate-hero-badge">
        <span class="w-8 h-px bg-[#d9c5a0]/30"></span>
        <span class="text-[10px] font-bold uppercase tracking-[0.3em] text-[#d9c5a0]">Booking Secured</span>
        <span class="w-8 h-px bg-[#d9c5a0]/30"></span>
      </div>

      <h1 class="text-3xl sm:text-5xl lg:text-6xl font-bold text-white leading-tight mb-4 drop-shadow-2xl">
        Booking <span class="text-[#d9c5a0]">Confirmed!</span>
      </h1>
      <p class="text-white/70 text-sm sm:text-base lg:text-lg max-w-xl mx-auto font-medium mb-8 sm:mb-10">
        Pack your bags, <%= @booking.guest_name.split.first %>, you're all set for your stay.
      </p>

      <div class="inline-flex flex-col items-center">
        <div class="bg-white/5 backdrop-blur-xl border border-[#d9c5a0]/20 p-1 rounded-2xl shadow-2xl">
          <div class="px-6 sm:px-8 py-3.5 sm:py-4 rounded-xl border border-[#d9c5a0]/10 flex flex-col items-center">
            <span class="text-[9px] font-bold uppercase tracking-[0.2em] text-[#d9c5a0] mb-2">Confirmation Code</span>
            <div class="text-2xl sm:text-3xl font-bold text-white tracking-wider">
              <%= @booking.confirmation_token %>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="max-w-4xl mx-auto px-4 -mt-8 sm:-mt-12 relative z-10">
    <!-- Next Steps Card -->
    <div class="bg-white rounded-[1.5rem] sm:rounded-[2rem] p-5 sm:p-7 md:p-10 shadow-[0_20px_50px_rgba(0,0,0,0.1)] mb-8 sm:mb-10 border border-neutral-border/50 print:hidden">
      <div class="flex items-center gap-x-3 sm:gap-x-4 mb-6 sm:mb-8">
        <div class="h-px flex-1 bg-neutral-border/50"></div>
        <h2 class="text-sm font-bold text-brand-primary uppercase tracking-[0.2em]">What's Next?</h2>
        <div class="h-px flex-1 bg-neutral-border/50"></div>
      </div>

      <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-6 sm:gap-8 md:gap-10">
        <div class="group">
          <div class="w-12 h-12 rounded-2xl bg-[#d9c5a0]/10 text-[#d9c5a0] flex items-center justify-center mb-5 group-hover:scale-110 transition-transform duration-300">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 17h2a2 2 0 002-2v-4a2 2 0 00-2-2H5a2 2 0 00-2 2v4a2 2 0 002 2h2m2 4h6a2 2 0 002-2v-4a2 2 0 00-2-2H9a2 2 0 00-2 2v4a2 2 0 002 2zm8-12V5a2 2 0 00-2-2H9a2 2 0 00-2 2v4h10z"/></svg>
          </div>
          <h3 class="font-bold text-sm text-neutral-text-primary uppercase tracking-widest mb-3">Save Voucher</h3>
          <p class="text-xs text-neutral-text-secondary leading-relaxed mb-4 font-medium">Download your booking voucher as a PDF. You'll need to show it upon arrival.</p>
          <%= link_to voucher_booking_path(@booking.confirmation_token), data: { turbo: false }, class: "text-[10px] font-bold text-brand-primary hover:text-[#d9c5a0] transition-colors uppercase tracking-widest flex items-center gap-x-2" do %>
            Download Voucher
            <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M17 8l4 4m0 0l-4 4m4-4H3" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
          <% end %>
        </div>

        <div class="group">
          <div class="w-12 h-12 rounded-2xl bg-[#d9c5a0]/10 text-[#d9c5a0] flex items-center justify-center mb-5 group-hover:scale-110 transition-transform duration-300">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
          </div>
          <h3 class="font-bold text-sm text-neutral-text-primary uppercase tracking-widest mb-3">Pre-check-in</h3>
          <p class="text-xs text-neutral-text-secondary leading-relaxed mb-4 font-medium">Save time at the desk. Complete your guest details online before you arrive.</p>
          <% if @booking.pre_checkin.present? %>
            <%= link_to pre_checkin_path(@booking.pre_checkin.token), class: "inline-flex items-center gap-x-2 text-[10px] font-bold text-brand-primary hover:text-[#d9c5a0] transition-colors uppercase tracking-widest" do %>
              Start Now
              <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M17 8l4 4m0 0l-4 4m4-4H3" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
            <% end %>
          <% else %>
            <span class="text-[10px] font-bold text-neutral-text-secondary uppercase tracking-widest">Not Available</span>
          <% end %>
        </div>

        <div class="group">
          <div class="w-12 h-12 rounded-2xl bg-[#25D366]/10 text-[#25D366] flex items-center justify-center mb-5 group-hover:scale-110 transition-transform duration-300">
            <svg class="w-6 h-6" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/></svg>
          </div>
          <h3 class="font-bold text-sm text-neutral-text-primary uppercase tracking-widest mb-3">Get Assistance</h3>
          <p class="text-xs text-neutral-text-secondary leading-relaxed mb-4 font-medium">Need help with directions or special requests? Our WhatsApp team is ready.</p>
          <a href="#" class="text-[10px] font-bold text-status-success hover:underline transition-colors uppercase tracking-widest flex items-center gap-x-2">
            Chat with us
            <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M17 8l4 4m0 0l-4 4m4-4H3" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </a>
        </div>

        <div class="group">
          <div class="w-12 h-12 rounded-2xl bg-brand-primary/10 text-brand-primary flex items-center justify-center mb-5 group-hover:scale-110 transition-transform duration-300">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/></svg>
          </div>
          <h3 class="font-bold text-sm text-neutral-text-primary uppercase tracking-widest mb-3">Manage Booking</h3>
          <p class="text-xs text-neutral-text-secondary leading-relaxed mb-4 font-medium">View and manage all your bookings in one place. Log in anytime with your WhatsApp or email.</p>
          <%= link_to guest_login_path, class: "text-[10px] font-bold text-brand-primary hover:text-[#d9c5a0] transition-colors uppercase tracking-widest flex items-center gap-x-2" do %>
            Log In to View
            <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M17 8l4 4m0 0l-4 4m4-4H3" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
          <% end %>
        </div>
      </div>
    </div>

    <!-- Booking Voucher Card -->
    <div class="bg-white rounded-[1.5rem] sm:rounded-[2rem] overflow-hidden shadow-[0_20px_50px_rgba(0,0,0,0.08)] border border-neutral-border/50">
      <div class="p-5 sm:p-8 md:p-12 border-b-4 border-dashed border-landing-bg relative">
        <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-6 sm:gap-8 mb-8 sm:mb-12">
          <div>
            <div class="inline-flex items-center gap-x-2 mb-3">
              <span class="w-5 h-px bg-brand-primary/30"></span>
              <span class="text-[10px] font-bold uppercase tracking-[0.2em] text-brand-primary">Stay Details</span>
            </div>
            <h2 class="text-2xl sm:text-4xl font-bold text-neutral-text-primary leading-tight"><%= @hotel.name %></h2>
            <p class="text-neutral-text-secondary font-bold"><%= @hotel.city %>, <%= @hotel.country %></p>
          </div>
          <div class="md:hidden">
            <div class="mx-auto w-36 h-36 bg-white rounded-2xl overflow-hidden border-2 border-neutral-border shadow-sm p-3">
              <%= image_tag @qr_data_url, alt: "Booking QR code", class: "w-full h-full block" %>
            </div>
            <p class="mt-2 text-center text-[10px] font-bold uppercase tracking-[0.16em] text-neutral-text-secondary">Scan at check-in</p>
          </div>
          <div class="hidden md:block">
            <div class="w-40 h-40 bg-white rounded-2xl overflow-hidden border-2 border-neutral-border shadow-sm p-3">
              <%= image_tag @qr_data_url, alt: "Booking QR code", class: "w-full h-full block" %>
            </div>
            <p class="mt-2 text-center text-[10px] font-bold uppercase tracking-[0.16em] text-neutral-text-secondary">Scan at check-in</p>
          </div>
        </div>

        <div class="grid grid-cols-2 md:grid-cols-4 gap-5 sm:gap-8">
          <div>
            <p class="text-[10px] font-bold uppercase tracking-[0.2em] text-neutral-text-secondary mb-1">Check-in</p>
            <p class="text-xl font-bold text-neutral-text-primary tracking-tight"><%= @booking.check_in.strftime("%b %d, %Y") %></p>
            <p class="text-[10px] text-neutral-text-secondary font-bold">From <%= @booking.hotel_snapshot['property_policy']&.fetch('check_in_time', '2:00 PM') %></p>
          </div>
          <div>
            <p class="text-[10px] font-bold uppercase tracking-[0.2em] text-neutral-text-secondary mb-1">Check-out</p>
            <p class="text-xl font-bold text-neutral-text-primary tracking-tight"><%= @booking.check_out.strftime("%b %d, %Y") %></p>
            <p class="text-[10px] text-neutral-text-secondary font-bold">Until <%= @booking.hotel_snapshot['property_policy']&.fetch('check_out_time', '12:00 PM') %></p>
          </div>
          <div>
            <p class="text-[10px] font-bold uppercase tracking-[0.2em] text-neutral-text-secondary mb-1">Duration</p>
            <p class="text-xl font-bold text-neutral-text-primary tracking-tight"><%= pluralize((@booking.check_out - @booking.check_in).to_i, 'Night') %></p>
          </div>
          <div>
            <p class="text-[10px] font-bold uppercase tracking-[0.2em] text-neutral-text-secondary mb-1">Guests</p>
            <p class="text-xl font-bold text-neutral-text-primary tracking-tight"><%= @booking.adults %> Adults</p>
            <% if @booking.children > 0 %>
              <p class="text-[10px] text-neutral-text-secondary font-bold"><%= @booking.children %> Children</p>
            <% end %>
          </div>
        </div>
      </div>

      <div class="p-5 sm:p-8 md:p-12 bg-landing-bg/50">
        <div class="space-y-8 sm:space-y-12">
          <!-- Room Items -->
          <div>
            <div class="flex items-center gap-x-3 mb-6">
              <span class="text-[11px] font-bold uppercase tracking-[0.2em] text-brand-primary">Accommodation Details</span>
              <div class="h-px flex-1 bg-brand-primary/10"></div>
            </div>
            <div class="space-y-3 sm:space-y-4">
              <% @booking_rooms.each do |room| %>
                <div class="flex justify-between items-center bg-white p-4 sm:p-6 rounded-2xl shadow-sm border border-neutral-border/40 hover:border-[#d9c5a0]/30 transition-colors group">
                  <div>
                    <p class="text-base sm:text-lg font-bold text-neutral-text-primary group-hover:text-brand-primary transition-colors"><%= room.room_type_snapshot['name'] %></p>
                    <p class="text-xs text-neutral-text-secondary font-bold"><%= room.quantity %>x Room Unit</p>
                  </div>
                  <div class="text-right">
                    <span class="inline-flex items-center px-3 py-1 rounded-full text-[10px] font-bold bg-[#d9c5a0]/10 text-[#d9c5a0] border border-[#d9c5a0]/20 uppercase tracking-wider">Paid</span>
                  </div>
                </div>
              <% end %>
            </div>
          </div>

          <!-- Guest & Payment Info -->
          <div class="grid md:grid-cols-2 gap-6 sm:gap-10 items-stretch">
            <div class="flex flex-col">
              <div class="flex items-center gap-x-3 mb-6">
                <span class="text-[11px] font-bold uppercase tracking-[0.2em] text-brand-primary">Primary Guest</span>
                <div class="h-px flex-1 bg-brand-primary/10"></div>
              </div>
              <div class="bg-white p-4 sm:p-6 rounded-2xl shadow-sm border border-neutral-border/40 h-full">
                <p class="text-base sm:text-lg font-bold text-neutral-text-primary mb-2"><%= @booking.guest_name %></p>
                <div class="space-y-1">
                  <p class="text-xs text-neutral-text-secondary flex items-center gap-x-2 font-bold">
                    <svg class="w-3.5 h-3.5 text-[#d9c5a0]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
                    <%= @booking.guest_email %>
                  </p>
                  <p class="text-xs text-neutral-text-secondary flex items-center gap-x-2 font-bold">
                    <svg class="w-3.5 h-3.5 text-[#d9c5a0]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
                    <%= @booking.guest_phone %>
                  </p>
                </div>
              </div>
            </div>
            <div class="flex flex-col">
              <div class="flex items-center gap-x-3 mb-6">
                <span class="text-[11px] font-bold uppercase tracking-[0.2em] text-brand-primary">Payment Summary</span>
                <div class="h-px flex-1 bg-brand-primary/10"></div>
              </div>
              <div class="bg-[#0a2e29] text-white p-4 sm:p-6 rounded-2xl shadow-xl shadow-brand-primary/10 border border-[#d9c5a0]/10 relative overflow-hidden h-full flex flex-col justify-center">
                <div class="absolute -top-12 -right-12 w-32 h-32 bg-brand-primary/20 rounded-full blur-3xl"></div>
                <div class="relative flex justify-between items-center mb-6">
                  <span class="text-[10px] font-bold uppercase tracking-[0.2em] text-[#d9c5a0]">Total Paid</span>
                  <div class="text-right">
                    <span class="text-2xl sm:text-3xl font-bold tracking-tight">RM <%= number_with_precision(@booking.total_amount, precision: 2) %></span>
                    <p class="text-[9px] text-white/50 uppercase tracking-widest mt-1">Inclusive of all taxes</p>
                  </div>
                </div>
                <div class="relative pt-4 border-t border-white/5 flex items-center justify-center gap-x-2">
                  <svg class="w-4 h-4 text-[#25D366]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>
                  <p class="text-[10px] text-white/70 font-bold uppercase tracking-widest">WAStays Secure Checkout</p>
                </div>
              </div>
            </div>
          </div>

          <!-- Hotel Terms -->
          <div class="pt-6 border-t border-neutral-border/40">
            <h3 class="text-xs font-bold uppercase tracking-[0.2em] text-brand-primary mb-4">Property Policies</h3>
            <div class="prose prose-sm prose-neutral max-w-none text-xs text-neutral-text-secondary leading-relaxed space-y-2">
              <div class="flex items-start gap-x-3">
                <span class="w-1.5 h-1.5 rounded-full bg-[#d9c5a0] mt-1.5 flex-none"></span>
                <p class="font-bold">Identification required upon check-in. Local government taxes may apply.</p>
              </div>
              <% if (policy = @booking.hotel_snapshot['property_policy']&.fetch('cancellation_policy', nil)).present? %>
                <div class="flex items-start gap-x-3">
                  <span class="w-1.5 h-1.5 rounded-full bg-[#d9c5a0] mt-1.5 flex-none"></span>
                  <p class="font-bold"><%= policy %></p>
                </div>
              <% end %>
            </div>
          </div>

          <!-- Footer Actions -->
          <div class="pt-8 border-t border-neutral-border/40 flex items-center justify-between print:hidden">
            <%= link_to root_path, class: "group inline-flex items-center gap-x-2 px-6 py-3 bg-neutral-bg hover:bg-neutral-border/40 text-[11px] font-bold text-neutral-text-secondary hover:text-brand-primary rounded-xl transition-all border border-neutral-border/50 uppercase tracking-widest shadow-sm" do %>
              <svg class="w-3.5 h-3.5" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
              Return to Home
            <% end %>
            <%= link_to receipt_booking_path(@booking.confirmation_token), class: "group inline-flex items-center gap-x-2 px-6 py-3 bg-[#0a2e29] hover:bg-[#0d3d35] text-[11px] font-bold text-[#d9c5a0] rounded-xl transition-all border border-[#d9c5a0]/20 uppercase tracking-widest shadow-sm", data: { turbo: false } do %>
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M12 10v6m0 0l-3-3m3 3l3-3M3 17V7a2 2 0 012-2h6l2 2h6a2 2 0 012 2v8a2 2 0 01-2 2H5a2 2 0 01-2-2z"/></svg>
              Download Receipt
            <% end %>
          </div>
        </div>
      </div>
    </div>

    <!-- Print Only: Footer -->
    <div class="hidden print:block mt-12 text-center text-[10px] text-neutral-text-secondary">
      <p>This is an electronically generated voucher for WAStays. No signature required.</p>
      <p class="mt-1 font-bold">WAStays Support: hello@wastays.com | Booking Ref: <%= @booking.confirmation_token %></p>
    </div>
  </div>
</div>
