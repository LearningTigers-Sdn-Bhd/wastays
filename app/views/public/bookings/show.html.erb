<div class="max-w-[85rem] mx-auto px-4 sm:px-6 lg:px-8 py-10">
  <div class="max-w-3xl mx-auto">
    <div class="bg-white border border-gray-200 rounded-xl shadow-sm overflow-hidden">
      <!-- Success Header -->
      <div class="bg-green-600 p-8 text-center text-white">
        <div class="inline-flex justify-center items-center h-16 w-16 rounded-full bg-green-500 border-4 border-white mb-4">
          <svg class="h-10 w-10 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7" />
          </svg>
        </div>
        <h1 class="text-3xl font-bold mb-2">Booking Confirmed!</h1>
        <p class="text-green-50">Thank you for booking with WAStays. Your reservation is now complete.</p>
        <div class="mt-6 inline-block bg-white/20 backdrop-blur-sm px-4 py-2 rounded-lg font-mono text-xl tracking-widest border border-white/30">
          <%= @booking.confirmation_token %>
        </div>
      </div>

      <div class="p-8 space-y-8">
        <!-- Guest Details -->
        <div class="grid sm:grid-cols-2 gap-8">
          <div>
            <h3 class="text-sm font-bold text-gray-800 uppercase tracking-wider mb-4">Guest Details</h3>
            <div class="space-y-2">
              <p class="text-gray-800 font-medium"><%= @booking.guest_name %></p>
              <p class="text-gray-600 text-sm"><%= @booking.guest_email %></p>
              <p class="text-gray-600 text-sm"><%= @booking.guest_phone %></p>
            </div>
          </div>
          <div>
            <h3 class="text-sm font-bold text-gray-800 uppercase tracking-wider mb-4">Hotel Details</h3>
            <div class="space-y-2">
              <p class="text-gray-800 font-medium"><%= @hotel.name %></p>
              <p class="text-gray-600 text-sm"><%= @hotel.address %></p>
              <p class="text-gray-600 text-sm"><%= @hotel.city %>, <%= @hotel.country %></p>
            </div>
          </div>
        </div>

        <!-- Stay Details -->
        <div class="border-t border-b border-gray-100 py-6">
          <h3 class="text-sm font-bold text-gray-800 uppercase tracking-wider mb-4">Stay Summary</h3>
          <div class="grid sm:grid-cols-3 gap-4">
            <div>
              <p class="text-xs text-gray-500 uppercase">Check-in</p>
              <p class="text-gray-800 font-medium"><%= @booking.check_in.strftime("%d %b %Y") %></p>
              <p class="text-xs text-gray-400">After <%= @booking.hotel_snapshot['property_policy']&.fetch('check_in_time', '2:00 PM') %></p>
            </div>
            <div>
              <p class="text-xs text-gray-500 uppercase">Check-out</p>
              <p class="text-gray-800 font-medium"><%= @booking.check_out.strftime("%d %b %Y") %></p>
              <p class="text-xs text-gray-400">Before <%= @booking.hotel_snapshot['property_policy']&.fetch('check_out_time', '12:00 PM') %></p>
            </div>
            <div>
              <p class="text-xs text-gray-500 uppercase">Stay Duration</p>
              <p class="text-gray-800 font-medium"><%= pluralize((@booking.check_out - @booking.check_in).to_i, 'night') %></p>
            </div>
          </div>
        </div>

        <!-- Room Details -->
        <div>
          <h3 class="text-sm font-bold text-gray-800 uppercase tracking-wider mb-4">Room Selection</h3>
          <div class="space-y-4">
            <% @booking_rooms.each do |room| %>
              <div class="flex justify-between items-center py-3 px-4 bg-gray-50 rounded-lg">
                <div>
                  <p class="font-bold text-gray-800"><%= room.room_type_snapshot['name'] %></p>
                  <p class="text-xs text-gray-500"><%= room.quantity %> room(s) x <%= room.booking.adults %> adults</p>
                </div>
                <div class="text-right">
                  <p class="font-bold text-blue-600">MYR <%= room.subtotal %></p>
                </div>
              </div>
            <% end %>
          </div>
        </div>

        <!-- Total -->
        <div class="flex justify-between items-center p-6 bg-blue-50 rounded-xl">
          <div>
            <p class="text-sm text-blue-800 font-bold uppercase tracking-wider">Total Amount Paid</p>
            <p class="text-xs text-blue-600">Securely processed via Curlec</p>
          </div>
          <div class="text-right">
            <p class="text-3xl font-bold text-blue-800">MYR <%= @booking.total_amount %></p>
          </div>
        </div>

        <!-- Next Steps -->
        <div class="bg-gray-50 p-6 rounded-xl border border-gray-100">
          <h3 class="text-lg font-bold text-gray-800 mb-3">What happens next?</h3>
          <ul class="space-y-3 text-sm text-gray-600">
            <li class="flex gap-x-3">
              <svg class="h-5 w-5 text-green-500 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
              <span>You will receive a confirmation email shortly.</span>
            </li>
            <li class="flex gap-x-3">
              <svg class="h-5 w-5 text-green-500 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
              <span>The hotel has been notified of your reservation.</span>
            </li>
            <li class="flex gap-x-3">
              <svg class="h-5 w-5 text-blue-500 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
              <span>A pre-check-in link will be sent via WhatsApp 24 hours before your arrival.</span>
            </li>
          </ul>
        </div>
      </div>

      <div class="p-8 border-t border-gray-100 bg-gray-50 text-center">
        <p class="text-sm text-gray-500 mb-4">Need help with your booking?</p>
        <div class="flex justify-center gap-4">
          <%= link_to "Return Home", root_path, class: "py-2 px-4 inline-flex justify-center items-center gap-x-2 text-sm font-medium rounded-lg border border-gray-200 bg-white text-gray-800 shadow-sm hover:bg-gray-50" %>
          <%= link_to "Contact Support", "mailto:support@wastays.com?subject=Booking Support: #{@booking.confirmation_token}", class: "py-2 px-4 inline-flex justify-center items-center gap-x-2 text-sm font-semibold rounded-lg border border-transparent bg-blue-600 text-white hover:bg-blue-700" %>
        </div>
      </div>
    </div>
  </div>
</div>
