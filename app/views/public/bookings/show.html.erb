<div class="bg-neutral-bg min-h-screen pb-24">
  <!-- Status Banner -->
  <div class="bg-status-success py-12 text-center text-white relative overflow-hidden print:hidden">
    <div class="absolute inset-0 opacity-10">
      <svg class="w-full h-full" viewBox="0 0 100 100" preserveAspectRatio="none"><path d="M0 100 C 20 0 50 0 100 100 Z" fill="white"></path></svg>
    </div>
    <div class="relative max-w-[85rem] mx-auto px-4">
      <div class="inline-flex items-center justify-center w-20 h-20 bg-white/20 rounded-full mb-6 backdrop-blur-md border-4 border-white/30">
        <svg class="w-10 h-10 text-white" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
      </div>
      <h1 class="text-4xl font-black tracking-tight mb-2">Booking Confirmed!</h1>
      <p class="text-white/90 text-lg">Pack your bags, <%= @booking.guest_name.split.first %>, you're all set.</p>
      
      <div class="mt-8 inline-flex flex-col items-center">
        <span class="text-[10px] font-black uppercase tracking-widest opacity-80 mb-1">Confirmation Code</span>
        <div class="bg-white text-status-success px-6 py-2 rounded-xl font-mono text-2xl font-black tracking-[0.2em] shadow-xl">
          <%= @booking.confirmation_token %>
        </div>
      </div>
    </div>
  </div>

  <div class="max-w-4xl mx-auto px-4 -mt-8 relative z-10">
    <!-- Next Steps Card -->
    <div class="card p-6 md:p-8 border-none shadow-2xl mb-8 print:hidden">
      <h2 class="text-xl font-black text-neutral-text-primary mb-6">What's Next?</h2>
      <div class="grid md:grid-cols-3 gap-6">
        <div class="space-y-3">
          <div class="w-10 h-10 rounded-full bg-brand-primary/10 text-brand-primary flex items-center justify-center font-black">1</div>
          <h3 class="font-bold text-sm text-neutral-text-primary uppercase tracking-wider">Save Voucher</h3>
          <p class="text-xs text-neutral-text-secondary leading-relaxed">Download or print this page. You'll need to show it upon arrival.</p>
          <button onclick="window.print()" class="text-xs font-black text-brand-primary hover:underline">Print Voucher →</button>
        </div>
        <div class="space-y-3">
          <div class="w-10 h-10 rounded-full bg-brand-primary/10 text-brand-primary flex items-center justify-center font-black">2</div>
          <h3 class="font-bold text-sm text-neutral-text-primary uppercase tracking-wider">Pre-check-in</h3>
          <p class="text-xs text-neutral-text-secondary leading-relaxed">Save time at the desk. Complete your guest details online before you arrive.</p>
          <a href="#" class="btn btn-primary py-1.5 px-4 text-[10px] font-black uppercase tracking-widest">Start Now</a>
        </div>
        <div class="space-y-3">
          <div class="w-10 h-10 rounded-full bg-green-100 text-status-success flex items-center justify-center font-black">
            <svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/></svg>
          </div>
          <h3 class="font-bold text-sm text-neutral-text-primary uppercase tracking-wider">Get Assistance</h3>
          <p class="text-xs text-neutral-text-secondary leading-relaxed">Need help with directions or special requests? Our WhatsApp team is ready.</p>
          <a href="#" class="text-xs font-black text-status-success hover:underline">Chat with us →</a>
        </div>
      </div>
    </div>

    <!-- Booking Voucher Card -->
    <div class="card overflow-hidden shadow-xl border-none">
      <div class="p-8 md:p-12 border-b-4 border-dashed border-neutral-bg relative">
        <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-6 mb-10">
          <div>
            <span class="text-[10px] font-black uppercase tracking-widest text-brand-primary mb-1 block">Booking Voucher</span>
            <h2 class="text-3xl font-black text-neutral-text-primary leading-tight"><%= @hotel.name %></h2>
            <p class="text-neutral-text-secondary font-medium"><%= @hotel.city %>, <%= @hotel.country %></p>
          </div>
          <div class="hidden md:block">
            <div class="w-24 h-24 bg-neutral-bg rounded-2xl flex items-center justify-center p-2 border-2 border-neutral-border">
              <%# QR Code Placeholder %>
              <svg class="w-full h-full text-neutral-border" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect width="18" height="18" x="3" y="3" rx="2"/><path d="M7 7h4v4H7z"/><path d="M13 7h4v4h-4z"/><path d="M7 13h4v4H7z"/><path d="M13 13h1"/><path d="M17 13h.01"/><path d="M13 17h.01"/><path d="M15 15h2v2h-2z"/></svg>
            </div>
          </div>
        </div>

        <div class="grid grid-cols-2 md:grid-cols-4 gap-8">
          <div>
            <p class="text-[10px] font-black uppercase tracking-widest text-neutral-text-secondary mb-1">Check-in</p>
            <p class="text-lg font-black text-neutral-text-primary"><%= @booking.check_in.strftime("%b %d, %Y") %></p>
            <p class="text-xs text-neutral-text-secondary">From <%= @booking.hotel_snapshot['property_policy']&.fetch('check_in_time', '2:00 PM') %></p>
          </div>
          <div>
            <p class="text-[10px] font-black uppercase tracking-widest text-neutral-text-secondary mb-1">Check-out</p>
            <p class="text-lg font-black text-neutral-text-primary"><%= @booking.check_out.strftime("%b %d, %Y") %></p>
            <p class="text-xs text-neutral-text-secondary">Until <%= @booking.hotel_snapshot['property_policy']&.fetch('check_out_time', '12:00 PM') %></p>
          </div>
          <div>
            <p class="text-[10px] font-black uppercase tracking-widest text-neutral-text-secondary mb-1">Duration</p>
            <p class="text-lg font-black text-neutral-text-primary"><%= pluralize((@booking.check_out - @booking.check_in).to_i, 'Night') %></p>
          </div>
          <div>
            <p class="text-[10px] font-black uppercase tracking-widest text-neutral-text-secondary mb-1">Guests</p>
            <p class="text-lg font-black text-neutral-text-primary"><%= @booking.adults %> Adults</p>
            <% if @booking.children > 0 %>
              <p class="text-xs text-neutral-text-secondary"><%= @booking.children %> Children</p>
            <% end %>
          </div>
        </div>
      </div>

      <div class="p-8 md:p-12 bg-neutral-bg/30">
        <div class="space-y-8">
          <!-- Room Items -->
          <div>
            <h3 class="text-sm font-black uppercase tracking-widest text-neutral-text-primary mb-4">Accommodation Details</h3>
            <div class="space-y-3">
              <% @booking_rooms.each do |room| %>
                <div class="flex justify-between items-center bg-white p-4 rounded-xl shadow-sm border border-neutral-border">
                  <div>
                    <p class="font-black text-neutral-text-primary"><%= room.room_type_snapshot['name'] %></p>
                    <p class="text-xs text-neutral-text-secondary"><%= room.quantity %>x Room Unit</p>
                  </div>
                  <div class="text-right">
                    <span class="badge badge-success">Paid</span>
                  </div>
                </div>
              <% end %>
            </div>
          </div>

          <!-- Guest Info -->
          <div class="grid md:grid-cols-2 gap-8">
            <div>
              <h3 class="text-sm font-black uppercase tracking-widest text-neutral-text-primary mb-4">Primary Guest</h3>
              <div class="bg-white p-4 rounded-xl shadow-sm border border-neutral-border">
                <p class="font-black text-neutral-text-primary"><%= @booking.guest_name %></p>
                <p class="text-xs text-neutral-text-secondary mt-1"><%= @booking.guest_email %></p>
                <p class="text-xs text-neutral-text-secondary"><%= @booking.guest_phone %></p>
              </div>
            </div>
            <div>
              <h3 class="text-sm font-black uppercase tracking-widest text-neutral-text-primary mb-4">Payment Summary</h3>
              <div class="bg-brand-primary text-white p-4 rounded-xl shadow-lg shadow-brand-primary/20">
                <div class="flex justify-between items-center">
                  <span class="text-xs font-bold uppercase tracking-widest opacity-80">Total Paid</span>
                  <span class="text-2xl font-black tracking-tighter">RM <%= number_with_precision(@booking.total_amount, precision: 2) %></span>
                </div>
                <p class="text-[10px] mt-2 opacity-70 italic">Processed via WAStays Secure Payments</p>
              </div>
            </div>
          </div>

          <!-- Hotel Terms -->
          <div class="pt-4">
            <h3 class="text-sm font-black uppercase tracking-widest text-neutral-text-primary mb-4">Property Policies</h3>
            <div class="prose prose-sm prose-neutral max-w-none text-xs text-neutral-text-secondary leading-relaxed">
              <p>• Identification required upon check-in. Local government taxes may apply.</p>
              <p>• <%= @booking.hotel_snapshot['property_policy']&.fetch('cancellation_policy', 'Cancellation policies are subject to the terms agreed during booking. No-shows may result in forfeiture of the full amount.') %></p>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Print Only: Footer -->
    <div class="hidden print:block mt-12 text-center text-[10px] text-neutral-text-secondary">
      <p>This is an electronically generated voucher for WAStays. No signature required.</p>
      <p class="mt-1">WAStays Support: support@wastays.com | Booking Ref: <%= @booking.confirmation_token %></p>
    </div>

    <div class="mt-12 text-center print:hidden">
      <%= link_to root_path, class: "inline-flex items-center gap-x-2 text-sm font-bold text-neutral-text-secondary hover:text-brand-primary transition-colors" do %>
        <svg class="w-4 h-4" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg>
        Return to Home
      <% end %>
    </div>
  </div>
</div>
