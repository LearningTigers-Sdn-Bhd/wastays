<div class="bg-neutral-bg min-h-screen pb-12">
  <!-- Checkout Header -->
  <div class="bg-white border-b border-neutral-border py-6 shadow-sm">
    <div class="max-w-[85rem] mx-auto px-4 flex flex-col md:flex-row md:items-center md:justify-between gap-y-4">
      <div>
        <h1 class="text-2xl font-black text-neutral-text-primary tracking-tight">Complete Your Booking</h1>
        <p class="text-sm text-neutral-text-secondary mt-1">Please provide your details to secure your room.</p>
      </div>
      
      <!-- Hold Timer -->
      <div class="inline-flex items-center gap-x-2 bg-red-50 border border-red-100 px-4 py-2 rounded-xl text-status-error">
        <svg class="w-4 h-4 animate-pulse" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
        <span class="text-xs font-black uppercase tracking-widest">Hold expires in: <span id="countdown"><%= ((@quote.expires_at - Time.current) / 60).to_i %>m</span></span>
      </div>
    </div>
  </div>

  <!-- Progress Stepper -->
  <div class="max-w-[85rem] mx-auto px-4 py-8">
    <div class="flex items-center justify-center max-w-2xl mx-auto mb-12">
      <div class="flex flex-col items-center relative">
        <div class="w-8 h-8 rounded-full bg-status-success text-white flex items-center justify-center text-xs font-bold ring-4 ring-green-50 shadow-sm">
          <svg class="w-4 h-4" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
        </div>
        <span class="text-[10px] font-black text-neutral-text-secondary uppercase tracking-widest mt-2 absolute -bottom-6 whitespace-nowrap">Room</span>
      </div>
      <div class="flex-1 h-0.5 bg-brand-primary mx-4"></div>
      <div class="flex flex-col items-center relative">
        <div class="w-8 h-8 rounded-full bg-brand-primary text-white flex items-center justify-center text-xs font-black ring-4 ring-red-50 shadow-md">2</div>
        <span class="text-[10px] font-black text-brand-primary uppercase tracking-widest mt-2 absolute -bottom-6 whitespace-nowrap">Details</span>
      </div>
      <div class="flex-1 h-0.5 bg-neutral-border mx-4"></div>
      <div class="flex flex-col items-center relative opacity-50">
        <div class="w-8 h-8 rounded-full bg-neutral-surface border-2 border-neutral-border text-neutral-text-secondary flex items-center justify-center text-xs font-bold">3</div>
        <span class="text-[10px] font-black text-neutral-text-secondary uppercase tracking-widest mt-2 absolute -bottom-6 whitespace-nowrap">Payment</span>
      </div>
    </div>

    <%= form_with url: verify_payment_path, method: :post, class: "max-w-[85rem] mx-auto", id: "payment-checkout-form", data: { checkout_session_url: checkout_payment_session_path, guest_lookup_url: guest_lookup_quote_path(@quote.token), payment_ready: @payment_ready } do |f| %>
      <%= f.hidden_field :quote_token, value: @quote.token %>
      <%= f.hidden_field :gateway, value: @payment_gateway %>
      <%= f.hidden_field "payment_response[razorpay_payment_id]", value: "", data: { razorpay_payment_id: true } %>
      <%= f.hidden_field "payment_response[razorpay_order_id]", value: "", data: { razorpay_order_id: true } %>
      <%= f.hidden_field "payment_response[razorpay_signature]", value: "", data: { razorpay_signature: true } %>
      
      <div class="grid lg:grid-cols-12 gap-8">
        <!-- Forms Area -->
        <div class="lg:col-span-8 space-y-6">
          <!-- Guest Information -->
          <div class="card p-6 md:p-8">
            <h2 class="text-xl font-extrabold text-neutral-text-primary mb-6 flex items-center gap-x-2">
              <svg class="w-5 h-5 text-brand-primary" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
              Guest Information
            </h2>
            
            <div class="grid sm:grid-cols-12 gap-4 sm:items-end">
              <div class="sm:col-span-9">
                <label for="email" class="block text-xs font-bold uppercase tracking-widest text-neutral-text-secondary mb-2">Email Address</label>
                <%= f.email_field "guest_details[email]",
                                  value: @quote.guest_email,
                                  id: "email",
                                  required: true,
                                  placeholder: "john@example.com",
                                  class: "form-input w-full rounded-xl border border-neutral-border py-3 px-4 focus:border-brand-primary focus:ring-brand-primary/20",
                                  data: { guest_email: true } %>
              </div>
              <div class="sm:col-span-3">
                <button type="button" class="btn btn-secondary w-full py-3 text-sm font-black" data-email-lookup-button>
                  Continue
                </button>
              </div>
            </div>
            <p class="text-xs text-neutral-text-secondary mt-2" data-email-lookup-feedback>
              Enter your email first. We will auto-fill your details if we find a previous booking.
            </p>

            <div data-guest-details-panel class="mt-6 opacity-60 pointer-events-none transition">
              <div class="grid sm:grid-cols-3 gap-6">
                <div class="sm:col-span-2">
                  <label for="name" class="block text-xs font-bold uppercase tracking-widest text-neutral-text-secondary mb-2">Full Name (as per ID/Passport)</label>
                  <%= f.text_field "guest_details[name]",
                                   value: @quote.guest_name,
                                   id: "name",
                                   required: true,
                                   placeholder: "John Doe",
                                   class: "form-input w-full rounded-xl border border-neutral-border py-3 px-4 focus:border-brand-primary focus:ring-brand-primary/20",
                                   data: { guest_field: "name" },
                                   disabled: true %>
                </div>
                <div>
                  <label for="gender" class="block text-xs font-bold uppercase tracking-widest text-neutral-text-secondary mb-2">Gender</label>
                  <%= f.select "guest_details[gender]",
                               options_for_select([["Male", "male"], ["Female", "female"], ["Other", "other"]]),
                               { prompt: "Select gender" },
                               { required: true,
                                 class: "form-select w-full rounded-xl border border-neutral-border py-3 px-4 focus:border-brand-primary focus:ring-brand-primary/20",
                                 data: { guest_field: "gender" },
                                 disabled: true } %>
                </div>
              </div>
              <div class="grid sm:grid-cols-2 gap-6 mt-6" data-country-flow>
                <div>
                  <label for="phone" class="block text-xs font-bold uppercase tracking-widest text-neutral-text-secondary mb-2">WhatsApp Number</label>
                  <%= f.telephone_field "guest_details[phone]",
                                       value: @quote.guest_phone,
                                       id: "phone",
                                       required: true,
                                       placeholder: "+60 12-345 6789",
                                       class: "form-input w-full rounded-xl border border-neutral-border py-3 px-4 focus:border-brand-primary focus:ring-brand-primary/20",
                                       data: { guest_field: "phone" },
                                       disabled: true %>
                </div>
                <div class="relative" data-country-dropdown data-countries="<%= country_options.to_json %>">
                  <label for="country" class="block text-xs font-bold uppercase tracking-widest text-neutral-text-secondary mb-2">Country (passport)</label>
                  <%= f.text_field "guest_details[country]",
                                   id: "country",
                                   required: true,
                                   class: "form-input w-full rounded-xl border border-neutral-border py-3 px-4 focus:border-brand-primary focus:ring-brand-primary/20",
                                   placeholder: "Start typing to search",
                                   autocomplete: "off",
                                   inputmode: "search",
                                   data: { country_select: true, country_input: true, guest_field: "country" },
                                   disabled: true %>
                  <p class="text-[10px] text-neutral-text-secondary mt-2">Start typing to select a country, then choose the document type.</p>
                  <div class="absolute z-20 mt-2 w-full rounded-xl border border-neutral-200 bg-white shadow-lg max-h-56 overflow-auto hidden" data-country-menu></div>
                </div>
                <div>
                  <label for="document_type" class="block text-xs font-bold uppercase tracking-widest text-neutral-text-secondary mb-2">Document Type</label>
                  <%= f.select "guest_details[document_type]",
                               options_for_select([["MyKad / IC", "ic"], ["Passport", "passport"]]),
                               { required: true, prompt: "Select document type" },
                               class: "form-select w-full rounded-xl border border-neutral-border py-3 px-4 focus:border-brand-primary focus:ring-brand-primary/20",
                               data: { document_select: true, guest_field: "document_type" },
                               disabled: true %>
                </div>
                <div data-document-field class="hidden">
                  <label for="government_id" class="block text-xs font-bold uppercase tracking-widest text-neutral-text-secondary mb-2" data-document-label>IC / Passport Number</label>
                  <%= f.text_field "guest_details[government_id]",
                                   id: "government_id",
                                   required: true,
                                   class: "form-input w-full rounded-xl border border-neutral-border py-3 px-4 focus:border-brand-primary focus:ring-brand-primary/20",
                                   placeholder: "Enter document number",
                                   data: { document_input: true, guest_field: "government_id" },
                                   disabled: true %>
                </div>
              </div>
            </div>
            <% if @hotel.tourism_tax_enabled? %>
              <p class="text-xs text-neutral-text-secondary mt-3">
                Malaysia tourism tax of RM <%= number_with_precision(@hotel.tourism_tax_amount, precision: 2) %> applies to guests with passports from outside Malaysia. The amount will be included during checkout for clarity.
              </p>
            <% end %>
          </div>
          <script>
            (function() {
              const form = document.getElementById('payment-checkout-form');
              const container = document.querySelector('[data-country-flow]');
              if (!container || !form) return;

              const countryInput = container.querySelector('[data-country-select]');
              const documentSelect = container.querySelector('[data-document-select]');
              const documentInput = container.querySelector('[data-document-input]');
              const documentLabel = container.querySelector('[data-document-label]');
              const documentField = container.querySelector('[data-document-field]');
              const countryDropdown = container.querySelector('[data-country-dropdown]');
              const countryMenu = container.querySelector('[data-country-menu]');
              const countryInputField = container.querySelector('[data-country-input]');
              const emailInput = form.querySelector('[data-guest-email]');
              const lookupButton = form.querySelector('[data-email-lookup-button]');
              const feedback = form.querySelector('[data-email-lookup-feedback]');
              const guestDetailsPanel = form.querySelector('[data-guest-details-panel]');
              const guestFields = form.querySelectorAll('[data-guest-field]');
              const countryList = countryDropdown ? JSON.parse(countryDropdown.dataset.countries || '[]') : [];
              let documentManuallySet = false;
              let detailsUnlocked = false;
              let lookupInProgress = false;
              let lastLookupEmail = '';

              const setFeedback = (message, tone = 'neutral') => {
                if (!feedback) return;
                feedback.textContent = message;
                feedback.classList.remove('text-neutral-text-secondary', 'text-status-success', 'text-status-error');
                if (tone === 'success') {
                  feedback.classList.add('text-status-success');
                } else if (tone === 'error') {
                  feedback.classList.add('text-status-error');
                } else {
                  feedback.classList.add('text-neutral-text-secondary');
                }
              };

              const setDetailsUnlocked = (unlocked) => {
                detailsUnlocked = unlocked;
                if (guestDetailsPanel) {
                  guestDetailsPanel.classList.toggle('opacity-60', !unlocked);
                  guestDetailsPanel.classList.toggle('pointer-events-none', !unlocked);
                }
                guestFields.forEach((field) => {
                  field.disabled = !unlocked;
                });
                if (!unlocked) {
                  if (countryMenu) countryMenu.classList.add('hidden');
                  if (documentField) documentField.classList.add('hidden');
                }
                updateEnabled();
              };

              const clearGuestFields = () => {
                guestFields.forEach((field) => {
                  if (!field.dataset.guestField) return;
                  field.value = '';
                });
                documentManuallySet = false;
                updateLabel();
              };

              const applyGuestDetails = (guestDetails) => {
                guestFields.forEach((field) => {
                  const key = field.dataset.guestField;
                  if (!key || !Object.prototype.hasOwnProperty.call(guestDetails, key)) return;
                  const value = guestDetails[key];
                  field.value = value || '';
                });
                documentManuallySet = !!documentSelect?.value;
                updateLabel();
              };

              const normalizedEmail = () => emailInput?.value?.trim().toLowerCase() || '';

              const lookupGuestByEmail = async () => {
                const email = normalizedEmail();
                if (!email || !form.dataset.guestLookupUrl || lookupInProgress) return;

                lookupInProgress = true;
                if (lookupButton) lookupButton.disabled = true;
                setFeedback('Checking your email...');

                try {
                  const response = await fetch(`${form.dataset.guestLookupUrl}?email=${encodeURIComponent(email)}`, {
                    headers: { Accept: 'application/json' }
                  });

                  const payload = await response.json();
                  setDetailsUnlocked(true);
                  lastLookupEmail = email;

                  if (payload.found) {
                    applyGuestDetails(payload.guest_details || {});
                    setFeedback('Welcome back! We found your saved details.', 'success');
                  } else {
                    clearGuestFields();
                    setFeedback('New email detected. Please fill in your details below.');
                  }
                } catch (error) {
                  setDetailsUnlocked(true);
                  clearGuestFields();
                  setFeedback('Unable to check email right now. Please fill in your details manually.', 'error');
                } finally {
                  lookupInProgress = false;
                  if (lookupButton) lookupButton.disabled = false;
                  updateEnabled();
                  autoSelectDocumentType();
                }
              };

              const updateEnabled = () => {
                if (!detailsUnlocked) {
                  if (documentSelect) documentSelect.disabled = true;
                  if (documentInput) documentInput.disabled = true;
                  if (documentField) documentField.classList.add('hidden');
                  return;
                }
                const hasCountry = countryInput && countryInput.value.trim().length > 0;
                if (documentSelect) documentSelect.disabled = !hasCountry;
                if (!hasCountry && documentSelect) {
                  documentSelect.value = '';
                  documentManuallySet = false;
                }
                const hasDocumentType = hasCountry && documentSelect && documentSelect.value;
                if (documentInput) documentInput.disabled = !hasDocumentType;
                if (documentField) {
                  documentField.classList.toggle('hidden', !hasDocumentType);
                }
              };

              const autoSelectDocumentType = () => {
                if (!countryInput || !documentSelect) return;
                const country = countryInput.value.trim().toLowerCase();
                if (!country) return;
                if (documentManuallySet && documentSelect.value) return;
                const isMalaysia = ['malaysia', 'my', 'mys'].includes(country);
                documentSelect.value = isMalaysia ? 'ic' : 'passport';
                updateLabel();
                updateEnabled();
              };

              const updateLabel = () => {
                if (!documentLabel || !documentSelect) return;
                if (!documentSelect.value) {
                  documentLabel.textContent = 'IC / Passport Number';
                  return;
                }
                const label = documentSelect.value === 'ic' ? 'IC Number' : 'Passport Number';
                documentLabel.textContent = label;
              };

              const renderCountryOptions = (query) => {
                if (!countryMenu || !countryInputField) return;
                const normalized = query.trim().toLowerCase();
                const matches = normalized
                  ? countryList.filter((country) => country.toLowerCase().includes(normalized))
                  : countryList;
                const limited = matches.slice(0, 12);
                countryMenu.innerHTML = limited
                  .map((country) => `<button type="button" class="w-full px-3 py-2 text-left text-sm text-neutral-text-primary hover:bg-neutral-100" data-country-option="${country}">${country}</button>`)
                  .join('');
                countryMenu.classList.toggle('hidden', limited.length === 0);
              };

              const closeCountryMenu = () => {
                if (countryMenu) countryMenu.classList.add('hidden');
              };

              const applyCountrySelection = (option) => {
                if (!option || !countryInputField) return;
                countryInputField.value = option.dataset.countryOption || '';
                closeCountryMenu();
                updateEnabled();
                autoSelectDocumentType();
              };

              if (countryInputField) {
                countryInputField.addEventListener('input', (event) => {
                  renderCountryOptions(event.target.value);
                  updateEnabled();
                  autoSelectDocumentType();
                });
                countryInputField.addEventListener('focus', (event) => {
                  renderCountryOptions(event.target.value);
                });
                countryInputField.addEventListener('blur', () => {
                  setTimeout(closeCountryMenu, 120);
                });
              }

              if (countryMenu) {
                countryMenu.addEventListener('mousedown', (event) => {
                  const option = event.target.closest('[data-country-option]');
                  if (!option) return;
                  // Select before input blur hides the dropdown.
                  event.preventDefault();
                  applyCountrySelection(option);
                });

                countryMenu.addEventListener('click', (event) => {
                  const option = event.target.closest('[data-country-option]');
                  if (!option) return;
                  applyCountrySelection(option);
                });
              }

              if (countryInput) {
                countryInput.addEventListener('input', updateEnabled);
              }
              if (documentSelect) {
                documentSelect.addEventListener('change', () => {
                  documentManuallySet = true;
                  updateEnabled();
                  updateLabel();
                });
              }

              if (emailInput) {
                emailInput.addEventListener('input', () => {
                  const email = normalizedEmail();
                  if (email !== lastLookupEmail) {
                    setDetailsUnlocked(false);
                    setFeedback('Enter your email first. We will auto-fill your details if we find a previous booking.');
                  }
                });
              }

              if (lookupButton) {
                lookupButton.addEventListener('click', () => {
                  lookupGuestByEmail();
                });
              }

              if (emailInput) {
                emailInput.addEventListener('keydown', (event) => {
                  if (event.key !== 'Enter') return;
                  event.preventDefault();
                  lookupGuestByEmail();
                });
              }

              updateEnabled();
              updateLabel();
              setDetailsUnlocked(false);

              if (normalizedEmail()) {
                lookupGuestByEmail();
              }
            })();
          </script>

          <!-- Payment Selection -->
          <div class="card p-6 md:p-8">
            <h2 class="text-xl font-extrabold text-neutral-text-primary mb-6 flex items-center gap-x-2">
              <svg class="w-5 h-5 text-brand-primary" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="14" x="2" y="5" rx="2"/><line x1="2" y1="10" x2="22" y2="10"/></svg>
              Secure Payment Method
            </h2>
            
            <div class="space-y-4">
              <label class="relative block cursor-pointer group">
                <input type="radio" name="payment_method" value="online" checked class="peer sr-only">
                <div class="p-4 md:p-5 bg-white border-2 border-neutral-border rounded-xl peer-checked:border-brand-primary peer-checked:bg-red-50/30 transition-all">
                  <div class="flex items-center justify-between">
                    <div class="flex items-center gap-x-4">
                      <div class="w-10 h-10 rounded-full bg-brand-primary/10 flex items-center justify-center text-brand-primary">
                        <svg class="w-6 h-6" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="14" x="2" y="5" rx="2"/><line x1="2" y1="10" x2="22" y2="10"/></svg>
                      </div>
                      <div>
                        <p class="font-bold text-neutral-text-primary">Online Payment / Cards</p>
                        <p class="text-xs text-neutral-text-secondary">FPX, Visa, Mastercard, E-Wallets</p>
                      </div>
                    </div>
                    <div class="h-6 w-6 rounded-full border-2 border-brand-primary flex items-center justify-center">
                      <div class="h-3 w-3 rounded-full bg-brand-primary"></div>
                    </div>
                  </div>
                </div>
              </label>
            </div>
            
            <p class="mt-6 text-xs text-neutral-text-secondary text-center">
              Your connection is encrypted. We do not store your full card details.
            </p>
            <% unless @payment_ready %>
              <div class="mt-4 rounded-xl border border-amber-200 bg-amber-50 px-4 py-3 text-sm text-amber-800">
                Online payment is temporarily unavailable for this hotel. Please contact the hotel to complete booking.
              </div>
            <% end %>
          </div>

          <!-- PDPA Consent -->
          <div class="space-y-4 py-4">
            <label class="flex items-start gap-3 text-sm text-neutral-text-secondary cursor-pointer">
              <%= hidden_field_tag "guest_details[privacy_consent]", "0" %>
              <%= check_box_tag "guest_details[privacy_consent]", "1", false, required: true, class: "mt-1 h-4 w-4 rounded border-neutral-border text-brand-primary focus:ring-brand-primary" %>
              <span>
                I have read and agree to the <%= link_to "Privacy Policy", privacy_policy_path, class: "text-brand-primary underline", target: "_blank" %> and how my data will be processed. <span class="text-status-error">*</span>
              </span>
            </label>

            <label class="flex items-start gap-3 text-sm text-neutral-text-secondary cursor-pointer">
              <%= hidden_field_tag "guest_details[marketing_consent]", "0" %>
              <%= check_box_tag "guest_details[marketing_consent]", "1", false, class: "mt-1 h-4 w-4 rounded border-neutral-border text-brand-primary focus:ring-brand-primary" %>
              <span>
                I agree to receive marketing communications, exclusive offers, and travel updates from WAStays and its partner hotels.
              </span>
            </label>
          </div>

          <div class="flex items-center justify-end gap-4 pt-4">
            <%= link_to "Back to hotel",
                        hotel_path(@hotel, request.query_parameters),
                        class: "btn btn-secondary min-w-[220px] px-12 py-4 text-base font-black text-center" %>
            <%= f.submit "Confirm & Pay Now",
                         class: "btn btn-gradient min-w-[220px] px-12 py-4 text-base font-black disabled:cursor-not-allowed disabled:opacity-60",
                         data: { checkout_submit: true },
                         disabled: !@payment_ready %>
          </div>
        </div>

        <!-- Summary Sidebar -->
        <aside class="lg:col-span-4">
          <div class="sticky top-[130px] space-y-6">
            <div class="card overflow-hidden">
              <div class="p-5 border-b border-neutral-border bg-neutral-bg/50">
                <h3 class="text-xs font-black text-neutral-text-secondary uppercase tracking-widest">Booking Summary</h3>
              </div>
              <div class="p-6">
                <div class="flex gap-x-4 mb-6">
                  <div class="w-20 h-20 rounded-xl overflow-hidden shrink-0 border border-neutral-border shadow-sm">
                    <% if @hotel.room_types.first&.photos&.attached? %>
                      <%= image_tag @hotel.room_types.first.photos.first, class: "w-full h-full object-cover" %>
                    <% else %>
                      <div class="w-full h-full bg-neutral-bg flex items-center justify-center text-neutral-border">
                        <svg class="w-8 h-8" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 9 12 2l9 9"/><path d="M9 22V12h6v10"/><path d="M21 11v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V11"/></svg>
                      </div>
                    <% end %>
                  </div>
                  <div>
                    <h4 class="font-extrabold text-neutral-text-primary leading-tight"><%= @hotel.name %></h4>
                    <p class="text-xs text-neutral-text-secondary mt-1"><%= @hotel.city %></p>
                    <div class="flex text-amber-400 mt-1">
                      <% @hotel.star_rating.to_i.times do %>
                        <svg class="w-3 h-3 fill-current" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
                      <% end %>
                    </div>
                  </div>
                </div>

                <div class="space-y-4 text-sm border-t border-b border-neutral-bg py-6 mb-6">
                  <div class="flex justify-between">
                    <span class="text-neutral-text-secondary">Check-in</span>
                    <span class="font-bold text-neutral-text-primary"><%= @quote.check_in.strftime("%a, %b %d") %></span>
                  </div>
                  <div class="flex justify-between">
                    <span class="text-neutral-text-secondary">Check-out</span>
                    <span class="font-bold text-neutral-text-primary"><%= @quote.check_out.strftime("%a, %b %d") %></span>
                  </div>
                  <div class="flex justify-between">
                    <span class="text-neutral-text-secondary">Stay Length</span>
                    <span class="font-bold text-neutral-text-primary"><%= pluralize((@quote.check_out - @quote.check_in).to_i, 'night') %></span>
                  </div>
                </div>

                <div class="space-y-3 mb-8">
                  <% @quote_items.each do |item| %>
                    <div class="flex justify-between text-sm">
                      <span class="text-neutral-text-secondary font-medium"><%= item.quantity %>x <%= item.room_type_snapshot['name'] %></span>
                      <span class="text-neutral-text-primary font-bold"><%= display_amount(item.subtotal, quote_currency: @quote.currency, display_currency: @display_currency, hotel: @hotel) %></span>
                    </div>
                  <% end %>
                </div>

                <div class="space-y-4 pt-6 border-t border-neutral-border">
                  <div class="flex justify-between items-center text-xl">
                    <span class="font-black text-neutral-text-primary">Total</span>
                    <span class="font-black text-brand-primary"><%= display_amount(@quote.total_amount, quote_currency: @quote.currency, display_currency: @display_currency, hotel: @hotel) %></span>
                  </div>
                  <p class="text-[10px] text-neutral-text-secondary italic text-right leading-tight">All-in price including taxes and service charges.</p>
                </div>
              </div>
            </div>

            <div class="card p-5 bg-neutral-surface border-neutral-border">
              <h4 class="text-[10px] font-black text-neutral-text-secondary uppercase tracking-widest mb-3">Cancellation Policy</h4>
              <p class="text-xs text-neutral-text-secondary leading-relaxed">
                <%= @quote.cancellation_policy_snapshot || "Standard cancellation policy applies. Refund eligibility depends on your check-in date." %>
              </p>
            </div>
          </div>
        </aside>
      </div>
    <% end %>
  </div>
</div>

<script src="https://checkout.razorpay.com/v1/checkout.js"></script>
<script>
  (function() {
    const form = document.getElementById("payment-checkout-form");
    if (!form) return;

    const submitButton = form.querySelector("[data-checkout-submit]");
    const checkoutSessionUrl = form.dataset.checkoutSessionUrl;
    const paymentReady = form.dataset.paymentReady === "true";
    const paymentIdField = form.querySelector("[data-razorpay-payment-id]");
    const orderIdField = form.querySelector("[data-razorpay-order-id]");
    const signatureField = form.querySelector("[data-razorpay-signature]");

    if (!submitButton || !checkoutSessionUrl) return;

    let submittingToServer = false;

    form.addEventListener("submit", async function(event) {
      if (submittingToServer) return;
      if (!paymentReady) return;

      event.preventDefault();
      submitButton.disabled = true;
      const originalLabel = submitButton.value;
      submitButton.value = "Opening secure checkout...";

      const formData = new FormData(form);

      try {
        const response = await fetch(checkoutSessionUrl, {
          method: "POST",
          headers: {
            "X-CSRF-Token": document.querySelector("meta[name='csrf-token']").content
          },
          body: formData
        });

        let session = {};
        try {
          session = await response.json();
        } catch (_jsonError) {
          throw new Error("Unable to initialize payment right now. Please try again.");
        }
        if (!response.ok) throw new Error(session.error || "Unable to initialize checkout.");

        if (session.checkout_url) {
          window.location.href = session.checkout_url;
          return;
        }

        if (!session.key_id || !session.order_id) {
          throw new Error("Unsupported checkout session payload.");
        }
        if (!window.Razorpay) {
          throw new Error("Payment service is temporarily unavailable. Please refresh and try again.");
        }

        const options = {
          key: session.key_id,
          amount: session.amount,
          currency: session.currency,
          name: "<%= j @hotel.name %>",
          description: session.description,
          order_id: session.order_id,
          callback_url: session.callback_url,
          redirect: true,
          handler: function(paymentResponse) {
            paymentIdField.value = paymentResponse.razorpay_payment_id || "";
            orderIdField.value = paymentResponse.razorpay_order_id || "";
            signatureField.value = paymentResponse.razorpay_signature || "";
            submittingToServer = true;
            form.requestSubmit();
          },
          prefill: {
            name: form.querySelector("#name")?.value || "",
            email: form.querySelector("#email")?.value || "",
            contact: form.querySelector("#phone")?.value || ""
          },
          notes: {
            quote_token: formData.get("quote_token")
          },
          theme: {
            color: "#d32f2f"
          }
        };

        const razorpay = new window.Razorpay(options);
        razorpay.on("payment.failed", function() {
          submitButton.disabled = false;
          submitButton.value = originalLabel;
        });
        razorpay.open();
      } catch (error) {
        alert(error.message || "Unable to start payment. Please try again.");
        submitButton.disabled = false;
        submitButton.value = originalLabel;
      }
    });
  })();
</script>

<script>
  (function() {
    const expiryTime = new Date("<%= @quote.expires_at.iso8601 %>").getTime();
    const countdownElement = document.getElementById('countdown');

    const timer = setInterval(() => {
      const now = new Date().getTime();
      const distance = expiryTime - now;

      if (distance < 0) {
        clearInterval(timer);
        countdownElement.innerHTML = "Expired";
        window.location.reload();
        return;
      }

      const minutes = Math.floor((distance % (1000 * 60 * 60)) / (1000 * 60));
      const seconds = Math.floor((distance % (1000 * 60)) / 1000);

      countdownElement.innerHTML = minutes + "m " + seconds + "s";
    }, 1000);
  })();
</script>
