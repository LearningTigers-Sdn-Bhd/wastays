<%#
  The thread and the box to add to it. Shared by the desktop and mobile pages so
  the two cannot drift into saying different things about the same conversation.
%>
<%= render PublicUI::Chat::Panel.new do |panel| %>
  <% panel.with_log(messages: messages, hotel: hotel) %>

  <% unless hotel.ai_concierge_ready? %>
    <% panel.with_notice(text: "Your message goes straight to our front desk. Someone will reply here shortly.") %>
  <% end %>

  <% panel.with_composer(url: concierge_chat_messages_path(hotel)) %>
<% end %>
