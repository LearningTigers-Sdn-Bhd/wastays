<% content_for :title, "Chat | #{@hotel.name}" %>
<%= render layout: "public/concierge/shared/page_shell" do %>
  <%= render "public/concierge/shared/page_header",
             back_path: concierge_home_path(@hotel),
             back_label: "Back to Concierge",
             eyebrow: "Chat",
             title_prefix: "Ask us",
             title_accent: "anything",
             subtitle: "Rooms, rates, facilities — or anything else about your stay.",
             subtitle_class: "hidden sm:block" %>
  <%= render "public/concierge/shared/error_alert", message: flash[:alert] %>

  <%= render "public/concierge/chats/conversation", messages: @messages, hotel: @hotel %>
<% end %>
