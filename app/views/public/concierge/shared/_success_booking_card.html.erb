<div class="bg-white rounded-2xl border border-neutral-border shadow-sm p-4 sm:p-5 text-left mb-8">
  <p class="text-xs font-bold uppercase tracking-widest text-neutral-text-secondary mb-2">Booking</p>
  <p class="font-semibold text-neutral-text-primary"><%= booking.guest_name %></p>
  <p class="text-xs font-mono text-neutral-text-secondary"><%= booking.confirmation_token %></p>
  <% concierge_room_details(booking).each do |room_detail| %>
    <p class="text-xs text-neutral-text-secondary mt-1"><%= room_detail %></p>
  <% end %>
</div>
