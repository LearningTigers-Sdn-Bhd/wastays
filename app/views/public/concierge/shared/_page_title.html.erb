<%# One display title for both templates. Callers own the wording and the tag —
    it defaults to h2 because the shell's top bar already spends the page's h1
    on the hotel name. %>
<%# .presence rather than fetch's key-presence check: page_header always
    forwards a wrapper_class key now (nil when the caller didn't ask for one),
    and fetch would take that nil as "the caller wants no margin at all"
    instead of falling back to the default. %>
<div class="<%= local_assigns[:wrapper_class].presence || "mb-6 sm:mb-8" %>">
  <%= content_tag local_assigns.fetch(:tag, "h2"),
        class: "mb-2 font-guest-display text-2xl font-semibold leading-tight text-foreground sm:text-3xl" do %>
    <%= title_prefix %><% if local_assigns[:title_accent].present? %> <span class="text-primary sm:italic"><%= title_accent %></span><% end %>
  <% end %>

  <% if local_assigns[:subtitle].present? %>
    <p class="mt-3 text-[13px] font-medium leading-relaxed text-muted-foreground sm:mt-2 sm:text-sm sm:font-normal <%= local_assigns[:subtitle_class] %>">
      <%= subtitle %>
    </p>
  <% end %>
</div>
