<%# The property's own photograph, not a logo, is what tells a guest they are
    in the right place -- so this runs at the top of every concierge page, not
    only the home screen. It replaces the old slim text-only bar: at 160px on a
    phone and 20dvh on desktop it costs more height than that bar did, but the
    hotel's identity is now genuinely legible rather than a truncated 9px label.

    It carries the page's h1: the templates below it are all sections of one
    property's concierge, so their own headings stay h2. %>
<div class="relative h-[160px] w-full flex-shrink-0 overflow-hidden rounded-b-[2rem] bg-primary shadow-2xl shadow-primary/20 md:h-[20dvh]">
  <%= link_to concierge_home_path(@hotel), class: "absolute inset-0 z-0", "aria-label": "#{@hotel.name} concierge home" do %>
    <% if @hotel.featured_photo_attachment.present? %>
      <%= image_tag @hotel.featured_photo_attachment, class: "absolute inset-0 h-full w-full object-cover opacity-80" %>
    <% else %>
      <%= image_tag "landing/bg-1.webp", class: "absolute inset-0 h-full w-full object-cover opacity-90" %>
    <% end %>
  <% end %>

  <%# Two layers, not one: the flat wash guarantees the floor contrast and the
      gradient keeps the photograph from looking merely dimmed. %>
  <div class="pointer-events-none absolute inset-0 z-[1] bg-black/50"></div>
  <div class="pointer-events-none absolute inset-0 z-[2] bg-gradient-to-t from-black/80 via-transparent to-black/40"></div>

  <div class="pointer-events-none relative z-10 mx-auto flex h-full max-w-5xl flex-col justify-end px-6 pb-4 md:px-10 md:pb-5">
    <div class="space-y-0.5">
      <h1 class="font-serif text-[29px] leading-tight text-white [text-shadow:0_2px_10px_rgba(0,0,0,0.8)] md:text-4xl">
        <%= @hotel.name %>
      </h1>
      <p class="text-[11px] font-bold uppercase tracking-[0.2em] text-accent opacity-90 md:text-[12px]">
        <%= concierge_location_label(@hotel) %>
      </p>
    </div>
  </div>
</div>
