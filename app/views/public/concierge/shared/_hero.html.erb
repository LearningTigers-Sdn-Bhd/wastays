<%# The property's own photograph, not a logo, is what tells a guest they are
    in the right place -- so this runs at the top of every concierge page, not
    only the home screen.

    It carries the page's h1: the templates below it are all sections of one
    property's concierge, so their own headings stay h2. %>
<%# It sticks like a navbar. The hero scrolls up until only its bottom strip is
    left, and that strip pins. The hero never changes height, so the page under
    it never jumps. concierge-hero marks the pinned state with data-compact, and
    the hotel name drops from three lines to one. %>
<%
  hero_photo = if @hotel.featured_photo_attachment.present?
    image_tag(@hotel.featured_photo_attachment, alt: "", class: "absolute inset-0 h-full w-full object-cover opacity-80")
  else
    image_tag("landing/bg-1.webp", alt: "", class: "absolute inset-0 h-full w-full object-cover opacity-90")
  end
%>
<div class="guest-hero" data-controller="concierge-hero">
  <div class="guest-hero__sentinel" data-concierge-hero-target="sentinel" aria-hidden="true"></div>

  <%= hero_photo %>

  <%# Two layers, not one: the flat wash guarantees the floor contrast and the
      gradient keeps the photograph from looking merely dimmed. %>
  <div class="pointer-events-none absolute inset-0 z-[1] bg-black/50"></div>
  <div class="pointer-events-none absolute inset-0 z-[2] bg-gradient-to-t from-black/80 via-transparent to-black/40"></div>

  <div class="guest-hero__content">
    <div>
      <h1 class="guest-hero__name font-guest-display"><%= @hotel.name %></h1>
      <p class="guest-hero__location"><%= concierge_location_label(@hotel) %></p>
    </div>
  </div>
</div>
