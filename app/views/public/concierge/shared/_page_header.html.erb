<%= render "public/concierge/shared/back_button",
           back_path: back_path,
           back_label: back_label,
           back_label_short: local_assigns.fetch(:back_label_short, "Back") %>

<%# The eyebrow rule is desktop chrome: on a phone it costs a line of height and
    repeats what the heading already says. %>
<div class="hidden md:flex items-center gap-x-3 mb-8">
  <span class="w-6 h-px bg-primary/30"></span>
  <span class="text-[10px] font-bold uppercase tracking-[0.3em] text-primary"><%= eyebrow %></span>
  <span class="flex-1 h-px bg-border<%= local_assigns[:divider_suffix] %>"></span>
</div>

<%= render "public/concierge/shared/page_title",
           title_prefix: title_prefix,
           title_accent: local_assigns[:title_accent],
           subtitle: local_assigns[:subtitle],
           subtitle_class: local_assigns[:subtitle_class] %>
