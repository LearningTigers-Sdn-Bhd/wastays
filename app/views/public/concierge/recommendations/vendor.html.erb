<% content_for :title, "#{@vendor.name} | #{@hotel.name}" %>
<%= render layout: "public/concierge/shared/page_shell",
           locals: { content_class: "flex-1 px-4 pt-8 pb-16 sm:px-6 md:pt-12",
                     container_class: "w-full max-w-5xl" } do %>
  <%= render "public/concierge/shared/back_button",
             back_path: concierge_recommendations_path(@hotel, category: @vendor.category_slug),
             back_label: "Back to #{VendorDirectory.category(@vendor.category_slug)&.name || 'Recommendations'}",
             wrapper_class: desktop_only_back_class %>

  <%# Hero. No vendor photography exists yet, so the accent wash plus the
      category mark carries the identity instead of a grey placeholder box. %>
  <div class="relative overflow-hidden rounded-2xl bg-gradient-to-br p-6 text-white shadow-lg <%= vendor_accent(@vendor, :wash) %>">
    <%= cached_icon category_icon_for(@vendor.category_slug),
          class: "pointer-events-none absolute -right-6 -top-6 h-40 w-40 opacity-10" %>

    <div class="relative">
      <span class="inline-flex items-center rounded-full bg-white/20 px-2.5 py-1 text-[11px] font-black uppercase tracking-wider backdrop-blur-sm">
        <%= VendorDirectory.category(@vendor.category_slug)&.name %>
      </span>
      <h2 class="mt-4 text-2xl font-black leading-tight sm:font-serif sm:text-3xl sm:font-normal"><%= @vendor.name %></h2>
      <p class="mt-2 text-[14px] font-medium leading-relaxed text-white/85"><%= @vendor.tagline %></p>

      <div class="mt-5 flex flex-wrap items-center gap-x-4 gap-y-2 border-t border-white/20 pt-4 text-[12px] font-bold">
        <% if @vendor.distance_label.present? %>
          <span class="inline-flex items-center gap-1.5">
            <%= cached_icon "map-pin", class: "h-3.5 w-3.5 text-white/70" %><%= vendor_distance_summary(@vendor) %>
          </span>
        <% end %>
        <% if @vendor.price_range.present? %>
          <span class="inline-flex items-center gap-1.5">
            <%= cached_icon "wallet", class: "h-3.5 w-3.5 text-white/70" %><%= @vendor.price_range %>
          </span>
        <% end %>
      </div>
    </div>
  </div>

  <% if @vendor.summary.present? %>
    <p class="mt-6 text-[14px] font-medium leading-relaxed text-muted-foreground"><%= @vendor.summary %></p>
  <% end %>

  <% if @vendor.tags.any? %>
    <div class="mt-4 flex flex-wrap gap-2">
      <% @vendor.tags.each do |tag| %>
        <span class="rounded-full border border-border/60 bg-white px-2.5 py-1 text-[11px] font-black uppercase tracking-wider text-muted-foreground"><%= tag %></span>
      <% end %>
    </div>
  <% end %>

  <%# Getting there gets the full width -- the address is the longest line here
      and the one a guest reads standing in the lobby. The phone number and the
      hours then share a row: they are both quick lookups, and stacking them made
      the offers below sit a screen further down. %>
  <%= link_to @vendor.google_maps_url, target: "_blank", rel: "noopener noreferrer",
        class: "group mt-6 flex items-center gap-4 rounded-2xl border border-border/60 bg-white p-4 shadow-sm transition-all hover:shadow-md active:scale-[0.98]" do %>
    <div class="flex h-11 w-11 flex-shrink-0 items-center justify-center rounded-xl bg-primary/5 text-primary transition-colors group-hover:bg-primary group-hover:text-white">
      <%= cached_icon "navigation", class: "h-5 w-5" %>
    </div>
    <div class="min-w-0">
      <p class="text-[11px] font-black uppercase tracking-[0.15em] text-muted-foreground">Get directions</p>
      <p class="mt-0.5 line-clamp-2 text-[13px] font-bold leading-snug text-foreground"><%= @vendor.address %></p>
    </div>
  <% end %>

  <div class="mt-3 grid items-start gap-3 sm:grid-cols-2">
    <% if @vendor.phone.present? %>
      <%= link_to "tel:#{@vendor.phone.gsub(/\s/, '')}",
            class: "group flex items-center gap-4 rounded-2xl border border-border/60 bg-white p-4 shadow-sm transition-all hover:shadow-md active:scale-[0.98]" do %>
        <div class="flex h-11 w-11 flex-shrink-0 items-center justify-center rounded-xl bg-primary/5 text-primary transition-colors group-hover:bg-primary group-hover:text-white">
          <%= cached_icon "phone", class: "h-5 w-5" %>
        </div>
        <div class="min-w-0">
          <p class="text-[11px] font-black uppercase tracking-[0.15em] text-muted-foreground">Call ahead</p>
          <p class="mt-0.5 text-[13px] font-bold text-foreground"><%= @vendor.phone %></p>
        </div>
      <% end %>
    <% end %>

    <% if @vendor.hours.any? %>
      <div class="rounded-2xl border border-border/60 bg-white p-4 shadow-sm">
        <p class="mb-2.5 flex items-center gap-2 border-b border-border/40 pb-2.5 text-[11px] font-black uppercase tracking-[0.2em] text-muted-foreground">
          <%= cached_icon "clock", class: "h-3.5 w-3.5" %> Opening hours
        </p>
        <dl class="space-y-1.5">
          <% @vendor.hours.each do |slot| %>
            <div class="flex items-baseline justify-between gap-4">
              <dt class="text-[13px] font-bold text-foreground"><%= slot.days %></dt>
              <dd class="text-[13px] font-medium <%= slot.closed? ? 'text-muted-foreground' : 'text-foreground' %>"><%= slot.label %></dd>
            </div>
          <% end %>
        </dl>
      </div>
    <% end %>
  </div>

  <section class="mt-8">
    <div class="mb-4 flex items-center gap-2">
      <%= cached_icon "ticket", class: "h-4 w-4 text-primary" %>
      <h3 class="text-[12px] font-black uppercase tracking-[0.2em] text-foreground">Guest offers</h3>
    </div>

    <% if @vendor.offers? %>
      <div class="grid gap-3 sm:grid-cols-2">
        <% @vendor.offers.each do |offer| %>
          <%= render "public/concierge/recommendations/offer_card", vendor: @vendor, offer: offer %>
        <% end %>
      </div>
    <% else %>
      <div class="rounded-2xl border border-dashed border-border bg-white/60 p-8 text-center">
        <p class="text-sm font-bold text-foreground">No offers right now</p>
        <p class="mt-1.5 text-[13px] font-medium leading-relaxed text-muted-foreground">
          We list <%= @vendor.name %> because it is worth your time, voucher or not. Check back later in your stay.
        </p>
      </div>
    <% end %>
  </section>
<% end %>
