<% content_for :title, "#{@offer.title} | #{@vendor.name}" %>
<%= render layout: "public/concierge/shared/page_shell",
           locals: { content_class: "flex-1 px-4 pt-8 pb-16 sm:px-6 md:pt-12",
                     container_class: "w-full max-w-2xl" } do %>
  <%= render "public/concierge/shared/back_button",
             back_path: concierge_recommendation_vendor_path(@hotel.unique_id, @hotel.public_id, @vendor),
             back_label: "Back to #{@vendor.name}",
             wrapper_class: desktop_only_back_class %>

  <div class="rounded-2xl bg-gradient-to-br p-6 text-center text-white shadow-lg <%= vendor_accent(@vendor, :wash) %>">
    <p class="text-[11px] font-black uppercase tracking-[0.25em] text-white/70"><%= @vendor.name %></p>
    <p class="mt-4 text-4xl font-black leading-none"><%= @offer.value_label %></p>
    <h2 class="mt-4 text-lg font-black leading-tight"><%= @offer.title %></h2>
    <p class="mt-1.5 text-[13px] font-medium leading-relaxed text-white/80"><%= @offer.subtitle %></p>
  </div>

  <% if @entry.present? %>
    <%= render "public/concierge/recommendations/voucher_qr", vendor: @vendor, offer: @offer, entry: @entry %>
  <% else %>
    <div class="mt-6 rounded-2xl border border-border/60 bg-white p-6 shadow-sm">
      <p class="text-[14px] font-medium leading-relaxed text-muted-foreground">
        Claim this voucher to get your own QR code. Show it to staff at <%= @vendor.name %> when you order —
        the code is issued to you and can only be used once.
      </p>

      <%= button_to concierge_claim_recommendation_offer_path(@hotel.unique_id, @hotel.public_id, @vendor, @offer),
            class: "mt-5 flex w-full items-center justify-center gap-2 rounded-xl bg-primary px-6 py-4 text-[13px] font-black uppercase tracking-widest text-primary-foreground shadow-md transition-all hover:bg-primary-hover active:scale-[0.98]" do %>
        <%= cached_icon "ticket", class: "h-4 w-4" %> Claim this voucher
      <% end %>

      <%# The same test the claim gate runs. It used to read the booking cookie
          only, so a guest who had already verified their stay was warned they
          would be asked for a code they will not be asked for. %>
      <% if concierge_guest_booking.blank? %>
        <p class="mt-3 flex items-start gap-1.5 text-[12px] font-medium leading-relaxed text-muted-foreground">
          <%= cached_icon "lock", class: "mt-px h-3.5 w-3.5 flex-shrink-0" %>
          We will ask for your booking confirmation code first — vouchers are for guests staying with us.
        </p>
      <% end %>
    </div>
  <% end %>

  <div class="mt-4 rounded-2xl border border-border/60 bg-white p-5 shadow-sm">
    <p class="mb-3 border-b border-border/40 pb-3 text-[11px] font-black uppercase tracking-[0.2em] text-muted-foreground">Terms</p>
    <ul class="space-y-2">
      <% @offer.terms.each do |term| %>
        <li class="flex items-start gap-2.5 text-[13px] font-medium leading-relaxed text-muted-foreground">
          <%= cached_icon "circle-check", class: "mt-px h-3.5 w-3.5 flex-shrink-0 text-primary/60" %>
          <span><%= term %></span>
        </li>
      <% end %>
      <% if offer_expiry_label(@offer).present? %>
        <li class="flex items-start gap-2.5 text-[13px] font-medium leading-relaxed text-muted-foreground">
          <%= cached_icon "clock", class: "mt-px h-3.5 w-3.5 flex-shrink-0 text-primary/60" %>
          <span><%= offer_expiry_label(@offer) %></span>
        </li>
      <% end %>
    </ul>
  </div>

  <%= link_to concierge_recommendation_vendor_path(@hotel.unique_id, @hotel.public_id, @vendor),
        class: "group mt-3 flex items-center gap-4 rounded-2xl border border-border/60 bg-white p-4 shadow-sm transition-all hover:shadow-md active:scale-[0.98]" do %>
    <div class="flex h-11 w-11 flex-shrink-0 items-center justify-center rounded-xl <%= vendor_accent(@vendor, :chip) %>">
      <%= cached_icon category_icon_for(@vendor.category_slug), class: "h-5 w-5" %>
    </div>
    <div class="min-w-0 flex-1">
      <p class="text-[11px] font-black uppercase tracking-[0.15em] text-muted-foreground">Where to use it</p>
      <p class="mt-0.5 truncate text-[13px] font-bold text-foreground"><%= @vendor.name %></p>
      <p class="mt-0.5 text-[12px] font-medium text-muted-foreground"><%= vendor_distance_summary(@vendor) %></p>
    </div>
    <%= cached_icon "chevron-right", stroke_width: 2.5, class: "h-4 w-4 flex-shrink-0 text-muted-foreground transition-transform group-hover:translate-x-0.5" %>
  <% end %>
<% end %>
