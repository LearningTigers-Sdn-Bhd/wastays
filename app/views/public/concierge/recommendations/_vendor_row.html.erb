<%# List mode: one to a row, the default -- room for the photo, dietary status,
    the tagline, a line of the description, distance and price, not only the
    name. Horizontal from sm up so the photo doesn't eat the row's height
    budget on a wider screen; stacked on a phone, where width is scarce. %>
<%= link_to concierge_recommendation_vendor_path(@hotel.unique_id, @hotel.public_id, vendor),
      data: { turbo_frame: "_top", concierge_dietary_filter_target: "item", dietary: vendor.dietary_tags.first.to_s },
      class: "group flex flex-col overflow-hidden rounded-2xl border border-border/60 bg-white shadow-sm transition-all hover:shadow-md active:scale-[0.99] sm:flex-row" do %>
  <div class="relative h-36 w-full flex-shrink-0 overflow-hidden bg-muted sm:h-auto sm:w-56">
    <%# Temporary stock photography -- see VendorDirectory::MockAdapter -- with
        the WAStays wash so the placeholder still reads as branded rather
        than a bare stock shot. %>
    <%= image_tag vendor.photo_url, alt: "", loading: "lazy",
          class: "absolute inset-0 h-full w-full object-cover" %>
    <div class="absolute inset-0 bg-gradient-to-br opacity-35 mix-blend-multiply <%= vendor_accent(vendor, :wash) %>"></div>
  </div>

  <div class="flex flex-1 flex-col p-4 sm:p-5">
    <div class="flex flex-wrap items-start justify-between gap-x-3 gap-y-1">
      <p class="text-[15px] font-black leading-tight text-foreground sm:text-base"><%= vendor.name %></p>
      <%# Having nothing to claim isn't worth a badge of its own -- only say
          something here when there is actually an offer to mention. %>
      <% if vendor.offers? %>
        <span class="flex-shrink-0 rounded-full px-2.5 py-1 text-[10px] font-black uppercase tracking-wider <%= vendor_accent(vendor, :chip) %>">
          <%= vendor.offer_count_label %>
        </span>
      <% end %>
    </div>

    <% if vendor.dietary_tags? %>
      <div class="mt-1.5">
        <%= render "public/concierge/recommendations/dietary_tags", vendor: vendor %>
      </div>
    <% end %>

    <p class="mt-1.5 text-[12px] font-medium leading-snug text-muted-foreground"><%= vendor.tagline %></p>

    <p class="mt-2 line-clamp-2 text-[12.5px] font-medium leading-relaxed text-muted-foreground/90">
      <%= vendor.summary %>
    </p>

    <div class="mt-3 flex flex-wrap items-center gap-x-3 gap-y-1.5">
      <% if vendor.distance_label.present? %>
        <p class="flex items-center gap-1 text-[11px] font-bold text-muted-foreground">
          <%= cached_icon "map-pin", class: "h-3 w-3 flex-shrink-0" %>
          <%= vendor_distance_summary(vendor) %>
        </p>
      <% end %>
      <% if vendor_open_now_label(vendor).present? %>
        <span class="flex items-center gap-1 text-[11px] font-bold <%= vendor_open_now_class(vendor) %>">
          <span class="h-1.5 w-1.5 flex-shrink-0 rounded-full bg-current"></span><%= vendor_open_now_label(vendor) %>
        </span>
      <% end %>
    </div>
  </div>
<% end %>
