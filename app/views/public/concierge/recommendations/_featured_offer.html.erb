<% vendor = offer.vendor_id == local_assigns[:vendor]&.id ? local_assigns[:vendor] : VendorDirectory.vendor(offer.vendor_id) %>
<%# A jeweller's placard, not a coupon: a clean white ground against the
    page's cream, the vendor's own pastel as a hairline border -- just enough
    colour to tell the cards apart at a glance -- and the value set in serif
    italic gold rather than a loud pill. Fills its grid cell rather than
    carrying a fixed width, since it now sits in a still 3-column row instead
    of a scrolling rail. %>
<%= link_to concierge_recommendation_offer_path(@hotel, vendor, offer),
      data: { turbo_frame: "_top" },
      class: "group flex min-w-0 flex-col rounded-xl border-2 bg-white p-2.5 shadow-sm transition-all hover:shadow-md active:scale-[0.97] sm:p-3.5 #{vendor_accent(vendor, :border)}" do %>
  <div class="flex items-center justify-between gap-1.5">
    <%= cached_icon category_icon_for(vendor.category_slug), class: "h-3.5 w-3.5 text-foreground/40" %>
    <% if offer.scarce? %>
      <span class="whitespace-nowrap text-[9px] font-bold uppercase tracking-wider text-rose-600"><%= offer.remaining %> left</span>
    <% end %>
  </div>

  <p class="mt-2.5 truncate font-serif text-lg italic leading-none text-accent-foreground"><%= offer.value_label %></p>

  <p class="mt-2 line-clamp-2 text-[12px] font-black leading-tight text-foreground"><%= offer.title %></p>

  <div class="mt-auto pt-2.5">
    <div class="mb-1.5 h-px w-4 bg-accent-foreground/50"></div>
    <p class="truncate text-[9px] font-bold uppercase tracking-wider text-muted-foreground"><%= vendor.name %></p>
  </div>
<% end %>
