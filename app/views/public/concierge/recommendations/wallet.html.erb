<% content_for :title, "My Vouchers | #{@hotel.name}" %>
<%= render layout: "public/concierge/shared/page_shell",
           locals: { content_class: "flex-1 px-4 pt-8 pb-16 sm:px-6 md:pt-12",
                     container_class: "w-full max-w-5xl" } do %>
  <%= render "public/concierge/shared/page_header",
             back_path: concierge_recommendations_path(@hotel.unique_id, @hotel.public_id),
             back_label: "Back to Recommendations",
             back_wrapper_class: desktop_only_back_class,
             eyebrow: "My Vouchers",
             title_prefix: "Your",
             title_accent: "Wallet",
             subtitle: "Vouchers you have claimed during this stay. Open one to show its QR code." %>

  <% if @entries.any? %>
    <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
      <% @entries.each do |entry| %>
        <% vendor = entry.vendor %>
        <%= link_to concierge_recommendation_offer_path(@hotel.unique_id, @hotel.public_id, vendor, entry.offer),
              class: "group flex items-center gap-4 rounded-2xl border border-border/60 bg-white p-4 shadow-sm transition-all hover:shadow-md active:scale-[0.98]" do %>
          <div class="flex h-12 w-12 flex-shrink-0 items-center justify-center rounded-xl bg-gradient-to-br text-white <%= vendor_accent(vendor, :wash) %>">
            <%= cached_icon "qr-code", class: "h-5 w-5" %>
          </div>
          <div class="min-w-0 flex-1">
            <p class="truncate text-sm font-black leading-tight text-foreground"><%= entry.offer.title %></p>
            <p class="mt-1 truncate text-[12px] font-medium text-muted-foreground"><%= vendor.name %></p>
            <p class="mt-1.5 font-mono text-[12px] font-bold tracking-wider text-primary"><%= entry.code %></p>
          </div>
          <%= cached_icon "chevron-right", stroke_width: 2.5, class: "h-4 w-4 flex-shrink-0 text-muted-foreground transition-transform group-hover:translate-x-0.5" %>
        <% end %>
      <% end %>
    </div>
  <% else %>
    <div class="rounded-2xl border border-dashed border-border bg-white/60 p-10 text-center">
      <div class="mx-auto mb-4 flex h-14 w-14 items-center justify-center rounded-2xl bg-primary/5 text-primary">
        <%= cached_icon "ticket", class: "h-6 w-6" %>
      </div>
      <p class="text-sm font-bold text-foreground">No vouchers yet</p>
      <p class="mx-auto mt-1.5 max-w-xs text-[13px] font-medium leading-relaxed text-muted-foreground">
        Browse the partners around the hotel and claim anything that takes your fancy.
      </p>
      <%= link_to concierge_recommendations_path(@hotel.unique_id, @hotel.public_id),
            class: "mt-5 inline-flex items-center gap-2 rounded-xl bg-primary px-5 py-3 text-[12px] font-black uppercase tracking-widest text-primary-foreground shadow-sm transition-all active:scale-95" do %>
        <%= cached_icon "store", class: "h-4 w-4" %> Browse recommendations
      <% end %>
    </div>
  <% end %>
<% end %>
