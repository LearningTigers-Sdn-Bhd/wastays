<%# The QR is the whole point of the screen once claimed, so it gets the light
    card and the full width -- vendor staff scan this across a counter, often in
    bad light. The code underneath is the fallback for vendors with no scanner. %>
<div class="mt-6 rounded-2xl border border-primary/30 bg-white p-6 shadow-md">
  <div class="mb-5 flex items-center justify-center gap-2">
    <%= cached_icon "circle-check", class: "h-4 w-4 text-primary" %>
    <p class="text-[12px] font-black uppercase tracking-[0.2em] text-primary">Claimed &amp; ready</p>
  </div>

  <div class="mx-auto aspect-square w-full max-w-[240px] rounded-xl border border-border/60 bg-white p-3">
    <%= image_tag voucher_qr_data_url(entry), alt: "QR code for #{offer.title} at #{vendor.name}", class: "h-full w-full" %>
  </div>

  <div class="mt-5 text-center">
    <p class="text-[11px] font-black uppercase tracking-[0.2em] text-muted-foreground">Voucher code</p>
    <p class="mt-1.5 font-mono text-lg font-bold tracking-wider text-foreground"><%= entry.code %></p>
    <p class="mt-3 text-[12px] font-medium leading-relaxed text-muted-foreground">
      Show this screen to staff at <%= vendor.name %>.
    </p>
  </div>
</div>
