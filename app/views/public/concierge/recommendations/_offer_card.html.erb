<% claimed = voucher_wallet&.claimed?(offer) %>
<%= link_to concierge_recommendation_offer_path(@hotel.unique_id, @hotel.public_id, vendor, offer),
      class: "group flex items-start gap-3 rounded-xl border bg-white p-3 shadow-sm transition-all hover:shadow-md active:scale-[0.98] #{claimed ? 'border-primary/40' : 'border-border/60'}" do %>
  <div class="flex h-10 w-10 flex-shrink-0 items-center justify-center rounded-lg <%= vendor_accent(vendor, :chip) %>">
    <%= cached_icon(offer.kind == "free_item" ? "gift" : "badge-percent", class: "h-4 w-4") %>
  </div>

  <div class="min-w-0 flex-1">
    <div class="flex flex-wrap items-center gap-1.5">
      <span class="rounded-full px-1.5 py-0.5 text-[10px] font-black uppercase tracking-wider <%= vendor_accent(vendor, :badge) %>"><%= offer.value_label %></span>
      <% if claimed %>
        <span class="inline-flex items-center gap-1 rounded-full bg-primary/10 px-1.5 py-0.5 text-[10px] font-black uppercase tracking-wider text-primary">
          <%= cached_icon "check", stroke_width: 3, class: "h-2.5 w-2.5" %> Claimed
        </span>
      <% elsif offer.scarce? %>
        <span class="text-[10px] font-black uppercase tracking-wider text-amber-600">Only <%= offer.remaining %> left</span>
      <% end %>
    </div>

    <p class="mt-1.5 text-[13px] font-black leading-tight text-foreground"><%= offer.title %></p>
    <p class="mt-0.5 text-[11px] font-medium leading-snug text-muted-foreground"><%= offer.subtitle %></p>
    <% if offer_expiry_label(offer).present? %>
      <p class="mt-1.5 text-[10px] font-bold uppercase tracking-wider text-muted-foreground"><%= offer_expiry_label(offer) %></p>
    <% end %>
  </div>

  <%= cached_icon "chevron-right", stroke_width: 2.5,
        class: "mt-1 h-3.5 w-3.5 flex-shrink-0 text-muted-foreground transition-transform group-hover:translate-x-0.5" %>
<% end %>
