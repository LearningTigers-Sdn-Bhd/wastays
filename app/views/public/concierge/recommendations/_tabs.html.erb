<%# Plain links everywhere now, same as desktop always was -- no modal, no
    sheet, nothing to open. Below lg the categories are a horizontally
    scrolling row of tiles (icon over label, so a tall narrow tile uses the
    vertical room a phone actually has to spare) starting from Food & Drink;
    above lg they wrap into the pill row instead, since a wide screen has
    the width to show all of them without scrolling either way. %>
<div class="mb-6">
  <div class="-mx-4 overflow-x-auto px-4 pb-1 lg:hidden [scrollbar-width:none] [&::-webkit-scrollbar]:hidden">
    <div class="flex w-max gap-2">
      <% categories.each do |tab| %>
        <% active = tab.slug == category.slug %>
        <%= link_to concierge_recommendations_path(@hotel, category: tab.slug),
              data: { turbo_frame: "category_content" },
              "aria-current": (active ? "page" : nil),
              class: "flex w-[72px] flex-shrink-0 flex-col items-center gap-1.5 rounded-2xl border px-2 py-3 text-center transition-all active:scale-95 #{active ? 'border-primary bg-primary text-primary-foreground shadow-sm' : 'border-border/60 bg-white text-muted-foreground hover:border-primary/40'}" do %>
          <%= cached_icon tab.icon, class: "h-5 w-5 flex-shrink-0" %>
          <span class="text-[10px] font-black uppercase leading-tight tracking-wide"><%= tab.name %></span>
        <% end %>
      <% end %>
    </div>
  </div>

  <%# Scoped to the category_content frame this partial itself renders inside
      of: clicking a pill swaps that frame in place -- new vendors, new active
      pill -- rather than doing a full Turbo Drive visit that replaces the
      entire page (hero photo included) for what is, underneath, one query
      param changing. data-turbo-action="advance" on the frame still keeps the
      URL and back button working normally. %>
  <div class="hidden lg:flex lg:flex-wrap lg:gap-2">
    <% categories.each do |tab| %>
      <% active = tab.slug == category.slug %>
      <%= link_to concierge_recommendations_path(@hotel, category: tab.slug),
            data: { turbo_frame: "category_content" },
            "aria-current": (active ? "page" : nil),
            class: "group inline-flex items-center gap-2 whitespace-nowrap rounded-full border px-4 py-2.5 text-[12px] font-black uppercase tracking-wider transition-all active:scale-95 #{active ? 'border-primary bg-primary text-primary-foreground shadow-sm' : 'border-border/60 bg-white text-muted-foreground hover:border-primary/40 hover:text-primary'}" do %>
        <%= cached_icon tab.icon, class: "h-4 w-4" %>
        <%= tab.name %>
      <% end %>
    <% end %>
  </div>
</div>
