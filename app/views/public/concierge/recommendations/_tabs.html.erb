<%# Below lg the categories are a native select. The list is superadmin-managed
    and free to grow, and a horizontally scrolling pill row hides whatever does
    not fit behind a gesture guests have no reason to know is there. The OS
    picker shows every category in one tap. Above lg the pills wrap onto a
    second line rather than scrolling, so nothing is hidden there either. %>
<div class="mb-6">
  <%= form_with url: concierge_recommendations_path(@hotel), method: :get,
        data: { controller: "auto-submit", turbo_action: "advance" },
        class: "lg:hidden" do |form| %>
    <%= form.label :category, "Category", class: "sr-only" %>

    <div class="relative">
      <span class="pointer-events-none absolute inset-y-0 left-0 flex items-center pl-4 text-primary">
        <%= cached_icon category.icon, class: "h-4 w-4" %>
      </span>

      <%= form.select :category,
            options_for_select(categories.map { |tab| [ tab.name, tab.slug ] }, category.slug),
            {},
            data: { action: "change->auto-submit#submitNow" },
            class: "w-full appearance-none rounded-xl border border-border bg-white py-4 pl-11 pr-11 text-[12px] font-black uppercase tracking-wider text-foreground focus:border-primary focus:outline-none focus:ring-2 focus:ring-primary/20" %>

      <span class="pointer-events-none absolute inset-y-0 right-0 flex items-center pr-4 text-muted-foreground">
        <%= cached_icon "chevron-down", stroke_width: 2.5, class: "h-4 w-4" %>
      </span>
    </div>

    <%# The select cannot submit itself without Stimulus, so give it a button. %>
    <noscript>
      <%= form.submit "Show", class: "mt-2 w-full rounded-xl bg-primary px-4 py-3 text-[11px] font-black uppercase tracking-widest text-primary-foreground" %>
    </noscript>
  <% end %>

  <div class="hidden lg:flex lg:flex-wrap lg:gap-2">
    <% categories.each do |tab| %>
      <% active = tab.slug == category.slug %>
      <%= link_to concierge_recommendations_path(@hotel, category: tab.slug),
            data: { turbo_action: "advance" },
            "aria-current": (active ? "page" : nil),
            class: "group inline-flex items-center gap-2 whitespace-nowrap rounded-full border px-4 py-2.5 text-[11px] font-black uppercase tracking-wider transition-all active:scale-95 #{active ? 'border-primary bg-primary text-primary-foreground shadow-sm' : 'border-border/60 bg-white text-muted-foreground hover:border-primary/40 hover:text-primary'}" do %>
        <%= cached_icon tab.icon, class: "h-4 w-4" %>
        <%= tab.name %>
      <% end %>
    <% end %>
  </div>
</div>
