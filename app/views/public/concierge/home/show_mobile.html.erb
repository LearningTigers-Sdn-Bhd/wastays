<% content_for :title, "#{@hotel.name} | Concierge" %>

<div data-mobile-view class="min-h-screen bg-background flex flex-col font-sans overflow-x-hidden">

  <%# Premium Hero Section with Darker Overlay for Readability %>
  <div class="relative w-full h-[320px] bg-primary overflow-hidden rounded-b-[3.5rem] shadow-2xl shadow-primary/20">
    <%# Use Hotel Featured Photo if present, otherwise use the landing page background %>
    <% if @hotel.featured_photo_attachment.present? %>
      <%= image_tag @hotel.featured_photo_attachment, class: "absolute inset-0 w-full h-full object-cover opacity-80" %>
    <% else %>
      <%= image_tag "landing/bg-1.webp", class: "absolute inset-0 w-full h-full object-cover opacity-90" %>
    <% end %>
    
    <%# Enhanced Dark Overlay for Text Clarity %>
    <div class="absolute inset-0 bg-black/50 z-[1]"></div>
    <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-transparent to-black/40 z-[2]"></div>

    <div class="relative z-10 h-full flex flex-col justify-end px-8 pb-12">
      <%# Badge Styled like Landing Page %>
      <div class="inline-flex self-start items-center gap-x-2 bg-accent px-3 py-1 rounded-md mb-5 shadow-lg shadow-black/30">
        <span class="text-[9px] font-black uppercase tracking-[0.25em] text-accent-foreground">Digital Concierge</span>
      </div>

      <div class="space-y-1">
        <p class="text-white/80 text-xs font-medium tracking-wide">Welcome to</p>
        <h1 class="text-4xl font-serif text-white leading-tight [text-shadow:0_2px_10px_rgba(0,0,0,0.8)]">
          <%= @hotel.name %>
        </h1>
        <p class="text-accent text-[11px] font-bold uppercase tracking-[0.2em] pt-1 opacity-90"><%= @hotel.city %>, <%= @hotel.country %></p>
      </div>
    </div>
  </div>

  <%# Greeting Section %>
  <div class="px-8 pt-8 pb-6">
    <h2 class="text-2xl font-serif text-foreground">
      Hello, <span class="italic text-primary">Guest</span>
    </h2>
    <p class="text-xs text-muted-foreground mt-1.5 leading-relaxed font-medium">How can we assist you today?</p>
  </div>

  <%# Action Cards Grid %>
  <div class="px-6 pb-12 space-y-4">
    
    <%# Primary Check-In Card (Full Row, Green) %>
    <%= link_to concierge_check_in_path(@hotel),
          class: "group relative flex items-center justify-between min-h-[120px] bg-primary rounded-[2rem] p-6 shadow-xl shadow-primary/20 overflow-hidden border border-white/5 active:scale-[0.98] transition-all duration-300" do %>
      <div class="relative z-10 flex items-center gap-x-5">
        <div class="w-14 h-14 rounded-2xl bg-white/10 border border-white/20 flex items-center justify-center flex-shrink-0">
          <svg class="w-7 h-7 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 16l-4-4m0 0l4-4m-4 4h14m-5 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h7a3 3 0 013 3v1"/>
          </svg>
        </div>
        <div>
          <p class="font-black text-sm uppercase tracking-[0.15em] text-white">Check In</p>
          <p class="text-[11px] text-white/60 mt-1 font-medium leading-tight">Register your arrival now</p>
        </div>
      </div>
      <div class="relative z-10 w-10 h-10 rounded-full bg-white/10 border border-white/10 flex items-center justify-center flex-shrink-0">
        <svg class="w-4 h-4 text-white/40" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7"/>
        </svg>
      </div>
    <% end %>

    <%# 2x2 Grid for Remaining Actions %>
    <div class="grid grid-cols-2 gap-4">
      <% [
        { path: concierge_check_out_path(@hotel), label: "Check Out", description: "Notify desk",
          icon_svg: '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"/>' },
        { path: concierge_book_path(@hotel), label: "Booking", description: "View rooms",
          icon_svg: '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>' },
        { path: concierge_new_request_path(@hotel), label: "Request", description: "Housekeeping",
          icon_svg: '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M7 8h10M7 12h4m1 8l-4-4H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-3l-4 4z"/>' },
        { path: concierge_contact_path(@hotel), label: "Contact Us", description: "Get help",
          icon_svg: '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>' }
      ].each do |tile| %>
        <%= link_to tile[:path],
              class: "group flex flex-col min-h-[140px] bg-white rounded-[2rem] p-5 border border-border/60 shadow-sm active:scale-95 transition-all duration-300" do %>
          <div class="w-10 h-10 rounded-xl bg-primary/5 border border-primary/10 flex items-center justify-center mb-4 group-active:bg-primary group-active:text-white transition-colors duration-200">
            <svg class="w-5 h-5 text-primary transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <%= tile[:icon_svg].html_safe %>
            </svg>
          </div>
          <p class="font-black text-[12px] uppercase tracking-wider text-foreground leading-tight"><%= tile[:label] %></p>
          <p class="text-[10px] text-muted-foreground mt-1.5 leading-relaxed font-medium"><%= tile[:description] %></p>
        <% end %>
      <% end %>
    </div>
  </div>

  <%# Footer %>
  <div class="px-4 pb-10 text-center mt-auto">
    <div class="w-12 h-px bg-border mx-auto mb-6"></div>
    <p class="text-[9px] text-muted-foreground font-black uppercase tracking-[0.25em] opacity-60">Powered by WAStays</p>
  </div>

</div>
