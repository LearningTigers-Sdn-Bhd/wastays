<% content_for :title, "#{@hotel.name} | Concierge" %>

<%= render layout: "public/concierge/shared/page_shell",
           locals: {
             content_class: "flex-1 bg-background flex items-start justify-center px-4 pt-20 pb-20 sm:px-6 md:pt-28 md:items-center",
             container_class: "w-full max-w-3xl"
           } do %>

  <div class="md:hidden text-center mb-8 pt-4">
    <%= link_to root_path do %>
      <%= image_tag "logo/long-logo.png", alt: "WAStays", class: "h-9 w-auto mx-auto mb-6" %>
    <% end %>
    <div class="inline-flex items-center gap-x-3 mb-3">
      <span class="w-6 h-px bg-primary/30"></span>
      <span class="text-[10px] font-bold uppercase tracking-[0.3em] text-primary">Digital Concierge</span>
      <span class="w-6 h-px bg-primary/30"></span>
    </div>
    <h1 class="text-2xl font-serif text-foreground"><%= @hotel.name %></h1>
    <p class="text-sm text-muted-foreground mt-1"><%= concierge_location_label(@hotel) %></p>
  </div>

  <div class="hidden md:block mb-10">
    <div class="flex items-center gap-x-3 mb-5">
      <span class="w-6 h-px bg-primary/30"></span>
      <span class="text-[10px] font-bold uppercase tracking-[0.3em] text-primary">How can we help?</span>
      <span class="flex-1 h-px bg-border/60"></span>
    </div>
    <h2 class="text-3xl font-serif text-foreground leading-tight">
      What would you like<br><span class="italic text-primary">to do today?</span>
    </h2>
  </div>

  <div class="space-y-4">
    <div class="animate-hero-badge" style="animation-delay: 0.1s;">
      <%= link_to concierge_check_in_path(@hotel), class: "group relative flex flex-col justify-end min-h-[140px] bg-secondary rounded-3xl p-6 shadow-xl shadow-secondary/20 hover:bg-primary transition-all duration-500 overflow-hidden" do %>
        <div class="absolute top-0 right-0 -mr-8 -mt-8 w-32 h-32 bg-accent/5 rounded-full blur-2xl group-hover:bg-accent/10 transition-colors"></div>

        <div class="relative z-10 flex items-center justify-between">
          <div>
            <div class="w-12 h-12 rounded-2xl bg-accent/15 border border-accent/20 flex items-center justify-center mb-4 group-hover:scale-110 transition-transform duration-500">
              <svg class="w-6 h-6 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 16l-4-4m0 0l4-4m-4 4h14m-5 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h7a3 3 0 013 3v1"/></svg>
            </div>
            <h3 class="font-black text-sm uppercase tracking-[0.2em] text-white">Check In</h3>
            <p class="text-xs text-white/60 mt-1 max-w-[200px]">Register your arrival or complete pre-check-in</p>
          </div>
          <div class="w-10 h-10 rounded-full border border-white/10 flex items-center justify-center group-hover:bg-accent group-hover:border-accent transition-all duration-500">
            <svg class="w-5 h-5 text-white/40 group-hover:text-secondary transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7"/></svg>
          </div>
        </div>
      <% end %>
    </div>

    <div class="grid grid-cols-2 gap-5">
      <% [
        { path: concierge_check_out_path(@hotel), label: "Check Out", description: "Notify front desk", delay: "0.2s", icon: "M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1" },
        { path: concierge_book_path(@hotel), label: "Book a Room", description: "View availability", delay: "0.3s", icon: "M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" },
        { path: concierge_new_request_path(@hotel), label: "Request", description: "Housekeeping, etc", delay: "0.4s", icon: "M7 8h10M7 12h4m1 8l-4-4H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-3l-4 4z" },
        { path: concierge_contact_path(@hotel), label: "Contact Us", description: "Help & Info", delay: "0.5s", icon: "M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" }
      ].each do |tile| %>
        <div class="animate-hero-badge" style="animation-delay: <%= tile[:delay] %>;">
          <%= link_to tile[:path], class: "group flex flex-col h-full bg-white rounded-3xl p-5 border border-border shadow-sm hover:border-primary/30 hover:shadow-md transition-all duration-300" do %>
            <div class="w-10 h-10 rounded-2xl bg-muted border border-border flex items-center justify-center mb-4 group-hover:bg-primary group-hover:border-primary transition-colors duration-300">
              <svg class="w-5 h-5 text-muted-foreground group-hover:text-white transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="<%= tile[:icon] %>"/></svg>
            </div>
            <p class="font-black text-xs uppercase tracking-widest text-foreground"><%= tile[:label] %></p>
            <p class="text-[10px] text-muted-foreground mt-1 leading-tight"><%= tile[:description] %></p>
          <% end %>
        </div>
      <% end %>
    </div>

    <%# The one tile that answers rather than routes: full width because it is
        the thing a guest with a question should reach for first. %>
    <div class="animate-hero-badge" style="animation-delay: 0.6s;">
      <%= link_to concierge_chat_path(@hotel), class: "group flex items-center gap-4 bg-white rounded-3xl p-5 border border-border shadow-sm hover:border-primary/30 hover:shadow-md transition-all duration-300" do %>
        <div class="w-10 h-10 shrink-0 rounded-2xl bg-muted border border-border flex items-center justify-center group-hover:bg-primary group-hover:border-primary transition-colors duration-300">
          <svg class="w-5 h-5 text-muted-foreground group-hover:text-white transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.86 9.86 0 01-4-.8L3 21l1.9-3.8A7.96 7.96 0 013 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"/></svg>
        </div>
        <div class="min-w-0">
          <p class="font-black text-xs uppercase tracking-widest text-foreground">Chat With Us</p>
          <p class="text-[10px] text-muted-foreground mt-1 leading-tight">Ask about rooms, rates or anything else</p>
        </div>
      <% end %>
    </div>
  </div>
<% end %>
