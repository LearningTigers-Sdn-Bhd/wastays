<% content_for :title, "#{@hotel.name} | Concierge" %>

<%# One template for every width. The photo hero is shared with every other
    concierge page now (public/concierge/shared/hero) -- this was where it
    started, so home is the one page that composes its own shell around it
    instead of going through page_shell. %>
<%# overflow-x-clip, not hidden: hidden would break the sticky hero. %>
<div class="flex min-h-screen flex-col overflow-x-clip bg-background font-guest-interface">

  <%= render "public/concierge/shared/hero" %>

  <div class="mx-auto w-full max-w-4xl px-5 pb-6 pt-5 md:px-8 md:pt-12">
    <h2 class="font-guest-display text-2xl font-semibold text-foreground md:text-3xl">
      Hello, <span class="italic text-primary">Guest</span>
    </h2>
    <p class="mt-1.5 text-sm leading-relaxed text-muted-foreground md:text-base">How can we help with your stay?</p>
  </div>

  <div class="mx-auto w-full max-w-4xl space-y-3 px-5 pb-12 md:space-y-4 md:px-8 md:pb-20">

    <%# Every tile is one generous tap target. Shape and colour establish the
        hierarchy; shadows, nested icon boxes and scale effects do not. %>
    <%= link_to concierge_check_in_path(@hotel.unique_id, @hotel.public_id),
          class: "flex min-h-20 touch-manipulation items-center gap-3 rounded-xl bg-primary px-4 py-4 text-primary-foreground transition-colors hover:bg-primary-hover active:bg-primary-active focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 md:px-5" do %>
      <%= cached_icon "log-in", class: "h-6 w-6 shrink-0 text-accent", aria: { hidden: true } %>
      <span class="min-w-0">
        <span class="block text-sm font-semibold">Pre-check in</span>
        <span class="mt-0.5 block text-xs leading-snug text-primary-foreground/75">Complete your details before arrival</span>
      </span>
      <%= cached_icon "chevron-right", class: "ml-auto h-4 w-4 shrink-0 text-primary-foreground/70", aria: { hidden: true } %>
    <% end %>

    <%
      service_tiles = [
        { path: concierge_book_path(@hotel.unique_id, @hotel.public_id), label: "Book a Room", description: "View available rooms", icon: "calendar-days", tone: :booking, link: { target: "_blank", rel: "noopener" } },
        { path: concierge_recommendations_path(@hotel.unique_id, @hotel.public_id), label: "Recommendations", description: "Places and guest offers", icon: "sparkles", tone: :discovery },
        { path: concierge_contact_path(@hotel.unique_id, @hotel.public_id), label: "Property Contacts", description: "Phone, WhatsApp, email and map", icon: "phone", tone: :contact }
      ]

      if @hotel.concierge_chat_available?
        service_tiles << { path: concierge_chat_path(@hotel.unique_id, @hotel.public_id), label: "Interact with Chatbot", description: "Instant answers, any time", icon: "message-circle", tone: :conversation }
      end
    %>

    <%# Three tiles without the chatbot, four with it. A phone shows two a row,
        and a lone last tile takes the row; a wider screen shows them all in
        one row. %>
    <div class="guest-tile-grid" data-columns="<%= service_tiles.size %>">
      <% service_tiles.each do |tile| %>
        <%= render GuestUI::ActionCard.new(label: tile[:label], hint: tile[:description],
                                           icon: tile[:icon], tone: tile[:tone], href: tile[:path],
                                           **tile.fetch(:link, {})) %>
      <% end %>
    </div>

    <div class="pt-3 md:pt-4">
      <%= render "public/concierge/info/guide_tiles", info: @info, columns: 4,
                 path: ->(section) { section == "property" ? concierge_info_path(@hotel.unique_id, @hotel.public_id) : concierge_info_section_path(@hotel.unique_id, @hotel.public_id, section) } %>
    </div>
  </div>

  <%= render "public/concierge/shared/footer" %>
</div>
