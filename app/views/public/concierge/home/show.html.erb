<% content_for :title, "#{@hotel.name} | Concierge" %>

<%# One template for every width. The phone layout was the better one -- the
    property's own photograph is what tells a guest they are in the right place,
    and a logo in a green column never did that -- so the hero now runs on
    desktop too and simply gets taller and wider. %>
<div class="flex min-h-screen flex-col overflow-x-hidden bg-background font-sans">

  <%# Roughly half the original phone hero: the badge and the "Welcome to" line
      are gone at every width now, not only from md up, so what is left is the
      photograph plus the name and location that actually identify the property.
      Desktop keeps its own 20dvh cap below. %>
  <div class="relative h-[160px] w-full overflow-hidden rounded-b-[2rem] bg-primary shadow-2xl shadow-primary/20 md:h-[20dvh]">
    <% if @hotel.featured_photo_attachment.present? %>
      <%= image_tag @hotel.featured_photo_attachment, class: "absolute inset-0 h-full w-full object-cover opacity-80" %>
    <% else %>
      <%= image_tag "landing/bg-1.webp", class: "absolute inset-0 h-full w-full object-cover opacity-90" %>
    <% end %>

    <%# Two layers, not one: the flat wash guarantees the floor contrast and the
        gradient keeps the photograph from looking merely dimmed. %>
    <div class="absolute inset-0 z-[1] bg-black/50"></div>
    <div class="absolute inset-0 z-[2] bg-gradient-to-t from-black/80 via-transparent to-black/40"></div>

    <div class="relative z-10 mx-auto flex h-full max-w-5xl flex-col justify-end px-6 pb-4 md:px-10 md:pb-5">
      <div class="space-y-0.5">
        <h1 class="font-serif text-[29px] leading-tight text-white [text-shadow:0_2px_10px_rgba(0,0,0,0.8)] md:text-4xl">
          <%= @hotel.name %>
        </h1>
        <p class="text-[11px] font-bold uppercase tracking-[0.2em] text-accent opacity-90 md:text-[12px]">
          <%= concierge_location_label(@hotel) %>
        </p>
      </div>
    </div>
  </div>

  <div class="mx-auto w-full max-w-5xl px-6 pb-6 pt-8 md:px-10 md:pt-12">
    <h2 class="font-serif text-2xl text-foreground md:text-3xl">
      Hello, <span class="italic text-primary">Guest</span>
    </h2>
    <p class="mt-1.5 text-xs font-medium leading-relaxed text-muted-foreground md:text-sm">How can we assist you today?</p>
  </div>

  <div class="mx-auto w-full max-w-5xl space-y-4 px-6 pb-12 md:px-10 md:pb-20">

    <%# Check In and Check Out are the two ends of one stay, so they share a row
        rather than one standing alone above a grid the other sits inside. Check
        In keeps the solid primary treatment as the more likely first tap; Check
        Out mirrors its shape and size in an outlined form so the pair reads as
        equals, not as a hero and an afterthought. %>
    <%# Every tile below is icon plus label only now -- no caption line -- so
        heights come down across the board to match the lighter content. %>
    <div class="grid grid-cols-2 gap-4">
      <%= link_to concierge_check_in_path(@hotel),
            class: "group relative flex min-h-[92px] flex-col justify-between overflow-hidden rounded-[2rem] border border-white/5 bg-primary p-5 shadow-xl shadow-primary/20 transition-all duration-300 active:scale-[0.98] md:min-h-[112px] md:p-8" do %>
        <div class="relative z-10 flex h-11 w-11 flex-shrink-0 items-center justify-center rounded-2xl border border-white/20 bg-white/10 md:h-14 md:w-14">
          <%= cached_icon "log-in", class: "h-5 w-5 text-accent md:h-6 md:w-6" %>
        </div>
        <p class="relative z-10 text-[13px] font-black uppercase tracking-[0.15em] text-white md:text-base">Check In</p>
      <% end %>

      <%= link_to concierge_check_out_path(@hotel),
            class: "group relative flex min-h-[92px] flex-col justify-between overflow-hidden rounded-[2rem] border border-primary/15 bg-white p-5 shadow-sm transition-all duration-300 hover:border-primary/30 hover:shadow-md active:scale-[0.98] md:min-h-[112px] md:p-8" do %>
        <div class="relative z-10 flex h-11 w-11 flex-shrink-0 items-center justify-center rounded-2xl border border-primary/10 bg-primary/5 text-primary transition-colors duration-200 group-hover:bg-primary group-hover:text-white md:h-14 md:w-14">
          <%= cached_icon "log-out", class: "h-5 w-5 md:h-6 md:w-6" %>
        </div>
        <p class="relative z-10 text-[13px] font-black uppercase tracking-[0.15em] text-foreground md:text-base">Check Out</p>
      <% end %>
    </div>

    <%# Grid order is row order: Recommendations sits immediately before Contact
        Us so the pair lands in the same row at every width -- two columns on a
        phone puts them together as row two, four columns on desktop puts all
        four in the one row. %>
    <div class="grid grid-cols-2 gap-4 md:grid-cols-4">
      <% [
        { path: concierge_book_path(@hotel), label: "Book a Room", icon: "calendar-days" },
        { path: concierge_new_request_path(@hotel), label: "Request", icon: "message-square-more" },
        { path: concierge_recommendations_path(@hotel), label: "Recommendations", icon: "sparkles" },
        { path: concierge_contact_path(@hotel), label: "Contact Us", icon: "phone" }
      ].each do |tile| %>
        <%= link_to tile[:path],
              class: "group flex min-h-[104px] flex-col justify-between rounded-[2rem] border border-border/60 bg-white p-5 shadow-sm transition-all duration-300 hover:border-primary/30 hover:shadow-md active:scale-95" do %>
          <div class="flex h-10 w-10 items-center justify-center rounded-xl border border-primary/10 bg-primary/5 text-primary transition-colors duration-200 group-hover:bg-primary group-hover:text-white">
            <%= cached_icon tile[:icon], class: "h-5 w-5" %>
          </div>
          <p class="text-[13px] font-black uppercase leading-tight tracking-wider text-foreground"><%= tile[:label] %></p>
        <% end %>
      <% end %>
    </div>

    <% if @hotel.concierge_chat_available? %>
      <%= link_to concierge_chat_path(@hotel),
            class: "group flex items-center gap-4 rounded-[2rem] border border-border/60 bg-white p-5 shadow-sm transition-all duration-300 hover:border-primary/30 hover:shadow-md active:scale-[0.98]" do %>
        <div class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl border border-primary/10 bg-primary/5 text-primary transition-colors duration-200 group-hover:bg-primary group-hover:text-white">
          <%= cached_icon "message-circle", class: "h-6 w-6" %>
        </div>
        <p class="text-[13px] font-black uppercase leading-tight tracking-wider text-foreground">Chat With Us</p>
      <% end %>
    <% end %>
  </div>

  <div class="mt-auto px-4 pb-10 text-center">
    <div class="mx-auto mb-6 h-px w-12 bg-border"></div>
    <p class="text-[10px] font-black uppercase tracking-[0.25em] text-muted-foreground opacity-60">Powered by WAStays</p>
  </div>
</div>
