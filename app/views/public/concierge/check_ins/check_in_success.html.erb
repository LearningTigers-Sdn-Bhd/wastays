<% content_for :title, "Checked In! | #{@hotel.name}" %>
<% presenter = Public::Concierge::CheckInPresenter.new(booking: @booking, hotel: @hotel) %>

<%# The end of the flow: what happened, where the key is, and the stay card
    the guest will see again on the stay page. %>
<%= render GuestUI::Page.new(variant: :centered) do |page| %>
  <% page.with_hero do %>
    <%= render "public/concierge/shared/hero" %>
  <% end %>

  <div class="guest-check-in-success">
    <div class="text-center">
      <span class="guest-check-in-success__mark">
        <%= app_icon "check", class: "size-7", aria: { hidden: "true" } %>
      </span>
      <%= render "public/concierge/stays/shared/page_heading",
                 title: "Welcome,",
                 title_accent: presenter.guest_name.to_s.split.first,
                 subtitle: "You are checked in. Collect your room key at the front desk." %>
    </div>

    <%= render GuestUI::Card.new(class: "guest-stay-summary") do %>
      <div class="flex items-center justify-between gap-3">
        <h2 class="guest-card__title">Your Stay</h2>
        <span class="guest-stay-summary__status" data-state="in-house">Checked in</span>
      </div>

      <dl class="mt-4 space-y-4">
        <div>
          <dt class="text-xs font-medium text-muted-foreground">Room</dt>
          <dd class="guest-stay-summary__room font-guest-display"><%= @room_number.presence || "See the front desk" %></dd>
        </div>

        <div>
          <dt class="sr-only">Dates</dt>
          <dd class="flex flex-wrap items-center gap-2 text-sm font-semibold text-foreground">
            <span><%= presenter.check_in_label %></span>
            <%= app_icon "arrow-right", class: "size-4 shrink-0 text-muted-foreground", aria: { hidden: "true" } %>
            <span><%= presenter.check_out_label %></span>
          </dd>
          <dd class="mt-1 text-xs font-medium text-muted-foreground"><%= pluralize(presenter.nights, "night") %></dd>
        </div>
      </dl>

      <dl class="guest-stay-summary__refs">
        <div class="flex items-baseline gap-1.5">
          <dt><span aria-hidden="true">Code</span><span class="sr-only">Booking confirmation code</span></dt>
          <dd class="font-mono text-foreground"><%= presenter.confirmation_code %></dd>
        </div>
      </dl>
    <% end %>

    <%= render GuestUI::Button.new(label: "Back to Concierge", variant: :secondary, size: :lg, block: true,
                                   href: concierge_home_path(@hotel.unique_id, @hotel.public_id)) %>
  </div>
<% end %>
