<% content_for :title, "Check In Now | #{@hotel.name}" %>
<%= render layout: "public/concierge/shared/page_shell" do %>
  <% subtitle = @presenter.subtitle %>
  <%= render "public/concierge/shared/page_header",
             back_path: concierge_check_in_path(@hotel),
             back_label: "Back to Check In",
             eyebrow: "Check In",
             title_prefix: "Ready to",
             title_accent: "check in?",
             subtitle: subtitle,
             divider_suffix: "/60" %>

  <%= render "public/concierge/shared/error_alert", message: @error %>

  <div class="mb-5 rounded-2xl border border-border bg-white p-5 shadow-sm">
    <div class="mb-4 flex items-center gap-3">
      <% if @presenter.pre_checkin_completed? %>
        <div class="flex-none rounded-xl bg-green-50 text-green-600">
          <%= cached_icon "circle-check", stroke_width: 2, class: "h-10 w-10 p-2.5" %>
        </div>
        <div>
          <p class="text-xs font-bold uppercase tracking-widest text-green-600">Pre-check-in Complete</p>
          <p class="text-xs text-muted-foreground">Your details have been verified</p>
        </div>
      <% else %>
        <div class="flex-none rounded-xl bg-amber-50 text-amber-600">
          <%= cached_icon "clipboard", stroke_width: 2, class: "h-10 w-10 p-2.5" %>
        </div>
        <div>
          <p class="text-xs font-bold uppercase tracking-widest text-amber-600">Registration Required</p>
          <p class="text-xs text-muted-foreground">Please fill in your details to proceed</p>
        </div>
      <% end %>
    </div>

    <div class="space-y-1 border-t border-border pt-4">
      <p class="font-black text-foreground"><%= @booking.guest_name %></p>
      <p class="text-xs font-mono text-muted-foreground"><%= @booking.confirmation_token %></p>
      <p class="text-xs text-muted-foreground">
        <%= concierge_booking_date_range(@booking) %>
        · <%= concierge_booking_nights(@booking) %>
      </p>
      <% @booking.booking_rooms.each do |booking_room| %>
        <p class="text-xs text-muted-foreground">1x <%= booking_room.room_type_snapshot["name"] %></p>
      <% end %>
    </div>
  </div>



  <%= form_with model: @form, url: concierge_submit_check_in_path(@hotel), method: :post, multipart: true, data: @presenter.form_data(self) do |f| %>
    <%= hidden_field_tag :latitude, nil, data: @presenter.geolocation_active? ? { geolocation_check_in_target: "latitude" } : {} %>
    <%= hidden_field_tag :longitude, nil, data: @presenter.geolocation_active? ? { geolocation_check_in_target: "longitude" } : {} %>
    <% if @presenter.registration_required? %>
      <div class="card p-6 mb-5">
        <div class="mb-4">
          <h2 class="text-sm font-black uppercase tracking-widest text-foreground">Guest Registration</h2>
          <p class="mt-1 text-xs text-muted-foreground">Fill in your details to complete check-in.</p>
        </div>

        <div class="space-y-4">
          <div>
            <%= f.label :guest_name, "Full Name (as per IC/Passport)", class: "block text-xs font-bold uppercase tracking-widest text-muted-foreground mb-2" %>
            <%= f.text_field :guest_name, value: @booking.guest_name, class: "form-input py-3 px-5 border border-border", required: true %>
          </div>

          <div class="grid gap-4 md:grid-cols-2">
            <div>
              <%= f.label :guest_document_type, "Document Type", class: "block text-xs font-bold uppercase tracking-widest text-muted-foreground mb-2" %>
              <%= f.select :guest_document_type,
                    @presenter.document_types,
                    { selected: @booking.guest_document_type, prompt: "Select document type" },
                    class: "form-input py-3 px-5 border border-border", required: true,
                    data: { guest_dob_target: "documentType", pre_checkin_document_target: "select", action: "change->guest-dob#autofill change->pre-checkin-document#toggleUploads" } %>
            </div>

            <div>
              <%= f.label :guest_government_id, "IC / Passport Number", class: "block text-xs font-bold uppercase tracking-widest text-muted-foreground mb-2" %>
              <%= f.text_field :guest_government_id, value: @booking.guest_government_id, class: "form-input py-3 px-5 border border-border", required: true, placeholder: "e.g. 900101011234", data: { guest_dob_target: "governmentId", action: "input->guest-dob#autofill" } %>
            </div>
          </div>

          <div class="grid gap-4 md:grid-cols-2">
            <div>
              <%= f.label :guest_email, "Email Address", class: "block text-xs font-bold uppercase tracking-widest text-muted-foreground mb-2" %>
              <%= f.email_field :guest_email, value: @booking.guest_email, class: "form-input py-3 px-5 border border-border", required: true %>
            </div>

            <div>
              <%= f.label :guest_phone, "Phone Number", class: "block text-xs font-bold uppercase tracking-widest text-muted-foreground mb-2" %>
              <%= f.telephone_field :guest_phone, value: @booking.guest_phone, class: "form-input py-3 px-5 border border-border", required: true %>
            </div>
          </div>

          <div>
            <%= f.label :guest_city, "City", class: "block text-xs font-bold uppercase tracking-widest text-muted-foreground mb-2" %>
            <%= f.text_field :guest_city, value: @booking.guest_city, class: "form-input py-3 px-5 border border-border", required: true, placeholder: "e.g. Petaling Jaya" %>
          </div>

          <div>
            <%= f.label :guest_state_code, "State", class: "block text-xs font-bold uppercase tracking-widest text-muted-foreground mb-2" %>
            <%= f.select :guest_state_code,
                  EInvoice::MalaysiaStates.options,
                  { include_blank: "Select state", selected: @booking.guest_state_code },
                  class: "form-input py-3 px-5 border border-border", required: true %>
          </div>

          <div>
            <%= f.label :guest_postal_code, "Postcode", class: "block text-xs font-bold uppercase tracking-widest text-muted-foreground mb-2" %>
            <%= f.text_field :guest_postal_code, value: @booking.guest_postal_code, class: "form-input py-3 px-5 border border-border", inputmode: "numeric", placeholder: "e.g. 88000" %>
          </div>

          <div>
            <%= f.label :guest_tin, "Tax identification number (optional)", class: "block text-xs font-bold uppercase tracking-widest text-muted-foreground mb-2" %>
            <%= f.text_field :guest_tin, value: @booking.guest_tin, class: "form-input py-3 px-5 border border-border", placeholder: "Only if the guest needs to claim this stay" %>
          </div>

          <div>
            <%= f.label :guest_country, "Nationality", class: "block text-xs font-bold uppercase tracking-widest text-muted-foreground mb-2" %>
              <%= f.select :guest_country,
                  country_options,
                  { selected: @presenter.default_country, prompt: "Select nationality" },
                  class: "form-input py-3 px-5 border border-border", required: true,
                  data: { guest_dob_target: "country", action: "change->guest-dob#autofill" } %>
          </div>

          <div>
            <%= f.label :guest_date_of_birth, "Date of Birth", class: "block text-xs font-bold uppercase tracking-widest text-muted-foreground mb-2" %>
            <%= f.date_field :guest_date_of_birth, value: @form.guest_date_of_birth, class: "form-input py-3 px-5 border border-border", data: { guest_dob_target: "dateOfBirth" } %>
          </div>

          <div>
            <%= f.label :guest_home_address, "Home Address", class: "block text-xs font-bold uppercase tracking-widest text-muted-foreground mb-2" %>
            <%= f.text_area :guest_home_address, value: @booking.guest_home_address, class: "form-input py-3 px-5 border border-border", required: true, rows: 3, placeholder: "e.g. No. 12, Jalan Ampang, 50450 Kuala Lumpur, Malaysia" %>
          </div>
        </div>
      </div>

      <div class="card p-6 mb-5 transition-all duration-300 transform <%= @presenter.upload_section_class %>" data-pre-checkin-document-target="uploadSection">
        <div class="mb-4">
          <h2 class="text-sm font-black uppercase tracking-widest text-foreground">Identity Document</h2>
          <p class="mt-1 text-xs text-muted-foreground">Upload or scan your IC / passport.</p>
        </div>
        <div class="grid gap-6 md:grid-cols-2">
          <div data-pre-checkin-document-target="frontContainer" class="transition-all duration-300 transform <%= @presenter.front_container_class %>">
            <%= render "shared/id_scanner", f: f, field: :id_front, side: :front, label: @presenter.front_scanner_label, height_class: @presenter.front_scanner_height_class %>
          </div>
          <div data-pre-checkin-document-target="backContainer" class="transition-all duration-300 transform <%= @presenter.back_container_class %>">
            <%= render "shared/id_scanner", f: f, field: :id_back, side: :back, label: "Back ID Card" %>
          </div>
        </div>
      </div>

      <div class="card p-6 mb-5">
        <div class="mb-4">
          <h2 class="text-sm font-black uppercase tracking-widest text-foreground">Guest Signature</h2>
          <p class="mt-1 text-xs text-muted-foreground">Sign below to confirm your check-in details.</p>
        </div>
        <div data-controller="signature" class="space-y-2">
          <div class="rounded-xl border border-border bg-white p-2">
            <canvas data-signature-target="canvas" class="w-full h-40 touch-none"></canvas>
          </div>
          <div class="flex justify-end">
            <button type="button" data-action="click->signature#clear" class="text-xs font-bold uppercase tracking-widest text-primary hover:underline">
              Clear Signature
            </button>
          </div>
          <%= f.hidden_field :signature, data: { signature_target: "input" }, required: true %>
        </div>
      </div>
    <% end %>

    <% if @presenter.geolocation_active? %>
      <div data-geolocation-check-in-target="status"></div>
    <% end %>
    <%= submit_tag @presenter.registration_required? ? "Confirm Pre-Check-In →" : "Confirm Check In →", class: "btn btn-primary w-full cursor-pointer py-3 text-sm font-black uppercase tracking-widest disabled:opacity-50 disabled:cursor-not-allowed mt-2", data: @presenter.geolocation_active? ? { geolocation_check_in_target: "submitButton" } : {} %>
  <% end %>

  <%= render "shared/scanner_modal" %>
<% end %>
