<% content_for :title, "Check In Now | #{@hotel.name}" %>
<%# The booking is known here, so the compact booking card is the way back
    to the code page on a phone, and the full card sits beside the form on a
    wider screen. %>
<% check_in_path = concierge_check_in_path(@hotel.unique_id, @hotel.public_id) %>
<%= render layout: "public/concierge/shared/form_layout",
           locals: {
             back_path: check_in_path,
             back_label: "Back to Check In",
             title: (@presenter.registration_required? ? "Pre-check-in" : "Check in"),
             subtitle: @presenter.subtitle,
             compact: render("public/concierge/shared/summary_compact",
                             path: check_in_path,
                             back_label: "Back to Check In",
                             title: @presenter.guest_name,
                             aside: pluralize(@presenter.nights, "night"),
                             detail: "#{@presenter.check_in_label} – #{@presenter.check_out_label}"),
             summary: render("public/concierge/check_ins/booking_summary", presenter: @presenter)
           } do %>
  <%= render GuestUI::Notice.new(message: @error, variant: :danger) %>
  <%= render GuestUI::Notice.new(message: flash[:notice], variant: :success) %>

  <%# No cards: each part of the form is a fieldset with a heading and one
      line that says what it is for, the same as the refund form. %>
  <%= form_with model: @form, url: concierge_submit_check_in_path(@hotel.unique_id, @hotel.public_id), method: :post,
                multipart: true, class: "space-y-8", data: @presenter.form_data(self) do |f| %>
    <%= hidden_field_tag :latitude, nil, data: @presenter.geolocation_active? ? { geolocation_check_in_target: "latitude" } : {} %>
    <%= hidden_field_tag :longitude, nil, data: @presenter.geolocation_active? ? { geolocation_check_in_target: "longitude" } : {} %>

    <% if @presenter.registration_required? %>
      <% document_type = @booking.guest_document_type %>
      <% address_country = @presenter.default_address_country %>
      <% coded_state = address_country.to_s.strip.casecmp?("Malaysia") %>

      <fieldset class="guest-fieldset" aria-describedby="check-in-guest-details-description">
        <legend class="guest-fieldset__legend">Guest details</legend>
        <p id="check-in-guest-details-description" class="guest-fieldset__description">
          Use the details on your IC or passport.
        </p>

        <%= render GuestUI::FormField.new(form: f, attribute: :guest_name, label: "Full name", required: true,
                                          hint: "As shown on your IC or passport.") do |field| %>
          <% field.with_input(value: @booking.guest_name, autocomplete: "name") %>
        <% end %>

        <div class="grid gap-5 md:grid-cols-2">
          <%= render GuestUI::FormField.new(form: f, attribute: :guest_country, label: "Nationality", required: true) do |field| %>
            <% field.with_select(choices: country_options, prompt: "Choose your nationality",
                                 selected: @presenter.default_country,
                                 native_data: { guest_dob_target: "country", guest_identity_target: "country",
                                                action: "change->guest-dob#autofill change->guest-identity#refresh" }) %>
          <% end %>

          <%= render GuestUI::FormField.new(form: f, attribute: :guest_document_type, label: "Document type", required: true) do |field| %>
            <% field.with_select(choices: @presenter.document_types, prompt: "Choose a document",
                                 selected: document_type,
                                 native_data: { guest_dob_target: "documentType", guest_identity_target: "documentType",
                                                pre_checkin_document_target: "select",
                                                action: "change->guest-dob#autofill change->guest-identity#documentChanged change->pre-checkin-document#toggleUploads" }) %>
          <% end %>
        </div>

        <%= render GuestUI::FormField.new(form: f, attribute: :guest_government_id, required: true,
                                          label: tag.span(Guests::GuestPresenter.identity_number_label(document_type), data: { guest_identity_label_text: true }),
                                          data: { guest_identity_target: "numberLabel" }) do |field| %>
          <% field.with_input(value: @booking.guest_government_id, placeholder: "For example: 900101011234",
                              autocomplete: "off",
                              data: { guest_dob_target: "governmentId", action: "input->guest-dob#autofill" }) %>
        <% end %>

        <%# A national identity card is not a document LHDN takes, so an
            individual e-invoice needs the passport number as well. %>
        <div data-guest-identity-target="passportRow" <%= "hidden" unless document_type == "national_id" %>>
          <%= render GuestUI::FormField.new(form: f, attribute: :guest_passport_number, label: "Passport number",
                                            hint: "Needed for an individual e-invoice.",
                                            disabled: document_type != "national_id") do |field| %>
            <% field.with_input(value: @booking.guest_passport_number, autocomplete: "off",
                                data: { guest_identity_target: "passportInput" }) %>
          <% end %>
        </div>

        <%= render GuestUI::FormField.new(form: f, attribute: :guest_date_of_birth, label: "Date of birth",
                                          hint: "Filled in from a MyKad number.") do |field| %>
          <% field.with_input(type: :date, value: @form.guest_date_of_birth, autocomplete: "bday",
                              data: { guest_dob_target: "dateOfBirth" }) %>
        <% end %>

        <div class="grid gap-5 md:grid-cols-2">
          <%= render GuestUI::FormField.new(form: f, attribute: :guest_email, label: "Email", required: true) do |field| %>
            <% field.with_input(type: :email, value: @booking.guest_email, autocomplete: "email",
                                placeholder: "For example: you@example.com") %>
          <% end %>

          <%= render GuestUI::FormField.new(form: f, attribute: :guest_phone, label: "Phone", required: true) do |field| %>
            <% field.with_input(type: :tel, value: @booking.guest_phone, autocomplete: "tel",
                                placeholder: "For example: +60 12 345 6789") %>
          <% end %>
        </div>
      </fieldset>

      <%# address-state swaps the state list for a text box when the address
          is not in Malaysia. Both carry the same field name; the hidden one is
          disabled, so the form sends one value. %>
      <fieldset class="guest-fieldset" aria-describedby="check-in-address-description"
                data-controller="address-state">
        <legend class="guest-fieldset__legend">Home address</legend>
        <p id="check-in-address-description" class="guest-fieldset__description">
          Where you live. The hotel needs it for your registration.
        </p>

        <%= render GuestUI::FormField.new(form: f, attribute: :guest_address_country, label: "Country", required: true,
                                          data: { address_state_target: "country" }) do |field| %>
          <% field.with_select(choices: country_options, prompt: "Choose a country", selected: address_country,
                               native_data: { action: "change->address-state#refresh" }) %>
        <% end %>

        <%= render GuestUI::FormField.new(form: f, attribute: :guest_home_address, label: "Street address", required: true) do |field| %>
          <% field.with_text_area(rows: 3, value: @booking.guest_home_address, autocomplete: "street-address",
                                  placeholder: "Street, building and unit") %>
        <% end %>

        <div class="grid gap-5 md:grid-cols-2">
          <%= render GuestUI::FormField.new(form: f, attribute: :guest_city, label: "City", required: true) do |field| %>
            <% field.with_input(value: @booking.guest_city, autocomplete: "address-level2",
                                placeholder: "For example: Petaling Jaya") %>
          <% end %>

          <%= render GuestUI::FormField.new(form: f, attribute: :guest_postal_code, label: "Postcode") do |field| %>
            <% field.with_input(value: @booking.guest_postal_code, inputmode: "numeric", autocomplete: "postal-code",
                                placeholder: "For example: 88000") %>
          <% end %>
        </div>

        <%= render GuestUI::FormField.new(form: f, attribute: :guest_state_code, label: "State", required: true,
                                          disabled: !coded_state, hidden: !coded_state,
                                          data: { address_state_target: "coded" }) do |field| %>
          <% field.with_select(choices: EInvoice::MalaysiaStates.options, prompt: "Choose a state",
                               selected: @booking.guest_state_code) %>
        <% end %>

        <%= render GuestUI::FormField.new(form: f, attribute: :guest_state_code, id: "booking_guest_state_code_free",
                                          label: "State or province", required: true,
                                          disabled: coded_state, hidden: coded_state,
                                          data: { address_state_target: "free" }) do |field| %>
          <% field.with_input(value: PostalAddresses::Presenter.printable_state(@booking.guest_state_code),
                              autocomplete: "address-level1", placeholder: "For example: Hokkaido") %>
        <% end %>

        <%= render GuestUI::FormField.new(form: f, attribute: :guest_tin, label: "Tax number (optional)",
                                          hint: "Only if you need to claim this stay.") do |field| %>
          <% field.with_input(value: @booking.guest_tin, autocomplete: "off") %>
        <% end %>
      </fieldset>

      <fieldset class="guest-fieldset <%= @presenter.upload_section_class %>" aria-describedby="check-in-document-description"
                data-pre-checkin-document-target="uploadSection">
        <legend class="guest-fieldset__legend">Identity document</legend>
        <p id="check-in-document-description" class="guest-fieldset__description">
          Scan or upload your IC or passport.
        </p>

        <div class="grid gap-5 md:grid-cols-2">
          <div data-pre-checkin-document-target="frontContainer" class="<%= @presenter.front_container_class %>">
            <%= render "shared/id_scanner", f: f, field: :id_front, side: :front, label: @presenter.front_scanner_label,
                                            height_class: @presenter.front_scanner_height_class %>
          </div>
          <div data-pre-checkin-document-target="backContainer" class="<%= @presenter.back_container_class %>">
            <%= render "shared/id_scanner", f: f, field: :id_back, side: :back, label: "Back ID Card" %>
          </div>
        </div>
      </fieldset>

      <fieldset class="guest-fieldset" aria-describedby="check-in-signature-description">
        <legend class="guest-fieldset__legend">Signature</legend>
        <p id="check-in-signature-description" class="guest-fieldset__description">
          Sign with your finger to confirm your details.
        </p>

        <div data-controller="signature" class="space-y-2">
          <div class="guest-signature">
            <canvas data-signature-target="canvas" class="h-40 w-full touch-none" aria-label="Signature pad"></canvas>
          </div>
          <div class="flex justify-end">
            <%= render GuestUI::Button.new(label: "Clear signature", variant: :ghost, size: :sm,
                                           data: { action: "click->signature#clear" }) %>
          </div>
          <%= f.hidden_field :signature, data: { signature_target: "input" }, required: true %>
        </div>
      </fieldset>
    <% end %>

    <% if @presenter.geolocation_active? %>
      <div data-geolocation-check-in-target="status"></div>
    <% end %>

    <%= render GuestUI::Button.new(label: (@presenter.registration_required? ? "Confirm pre-check-in" : "Confirm check-in"),
                                   size: :lg, block: true, type: "submit",
                                   data: (@presenter.geolocation_active? ? { geolocation_check_in_target: "submitButton" } : { turbo_submits_with: "Sending…" })) %>
  <% end %>

  <%= render "shared/scanner_modal" %>
<% end %>
