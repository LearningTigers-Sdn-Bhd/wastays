<% content_for :title, "Check In Now | #{@hotel.name}" %>
<% subtitle = @booking&.pre_checkin&.completed? ? "Your pre-check-in is complete. Confirm below to check in and get your room assigned." : "Complete your guest registration below to check in and get your room assigned." %>

<div data-mobile-view class="min-h-screen bg-landing-bg flex flex-col font-sans">

  <%# Top nav %>
  <div class="px-6 pt-8 pb-6">
    <%= link_to concierge_check_in_path(@hotel.slug),
          class: "w-10 h-10 rounded-xl bg-brand-primary flex items-center justify-center flex-shrink-0 shadow-lg shadow-brand-primary/20 active:scale-90 transition-transform" do %>
      <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M15 19l-7-7 7-7"/>
      </svg>
    <% end %>
  </div>

  <%# Header Section %>
  <div class="px-6 pb-8">
    <h1 class="text-2xl font-black text-neutral-text-primary leading-tight">
      Ready to <span class="text-brand-primary">check in?</span>
    </h1>
    <p class="text-[13px] text-neutral-text-secondary mt-3 font-medium leading-relaxed">
      <%= subtitle %>
    </p>
  </div>

  <div class="flex-1 px-6 space-y-6 pb-32">
    <%= render "public/concierge/shared/error_alert", message: @error %>

    <%# Booking summary card - Redesigned as a premium "Ticket" %>
    <div class="rounded-2xl border border-neutral-border/50 bg-white p-6 shadow-sm overflow-hidden relative">
      <div class="flex items-center gap-4 mb-5 pb-5 border-b border-dashed border-neutral-border/80">
        <% if @booking&.pre_checkin&.completed? %>
          <div class="w-12 h-12 rounded-xl bg-green-50 text-green-600 flex items-center justify-center">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
          </div>
          <div>
            <p class="text-[10px] font-black uppercase tracking-[0.15em] text-green-600">Verified</p>
            <p class="text-xs font-bold text-neutral-text-primary mt-0.5">Registration Complete</p>
          </div>
        <% else %>
          <div class="w-12 h-12 rounded-xl bg-amber-50 text-amber-600 flex items-center justify-center">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"/></svg>
          </div>
          <div>
            <p class="text-[10px] font-black uppercase tracking-[0.15em] text-amber-600">Action Required</p>
            <p class="text-xs font-bold text-neutral-text-primary mt-0.5">Please Complete Registration</p>
          </div>
        <% end %>
      </div>
      
      <div class="space-y-3">
        <div>
          <p class="text-[10px] font-black uppercase tracking-[0.2em] text-neutral-text-secondary mb-1">Guest Name</p>
          <p class="text-sm font-bold text-neutral-text-primary"><%= @booking.guest_name %></p>
        </div>
        
        <div class="flex items-center justify-between gap-4">
          <div>
            <p class="text-[10px] font-black uppercase tracking-[0.2em] text-neutral-text-secondary mb-1">Reservation No.</p>
            <p class="text-xs font-mono font-bold text-brand-primary"><%= @booking.confirmation_token %></p>
          </div>
          <div class="text-right">
            <p class="text-[10px] font-black uppercase tracking-[0.2em] text-neutral-text-secondary mb-1">Stay Duration</p>
            <p class="text-xs font-bold text-neutral-text-primary">
              <%= concierge_booking_nights(@booking) %>
            </p>
          </div>
        </div>

        <div>
          <p class="text-[10px] font-black uppercase tracking-[0.2em] text-neutral-text-secondary mb-1">Room Details</p>
          <div class="space-y-0.5">
            <% @booking.booking_rooms.each do |booking_room| %>
              <p class="text-xs font-bold text-neutral-text-primary"><%= booking_room.quantity %>x <%= booking_room.room_type_snapshot["name"] %></p>
            <% end %>
          </div>
        </div>
      </div>
    </div>

    <%# Guest registration form %>
    <%= form_with model: @booking, url: concierge_submit_check_in_path(@hotel.slug), method: :post, multipart: true, class: "space-y-6", data: { controller: "scanner" } do |f| %>
      <% unless @booking&.pre_checkin&.completed? %>
        <div class="rounded-2xl border border-neutral-border/50 bg-white p-6 shadow-sm space-y-8">
          <div>
            <h2 class="text-sm font-black uppercase tracking-[0.2em] text-neutral-text-primary">Guest Registration</h2>
            <p class="text-[11px] text-neutral-text-secondary mt-2 leading-relaxed">Fill in your details to complete check-in.</p>
          </div>

          <div class="space-y-6">
            <div class="space-y-2">
              <%= f.label :guest_name, "Full Name (as per IC/Passport)", class: "block text-[10px] font-black uppercase tracking-[0.2em] text-neutral-text-secondary ml-1" %>
              <%= f.text_field :guest_name, value: @booking.guest_name, 
                    class: "w-full bg-neutral-bg border-neutral-border/40 rounded-xl py-3.5 px-4 text-sm font-medium focus:ring-4 focus:ring-brand-primary/10 focus:border-brand-primary transition-all", required: true %>
            </div>

            <div class="space-y-2">
              <%= f.label :guest_document_type, "Document Type", class: "block text-[10px] font-black uppercase tracking-[0.2em] text-neutral-text-secondary ml-1" %>
              <div class="relative" data-controller="searchable-select">
                <%= f.hidden_field :guest_document_type, value: @booking.guest_document_type, data: { searchable_select_target: "hiddenInput" } %>
                <div class="relative cursor-pointer" data-action="click->searchable-select#toggle">
                  <input type="text" readonly 
                         data-searchable-select-target="input"
                         placeholder="Select document type"
                         class="w-full bg-neutral-bg border-neutral-border/40 rounded-xl py-3.5 px-4 pr-10 text-sm font-medium focus:ring-4 focus:ring-brand-primary/10 focus:border-brand-primary transition-all cursor-pointer">
                  <div class="absolute inset-y-0 right-0 flex items-center pr-3 pointer-events-none">
                    <svg class="h-4 w-4 text-neutral-text-secondary" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 9l-7 7-7-7"/></svg>
                  </div>
                </div>
                
                <div data-searchable-select-target="options" class="hidden absolute z-50 mt-2 w-full bg-white border border-neutral-border/60 rounded-xl shadow-xl max-h-60 overflow-y-auto">
                  <% [["MyKad (IC)", "ic"], ["Passport", "passport"]].each do |label, value| %>
                    <div class="px-4 py-3 text-sm font-medium text-neutral-text-primary hover:bg-neutral-bg cursor-pointer transition-colors border-b border-neutral-border/20 last:border-0"
                         data-action="click->searchable-select#select"
                         data-searchable-select-target="option"
                         data-value="<%= value %>"
                         data-label="<%= label %>">
                      <%= label %>
                    </div>
                  <% end %>
                </div>
              </div>
            </div>

            <div class="space-y-2">
              <%= f.label :guest_government_id, "IC / Passport Number", class: "block text-[10px] font-black uppercase tracking-[0.2em] text-neutral-text-secondary ml-1" %>
              <%= f.text_field :guest_government_id, value: @booking.guest_government_id, 
                    class: "w-full bg-neutral-bg border-neutral-border/40 rounded-xl py-3.5 px-4 text-sm font-medium focus:ring-4 focus:ring-brand-primary/10 focus:border-brand-primary transition-all", 
                    required: true, placeholder: "e.g. 900101011234" %>
            </div>

            <div class="space-y-2">
              <%= f.label :guest_email, "Email Address", class: "block text-[10px] font-black uppercase tracking-[0.2em] text-neutral-text-secondary ml-1" %>
              <%= f.email_field :guest_email, value: @booking.guest_email, 
                    class: "w-full bg-neutral-bg border-neutral-border/40 rounded-xl py-3.5 px-4 text-sm font-medium focus:ring-4 focus:ring-brand-primary/10 focus:border-brand-primary transition-all", required: true %>
            </div>

            <div class="space-y-2">
              <%= f.label :guest_phone, "Phone Number", class: "block text-[10px] font-black uppercase tracking-[0.2em] text-neutral-text-secondary ml-1" %>
              <%= f.telephone_field :guest_phone, value: @booking.guest_phone, 
                    class: "w-full bg-neutral-bg border-neutral-border/40 rounded-xl py-3.5 px-4 text-sm font-medium focus:ring-4 focus:ring-brand-primary/10 focus:border-brand-primary transition-all", required: true %>
            </div>

            <div class="space-y-2">
              <%= f.label :guest_country, "Nationality", class: "block text-[10px] font-black uppercase tracking-[0.2em] text-neutral-text-secondary ml-1" %>
              <div class="relative" data-controller="searchable-select">
                <%= f.hidden_field :guest_country, value: @booking.guest_country.presence || "Malaysia", data: { searchable_select_target: "hiddenInput" } %>
                <div class="relative">
                  <input type="text" 
                         data-searchable-select-target="input"
                         data-action="input->searchable-select#filter focus->searchable-select#open"
                         placeholder="Search nationality..."
                         autocomplete="off"
                         class="w-full bg-neutral-bg border-neutral-border/40 rounded-xl py-3.5 px-4 pr-10 text-sm font-medium focus:ring-4 focus:ring-brand-primary/10 focus:border-brand-primary transition-all">
                  <div class="absolute inset-y-0 right-0 flex items-center pr-3 cursor-pointer" data-action="click->searchable-select#toggle">
                    <svg class="h-4 w-4 text-neutral-text-secondary" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 9l-7 7-7-7"/></svg>
                  </div>
                </div>
                
                <div data-searchable-select-target="options" class="hidden absolute z-50 mt-2 w-full bg-white border border-neutral-border/60 rounded-xl shadow-xl max-h-60 overflow-y-auto">
                  <div data-searchable-select-target="placeholder" class="hidden px-4 py-3 text-sm text-neutral-text-secondary italic">No results found</div>
                  <% country_options.each do |label, value| %>
                    <div class="px-4 py-3 text-sm font-medium text-neutral-text-primary hover:bg-neutral-bg cursor-pointer transition-colors border-b border-neutral-border/20 last:border-0"
                         data-action="click->searchable-select#select"
                         data-searchable-select-target="option"
                         data-value="<%= value %>"
                         data-label="<%= label %>">
                      <%= label %>
                    </div>
                  <% end %>
                </div>
              </div>
            </div>

            <div class="space-y-2">
              <%= f.label :guest_city, "City", class: "block text-[10px] font-black uppercase tracking-[0.2em] text-neutral-text-secondary ml-1" %>
              <%= f.text_field :guest_city, value: @booking.guest_city,
                    class: "w-full bg-neutral-bg border-neutral-border/40 rounded-xl py-3.5 px-4 text-sm font-medium focus:ring-4 focus:ring-brand-primary/10 focus:border-brand-primary transition-all",
                    required: true, placeholder: "e.g. Kuala Lumpur" %>
            </div>

            <div class="space-y-2">
              <%= f.label :guest_home_address, "Home Address", class: "block text-[10px] font-black uppercase tracking-[0.2em] text-neutral-text-secondary ml-1" %>
              <%= f.text_area :guest_home_address, value: @booking.guest_home_address,
                    class: "w-full bg-neutral-bg border-neutral-border/40 rounded-xl py-3.5 px-4 text-sm font-medium focus:ring-4 focus:ring-brand-primary/10 focus:border-brand-primary transition-all",
                    required: true, rows: 3, placeholder: "e.g. No. 12, Jalan Ampang, 50450 Kuala Lumpur" %>
            </div>
          </div>
        </div>

        <%# ID document photos %>
        <div class="rounded-2xl border border-neutral-border/50 bg-white p-6 shadow-sm space-y-6">
          <div>
            <h2 class="text-sm font-black uppercase tracking-[0.2em] text-neutral-text-primary">Identity Document</h2>
            <p class="text-[11px] text-neutral-text-secondary mt-2 leading-relaxed">Upload or scan your IC / passport.</p>
          </div>
          <div class="grid gap-4">
            <%= render "shared/id_scanner", f: f, field: :id_front, side: :front, label: "Front ID / Passport" %>
            <%= render "shared/id_scanner", f: f, field: :id_back, side: :back, label: "Back ID / Passport" %>
          </div>
        </div>

        <%# Guest signature %>
        <div class="rounded-2xl border border-neutral-border/50 bg-white p-6 shadow-sm space-y-4">
          <div>
            <h2 class="text-sm font-black uppercase tracking-[0.2em] text-neutral-text-primary">Guest Signature</h2>
            <p class="text-[11px] text-neutral-text-secondary mt-2 leading-relaxed">Sign below to confirm your check-in details.</p>
          </div>
          <div data-controller="signature" class="space-y-2">
            <div class="rounded-xl border border-neutral-border bg-white p-2">
              <canvas data-signature-target="canvas" class="w-full h-40 touch-none"></canvas>
            </div>
            <div class="flex justify-end">
              <button type="button" data-action="click->signature#clear" class="text-xs font-bold uppercase tracking-widest text-brand-primary hover:underline">
                Clear Signature
              </button>
            </div>
            <%= f.hidden_field :signature, data: { signature_target: "input" }, required: true %>
          </div>
        </div>
      <% end %>

      <%# Submit button positioned at the bottom %>
      <div class="fixed bottom-0 left-0 right-0 p-6 bg-landing-bg/95 backdrop-blur-md z-30">
        <%= submit_tag "CONFIRM CHECK IN",
              class: "w-full bg-brand-primary text-white font-black py-5 rounded-xl shadow-xl shadow-brand-primary/30 active:scale-[0.98] transition-all cursor-pointer tracking-widest text-sm" %>
      </div>
    <% end %>

    <%= render "shared/scanner_modal" %>
  </div>

</div>
