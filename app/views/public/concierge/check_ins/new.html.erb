<% content_for :title, "Check In | #{@hotel.name}" %>

<%# No booking is known yet, so there is no summary card: the heading keeps
    its back link on every width. %>
<%= render layout: "public/concierge/shared/form_layout",
           locals: {
             back_path: concierge_home_path(@hotel.unique_id, @hotel.public_id),
             back_label: "Back to Concierge",
             title: "Check in",
             subtitle: "Enter the code from your booking email."
           } do %>
  <%= render GuestUI::Notice.new(message: @error, variant: :danger) %>

  <%= form_with url: concierge_check_in_lookup_path(@hotel.unique_id, @hotel.public_id), method: :post do |form| %>
    <%= render GuestUI::FormField.new(form: form, attribute: :confirmation_token, label: "Confirmation code",
                                      hint: "It is in your booking email.", required: true,
                                      error: nil) do |field| %>
      <% field.with_input(variant: :code, value: params[:confirmation_token], placeholder: "AKWS4A") %>
    <% end %>

    <%= render GuestUI::Button.new(label: "Continue", size: :lg, block: true, class: "mt-5", type: "submit",
                                   data: { turbo_submits_with: "Checking…" }) %>
  <% end %>
<% end %>
