<% content_for :title, "Contact Us | #{@hotel.name}" %>

<div data-mobile-view class="min-h-screen bg-background flex flex-col font-sans">

  <%# Top nav %>
  <div class="px-6 pt-8 pb-6">
    <%= link_to concierge_home_path(@hotel.slug),
          class: "w-10 h-10 rounded-xl bg-primary flex items-center justify-center flex-shrink-0 shadow-lg shadow-primary/20 active:scale-90 transition-transform" do %>
      <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M15 19l-7-7 7-7"/>
      </svg>
    <% end %>
  </div>

  <%# Header Section %>
  <div class="px-6 pb-8">
    <h1 class="text-2xl font-black text-foreground leading-tight">
      Get in <span class="text-primary">touch?</span>
    </h1>
    <% if concierge_contact_address(@hotel).present? %>
      <p class="text-[13px] text-muted-foreground mt-3 font-medium leading-relaxed">
        <%= concierge_contact_address(@hotel) %>
      </p>
    <% else %>
      <p class="text-[13px] text-muted-foreground mt-3 font-medium leading-relaxed">
        We're here to help you with anything you need.
      </p>
    <% end %>
  </div>

  <div class="flex-1 px-6 space-y-4 pb-12">
    <% if @hotel.contact_phone.present? %>
      <a href="tel:<%= @hotel.contact_phone.gsub(/\s/, '') %>" class="group flex items-center gap-5 rounded-2xl border border-border/50 bg-white p-5 shadow-sm active:scale-[0.98] transition-all">
        <div class="w-12 h-12 rounded-xl bg-primary/5 text-primary flex items-center justify-center flex-shrink-0 group-active:bg-primary group-active:text-white transition-colors">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
        </div>
        <div>
          <p class="text-[10px] font-black uppercase tracking-[0.15em] text-muted-foreground">Call Us</p>
          <p class="text-sm font-bold text-foreground mt-0.5"><%= @hotel.contact_phone %></p>
        </div>
      </a>
    <% end %>

    <% if @whatsapp_link.present? %>
      <a href="<%= @whatsapp_link %>" target="_blank" rel="noopener noreferrer" class="group flex items-center gap-5 rounded-2xl border border-border/50 bg-white p-5 shadow-sm active:scale-[0.98] transition-all">
        <div class="w-12 h-12 rounded-xl bg-emerald-50 text-emerald-600 flex items-center justify-center flex-shrink-0 group-active:bg-emerald-600 group-active:text-white transition-colors">
          <svg class="w-6 h-6" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/></svg>
        </div>
        <div>
          <p class="text-[10px] font-black uppercase tracking-[0.15em] text-muted-foreground">WhatsApp</p>
          <p class="text-sm font-bold text-foreground mt-0.5"><%= @hotel.whatsapp_number.presence || @hotel.contact_phone %></p>
        </div>
      </a>
    <% end %>

    <% if @hotel.contact_email.present? %>
      <a href="mailto:<%= @hotel.contact_email %>" class="group flex items-center gap-5 rounded-2xl border border-border/50 bg-white p-5 shadow-sm active:scale-[0.98] transition-all">
        <div class="w-12 h-12 rounded-xl bg-blue-50 text-blue-600 flex items-center justify-center flex-shrink-0 group-active:bg-blue-600 group-active:text-white transition-colors">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
        </div>
        <div>
          <p class="text-[10px] font-black uppercase tracking-[0.15em] text-muted-foreground">Email</p>
          <p class="text-sm font-bold text-foreground mt-0.5 break-all"><%= @hotel.contact_email %></p>
        </div>
      </a>
    <% end %>

    <% if @maps_link.present? %>
      <a href="<%= @maps_link %>" target="_blank" rel="noopener noreferrer" class="group flex items-center gap-5 rounded-2xl border border-border/50 bg-white p-5 shadow-sm active:scale-[0.98] transition-all">
        <div class="w-12 h-12 rounded-xl bg-primary/5 text-primary flex items-center justify-center flex-shrink-0 group-active:bg-primary group-active:text-white transition-colors">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
        </div>
        <div>
          <p class="text-[10px] font-black uppercase tracking-[0.15em] text-muted-foreground">Location</p>
          <p class="text-sm font-bold text-foreground mt-0.5"><%= concierge_location_label(@hotel) %></p>
        </div>
      </a>
    <% end %>

    <% if @policy.present? && (@policy.check_in_time.present? || @policy.check_out_time.present?) %>
      <div class="rounded-2xl border border-border/50 bg-white p-6 shadow-sm space-y-4 mt-4">
        <p class="text-[10px] font-black uppercase tracking-[0.2em] text-muted-foreground border-b border-border/30 pb-3">Property Hours</p>
        <div class="grid grid-cols-2 gap-6">
          <% if @policy.check_in_time.present? %>
            <div>
              <p class="text-[9px] font-black uppercase tracking-[0.1em] text-muted-foreground">Check-in from</p>
              <p class="text-sm font-bold text-primary mt-1"><%= @policy.check_in_time %></p>
            </div>
          <% end %>
          <% if @policy.check_out_time.present? %>
            <div>
              <p class="text-[9px] font-black uppercase tracking-[0.1em] text-muted-foreground">Check-out by</p>
              <p class="text-sm font-bold text-primary mt-1"><%= @policy.check_out_time %></p>
            </div>
          <% end %>
        </div>
      </div>
    <% end %>

    <% if !@hotel.contact_phone.present? && !@whatsapp_link.present? && !@hotel.contact_email.present? %>
      <div class="rounded-2xl border border-border/50 bg-white p-10 text-center shadow-sm">
        <p class="text-sm font-medium text-muted-foreground">Please visit the front desk for assistance.</p>
      </div>
    <% end %>
  </div>

  <%# Footer Spacing %>
  <div class="pb-10"></div>

</div>
