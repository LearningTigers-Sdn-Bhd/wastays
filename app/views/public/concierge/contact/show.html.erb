<% content_for :title, "Contact | #{@hotel.name}" %>

<%# No stay is known here, so there is no summary card: the heading keeps its
    back link on every width, as on the check-in code page. Not a form, so
    the page takes the full width and the cards sit in two columns. %>
<%= render layout: "public/concierge/shared/form_layout",
           locals: {
             back_path: concierge_home_path(@hotel.unique_id, @hotel.public_id),
             back_label: "Back to Concierge",
             title: "Get in touch",
             wide: true,
             subtitle: concierge_contact_address(@hotel).presence || "We are here to help with anything you need."
           } do %>
  <%= render "public/concierge/contact/details", two_columns: true %>
<% end %>
