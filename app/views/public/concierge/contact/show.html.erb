<% content_for :title, "Contact | #{@hotel.name}" %>
<%= render layout: "public/concierge/shared/page_shell" do %>
  <%= render "public/concierge/shared/page_header",
             back_path: concierge_home_path(@hotel),
             back_label: "Back to Concierge",
             eyebrow: "Contact Us",
             title_prefix: "Get in",
             title_accent: "Touch",
             subtitle: concierge_contact_address(@hotel).presence || "We're here to help you with anything you need." %>

  <div class="space-y-4">
    <% [
      { show: @hotel.contact_phone.present?,
        href: "tel:#{@hotel.contact_phone.to_s.gsub(/\s/, '')}",
        external: false,
        tone: "bg-primary/5 text-primary group-hover:bg-primary group-hover:text-white group-active:bg-primary group-active:text-white",
        label: "Call Us",
        value: @hotel.contact_phone,
        icon: '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>' },
      { show: @whatsapp_link.present?,
        href: @whatsapp_link,
        external: true,
        tone: "bg-emerald-50 text-emerald-600 group-hover:bg-emerald-600 group-hover:text-white group-active:bg-emerald-600 group-active:text-white",
        label: "WhatsApp",
        value: @hotel.whatsapp_number.presence || @hotel.contact_phone,
        icon: '<path fill="currentColor" stroke="none" d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/>' },
      { show: @hotel.contact_email.present?,
        href: "mailto:#{@hotel.contact_email}",
        external: false,
        tone: "bg-blue-50 text-blue-600 group-hover:bg-blue-600 group-hover:text-white group-active:bg-blue-600 group-active:text-white",
        label: "Email",
        value: @hotel.contact_email,
        value_class: "break-all",
        icon: '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>' },
      { show: @maps_link.present?,
        href: @maps_link,
        external: true,
        tone: "bg-primary/5 text-primary group-hover:bg-primary group-hover:text-white group-active:bg-primary group-active:text-white",
        label: "Get Directions",
        value: concierge_location_label(@hotel),
        icon: '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>' }
    ].select { |card| card[:show] }.each do |card| %>
      <%= link_to card[:href],
            target: (card[:external] ? "_blank" : nil),
            rel: (card[:external] ? "noopener noreferrer" : nil),
            class: "group flex items-center gap-5 rounded-2xl border border-border/60 bg-white p-5 shadow-sm transition-all hover:shadow-md active:scale-[0.98]" do %>
        <div class="flex h-12 w-12 flex-shrink-0 items-center justify-center rounded-xl transition-colors <%= card[:tone] %>">
          <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><%= card[:icon].html_safe %></svg>
        </div>
        <div class="min-w-0">
          <p class="text-[10px] font-black uppercase tracking-[0.15em] text-muted-foreground"><%= card[:label] %></p>
          <p class="mt-0.5 text-sm font-bold text-foreground <%= card[:value_class] %>"><%= card[:value] %></p>
        </div>
      <% end %>
    <% end %>

    <% if @policy.present? && (@policy.check_in_time.present? || @policy.check_out_time.present?) %>
      <div class="mt-4 space-y-4 rounded-2xl border border-border/60 bg-white p-6 shadow-sm">
        <p class="border-b border-border/40 pb-3 text-[10px] font-black uppercase tracking-[0.2em] text-muted-foreground">Property Hours</p>
        <div class="grid grid-cols-2 gap-6">
          <% if @policy.check_in_time.present? %>
            <div>
              <p class="text-[9px] font-black uppercase tracking-[0.1em] text-muted-foreground">Check-in from</p>
              <p class="mt-1 text-sm font-bold text-primary"><%= @policy.check_in_time %></p>
            </div>
          <% end %>
          <% if @policy.check_out_time.present? %>
            <div>
              <p class="text-[9px] font-black uppercase tracking-[0.1em] text-muted-foreground">Check-out by</p>
              <p class="mt-1 text-sm font-bold text-primary"><%= @policy.check_out_time %></p>
            </div>
          <% end %>
        </div>
      </div>
    <% end %>

    <% if @hotel.contact_phone.blank? && @whatsapp_link.blank? && @hotel.contact_email.blank? %>
      <div class="rounded-2xl border border-border/60 bg-white p-10 text-center shadow-sm">
        <p class="text-sm font-medium text-muted-foreground">Please visit the front desk for assistance.</p>
      </div>
    <% end %>
  </div>
<% end %>
