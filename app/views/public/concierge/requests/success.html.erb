<% content_for :title, "Request Submitted! | #{@hotel.name}" %>

<%# Full-bleed like the checkout confirmation, and for the same reason: the
    request is in, so Done is the only thing left to do. %>
<div data-controller="scroll-reveal"
     class="flex min-h-screen flex-col bg-primary font-sans">

  <div class="flex flex-1 flex-col items-center justify-center px-6 py-12 text-center">

    <div class="relative mb-8" data-animate="scale-in">
      <div class="absolute inset-0 scale-150 rounded-full bg-white/10 blur-2xl"></div>
      <div class="relative flex h-24 w-24 items-center justify-center rounded-full border-4 border-white shadow-2xl">
        <svg class="h-12 w-12 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"/>
        </svg>
      </div>
    </div>

    <div data-animate style="transition-delay: 0.1s" class="mb-8">
      <h1 class="mb-2 text-3xl font-black leading-tight text-white">
        Request Sent!
      </h1>
      <p class="text-[13px] font-medium leading-relaxed text-white/70">
        Our team has been notified. We will attend to <br>
        your request at <span class="font-bold text-white"><%= @hotel.name %></span> shortly.
      </p>
    </div>

    <% if flash[:concierge_request_kind].present? || flash[:concierge_request_details].present? %>
      <div class="mx-auto mb-8 w-full max-w-[300px] space-y-4 rounded-2xl border border-white/10 bg-white/5 p-5 text-left" data-animate style="transition-delay: 0.2s">
        <div class="flex items-start justify-between gap-4">
          <div>
            <p class="mb-1 text-[8px] font-black uppercase tracking-[0.2em] text-white/40">Request Type</p>
            <p class="text-[11px] font-bold uppercase text-white"><%= flash[:concierge_request_kind].to_s.titleize %></p>
          </div>
          <div class="text-right">
            <p class="mb-1 text-[8px] font-black uppercase tracking-[0.2em] text-white/40">Time</p>
            <p class="font-mono text-[11px] font-bold text-accent"><%= Time.current.strftime("%I:%M %p") %></p>
          </div>
        </div>

        <% if flash[:concierge_request_details].present? %>
          <div class="border-t border-white/10 pt-3">
            <p class="mb-1.5 text-[8px] font-black uppercase tracking-[0.2em] text-white/40">Details</p>
            <p class="line-clamp-3 text-[11px] font-medium italic leading-relaxed text-white/90">
              "<%= flash[:concierge_request_details] %>"
            </p>
          </div>
        <% end %>
      </div>
    <% end %>

    <div class="mx-auto w-full max-w-[300px] space-y-3 rounded-2xl border border-white/10 bg-white/5 p-5 text-left" data-animate style="transition-delay: 0.3s">
      <div class="flex items-center justify-between gap-4">
        <div>
          <p class="mb-0.5 text-[8px] font-black uppercase tracking-[0.2em] text-white/40">Guest</p>
          <p class="text-[11px] font-bold uppercase text-white"><%= @booking.guest_name %></p>
        </div>
        <div class="text-right">
          <p class="mb-0.5 text-[8px] font-black uppercase tracking-[0.2em] text-white/40">Room</p>
          <p class="text-[11px] font-bold text-white"><%= @booking.room_numbers.presence || "LOBBY" %></p>
        </div>
      </div>
    </div>

  </div>

  <div class="p-6 pb-12" data-animate style="transition-delay: 0.4s">
    <%= link_to concierge_home_path(@hotel),
          class: "mx-auto block w-full max-w-sm rounded-xl bg-white py-4.5 text-center text-sm font-black uppercase tracking-[0.2em] text-primary shadow-2xl transition-all hover:shadow-xl active:scale-[0.98]" do %>
      Done
    <% end %>
  </div>

</div>
