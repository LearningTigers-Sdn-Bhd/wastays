<% content_for :title, "New Request | #{@hotel.name}" %>

<div data-mobile-view class="min-h-screen bg-background flex flex-col font-sans">

  <%= render "public/concierge/shared/back_button",
             back_path: concierge_home_path(@hotel),
             back_label: "Back to Concierge",
             wrapper_class: "px-6 pt-8 pb-6 flex" %>

  <%= render "public/concierge/shared/page_title",
             tag: "h1",
             wrapper_class: "px-6 pb-4",
             title_prefix: "Submit a",
             title_accent: "request?",
             subtitle: (@booking.present? ? "Tell us how we can help you today." : "Enter your reservation number to start.") %>

  <div class="flex-1 px-6 space-y-6 pb-32">
    <%= render "public/concierge/shared/error_alert", message: @error %>

    <% if @booking.present? %>
      <%# Booking summary card - "Ticket" style %>
      <div class="rounded-2xl border border-border/50 bg-white p-6 shadow-sm overflow-hidden relative">
        <div class="flex items-center gap-4 mb-5 pb-5 border-b border-dashed border-border/80">
          <div class="w-12 h-12 rounded-xl bg-primary/5 text-primary flex items-center justify-center">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/></svg>
          </div>
          <div>
            <p class="text-[10px] font-black uppercase tracking-[0.15em] text-muted-foreground">Guest Name</p>
            <p class="text-xs font-bold text-foreground mt-0.5"><%= @booking.guest_name %></p>
          </div>
        </div>
        
        <div class="space-y-3">
          <div class="flex items-center justify-between gap-4">
            <div>
              <p class="text-[10px] font-black uppercase tracking-[0.2em] text-muted-foreground mb-1">Reservation No.</p>
              <p class="text-xs font-mono font-bold text-primary"><%= @booking.confirmation_token %></p>
            </div>
            <div class="text-right">
              <p class="text-[10px] font-black uppercase tracking-[0.2em] text-muted-foreground mb-1">Room No.</p>
              <p class="text-xs font-bold text-foreground">
                <%= @booking.room_numbers.presence || "ASSIGNING" %>
              </p>
            </div>
          </div>
        </div>
      </div>
    <% end %>

    <%= form_with url: concierge_requests_path(@hotel), method: :post, class: "space-y-6" do |f| %>
      <% if @booking.present? %>
        <%= hidden_field_tag :confirmation_token, @booking.confirmation_token %>
        <%= hidden_field_tag :stage, "submit" %>
        
        <div class="rounded-2xl border border-border/50 bg-white p-6 shadow-sm space-y-6">
          <div class="space-y-2">
            <label class="block text-[10px] font-black uppercase tracking-[0.2em] text-muted-foreground ml-1">Request Type</label>
            <div class="relative" data-controller="searchable-select">
              <%= hidden_field_tag :kind, params[:kind], data: { searchable_select_target: "hiddenInput" } %>
              <div class="relative cursor-pointer" data-action="click->searchable-select#toggle">
                <input type="text" readonly 
                       data-searchable-select-target="input"
                       placeholder="Select type..."
                       class="w-full bg-muted border-border/40 rounded-xl py-3.5 px-4 pr-10 text-sm font-medium focus:ring-4 focus:ring-primary/10 focus:border-primary transition-all cursor-pointer">
                <div class="absolute inset-y-0 right-0 flex items-center pr-3 pointer-events-none">
                  <svg class="h-4 w-4 text-muted-foreground" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 9l-7 7-7-7"/></svg>
                </div>
              </div>
              
              <div data-searchable-select-target="options" class="hidden absolute z-50 mt-2 w-full bg-white border border-border/60 rounded-xl shadow-xl max-h-60 overflow-y-auto">
                <% [["Housekeeping", "housekeeping"], ["Complaint / Feedback", "complaint"]].each do |label, value| %>
                  <div class="px-4 py-3 text-sm font-medium text-foreground hover:bg-muted cursor-pointer transition-colors border-b border-border/20 last:border-0"
                       data-action="click->searchable-select#select"
                       data-searchable-select-target="option"
                       data-value="<%= value %>"
                       data-label="<%= label %>">
                    <%= label %>
                  </div>
                <% end %>
              </div>
            </div>
          </div>

          <div class="space-y-2">
            <label class="block text-[10px] font-black uppercase tracking-[0.2em] text-muted-foreground ml-1">Details <span class="text-red-500">*</span></label>
            <%= text_area_tag :details, params[:details], rows: 4, 
                  class: "w-full bg-muted border-border/40 rounded-xl py-3.5 px-4 text-sm font-medium focus:ring-4 focus:ring-primary/10 focus:border-primary transition-all shadow-none",
                  required: true, placeholder: "Describe your request..." %>
          </div>
        </div>

        <%# Fixed Bottom Button %>
        <div class="fixed bottom-0 left-0 right-0 p-6 bg-background/95 backdrop-blur-md z-30">
          <%= submit_tag "SUBMIT REQUEST",
                class: "w-full bg-primary text-white font-black py-5 rounded-xl shadow-xl shadow-primary/30 active:scale-[0.98] transition-all cursor-pointer tracking-widest text-sm" %>
        </div>
      <% else %>
        <div class="space-y-2">
          <%= label_tag :confirmation_token, "Confirmation Code", class: "ml-1 block text-[10px] font-black uppercase tracking-[0.2em] text-muted-foreground" %>
          <%= text_field_tag :confirmation_token, params[:confirmation_token], 
                class: "w-full bg-white border-border/60 rounded-xl py-4 px-5 text-sm shadow-sm focus:ring-4 focus:ring-primary/10 focus:border-primary transition-all placeholder:text-muted-foreground/40",
                placeholder: "e.g. AKWS4A", 
                autocapitalize: "characters", required: true %>
        </div>
        <%= hidden_field_tag :stage, "lookup" %>

        <%# Fixed Bottom Button %>
        <div class="fixed bottom-0 left-0 right-0 p-6 bg-background">
          <%= submit_tag "CONTINUE",
                class: "w-full bg-primary text-white font-black py-5 rounded-xl shadow-xl shadow-primary/30 active:scale-[0.98] transition-all cursor-pointer tracking-widest text-sm" %>
        </div>
      <% end %>
    <% end %>
  </div>

  <%# Spacing for fixed bottom button %>
  <div class="h-28"></div>

</div>
