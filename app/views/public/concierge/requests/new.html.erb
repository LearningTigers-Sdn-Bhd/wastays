<% content_for :title, "Request | #{@hotel.name}" %>
<%= render layout: "public/concierge/shared/page_shell" do %>
  <%= render "public/concierge/shared/page_header",
             back_path: concierge_home_path(@hotel.slug),
             back_label: "Back to Concierge",
             eyebrow: "Request",
             title_prefix: "Submit a",
             title_accent: "Request" %>
  <%= render "public/concierge/shared/error_alert", message: @error %>

  <div class="space-y-4 rounded-2xl border border-border bg-white p-4 shadow-sm sm:p-5">
    <p class="text-xs text-muted-foreground">Enter your booking details to continue.</p>

    <% if @booking.present? %>
      <%= render "public/concierge/shared/booking_summary",
                 booking: @booking,
                 label: "Your Booking" %>
    <% end %>

    <%= form_with url: concierge_requests_path(@hotel.slug), method: :post, class: "space-y-4" do %>
      <% if @booking.present? %>
        <%= hidden_field_tag :confirmation_token, @booking.confirmation_token %>
        <%= hidden_field_tag :stage, "submit" %>
        <div class="space-y-4 rounded-2xl border border-border bg-white p-4 shadow-sm sm:p-5">
          <div>
            <label class="mb-2 block text-xs font-bold uppercase tracking-widest text-muted-foreground">Request Type</label>
            <%= select_tag :kind, options_for_select([["Housekeeping", "housekeeping"], ["Complaint / Feedback", "complaint"]], params[:kind]), class: "form-input px-4 py-3", required: true %>
          </div>
          <div>
            <label class="mb-2 block text-xs font-bold uppercase tracking-widest text-muted-foreground">Details <span class="text-red-500">*</span></label>
            <%= text_area_tag :details, params[:details], rows: 4, class: "form-input px-4 py-3", required: true, placeholder: "Describe your request..." %>
          </div>
        </div>
        <%= submit_tag "Submit Request →", class: "btn btn-primary w-full cursor-pointer py-3 text-sm font-black uppercase tracking-widest" %>
      <% else %>
        <div>
          <label class="mb-2 block text-xs font-bold uppercase tracking-widest text-muted-foreground">Confirmation Code</label>
          <%= text_field_tag :confirmation_token, params[:confirmation_token], class: "form-input px-4 py-3 uppercase", placeholder: "e.g. AKWS4A", autocapitalize: "characters", required: true %>
        </div>
        <%= hidden_field_tag :stage, "lookup" %>
        <%= submit_tag "Continue →", class: "btn btn-primary w-full cursor-pointer py-3 text-sm font-black uppercase tracking-widest" %>
      <% end %>
    <% end %>
  </div>
<% end %>
