<% content_for :title, "Request Submitted! | #{@hotel.name}" %>

<div data-mobile-view 
     data-controller="scroll-reveal"
     class="h-screen bg-primary flex flex-col font-sans overflow-hidden">

  <div class="flex-1 flex flex-col items-center justify-center px-6 text-center pt-8">
    
    <%# Large Success Icon %>
    <div class="relative mb-8" data-animate="scale-in">
      <div class="absolute inset-0 bg-white/10 rounded-full blur-2xl scale-150"></div>
      <div class="relative w-24 h-24 rounded-full border-4 border-white flex items-center justify-center shadow-2xl">
        <svg class="w-12 h-12 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"/>
        </svg>
      </div>
    </div>

    <%# Success Content %>
    <div data-animate style="transition-delay: 0.1s" class="mb-8">
      <h1 class="text-3xl font-black text-white leading-tight mb-2">
        Request Sent!
      </h1>
      <p class="text-white/70 text-[13px] leading-relaxed font-medium">
        Our team has been notified. We will attend to <br>
        your request at <span class="font-bold text-white"><%= @hotel.name %></span> shortly.
      </p>
    </div>

    <%# Request Details Display %>
    <% if flash[:concierge_request_kind].present? || flash[:concierge_request_details].present? %>
      <div class="w-full max-w-[300px] mx-auto bg-white/5 border border-white/10 rounded-2xl p-5 text-left space-y-4 mb-8" data-animate style="transition-delay: 0.2s">
        <div class="flex justify-between items-start gap-4">
          <div>
            <p class="text-[8px] font-black uppercase tracking-[0.2em] text-white/40 mb-1">Request Type</p>
            <p class="text-[11px] font-bold text-white uppercase"><%= flash[:concierge_request_kind].to_s.titleize %></p>
          </div>
          <div class="text-right">
            <p class="text-[8px] font-black uppercase tracking-[0.2em] text-white/40 mb-1">Time</p>
            <p class="text-[11px] font-mono font-bold text-accent"><%= Time.current.strftime("%I:%M %p") %></p>
          </div>
        </div>
        
        <% if flash[:concierge_request_details].present? %>
          <div class="pt-3 border-t border-white/10">
            <p class="text-[8px] font-black uppercase tracking-[0.2em] text-white/40 mb-1.5">Details</p>
            <p class="text-[11px] font-medium text-white/90 line-clamp-3 leading-relaxed italic italic">
              "<%= flash[:concierge_request_details] %>"
            </p>
          </div>
        <% end %>
      </div>
    <% end %>

    <%# Guest Info Card - Compact %>
    <div class="w-full max-w-[300px] mx-auto bg-white/5 border border-white/10 rounded-2xl p-5 text-left space-y-3" data-animate style="transition-delay: 0.3s">
      <div class="flex justify-between items-center gap-4">
        <div>
          <p class="text-[8px] font-black uppercase tracking-[0.2em] text-white/40 mb-0.5">Guest</p>
          <p class="text-[11px] font-bold text-white uppercase"><%= @booking.guest_name %></p>
        </div>
        <div class="text-right">
          <p class="text-[8px] font-black uppercase tracking-[0.2em] text-white/40 mb-0.5">Room</p>
          <p class="text-[11px] font-bold text-white"><%= @booking.room_numbers.presence || "LOBBY" %></p>
        </div>
      </div>
    </div>

  </div>

  <%# Fixed Bottom Button %>
  <div class="p-6 pb-12" data-animate style="transition-delay: 0.4s">
    <%= link_to concierge_home_path(@hotel.slug), 
          class: "block w-full bg-white text-primary font-black py-4.5 rounded-xl shadow-2xl active:scale-[0.98] transition-all text-center tracking-[0.2em] text-sm uppercase" do %>
      Done
    <% end %>
  </div>

</div>
