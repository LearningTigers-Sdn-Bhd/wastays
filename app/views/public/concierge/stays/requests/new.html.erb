<% housekeeping = @kind == "housekeeping" %>
<% content_for :title, "#{housekeeping ? 'Housekeeping' : 'Report a problem'} | #{@hotel.name}" %>

<%= render layout: "public/concierge/stays/shared/form_page",
           locals: {
             presenter: @presenter,
             error: @error,
             title: housekeeping ? "Ask for housekeeping" : "Report a problem",
             subtitle: housekeeping ? "Tell us what you need in your room." : "Tell us what is wrong and we will put it right."
           } do %>
  <%= form_with url: concierge_stay_requests_path(*stay_route_args), method: :post, local: true do |form| %>
    <%= hidden_field_tag :kind, @kind %>

    <%= form.label :details, housekeeping ? "What do you need?" : "What is wrong?",
          class: "block text-[10px] font-black uppercase tracking-[0.2em] text-muted-foreground" %>
    <%= form.text_area :details,
          value: params[:details],
          rows: 5,
          autofocus: true,
          class: "mt-3 w-full rounded-xl border border-border bg-background px-4 py-3 text-[14px] font-medium leading-relaxed text-foreground focus:border-primary focus:outline-none focus:ring-2 focus:ring-primary/20" %>

    <%= form.submit "Send to the hotel",
          class: "mt-5 min-h-[44px] w-full cursor-pointer rounded-xl bg-primary px-6 py-4 text-[12px] font-black uppercase tracking-widest text-primary-foreground shadow-md transition-all hover:bg-primary-hover active:scale-[0.98]" %>
  <% end %>
<% end %>
