<% housekeeping = @kind == "housekeeping" %>
<% content_for :title, "#{housekeeping ? 'Housekeeping' : 'Report a problem'} | #{@hotel.name}" %>

<%= render layout: "public/concierge/stays/shared/form_page",
           locals: {
             presenter: @presenter,
             error: @error,
             title: housekeeping ? "Ask for housekeeping" : "Report a problem",
             subtitle: housekeeping ? "Tell us what you need in your room." : "Tell us what is wrong and we will put it right."
           } do %>
  <%= form_with url: concierge_stay_requests_path(*stay_route_args), method: :post, local: true do |form| %>
    <%= hidden_field_tag :kind, @kind %>

    <%= render GuestUI::FormField.new(form: form, attribute: :details,
                                      label: housekeeping ? "What do you need?" : "What is wrong?",
                                      required: true) do |field| %>
      <% field.with_text_area(rows: 5, value: params[:details],
                              placeholder: housekeeping ? "For example: two more towels, and clean the room after 2 pm" : "For example: the air conditioning does not cool the room") %>
    <% end %>

    <%= render GuestUI::Button.new(label: "Send to the hotel", size: :lg, block: true,
                                   class: "mt-5", type: "submit",
                                   data: { turbo_submits_with: "Sending…" }) %>
  <% end %>
<% end %>
