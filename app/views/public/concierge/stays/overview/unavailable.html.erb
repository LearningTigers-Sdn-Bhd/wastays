<%# A neutral page. It says nothing about the booking or the guest, because a
    stranger can reach this URL with a revoked or expired link. %>
<% content_for :title, "Stay not available | #{@hotel.name}" %>
<%= render layout: "public/concierge/shared/page_shell",
           locals: { content_class: "flex-1 flex items-center justify-center px-4 py-10 sm:px-6",
                     container_class: "w-full max-w-xl" } do %>
  <%= render "public/concierge/shared/page_header",
             back: false,
             eyebrow: "Stay Page",
             title_prefix: "This link is not",
             title_accent: "Available",
             subtitle: "The link has ended. Please contact the front desk for help." %>

  <div class="mt-6 text-center">
    <%= link_to "Go to the concierge home",
          concierge_home_path(@hotel.unique_id, @hotel.public_id),
          class: "font-bold text-primary underline underline-offset-4" %>
  </div>
<% end %>
