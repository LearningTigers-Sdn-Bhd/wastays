<%# The locked stay page. Same hero and same two columns as the verified page,
    but the left column explains the access instead of showing the stay. It
    names the hotel, which the QR code already makes public, and nothing about
    the guest, the room, the dates, the status, or the money. %>
<% content_for :title, "Your stay | #{@hotel.name}" %>

<%= render GuestUI::Page.new do |page| %>
  <% page.with_hero do %>
    <%= render "public/concierge/shared/hero" %>
  <% end %>
  <% page.with_context do %>
    <%= render GuestUI::Card.new(title: "About This Access") do %>
      <p class="text-[13px] font-medium leading-relaxed text-foreground">
        This link gives access to one hotel stay.
      </p>
      <p class="mt-3 text-[11px] font-medium leading-relaxed text-muted-foreground">
        Your stay details stay hidden until you verify this device. You do this one
        time on each device you use.
      </p>
    <% end %>
  <% end %>

  <%= render "public/concierge/stays/shared/page_heading",
             title: "Open your",
             title_accent: "Stay",
             subtitle: "Enter the confirmation code from your booking email." %>

  <%= render GuestUI::Notice.new(message: @error, variant: :danger) %>
  <%= render GuestUI::Notice.new(message: @notice, variant: :success) %>

  <% if @locked %>
    <%# The way out of a lock. The mail goes to the booking email, which the
        guest never types here. %>
    <%= render GuestUI::Card.new do %>
      <p class="text-[13px] font-medium leading-relaxed text-foreground">
        This stay page is locked. We can send a new link to the email on the booking.
      </p>
      <%= render GuestUI::Button.new(
            label: "Email me a new link",
            href: concierge_stay_recovery_path(*stay_route_args),
            method: :post,
            size: :lg,
            block: true,
            class: "mt-5") %>
    <% end %>
  <% else %>
    <%= render GuestUI::Card.new do %>
      <%= form_with url: concierge_stay_verification_path(*stay_route_args), method: :post, local: true do |form| %>
        <%= render GuestUI::FormField.new(form: form, attribute: :confirmation_token,
                                          label: "Booking confirmation code") do |field| %>
          <% field.with_input(variant: :code, size: :lg, value: nil, autofocus: true) %>
        <% end %>

        <%= render GuestUI::Button.new(label: "Verify this device", size: :lg, block: true,
                                       class: "mt-5", type: "submit") %>
      <% end %>
    <% end %>
  <% end %>

  <p class="text-center text-[11px] font-medium leading-relaxed text-muted-foreground">
    Cannot find your code?
    <%= link_to "Contact the front desk", concierge_contact_path(@hotel.unique_id, @hotel.public_id),
          class: "font-bold text-primary underline underline-offset-4" %>.
  </p>
<% end %>
