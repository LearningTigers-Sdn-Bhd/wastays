<% content_for :title, "Your stay | #{@hotel.name}" %>
<% presenter = @presenter %>

<%= render GuestUI::Page.new do |page| %>
  <% page.with_hero do %>
    <%= render "public/concierge/shared/hero" %>
  <% end %>
  <% page.with_context do %>
    <%= render "public/concierge/stays/shared/stay_details", presenter: presenter %>
  <% end %>

  <%= render "public/concierge/stays/shared/page_heading",
             title: "Hello,",
             title_accent: presenter.greeting_name,
             subtitle: "What do you need?" %>

  <%# Primary actions. Two tiles, because these are the two a guest reaches for
      most while in house. %>
  <% if presenter.in_house? %>
    <div class="grid grid-cols-2 gap-3.5 md:gap-4">
      <% if presenter.can_send_request? %>
        <%= render "public/concierge/stays/shared/primary_tile",
                   tone: :primary,
                   icon: "sparkles",
                   label: "Housekeeping",
                   path: concierge_new_stay_request_path(*stay_route_args, kind: "housekeeping") %>
      <% end %>

      <% if presenter.can_request_check_out? %>
        <%= render "public/concierge/stays/shared/primary_tile",
                   icon: "log-out",
                   label: "Check Out",
                   path: stay_check_out_path %>
      <% elsif presenter.check_out_pending? %>
        <%= render "public/concierge/stays/shared/primary_tile",
                   pending: true,
                   icon: "circle-check",
                   label: "Check-out asked" %>
      <% end %>
    </div>
  <% end %>

  <%# Stay controls. %>
  <% if presenter.can_toggle_do_not_disturb? %>
    <%= render GuestUI::Card.new do %>
      <div class="flex items-center justify-between gap-4">
        <span>
          <span class="block text-[13px] font-bold text-foreground">Do not disturb</span>
          <span class="mt-0.5 block text-[11px] font-medium text-muted-foreground">Housekeeping will keep away from your room.</span>
        </span>
        <%= render GuestUI::Button.new(
              label: "Switch",
              href: concierge_stay_do_not_disturb_path(*stay_route_args),
              method: :patch,
              variant: :secondary,
              size: :sm) %>
      </div>
    <% end %>
  <% end %>

  <%# Secondary services. %>
  <%= render GuestUI::Card.new(title: "Hotel Services") do |card| %>
    <% if presenter.can_send_request? %>
      <% card.with_row label: "Report a problem",
                       hint: "Tell the hotel team what is wrong.",
                       href: concierge_new_stay_request_path(*stay_route_args, kind: "complaint") %>
    <% end %>
    <% card.with_row label: "Recommendations and offers",
                     href: concierge_recommendations_path(@hotel.unique_id, @hotel.public_id) %>
    <% card.with_row label: "Contact the front desk",
                     href: concierge_contact_path(@hotel.unique_id, @hotel.public_id) %>
    <% if presenter.chat_available? %>
      <% card.with_row label: "Chat with us",
                       href: concierge_chat_path(@hotel.unique_id, @hotel.public_id) %>
    <% end %>
  <% end %>

  <%# Booking documents and money. Last, because a guest reaches for these once. %>
  <%= render GuestUI::Card.new(title: "Booking and Billing") do |card| %>
    <% card.with_row label: "Booking receipt", hint: "PDF", href: stay_document_path(:receipt) %>
    <% if presenter.invoice_available? %>
      <% card.with_row label: "Invoice", hint: "PDF", href: stay_document_path(:invoice) %>
    <% end %>
    <% card.with_row label: "E-invoice",
                     hint: presenter.e_invoice_ready? ? "Ready to download" : nil,
                     href: stay_e_invoice_path %>
    <% if presenter.can_request_refund? %>
      <% card.with_row label: "Ask for a refund",
                       hint: "The hotel replies to you.",
                       href: stay_refund_path %>
    <% elsif presenter.refund_request %>
      <% card.with_row label: "Your refund request",
                       hint: presenter.refund_request.status.humanize,
                       href: stay_refund_path %>
    <% end %>
  <% end %>
<% end %>
