<% content_for :title, "Ask for a refund | #{@hotel.name}" %>
<% existing = @presenter.refund_request %>

<%= render layout: "public/concierge/stays/shared/form_page",
           locals: {
             presenter: @presenter,
             error: @error,
             title: "Ask for a refund",
             subtitle: "This is a request, not a payment. The hotel reads it and replies to you."
           } do %>
  <% if existing && !existing.rejected? %>
    <dl class="space-y-4">
      <div>
        <dt class="text-[11px] font-medium text-muted-foreground">Status</dt>
        <dd class="text-lg font-black text-foreground"><%= existing.status.humanize %></dd>
      </div>
      <div>
        <dt class="text-[11px] font-medium text-muted-foreground">Amount asked</dt>
        <dd class="text-[13px] font-bold text-foreground"><%= @presenter.booking.currency %> <%= number_with_precision(existing.refund_amount, precision: 2) %></dd>
      </div>
      <% if existing.hotel_note.present? %>
        <div>
          <dt class="text-[11px] font-medium text-muted-foreground">From the hotel</dt>
          <dd class="text-[13px] font-medium leading-relaxed text-foreground"><%= existing.hotel_note %></dd>
        </div>
      <% end %>
    </dl>
  <% else %>
    <% if existing&.rejected? && existing.hotel_note.present? %>
      <p class="mb-5 rounded-xl border border-border/60 bg-background p-4 text-[12px] font-medium leading-relaxed text-foreground">
        The hotel asked for a change: <%= existing.hotel_note %>
      </p>
    <% end %>

    <%= form_with model: @refund_request, url: concierge_stay_refunds_path(*stay_route_args),
          scope: :refund_request, method: :post, local: true, class: "space-y-5" do |form| %>
      <div>
        <%= form.label :refund_amount, "How much are you asking for?",
              class: "block text-[10px] font-black uppercase tracking-[0.2em] text-muted-foreground" %>
        <%= form.number_field :refund_amount,
              value: params.dig(:refund_request, :refund_amount),
              step: "0.01", min: "0.01", max: @presenter.booking.total_amount,
              autofocus: true,
              class: "mt-3 min-h-[44px] w-full rounded-xl border border-border bg-background px-4 py-3 text-[16px] font-bold text-foreground focus:border-primary focus:outline-none focus:ring-2 focus:ring-primary/20" %>
        <p class="mt-2 text-[11px] font-medium text-muted-foreground">
          You paid <%= @presenter.booking.currency %> <%= number_with_precision(@presenter.booking.total_amount, precision: 2) %> for this stay.
        </p>
      </div>

      <div>
        <%= form.label :reason, "Why are you asking?",
              class: "block text-[10px] font-black uppercase tracking-[0.2em] text-muted-foreground" %>
        <%= form.text_area :reason, rows: 4,
              class: "mt-3 w-full rounded-xl border border-border bg-background px-4 py-3 text-[14px] font-medium leading-relaxed text-foreground focus:border-primary focus:outline-none focus:ring-2 focus:ring-primary/20" %>
      </div>

      <div class="space-y-4 border-t border-border/60 pt-5">
        <p class="text-[10px] font-black uppercase tracking-[0.2em] text-muted-foreground">Where the money goes</p>

        <% { bank_name: "Bank name", account_holder_name: "Account holder name", account_number: "Account number" }.each do |field, label| %>
          <div>
            <%= form.label field, label, class: "block text-[11px] font-bold text-foreground" %>
            <%= form.text_field field,
                  class: "mt-2 min-h-[44px] w-full rounded-xl border border-border bg-background px-4 py-3 text-[14px] font-medium text-foreground focus:border-primary focus:outline-none focus:ring-2 focus:ring-primary/20" %>
          </div>
        <% end %>

        <div>
          <p class="text-[11px] font-bold text-foreground">Account type</p>
          <div class="mt-2 flex gap-3">
            <% RefundRequest::ACCOUNT_TYPES.each do |type| %>
              <label class="flex min-h-[44px] flex-1 cursor-pointer items-center justify-center gap-2 rounded-xl border border-border bg-background px-4 text-[12px] font-bold capitalize text-foreground has-checked:border-primary has-checked:bg-primary/5 has-checked:text-primary">
                <%= form.radio_button :account_type, type, class: "accent-primary" %>
                <%= type %>
              </label>
            <% end %>
          </div>
        </div>
      </div>

      <%= form.submit "Send my request",
            class: "min-h-[44px] w-full cursor-pointer rounded-xl bg-primary px-6 py-4 text-[12px] font-black uppercase tracking-widest text-primary-foreground shadow-md transition-all hover:bg-primary-hover active:scale-[0.98]" %>
    <% end %>
  <% end %>
<% end %>
