<%# The stay page shell from docs/guest-concierge/LAYOUTING.md.
    Row 1 is the shared hotel hero. Row 2 is one centred container with two
    columns: stay context at about one third, actions at about two thirds.
    Mobile stacks them, and the DOM order already matches that reading order,
    so the grid never moves focus.

    Prototype markup. It reuses the Public Concierge partials and classes and
    adds no component and no colour token. A later session owns the visual
    system, the container width, and the breakpoint. %>
<div class="flex min-h-screen flex-col overflow-x-hidden bg-background font-sans">
  <%= render "public/concierge/shared/hero" %>

  <div class="mx-auto w-full max-w-5xl px-6 pb-12 pt-6 md:px-10 md:pt-10 md:pb-20">
    <div class="grid items-start gap-6 md:grid-cols-3 md:gap-8">
      <%# Column 1 answers "What is my stay?" %>
      <div class="md:col-span-1"><%= yield :context %></div>

      <%# Column 2 answers "What can I do?" %>
      <div class="md:col-span-2 space-y-6"><%= yield :actions %></div>
    </div>
  </div>

  <div class="mt-auto px-4 pb-10 text-center">
    <div class="mx-auto mb-6 h-px w-12 bg-border"></div>
    <p class="text-[10px] font-black uppercase tracking-[0.25em] text-muted-foreground opacity-60">Powered by WAStays</p>
  </div>
</div>
