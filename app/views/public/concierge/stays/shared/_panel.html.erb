<%# One bordered block. Every column section uses it, so the columns align at
    the top and the spacing stays in one place. %>
<section class="rounded-2xl border border-border/60 bg-white p-6 shadow-sm">
  <% if local_assigns[:title].present? %>
    <h2 class="text-[10px] font-black uppercase tracking-[0.2em] text-muted-foreground"><%= title %></h2>
    <div class="mt-4"><%= yield %></div>
  <% else %>
    <%= yield %>
  <% end %>
</section>
