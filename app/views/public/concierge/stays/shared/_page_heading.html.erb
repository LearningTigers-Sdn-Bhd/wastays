<%# The heading of a stay page: the serif line the guest reads first, and the
    sentence under it. A back link goes above it when the page is not the stay
    itself, so the way out sits before the title rather than after the form. %>
<div>
  <% if local_assigns[:back_path].present? %>
    <%= link_to local_assigns[:back_path],
          class: "inline-flex min-h-11 items-center gap-1.5 text-[11px] font-black uppercase tracking-widest text-muted-foreground transition-colors hover:text-primary" do %>
      <%= app_icon "chevron-left", class: "size-3.5", aria: { hidden: "true" } %>
      <%= local_assigns.fetch(:back_label, "Back to my stay") %>
    <% end %>
  <% end %>

  <h2 class="<%= local_assigns[:back_path].present? ? "mt-2" : "" %> font-serif text-2xl text-foreground md:text-3xl">
    <%= title %><% if local_assigns[:title_accent].present? %> <span class="italic text-primary"><%= title_accent %></span><% end %>
  </h2>

  <% if local_assigns[:subtitle].present? %>
    <p class="mt-1.5 text-xs font-medium leading-relaxed text-muted-foreground md:text-sm"><%= subtitle %></p>
  <% end %>
</div>
