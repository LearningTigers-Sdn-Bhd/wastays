<%# The two immediate stay actions, side by side on a phone. The tile stacks
    the icon over the text so the label keeps its width at half a screen. A
    pending request keeps its place without offering a second link. %>
<%
  tone = local_assigns.fetch(:tone, :secondary)
  pending = local_assigns.fetch(:pending, false)
  surface = if pending
    "border border-dashed border-border bg-card"
  elsif tone == :primary
    "guest-service-surface transition-colors"
  else
    "guest-stay-action--secondary"
  end
  primary = tone == :primary && !pending
  caption = primary ? "guest-primary-action__label" : "text-foreground"
  description_color = primary ? "guest-primary-action__hint" : "text-muted-foreground"
  icon_color = primary ? "guest-service-surface__icon" : "text-primary"
%>
<% tile = capture do %>
  <%= app_icon icon, class: "guest-stay-action__icon size-6 shrink-0 #{icon_color}", aria: { hidden: "true" } %>
  <span class="min-w-0">
    <span class="guest-stay-action__label block text-sm font-semibold leading-tight <%= caption %>"><%= label %></span>
    <span class="guest-stay-action__hint mt-1 block text-xs leading-snug <%= description_color %>"><%= description %></span>
  </span>
<% end %>

<%# The same box as GuestUI::ActionCard, so the two grids on the stay page
    read as one set. %>
<% classes = "guest-stay-action flex min-h-28 flex-col gap-3 rounded-xl p-4 #{surface}" %>
<% if pending %>
  <div class="<%= classes %>"><%= tile %></div>
<% else %>
  <%= link_to path,
              class: "#{classes} touch-manipulation focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 focus-visible:ring-offset-background",
              data: (primary ? { tone: "primary" } : {}) do %><%= tile %><% end %>
<% end %>
