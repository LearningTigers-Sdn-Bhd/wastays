<%# A one-form stay page. The left column keeps the stay context, so the guest
    never loses track of which stay they are acting on. %>
<%= render GuestUI::Page.new do |page| %>
  <% page.with_hero do %>
    <%= render "public/concierge/shared/hero",
               home_path: stay_path,
               home_label: "Your stay at #{@hotel.name}" %>
  <% end %>
  <% page.with_context do %>
    <%= render "public/concierge/stays/shared/stay_details", presenter: presenter %>
  <% end %>

  <%= render "public/concierge/stays/shared/page_heading",
             back_path: stay_path,
             title: title,
             subtitle: local_assigns[:subtitle] %>

  <%= render "public/concierge/stays/shared/flash" %>
  <%= render GuestUI::Notice.new(message: local_assigns[:error], variant: :danger) %>

  <%= render GuestUI::Card.new do %>
    <%= yield %>
  <% end %>
<% end %>
