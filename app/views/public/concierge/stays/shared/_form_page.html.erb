<%# A one-form stay page. The stay stays in view, so the guest never loses
    track of which stay they are acting on. The frame is the shared form
    layout; the stay cards are its summaries. %>
<%= render layout: "public/concierge/shared/form_layout",
           locals: {
             back_path: stay_path,
             back_label: "Back to my stay",
             title: title,
             subtitle: local_assigns[:subtitle],
             compact: render("public/concierge/shared/summary_compact",
                             path: stay_path,
                             back_label: "Back to my stay",
                             title: (presenter.room_assigned? ? "Room #{presenter.room_label}" : "Room to be assigned"),
                             aside: presenter.stay_progress_label,
                             detail: "#{presenter.check_in_label} – #{presenter.check_out_label}"),
             summary: render("public/concierge/stays/shared/stay_details", presenter: presenter)
           } do %>
  <%= render "public/concierge/stays/shared/flash" %>
  <%= render GuestUI::Notice.new(message: local_assigns[:error], variant: :danger) %>

  <%= yield %>
<% end %>
