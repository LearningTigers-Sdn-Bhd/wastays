<% content_for :title, "Check Out | #{@hotel.name}" %>

<div data-mobile-view class="min-h-screen bg-landing-bg flex flex-col font-sans">

  <%# Top nav %>
  <div class="px-6 pt-8 pb-6">
    <%= link_to concierge_home_path(@hotel.slug),
          class: "w-10 h-10 rounded-xl bg-brand-primary flex items-center justify-center flex-shrink-0 shadow-lg shadow-brand-primary/20 active:scale-90 transition-transform" do %>
      <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M15 19l-7-7 7-7"/>
      </svg>
    <% end %>
  </div>

  <%# Header Section %>
  <div class="px-6 pb-8">
    <h1 class="text-2xl font-black text-neutral-text-primary leading-tight">
      Ready to <span class="text-brand-primary">check out?</span>
    </h1>
    <p class="text-[13px] text-neutral-text-secondary mt-3 font-medium leading-relaxed">
      <%= @booking.present? ? "Please review your stay and confirm your checkout." : "Enter your reservation number to start." %>
    </p>
  </div>

  <div class="flex-1 px-6 space-y-6 pb-32">
    <%= render "public/concierge/shared/error_alert", message: @error %>

    <% if @booking.present? %>
      <%# Booking summary card - "Ticket" style %>
      <div class="rounded-2xl border border-neutral-border/50 bg-white p-6 shadow-sm overflow-hidden relative">
        <div class="flex items-center gap-4 mb-5 pb-5 border-b border-dashed border-neutral-border/80">
          <div class="w-12 h-12 rounded-xl bg-brand-primary/5 text-brand-primary flex items-center justify-center">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/></svg>
          </div>
          <div>
            <p class="text-[10px] font-black uppercase tracking-[0.15em] text-neutral-text-secondary">Guest Name</p>
            <p class="text-xs font-bold text-neutral-text-primary mt-0.5"><%= @booking.guest_name %></p>
          </div>
        </div>
        
        <div class="space-y-4">
          <div class="flex items-center justify-between gap-4">
            <div>
              <p class="text-[10px] font-black uppercase tracking-[0.2em] text-neutral-text-secondary mb-1">Reservation No.</p>
              <p class="text-xs font-mono font-bold text-brand-primary"><%= @booking.confirmation_token %></p>
            </div>
            <div class="text-right">
              <p class="text-[10px] font-black uppercase tracking-[0.2em] text-neutral-text-secondary mb-1">Stay Duration</p>
              <p class="text-xs font-bold text-neutral-text-primary">
                <%= concierge_booking_nights(@booking) %>
              </p>
            </div>
          </div>

          <div class="flex items-start justify-between gap-4">
            <div>
              <p class="text-[10px] font-black uppercase tracking-[0.2em] text-neutral-text-secondary mb-1">Room Details</p>
              <div class="space-y-0.5">
                <% @booking.booking_rooms.each do |booking_room| %>
                  <p class="text-xs font-bold text-neutral-text-primary"><%= booking_room.quantity %>x <%= booking_room.room_type_snapshot["name"] %></p>
                <% end %>
              </div>
            </div>
            <% if @booking.room_numbers.present? %>
              <div class="text-right">
                <p class="text-[10px] font-black uppercase tracking-[0.2em] text-neutral-text-secondary mb-1">Room No.</p>
                <p class="text-sm font-black text-brand-primary"><%= @booking.room_numbers %></p>
              </div>
            <% end %>
          </div>
        </div>
      </div>
    <% end %>

    <%= form_with url: concierge_create_check_out_path(@hotel.slug), method: :post, class: "space-y-6" do %>
      <% if @booking.present? %>
        <%= hidden_field_tag :confirmation_token, @booking.confirmation_token %>
        <%= hidden_field_tag :stage, "submit" %>
        
        <div class="rounded-2xl border border-neutral-border/50 bg-white p-6 shadow-sm space-y-4">
          <div class="flex items-center gap-3">
            <div class="w-8 h-8 rounded-lg bg-brand-primary/5 text-brand-primary flex items-center justify-center">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 10h.01M12 10h.01M16 10h.01M9 16H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-5l-5 5v-5z"/></svg>
            </div>
            <label class="text-[10px] font-black uppercase tracking-[0.2em] text-neutral-text-primary">Message to front desk (optional)</label>
          </div>
          <%= text_area_tag :guest_notes, params[:guest_notes], rows: 3, 
                class: "w-full bg-neutral-bg border-neutral-border/40 rounded-xl py-3.5 px-4 text-sm font-medium focus:ring-4 focus:ring-brand-primary/10 focus:border-brand-primary transition-all shadow-none", 
                placeholder: "e.g. Requesting late checkout until 2pm" %>
        </div>

        <%# Fixed Bottom Button %>
        <div class="fixed bottom-0 left-0 right-0 p-6 bg-landing-bg/95 backdrop-blur-md z-30">
          <%= submit_tag "CONFIRM CHECKOUT",
                class: "w-full bg-brand-primary text-white font-black py-5 rounded-xl shadow-xl shadow-brand-primary/30 active:scale-[0.98] transition-all cursor-pointer tracking-widest text-sm" %>
        </div>
      <% else %>
        <div class="space-y-2">
          <label class="block text-[10px] font-black uppercase tracking-[0.2em] text-neutral-text-secondary ml-1">Confirmation Code</label>
          <%= text_field_tag :confirmation_token, params[:confirmation_token], 
                class: "w-full bg-white border-neutral-border/60 rounded-xl py-4 px-5 text-sm shadow-sm focus:ring-4 focus:ring-brand-primary/10 focus:border-brand-primary transition-all placeholder:text-neutral-text-secondary/40",
                placeholder: "e.g. WS-ABC12345", 
                autocapitalize: "characters", required: true %>
        </div>
        <%= hidden_field_tag :stage, "lookup" %>

        <%# Fixed Bottom Button %>
        <div class="fixed bottom-0 left-0 right-0 p-6 bg-landing-bg">
          <%= submit_tag "CONTINUE",
                class: "w-full bg-brand-primary text-white font-black py-5 rounded-xl shadow-xl shadow-brand-primary/30 active:scale-[0.98] transition-all cursor-pointer tracking-widest text-sm" %>
        </div>
      <% end %>
    <% end %>
  </div>

  <%# Spacing for fixed bottom button %>
  <div class="h-28"></div>

</div>
