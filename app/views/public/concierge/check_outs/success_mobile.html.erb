<% content_for :title, "Checkout Confirmed! | #{@hotel.name}" %>

<div data-mobile-view 
     data-controller="scroll-reveal"
     class="h-screen bg-primary flex flex-col font-sans overflow-hidden">

  <div class="flex-1 flex flex-col items-center justify-center px-6 text-center">
    
    <%# Large Success Icon %>
    <div class="relative mb-8" data-animate="scale-in">
      <div class="absolute inset-0 bg-white/10 rounded-full blur-2xl scale-150"></div>
      <div class="relative w-24 h-24 rounded-full border-4 border-white flex items-center justify-center shadow-2xl">
        <svg class="w-12 h-12 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"/>
        </svg>
      </div>
    </div>

    <%# Success Content %>
    <div data-animate style="transition-delay: 0.1s" class="mb-8">
      <h1 class="text-3xl font-black text-white leading-tight mb-2">
        Checkout Confirmed!
      </h1>
      <p class="text-white/70 text-[13px] leading-relaxed font-medium">
        Your visit at <span class="font-bold text-white"><%= @hotel.name %></span> <br>
        has been successfully checked-out!
      </p>
    </div>

    <%# Check-out Time Display (Simulating the OYO style) %>
    <div class="w-full max-w-[280px] mx-auto mb-8 pt-6 border-t border-white/20" data-animate style="transition-delay: 0.2s">
      <p class="text-[10px] font-black uppercase tracking-[0.2em] text-accent/80 mb-2">Your check-out time</p>
      <p class="text-5xl font-serif text-white tracking-tighter [text-shadow:0_4px_12px_rgba(0,0,0,0.3)]">
        <%= Time.current.strftime("%I:%M %p") %>
      </p>
    </div>

    <%# Guest Info Card - Compact %>
    <div class="w-full max-w-[300px] mx-auto bg-white/5 border border-white/10 rounded-2xl p-5 text-left space-y-4" data-animate style="transition-delay: 0.3s">
      <div class="flex justify-between items-start gap-4">
        <div>
          <p class="text-[8px] font-black uppercase tracking-[0.2em] text-white/40 mb-1">Guest</p>
          <p class="text-[11px] font-bold text-white uppercase"><%= @booking.guest_name %></p>
        </div>
        <div class="text-right">
          <p class="text-[8px] font-black uppercase tracking-[0.2em] text-white/40 mb-1">Reservation</p>
          <p class="text-[11px] font-mono font-bold text-accent"><%= @booking.confirmation_token %></p>
        </div>
      </div>
      
      <div class="flex items-end justify-between gap-4 pt-3 border-t border-white/10">
        <div>
          <p class="text-[8px] font-black uppercase tracking-[0.2em] text-white/40 mb-1">Room Type</p>
          <p class="text-[11px] font-bold text-white">
            <%= @booking.booking_rooms.map { |br| br.room_type_snapshot["name"] }.join(", ") %>
          </p>
        </div>
        <div class="text-right">
          <p class="text-[8px] font-black uppercase tracking-[0.2em] text-white/40 mb-1">Stayed</p>
          <p class="text-[11px] font-bold text-white"><%= concierge_booking_nights(@booking) %></p>
        </div>
      </div>
    </div>

  </div>

  <%# Fixed Bottom Button %>
  <div class="p-6 pb-12" data-animate style="transition-delay: 0.4s">
    <%= link_to concierge_home_path(@hotel), 
          class: "block w-full bg-white text-primary font-black py-4.5 rounded-xl shadow-2xl active:scale-[0.98] transition-all text-center tracking-[0.2em] text-sm uppercase" do %>
      Done
    <% end %>
  </div>

</div>
