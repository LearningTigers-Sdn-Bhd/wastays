<% content_for :title, "Checkout Confirmed! | #{@hotel.name}" %>

<%# A full-bleed confirmation, not a page in the concierge shell: this screen ends
    the journey, so there is nothing left to navigate to but Done. %>
<div data-controller="scroll-reveal"
     class="flex min-h-screen flex-col bg-primary font-sans">

  <div class="flex flex-1 flex-col items-center justify-center px-6 py-12 text-center">

    <div class="relative mb-8" data-animate="scale-in">
      <div class="absolute inset-0 scale-150 rounded-full bg-white/10 blur-2xl"></div>
      <div class="relative flex h-24 w-24 items-center justify-center rounded-full border-4 border-white shadow-2xl">
        <svg class="h-12 w-12 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"/>
        </svg>
      </div>
    </div>

    <div data-animate style="transition-delay: 0.1s" class="mb-8">
      <h1 class="mb-2 text-3xl font-black leading-tight text-white">
        Checkout Confirmed!
      </h1>
      <p class="text-[13px] font-medium leading-relaxed text-white/70">
        Your visit at <span class="font-bold text-white"><%= @hotel.name %></span> <br>
        has been successfully checked-out!
      </p>
    </div>

    <div class="mx-auto mb-8 w-full max-w-[280px] border-t border-white/20 pt-6" data-animate style="transition-delay: 0.2s">
      <p class="mb-2 text-[10px] font-black uppercase tracking-[0.2em] text-accent/80">Your check-out time</p>
      <p class="font-serif text-5xl tracking-tighter text-white [text-shadow:0_4px_12px_rgba(0,0,0,0.3)]">
        <%= Time.current.strftime("%I:%M %p") %>
      </p>
    </div>

    <div class="mx-auto w-full max-w-[300px] space-y-4 rounded-2xl border border-white/10 bg-white/5 p-5 text-left" data-animate style="transition-delay: 0.3s">
      <div class="flex items-start justify-between gap-4">
        <div>
          <p class="mb-1 text-[8px] font-black uppercase tracking-[0.2em] text-white/40">Guest</p>
          <p class="text-[11px] font-bold uppercase text-white"><%= @booking.guest_name %></p>
        </div>
        <div class="text-right">
          <p class="mb-1 text-[8px] font-black uppercase tracking-[0.2em] text-white/40">Reservation</p>
          <p class="font-mono text-[11px] font-bold text-accent"><%= @booking.confirmation_token %></p>
        </div>
      </div>

      <div class="flex items-end justify-between gap-4 border-t border-white/10 pt-3">
        <div>
          <p class="mb-1 text-[8px] font-black uppercase tracking-[0.2em] text-white/40">Room Type</p>
          <p class="text-[11px] font-bold text-white">
            <%= @booking.booking_rooms.map { |br| br.room_type_snapshot["name"] }.join(", ") %>
          </p>
        </div>
        <div class="text-right">
          <p class="mb-1 text-[8px] font-black uppercase tracking-[0.2em] text-white/40">Stayed</p>
          <p class="text-[11px] font-bold text-white"><%= concierge_booking_nights(@booking) %></p>
        </div>
      </div>
    </div>

  </div>

  <div class="p-6 pb-12" data-animate style="transition-delay: 0.4s">
    <%= link_to concierge_home_path(@hotel),
          class: "mx-auto block w-full max-w-sm rounded-xl bg-white py-4.5 text-center text-sm font-black uppercase tracking-[0.2em] text-primary shadow-2xl transition-all hover:shadow-xl active:scale-[0.98]" do %>
      Done
    <% end %>
  </div>

</div>
