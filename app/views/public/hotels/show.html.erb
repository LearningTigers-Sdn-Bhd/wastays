  <div class="max-w-[85rem] mx-auto px-4 py-6 sm:px-6 lg:px-8">
    <div class="flex flex-col lg:flex-row gap-8">
      <!-- Main Content -->
      <div class="flex-1 space-y-8">
        <!-- Hotel Info Header -->
        <div class="card p-6 md:p-8">
          <div class="flex justify-between items-start mb-4">
            <div>
              <div class="flex items-center gap-x-2 mb-2">
                <div class="flex text-amber-400">
                  <% @hotel.star_rating.to_i.times do %>
                    <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
                  <% end %>
                </div>
                <span class="text-xs font-bold text-neutral-text-secondary uppercase tracking-widest">Hotel Grade</span>
              </div>
              <h1 class="text-3xl md:text-4xl font-extrabold text-neutral-text-primary mb-2"><%= @hotel.name %></h1>
              <p class="text-neutral-text-secondary flex items-start gap-x-2">
                <svg class="w-5 h-5 mt-0.5 text-brand-primary shrink-0" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg>
                <span><%= @hotel.address %>, <%= @hotel.city %>, <%= @hotel.country %></span>
              </p>
            </div>
            <div class="hidden sm:block text-right">
              <div class="bg-brand-primary text-white p-3 rounded-xl shadow-lg shadow-brand-primary/20">
                <span class="block text-[10px] uppercase font-black tracking-tighter opacity-80">Guest Rating</span>
                <span class="text-2xl font-black italic tracking-tighter">4.8</span>
              </div>
            </div>
          </div>

          <% if @hotel.amenities.any? %>
            <div class="flex flex-wrap gap-3 mt-8">
              <% @hotel.amenities.each do |amenity_id| %>
                <% amenity = Hotel::AMENITIES.find { |a| a[:id] == amenity_id } %>
                <% next unless amenity %>
                <div class="flex items-center gap-x-2 bg-neutral-bg px-3 py-2 rounded-lg border border-neutral-border">
                  <% case amenity[:icon] %>
                  <% when 'wifi' %>
                    <svg class="w-3.5 h-3.5 text-brand-secondary" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20h.01"/><path d="M2 10c6.667-3.333 13.333-3.333 20 0"/><path d="M7 15c3.333-1.667 6.667-1.667 10 0"/></svg>
                  <% when 'parking' %>
                    <svg class="w-3.5 h-3.5 text-brand-secondary" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor"><path d="M5,22H19a3,3,0,0,0,3-3V5a3,3,0,0,0-3-3H5A3,3,0,0,0,2,5V19A3,3,0,0,0,5,22ZM4,5A1,1,0,0,1,5,4H19a1,1,0,0,1,1,1V19a1,1,0,0,1-1,1H5a1,1,0,0,1-1-1ZM9,18a1,1,0,0,0,1-1V14h2a4,4,0,0,0,0-8H9A1,1,0,0,0,8,7V17A1,1,0,0,0,9,18ZM10,8h2a2,2,0,0,1,0,4H10Z"/></svg>
                  <% when 'pool' %>
                    <svg class="w-3.5 h-3.5 text-brand-secondary" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 6c.6.5 1.2 1 2.5 1C7 7 7 5 9.5 5c2.5 0 2.5 2 5 2 2.5 0 2.5-2 5-2 1.3 0 1.9.5 2.5 1"/><path d="M2 12c.6.5 1.2 1 2.5 1 2.5 0 2.5-2 5-2 2.5 0 2.5 2 5 2 2.5 0 2.5-2 5-2 1.3 0 1.9.5 2.5 1"/><path d="M2 18c.6.5 1.2 1 2.5 1 2.5 0 2.5-2 5-2 2.5 0 2.5 2 5 2 2.5 0 2.5-2 5-2 1.3 0 1.9.5 2.5 1"/></svg>
                  <% when 'gym' %>
                    <svg class="w-3.5 h-3.5 text-brand-secondary" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m6.5 6.5 11 11"/><path d="m11.8 5.8 5.2 5.2"/><path d="m7 11.8 5.2 5.2"/><path d="M5.8 11.8 11 17"/><path d="m11.8 5.8 5.2 5.2"/><path d="m3 21 3-3"/><path d="m18 6 3-3"/></svg>
                  <% when 'restaurant' %>
                    <svg class="w-3.5 h-3.5 text-brand-secondary" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 2v7c0 1.1.9 2 2 2h4a2 2 0 0 0 2-2V2"/><path d="M7 2v20"/><path d="M21 15V2v0a5 5 0 0 0-5 5v6c0 1.1.9 2 2 2h3Zm0 0v7"/></svg>
                  <% when 'bar' %>
                    <svg class="w-3.5 h-3.5 text-brand-secondary" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 14 14" fill="currentColor"><path d="M3,0 C2,0 2,0.4670568 2,1 L2,3 C2,4 0,4 0,6 L0,13 C0,13.566252 0.467057,14 1,14 L5,14 C5.599561,14 6,13.599561 6,13 L6,6 C6,4 4,4 4,3 L4,1 C4,0.4337479 4,0 3,0 Z M7,5 C7,8 7.47106,10 10,10 L10,12 C10,12.666911 9,13 8.5,13 C7.5,13 7,13 7,14 L14,14 C14,13 13.5,13 12.5,13 C12,13 11,12.633602 11,12 L11,10 C13.47106,10 14,8 14,5 L7,5 Z"/></svg>
                  <% when 'front_desk' %>
                    <svg class="w-3.5 h-3.5 text-brand-secondary" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 512 512" fill="currentColor"><g><path d="M441.153,271.209c-1.784-21.92-17.003-40.092-37.398-46.24v-18.627H373.33v18.627 c-20.395,6.149-35.614,24.32-37.398,46.24h-48.975v-64.297c0-34.877-25.047-63.999-58.095-70.363 c4.813-8.416,7.581-18.147,7.581-28.517V89.087V78.192H121.171v10.895v18.946c0,10.37,2.767,20.101,7.581,28.517 c-33.048,6.363-58.095,35.486-58.095,70.363v64.297H0v54.477h512v-54.477H441.153z"/></g><g><rect y="356.108" width="511.997" height="145.808"/></g><g><rect x="121.174" y="10.084" width="115.271" height="37.687"/></g></svg>
                  <% when 'spa' %>
                    <svg class="w-3.5 h-3.5 text-brand-secondary" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 50 50" fill="currentColor"><path d="M47.231 41h-16.231v4h16.397c1.348 0 1.603-1.175 1.603-1.175v-.97s-.012-1.855-1.769-1.855zm-2.245-.79c2.214 0 4.014-1.802 4.014-4.022 0-2.227-1.8-4.023-4.014-4.023-2.211 0-4.006 1.797-4.006 4.023 0 2.219 1.795 4.022 4.006 4.022zm-8.454-.21c2.106 0 3.8-1.484 3.8-3.587-.001-2.099-1.701-3.2-3.791-3.216l-5.541.702v6.101h5.532zm-18.009-26.067c2.459 0 4.448-2 4.448-4.467 0-2.467-1.989-4.466-4.448-4.466-2.457 0-4.449 1.999-4.449 4.466s1.992 4.467 4.449 4.467zm-4.542 14.456l-.04-.058-2.016-4.694-.003 9.363h6.025l1.316-1.4-3.569-1.374c-.846-.318-1.447-1.038-1.713-1.837zm1.277-.421c.195.438.556.793 1.01.956l6.877 2.549c.88.389 1.908-.015 2.294-.898.386-.889-.015-1.924-.896-2.311l-6.345-2.396-1.96-4.701 1.278-.476 1.661 4.028 4.823 1.788v-4.922l2.56 1.523 1.276 6.428c.313.918 1.304 1.401 2.218 1.084.905-.314 1.386-1.315 1.075-2.229l-1.43-6.191c-.094-.347-.293-.65-.562-.877-.733-.812-4.44-4.957-4.704-5.234-.387-.388-1.272-1.089-2.944-1.089h-6c-3.41 0-4.066 3.48-3.369 5.25l3.138 7.718zm14.742 6.032h-27.033c-.984 0-1.967.555-1.967 1.776v9.224h29v-11z"/></svg>
                  <% when 'laundry' %>
                    <svg class="w-3.5 h-3.5 text-brand-secondary" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 64 64" fill="currentColor"><path d="M3 61h58V3H3v58zM5 59V20h54v39H5zM59 5v13H5V5h54z"/><path d="M32 23c-9.4 0-17 7.6-17 17s7.6 17 17 17 17-7.6 17-17-7.6-17-17-17zm0 32c-7.8 0-14.2-6-14.9-13.6 3.2-.3 4.9.4 6.7 1.2 1.5.7 3.1 1.4 5.4 1.4.7 0 1.6-.1 2.5-.2 4.1-.7 6 .1 8.1 1 1.5.7 3.1 1.4 5.4 1.4.2 0 .4 0 .6 0C43.3 51.3 38.1 55 32 55zm14.4-11c-2.6.3-4.2-.3-5.9-1.1-2.1-1-4.6-2-9.3-1.2-3.2.6-4.8-.1-6.7-1-1.9-.8-4-1.8-7.6-1.4.3-8 6.9-14.4 15-14.4 8.3 0 15 6.7 15 15 0 1.5-.2 2.9-.6 4.1z"/><path d="M37 14c1.7 0 3-1.3 3-3s-1.3-3-3-3-3 1.3-3 3 1.3 3 3 3zm0-4c.6 0 1 .4 1 1s-.4 1-1 1-1-.4-1-1 .4-1 1-1z"/><path d="M45 14c1.7 0 3-1.3 3-3s-1.3-3-3-3-3 1.3-3 3 1.3 3 3 3zm0-4c.6 0 1 .4 1 1s-.4 1-1 1-1-.4-1-1 .4-1 1-1z"/><path d="M53 14c1.7 0 3-1.3 3-3s-1.3-3-3-3-3 1.3-3 3 1.3 3 3 3zm0-4c.6 0 1 .4 1 1s-.4 1-1 1-1-.4-1-1 .4-1 1-1z"/></svg>
                  <% end %>
                  <span class="text-[11px] font-medium text-neutral-text-secondary"><%= amenity[:name] %></span>
                </div>
              <% end %>
            </div>
          <% end %>
        </div>

        <!-- About / Story Section -->
        <div class="space-y-4">
          <h2 class="text-2xl font-extrabold text-neutral-text-primary">About this hotel</h2>
          <div class="prose prose-neutral max-w-none text-neutral-text-secondary leading-relaxed">
            <p>Welcome to <%= @hotel.name %>, where local hospitality meets modern comfort. Located in the heart of <%= @hotel.city %>, our property is designed for travelers who value simplicity, quality, and direct deals.</p>
            <p>Whether you're visiting for business or leisure, we provide a seamless stay experience with all the essential amenities you need. Book directly with us through WAStays to enjoy the best rates and personalized WhatsApp support throughout your journey.</p>
          </div>
        </div>

        <!-- Room Options Section -->
        <div class="space-y-6 pt-4" id="rooms-section">
          <div class="flex justify-between items-end">
            <h2 class="text-2xl font-extrabold text-neutral-text-primary">Select your room</h2>
            <p class="text-sm text-brand-secondary font-bold">Recommended for <%= @adults %> guests</p>
          </div>

          <div class="space-y-6">
            <% if @search_ready && @room_types.empty? %>
              <div class="card p-8 text-center">
                <h3 class="text-lg font-bold text-neutral-text-primary mb-2">No rooms available for selected dates</h3>
                <p class="text-sm text-neutral-text-secondary mb-6">Try changing your check-in/check-out dates to see available options.</p>
                <%= link_to "Edit Search", hotel_path(@hotel, request.query_parameters.merge(edit_search: 1)), class: "btn btn-secondary px-8" %>
              </div>
            <% end %>

            <% @room_types.each do |room_type| %>
              <div class="card overflow-hidden group hover:shadow-xl transition-all duration-300">
                <div class="flex flex-col md:flex-row">
                  <div class="md:w-80 lg:w-96 h-64 md:h-auto relative overflow-hidden cursor-pointer"
                       data-action="click->room-details#open"
                       data-room-details="<%= {
                         name: room_type.name,
                         description: room_type.description,
                         max_adults: room_type.max_adults,
                         max_children: room_type.max_children,
                         photos: room_type.photos.map { |p| url_for(p) },
                         room_amenities: room_type.amenities.map { |id| Hotel::ROOM_AMENITIES.find { |a| a[:id] == id } }.compact,
                         hotel_amenities: @hotel.amenities.map { |id| Hotel::HOTEL_AMENITIES.find { |a| a[:id] == id } }.compact
                       }.to_json %>">

                    <% if room_type.photos.attached? %>
                      <%= image_tag room_type.photos.first, class: "absolute inset-0 w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" %>
                    <% else %>
                      <div class="absolute inset-0 bg-neutral-bg flex items-center justify-center">
                        <svg class="w-12 h-12 text-neutral-border" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z"/><path d="M14 2v4a2 2 0 0 0 2 2h4"/><path d="m10 13 2 2 4-4"/></svg>
                      </div>
                    <% end %>
                  </div>
                  <div class="flex-1 p-6 flex flex-col justify-between">
                    <div>
                      <h3 class="text-xl font-bold text-neutral-text-primary mb-2"><%= room_type.name %></h3>
                      <p class="text-sm text-neutral-text-secondary line-clamp-2 mb-4"><%= room_type.description %></p>
                      
                      <div class="flex flex-wrap gap-y-2 gap-x-4 mb-6">
                        <div class="flex items-center gap-x-1.5 text-xs font-bold text-neutral-text-secondary uppercase tracking-wider">
                          <svg class="w-3.5 h-3.5 text-brand-primary" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/></svg>
                          Up to <%= room_type.max_adults %> Adults
                        </div>
                        <% if room_type.max_children.to_i > 0 %>
                          <div class="flex items-center gap-x-1.5 text-xs font-bold text-neutral-text-secondary uppercase tracking-wider">
                            <svg class="w-3.5 h-3.5 text-brand-primary" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
                            <%= room_type.max_children %> Children
                          </div>
                        <% end %>
                      </div>
                    </div>

                    <div class="flex justify-between items-end border-t border-neutral-border pt-4">
                      <div>
                        <p class="text-[10px] text-neutral-text-secondary uppercase font-black tracking-widest">Total for Stay</p>
                        <% if @search_ready %>
                          <p class="text-2xl font-black text-neutral-text-primary">
                            RM <%= number_with_precision(@availability_service.calculate_total_price(room_type), precision: 2) %>
                          </p>
                          <p class="text-[10px] text-neutral-text-secondary italic">Inclusive of all taxes</p>
                        <% else %>
                          <p class="text-sm font-bold text-neutral-text-secondary">Select dates to see price</p>
                        <% end %>
                      </div>
                      
                      <%= form_with url: quotes_path, method: :post do |f| %>
                        <%= f.hidden_field :hotel_id, value: @hotel.id %>
                        <%= f.hidden_field :room_type_id, value: room_type.id %>
                        <%= f.hidden_field :check_in, value: @check_in&.to_s %>
                        <%= f.hidden_field :check_out, value: @check_out&.to_s %>
                        <%= f.hidden_field :adults, value: @adults %>
                        <%= f.hidden_field :children, value: @children %>
                        <%= f.hidden_field :room_count, value: @room_count %>
                        
                        <%= f.submit "Reserve Now",
                                     disabled: !@search_ready,
                                     class: "btn bg-blue-600 hover:bg-blue-700 text-white font-bold py-3 px-8 shadow-lg shadow-brand-primary/20 disabled:opacity-50 disabled:cursor-not-allowed" %>
                      <% end %>
                    </div>
                  </div>
                </div>
              </div>
            <% end %>
          </div>
        </div>

        <!-- Detail Sections -->
        <div class="grid md:grid-cols-2 gap-6">
          <div class="card p-6">
            <h3 class="text-lg font-extrabold text-neutral-text-primary mb-4 flex items-center gap-x-2">
              <svg class="w-5 h-5 text-brand-primary" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
              Check-in & Policies
            </h3>
            <ul class="space-y-3 text-sm text-neutral-text-secondary">
              <li class="flex justify-between border-b border-neutral-bg pb-2">
                <span>Check-in time</span>
                <span class="font-bold text-neutral-text-primary"><%= @hotel.property_policy&.check_in_time || "2:00 PM" %></span>
              </li>
              <li class="flex justify-between border-b border-neutral-bg pb-2">
                <span>Check-out time</span>
                <span class="font-bold text-neutral-text-primary"><%= @hotel.property_policy&.check_out_time || "12:00 PM" %></span>
              </li>
              <li class="pt-2">
                <p class="font-bold text-neutral-text-primary mb-1 text-[10px] uppercase tracking-widest">Important Info</p>
                <p class="text-xs leading-relaxed"><%= @hotel.property_policy&.cancellation_policy.presence || "Cancellation policies are subject to the room type selected. Please review your quote before payment." %></p>
              </li>
            </ul>
          </div>

          <div class="card p-6 flex flex-col justify-center items-center text-center bg-brand-gradient text-white border-none shadow-xl shadow-brand-primary/20">
            <div class="w-12 h-12 bg-white/20 rounded-full flex items-center justify-center mb-4">
              <svg class="w-6 h-6" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/></svg>
            </div>
            <h4 class="text-xl font-black mb-2">Need assistance?</h4>
            <p class="text-white/80 text-sm mb-6">Our travel experts are ready to help you via WhatsApp.</p>
            <a href="#" class="inline-flex items-center gap-x-2 bg-white text-brand-primary px-6 py-2.5 rounded-xl font-bold text-sm hover:bg-neutral-bg transition-colors">
              Chat with an expert
            </a>
          </div>
        </div>
      </div>

      <!-- Sticky Sidebar -->
      <aside class="lg:w-80">
        <div class="sticky top-[130px] space-y-6">
          <div class="card p-6 border-brand-primary/20 bg-white">
            <h3 class="text-sm font-black text-neutral-text-primary uppercase tracking-widest mb-6 border-b border-neutral-bg pb-4">Your Search</h3>
            <div class="space-y-4">
              <div class="flex items-center gap-x-3">
                <svg class="w-3.5 h-3.5 text-neutral-text-secondary" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="18" x="3" y="4" rx="2" ry="2"/><line x1="16" x2="16" y2="6"/><line x1="8" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
                <div>
                  <p class="text-[10px] text-neutral-text-secondary uppercase font-bold tracking-wider">Stay Dates</p>
                  <p class="text-sm font-bold text-neutral-text-primary">
                    <% if @search_ready %>
                      <%= @check_in.strftime("%b %d") %> - <%= @check_out.strftime("%b %d") %>
                    <% else %>
                      Select your dates
                    <% end %>
                  </p>
                </div>
              </div>
              <div class="flex items-center gap-x-3">
                <svg class="w-3.5 h-3.5 text-neutral-text-secondary" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
                <div>
                  <p class="text-[10px] text-neutral-text-secondary uppercase font-bold tracking-wider">Guests</p>
                  <p class="text-sm font-bold text-neutral-text-primary">
                    <%= @adults %> Adults, <%= @children %> Children
                  </p>
                </div>
              </div>
            </div>
            <div class="mt-8">
              <%= link_to "Edit Search",
                          hotel_path(@hotel, request.query_parameters.merge(edit_search: 1)),
                          class: "btn btn-secondary w-full py-2.5 text-xs font-bold uppercase tracking-widest" %>
            </div>
          </div>

          <div class="card p-6 bg-red-50/50 border-red-100">
            <h4 class="text-xs font-black text-brand-primary uppercase tracking-widest mb-3">Why book here?</h4>
            <ul class="space-y-3">
              <li class="flex items-start gap-x-2 text-xs font-medium text-neutral-text-secondary leading-snug">
                <svg class="w-3.5 h-3.5 text-status-success shrink-0" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
                No hidden fees or service charges
              </li>
              <li class="flex items-start gap-x-2 text-xs font-medium text-neutral-text-secondary leading-snug">
                <svg class="w-3.5 h-3.5 text-status-success shrink-0" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
                Verified local budget stays
              </li>
              <li class="flex items-start gap-x-2 text-xs font-medium text-neutral-text-secondary leading-snug">
                <svg class="w-3.5 h-3.5 text-status-success shrink-0" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
                Direct WhatsApp line to the hotel
              </li>
            </ul>
          </div>
        </div>
      </aside>
    </div>
  </div>

  <!-- Mobile Sticky CTA (Phase 5 requirement) -->
  <div class="lg:hidden fixed bottom-0 inset-x-0 z-[49] bg-white border-t border-neutral-border p-4 shadow-[0_-10px_20px_-5px_rgba(0,0,0,0.1)]">
    <div class="flex items-center justify-between gap-x-4 max-w-[85rem] mx-auto">
      <div>
        <p class="text-[10px] text-neutral-text-secondary uppercase font-black tracking-tighter">Starting from</p>
        <p class="text-xl font-black text-neutral-text-primary">
          <% if @search_ready && @room_types.any? %>
            RM <%= number_with_precision(@availability_service.calculate_total_price(@room_types.first), precision: 2) %>
          <% else %>
            Select dates
          <% end %>
        </p>
      </div>
      <a href="#rooms-section" class="btn btn-primary px-8 py-3 shadow-lg shadow-brand-primary/20">
        Choose Room
      </a>
    </div>
  </div>
</div>
