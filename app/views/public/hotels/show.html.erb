<div class="max-w-[85rem] mx-auto px-4 sm:px-6 lg:px-8 py-10">
  <nav class="flex mb-5" aria-label="Breadcrumb">
    <ol class="flex items-center whitespace-nowrap">
      <li class="inline-flex items-center">
        <%= link_to "Hotels", hotels_path(city: params[:city], check_in: params[:check_in], check_out: params[:check_out], adults: params[:adults], children: params[:children]), class: "flex items-center text-sm text-gray-500 hover:text-blue-600 focus:outline-none focus:text-blue-600" %>
        <svg class="flex-shrink-0 mx-2 overflow-visible h-4 w-4 text-gray-400" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg>
      </li>
      <li class="inline-flex items-center text-sm font-semibold text-gray-800 truncate" aria-current="page">
        <%= @hotel.name %>
      </li>
    </ol>
  </nav>

  <div class="grid lg:grid-cols-3 gap-8">
    <!-- Left Column: Hotel Info and Rooms -->
    <div class="lg:col-span-2 space-y-8">
      <!-- Hotel Header -->
      <div>
        <div class="flex justify-between items-start">
          <h1 class="text-3xl font-bold text-gray-800"><%= @hotel.name %></h1>
          <div class="flex text-yellow-400">
            <% @hotel.star_rating.to_i.times do %>
              <svg class="h-5 w-5 fill-current" viewBox="0 0 20 20"><path d="M10 15l-5.878 3.09 1.123-6.545L.489 6.91l6.572-.955L10 0l2.939 5.955 6.572.955-4.756 4.635 1.123 6.545z"/></svg>
            <% end %>
          </div>
        </div>
        <p class="mt-2 text-gray-600 flex items-center">
          <svg class="h-4 w-4 mr-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
          </svg>
          <%= @hotel.address %>, <%= @hotel.city %>, <%= @hotel.country %>
        </p>
      </div>

      <!-- Gallery (Simplified for MVP) -->
      <div class="grid grid-cols-2 gap-2 rounded-xl overflow-hidden">
        <% if @hotel.room_types.first&.photos&.attached? %>
          <div class="col-span-2">
            <%= image_tag @hotel.room_types.first.photos.first, class: "w-full h-80 object-cover" %>
          </div>
          <% @hotel.room_types.each do |rt| %>
            <% rt.photos.drop(1).each do |photo| %>
              <div>
                <%= image_tag photo, class: "w-full h-40 object-cover" %>
              </div>
            <% end %>
          <% end %>
        <% else %>
          <div class="col-span-2 bg-gray-100 h-80 flex items-center justify-center">
            <svg class="h-20 w-20 text-gray-300" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
            </svg>
          </div>
        <% end %>
      </div>

      <!-- Policies and About -->
      <div class="grid md:grid-cols-2 gap-6 bg-white p-6 rounded-xl border border-gray-200">
        <div>
          <h3 class="text-lg font-bold text-gray-800 mb-3">Policies</h3>
          <ul class="space-y-2 text-sm text-gray-600">
            <li class="flex justify-between">
              <span>Check-in:</span>
              <span class="font-medium text-gray-800"><%= @hotel.property_policy&.check_in_time || "From 2:00 PM" %></span>
            </li>
            <li class="flex justify-between">
              <span>Check-out:</span>
              <span class="font-medium text-gray-800"><%= @hotel.property_policy&.check_out_time || "Until 12:00 PM" %></span>
            </li>
          </ul>
        </div>
        <div>
          <h3 class="text-lg font-bold text-gray-800 mb-3">Cancellation</h3>
          <p class="text-sm text-gray-600">
            <%= @hotel.property_policy&.cancellation_policy.presence || "Cancellation policies vary by room type." %>
          </p>
        </div>
      </div>

      <!-- Room Selection -->
      <div class="space-y-4">
        <h2 class="text-2xl font-bold text-gray-800">Select Your Room</h2>
        <% @room_types.each do |room_type| %>
          <div class="bg-white border border-gray-200 rounded-xl overflow-hidden shadow-sm hover:shadow-md transition">
            <div class="flex flex-col md:flex-row">
              <div class="md:w-1/3 min-h-[200px] relative">
                <% if room_type.photos.attached? %>
                  <%= image_tag room_type.photos.first, class: "absolute inset-0 w-full h-full object-cover" %>
                <% else %>
                  <div class="absolute inset-0 bg-gray-100 flex items-center justify-center">
                    <svg class="h-10 w-10 text-gray-300" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
                    </svg>
                  </div>
                <% end %>
              </div>
              <div class="p-6 md:w-2/3 flex flex-col justify-between">
                <div>
                  <h3 class="text-xl font-bold text-gray-800"><%= room_type.name %></h3>
                  <p class="mt-2 text-sm text-gray-600 line-clamp-2"><%= room_type.description %></p>
                  
                  <div class="mt-4 flex flex-wrap gap-4 text-sm text-gray-500">
                    <span class="flex items-center">
                      <svg class="h-4 w-4 mr-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
                      </svg>
                      Max <%= room_type.max_adults %> Adults
                    </span>
                    <% if room_type.max_children.to_i > 0 %>
                      <span class="flex items-center">
                        <svg class="h-4 w-4 mr-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z" />
                        </svg>
                        Max <%= room_type.max_children %> Children
                      </span>
                    <% end %>
                  </div>
                </div>

                <div class="mt-6 flex justify-between items-end border-t pt-4">
                  <div>
                    <p class="text-xs text-gray-500">Total for stay</p>
                    <p class="text-2xl font-bold text-blue-600">MYR <%= @availability_service.calculate_total_price(room_type) %></p>
                    <p class="text-xs text-gray-400">Excludes taxes & fees</p>
                  </div>
                  
                  <%= form_with url: quotes_path, method: :post do |f| %>
                    <%= f.hidden_field :hotel_id, value: @hotel.id %>
                    <%= f.hidden_field :room_type_id, value: room_type.id %>
                    <%= f.hidden_field :check_in, value: params[:check_in] %>
                    <%= f.hidden_field :check_out, value: params[:check_out] %>
                    <%= f.hidden_field :adults, value: params[:adults] %>
                    <%= f.hidden_field :children, value: params[:children] %>
                    <%= f.hidden_field :room_count, value: params[:room_count] || 1 %>
                    
                    <%= f.submit "Reserve Room", class: "py-2 px-6 inline-flex justify-center items-center gap-x-2 text-sm font-semibold rounded-lg border border-transparent bg-blue-600 text-white hover:bg-blue-700 transition cursor-pointer" %>
                  <% end %>
                </div>
              </div>
            </div>
          </div>
        <% end %>
      </div>
    </div>

    <!-- Right Column: Search Sticky and Summary -->
    <div class="space-y-6">
      <div class="sticky top-4 p-6 bg-white border border-gray-200 rounded-xl shadow-sm">
        <h3 class="text-lg font-bold text-gray-800 mb-4 text-center">Your Stay</h3>
        
        <div class="space-y-4">
          <div class="flex justify-between text-sm py-2 border-b border-gray-100">
            <span class="text-gray-500">Check-in</span>
            <span class="font-medium text-gray-800"><%= params[:check_in] || Date.today.strftime("%d %b %Y") %></span>
          </div>
          <div class="flex justify-between text-sm py-2 border-b border-gray-100">
            <span class="text-gray-500">Check-out</span>
            <span class="font-medium text-gray-800"><%= params[:check_out] || Date.tomorrow.strftime("%d %b %Y") %></span>
          </div>
          <div class="flex justify-between text-sm py-2 border-b border-gray-100">
            <span class="text-gray-500">Guests</span>
            <span class="font-medium text-gray-800"><%= params[:adults] || 2 %> Adults, <%= params[:children] || 0 %> Children</span>
          </div>
        </div>

        <div class="mt-6">
          <%= link_to "Change Search", root_path, class: "w-full py-2 px-4 inline-flex justify-center items-center gap-x-2 text-sm font-medium rounded-lg border border-gray-200 bg-white text-gray-800 shadow-sm hover:bg-gray-50 disabled:opacity-50 disabled:pointer-events-none" %>
        </div>
      </div>
      
      <div class="p-6 bg-blue-50 border border-blue-100 rounded-xl">
        <h3 class="text-sm font-bold text-blue-800 mb-2">Why book with WAStays?</h3>
        <ul class="space-y-2 text-xs text-blue-700">
          <li class="flex items-start">
            <svg class="h-4 w-4 mr-1 text-blue-500 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
            </svg>
            No booking fees
          </li>
          <li class="flex items-start">
            <svg class="h-4 w-4 mr-1 text-blue-500 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
            </svg>
            Pay directly at the hotel
          </li>
          <li class="flex items-start">
            <svg class="h-4 w-4 mr-1 text-blue-500 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
            </svg>
            Instant confirmation
          </li>
        </ul>
      </div>
    </div>
  </div>
</div>
