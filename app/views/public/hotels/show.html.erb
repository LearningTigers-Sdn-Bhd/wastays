<%# frozen_string_literal: true %>

<div class="bg-neutral-bg min-h-screen pb-24 lg:pb-0" 
     data-controller="gallery-toggle room-details" 
     data-gallery-toggle-photos-value="<%= @hotel.photo_urls_json %>"
     data-gallery-toggle-index-value="0">
  
  <% content_for :hide_chrome, true %>

  <%# ── Search-bar header ── %>
  <%= render "hotel_search_bar",
      hotel: @hotel,
      check_in: @check_in,
      check_out: @check_out,
      adults: @adults,
      children: @children,
      room_count: @room_count %>

  <%# Breadcrumb %>
  <div class="bg-white border-b border-neutral-border">
    <div class="max-w-[85rem] mx-auto px-4 py-2.5">
      <nav class="flex text-sm text-neutral-text-secondary" aria-label="Breadcrumb">
        <%= link_to "Hotels", hotels_path(request.query_parameters), class: "hover:text-brand-primary" %>
        <svg class="mx-2 h-4 w-4 text-gray-400 self-center" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="m9 18 6-6-6-6"/></svg>
        <span class="font-semibold text-neutral-text-primary truncate"><%= @hotel.name %></span>
      </nav>
    </div>
  </div>

  <%# Modals (Logic-heavy components) %>
  <%= render "stay_modal", 
             show_stay_modal: @show_stay_modal,
             hotel: @hotel,
             check_in: @check_in,
             check_out: @check_out,
             adults: @adults,
             children: @children,
             room_count: @room_count,
             display_currency: @display_currency %>

  <%= render "photo_gallery_modal", hotel: @hotel %>
  <%= render "room_details_modal" %>

  <%# Gallery Section (Primary Visuals) %>
  <div id="hotel-gallery-top" class="max-w-[85rem] mx-auto px-4 py-6 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-4 md:h-[420px]">
      <div class="md:col-span-2 md:row-span-2 aspect-[2/1] md:aspect-auto rounded-2xl overflow-hidden shadow-lg group cursor-pointer" 
           data-action="click->gallery-toggle#show">
        <% if @hotel.primary_photo.present? %>
          <%= image_tag @hotel.primary_photo, class: "w-full h-full object-cover group-hover:scale-105 transition-transform duration-700" %>
        <% else %>
          <div class="w-full h-full bg-neutral-border flex items-center justify-center">
            <svg class="w-16 h-16 text-neutral-text-secondary" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z"/><path d="M14 2v4a2 2 0 0 0 2 2h4"/><path d="m10 13 2 2 4-4"/></svg>
          </div>
        <% end %>
      </div>
      <% @hotel.secondary_photos_with_fallbacks.each_with_index do |item, index| %>
        <div class="hidden md:block rounded-2xl overflow-hidden shadow-md group relative cursor-pointer" 
             data-action="click->gallery-toggle#show">
          <% if item[:is_attachment] %>
            <%= image_tag item[:photo], class: "w-full h-full object-cover group-hover:scale-110 transition-transform duration-500", alt: @hotel.name %>
          <% else %>
            <img src="<%= item[:photo] %>" class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-500" alt="Hotel Image">
          <% end %>

          <% if index == 3 %>
            <div class="absolute inset-0 bg-black/40 flex items-center justify-center pointer-events-none">
              <span class="inline-flex items-center gap-x-2 rounded-full bg-white/90 px-4 py-2 text-sm font-semibold text-neutral-text-primary shadow-sm">
                <svg class="h-4 w-4" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="18" x="3" y="4" rx="2" ry="2"/><circle cx="9" cy="9" r="2"/><path d="m21 15-3.086-3.086a2 2 0 0 0-2.828 0L6 21"/></svg>
                See all photos
              </span>
            </div>
          <% end %>
        </div>
      <% end %>
    </div>
 
    <% if @hotel.has_photos? %>
      <div class="mt-4 md:hidden">
        <button type="button" data-action="click->gallery-toggle#show" class="inline-flex w-full items-center justify-center gap-x-2 rounded-xl border border-neutral-border bg-white px-4 py-3 text-sm font-semibold text-neutral-text-primary shadow-sm hover:bg-neutral-bg">
          <svg class="h-4 w-4" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="18" x="3" y="4" rx="2" ry="2"/><circle cx="9" cy="9" r="2"/><path d="m21 15-3.086-3.086a2 2 0 0 0-2.828 0L6 21"/></svg>
          See all photos
        </button>
      </div>
    <% end %>
  </div>

  <div class="max-w-[85rem] mx-auto px-4 py-6 sm:px-6 lg:px-8">
    <div class="flex flex-col lg:flex-row gap-8">
      <%# Main Content %>
      <div class="flex-1 space-y-8">
        
        <%# Hotel Info Header %>
        <div class="card p-6 md:p-8">
          <div class="flex justify-between items-start mb-4">
            <div>
              <div class="flex items-center gap-x-2 mb-2">
                <div class="flex text-amber-400">
                  <% @hotel.star_rating_int.times do %>
                    <%= cached_icon "star", library: "phosphor", variant: "fill", class: "w-3.5 h-3.5 fill-current" %>
                  <% end %>
                </div>
                <span class="text-xs font-bold text-neutral-text-secondary uppercase tracking-widest">Hotel Grade</span>
              </div>
              <h1 class="text-3xl md:text-4xl font-extrabold text-neutral-text-primary mb-2"><%= @hotel.name %></h1>
              <p class="text-neutral-text-secondary flex items-start gap-x-2">
                <svg class="w-5 h-5 mt-0.5 text-brand-primary shrink-0" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg>
                <span><%= @hotel.full_address %></span>
              </p>
            </div>
            <div class="hidden sm:block text-right">
              <div class="bg-brand-primary text-white p-3 rounded-xl shadow-lg shadow-brand-primary/20">
                <span class="block text-[10px] uppercase font-black tracking-tighter opacity-80">Guest Rating</span>
                <span class="text-2xl font-black italic tracking-tighter">4.8</span>
              </div>
            </div>
          </div>

          <%= render "categorized_amenities", categorized_amenities: @categorized_amenities %>
        </div>

        <%# About / Story Section %>
        <div class="space-y-4">
          <h2 class="text-2xl font-extrabold text-neutral-text-primary">About this hotel</h2>
          <div class="prose prose-neutral max-w-none text-neutral-text-secondary leading-relaxed">
            <p>Welcome to <%= @hotel.name %>, where local hospitality meets modern comfort. Located in the heart of <%= @hotel.city %>, our property is designed for travelers who value simplicity, quality, and direct deals.</p>
            <p>Whether you're visiting for business or leisure, we provide a seamless stay experience with all the essential amenities you need. Book directly with us through WAStays to enjoy the best rates and personalized WhatsApp support throughout your journey.</p>
          </div>
        </div>

        <%# Room Options Section %>
        <div class="space-y-6 pt-4" id="rooms-section">
          <div class="flex justify-between items-end">
            <h2 class="text-2xl font-extrabold text-neutral-text-primary">Select your room</h2>
            <div class="flex items-center gap-3">
              <p class="text-sm text-brand-secondary font-bold">Recommended for <%= @adults %> guests</p>
              
              <%= form_with url: hotel_path(@hotel), method: :get, local: true, class: "hidden sm:block" do |f| %>
                <% request.query_parameters.except("display_currency").each do |key, value| %>
                  <%= hidden_field_tag key, value %>
                <% end %>
                <%= f.select :display_currency,
                             options_for_select(@hotel.currency_dropdown_options, @display_currency),
                             {},
                             class: "rounded-lg border border-neutral-border bg-white px-3 py-2 text-xs font-bold text-neutral-text-primary",
                             onchange: "this.form.submit()",
                             aria: { label: "Display currency" } %>
              <% end %>
            </div>
          </div>

          <div class="space-y-6">
            <% if @search_ready && @room_types.empty? %>
              <div class="card p-8 text-center">
                <h3 class="text-lg font-bold text-neutral-text-primary mb-2">No rooms available for selected dates</h3>
                <p class="text-sm text-neutral-text-secondary mb-6">Try changing your check-in/check-out dates to see available options.</p>
                <%= link_to "Edit Search", "#", data: { action: "click->rate-calendar#openPicker" }, class: "btn btn-secondary px-8" %>
              </div>
            <% end %>

            <% @room_types.each do |room_type| %>
              <%= render "room_card",
                         room_type: room_type,
                         hotel: @hotel,
                         search_ready: @search_ready,
                         check_in: @check_in,
                         check_out: @check_out,
                         adults: @adults,
                         children: @children,
                         room_count: @room_count,
                         display_currency: @display_currency %>
            <% end %>
          </div>
        </div>
      </div>

      <%# Sticky Sidebar %>
      <aside class="lg:w-80">
        <div class="sticky top-[130px] space-y-6">
          <%# Location Map Card %>
          <div class="card p-6 bg-white shadow-sm">
            <%# Card Header %>
            <div class="flex justify-between items-center mb-4 pb-3 border-b border-neutral-bg">
              <h3 class="text-xs font-black text-neutral-text-primary uppercase tracking-widest flex items-center gap-x-2">
                <%= cached_icon "map-pin", class: "w-4 h-4 text-brand-primary" %>
                Location
              </h3>
            </div>

            <%# Map Frame Wrapper %>
            <div class="h-40 w-full bg-neutral-bg rounded-lg overflow-hidden border border-neutral-border relative group cursor-pointer">
              <%# Interactive Overlay Link %>
              <div class="absolute inset-0 bg-black/0 group-hover:bg-black/5 transition-colors z-10"></div>
              <a href="https://www.google.com/maps/search/?api=1&query=<%= u("#{@hotel.name}, #{@hotel.full_address}") %>" 
                 target="_blank" 
                 rel="noopener noreferrer" 
                 class="absolute inset-0 z-20" 
                 title="Open <%= @hotel.name %> on Google Maps">
              </a>
              <iframe
                width="100%"
                height="100%"
                style="border:0;"
                loading="lazy"
                allowfullscreen
                referrerpolicy="no-referrer-when-downgrade"
                src="https://maps.google.com/maps?q=<%= u("#{@hotel.name}, #{@hotel.full_address}") %>&t=&z=15&ie=UTF8&iwloc=&output=embed">
              </iframe>
            </div>
          </div>

          <div class="card p-6 bg-white">
            <h3 class="text-xs font-black text-neutral-text-primary uppercase tracking-widest mb-4 pb-3 border-b border-neutral-bg flex items-center gap-x-2">
              <svg class="w-4 h-4 text-brand-primary" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
              Check-in & Policies
            </h3>
            <ul class="space-y-3 text-sm text-neutral-text-secondary">
              <li class="flex justify-between border-b border-neutral-bg pb-2">
                <span>Check-in time</span>
                <span class="font-bold text-neutral-text-primary"><%= @hotel.check_in_time %></span>
              </li>
              <li class="flex justify-between pb-2">
                <span>Check-out time</span>
                <span class="font-bold text-neutral-text-primary"><%= @hotel.check_out_time %></span>
              </li>
              <li class="pt-1 border-t border-neutral-bg">
                <p class="font-bold text-neutral-text-primary mb-1 text-[10px] uppercase tracking-widest">Important Info</p>
                <p class="text-xs leading-relaxed"><%= @hotel.cancellation_policy %></p>
              </li>
            </ul>
          </div>

          <div class="card p-6 bg-brand-primary text-white border-none">
            <div class="flex flex-col items-center text-center gap-y-3">
              <div class="w-10 h-10 rounded-full bg-white/10 flex items-center justify-center">
                <svg class="w-5 h-5 text-white" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/></svg>
              </div>
              <div>
                <p class="font-bold text-sm">Need assistance?</p>
                <p class="text-xs text-white/70 mt-0.5">Our travel experts are ready to help you via WhatsApp.</p>
              </div>
              <a href="https://wa.me/601162023996" target="_blank" rel="noopener noreferrer"
                 class="w-full text-center text-sm font-bold bg-white text-brand-primary rounded-full py-2 px-4 hover:bg-white/90 transition-colors">
                Chat with an expert
              </a>
            </div>
          </div>

          <div class="card p-6 bg-red-50/50 border-red-100">
            <h4 class="text-xs font-black text-brand-primary uppercase tracking-widest mb-3">Why book here?</h4>
            <ul class="space-y-3">
              <li class="flex items-start gap-x-2 text-xs font-medium text-neutral-text-secondary leading-snug">
                <svg class="w-3.5 h-3.5 text-status-success shrink-0 mt-0.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"/></svg>
                No hidden fees or service charges
              </li>
              <li class="flex items-start gap-x-2 text-xs font-medium text-neutral-text-secondary leading-snug">
                <svg class="w-3.5 h-3.5 text-status-success shrink-0 mt-0.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"/></svg>
                Verified local budget stays
              </li>
              <li class="flex items-start gap-x-2 text-xs font-medium text-neutral-text-secondary leading-snug">
                <svg class="w-3.5 h-3.5 text-status-success shrink-0 mt-0.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"/></svg>
                Direct WhatsApp line to the hotel
              </li>
            </ul>
          </div>
        </div>
      </aside>
    </div>
  </div>

  <%# Mobile Sticky CTA (Keep as partial as it's a floating fixed element) %>
  <%= render "mobile_sticky_cta", 
             hotel: @hotel, 
             availability_service: @availability_service, 
             room_types: @room_types %>
</div>
