<div class="bg-neutral-bg min-h-screen pb-24 lg:pb-0" 
     data-controller="gallery-toggle room-details" 
     data-gallery-toggle-photos-value="<%= @hotel.ordered_photo_attachments.map { |p| url_for(p) }.to_json %>"
     data-gallery-toggle-index-value="0">
<% content_for :hide_chrome, true %>

<%# ── Search-bar header (replaces global nav on this page) ── %>
<%= render "hotel_search_bar",
    hotel: @hotel,
    check_in: @check_in,
    check_out: @check_out,
    adults: @adults,
    children: @children,
    room_count: @room_count %>

<%# Breadcrumb %>
<div class="bg-white border-b border-neutral-border">
  <div class="max-w-[85rem] mx-auto px-4 py-2.5">
    <nav class="flex text-sm text-neutral-text-secondary" aria-label="Breadcrumb">
      <%= link_to "Hotels", hotels_path(request.query_parameters), class: "hover:text-brand-primary" %>
      <svg class="mx-2 h-4 w-4 text-gray-400 self-center" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="m9 18 6-6-6-6"/></svg>
      <span class="font-semibold text-neutral-text-primary truncate"><%= @hotel.name %></span>
    </nav>
  </div>
</div>

  <% if @show_stay_modal %>
    <div class="fixed inset-0 z-[200] bg-black/55 backdrop-blur-sm px-4 sm:px-6 flex items-center justify-center overflow-y-auto" role="dialog" aria-modal="true" onclick="if (event.target === this) { this.classList.add('hidden') }">
      <div class="w-full max-w-xl my-6 rounded-2xl bg-white shadow-2xl border border-neutral-border p-6 sm:p-8" onclick="event.stopPropagation()">
        <h2 class="text-2xl font-extrabold text-neutral-text-primary mb-2">Select Your Stay Dates</h2>
        <p class="text-sm text-neutral-text-secondary mb-6">Choose your check-in and check-out dates to see accurate room availability and price.</p>

        <%= form_with url: hotel_path(@hotel),
                      method: :get,
                      local: true,
                      class: "space-y-4",
                      html: {
                        onsubmit: "var params=new URLSearchParams(new FormData(this));window.location.replace(this.action+'?'+params.toString());return false;"
                      } do |f| %>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>
              <%= f.label :check_in, "Check-in", class: "block text-xs font-bold uppercase tracking-wider text-neutral-text-secondary mb-2" %>
              <%= f.date_field :check_in, value: (@check_in || Date.current).to_s, required: true, class: "w-full rounded-xl border border-neutral-border px-4 py-3 text-sm font-semibold text-neutral-text-primary" %>
            </div>
            <div>
              <%= f.label :check_out, "Check-out", class: "block text-xs font-bold uppercase tracking-wider text-neutral-text-secondary mb-2" %>
              <%= f.date_field :check_out, value: (@check_out || Date.tomorrow).to_s, required: true, class: "w-full rounded-xl border border-neutral-border px-4 py-3 text-sm font-semibold text-neutral-text-primary" %>
            </div>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
            <div>
              <%= f.label :adults, "Adults", class: "block text-xs font-bold uppercase tracking-wider text-neutral-text-secondary mb-2" %>
              <%= f.select :adults, options_for_select((1..8).map { |n| [n, n] }, @adults), {}, class: "w-full rounded-xl border border-neutral-border px-4 py-3 text-sm font-semibold text-neutral-text-primary" %>
            </div>
            <div>
              <%= f.label :children, "Children", class: "block text-xs font-bold uppercase tracking-wider text-neutral-text-secondary mb-2" %>
              <%= f.select :children, options_for_select((0..6).map { |n| [n, n] }, @children), {}, class: "w-full rounded-xl border border-neutral-border px-4 py-3 text-sm font-semibold text-neutral-text-primary" %>
            </div>
            <div>
              <%= f.label :room_count, "Rooms", class: "block text-xs font-bold uppercase tracking-wider text-neutral-text-secondary mb-2" %>
              <%= f.select :room_count, options_for_select((1..5).map { |n| [n, n] }, @room_count), {}, class: "w-full rounded-xl border border-neutral-border px-4 py-3 text-sm font-semibold text-neutral-text-primary" %>
            </div>
          </div>

          <div>
            <%= f.label :display_currency, "Display Currency", class: "block text-xs font-bold uppercase tracking-wider text-neutral-text-secondary mb-2" %>
            <%= f.select :display_currency, options_for_select(CurrencyCatalog.options, @display_currency), {}, class: "w-full rounded-xl border border-neutral-border px-4 py-3 text-sm font-semibold text-neutral-text-primary" %>
            <p class="mt-1 text-[11px] text-neutral-text-secondary">Prices are estimates when display currency differs from the charged hotel currency.</p>
          </div>

          <div class="pt-2">
            <%= f.submit "Check Availability", class: "btn btn-primary w-full py-3 text-sm font-bold uppercase tracking-widest" %>
          </div>
        <% end %>
      </div>
    </div>
  <% end %>

  <!-- Gallery Section -->
  <div id="hotel-gallery-top" class="max-w-[85rem] mx-auto px-4 py-6 sm:px-6 lg:px-8">
    <% hotel_gallery_photos = @hotel.ordered_photo_attachments.first(5) %>
    <% hotel_gallery_count = @hotel.photos.attached? ? @hotel.photos.count : 0 %>
    <% extra_gallery_photos = [hotel_gallery_count - hotel_gallery_photos.size, 0].max %>
    <% fallback_images = [
      "https://images.unsplash.com/photo-1566073771259-6a8506099945?auto=format&fit=crop&q=80&w=600",
      "https://images.unsplash.com/photo-1582719478250-c89cae4dc85b?auto=format&fit=crop&q=80&w=600",
      "https://images.unsplash.com/photo-1520250497591-112f2f40a3f4?auto=format&fit=crop&q=80&w=600",
      "https://images.unsplash.com/photo-1549443105-2070367f4077?auto=format&fit=crop&q=80&w=600"
    ] %>
    <div class="grid grid-cols-1 md:grid-cols-4 gap-4 md:h-[420px]">
      <div class="md:col-span-2 md:row-span-2 aspect-[2/1] md:aspect-auto rounded-2xl overflow-hidden shadow-lg group cursor-pointer" 
           data-action="click->gallery-toggle#show">
        <% if hotel_gallery_photos.first.present? %>
          <%= image_tag hotel_gallery_photos.first, class: "w-full h-full object-cover group-hover:scale-105 transition-transform duration-700" %>
        <% elsif @hotel.room_types.first&.photos&.attached? %>
          <%= image_tag @hotel.room_types.first.photos.first, class: "w-full h-full object-cover group-hover:scale-105 transition-transform duration-700" %>
        <% else %>
          <div class="w-full h-full bg-neutral-border flex items-center justify-center">
            <svg class="w-16 h-16 text-neutral-text-secondary" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z"/><path d="M14 2v4a2 2 0 0 0 2 2h4"/><path d="m10 13 2 2 4-4"/></svg>
          </div>
        <% end %>
      </div>
      <% (1..4).each do |i| %>
        <div class="hidden md:block rounded-2xl overflow-hidden shadow-md group relative cursor-pointer" 
             data-action="click->gallery-toggle#show">
          <% if hotel_gallery_photos[i].present? %>
            <%= image_tag hotel_gallery_photos[i], class: "w-full h-full object-cover group-hover:scale-110 transition-transform duration-500", alt: @hotel.name %>
          <% else %>
            <img src="<%= fallback_images[i - 1] %>" class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-500" alt="Hotel Image">
          <% end %>

          <% if i == 4 %>
            <div class="absolute inset-0 bg-black/40 flex items-center justify-center pointer-events-none">
              <span class="inline-flex items-center gap-x-2 rounded-full bg-white/90 px-4 py-2 text-sm font-semibold text-neutral-text-primary shadow-sm">
                <svg class="h-4 w-4" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="18" x="3" y="4" rx="2" ry="2"/><circle cx="9" cy="9" r="2"/><path d="m21 15-3.086-3.086a2 2 0 0 0-2.828 0L6 21"/></svg>
                See all photos
              </span>
            </div>
          <% end %>
        </div>
      <% end %>
    </div>

    <% if @hotel.photos.attached? && hotel_gallery_count.positive? %>
      <div class="mt-4 md:hidden">
        <button type="button" data-action="click->gallery-toggle#show" class="inline-flex w-full items-center justify-center gap-x-2 rounded-xl border border-neutral-border bg-white px-4 py-3 text-sm font-semibold text-neutral-text-primary shadow-sm hover:bg-neutral-bg">
          <svg class="h-4 w-4" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="18" x="3" y="4" rx="2" ry="2"/><circle cx="9" cy="9" r="2"/><path d="m21 15-3.086-3.086a2 2 0 0 0-2.828 0L6 21"/></svg>
          See all photos
        </button>
      </div>
    <% end %>
  </div>

  <% if @hotel.photos.attached? %>
    <div id="hotel-photo-gallery" 
         class="hidden fixed inset-0 z-[120] bg-gray-900/70 backdrop-blur-sm p-0 sm:px-6 sm:pb-6 lg:px-10 lg:pb-10 flex items-start justify-center pt-4 sm:pt-10 lg:pt-8 transition-opacity" 
         data-gallery-toggle-target="panel"
         data-action="click->gallery-toggle#hide">
      
      <div class="relative w-full h-[94vh] sm:h-[84vh] max-w-7xl overflow-hidden rounded-none sm:rounded-3xl bg-white shadow-2xl flex flex-col" 
           data-action="click->gallery-toggle#stop">
        
        <!-- Header -->
        <div class="flex items-center justify-between gap-4 border-b border-neutral-border px-5 py-4 sm:px-8 sm:py-6 shrink-0 bg-white z-20">
          <div class="flex items-center gap-x-4">
            <button type="button" 
                    data-gallery-toggle-target="backButton"
                    data-action="click->gallery-toggle#closeViewer"
                    class="hidden h-9 w-9 flex items-center justify-center rounded-full bg-neutral-bg text-neutral-text-primary hover:bg-neutral-border transition-colors">
              <svg class="h-5 w-5" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg>
            </button>
            <h2 class="text-xl font-extrabold text-neutral-text-primary">
              <span data-gallery-toggle-target="headerTitle">Hotel Photos</span>
            </h2>
          </div>

          <button type="button" data-action="click->gallery-toggle#hide" class="h-10 w-10 flex items-center justify-center rounded-full border border-neutral-border text-neutral-text-secondary hover:bg-neutral-bg hover:text-neutral-text-primary transition-colors">
            <svg class="h-5 w-5" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg>
          </button>
        </div>

        <!-- Body -->
        <div class="flex-grow overflow-hidden relative flex flex-col">
          <!-- Grid Mode Content -->
          <div data-gallery-toggle-target="grid" class="h-full overflow-y-auto p-5 sm:p-8">
            <div class="grid gap-4 grid-cols-2 sm:grid-cols-3 lg:grid-cols-4">
              <% @hotel.ordered_photo_attachments.each_with_index do |photo, index| %>
                <div class="aspect-[4/3] overflow-hidden rounded-2xl border border-neutral-border bg-neutral-bg cursor-pointer group"
                     data-action="click->gallery-toggle#openViewer"
                     data-index="<%= index %>">
                  <%= image_tag photo, class: "w-full h-full object-cover group-hover:scale-110 transition-transform duration-500" %>
                </div>
              <% end %>
            </div>
          </div>

          <!-- Viewer Mode Content -->
          <div data-gallery-toggle-target="viewer" class="hidden h-full flex flex-col bg-neutral-900">
            <!-- Main Display Area -->
            <div class="flex-grow flex items-center justify-center relative overflow-hidden"
                 data-action="touchstart->gallery-toggle#touchStart touchmove->gallery-toggle#touchMove touchend->gallery-toggle#touchEnd">
              
              <img data-gallery-toggle-target="backdropImage" src="" class="absolute inset-0 h-full w-full scale-110 object-cover blur-2xl opacity-40">
              
              <button type="button" data-action="click->gallery-toggle#prev" class="absolute left-4 z-20 h-12 w-12 flex items-center justify-center rounded-xl bg-white/95 text-blue-600 shadow-md hover:bg-white transition-colors">
                <svg class="h-6 w-6" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" /></svg>
              </button>

              <img data-gallery-toggle-target="lightboxImage" src="" class="relative z-10 max-w-full max-h-full object-contain">

              <button type="button" data-action="click->gallery-toggle#next" class="absolute right-4 z-20 h-12 w-12 flex items-center justify-center rounded-xl bg-white/95 text-blue-600 shadow-md hover:bg-white transition-colors">
                <svg class="h-6 w-6" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" /></svg>
              </button>

              <div data-gallery-toggle-target="viewerCounter" class="hidden absolute bottom-6 left-1/2 -translate-x-1/2 z-20 rounded-full bg-black/45 px-3 py-1 text-sm font-semibold text-white">
                <span data-gallery-toggle-target="indexDisplay">1</span> / <%= @hotel.photos.count %>
              </div>
            </div>

            <!-- Thumbnails Strip -->
            <div class="bg-black/50 backdrop-blur-md p-4 sm:p-5 border-t border-white/5 overflow-x-auto shrink-0">
              <div data-gallery-toggle-target="thumbnails" class="flex gap-3 justify-center min-w-max mx-auto pb-1">
                <!-- Thumbnails rendered by JS -->
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  <% end %>

  <!-- Room Details Modal -->
  <div id="room-details-modal" 
       class="hidden fixed inset-0 z-[150] bg-gray-900/60 backdrop-blur-sm lg:p-10 flex items-center justify-center transition-opacity" 
       data-room-details-target="modal"
       data-action="click->room-details#close">
    <div class="relative h-[94vh] w-screen overflow-hidden bg-white flex flex-col md:h-[84vh] md:w-full md:max-w-[84rem] md:rounded-[1.75rem] md:shadow-2xl" 
         data-action="click->room-details#stop">
      <button type="button" 
              data-action="click->room-details#close" 
              class="absolute right-4 top-4 z-20 inline-flex h-10 w-10 items-center justify-center rounded-full bg-white/95 text-gray-500 shadow-md hover:bg-white hover:text-gray-700 transition-colors md:right-5 md:top-5">
        <svg class="h-5 w-5" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg>
      </button>

      <div class="flex min-h-0 flex-1 flex-col md:flex-row">
        <div class="flex w-full min-h-0 flex-col bg-white md:w-[68%]">
          <div class="px-4 pt-4 md:px-6 md:pt-6">
            <div class="relative overflow-hidden rounded-2xl bg-black h-[42vh] min-h-[300px] md:h-[54vh] md:min-h-[430px] group"
                 data-room-details-target="viewer"
                 data-action="touchstart->room-details#touchStart touchmove->room-details#touchMove touchend->room-details#touchEnd">
              <img data-room-details-target="backdropImage" src="" class="absolute inset-0 h-full w-full scale-110 object-cover blur-2xl opacity-55">
              <div class="absolute inset-0 bg-black/18"></div>
              <img data-room-details-target="mainImage" src="" class="relative z-[1] h-full w-full object-contain p-3 md:p-0">

              <button type="button" data-action="click->room-details#prev" class="absolute left-4 top-1/2 z-10 flex h-12 w-12 -translate-y-1/2 items-center justify-center rounded-xl bg-white/95 text-blue-600 shadow-md hover:bg-white md:left-6">
                <svg class="h-6 w-6" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" /></svg>
              </button>
              <button type="button" data-action="click->room-details#next" class="absolute right-4 top-1/2 z-10 flex h-12 w-12 -translate-y-1/2 items-center justify-center rounded-xl bg-white/95 text-blue-600 shadow-md hover:bg-white md:right-6">
                <svg class="h-6 w-6" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" /></svg>
              </button>

              <div class="absolute bottom-4 left-1/2 z-[1] -translate-x-1/2 rounded-full bg-black/45 px-3 py-1 text-sm font-semibold text-white">
                <span data-room-details-target="indexDisplay">1</span>/<span data-room-details-target="totalCount">1</span>
              </div>
            </div>
          </div>

          <div class="hidden shrink-0 border-t border-gray-100 bg-white px-4 py-4 md:block md:px-6">
            <div data-room-details-target="thumbnails" class="flex gap-3 overflow-x-auto pb-1">
            </div>
          </div>
        </div>

        <div class="w-full min-h-0 flex-col overflow-y-auto bg-white md:w-[32%] md:border-l md:border-gray-100">
          <div class="p-6 md:p-7">
            <h2 data-room-details-target="name" class="text-2xl font-bold text-gray-900 mb-4 pr-6"></h2>
          
            <h3 class="text-sm font-bold text-gray-900 mb-3">Room Information</h3>
            <ul class="space-y-4 mb-8">
            <li class="flex items-center gap-3">
              <svg class="w-5 h-5 text-gray-400 shrink-0" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/></svg>
              <div>
                <p class="text-sm font-medium text-gray-900"><span data-room-details-target="adults"></span></p>
                <p class="text-xs text-gray-500">Maximum adults allowed</p>
              </div>
            </li>
            <li class="flex items-center gap-3" data-room-details-target="childrenContainer">
              <svg class="w-5 h-5 text-gray-400 shrink-0" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
              <div>
                <p class="text-sm font-medium text-gray-900"><span data-room-details-target="children"></span></p>
                <p class="text-xs text-gray-500">Maximum children allowed</p>
              </div>
            </li>
          </ul>

          <h3 class="text-sm font-bold text-gray-900 mb-3">Description</h3>
          <div class="text-sm text-gray-600 leading-relaxed mb-8">
            <p data-room-details-target="description"></p>
          </div>

          <div data-room-details-target="amenitiesSection" class="hidden">
            <h3 class="text-sm font-black text-neutral-text-primary uppercase tracking-widest mb-3">Room Amenities</h3>
            <div data-room-details-target="amenitiesList" class="space-y-6">
              <!-- Amenities will be rendered here -->
            </div>
            <div class="flex justify-end">
              <button type="button" 
                      data-room-details-target="roomAmenitiesToggle"
                      data-action="click->room-details#toggleRoomAmenities"
                      class="mt-4 text-xs font-bold text-blue-600 hover:text-blue-700 flex items-center gap-1 hidden">
                <span>Show more</span>
                <svg class="w-3.5 h-3.5" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6"/></svg>
              </button>
            </div>
          </div>

          <div data-room-details-target="hotelAmenitiesSection" class="hidden mt-6">
            <h3 class="text-sm font-black text-neutral-text-primary uppercase tracking-widest mb-3">Hotel Amenities</h3>
            <div data-room-details-target="hotelAmenitiesList" class="space-y-6">
              <!-- Hotel Amenities will be rendered here -->
            </div>
            <div class="flex justify-end">
              <button type="button" 
                      data-room-details-target="hotelAmenitiesToggle"
                      data-action="click->room-details#toggleHotelAmenities"
                      class="mt-4 text-xs font-bold text-blue-600 hover:text-blue-700 flex items-center gap-1 hidden">
                <span>Show more</span>
                <svg class="w-3.5 h-3.5" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6"/></svg>
              </button>
            </div>
          </div>
        </div>
      </div>
      </div>
    </div>
  </div>

  <!-- Amenity Category Template -->
  <template id="amenity-category-template">
    <div class="mb-6">
      <h4 class="flex items-center gap-x-2 text-[11px] font-black text-neutral-text-primary uppercase tracking-[0.1em] mb-3">
        <span data-category-icon></span>
        <span data-category-name></span>
      </h4>
      <div data-amenity-list class="grid grid-cols-2 gap-y-3 gap-x-4">
      </div>
    </div>
  </template>

  <!-- Amenity Item Template -->
  <template id="amenity-item-template">
    <div class="flex items-center gap-x-2.5 text-[13px] font-medium text-neutral-text-secondary">
      <svg class="w-5 h-5 text-slate-900 shrink-0" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
        <path d="M9 22H15C20 22 22 20 22 15V9C22 4 20 2 15 2H9C4 2 2 4 2 9V15C2 20 4 22 9 22Z" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
        <path d="M7.75 12L10.58 14.83L16.25 9.17004" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
      <span data-amenity-name></span>
    </div>
  </template>

  <div class="max-w-[85rem] mx-auto px-4 py-6 sm:px-6 lg:px-8">
    <div class="flex flex-col lg:flex-row gap-8">
      <!-- Main Content -->
      <div class="flex-1 space-y-8">
        <!-- Hotel Info Header -->
        <div class="card p-6 md:p-8">
          <div class="flex justify-between items-start mb-4">
            <div>
              <div class="flex items-center gap-x-2 mb-2">
                <div class="flex text-amber-400">
                  <% @hotel.star_rating.to_i.times do %>
                    <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
                  <% end %>
                </div>
                <span class="text-xs font-bold text-neutral-text-secondary uppercase tracking-widest">Hotel Grade</span>
              </div>
              <h1 class="text-3xl md:text-4xl font-extrabold text-neutral-text-primary mb-2"><%= @hotel.name %></h1>
              <p class="text-neutral-text-secondary flex items-start gap-x-2">
                <svg class="w-5 h-5 mt-0.5 text-brand-primary shrink-0" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg>
                <span><%= @hotel.address %>, <%= @hotel.city %>, <%= @hotel.country %></span>
              </p>
            </div>
            <div class="hidden sm:block text-right">
              <div class="bg-brand-primary text-white p-3 rounded-xl shadow-lg shadow-brand-primary/20">
                <span class="block text-[10px] uppercase font-black tracking-tighter opacity-80">Guest Rating</span>
                <span class="text-2xl font-black italic tracking-tighter">4.8</span>
              </div>
            </div>
          </div>

          <% if @categorized_amenities.any? %>
            <div class="mt-8" data-controller="hotel-amenities">
              <!-- Initial View (Collapsed) -->
              <div data-hotel-amenities-target="collapsedContent">
                <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-x-8 gap-y-10">
                  <% 
                    visible_categories_count = 0
                    total_amenities_count = 0
                    @categorized_amenities.each do |category, amenities|
                      break if visible_categories_count >= 3
                      
                      visible_amenities = amenities.take(5)
                      
                      if visible_amenities.any?
                        visible_categories_count += 1
                        total_amenities_count += visible_amenities.size
                  %>
                    <div>
                      <h4 class="flex items-center gap-x-2 text-xs font-black text-neutral-text-primary uppercase tracking-widest mb-4">
                        <%= category_icon(category) %>
                        <%= category %>
                      </h4>
                      <div class="space-y-3">
                        <% visible_amenities.each do |amenity| %>
                          <div class="flex items-center gap-x-2.5 text-[13px] font-medium text-neutral-text-secondary">
                            <svg class="w-5 h-5 text-status-success shrink-0" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
                            <span><%= amenity.name %></span>
                          </div>
                        <% end %>
                      </div>
                    </div>
                  <% 
                      end
                    end 
                  %>
                </div>
              </div>

              <!-- Full View (Expanded) -->
              <div data-hotel-amenities-target="expandedContent" class="hidden">
                <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-x-8 gap-y-10">
                  <% @categorized_amenities.each do |category, amenities| %>
                    <div>
                      <h4 class="flex items-center gap-x-2 text-xs font-black text-neutral-text-primary uppercase tracking-widest mb-4">
                        <%= category_icon(category) %>
                        <%= category %>
                      </h4>
                      <div class="space-y-3">
                        <% amenities.each do |amenity| %>
                          <div class="flex items-center gap-x-2.5 text-[13px] font-medium text-neutral-text-secondary">
                            <svg class="w-5 h-5 text-status-success shrink-0" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
                            <span><%= amenity.name %></span>
                          </div>
                        <% end %>
                      </div>
                    </div>
                  <% end %>
                </div>
              </div>

              <% if @categorized_amenities.size > visible_categories_count || @categorized_amenities.sum { |_, a| a.size } > total_amenities_count %>
                <button type="button" 
                        class="mt-6 text-sm font-bold text-blue-600 hover:text-blue-700 flex items-center gap-1 transition-colors"
                        data-action="click->hotel-amenities#toggle"
                        data-hotel-amenities-target="showMoreButton">
                  Show more
                </button>
              <% end %>
            </div>
          <% end %>
        </div>

        <!-- About / Story Section -->
        <div class="space-y-4">
          <h2 class="text-2xl font-extrabold text-neutral-text-primary">About this hotel</h2>
          <div class="prose prose-neutral max-w-none text-neutral-text-secondary leading-relaxed">
            <p>Welcome to <%= @hotel.name %>, where local hospitality meets modern comfort. Located in the heart of <%= @hotel.city %>, our property is designed for travelers who value simplicity, quality, and direct deals.</p>
            <p>Whether you're visiting for business or leisure, we provide a seamless stay experience with all the essential amenities you need. Book directly with us through WAStays to enjoy the best rates and personalized WhatsApp support throughout your journey.</p>
          </div>
        </div>

        <!-- Room Options Section -->
        <div class="space-y-6 pt-4" id="rooms-section">
          <div class="flex justify-between items-end">
            <h2 class="text-2xl font-extrabold text-neutral-text-primary">Select your room</h2>
            <div class="flex items-center gap-3">
              <p class="text-sm text-brand-secondary font-bold">Recommended for <%= @adults %> guests</p>
              <%= form_with url: hotel_path(@hotel), method: :get, local: true, class: "hidden sm:block" do |f| %>
                <% request.query_parameters.except("display_currency").each do |key, value| %>
                  <%= hidden_field_tag key, value %>
                <% end %>
                <%= f.select :display_currency,
                             options_for_select(CurrencyCatalog::COMMON_CODES.map { |code| [ code, code ] }, @display_currency),
                             {},
                             class: "rounded-lg border border-neutral-border bg-white px-3 py-2 text-xs font-bold text-neutral-text-primary",
                             onchange: "this.form.submit()",
                             aria: { label: "Display currency" } %>
              <% end %>
            </div>
          </div>

          <div class="space-y-6">
            <% if @search_ready && @room_types.empty? %>
              <div class="card p-8 text-center">
                <h3 class="text-lg font-bold text-neutral-text-primary mb-2">No rooms available for selected dates</h3>
                <p class="text-sm text-neutral-text-secondary mb-6">Try changing your check-in/check-out dates to see available options.</p>
                <%= link_to "Edit Search", "#", data: { action: "click->rate-calendar#openPicker" }, class: "btn btn-secondary px-8" %>
              </div>
            <% end %>

            <% @room_types.each do |room_type| %>
              <div class="card overflow-hidden group hover:shadow-xl transition-all duration-300">
                <div class="flex flex-col md:flex-row">
                  <div class="md:w-80 lg:w-96 h-64 md:h-auto relative overflow-hidden cursor-pointer"
                       data-action="click->room-details#open"
                       data-room-details="<%= {
                         name: room_type.name,
                         description: room_type.description,
                         max_adults: room_type.max_adults,
                         max_children: room_type.max_children,
                         photos: room_type.photos.map { |p| url_for(p) },
                         room_amenities: room_type.amenities.map { |id|
                           amenity = Hotel::ROOM_AMENITIES_MAP[id]
                           next nil unless amenity
                           amenity.merge(category_icon: category_icon(amenity[:category]))
                         }.compact,
                         hotel_amenities: @hotel.amenities.map { |id|
                           amenity = Hotel::HOTEL_AMENITIES_MAP[id]
                           next nil unless amenity
                           amenity.merge(category_icon: category_icon(amenity[:category]))
                         }.compact

                       }.to_json %>">

                    <% if room_type.photos.attached? %>
                      <%= image_tag room_type.photos.first, class: "absolute inset-0 w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" %>
                    <% else %>
                      <div class="absolute inset-0 bg-neutral-bg flex items-center justify-center">
                        <svg class="w-12 h-12 text-neutral-border" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z"/><path d="M14 2v4a2 2 0 0 0 2 2h4"/><path d="m10 13 2 2 4-4"/></svg>
                      </div>
                    <% end %>
                  </div>
                  <div class="flex-1 p-6 flex flex-col justify-between">
                    <div>
                      <h3 class="text-xl font-bold text-neutral-text-primary mb-2"><%= room_type.name %></h3>
                      <p class="text-sm text-neutral-text-secondary line-clamp-2 mb-4"><%= room_type.description %></p>
                      
                      <div class="flex flex-wrap gap-y-2 gap-x-4 mb-6">
                        <div class="flex items-center gap-x-1.5 text-xs font-bold text-neutral-text-secondary uppercase tracking-wider">
                          <svg class="w-3.5 h-3.5 text-brand-primary" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/></svg>
                          Up to <%= room_type.max_adults %> Adults
                        </div>
                        <% if room_type.max_children.to_i > 0 %>
                          <div class="flex items-center gap-x-1.5 text-xs font-bold text-neutral-text-secondary uppercase tracking-wider">
                            <svg class="w-3.5 h-3.5 text-brand-primary" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
                            <%= room_type.max_children %> Children
                          </div>
                        <% end %>
                      </div>
                    </div>

                    <div class="flex justify-between items-end border-t border-neutral-border pt-4">
                      <div>
                        <% if @search_ready %>
                          <% pricing_summary = @availability_service.pricing_summary_for(room_type) %>
                          
                          <p class="text-[10px] text-neutral-text-secondary uppercase font-black tracking-widest mb-1">Total for Stay</p>
                          
                          <% if pricing_summary[:partner].present? %>
                            <div class="inline-flex items-center gap-x-1.5 rounded-full bg-blue-50 px-2 py-0.5 text-[9px] font-black uppercase tracking-wider text-blue-700 border border-blue-100 mb-2">
                              <svg class="size-2.5" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2L1 21h22L12 2zm0 3.45l8.15 14.1H3.85L12 5.45zM11 11v4h2v-4h-2zm0 6v2h2v-2h-2z"/></svg>
                              Corporate Rate Applied: <%= pricing_summary[:partner].name %>
                            </div>
                          <% end %>

                          <p class="text-2xl font-black text-neutral-text-primary">
                            <%= display_amount(pricing_summary[:total_price], quote_currency: pricing_summary[:currency], display_currency: @display_currency, hotel: @hotel) %>
                          </p>
                          <p class="text-[10px] text-neutral-text-secondary italic">
                            <%= pricing_summary[:rate_plan_name].presence || "Best available rate" %> · charged in <%= pricing_summary[:currency] %><%= @display_currency != pricing_summary[:currency] ? " · estimate" : "" %>
                          </p>
                        <% else %>
                          <p class="text-[10px] text-neutral-text-secondary uppercase font-black tracking-widest">Total for Stay</p>
                          <p class="text-sm font-bold text-neutral-text-secondary">Select dates to see price</p>
                        <% end %>
                      </div>
                      
                      <%= form_with url: quotes_path, method: :post do |f| %>
                        <%= f.hidden_field :hotel_id, value: @hotel.id %>
                        <%= f.hidden_field :room_type_id, value: room_type.id %>
                        <%= f.hidden_field :check_in, value: @check_in&.to_s %>
                        <%= f.hidden_field :check_out, value: @check_out&.to_s %>
                        <%= f.hidden_field :adults, value: @adults %>
                        <%= f.hidden_field :children, value: @children %>
                        <%= f.hidden_field :room_count, value: @room_count %>
                        <%= f.hidden_field :display_currency, value: @display_currency %>
                        <%= f.hidden_field :partner_code, value: params[:partner_code] %>
                        
                        <%= f.submit "Reserve Now",
                                     disabled: !@search_ready,
                                     class: "btn bg-blue-600 hover:bg-blue-700 text-white font-bold py-3 px-8 shadow-lg shadow-brand-primary/20 disabled:opacity-50 disabled:cursor-not-allowed" %>
                      <% end %>
                    </div>
                  </div>
                </div>
              </div>
            <% end %>
          </div>
        </div>

      </div>

      <!-- Sticky Sidebar -->
      <aside class="lg:w-80">
        <div class="sticky top-[130px] space-y-6">

          <%# Check-in & Policies card %>
          <div class="card p-6 bg-white">
            <h3 class="text-xs font-black text-neutral-text-primary uppercase tracking-widest mb-4 pb-3 border-b border-neutral-bg flex items-center gap-x-2">
              <svg class="w-4 h-4 text-brand-primary" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
              Check-in & Policies
            </h3>
            <ul class="space-y-3 text-sm text-neutral-text-secondary">
              <li class="flex justify-between border-b border-neutral-bg pb-2">
                <span>Check-in time</span>
                <span class="font-bold text-neutral-text-primary"><%= @hotel.property_policy&.check_in_time || "2:00 PM" %></span>
              </li>
              <li class="flex justify-between pb-2">
                <span>Check-out time</span>
                <span class="font-bold text-neutral-text-primary"><%= @hotel.property_policy&.check_out_time || "12:00 PM" %></span>
              </li>
              <li class="pt-1 border-t border-neutral-bg">
                <p class="font-bold text-neutral-text-primary mb-1 text-[10px] uppercase tracking-widest">Important Info</p>
                <p class="text-xs leading-relaxed"><%= @hotel.property_policy&.cancellation_policy.presence || "Cancellation policies are subject to the room type selected. Please review your quote before payment." %></p>
              </li>
            </ul>
          </div>

          <%# Need Assistance card %>
          <div class="card p-6 bg-brand-primary text-white border-none">
            <div class="flex flex-col items-center text-center gap-y-3">
              <div class="w-10 h-10 rounded-full bg-white/10 flex items-center justify-center">
                <svg class="w-5 h-5 text-white" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/></svg>
              </div>
              <div>
                <p class="font-bold text-sm">Need assistance?</p>
                <p class="text-xs text-white/70 mt-0.5">Our travel experts are ready to help you via WhatsApp.</p>
              </div>
              <a href="https://wa.me/601162023996" target="_blank" rel="noopener noreferrer"
                 class="w-full text-center text-sm font-bold bg-white text-brand-primary rounded-full py-2 px-4 hover:bg-white/90 transition-colors">
                Chat with an expert
              </a>
            </div>
          </div>

          <%# Why Book Here card %>
          <div class="card p-6 bg-red-50/50 border-red-100">
            <h4 class="text-xs font-black text-brand-primary uppercase tracking-widest mb-3">Why book here?</h4>
            <ul class="space-y-3">
              <li class="flex items-start gap-x-2 text-xs font-medium text-neutral-text-secondary leading-snug">
                <svg class="w-3.5 h-3.5 text-status-success shrink-0 mt-0.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"/></svg>
                No hidden fees or service charges
              </li>
              <li class="flex items-start gap-x-2 text-xs font-medium text-neutral-text-secondary leading-snug">
                <svg class="w-3.5 h-3.5 text-status-success shrink-0 mt-0.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"/></svg>
                Verified local budget stays
              </li>
              <li class="flex items-start gap-x-2 text-xs font-medium text-neutral-text-secondary leading-snug">
                <svg class="w-3.5 h-3.5 text-status-success shrink-0 mt-0.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"/></svg>
                Direct WhatsApp line to the hotel
              </li>
            </ul>
          </div>

        </div>
      </aside>
    </div>
  </div>

  <!-- Mobile Sticky CTA (Phase 5 requirement) -->
  <div class="lg:hidden fixed bottom-0 inset-x-0 z-[49] bg-white border-t border-neutral-border p-4 shadow-[0_-10px_20px_-5px_rgba(0,0,0,0.1)]">
    <div class="flex items-center justify-between gap-x-4 max-w-[85rem] mx-auto">
      <div>
        <p class="text-[10px] text-neutral-text-secondary uppercase font-black tracking-tighter">Starting from</p>
        <p class="text-xl font-black text-neutral-text-primary">
          <% if @search_ready && @room_types.any? %>
            RM <%= number_with_precision(@availability_service.calculate_total_price(@room_types.first), precision: 2) %>
          <% else %>
            Select dates
          <% end %>
        </p>
      </div>
      <a href="#rooms-section" class="btn btn-primary px-8 py-3 shadow-lg shadow-brand-primary/20">
        Choose Room
      </a>
    </div>
  </div>
</div>
