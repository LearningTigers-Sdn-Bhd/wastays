<div class="max-w-[85rem] mx-auto px-4 sm:px-6 lg:px-8 py-10">
  <div class="flex flex-col md:flex-row justify-between items-center mb-8 gap-4">
    <div>
      <h1 class="text-2xl font-bold text-gray-800">
        Available Hotels
        <% if params[:city].present? %>
          in <%= params[:city] %>
        <% end %>
      </h1>
      <p class="text-gray-600"><%= pluralize(@hotels.count, 'hotel') %> found</p>
    </div>
    
    <div class="w-full md:w-auto">
      <%= link_to "Change Search", root_path, class: "inline-flex items-center gap-x-2 text-sm font-medium text-blue-600 hover:text-blue-800" %>
    </div>
  </div>

  <% if @hotels.any? %>
    <div class="grid lg:grid-cols-2 gap-6">
      <% @hotels.each do |hotel| %>
        <div class="group flex flex-col h-full bg-white border border-gray-200 shadow-sm rounded-xl overflow-hidden hover:shadow-md transition">
          <div class="flex flex-col sm:flex-row h-full">
            <div class="relative w-full sm:w-1/3 min-h-[150px]">
              <% if hotel.room_types.first&.photos&.attached? %>
                <%= image_tag hotel.room_types.first.photos.first, class: "absolute inset-0 w-full h-full object-cover" %>
              <% else %>
                <div class="absolute inset-0 bg-gray-100 flex items-center justify-center">
                  <svg class="h-10 w-10 text-gray-300" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
                  </svg>
                </div>
              <% end %>
            </div>
            
            <div class="p-4 sm:p-6 flex flex-col justify-between w-full sm:w-2/3">
              <div>
                <div class="flex justify-between items-start">
                  <h3 class="text-xl font-bold text-gray-800 group-hover:text-blue-600 transition">
                    <%= hotel.name %>
                  </h3>
                  <div class="flex text-yellow-400">
                    <% hotel.star_rating.to_i.times do %>
                      <svg class="h-4 w-4 fill-current" viewBox="0 0 20 20"><path d="M10 15l-5.878 3.09 1.123-6.545L.489 6.91l6.572-.955L10 0l2.939 5.955 6.572.955-4.756 4.635 1.123 6.545z"/></svg>
                    <% end %>
                  </div>
                </div>
                <p class="mt-1 text-gray-600 text-sm">
                  <svg class="inline-block h-4 w-4 mr-1 mb-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                  </svg>
                  <%= hotel.city %>, <%= hotel.country %>
                </p>
                
                <div class="mt-4 flex flex-wrap gap-2">
                  <span class="inline-flex items-center gap-x-1.5 py-1 px-2 rounded-full text-xs font-medium bg-blue-100 text-blue-800">
                    Free Cancellation
                  </span>
                  <span class="inline-flex items-center gap-x-1.5 py-1 px-2 rounded-full text-xs font-medium bg-green-100 text-green-800">
                    No Upfront Payment
                  </span>
                </div>
              </div>

              <div class="mt-6 flex justify-between items-end">
                <div>
                  <p class="text-xs text-gray-500">Starting from</p>
                  <p class="text-xl font-bold text-blue-600">
                    MYR <%= @availability_service.calculate_total_price(hotel.room_types.first) if hotel.room_types.any? %>
                  </p>                  <p class="text-xs text-gray-400">Excludes taxes & fees</p>
                </div>
                <%= link_to "View Details", hotel_path(hotel, city: params[:city], check_in: params[:check_in], check_out: params[:check_out], adults: params[:adults], children: params[:children]), class: "py-2 px-4 inline-flex items-center gap-x-2 text-sm font-semibold rounded-lg border border-transparent bg-blue-600 text-white hover:bg-blue-700 transition" %>
              </div>
            </div>
          </div>
        </div>
      <% end %>
    </div>
  <% else %>
    <div class="text-center py-20 bg-gray-50 rounded-xl border-2 border-dashed border-gray-200">
      <h3 class="text-xl font-medium text-gray-800 mb-2">No hotels found</h3>
      <p class="text-gray-500 mb-6">Try searching for a different city or changing your criteria.</p>
      <%= link_to "Return Home", root_path, class: "inline-flex items-center gap-x-2 text-sm font-semibold rounded-lg border border-transparent bg-blue-600 text-white hover:bg-blue-700 py-3 px-6" %>
    </div>
  <% end %>
</div>
