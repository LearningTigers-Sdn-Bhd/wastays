<header class="sticky top-0 z-50 w-full bg-white border-b border-neutral-border shadow-sm overflow-visible">
  <%= form_with url: hotel_path(hotel), method: :get, local: true do |f| %>

    <div class="max-w-[85rem] mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center gap-x-4">

      <%# Logo %>
      <a href="<%= root_path %>" class="hidden sm:flex flex-none">
        <%= image_tag "logo/long-logo.png", alt: "WAStays", class: "h-9 w-auto" %>
      </a>

      <%# Search pill — date range + guests %>
      <div data-controller="rate-calendar"
           data-rate-calendar-url-value="<%= rate_calendar_hotel_path(hotel) %>"
           data-rate-calendar-currency-value="<%= hotel.property_policy&.currency || 'MYR' %>"
           data-rate-calendar-room-count-value="<%= room_count %>"
           class="flex-1 flex items-center gap-x-0 rounded-full border border-neutral-border bg-white shadow-sm hover:shadow-md transition-shadow min-w-0 sm:max-w-2xl sm:mx-auto">

        <%# Date pill segment %>
        <div class="flex items-center justify-center px-3 sm:px-4 py-2 flex-1 min-w-0 border-r border-neutral-border cursor-pointer"
             data-action="click->rate-calendar#openPicker">
          <div class="text-center min-w-0">
            <p class="text-[10px] font-bold uppercase tracking-wider text-neutral-text-secondary leading-none mb-0.5 text-center">Check-In / Out</p>
            <p class="text-xs sm:text-sm font-semibold text-neutral-text-primary truncate text-center" data-rate-calendar-target="dateDisplay">
              <% display_check_in = check_in || Date.current
                 display_check_out = check_out || Date.tomorrow %>
              <%= display_check_in.strftime("%a, %d %b") %> → <%= display_check_out.strftime("%a, %d %b") %>
            </p>
          </div>
          <%= f.date_field :check_in, value: (check_in || Date.current).to_s, required: true, autocomplete: "off",
              data: { rate_calendar_target: "checkIn" }, class: "sr-only" %>
          <%= f.date_field :check_out, value: (check_out || Date.tomorrow).to_s, required: true, autocomplete: "off",
              data: { rate_calendar_target: "checkOut" }, class: "sr-only" %>
        </div>

        <%# Guests segment — click to open stepper dropdown %>
        <div class="relative flex-none" data-controller="dropdown hotel-search-bar">
          <button type="button" data-action="click->dropdown#toggle"
                  class="flex items-center gap-x-1.5 px-3 sm:px-4 py-2 border-r border-neutral-border cursor-pointer hover:bg-neutral-50 transition-colors h-full">
            <svg class="w-4 h-4 text-neutral-text-secondary flex-none" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
            <%# Mobile: show compact count only; desktop: show full label %>
            <div class="hidden sm:block">
              <p class="text-[10px] font-bold uppercase tracking-wider text-neutral-text-secondary leading-none mb-0.5">Guests</p>
              <p class="text-sm font-semibold text-neutral-text-primary whitespace-nowrap" data-hotel-search-bar-target="display">
                <%= adults %> Adults · <%= children %> Children · <%= room_count %> Room<%= room_count > 1 ? "s" : "" %>
              </p>
            </div>
            <%# Mobile compact display %>
            <span class="sm:hidden text-xs font-bold text-neutral-text-primary" data-hotel-search-bar-target="compactDisplay">
              <%= adults + children %>
            </span>
            <svg class="w-3 h-3 text-neutral-text-secondary" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="m6 9 6 6 6-6"/></svg>
          </button>

          <div data-dropdown-target="menu"
               class="hidden absolute top-full left-0 mt-2 z-[201] bg-white rounded-2xl shadow-2xl border border-neutral-border p-4 w-64">
            <%# Adults row %>
            <div class="flex items-center justify-between py-2">
              <div>
                <p class="text-sm font-semibold text-neutral-text-primary">Adults</p>
                <p class="text-xs text-neutral-text-secondary">Age 13+</p>
              </div>
              <div class="flex items-center gap-x-3">
                <button type="button"
                        data-action="click->hotel-search-bar#step"
                        data-hotel-search-bar-field-param="adults"
                        data-hotel-search-bar-delta-param="-1"
                        data-hotel-search-bar-min-param="1"
                        data-hotel-search-bar-max-param="8"
                        class="w-8 h-8 rounded-full border border-neutral-border flex items-center justify-center text-neutral-text-secondary hover:border-brand-primary hover:text-brand-primary transition-colors text-lg font-light">−</button>
                <span data-hotel-search-bar-target="adultsCount" class="w-4 text-center text-sm font-bold text-neutral-text-primary"><%= adults %></span>
                <button type="button"
                        data-action="click->hotel-search-bar#step"
                        data-hotel-search-bar-field-param="adults"
                        data-hotel-search-bar-delta-param="1"
                        data-hotel-search-bar-min-param="1"
                        data-hotel-search-bar-max-param="8"
                        class="w-8 h-8 rounded-full border border-neutral-border flex items-center justify-center text-neutral-text-secondary hover:border-brand-primary hover:text-brand-primary transition-colors text-lg font-light">+</button>
              </div>
            </div>

            <%# Children row %>
            <div class="flex items-center justify-between py-2 border-t border-neutral-border">
              <div>
                <p class="text-sm font-semibold text-neutral-text-primary">Children</p>
                <p class="text-xs text-neutral-text-secondary">Age 0–12</p>
              </div>
              <div class="flex items-center gap-x-3">
                <button type="button"
                        data-action="click->hotel-search-bar#step"
                        data-hotel-search-bar-field-param="children"
                        data-hotel-search-bar-delta-param="-1"
                        data-hotel-search-bar-min-param="0"
                        data-hotel-search-bar-max-param="6"
                        class="w-8 h-8 rounded-full border border-neutral-border flex items-center justify-center text-neutral-text-secondary hover:border-brand-primary hover:text-brand-primary transition-colors text-lg font-light">−</button>
                <span data-hotel-search-bar-target="childrenCount" class="w-4 text-center text-sm font-bold text-neutral-text-primary"><%= children %></span>
                <button type="button"
                        data-action="click->hotel-search-bar#step"
                        data-hotel-search-bar-field-param="children"
                        data-hotel-search-bar-delta-param="1"
                        data-hotel-search-bar-min-param="0"
                        data-hotel-search-bar-max-param="6"
                        class="w-8 h-8 rounded-full border border-neutral-border flex items-center justify-center text-neutral-text-secondary hover:border-brand-primary hover:text-brand-primary transition-colors text-lg font-light">+</button>
              </div>
            </div>

            <%# Rooms row %>
            <div class="flex items-center justify-between py-2 border-t border-neutral-border">
              <div>
                <p class="text-sm font-semibold text-neutral-text-primary">Rooms</p>
              </div>
              <div class="flex items-center gap-x-3">
                <button type="button"
                        data-action="click->hotel-search-bar#step"
                        data-hotel-search-bar-field-param="room-count"
                        data-hotel-search-bar-delta-param="-1"
                        data-hotel-search-bar-min-param="1"
                        data-hotel-search-bar-max-param="5"
                        class="w-8 h-8 rounded-full border border-neutral-border flex items-center justify-center text-neutral-text-secondary hover:border-brand-primary hover:text-brand-primary transition-colors text-lg font-light">−</button>
                <span data-hotel-search-bar-target="roomCountCount" class="w-4 text-center text-sm font-bold text-neutral-text-primary"><%= room_count %></span>
                <button type="button"
                        data-action="click->hotel-search-bar#step"
                        data-hotel-search-bar-field-param="room-count"
                        data-hotel-search-bar-delta-param="1"
                        data-hotel-search-bar-min-param="1"
                        data-hotel-search-bar-max-param="5"
                        class="w-8 h-8 rounded-full border border-neutral-border flex items-center justify-center text-neutral-text-secondary hover:border-brand-primary hover:text-brand-primary transition-colors text-lg font-light">+</button>
              </div>
            </div>
          </div>

          <%= f.hidden_field :adults, value: adults, data: { hotel_search_bar_target: "adultsInput" } %>
          <%= f.hidden_field :children, value: children, data: { hotel_search_bar_target: "childrenInput" } %>
          <%= f.hidden_field :room_count, value: room_count, data: { hotel_search_bar_target: "roomCountInput" } %>
        </div>

        <%# Search button %>
        <%= f.button type: "submit",
              class: "flex-none flex items-center justify-center gap-x-2 h-10 w-10 sm:w-auto sm:px-4 m-1 rounded-full bg-brand-primary text-white hover:bg-brand-primary/90 transition-colors" do %>
          <svg class="w-4 h-4 flex-none" fill="none" stroke="currentColor" viewBox="0 0 24 24"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
          <span class="hidden sm:inline text-sm font-semibold leading-none">Search</span>
        <% end %>
      </div>

      <%# Login / user %>
      <div class="hidden sm:flex flex-none">
        <% if logged_in? %>
          <a href="<%= current_hotel.present? ? hotel_dashboard_path(current_hotel) : admin_dashboard_path %>"
             class="text-sm font-semibold text-brand-primary hover:underline"><%= current_user.name.split.first %></a>
        <% else %>
          <a href="<%= login_path %>"
             class="hidden sm:inline-flex items-center px-4 py-2 rounded-full text-sm font-semibold text-white bg-brand-primary hover:bg-brand-primary/90 transition-colors">Login</a>
        <% end %>
      </div>

    </div>
  <% end %>
</header>
