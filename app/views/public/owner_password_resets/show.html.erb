<main class="mx-auto max-w-md space-y-6 px-5 py-12">
  <h1 class="text-base font-semibold tracking-tight">Set a new password</h1>
  <% if @error.present? %><p role="alert" class="text-sm text-destructive"><%= @error %></p><% end %>
  <%= form_with url: owner_password_reset_path(params[:token]), method: :patch, class: "space-y-4" do |form| %>
    <div class="space-y-2">
      <%= form.label :password, "New password", class: "block text-sm font-medium" %>
      <%= form.password_field :password, required: true, minlength: 12, autocomplete: "new-password", class: "w-full rounded-md border border-border bg-card px-3 py-2" %>
    </div>
    <div class="space-y-2">
      <%= form.label :password_confirmation, "Confirm new password", class: "block text-sm font-medium" %>
      <%= form.password_field :password_confirmation, required: true, minlength: 12, autocomplete: "new-password", class: "w-full rounded-md border border-border bg-card px-3 py-2" %>
    </div>
    <%= render PanelsUI::Button.new(as: :button, type: :submit, variant: :primary) do %>Set password<% end %>
  <% end %>
</main>
