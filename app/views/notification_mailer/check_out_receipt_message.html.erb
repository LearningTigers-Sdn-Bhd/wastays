<!DOCTYPE html>
<html>
  <head>
    <meta content="text/html; charset=UTF-8" http-equiv="Content-Type">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
  </head>
  <body style="margin:0;padding:0;background-color:#f5f4f0;font-family:'Inter',Arial,sans-serif;">
    <table width="100%" cellpadding="0" cellspacing="0" style="background-color:#f5f4f0;padding:40px 0;">
      <tr>
        <td align="center">
          <table width="520" cellpadding="0" cellspacing="0" style="background:#ffffff;border-radius:24px;overflow:hidden;border:1px solid #e8e5df;box-shadow:0 4px 6px -1px rgba(0,0,0,0.05);">

            <!-- Header -->
            <tr>
              <td style="background-color:#0f4a43;padding:40px;text-align:center;">
                <img src="<%= attachments['long-logo.png'].url %>" alt="WAStays" style="height:44px;width:auto;display:inline-block;">
              </td>
            </tr>

            <!-- Body -->
            <tr>
              <td style="padding:48px 40px;">
                <p style="margin:0 0 4px;font-size:12px;font-weight:700;color:#0f4a43;text-transform:uppercase;letter-spacing:0.1em;"><%= @payload[:document_type] == "invoice" ? "Check-Out Invoice" : "Check-Out Complete" %></p>
                <p style="margin:0 0 24px;font-size:26px;font-weight:700;color:#0f172a;letter-spacing:-0.02em;">Thank you, <%= @guest_first_name %>.</p>
                <p style="margin:0 0 32px;font-size:15px;color:#475569;line-height:1.7;">
                  Your stay at <strong style="color:#0f172a;"><%= @payload[:hotel_name] %></strong> has been completed.
                  <% if @payload[:document_type] == "invoice" %>
                    Please find your invoice summary below.
                  <% else %>
                    We hope you had a wonderful stay. Your receipt is available below.
                  <% end %>
                </p>

                <!-- Booking Reference Card -->
                <table width="100%" cellpadding="0" cellspacing="0" style="background:#f8fafc;border-radius:16px;margin-bottom:24px;">
                  <tr>
                    <td style="padding:20px 24px 16px;">
                      <p style="margin:0;font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:0.08em;color:#94a3b8;">Booking Reference</p>
                      <p style="margin:6px 0 0;font-size:20px;font-weight:800;color:#0f172a;font-family:monospace;letter-spacing:0.05em;"><%= @payload[:confirmation_token] %></p>
                    </td>
                  </tr>
                  <tr>
                    <td style="padding:14px 24px 20px;border-top:1px solid #e2e8f0;">
                      <table width="100%" cellpadding="0" cellspacing="0">
                        <tr>
                          <td style="width:50%;vertical-align:top;">
                            <p style="margin:0;font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:0.08em;color:#94a3b8;">Check-in</p>
                            <p style="margin:4px 0 0;font-size:14px;font-weight:600;color:#0f172a;"><%= Date.parse(@payload[:check_in].to_s).strftime("%d %b %Y") rescue @payload[:check_in] %></p>
                          </td>
                          <td style="width:50%;vertical-align:top;">
                            <p style="margin:0;font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:0.08em;color:#94a3b8;">Check-out</p>
                            <p style="margin:4px 0 0;font-size:14px;font-weight:600;color:#0f172a;"><%= Date.parse(@payload[:check_out].to_s).strftime("%d %b %Y") rescue @payload[:check_out] %></p>
                          </td>
                        </tr>
                      </table>
                    </td>
                  </tr>
                </table>

                <!-- Charges -->
                <table width="100%" cellpadding="0" cellspacing="0" style="border:1px solid #e2e8f0;border-radius:16px;overflow:hidden;margin-bottom:24px;">
                  <tr>
                    <td style="padding:12px 20px;background:#f8fafc;border-bottom:1px solid #e2e8f0;">
                      <p style="margin:0;font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:0.08em;color:#64748b;">Charges</p>
                    </td>
                  </tr>

                  <% Array(@payload[:line_items]).each do |item| %>
                    <tr>
                      <td style="padding:14px 20px;border-bottom:1px solid #f1f5f9;">
                        <table width="100%" cellpadding="0" cellspacing="0">
                          <tr>
                            <td style="font-size:14px;color:#0f172a;font-weight:600;">
                              <%= item["description"].presence || item[:description].presence || "Room Charge" %>
                              <% room_number = item["room_number"].presence || item[:room_number].presence %>
                              <% if room_number.present? %>
                                <span style="color:#64748b;font-weight:400;"> · Room <%= room_number %></span>
                              <% end %>
                              <br><span style="font-size:12px;color:#94a3b8;font-weight:400;">Qty: <%= item["quantity"] || item[:quantity] || 1 %></span>
                            </td>
                            <td align="right" style="font-size:14px;color:#0f172a;font-weight:700;vertical-align:top;">
                              <%= @payload[:currency] %> <%= format("%.2f", (item["amount"] || item[:amount] || 0).to_f) %>
                            </td>
                          </tr>
                        </table>
                      </td>
                    </tr>
                  <% end %>

                  <% Array(@payload[:tax_line]).each do |tax_raw| %>
                    <% tax = tax_raw.with_indifferent_access %>
                    <tr>
                      <td style="padding:12px 20px;border-bottom:1px solid #f1f5f9;">
                        <table width="100%" cellpadding="0" cellspacing="0">
                          <tr>
                            <td style="font-size:13px;color:#64748b;"><%= tax[:description].presence || "Tax" %></td>
                            <td align="right" style="font-size:13px;color:#64748b;"><%= @payload[:currency] %> <%= format("%.2f", tax[:amount].to_f) %></td>
                          </tr>
                        </table>
                      </td>
                    </tr>
                  <% end %>

                  <!-- Total -->
                  <tr>
                    <td style="padding:16px 20px;background:#0f4a43;border-radius:0 0 14px 14px;">
                      <table width="100%" cellpadding="0" cellspacing="0">
                        <tr>
                          <td style="font-size:13px;color:#d9c5a0;font-weight:700;text-transform:uppercase;letter-spacing:0.05em;"><%= @payload[:document_type] == "invoice" ? "Amount Due" : "Total Paid" %></td>
                          <td align="right" style="font-size:20px;color:#ffffff;font-weight:800;"><%= @payload[:currency] %> <%= format("%.2f", @payload[:booking_total].to_f) %></td>
                        </tr>
                      </table>
                    </td>
                  </tr>
                </table>

                <% if @payload[:totals_mismatch] %>
                  <table width="100%" cellpadding="0" cellspacing="0" style="background:#fff7ed;border-radius:12px;margin-bottom:22px;border:1px solid #fed7aa;">
                    <tr>
                      <td style="padding:14px 16px;">
                        <p style="margin:0;font-size:13px;color:#9a3412;line-height:1.6;">
                          Note: line-item total differs by <strong><%= @payload[:currency] %> <%= format("%.2f", @payload[:totals_mismatch_amount].to_f) %></strong> from booking total. Please contact us if you have any questions.
                        </p>
                      </td>
                    </tr>
                  </table>
                <% end %>

                <!-- CTA -->
                <% if @payload[:invoice_url].present? %>
                  <table cellpadding="0" cellspacing="0" style="margin:0 auto 32px;width:100%;">
                    <tr>
                      <td style="background-color:#0f4a43;border-radius:14px;text-align:center;">
                        <a href="<%= @payload[:invoice_url] %>" style="color:#ffffff;font-size:15px;font-weight:700;text-decoration:none;display:block;padding:16px 32px;letter-spacing:0.01em;">
                          <%= @payload[:document_type] == "invoice" ? "View Invoice" : "View Receipt" %>
                        </a>
                      </td>
                    </tr>
                  </table>
                <% end %>

                <p style="margin:0;font-size:13px;color:#94a3b8;line-height:1.6;text-align:center;">
                  Questions? Contact us at hello@wastays.com
                </p>
              </td>
            </tr>

            <!-- Footer -->
            <tr>
              <td style="background-color:#faf9f6;padding:24px 40px;text-align:center;border-top:1px solid #f1f5f9;">
                <p style="margin:0;font-size:12px;color:#94a3b8;">&copy; <%= Date.current.year %> WAStays. All rights reserved.</p>
              </td>
            </tr>

          </table>
        </td>
      </tr>
    </table>
  </body>
</html>
