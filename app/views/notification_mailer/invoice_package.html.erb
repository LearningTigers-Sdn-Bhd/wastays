<!DOCTYPE html>
<html>
  <head>
    <meta content="text/html; charset=UTF-8" http-equiv="Content-Type">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
  </head>
  <body style="margin:0;padding:0;background-color:#f5f4f0;font-family:'Inter',Arial,sans-serif;">
    <table width="100%" cellpadding="0" cellspacing="0" style="background-color:#f5f4f0;padding:40px 0;">
      <tr>
        <td align="center">
          <table width="520" cellpadding="0" cellspacing="0" style="background:#ffffff;border-radius:24px;overflow:hidden;border:1px solid #e8e5df;">
            <tr>
              <td style="background-color:#0f4a43;padding:32px;text-align:center;">
                <img src="<%= attachments['long-logo.png'].url %>" alt="WAStays" style="height:40px;width:auto;display:inline-block;">
              </td>
            </tr>
            <tr>
              <td style="padding:40px;">
                <p style="margin:0 0 8px;font-size:13px;color:#64748b;">Combined invoices</p>
                <h1 style="margin:0 0 20px;font-size:24px;color:#0f172a;">Your invoices are attached</h1>
                <p style="margin:0 0 20px;font-size:15px;color:#475569;line-height:1.7;">
                  <%= @payload[:payer_name] %>, your <%= pluralize(@payload[:invoice_count], "finalized invoice") %>
                  from <strong><%= @payload[:hotel_name] %></strong> are included in one PDF.
                </p>
                <p style="margin:0;font-size:13px;color:#64748b;line-height:1.6;">
                  Each invoice keeps its own official invoice number. Please contact the hotel if you need help with these documents.
                </p>
              </td>
            </tr>
          </table>
        </td>
      </tr>
    </table>
  </body>
</html>
