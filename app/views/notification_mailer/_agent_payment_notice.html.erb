<%# The shell every agent payment mail shares. Four near-identical tables would
    be four places to forget the reservation number or the deadline, so the four
    views supply only the eyebrow, the headline, a sentence and an optional
    button, and the stay and money details are rendered once here. %>
<!DOCTYPE html>
<html>
  <head>
    <meta content="text/html; charset=UTF-8" http-equiv="Content-Type">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
  </head>
  <body style="margin:0;padding:0;background-color:#f5f4f0;font-family:'Inter',Arial,sans-serif;">
    <table width="100%" cellpadding="0" cellspacing="0" style="background-color:#f5f4f0;padding:40px 0;">
      <tr>
        <td align="center">
          <table width="520" cellpadding="0" cellspacing="0" style="background:#ffffff;border-radius:24px;overflow:hidden;border:1px solid #e8e5df;box-shadow:0 4px 6px -1px rgba(0,0,0,0.05);">
            <tr>
              <td style="background-color:<%= accent %>;padding:40px;text-align:center;">
                <img src="<%= attachments['long-logo.png'].url %>" alt="WAStays" style="height:44px;width:auto;display:inline-block;">
              </td>
            </tr>

            <tr>
              <td style="padding:48px 40px;">
                <p style="margin:0 0 4px;font-size:12px;font-weight:700;color:<%= accent %>;text-transform:uppercase;letter-spacing:0.1em;"><%= eyebrow %></p>
                <p style="margin:0 0 24px;font-size:26px;font-weight:700;color:#0f172a;letter-spacing:-0.02em;"><%= headline %></p>
                <p style="margin:0 0 32px;font-size:15px;color:#475569;line-height:1.7;"><%= body %></p>

                <table width="100%" cellpadding="0" cellspacing="0" style="background:#f8fafc;border-radius:16px;margin-bottom:32px;">
                  <tr>
                    <td style="padding:24px 24px 16px;">
                      <p style="margin:0;font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:0.08em;color:#94a3b8;">Reservation</p>
                      <p style="margin:6px 0 0;font-size:20px;font-weight:800;color:#0f172a;font-family:monospace;letter-spacing:0.05em;"><%= @payload[:reservation_number] %></p>
                      <p style="margin:6px 0 0;font-size:14px;color:#475569;"><%= @payload[:guest_name] %> · <%= @payload[:hotel_name] %></p>
                    </td>
                  </tr>
                  <tr>
                    <td style="padding:16px 24px;border-top:1px solid #e2e8f0;">
                      <table width="100%" cellpadding="0" cellspacing="0">
                        <tr>
                          <td style="width:50%;vertical-align:top;padding-right:12px;">
                            <p style="margin:0;font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:0.08em;color:#94a3b8;">Arrival</p>
                            <p style="margin:4px 0 0;font-size:14px;font-weight:600;color:#0f172a;"><%= format_payload_date(@payload[:check_in]) %></p>
                          </td>
                          <td style="width:50%;vertical-align:top;">
                            <p style="margin:0;font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:0.08em;color:#94a3b8;">Departure</p>
                            <p style="margin:4px 0 0;font-size:14px;font-weight:600;color:#0f172a;"><%= format_payload_date(@payload[:check_out]) %></p>
                          </td>
                        </tr>
                      </table>
                    </td>
                  </tr>
                  <tr>
                    <td style="padding:16px 24px;border-top:1px solid #e2e8f0;">
                      <p style="margin:0;font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:0.08em;color:#94a3b8;">Amount</p>
                      <p style="margin:4px 0 0;font-size:18px;font-weight:800;color:#0f172a;"><%= @payload[:amount_label] %></p>
                    </td>
                  </tr>
                  <%# Stated with its zone, because the agent is often not in the
                      hotel's and "by 2pm Friday" is otherwise ambiguous. %>
                  <% if @payload[:payment_due_label].present? %>
                    <tr>
                      <td style="padding:16px 24px;border-top:1px solid #e2e8f0;">
                        <p style="margin:0;font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:0.08em;color:#94a3b8;">Pay by</p>
                        <p style="margin:4px 0 0;font-size:16px;font-weight:700;color:#0f172a;"><%= @payload[:payment_due_label] %></p>
                      </td>
                    </tr>
                  <% end %>
                </table>

                <%# The hotel's own words, quoted rather than summarised: a
                    rejection an agent cannot act on is a rejection that costs
                    them the rooms twice. %>
                <% if local_assigns[:note].present? %>
                  <table width="100%" cellpadding="0" cellspacing="0" style="background:#fef3f2;border:1px solid #fecdca;border-radius:16px;margin-bottom:32px;">
                    <tr>
                      <td style="padding:20px 24px;">
                        <p style="margin:0;font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:0.08em;color:#b42318;"><%= local_assigns[:note_label] || "Reason" %></p>
                        <p style="margin:6px 0 0;font-size:15px;color:#0f172a;line-height:1.6;"><%= note %></p>
                      </td>
                    </tr>
                  </table>
                <% end %>

                <% if local_assigns[:cta_label].present? && @payload[:pay_url].present? %>
                  <table width="100%" cellpadding="0" cellspacing="0">
                    <tr>
                      <td align="center">
                        <a href="<%= @payload[:pay_url] %>" style="display:inline-block;background:<%= accent %>;color:#ffffff;text-decoration:none;padding:14px 28px;border-radius:12px;font-size:15px;font-weight:700;"><%= cta_label %></a>
                      </td>
                    </tr>
                  </table>
                <% end %>
              </td>
            </tr>

            <tr>
              <td style="padding:24px 40px 40px;border-top:1px solid #e8e5df;">
                <p style="margin:0;font-size:12px;color:#94a3b8;line-height:1.6;">
                  Sent to <%= @payload[:agency_name] || "your agency" %> via the WAStays corporate portal.
                </p>
              </td>
            </tr>
          </table>
        </td>
      </tr>
    </table>
  </body>
</html>
