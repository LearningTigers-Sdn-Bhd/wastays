<!DOCTYPE html>
<html>
  <head>
    <meta content="text/html; charset=UTF-8" http-equiv="Content-Type">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
  </head>
  <body style="margin:0;padding:0;background-color:#f5f4f0;font-family:'Inter',Arial,sans-serif;">
    <table width="100%" cellpadding="0" cellspacing="0" style="background-color:#f5f4f0;padding:40px 0;">
      <tr>
        <td align="center">
          <table width="520" cellpadding="0" cellspacing="0" style="background:#ffffff;border-radius:24px;overflow:hidden;border:1px solid #e8e5df;box-shadow:0 4px 6px -1px rgba(0,0,0,0.05);">

            <!-- Header -->
            <tr>
              <td style="background-color:#0f4a43;padding:40px;text-align:center;">
                <img src="<%= attachments['long-logo.png'].url %>" alt="WAStays" style="height:44px;width:auto;display:inline-block;">
              </td>
            </tr>

            <!-- Body -->
            <tr>
              <td style="padding:48px 40px;">
                <p style="margin:0 0 4px;font-size:12px;font-weight:700;color:#0f4a43;text-transform:uppercase;letter-spacing:0.1em;">Guest Registration Card</p>
                <p style="margin:0 0 24px;font-size:26px;font-weight:700;color:#0f172a;letter-spacing:-0.02em;">Here is your registration card, <%= @guest_first_name %>.</p>
                <p style="margin:0 0 32px;font-size:15px;color:#475569;line-height:1.7;">
                  Your registration card for <strong style="color:#0f172a;"><%= @payload[:hotel_name] %></strong> is attached to this email.
                </p>

                <!-- Stay Summary Card -->
                <table width="100%" cellpadding="0" cellspacing="0" style="background:#f8fafc;border-radius:16px;margin-bottom:32px;">
                  <tr>
                    <td style="padding:24px 24px 16px;">
                      <p style="margin:0;font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:0.08em;color:#94a3b8;">Registration No.</p>
                      <p style="margin:6px 0 0;font-size:20px;font-weight:800;color:#0f172a;font-family:monospace;letter-spacing:0.05em;"><%= @booking.guest_registration_card_number_display %></p>
                    </td>
                  </tr>
                  <tr>
                    <td style="padding:16px 24px;border-top:1px solid #e2e8f0;">
                      <table width="100%" cellpadding="0" cellspacing="0">
                        <tr>
                          <td style="width:50%;vertical-align:top;padding-right:12px;">
                            <p style="margin:0;font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:0.08em;color:#94a3b8;">Check-in</p>
                            <p style="margin:4px 0 0;font-size:14px;font-weight:600;color:#0f172a;"><%= @booking.check_in.strftime("%d %b %Y") %></p>
                          </td>
                          <td style="width:50%;vertical-align:top;">
                            <p style="margin:0;font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:0.08em;color:#94a3b8;">Check-out</p>
                            <p style="margin:4px 0 0;font-size:14px;font-weight:600;color:#0f172a;"><%= @booking.check_out.strftime("%d %b %Y") %></p>
                          </td>
                        </tr>
                      </table>
                    </td>
                  </tr>
                  <tr>
                    <td style="padding:16px 24px 24px;border-top:1px solid #e2e8f0;">
                      <table width="100%" cellpadding="0" cellspacing="0">
                        <tr>
                          <td style="width:50%;vertical-align:top;padding-right:12px;">
                            <p style="margin:0;font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:0.08em;color:#94a3b8;">Duration</p>
                            <p style="margin:4px 0 0;font-size:14px;font-weight:600;color:#0f172a;"><%= @nights %> <%= @nights == 1 ? "Night" : "Nights" %></p>
                          </td>
                          <td style="width:50%;vertical-align:top;">
                            <p style="margin:0;font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:0.08em;color:#94a3b8;">Booking Reference</p>
                            <p style="margin:4px 0 0;font-size:14px;font-weight:600;color:#0f172a;font-family:monospace;"><%= @booking.confirmation_token %></p>
                          </td>
                        </tr>
                      </table>
                    </td>
                  </tr>
                </table>

                <!-- Signature status -->
                <% if @card&.signed? %>
                  <table width="100%" cellpadding="0" cellspacing="0" style="background:#f0fdf4;border-radius:12px;margin-bottom:32px;border:1px solid #bbf7d0;">
                    <tr>
                      <td style="padding:16px 20px;">
                        <p style="margin:0;font-size:14px;color:#166534;line-height:1.6;">
                          <strong>Signed</strong> — This card was signed by <%= @card.signer_name %>. Keep the attached copy for your records.
                        </p>
                      </td>
                    </tr>
                  </table>
                <% else %>
                  <table width="100%" cellpadding="0" cellspacing="0" style="background:#fffbeb;border-radius:12px;margin-bottom:32px;border:1px solid #fde68a;">
                    <tr>
                      <td style="padding:16px 20px;">
                        <p style="margin:0;font-size:14px;color:#92400e;line-height:1.6;">
                          <strong>Signature needed</strong> — Please review the attached card and sign it on arrival.
                        </p>
                      </td>
                    </tr>
                  </table>
                <% end %>

                <hr style="border:none;border-top:1px solid #f1f5f9;margin:0 0 32px;">

                <p style="margin:0;font-size:13px;color:#94a3b8;line-height:1.6;text-align:center;">
                  Questions? Contact us at hello@wastays.com
                </p>
              </td>
            </tr>

            <!-- Footer -->
            <tr>
              <td style="background-color:#faf9f6;padding:24px 40px;text-align:center;border-top:1px solid #f1f5f9;">
                <p style="margin:0;font-size:12px;color:#94a3b8;">&copy; <%= Date.current.year %> WAStays. All rights reserved.</p>
              </td>
            </tr>

          </table>
        </td>
      </tr>
    </table>
  </body>
</html>
