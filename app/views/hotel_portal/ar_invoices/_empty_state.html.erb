<div class="flex flex-col items-center justify-center px-4 py-10 text-center">
  <div class="mb-3 rounded-full bg-slate-50 p-3 text-slate-400">
    <%= cached_icon "file-search", stroke_width: 2, class: "size-6" %>
  </div>
  <h3 class="text-sm font-bold text-slate-900">No AR invoices found</h3>
  <p class="mt-1 max-w-[300px] text-xs text-slate-500">Try adjusting the search, corporate account, due date, or status filters.</p>
  <% if presenter.filters_active? %>
    <%= link_to hotel_ar_invoices_path(current_hotel), class: "mt-4 inline-flex items-center gap-1.5 rounded-lg border border-slate-200 bg-white px-3 py-1.5 text-xs font-bold text-slate-700 shadow-sm transition hover:bg-slate-50 active:scale-95", data: { turbo_frame: "_top" } do %>
      <%= cached_icon "rotate-ccw", stroke_width: 2.5, class: "size-3" %>
      Reset Filters
    <% end %>
  <% end %>
</div>
