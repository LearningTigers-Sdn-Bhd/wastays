<div class="mx-auto max-w-[1600px] space-y-4 pb-10">
  <div class="flex justify-end px-4 md:px-0">
    <%= link_to hotel_ar_agent_summary_path(current_hotel, format: :pdf),
                target: "_blank", rel: "noopener",
                class: "inline-flex items-center justify-center gap-2 rounded-xl bg-slate-900 px-4 py-2.5 text-sm font-bold text-white shadow-sm transition hover:bg-slate-700 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-slate-900/20" do %>
      <%= cached_icon "printer", class: "size-4", aria: { hidden: true } %>
      Print Summary
    <% end %>
  </div>

  <%= render "hotel_portal/ar_invoices/aging/metrics", presenter: @presenter %>
  <%= render "hotel_portal/ar_invoices/aging/table", presenter: @presenter %>
</div>
