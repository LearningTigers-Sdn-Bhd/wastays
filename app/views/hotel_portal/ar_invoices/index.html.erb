<div class="mx-auto max-w-7xl space-y-6 pb-20">
  <div class="flex flex-col gap-2 sm:flex-row sm:items-end sm:justify-between">
    <div>
      <h1 class="text-3xl font-bold tracking-tight text-slate-950">AR Invoices</h1>
      <p class="mt-1 text-sm text-slate-600">Track Direct Bill invoices, due dates, and outstanding balances.</p>
    </div>
    <%= link_to "Record Payment", new_hotel_ar_payment_path(current_hotel), class: "inline-flex items-center justify-center rounded-xl bg-slate-900 px-5 py-2.5 text-sm font-bold text-white shadow-sm transition hover:bg-slate-700" %>
  </div>

  <section class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">
    <div class="border-b border-slate-200 px-6 py-5">
      <h2 class="text-lg font-bold text-slate-950">Accounts Receivable Ledger</h2>
    </div>
    <% if @ar_invoices.any? %>
      <div class="overflow-x-auto">
        <table class="w-full min-w-[1100px] text-left text-sm">
          <thead class="border-b border-slate-200 bg-slate-50 text-xs uppercase tracking-wider text-slate-500">
            <tr>
              <th class="px-6 py-3">Invoice</th>
              <th class="px-6 py-3">Corporate Account</th>
              <th class="px-6 py-3">Source</th>
              <th class="px-6 py-3">Issued</th>
              <th class="px-6 py-3">Due</th>
              <th class="px-6 py-3 text-right">Amount</th>
              <th class="px-6 py-3 text-right">Paid</th>
              <th class="px-6 py-3 text-right">Outstanding</th>
              <th class="px-6 py-3">Status</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-100">
            <% @ar_invoices.each do |invoice| %>
              <tr>
                <td class="px-6 py-4 font-bold text-slate-950"><%= link_to "AR-#{invoice.invoice_number}", hotel_ar_invoice_path(current_hotel, invoice), class: "underline decoration-slate-300 underline-offset-2 hover:text-slate-600" %></td>
                <td class="px-6 py-4 text-slate-700"><%= invoice.corporate_account.name %></td>
                <td class="px-6 py-4 text-slate-600">
                  <div class="font-semibold text-slate-900"><%= invoice.booking.confirmation_token %></div>
                  <div class="text-xs"><%= invoice.booking_folio.folio_reference_display %></div>
                </td>
                <td class="px-6 py-4 text-slate-600"><%= invoice.issued_on.strftime("%d %b %Y") %></td>
                <td class="px-6 py-4 text-slate-600"><%= invoice.due_on.strftime("%d %b %Y") %></td>
                <td class="px-6 py-4 text-right font-semibold tabular-nums text-slate-900"><%= invoice.currency %> <%= number_with_precision(invoice.amount, precision: 2) %></td>
                <td class="px-6 py-4 text-right tabular-nums text-slate-600"><%= invoice.currency %> <%= number_with_precision(invoice.paid_amount, precision: 2) %></td>
                <td class="px-6 py-4 text-right font-bold tabular-nums text-slate-950"><%= invoice.currency %> <%= number_with_precision(invoice.outstanding_amount, precision: 2) %></td>
                <td class="px-6 py-4"><span class="rounded-md bg-slate-100 px-2 py-1 text-xs font-bold uppercase tracking-wide text-slate-700"><%= invoice.status.humanize %></span></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% else %>
      <p class="px-6 py-10 text-center text-sm text-slate-500">No AR invoices have been created yet.</p>
    <% end %>
  </section>
</div>
