<section class="overflow-hidden rounded-xl border border-slate-200 bg-white shadow-sm" data-testid="technical-snapshots-card">
  <header class="border-b border-slate-200 bg-slate-50/60 px-4 py-2.5">
    <h2 class="inline-flex items-center gap-2 text-xs font-bold uppercase tracking-wider text-slate-700">
      <span class="inline-flex size-6 items-center justify-center rounded bg-violet-50 text-violet-700">
        <%= cached_icon "database", class: "size-3.5", aria: { hidden: true } %>
      </span>
      Technical Snapshots
    </h2>
  </header>

  <% if presenter.technical_snapshot_rows.any? %>
    <dl class="divide-y divide-slate-200">
      <% presenter.technical_snapshot_rows.each do |row| %>
        <div class="grid grid-cols-2 bg-white">
          <dt class="border-r border-slate-200 px-4 py-3 text-[10px] font-bold uppercase tracking-wider text-slate-500"><%= row.label %></dt>
          <dd class="min-w-0 break-words px-4 py-3 text-sm font-semibold text-slate-900"><%= row.value %></dd>
        </div>
      <% end %>
    </dl>
  <% else %>
    <div class="px-6 py-12 text-center">
      <span class="mx-auto inline-flex size-10 items-center justify-center rounded-full bg-slate-100 text-slate-500">
        <%= cached_icon "database", class: "size-5", aria: { hidden: true } %>
      </span>
      <p class="mt-3 text-sm font-semibold text-slate-700">No technical snapshot recorded</p>
      <p class="mt-1 text-xs text-slate-500">This invoice does not contain captured source metadata.</p>
    </div>
  <% end %>
</section>
