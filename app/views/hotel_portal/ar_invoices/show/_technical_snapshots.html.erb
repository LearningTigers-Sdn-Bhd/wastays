<section class="overflow-hidden rounded-xl border border-border bg-card shadow-sm" data-testid="technical-snapshots-card">
  <header class="border-b border-border bg-muted/60 px-4 py-2.5">
    <h2 class="inline-flex items-center gap-2 text-xs font-bold uppercase tracking-wider text-foreground">
      <span class="inline-flex size-6 items-center justify-center rounded bg-violet-50 text-violet-700">
        <%= cached_icon "database", class: "size-3.5", aria: { hidden: true } %>
      </span>
      Technical Snapshots
    </h2>
  </header>

  <% if presenter.technical_snapshot_rows.any? %>
    <dl class="divide-y divide-border">
      <% presenter.technical_snapshot_rows.each do |row| %>
        <div class="grid grid-cols-2 bg-card">
          <dt class="border-r border-border px-4 py-3 text-[10px] font-bold uppercase tracking-wider text-muted-foreground"><%= row.label %></dt>
          <dd class="min-w-0 break-words px-4 py-3 text-sm font-semibold text-foreground"><%= row.value %></dd>
        </div>
      <% end %>
    </dl>
  <% else %>
    <div class="px-6 py-12 text-center">
      <span class="mx-auto inline-flex size-10 items-center justify-center rounded-full bg-muted text-muted-foreground">
        <%= cached_icon "database", class: "size-5", aria: { hidden: true } %>
      </span>
      <p class="mt-3 text-sm font-semibold text-foreground">No technical snapshot recorded</p>
      <p class="mt-1 text-xs text-muted-foreground">This invoice does not contain captured source metadata.</p>
    </div>
  <% end %>
</section>
