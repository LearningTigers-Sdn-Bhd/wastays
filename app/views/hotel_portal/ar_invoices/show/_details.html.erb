<div class="grid grid-cols-1 items-start gap-4 lg:grid-cols-3">
  <section class="overflow-hidden rounded-xl border border-border bg-card shadow-sm" data-testid="invoice-summary-card">
    <header class="border-b border-border bg-muted/60 px-4 py-2.5">
      <h2 class="inline-flex items-center gap-2 text-xs font-bold uppercase tracking-wider text-foreground">
        <span class="inline-flex size-6 items-center justify-center rounded bg-emerald-50 text-emerald-700">
          <%= cached_icon "receipt-text", class: "size-3.5", aria: { hidden: true } %>
        </span>
        Invoice Summary
      </h2>
    </header>

    <div class="grid grid-cols-1 gap-px bg-muted">
      <div class="bg-card px-4 py-2.5">
        <p class="text-[10px] font-bold uppercase tracking-wider text-muted-foreground">Status</p>
        <span class="mt-1 inline-flex rounded-md border px-2 py-0.5 text-[10px] font-bold uppercase tracking-wider <%= presenter.status_class %>"><%= presenter.status_label %></span>
      </div>
      <div class="bg-card px-4 py-2.5">
        <p class="text-[10px] font-bold uppercase tracking-wider text-muted-foreground">Original Amount</p>
        <p class="mt-0.5 text-sm font-semibold tabular-nums text-foreground"><%= presenter.original_amount_label %></p>
      </div>
      <div class="bg-card px-4 py-2.5">
        <p class="text-[10px] font-bold uppercase tracking-wider text-muted-foreground">Paid Amount</p>
        <p class="mt-0.5 text-sm font-semibold tabular-nums text-emerald-700"><%= presenter.paid_amount_label %></p>
      </div>
      <div class="bg-card px-4 py-2.5">
        <p class="text-[10px] font-bold uppercase tracking-wider text-muted-foreground">Outstanding</p>
        <p class="mt-0.5 text-sm font-bold tabular-nums text-amber-700"><%= presenter.outstanding_amount_label %></p>
      </div>
    </div>
  </section>

  <section class="overflow-hidden rounded-xl border border-border bg-card shadow-sm lg:col-span-2" data-testid="invoice-details-card">
    <header class="border-b border-border bg-muted/60 px-4 py-2.5">
      <h2 class="inline-flex items-center gap-2 text-xs font-bold uppercase tracking-wider text-foreground">
        <span class="inline-flex size-6 items-center justify-center rounded bg-blue-50 text-blue-700">
          <%= cached_icon "file-text", class: "size-3.5", aria: { hidden: true } %>
        </span>
        Invoice Details
      </h2>
    </header>

    <div class="grid grid-cols-1 gap-px bg-muted sm:grid-cols-2">
      <div class="bg-card px-4 py-2.5">
        <p class="text-[10px] font-bold uppercase tracking-wider text-muted-foreground">Corporate Account</p>
        <%= link_to(hotel_corporate_accounts_path(current_hotel),
                    title: presenter.company_name,
                    class: "mt-0.5 inline-flex max-w-full items-center gap-1 text-sm font-semibold text-foreground underline decoration-muted-foreground underline-offset-2 transition hover:text-blue-700 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-600 focus-visible:ring-offset-2") do %>
          <span class="truncate"><%= presenter.company_name %></span>
          <%= cached_icon "arrow-up-right", class: "size-3.5 shrink-0", aria: { hidden: true } %>
        <% end %>
      </div>
      <div class="bg-card px-4 py-2.5">
        <p class="text-[10px] font-bold uppercase tracking-wider text-muted-foreground">Source Booking</p>
        <%= link_to(hotel_booking_control_panel_path(current_hotel, ar_invoice.booking, tab: "booking_details"),
                    class: "mt-0.5 inline-flex items-center gap-1 text-sm font-semibold text-foreground underline decoration-muted-foreground underline-offset-2 transition hover:text-blue-700 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-600 focus-visible:ring-offset-2") do %>
          <%= presenter.booking_reference %>
          <%= cached_icon "arrow-up-right", class: "size-3.5", aria: { hidden: true } %>
        <% end %>
      </div>
      <div class="bg-card px-4 py-2.5">
        <p class="text-[10px] font-bold uppercase tracking-wider text-muted-foreground">Source Folio</p>
        <%= link_to(hotel_booking_control_panel_path(current_hotel, ar_invoice.booking, tab: "folio_operations", folio_id: ar_invoice.booking_folio_id),
                    class: "mt-0.5 inline-flex items-center gap-1 text-sm font-semibold text-foreground underline decoration-muted-foreground underline-offset-2 transition hover:text-blue-700 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-600 focus-visible:ring-offset-2") do %>
          <%= presenter.folio_reference %>
          <%= cached_icon "arrow-up-right", class: "size-3.5", aria: { hidden: true } %>
        <% end %>
      </div>
      <div class="bg-card px-4 py-2.5">
        <p class="text-[10px] font-bold uppercase tracking-wider text-muted-foreground">Payment Terms</p>
        <p class="mt-0.5 text-sm font-semibold text-foreground"><%= presenter.payment_terms_label %></p>
      </div>
      <div class="bg-card px-4 py-2.5">
        <p class="text-[10px] font-bold uppercase tracking-wider text-muted-foreground">Issued On</p>
        <p class="mt-0.5 text-sm font-semibold text-foreground"><%= presenter.issued_on_label %></p>
      </div>
      <div class="bg-card px-4 py-2.5">
        <p class="text-[10px] font-bold uppercase tracking-wider text-muted-foreground">Due On</p>
        <p class="mt-0.5 text-sm font-semibold text-foreground"><%= presenter.due_on_label %></p>
      </div>
      <div class="bg-card px-4 py-2.5">
        <p class="text-[10px] font-bold uppercase tracking-wider text-muted-foreground">Direct Bill Source</p>
        <p class="mt-0.5 text-sm font-semibold text-foreground"><%= presenter.direct_bill_source_label %></p>
      </div>
      <div class="bg-card px-4 py-2.5">
        <p class="text-[10px] font-bold uppercase tracking-wider text-muted-foreground">Created At</p>
        <p class="mt-0.5 text-sm font-semibold text-foreground"><%= presenter.created_at_label %></p>
      </div>
    </div>
  </section>
</div>
