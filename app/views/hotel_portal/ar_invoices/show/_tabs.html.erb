<div class="mt-8 mb-3 rounded-xl border border-border bg-card p-1.5">
  <nav class="flex items-center gap-1 overflow-x-auto" aria-label="Invoice tabs" role="tablist">
    <button type="button"
            data-tabs-target="tab"
            data-tab-name="payment-allocations"
            data-tab-label="Payment Allocations"
            data-action="click->tabs#switch"
            class="group inline-flex h-9 items-center gap-2 whitespace-nowrap rounded-lg px-4 text-sm font-medium text-muted-foreground transition-all duration-150 hover:bg-muted hover:text-foreground data-[active=true]:bg-blue-600 data-[active=true]:font-semibold data-[active=true]:text-primary-foreground"
            aria-controls="payment-allocations-panel"
            role="tab">
      <%= cached_icon "credit-card", class: "size-4", aria: { hidden: true } %>
      <span>Payment Allocations</span>
      <span class="rounded-full bg-muted px-1.5 py-0.5 text-[10px] font-bold text-muted-foreground transition-colors duration-150 group-data-[active=true]:bg-card/20 group-data-[active=true]:text-primary-foreground">
        <%= presenter.allocation_rows.size %>
      </span>
    </button>

    <button type="button"
            data-tabs-target="tab"
            data-tab-name="technical-snapshots"
            data-tab-label="Technical Snapshots"
            data-action="click->tabs#switch"
            class="group inline-flex h-9 items-center gap-2 whitespace-nowrap rounded-lg px-4 text-sm font-medium text-muted-foreground transition-all duration-150 hover:bg-muted hover:text-foreground data-[active=true]:bg-blue-600 data-[active=true]:font-semibold data-[active=true]:text-primary-foreground"
            aria-controls="technical-snapshots-panel"
            role="tab">
      <%= cached_icon "database", class: "size-4", aria: { hidden: true } %>
      <span>Technical Snapshots</span>
    </button>
  </nav>
</div>
