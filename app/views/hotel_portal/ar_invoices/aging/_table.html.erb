<% if presenter.rows.any? %>
  <div class="hidden overflow-x-auto rounded-xl border border-slate-200 bg-white shadow-sm lg:block">
    <table class="min-w-[1450px] divide-y divide-slate-200">
      <thead class="bg-slate-50/50">
        <tr>
          <th scope="col" class="w-72 whitespace-nowrap px-6 py-3 text-left text-[10px] font-bold uppercase tracking-widest text-slate-500">Corporate Account</th>
          <th scope="col" class="w-36 whitespace-nowrap px-6 py-3 text-left text-[10px] font-bold uppercase tracking-widest text-slate-500">Currency</th>
          <th scope="col" class="w-44 whitespace-nowrap px-6 py-3 text-right text-[10px] font-bold uppercase tracking-widest text-slate-500">Credit Limit</th>
          <th scope="col" class="w-36 whitespace-nowrap px-6 py-3 text-right text-[10px] font-bold uppercase tracking-widest text-emerald-700">Current</th>
          <th scope="col" class="w-36 whitespace-nowrap px-6 py-3 text-right text-[10px] font-bold uppercase tracking-widest text-amber-700">1–30</th>
          <th scope="col" class="w-36 whitespace-nowrap px-6 py-3 text-right text-[10px] font-bold uppercase tracking-widest text-orange-700">31–60</th>
          <th scope="col" class="w-36 whitespace-nowrap px-6 py-3 text-right text-[10px] font-bold uppercase tracking-widest text-red-700">61–90</th>
          <th scope="col" class="w-36 whitespace-nowrap px-6 py-3 text-right text-[10px] font-bold uppercase tracking-widest text-rose-700">90+</th>
          <th scope="col" class="w-48 whitespace-nowrap px-6 py-3 text-right text-[10px] font-bold uppercase tracking-widest text-slate-500">Total</th>
          <th scope="col" class="w-60 whitespace-nowrap px-6 py-3 text-left text-[10px] font-bold uppercase tracking-widest text-slate-500">Credit Status</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-slate-100 bg-white">
        <% presenter.rows.each do |row| %>
          <% invoices_url = hotel_ar_invoices_path(current_hotel, hotel_corporate_account_id: row.hotel_corporate_account.id, balance: "outstanding") %>
          <tr
            class="group cursor-pointer transition-colors hover:bg-slate-50/80 focus-visible:bg-slate-50 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-inset focus-visible:ring-slate-900/20"
            role="link"
            tabindex="0"
            data-controller="clickable-row"
            data-testid="aging-row-<%= row.hotel_corporate_account.id %>-<%= row.currency %>"
            data-clickable-row-url-value="<%= invoices_url %>"
            data-action="click->clickable-row#visit keydown->clickable-row#visitFromKeyboard">
            <td class="whitespace-nowrap px-6 py-3 text-sm font-bold text-slate-900 decoration-slate-400 underline-offset-4 group-hover:underline group-focus-visible:underline"><%= row.corporate_account_name %></td>
            <td class="whitespace-nowrap px-6 py-3 text-xs font-black uppercase tracking-wider text-slate-600"><%= row.currency %></td>
            <td class="whitespace-nowrap px-6 py-3 text-right text-sm font-semibold tabular-nums text-slate-700"><%= row.credit_limit_label %></td>
            <td class="whitespace-nowrap px-6 py-3 text-right text-sm font-semibold tabular-nums text-slate-700"><%= row.current_label %></td>
            <td class="whitespace-nowrap px-6 py-3 text-right text-sm font-semibold tabular-nums text-slate-700"><%= row.days_1_30_label %></td>
            <td class="whitespace-nowrap px-6 py-3 text-right text-sm font-semibold tabular-nums text-slate-700"><%= row.days_31_60_label %></td>
            <td class="whitespace-nowrap px-6 py-3 text-right text-sm font-semibold tabular-nums text-slate-700"><%= row.days_61_90_label %></td>
            <td class="whitespace-nowrap px-6 py-3 text-right text-sm font-semibold tabular-nums text-slate-700"><%= row.days_over_90_label %></td>
            <td class="whitespace-nowrap px-6 py-3 text-right text-sm font-black tabular-nums text-slate-950"><%= row.total_outstanding_label %></td>
            <td class="px-6 py-3">
              <span class="inline-flex items-center rounded-md border px-1.5 py-0.5 text-[10px] font-black uppercase tracking-wider <%= row.credit_status_class %>"><%= row.credit_status_label %></span>
              <p class="mt-1 max-w-56 text-[11px] font-medium leading-4 text-slate-500"><%= row.credit_status_description %></p>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>

  <div class="space-y-3 px-4 md:px-0 lg:hidden">
    <% presenter.rows.each do |row| %>
      <% invoices_url = hotel_ar_invoices_path(current_hotel, hotel_corporate_account_id: row.hotel_corporate_account.id, balance: "outstanding") %>
      <article
        class="group cursor-pointer rounded-xl border border-slate-200 bg-white p-4 shadow-sm transition hover:border-slate-300 hover:bg-slate-50/60 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-slate-900/20"
        role="link"
        tabindex="0"
        data-controller="clickable-row"
        data-testid="aging-card-<%= row.hotel_corporate_account.id %>-<%= row.currency %>"
        data-clickable-row-url-value="<%= invoices_url %>"
        data-action="click->clickable-row#visit keydown->clickable-row#visitFromKeyboard">
        <div class="flex items-start justify-between gap-3">
          <div class="min-w-0">
            <p class="truncate text-sm font-black text-slate-900 decoration-slate-400 underline-offset-4 group-hover:underline group-focus-visible:underline"><%= row.corporate_account_name %></p>
            <p class="mt-1 text-[10px] font-bold uppercase tracking-widest text-slate-400"><%= row.currency %> balances</p>
          </div>
          <span class="inline-flex shrink-0 items-center rounded-md border px-1.5 py-0.5 text-[10px] font-black uppercase tracking-wider <%= row.credit_status_class %>"><%= row.credit_status_label %></span>
        </div>

        <div class="mt-4 grid grid-cols-3 gap-3 border-y border-slate-100 py-4">
          <div>
            <p class="text-[10px] font-bold uppercase tracking-widest text-emerald-700">Current</p>
            <p class="mt-1 text-xs font-bold tabular-nums text-slate-900"><%= row.current_label %></p>
          </div>
          <div class="text-center">
            <p class="text-[10px] font-bold uppercase tracking-widest text-amber-700">1–30</p>
            <p class="mt-1 text-xs font-bold tabular-nums text-slate-900"><%= row.days_1_30_label %></p>
          </div>
          <div class="text-right">
            <p class="text-[10px] font-bold uppercase tracking-widest text-orange-700">31–60</p>
            <p class="mt-1 text-xs font-bold tabular-nums text-slate-900"><%= row.days_31_60_label %></p>
          </div>
          <div>
            <p class="text-[10px] font-bold uppercase tracking-widest text-red-700">61–90</p>
            <p class="mt-1 text-xs font-bold tabular-nums text-slate-900"><%= row.days_61_90_label %></p>
          </div>
          <div class="text-center">
            <p class="text-[10px] font-bold uppercase tracking-widest text-rose-700">90+</p>
            <p class="mt-1 text-xs font-bold tabular-nums text-slate-900"><%= row.days_over_90_label %></p>
          </div>
          <div class="text-right">
            <p class="text-[10px] font-bold uppercase tracking-widest text-slate-500">Total</p>
            <p class="mt-1 text-xs font-black tabular-nums text-slate-950"><%= row.total_outstanding_label %></p>
          </div>
        </div>

        <div class="mt-4 flex items-start justify-between gap-4">
          <div>
            <p class="text-[10px] font-bold uppercase tracking-widest text-slate-400">Credit limit</p>
            <p class="mt-1 text-xs font-bold tabular-nums text-slate-700"><%= row.credit_limit_label %></p>
          </div>
          <p class="max-w-[55%] text-right text-[11px] font-medium leading-4 text-slate-500"><%= row.credit_status_description %></p>
        </div>
      </article>
    <% end %>
  </div>
<% else %>
  <div class="mx-4 rounded-xl border border-dashed border-slate-200 bg-white shadow-sm md:mx-0">
    <%= render "hotel_portal/ar_invoices/aging/empty_state" %>
  </div>
<% end %>
