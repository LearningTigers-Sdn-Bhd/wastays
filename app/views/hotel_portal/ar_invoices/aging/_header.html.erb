<div>
  <%= render PanelsUI::PageHeader.new(title: "Aging Report") do |header| %>
    <% header.with_caption do %>
      Outstanding corporate balances as of <%= presenter.as_of_date.strftime("%d %b %Y") %>.
    <% end %>
    <% header.with_actions do %>
      <%= render PanelsUI::Button.new(as: :a, href: hotel_ar_invoices_path(current_hotel, balance: "outstanding"), variant: :secondary, size: :md, class: "w-full lg:w-auto") do %>
        <%= cached_icon "list-filter", class: "size-4", aria: { hidden: true } %>
        View Outstanding Invoices
      <% end %>
    <% end %>
  <% end %>
</div>
