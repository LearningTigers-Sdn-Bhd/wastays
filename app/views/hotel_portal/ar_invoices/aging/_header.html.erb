<header class="flex flex-col gap-4 px-4 pt-5 md:px-0 lg:flex-row lg:items-end lg:justify-between">
  <div>
    <h1 class="text-2xl font-bold tracking-tight text-foreground sm:text-3xl">Aging Report</h1>
    <p class="mt-1 text-sm font-medium text-muted-foreground">
      Outstanding corporate balances as of <%= presenter.as_of_date.strftime("%d %b %Y") %>.
    </p>
  </div>

  <%= link_to hotel_ar_invoices_path(current_hotel, balance: "outstanding"),
              class: "inline-flex items-center justify-center gap-2 rounded-xl border border-border bg-card px-4 py-2.5 text-sm font-bold text-foreground shadow-sm transition hover:border-border-interactive hover:bg-muted focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring/20" do %>
    <%= cached_icon "list-filter", class: "size-4", aria: { hidden: true } %>
    View Outstanding Invoices
  <% end %>
</header>
