<%= form_with url: hotel_ar_aging_path(current_hotel), method: :get, class: "space-y-2 px-4 md:px-0", data: { controller: "auto-submit", turbo_frame: "aging_results", turbo_action: "advance" } do |form| %>
  <div class="relative">
    <div class="pointer-events-none absolute inset-y-0 left-0 flex items-center pl-3">
      <%= cached_icon "search", stroke_width: 2, class: "size-4 text-muted-foreground" %>
    </div>
    <%= form.text_field :query,
      value: presenter.query,
      placeholder: "Search corporate account...",
      class: "block w-full rounded-lg border border-border bg-card py-2 pl-10 pr-3 text-sm shadow-sm transition-all placeholder:text-muted-foreground focus:border-border-interactive focus:outline-none focus:ring-1 focus:ring-ring/10",
      data: { action: "input->auto-submit#submit" } %>
  </div>

  <div class="flex items-center justify-between gap-3">
    <div class="-mx-0.5 flex min-w-0 flex-1 items-center gap-2 overflow-x-auto px-0.5 py-2 no-scrollbar">
      <div class="shrink-0">
        <input type="radio" name="account_type" value="" id="aging_account_type_all" class="peer sr-only" <%= "checked" if presenter.account_type.blank? %> data-action="change->auto-submit#submitNow">
        <label for="aging_account_type_all" class="inline-flex cursor-pointer rounded-full border border-border bg-card px-4 py-1.5 text-xs font-bold uppercase tracking-wider text-muted-foreground shadow-sm transition hover:bg-muted hover:text-foreground peer-checked:border-border-interactive peer-checked:bg-primary peer-checked:text-primary-foreground">All</label>
      </div>
      <% presenter.account_type_options.each do |label, value| %>
        <div class="shrink-0">
          <input type="radio" name="account_type" value="<%= value %>" id="aging_account_type_<%= value %>" class="peer sr-only" <%= "checked" if presenter.account_type == value %> data-action="change->auto-submit#submitNow">
          <label for="aging_account_type_<%= value %>" class="inline-flex cursor-pointer rounded-full border border-border bg-card px-4 py-1.5 text-xs font-bold uppercase tracking-wider text-muted-foreground shadow-sm transition hover:bg-muted hover:text-foreground peer-checked:border-border-interactive peer-checked:bg-primary peer-checked:text-primary-foreground"><%= label %></label>
        </div>
      <% end %>
    </div>

    <%= render PanelsUI::Button.new(
          as: :a,
          href: hotel_ar_aging_summary_pdf_path(
            current_hotel,
            "aging-summary-statement-#{current_hotel.slug}-#{presenter.as_of_date}.pdf",
            query: presenter.query,
            account_type: presenter.account_type
          ),
          variant: :primary,
          size: :md,
          class: "shrink-0",
          target: "_blank",
          rel: "noopener") do %>
      <%= cached_icon "printer", class: "size-4", aria: { hidden: true } %>
      Print Summary
    <% end %>
  </div>
<% end %>
