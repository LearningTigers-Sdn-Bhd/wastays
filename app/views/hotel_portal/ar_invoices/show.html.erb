<div class="mx-auto max-w-5xl space-y-6 pb-20">
  <div class="flex flex-col gap-4 sm:flex-row sm:items-start sm:justify-between">
    <div>
      <p class="text-xs font-bold uppercase tracking-[0.2em] text-slate-400">AR Invoice</p>
      <h1 class="mt-1 text-3xl font-bold tracking-tight text-slate-950">AR-<%= @ar_invoice.invoice_number %></h1>
      <p class="mt-1 text-sm text-slate-600"><%= @ar_invoice.corporate_account.name %></p>
    </div>
    <div class="flex gap-2">
      <%= link_to "Record Payment", new_hotel_ar_payment_path(current_hotel, ar_invoice_id: @ar_invoice.id, hotel_corporate_account_id: @ar_invoice.hotel_corporate_account_id), class: "rounded-xl bg-slate-900 px-4 py-2 text-sm font-bold text-white shadow-sm transition hover:bg-slate-700" %>
      <%= link_to "Back to AR Invoices", hotel_ar_invoices_path(current_hotel), class: "rounded-xl border border-slate-200 bg-white px-4 py-2 text-sm font-bold text-slate-700 shadow-sm transition hover:bg-slate-50" %>
    </div>
  </div>

  <section class="grid gap-4 sm:grid-cols-3">
    <div class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
      <p class="text-xs font-bold uppercase tracking-wider text-slate-500">Original Amount</p>
      <p class="mt-2 text-2xl font-black text-slate-950"><%= @ar_invoice.currency %> <%= number_with_precision(@ar_invoice.amount, precision: 2) %></p>
    </div>
    <div class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
      <p class="text-xs font-bold uppercase tracking-wider text-slate-500">Paid Amount</p>
      <p class="mt-2 text-2xl font-black text-slate-950"><%= @ar_invoice.currency %> <%= number_with_precision(@ar_invoice.paid_amount, precision: 2) %></p>
    </div>
    <div class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
      <p class="text-xs font-bold uppercase tracking-wider text-slate-500">Outstanding</p>
      <p class="mt-2 text-2xl font-black text-slate-950"><%= @ar_invoice.currency %> <%= number_with_precision(@ar_invoice.outstanding_amount, precision: 2) %></p>
    </div>
  </section>

  <section class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">
    <div class="border-b border-slate-200 px-6 py-5">
      <h2 class="text-lg font-bold text-slate-950">Invoice Details</h2>
    </div>
    <dl class="grid divide-y divide-slate-100 text-sm sm:grid-cols-2 sm:divide-x sm:divide-y-0">
      <div class="space-y-4 p-6">
        <div>
          <dt class="text-xs font-bold uppercase tracking-wider text-slate-500">Status</dt>
          <dd class="mt-1 font-semibold text-slate-950"><%= @ar_invoice.status.humanize %></dd>
        </div>
        <div>
          <dt class="text-xs font-bold uppercase tracking-wider text-slate-500">Issued On</dt>
          <dd class="mt-1 font-semibold text-slate-950"><%= @ar_invoice.issued_on.strftime("%d %b %Y") %></dd>
        </div>
        <div>
          <dt class="text-xs font-bold uppercase tracking-wider text-slate-500">Due On</dt>
          <dd class="mt-1 font-semibold text-slate-950"><%= @ar_invoice.due_on.strftime("%d %b %Y") %></dd>
        </div>
      </div>
      <div class="space-y-4 p-6">
        <div>
          <dt class="text-xs font-bold uppercase tracking-wider text-slate-500">Source Booking</dt>
          <dd class="mt-1 font-semibold text-slate-950"><%= link_to @ar_invoice.booking.confirmation_token, hotel_booking_path(current_hotel, @ar_invoice.booking), class: "underline decoration-slate-300 underline-offset-2 hover:text-slate-600" %></dd>
        </div>
        <div>
          <dt class="text-xs font-bold uppercase tracking-wider text-slate-500">Source Folio</dt>
          <dd class="mt-1 font-semibold text-slate-950"><%= link_to @ar_invoice.booking_folio.folio_reference_display, hotel_folio_path(current_hotel, @ar_invoice.booking, active_folio_id: @ar_invoice.booking_folio_id), class: "underline decoration-slate-300 underline-offset-2 hover:text-slate-600" %></dd>
        </div>
        <div>
          <dt class="text-xs font-bold uppercase tracking-wider text-slate-500">Corporate Account</dt>
          <dd class="mt-1 font-semibold text-slate-950"><%= @ar_invoice.corporate_account.name %></dd>
        </div>
      </div>
    </dl>
  </section>

  <section class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">
    <div class="border-b border-slate-200 px-6 py-5">
      <h2 class="text-lg font-bold text-slate-950">Payment Allocations</h2>
    </div>
    <% if @ar_invoice.ar_payment_allocations.any? %>
      <div class="overflow-x-auto">
        <table class="w-full text-left text-sm">
          <thead class="border-b border-slate-200 bg-slate-50 text-xs uppercase tracking-wider text-slate-500">
            <tr>
              <th class="px-6 py-3">Received</th>
              <th class="px-6 py-3">Reference</th>
              <th class="px-6 py-3">Method</th>
              <th class="px-6 py-3 text-right">Allocated</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-100">
            <% @ar_invoice.ar_payment_allocations.each do |allocation| %>
              <tr>
                <td class="px-6 py-4 text-slate-600"><%= allocation.ar_payment.received_at.strftime("%d %b %Y") %></td>
                <td class="px-6 py-4 font-semibold text-slate-950"><%= allocation.ar_payment.reference_number %></td>
                <td class="px-6 py-4 text-slate-600"><%= allocation.ar_payment.payment_method.humanize %></td>
                <td class="px-6 py-4 text-right font-bold tabular-nums text-slate-950"><%= allocation.ar_payment.currency %> <%= number_with_precision(allocation.amount, precision: 2) %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% else %>
      <p class="px-6 py-10 text-center text-sm text-slate-500">No payments have been allocated to this invoice yet.</p>
    <% end %>
  </section>

  <section class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">
    <div class="border-b border-slate-200 px-6 py-5">
      <h2 class="text-lg font-bold text-slate-950">Snapshot Metadata</h2>
    </div>
    <pre class="overflow-x-auto p-6 text-xs text-slate-700"><%= JSON.pretty_generate(@ar_invoice.metadata || {}) %></pre>
  </section>
</div>
