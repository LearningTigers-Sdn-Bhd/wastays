<%= turbo_frame_tag "ar_invoices_results" do %>
  <div class="hidden overflow-x-auto rounded-xl border border-slate-200 bg-white shadow-sm lg:block">
    <table class="min-w-[1400px] divide-y divide-slate-200">
      <thead class="bg-slate-50/50">
        <tr>
          <th scope="col" class="w-48 whitespace-nowrap px-6 py-3 text-left text-[10px] font-bold uppercase tracking-widest text-slate-500">Invoice</th>
          <th scope="col" class="w-40 whitespace-nowrap px-6 py-3 text-left text-[10px] font-bold uppercase tracking-widest text-slate-500">Status</th>
          <th scope="col" class="w-72 whitespace-nowrap px-6 py-3 text-left text-[10px] font-bold uppercase tracking-widest text-slate-500">Corporate Account</th>
          <th scope="col" class="w-96 whitespace-nowrap px-6 py-3 text-left text-[10px] font-bold uppercase tracking-widest text-slate-500">Source</th>
          <th scope="col" class="w-44 whitespace-nowrap px-6 py-3 text-left text-[10px] font-bold uppercase tracking-widest text-slate-500">Issued</th>
          <th scope="col" class="w-44 whitespace-nowrap px-6 py-3 text-left text-[10px] font-bold uppercase tracking-widest text-slate-500">Due</th>
          <th scope="col" class="w-52 whitespace-nowrap px-6 py-3 text-right text-[10px] font-bold uppercase tracking-widest text-slate-500">Outstanding</th>
          <th scope="col" class="sticky right-0 z-10 w-24 whitespace-nowrap border-l border-slate-200/50 bg-slate-50 px-6 py-3 text-right text-[10px] font-bold uppercase tracking-widest text-slate-500 shadow-[-4px_0_6px_-1px_rgba(0,0,0,0.05)]">Action</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-slate-100 bg-white">
        <% if presenter.paginated_rows.any? %>
          <% presenter.paginated_rows.each do |row| %>
            <tr
              class="group cursor-pointer transition-colors hover:bg-slate-50/80 focus-visible:bg-slate-50 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-inset focus-visible:ring-slate-900/20"
              role="link"
              tabindex="0"
              data-controller="clickable-row"
              data-testid="ar-invoice-row-<%= row.invoice.id %>"
              data-clickable-row-url-value="<%= hotel_ar_invoice_path(current_hotel, row.invoice) %>"
              data-action="click->clickable-row#visit keydown->clickable-row#visitFromKeyboard">
              <td class="whitespace-nowrap px-6 py-3">
                <span class="text-sm font-bold text-slate-900 decoration-slate-400 underline-offset-4 group-hover:underline group-focus-visible:underline"><%= row.invoice_label %></span>
              </td>
              <td class="whitespace-nowrap px-6 py-3">
                <span class="inline-flex items-center rounded-md border px-1.5 py-0.5 text-[10px] font-black uppercase tracking-wider <%= row.status_class %>"><%= row.status_label %></span>
              </td>
              <td class="whitespace-nowrap px-6 py-3 text-sm font-bold text-slate-900"><%= row.corporate_account_name %></td>
              <td class="whitespace-nowrap px-6 py-3 text-sm font-medium text-slate-700"><%= row.source_label %></td>
              <td class="whitespace-nowrap px-6 py-3 text-sm font-semibold text-slate-700"><%= row.issued_on_label %></td>
              <td class="whitespace-nowrap px-6 py-3 text-sm font-bold text-slate-900"><%= row.due_on_label %></td>
              <td class="whitespace-nowrap px-6 py-3 text-right text-sm font-black tabular-nums text-slate-950"><%= row.outstanding_amount_label %></td>
              <td class="sticky right-0 z-10 whitespace-nowrap border-l border-slate-100 bg-white px-6 py-3 text-right shadow-[-4px_0_6px_-1px_rgba(0,0,0,0.05)] group-hover:bg-slate-50 group-focus-visible:bg-slate-50">
                <%= render "row_actions", row: row %>
              </td>
            </tr>
          <% end %>
        <% else %>
          <tr>
            <td colspan="8" class="px-6 py-4">
              <%= render "empty_state", presenter: presenter %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>

  <div class="space-y-3 px-4 md:px-0 lg:hidden">
    <% if presenter.paginated_rows.any? %>
      <% presenter.paginated_rows.each do |row| %>
        <article
          class="group cursor-pointer rounded-xl border border-slate-200 bg-white p-4 shadow-sm transition hover:border-slate-300 hover:bg-slate-50/60 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-slate-900/20"
          role="link"
          tabindex="0"
          data-controller="clickable-row"
          data-testid="ar-invoice-card-<%= row.invoice.id %>"
          data-clickable-row-url-value="<%= hotel_ar_invoice_path(current_hotel, row.invoice) %>"
          data-action="click->clickable-row#visit keydown->clickable-row#visitFromKeyboard">
          <div class="flex items-start justify-between gap-3">
            <div>
              <p class="text-[10px] font-bold uppercase tracking-widest text-slate-400">Invoice</p>
              <p class="mt-1 text-sm font-black text-slate-900 decoration-slate-400 underline-offset-4 group-hover:underline group-focus-visible:underline"><%= row.invoice_label %></p>
            </div>
            <div class="flex items-start gap-2">
              <span class="inline-flex items-center rounded-md border px-1.5 py-0.5 text-[10px] font-black uppercase tracking-wider <%= row.status_class %>"><%= row.status_label %></span>
              <%= render "row_actions", row: row %>
            </div>
          </div>

          <div class="mt-4 grid grid-cols-2 gap-4">
            <div class="min-w-0">
              <p class="text-[10px] font-bold uppercase tracking-widest text-slate-400">Corporate Account</p>
              <p class="mt-1 truncate text-sm font-bold text-slate-900"><%= row.corporate_account_name %></p>
              <p class="mt-1 truncate text-[11px] font-medium text-slate-500"><%= row.source_label %></p>
            </div>
            <div class="text-right">
              <p class="text-[10px] font-bold uppercase tracking-widest text-slate-400">Outstanding</p>
              <p class="mt-1 text-sm font-black tabular-nums text-slate-950"><%= row.outstanding_amount_label %></p>
            </div>
          </div>

          <div class="mt-4 grid grid-cols-2 gap-4 border-t border-slate-100 pt-4">
            <div>
              <p class="text-[10px] font-bold uppercase tracking-widest text-slate-400">Issued</p>
              <p class="mt-1 text-xs font-semibold text-slate-700"><%= row.issued_on_label %></p>
            </div>
            <div class="text-right">
              <p class="text-[10px] font-bold uppercase tracking-widest text-slate-400">Due</p>
              <p class="mt-1 text-xs font-bold text-slate-900"><%= row.due_on_label %></p>
            </div>
          </div>
        </article>
      <% end %>
    <% else %>
      <div class="rounded-xl border border-dashed border-slate-200 bg-white p-6 shadow-sm">
        <%= render "empty_state", presenter: presenter %>
      </div>
    <% end %>
  </div>

  <% if presenter.pagination.total_pages > 1 %>
    <div class="mt-6 flex justify-center">
      <%= paginate presenter.pagination, params: presenter.pagination_params %>
    </div>
  <% end %>
<% end %>
