<% form_url = hotel_housekeeping_tasks_path(current_hotel) %>

<div class="space-y-6">
  <!-- Search and Filters Form -->
  <div>
    <%= form_with url: form_url, method: :get, id: "hk-filters-form", data: { controller: "auto-submit export-sync", turbo_frame: "housekeeping_tasks_results", action: "input->export-sync#sync change->export-sync#sync" }, class: "grid gap-4 sm:grid-cols-2 lg:grid-cols-5" do |f| %>

      <!-- Text Search -->
      <div class="relative lg:col-span-2">
        <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none text-muted-foreground">
          <%= cached_icon "search", class: "size-4" %>
        </div>
        <%= text_field_tag :q, params[:q], autocomplete: "off", class: "panel-input pl-10", placeholder: "Search guest, booking or request...", data: { action: "input->auto-submit#submit" } %>
      </div>

      <!-- Assigned To Filter -->
      <div>
        <%= select_tag :assigned_to, options_for_select([["All Staff", ""]] + @staff_members.map { |s| [s.name, s.id] }, params[:assigned_to]), class: "panel-native-select", data: { action: "change->auto-submit#submit" } %>
      </div>

      <!-- Room Status Filter -->
      <div>
        <%= select_tag :room_status, options_for_select(room_status_filter_options, params[:room_status]), class: "panel-native-select", data: { action: "change->auto-submit#submit" } %>
      </div>

      <!-- Date Filter -->
      <div>
        <%= date_field_tag :date, (params[:date].presence || @selected_date.to_s), class: "panel-native-select", placeholder: "Date", data: { action: "change->auto-submit#submit" } %>
      </div>
    <% end %>
  </div>

  <!-- Results Frame -->
  <%= turbo_frame_tag "housekeeping_tasks_results" do %>
    <div class="overflow-hidden rounded-lg border border-border bg-card">
      <% if @room_groups.any? %>
        <div class="overflow-x-auto">
          <table class="min-w-full divide-y divide-border table-fixed">
            <colgroup>
              <col class="w-[12%]"> <!-- Room -->
              <col class="w-[13%]"> <!-- Assign To -->
              <col class="w-[11%]"> <!-- Room Status -->
              <col class="w-[9%]">  <!-- Arrival Time -->
              <col class="w-[9%]">  <!-- Arrival Date -->
              <col class="w-[9%]">  <!-- Departure -->
              <col class="w-[5%]">  <!-- Nights -->
              <col class="w-[22%]"> <!-- Task Details -->
              <col class="w-[10%]"> <!-- Task Status -->
            </colgroup>
            <thead class="bg-muted">
              <tr>
                <th scope="col" class="px-6 py-4 text-left text-xs font-medium text-muted-foreground whitespace-nowrap border-r border-border">Room</th>
                <th scope="col" class="px-3 py-4 text-left text-xs font-medium text-muted-foreground whitespace-nowrap">Assign To</th>
                <th scope="col" class="px-3 py-4 text-left text-xs font-medium text-muted-foreground whitespace-nowrap">Room Status</th>
                <th scope="col" class="px-3 py-4 text-left text-xs font-medium text-muted-foreground whitespace-nowrap">Arrival Time</th>
                <th scope="col" class="px-3 py-4 text-left text-xs font-medium text-muted-foreground whitespace-nowrap">Arrival Date</th>
                <th scope="col" class="px-3 py-4 text-left text-xs font-medium text-muted-foreground whitespace-nowrap">Departure</th>
                <th scope="col" class="px-3 py-4 text-center text-xs font-medium text-muted-foreground whitespace-nowrap">Nights</th>
                <th scope="col" class="px-3 py-4 text-left text-xs font-medium text-muted-foreground whitespace-nowrap">Task Details</th>
                <th scope="col" class="py-4 pl-3 pr-6 text-right text-xs font-medium text-muted-foreground whitespace-nowrap">Task Status</th>
              </tr>
            </thead>
            <% @room_groups.each do |group| %>
              <tbody class="divide-y divide-border" data-controller="table-group">
                <!-- Room Type Heading Row -->
                <tr class="bg-muted cursor-pointer select-none border-b border-border" data-action="click->table-group#toggle">
                  <td colspan="9" class="px-6 py-3 text-sm font-semibold text-foreground">
                    <div class="flex items-center gap-2">
                      <span><%= group[:room_type].name %></span>
                      <%= cached_icon "chevron-right", stroke_width: 2.5, class: "size-4 shrink-0 text-muted-foreground transition-transform duration-150 rotate-90", data: { table_group_target: "icon" } %>
                    </div>
                  </td>
                </tr>

                <!-- Room Rows -->
                <% group[:rooms].each do |room| %>
                  <tr class="group hover:bg-muted/50 transition-colors duration-150 align-middle" data-table-group-target="row">
                    <!-- Room -->
                    <td class="px-6 py-4 whitespace-nowrap align-middle border-r border-border pr-6">
                      <div class="flex items-center justify-between gap-2 w-full">
                        <div class="min-w-0">
                          <span class="block text-sm font-medium text-foreground"><%= room.room_number %></span>
                        </div>
                        <% if room.room_type %>
                          <div class="flex items-center gap-1.5 shrink-0">
                            <%= render "shared/room_attribute_icon",
                                       allowed: room.smoking_allowed?,
                                       icon_name: "cigarette",
                                       allowed_label: "Smoking Allowed",
                                       disallowed_label: "No Smoking" %>

                            <%= render "shared/room_attribute_icon",
                                       allowed: room.pets_allowed?,
                                       icon_name: "paw-print",
                                       allowed_label: "Pets Allowed",
                                       disallowed_label: "No Pets",
                                       disallowed_icon_size: "size-3" %>
                          </div>
                        <% end %>
                      </div>
                    </td>

                    <!-- Assign To -->
                    <td class="px-3 py-4 whitespace-nowrap text-sm text-foreground">
                      <div class="flex min-h-9 items-center py-1">
                        <% first_req = room.first_task_request %>
                        <% if first_req&.assignable? %>
                          <%= form_with url: first_req.assign_url, method: :patch, data: { controller: "auto-submit" }, class: "inline-block" do |f| %>
                            <% board_filters.each do |key, value| %>
                              <%= hidden_field_tag "filters[#{key}]", value, id: nil %>
                            <% end %>
                            <%= select_tag :assigned_to, options_for_select([["Unassigned", ""]] + @staff_members.map { |s| [s.name, s.id] }, first_req.assigned_to_value), class: "panel-native-select", data: { action: "change->auto-submit#submit" } %>
                          <% end %>
                        <% else %>
                          <span class="text-sm text-muted-foreground">-</span>
                        <% end %>
                      </div>
                    </td>

                    <!-- Room Status -->
                    <td class="px-3 py-4 whitespace-nowrap">
                      <%= render PanelsUI::Badge.new(label: room.display_status, variant: room.status_badge_variant, size: :sm) %>
                    </td>

                    <!-- Arrival Time -->
                    <td class="px-3 py-4 whitespace-nowrap text-sm text-foreground">
                      <%= room.arrival_time %>
                    </td>

                    <!-- Arrival Date -->
                    <td class="px-3 py-4 whitespace-nowrap text-sm text-foreground">
                      <%= room.arrival_date %>
                    </td>

                    <!-- Departure -->
                    <td class="px-3 py-4 whitespace-nowrap text-sm text-foreground">
                      <%= room.departure_date %>
                    </td>

                    <!-- Nights -->
                    <td class="px-3 py-4 whitespace-nowrap text-sm text-foreground text-center">
                      <%= room.nights %>
                    </td>

                    <!-- Task Details -->
                    <td class="px-3 py-4">
                      <div class="flex flex-col gap-2">
                        <% room.task_requests.each do |req| %>
                          <div class="flex min-h-9 items-center py-1">
                            <% if req.has_details? %>
                              <p class="text-sm text-foreground line-clamp-2" title="<%= req.request_details %>">
                                <%= req.request_details %>
                              </p>
                            <% else %>
                              <span class="text-sm text-muted-foreground">-</span>
                            <% end %>
                          </div>
                        <% end %>
                      </div>
                    </td>

                    <!-- Task Status -->
                    <td class="py-4 pl-3 pr-6 text-right whitespace-nowrap text-sm text-foreground">
                      <div class="flex flex-col gap-2 items-end">
                        <% room.task_requests.each do |req| %>
                          <div class="flex min-h-9 items-center py-1">
                            <% if req.assignable? %>
                              <%= form_with url: req.status_url, method: :patch, data: { controller: "auto-submit" }, class: "inline-block" do |f| %>
                                <%= hidden_field_tag :redirect_to, request.original_url %>
                                <%= select_tag :status, options_for_select(task_status_options, req.selected_status_value), class: "panel-native-select", data: { action: "change->auto-submit#submit" } %>
                              <% end %>
                            <% else %>
                              <%= render PanelsUI::Badge.new(label: req.fallback_status_label, variant: :warning, size: :sm) %>
                            <% end %>
                          </div>
                        <% end %>
                      </div>
                    </td>
                  </tr>
                <% end %>
              </tbody>
            <% end %>
          </table>
        </div>
      <% else %>
        <div class="px-6 py-16 text-center sm:px-8 space-y-3">
          <div class="inline-flex size-12 items-center justify-center rounded-lg border border-border bg-muted text-muted-foreground">
            <%= cached_icon "clipboard-check", class: "size-6" %>
          </div>
          <div>
            <h3 class="text-base font-semibold text-foreground">No rooms found</h3>
            <p class="mt-1 text-sm text-muted-foreground">Try adjusting your filters or searching for a different room.</p>
          </div>
        </div>
      <% end %>
    </div>
  <% end %>
</div>
