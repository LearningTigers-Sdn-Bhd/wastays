<% form_url = (controller_name == "room_status_board" ? hotel_room_status_board_path(current_hotel) : hotel_housekeeping_tasks_path(current_hotel)) %>

<div class="space-y-6">
  <!-- Search and Filters Form -->
  <div class="mx-4 rounded-2xl border border-slate-200 bg-white p-4 shadow-sm md:mx-0">
    <%= form_with url: form_url, method: :get, data: { controller: "auto-submit", turbo_frame: "housekeeping_tasks_results" }, class: "grid gap-4 md:grid-cols-[1fr_250px_auto]" do |f| %>
      <%= hidden_field_tag :tab, "housekeeping" if controller_name == "room_status_board" %>

      <!-- Text Search -->
      <div class="relative">
        <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none text-slate-400">
          <%= cached_icon "search", class: "size-4" %>
        </div>
        <%= text_field_tag :q, params[:q], autocomplete: "off", class: "w-full rounded-xl border border-slate-200 pl-10 pr-4 py-2.5 text-sm font-medium text-slate-700 focus:border-slate-300 focus:outline-none focus:ring-0 shadow-sm", placeholder: "Search guest, booking or request...", data: { action: "input->auto-submit#submit" } %>
      </div>

      <!-- Room Number Filter -->
      <div>
        <%= text_field_tag :room_number, params[:room_number], class: "w-full rounded-xl border border-slate-200 bg-white px-4 py-2.5 text-sm font-medium text-slate-700 focus:border-slate-300 focus:outline-none focus:ring-0 shadow-sm", placeholder: "Room number...", data: { action: "input->auto-submit#submit" } %>
      </div>

      <!-- Actions -->
      <div class="flex items-center gap-2">
        <%= f.submit "Filter", class: "rounded-xl bg-slate-900 px-6 py-2.5 text-sm font-bold text-white shadow-sm transition hover:bg-slate-700 cursor-pointer" %>
        <%= link_to "Reset", form_url, class: "rounded-xl border border-slate-200 bg-white px-6 py-2.5 text-sm font-bold text-slate-700 shadow-sm transition hover:bg-slate-50", data: { turbo_frame: "_top" } %>
      </div>
    <% end %>
  </div>

  <!-- Results Frame -->
  <%= turbo_frame_tag "housekeeping_tasks_results" do %>
    <div class="mx-4 overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm md:mx-0">
      <% if @room_groups.any? %>
        <div class="overflow-x-auto">
          <table class="min-w-full divide-y divide-slate-200 table-fixed">
            <colgroup>
              <col class="w-[10%]"> <!-- Room -->
              <col class="w-[15%]"> <!-- Assign To -->
              <col class="w-[12%]"> <!-- Room Status -->
              <col class="w-[10%]"> <!-- Arrival Time -->
              <col class="w-[10%]"> <!-- Arrival Date -->
              <col class="w-[10%]"> <!-- Departure -->
              <col class="w-[6%]">  <!-- Nights -->
              <col class="w-[17%]"> <!-- Task Details -->
              <col class="w-[10%]"> <!-- Task Status -->
            </colgroup>
            <thead class="bg-slate-50">
              <tr>
                <th scope="col" class="px-6 py-4 text-left text-[11px] font-bold uppercase tracking-[0.1em] text-slate-500 whitespace-nowrap">Room</th>
                <th scope="col" class="px-3 py-4 text-left text-[11px] font-bold uppercase tracking-[0.1em] text-slate-500 whitespace-nowrap">Assign To</th>
                <th scope="col" class="px-3 py-4 text-left text-[11px] font-bold uppercase tracking-[0.1em] text-slate-500 whitespace-nowrap">Room Status</th>
                <th scope="col" class="px-3 py-4 text-left text-[11px] font-bold uppercase tracking-[0.1em] text-slate-500 whitespace-nowrap">Arrival Time</th>
                <th scope="col" class="px-3 py-4 text-left text-[11px] font-bold uppercase tracking-[0.1em] text-slate-500 whitespace-nowrap">Arrival Date</th>
                <th scope="col" class="px-3 py-4 text-left text-[11px] font-bold uppercase tracking-[0.1em] text-slate-500 whitespace-nowrap">Departure</th>
                <th scope="col" class="px-3 py-4 text-center text-[11px] font-bold uppercase tracking-[0.1em] text-slate-500 whitespace-nowrap">Nights</th>
                <th scope="col" class="px-3 py-4 text-left text-[11px] font-bold uppercase tracking-[0.1em] text-slate-500 whitespace-nowrap">Task Details</th>
                <th scope="col" class="py-4 pl-3 pr-6 text-right text-[11px] font-bold uppercase tracking-[0.1em] text-slate-500 whitespace-nowrap">Task Status</th>
              </tr>
            </thead>
            <% @room_groups.each do |group| %>
              <tbody class="divide-y divide-slate-200" data-controller="table-group">
                <!-- Room Type Heading Row -->
                <tr class="bg-slate-100/80 font-bold cursor-pointer select-none border-b border-slate-200" data-action="click->table-group#toggle">
                  <td colspan="9" class="px-6 py-3 text-xs font-black text-slate-800 uppercase tracking-wider">
                    <div class="flex items-center gap-2">
                      <%= cached_icon "chevron-right", stroke_width: 2.5, class: "size-4 shrink-0 text-slate-500 transition-transform duration-150 rotate-90", data: { table_group_target: "icon" } %>
                      <span><%= group[:room_type].name %></span>
                      <span class="text-[10px] font-bold text-slate-500 normal-case">(<%= pluralize(group[:rooms].size, "room") %>)</span>
                    </div>
                  </td>
                </tr>

                <!-- Rooms Row -->
                <% group[:rooms].each do |room| %>
                  <% room_no = room[:room_number] %>
                  <% resolved_status = room[:resolved_status] %>
                  <% active_booking = room[:active_booking] %>
                  <% hk_request = room[:hk_request] %>

                  <% display_status = resolved_status == "dirty" ? "Dirty Confirmed" : resolved_status.humanize.titleize %>
                  <% status_badge_class = case resolved_status
                                          when "ready" then "bg-emerald-50 text-emerald-700 border-emerald-100"
                                          when "dirty" then "bg-amber-50 text-amber-700 border-amber-100"
                                          when "cleaning" then "bg-blue-50 text-blue-700 border-blue-100"
                                          when "occupied" then "bg-rose-50 text-rose-700 border-rose-100"
                                          else "bg-slate-50 text-slate-700 border-slate-100"
                                          end %>

                  <tr class="group hover:bg-slate-50/70 transition-colors duration-150 align-middle" data-table-group-target="row">
                    <!-- Room -->
                    <td class="px-6 py-4 whitespace-nowrap text-sm font-bold text-slate-950">
                      <%= room_no %>
                    </td>

                    <!-- Assign To -->
                    <td class="px-3 py-4 whitespace-nowrap text-xs font-bold text-slate-900">
                      <% if hk_request %>
                        <%= form_with url: assign_hotel_housekeeping_task_path(current_hotel, hk_request), method: :patch, data: { controller: "auto-submit" }, class: "inline-block" do |f| %>
                          <%= f.select :assigned_to, options_from_collection_for_select(@staff_members, :id, :name, hk_request.metadata&.dig("assigned_to")), { include_blank: "Unassigned" }, class: "rounded-xl border border-slate-200 bg-white px-3 py-1.5 text-xs text-slate-700 focus:border-slate-300 focus:outline-none focus:ring-0 shadow-sm cursor-pointer", data: { action: "change->auto-submit#submit" } %>
                        <% end %>
                      <% else %>
                        <span class="text-xs font-bold text-slate-400">-</span>
                      <% end %>
                    </td>

                    <!-- Room Status -->
                    <td class="px-3 py-4 whitespace-nowrap">
                      <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-[10px] font-black uppercase tracking-wider border <%= status_badge_class %>">
                        <%= display_status %>
                      </span>
                    </td>

                    <!-- Arrival Time -->
                    <td class="px-3 py-4 whitespace-nowrap text-xs font-bold text-slate-900">
                      <%= (active_booking && active_booking.pre_checkin&.metadata&.dig("estimated_arrival_time").presence) || "-" %>
                    </td>

                    <!-- Arrival Date -->
                    <td class="px-3 py-4 whitespace-nowrap text-xs font-bold text-slate-900">
                      <%= active_booking ? display_housekeeping_date(active_booking.check_in) : "-" %>
                    </td>

                    <!-- Departure -->
                    <td class="px-3 py-4 whitespace-nowrap text-xs font-bold text-slate-900">
                      <%= active_booking ? display_housekeeping_date(active_booking.check_out) : "-" %>
                    </td>

                    <!-- Nights -->
                    <td class="px-3 py-4 whitespace-nowrap text-xs font-bold text-slate-900 text-center">
                      <%= active_booking ? active_booking.duration_in_nights : "-" %>
                    </td>

                    <!-- Task Details -->
                    <td class="px-3 py-4">
                      <% if hk_request %>
                        <p class="text-sm font-medium text-slate-700 line-clamp-2" title="<%= hk_request.request_details %>">
                          <%= hk_request.request_details %>
                        </p>
                      <% else %>
                        <span class="text-xs font-bold text-slate-400">-</span>
                      <% end %>
                    </td>

                    <!-- Task Status -->
                    <td class="py-4 pl-3 pr-6 text-right whitespace-nowrap text-xs font-bold text-slate-900">
                      <% if hk_request %>
                        <%= form_with url: hotel_request_status_path(current_hotel, kind: "housekeeping", request_id: hk_request.id), method: :patch, data: { controller: "auto-submit" }, class: "inline-block" do |f| %>
                          <%= hidden_field_tag :redirect_to, request.original_url %>
                          <%= select_tag :status, options_for_select([["Pending", "pending"], ["In Progress", "in_progress"], ["Completed", "completed"], ["Failed", "failed"], ["Cancelled", "cancelled"]], hk_request.status), class: "rounded-xl border border-slate-200 bg-white px-3 py-1.5 text-xs text-slate-700 focus:border-slate-300 focus:outline-none focus:ring-0 shadow-sm cursor-pointer", data: { action: "change->auto-submit#submit" } %>
                        <% end %>
                      <% else %>
                        <span class="text-xs font-bold text-slate-400">-</span>
                      <% end %>
                    </td>
                  </tr>
                <% end %>
              </tbody>
            <% end %>
          </table>
        </div>
      <% else %>
        <div class="px-6 py-20 text-center sm:px-8 space-y-3">
          <div class="inline-flex size-14 items-center justify-center rounded-2xl bg-slate-50 border border-slate-100 text-slate-400 shadow-inner">
            <%= cached_icon "clipboard-check", class: "size-6" %>
          </div>
          <div>
            <h3 class="text-sm font-bold text-slate-900 uppercase tracking-wider">No rooms found</h3>
            <p class="mt-1 text-sm font-medium text-slate-500">Try adjusting your filters or searching for a different room.</p>
          </div>
        </div>
      <% end %>
    </div>
  <% end %>
</div>
