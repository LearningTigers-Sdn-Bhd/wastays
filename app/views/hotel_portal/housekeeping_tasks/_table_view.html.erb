<% form_url = hotel_housekeeping_tasks_path(current_hotel) %>
<% board_return_url = hotel_housekeeping_tasks_path(current_hotel, board_filters.merge(date: @selected_date.iso8601)) %>
<% staff_choices = @staff_members.map { |staff| [ staff.name, staff.id ] } %>
<% writable_date = @selected_date == (current_hotel.current_business_date || current_hotel.business_date_for(Time.current)) %>

<div class="space-y-6">
  <section class="space-y-3" aria-labelledby="hk-filters-heading">
    <h2 id="hk-filters-heading" class="sr-only">Filter housekeeping rooms</h2>

    <%= form_with url: form_url, method: :get, id: "hk-filters-form",
          data: {
            controller: "export-sync",
            action: "change->export-sync#sync input->export-sync#sync",
            turbo_frame: "housekeeping_tasks_results"
          },
          class: "grid items-end gap-4 sm:grid-cols-2 lg:grid-cols-5" do |form| %>

      <%= render PanelsUI::FormField.new(form:, attribute: :q, label: "Search", class: "lg:col-span-2") do |field| %>
        <% field.with_addon(align: :inline_start, variant: :bare) do %>
          <%= app_icon "search", class: "size-4 text-muted-foreground", aria: { hidden: true } %>
        <% end %>
        <% field.with_input(type: :search, value: params[:q], autocomplete: "off",
                            placeholder: "Room, guest, booking or remarks") %>
      <% end %>

      <%= render PanelsUI::FormField.new(form:, attribute: :assigned_to, label: "Assigned to") do |field| %>
        <% field.with_select_menu([ [ "All staff", "" ] ] + staff_choices, selected: params[:assigned_to].to_s) %>
      <% end %>

      <%= render PanelsUI::FormField.new(form:, attribute: :booking_status, label: "Booking status") do |field| %>
        <% field.with_select_menu(booking_status_filter_options, selected: params[:booking_status].to_s) %>
      <% end %>

      <div class="flex flex-col gap-2 sm:flex-row sm:items-end">
        <%= render PanelsUI::FormField.new(form:, attribute: :date, label: "As of date", class: "flex-1") do |field| %>
          <% field.with_date_picker(value: @selected_date.iso8601, placeholder: "As of date") %>
        <% end %>
        <%= render PanelsUI::Button.new(label: "Apply", variant: :secondary, type: "submit") %>
      </div>
    <% end %>
  </section>

  <section class="space-y-3" aria-labelledby="hk-board-heading" data-controller="results-announcer">
    <h2 id="hk-board-heading" class="sr-only">Housekeeping room board</h2>
    <p class="sr-only" role="status" aria-live="polite" aria-atomic="true"
       data-results-announcer-target="status"></p>

    <%= turbo_frame_tag "housekeeping_tasks_results" do %>
      <% unless writable_date %>
        <div class="mb-3 rounded-lg border border-border bg-muted px-4 py-3 text-sm text-muted-foreground" role="note">
          Room status, assignment, and remarks are read-only outside the current business date.
        </div>
      <% end %>

      <p hidden data-board-summary>
        <%= pluralize(@room_groups.sum { |group| group[:rooms].size }, "room") %>
        matching the current filters.
      </p>

      <% if @room_groups.any? %>
        <%= render PanelsUI::Table.new(
              caption: "Housekeeping rooms by room type",
              density: :compact,
              header_style: :sentence,
              hoverable: true,
              sticky_header: true,
              wrapper_class: "max-h-[75dvh] overflow-auto overscroll-none rounded-lg border border-border bg-card",
              data: { controller: "table-group" }
            ) do |table| %>
          <% table.with_header do %>
            <tr>
              <th scope="col">Room type</th>
              <th scope="col" class="text-center">Pax</th>
              <th scope="col">Room status</th>
              <th scope="col">Assigned to</th>
              <th scope="col" class="text-center">Booking status</th>
              <th scope="col" class="text-end">Arrival</th>
              <th scope="col" class="text-end">Departure</th>
              <th scope="col" class="text-center">Nights</th>
              <th scope="col">Remarks</th>
            </tr>
          <% end %>

          <% table.with_body do %>
            <% @room_groups.each_with_index do |group, group_index| %>
              <% group_key = "hk-group-#{group[:room_type]&.id || group_index}" %>
              <% row_ids = group[:rooms].map { |room| "#{group_key}-#{room.dom_key}" } %>

              <tr class="bg-muted/55" data-slot="room-type-group">
                <th scope="rowgroup" colspan="9">
                  <button type="button"
                          class="flex w-full items-center gap-2 text-left text-sm font-semibold text-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-border-interactive"
                          aria-expanded="true"
                          aria-controls="<%= row_ids.join(" ") %>"
                          data-action="click->table-group#toggle"
                          data-table-group-group-param="<%= group_key %>">
                    <%= app_icon "chevron-right",
                          class: "size-4 shrink-0 rotate-90 text-muted-foreground transition-transform duration-150",
                          aria: { hidden: true },
                          data: { table_group_target: "icon" } %>
                    <span><%= group[:room_type]&.name || "Unassigned room type" %></span>
                    <span class="text-xs font-normal text-muted-foreground">
                      (<%= pluralize(group[:rooms].size, "room") %>)
                    </span>
                  </button>
                </th>
              </tr>

              <% group[:rooms].each do |room| %>
                <tr id="<%= "#{group_key}-#{room.dom_key}" %>" class="align-middle" data-group="<%= group_key %>">
                  <th scope="row" class="whitespace-nowrap">
                    <div class="flex items-center justify-between gap-2">
                      <span class="font-medium text-foreground"><%= room.room_number %></span>
                      <span class="flex shrink-0 items-center gap-1.5">
                        <%= render "shared/room_attribute_icon",
                              allowed: room.smoking_allowed?,
                              icon_name: "cigarette",
                              allowed_label: "Smoking Allowed",
                              disallowed_label: "No Smoking" %>
                        <%= render "shared/room_attribute_icon",
                              allowed: room.pets_allowed?,
                              icon_name: "paw-print",
                              allowed_label: "Pets Allowed",
                              disallowed_label: "No Pets",
                              disallowed_icon_size: "size-3" %>
                      </span>
                    </div>
                  </th>

                  <td class="whitespace-nowrap text-center tabular-nums"><%= room.pax %></td>

                  <td class="w-52 whitespace-nowrap">
                    <% if room.writable? %>
                      <% status_id = "hk-room-status-#{room.dom_key}" %>
                      <%= form_with url: room.status_url, method: :patch, class: "contents",
                            data: {
                              controller: "auto-submit",
                              action: "change->auto-submit#submitNow",
                              turbo_frame: "_top"
                            } do |form| %>
                        <%= hidden_field_tag :date, @selected_date.iso8601, id: nil %>
                        <% board_filters.each do |key, value| %>
                          <%= hidden_field_tag "filters[#{key}]", value, id: nil %>
                        <% end %>
                        <%= label_tag status_id, "Room status for #{room.label}", class: "sr-only" %>
                        <%= render PanelsUI::SelectMenu.new(
                              form:,
                              attribute: :status,
                              id: status_id,
                              size: :sm,
                              class: "w-48",
                              choices: room.status_choices,
                              selected: room.resolved_status) %>
                      <% end %>
                    <% else %>
                      <%= render PanelsUI::Badge.new(
                            label: room.display_status,
                            variant: room.status_badge_variant,
                            size: :sm,
                            class: "w-full justify-center") %>
                    <% end %>
                  </td>

                  <td class="whitespace-nowrap">
                    <% if dispatch_housekeeping? && room.writable? %>
                      <% assignment_id = "hk-assignment-#{room.dom_key}" %>
                      <%= form_with url: room.assignment_url, method: :patch, class: "contents",
                            data: { controller: "auto-submit", action: "change->auto-submit#submitNow" } do |form| %>
                        <%= hidden_field_tag :date, @selected_date.iso8601, id: nil %>
                        <% board_filters.each do |key, value| %>
                          <%= hidden_field_tag "filters[#{key}]", value, id: nil %>
                        <% end %>
                        <%= label_tag assignment_id, "Assign housekeeper for #{room.label}", class: "sr-only" %>
                        <%= render PanelsUI::Combobox.new(
                              form:,
                              attribute: :assigned_to_id,
                              id: assignment_id,
                              size: :sm,
                              class: "w-44",
                              choices: [ [ "Unassigned", "" ] ] + staff_choices,
                              selected: room.assigned_to_value,
                              allow_empty_option: true,
                              placeholder: "Unassigned",
                              empty_text: "No staff found") %>
                      <% end %>
                    <% else %>
                      <span class="text-sm <%= room.assigned_to ? "text-foreground" : "text-muted-foreground" %>">
                        <%= room.assigned_to_name %>
                      </span>
                    <% end %>
                  </td>

                  <td class="w-36 text-center">
                    <%= render PanelsUI::Badge.new(
                          label: room.booking_status_label,
                          variant: room.booking_status_badge_variant,
                          size: :sm,
                          class: "w-full justify-center") %>
                  </td>

                  <td class="whitespace-nowrap text-end"><%= room.arrival %></td>
                  <td class="whitespace-nowrap text-end"><%= room.departure %></td>
                  <td class="text-center tabular-nums"><%= room.nights %></td>

                  <td class="max-w-xs">
                    <div class="flex items-center justify-between gap-2">
                      <p class="line-clamp-2 min-w-0 text-sm <%= room.has_remarks? ? "text-foreground" : "text-muted-foreground" %>"
                         title="<%= room.notes if room.has_remarks? %>"><%= room.remarks %></p>
                      <% if room.writable? %>
                        <div class="flex shrink-0 items-center gap-1">
                          <% if room.has_remarks? %>
                            <%= form_with url: room.remarks_url, method: :patch, class: "contents",
                                  data: { turbo_confirm: "Clear remarks for #{room.label}?" } do %>
                              <%= hidden_field_tag :date, @selected_date.iso8601, id: nil %>
                              <%= hidden_field_tag :return_to, board_return_url, id: nil %>
                              <%= hidden_field_tag :notes, "", id: nil %>
                              <%= render PanelsUI::Button.new(
                                    as: :button,
                                    type: :submit,
                                    variant: :ghost,
                                    size: :icon_sm,
                                    aria_label: "Clear remarks for #{room.label}") do %>
                                <%= app_icon "x", class: "size-4", aria: { hidden: true } %>
                              <% end %>
                            <% end %>
                          <% end %>

                          <%= render PanelsUI::Button.new(
                                href: room.edit_remarks_url(return_to: board_return_url),
                                variant: :ghost,
                                size: :icon_sm,
                                data: { turbo_frame: "housekeeping_action_sheet" },
                                aria_label: "Edit remarks for #{room.label}") do %>
                            <%= app_icon "pencil", class: "size-4", aria: { hidden: true } %>
                          <% end %>
                        </div>
                      <% end %>
                    </div>
                  </td>
                </tr>
              <% end %>
            <% end %>
          <% end %>
        <% end %>
      <% else %>
        <div class="space-y-3 rounded-lg border border-border bg-card px-6 py-16 text-center sm:px-8">
          <span class="inline-flex size-12 items-center justify-center rounded-lg border border-border bg-muted text-muted-foreground">
            <%= app_icon "clipboard-check", class: "size-6", aria: { hidden: true } %>
          </span>
          <div>
            <h3 class="text-base font-semibold text-foreground">No rooms found</h3>
            <p class="mt-1 text-sm text-muted-foreground">Try adjusting your filters or searching for a different room.</p>
          </div>
        </div>
      <% end %>
    <% end %>
  </section>
</div>
