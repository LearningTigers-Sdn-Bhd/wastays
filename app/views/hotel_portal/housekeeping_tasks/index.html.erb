<% content_for :title, "Housekeeping Tasks | WAStays" %>

<div class="max-w-[1600px] mx-auto pb-10 space-y-6">
  <%= render PanelsUI::PageHeader.new(title: "Housekeeping Tasks", description: "Monitor, dispatch, and manage room cleaning and service requests in real-time.") do |header| %>
    <% header.with_actions do %>
      <%= render PanelsUI::DropdownMenu.new(id: "housekeeping-tasks-export-menu", placement: :bottom_end, class: "w-48") do |menu| %>
        <% menu.with_trigger(variant: :neutral, size: :md, class: "w-full sm:w-auto") do %>
          <%= cached_icon "download", class: "size-4" %>
          Export
        <% end %>
        <% menu.with_item(href: hotel_housekeeping_tasks_path(current_hotel, format: :pdf), id: "export-pdf-link", variant: :default, data: { turbo: false }) do %>
          <%= cached_icon "file-pdf", class: "size-4 text-rose-500" %>
          <span>PDF</span>
        <% end %>
        <% menu.with_item(href: hotel_housekeeping_tasks_path(current_hotel, format: :xls), id: "export-excel-link", variant: :default, data: { turbo: false }) do %>
          <%= cached_icon "file-xls", class: "size-4 text-emerald-500" %>
          <span>Excel</span>
        <% end %>
      <% end %>
    <% end %>
  <% end %>

  <%= render "hotel_portal/housekeeping_tasks/table_view" %>
</div>
