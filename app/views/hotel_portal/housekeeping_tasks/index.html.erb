<% content_for :title, "Housekeeping Tasks | WAStays" %>

<div class="max-w-[1600px] mx-auto pb-10 space-y-6">
  <!-- Header -->
  <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between px-4 md:px-0 mt-6">
    <div>
      <h1 class="text-2xl font-black tracking-tight text-slate-950 sm:text-3xl">Housekeeping Tasks</h1>
      <p class="mt-1 text-sm font-medium text-slate-600">Monitor, dispatch, and manage room cleaning and service requests in real-time.</p>
    </div>

    <!-- Export Dropdown -->
    <div class="relative inline-block text-left shrink-0 self-start sm:self-center" data-controller="dropdown" data-dropdown-align="right">
      <button type="button" class="inline-flex items-center gap-1.5 rounded-xl border border-slate-200 bg-white px-4 py-2.5 text-xs font-bold text-slate-700 shadow-sm transition hover:border-slate-900 hover:bg-slate-50" data-dropdown-target="button" data-action="click->dropdown#toggle keydown->dropdown#handleKeydown" aria-expanded="false" aria-haspopup="true">
        <%= cached_icon "download", class: "size-4 text-slate-500" %>
        <span>Export</span>
      </button>
      <div data-dropdown-target="menu" class="hidden absolute right-0 z-50 mt-2 w-48 origin-top-right rounded-2xl border border-slate-200 bg-white p-1.5 shadow-xl shadow-slate-950/10 focus:outline-none" role="menu" aria-orientation="vertical" tabindex="-1">
        <%= link_to hotel_housekeeping_tasks_path(current_hotel, format: :pdf), id: "export-pdf-link", role: "menuitem", class: "flex w-full items-center gap-3 rounded-lg px-3 py-2.5 text-left text-sm font-semibold text-slate-700 hover:bg-slate-100 focus-visible:bg-slate-100 focus-visible:outline-none", data: { turbo: false } do %>
          <%= cached_icon "file-pdf", class: "size-4 text-rose-500" %>
          <span>PDF</span>
        <% end %>
        <%= link_to hotel_housekeeping_tasks_path(current_hotel, format: :xls), id: "export-excel-link", role: "menuitem", class: "flex w-full items-center gap-3 rounded-lg px-3 py-2.5 text-left text-sm font-semibold text-slate-700 hover:bg-slate-100 focus-visible:bg-slate-100 focus-visible:outline-none", data: { turbo: false } do %>
          <%= cached_icon "file-xls", class: "size-4 text-emerald-500" %>
          <span>Excel</span>
        <% end %>
      </div>
    </div>
  </div>

  <%= render "hotel_portal/housekeeping_tasks/table_view" %>
</div>
