<div class="max-w-[1600px] mx-auto pb-20 space-y-8">
  <div class="px-4 md:px-0">
    <div class="mt-5">
      <div>
        <h1 class="text-2xl font-bold tracking-tight text-slate-950 sm:text-3xl">In-House Guests</h1>
        <p class="mt-1 text-sm font-medium text-slate-600">Guests currently checked in at your hotel.</p>
      </div>
    </div>
  </div>

  <div class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">
    <div class="flex items-center justify-between border-b border-slate-200 px-6 py-5 sm:px-8">
      <div>
        <h2 class="text-lg font-bold tracking-tight text-slate-950 sm:text-xl">Current Stays</h2>
        <p class="mt-1 text-sm font-medium text-slate-600">Live view of guests who are currently checked in at this property.</p>
      </div>
      <div class="flex items-center gap-x-6">
        <span class="text-sm font-medium text-slate-500">In-House Now <span class="font-semibold text-slate-900"><%= @in_house_count %></span></span>
        <span class="text-sm font-medium text-slate-500">Check-outs Today <span class="font-semibold text-slate-900"><%= @check_outs_today_count %></span></span>
      </div>
    </div>

    <div class="border-b border-slate-200 bg-slate-50/70 px-6 py-4 sm:px-8">
      <%= form_with url: hotel_in_house_guests_path(current_hotel), method: :get, class: "flex flex-col gap-3 xl:flex-row xl:items-center xl:justify-between", data: { controller: "auto-submit" } do |f| %>
        <div class="flex w-full flex-col gap-3 lg:flex-row">
          <label class="relative block flex-1">
            <span class="sr-only">Search in-house guests</span>
            <span class="pointer-events-none absolute inset-y-0 left-0 flex items-center pl-4 text-slate-400">
              <%= cached_icon "search", library: "lucide", class: "size-4" %>
            </span>
            <%= f.search_field :query,
                               value: @query,
                               id: "in-house-guests-search",
                               placeholder: "Search guest, contact, or booking reference",
                               class: "w-full rounded-xl border border-slate-200 bg-white py-2.5 pl-11 pr-4 text-sm text-slate-700 placeholder:text-slate-400 focus:border-slate-300 focus:outline-none focus:ring-0",
                               data: { action: "input->auto-submit#submit" } %>
          </label>

          <%= f.select :room_assignment,
                       [["All In-House", ""], ["With Room Assigned", "assigned"], ["Without Room Assigned", "unassigned"]],
                       { selected: @room_assignment },
                       class: "rounded-xl border border-slate-200 bg-white px-3 py-2.5 text-sm font-medium text-slate-700 focus:border-slate-300 focus:outline-none focus:ring-0",
                       data: { action: "change->auto-submit#submit" } %>
        </div>

        <div class="flex items-center gap-2">
          <% if @query.present? || @room_assignment.present? %>
            <%= link_to "Clear", hotel_in_house_guests_path(current_hotel), class: "inline-flex items-center rounded-lg border border-slate-200 bg-white px-3 py-2 text-sm font-semibold text-slate-700 shadow-sm transition hover:border-slate-900 hover:bg-slate-50" %>
          <% end %>
        </div>
      <% end %>
    </div>

    <div class="hidden lg:block overflow-x-auto">
      <table class="min-w-full table-fixed">
        <colgroup>
          <col class="w-[18%]">
          <col class="w-[19%]">
          <col class="w-[14%]">
          <col class="w-[14%]">
          <col class="w-[17%]">
          <col class="w-[18%]">
        </colgroup>
        <thead class="bg-slate-100">
          <tr>
            <th scope="col" class="px-6 py-4 text-left text-[11px] font-semibold uppercase tracking-[0.1em] text-slate-600 sm:px-8">Guest / Reference</th>
            <th scope="col" class="px-6 py-4 text-left text-[11px] font-semibold uppercase tracking-[0.1em] text-slate-600">Contact</th>
            <th scope="col" class="px-6 py-4 text-left text-[11px] font-semibold uppercase tracking-[0.1em] text-slate-600">Stay Dates</th>
            <th scope="col" class="px-6 py-4 text-left text-[11px] font-semibold uppercase tracking-[0.1em] text-slate-600">Checked In</th>
            <th scope="col" class="px-6 py-4 text-left text-[11px] font-semibold uppercase tracking-[0.1em] text-slate-600">Rooms</th>
            <th scope="col" class="px-6 py-4 text-right text-[11px] font-semibold uppercase tracking-[0.1em] text-slate-600 sm:px-8">Actions</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-200 bg-white">
          <% if @in_house_guests.any? %>
            <% @in_house_guests.each_with_index do |booking, index| %>
              <% presenter = HotelPortal::InHouseGuestPresenter.new(booking, current_user.time_zone) %>
              <tr class="align-top <%= presenter.blacklisted? ? 'bg-rose-100' : (index.even? ? 'bg-white hover:bg-slate-100/80 transition-colors' : 'bg-slate-50/55 hover:bg-slate-100/80 transition-colors') %>">
                <td class="py-4 pr-6 sm:pr-8 <%= presenter.blacklisted? ? 'border-l-4 border-l-rose-600 pl-5 sm:pl-7' : 'pl-6 sm:pl-8' %>">
                  <div class="flex flex-col gap-1.5">
                    <div class="flex items-center gap-2">
                      <div class="flex items-center gap-x-1.5">
                        <span class="text-sm font-semibold text-slate-900"><%= presenter.guest_name %></span>
                        <% if presenter.vip? %>
                          <%= cached_icon "crown-simple", library: "phosphor", variant: "duotone", class: "size-4 text-amber-500 fill-amber-500 shrink-0" %>
                        <% end %>
                        <% if presenter.blacklisted? %>
                          <div class="relative size-4 flex items-center justify-center shrink-0">
                            <%= cached_icon "user", library: "phosphor", variant: "light", class: "size-3.5 text-rose-600" %>
                            <%= cached_icon "ban", class: "absolute inset-0 size-4 text-rose-600" %>
                          </div>
                        <% end %>
                        <% if presenter.repeat? %>
                          <%= cached_icon "repeat", library: "lucide", variant: "outline", class: "size-4 text-blue-500 shrink-0" %>
                        <% end %>
                      </div>
                      <% if presenter.status == "review_due_out" || presenter.status == "checkout_required" %>
                        <span class="<%= presenter.status_badge_class %>"><%= presenter.status_label %></span>
                      <% end %>
                    </div>
                    <span class="text-xs font-mono text-slate-500"><%= presenter.confirmation_token %></span>
                  </div>
                </td>
                <td class="px-6 py-4">
                  <div class="flex flex-col gap-1">
                    <span class="text-sm text-slate-900"><%= presenter.guest_email %></span>
                    <span class="text-sm text-slate-600"><%= presenter.guest_phone %></span>
                  </div>
                </td>
                <td class="px-6 py-4 whitespace-nowrap">
                  <div class="flex flex-col gap-0.5">
                    <span class="text-sm font-medium text-slate-900"><%= presenter.check_in_formatted %></span>
                    <span class="text-xs text-slate-500">to <%= presenter.check_out_formatted %></span>
                  </div>
                </td>
                <td class="px-6 py-4 whitespace-nowrap">
                  <span class="text-sm font-medium text-slate-900"><%= presenter.checked_in_at_formatted %></span>
                </td>
                <td class="px-6 py-4">
                  <% if presenter.rooms_assigned? %>
                    <div class="flex flex-wrap gap-2">
                      <% presenter.rooms_summary.each do |room_summary_text| %>
                        <span class="inline-flex items-center rounded-full border border-slate-200 bg-slate-50 px-2.5 py-1 text-xs font-medium text-slate-700">
                          <%= room_summary_text %>
                        </span>
                      <% end %>
                    </div>
                  <% else %>
                    <span class="text-sm text-slate-400">No rooms assigned</span>
                  <% end %>
                </td>
                <td class="px-6 py-4 text-right whitespace-nowrap sm:px-8">
                  <div class="inline-flex items-center gap-2">
                    <%= link_to "View booking", hotel_booking_path(current_hotel, presenter.booking), class: "inline-flex items-center rounded-lg border border-slate-200 bg-white px-3 py-1.5 text-xs font-semibold text-slate-700 shadow-sm transition hover:border-slate-900 hover:bg-slate-50" %>
                    <% if presenter.status == "review_due_out" %>
                      <%= link_to "Review late checkout", hotel_booking_transaction_late_checkout_path(current_hotel, presenter.booking), data: { turbo_frame: "offcanvas_drawer", offcanvas_variant: "right" }, class: "inline-flex items-center rounded-lg bg-amber-600 px-3 py-1.5 text-xs font-semibold text-white shadow-sm transition hover:bg-amber-700" %>
                    <% elsif presenter.status == "checkout_required" %>
                      <%= link_to "Complete checkout", hotel_booking_transaction_check_out_path(current_hotel, presenter.booking), data: { turbo_frame: "offcanvas_drawer", offcanvas_variant: "fullscreen-bottom" }, class: "inline-flex items-center rounded-lg bg-slate-900 px-3 py-1.5 text-xs font-semibold text-white shadow-sm transition hover:bg-slate-700" %>
                    <% else %>
                      <%= button_to "Check out",
                                    check_out_hotel_booking_path(current_hotel, presenter.booking),
                                    method: :post,
                                    class: "inline-flex items-center rounded-lg bg-slate-900 px-3 py-1.5 text-xs font-semibold text-white shadow-sm transition hover:bg-slate-700",
                                    data: { turbo_confirm: "Are you sure you want to check out this guest?" } %>
                    <% end %>
                  </div>
                </td>
              </tr>
            <% end %>
          <% else %>
            <tr>
              <td colspan="6" class="px-6 py-12 text-center sm:px-8">
                <% if @query.present? && @in_house_count.positive? %>
                  <p class="text-sm font-medium text-slate-500">No current in-house stays matched your search.</p>
                  <p class="mt-1 text-sm text-slate-500">Try a different guest name, contact detail, or booking reference.</p>
                <% else %>
                  <p class="text-sm font-medium text-slate-500">No guests are currently checked in.</p>
                  <p class="mt-1 text-sm text-slate-500">Try adjusting your search or check back after the next arrival is checked in.</p>
                <% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>

    <div class="space-y-4 p-4 sm:p-6 lg:hidden">
      <% if @in_house_guests.any? %>
        <% @in_house_guests.each do |booking| %>
          <% presenter = HotelPortal::InHouseGuestPresenter.new(booking, current_user.time_zone) %>
          <div class="rounded-2xl border border-slate-200 p-4 shadow-sm <%= presenter.blacklisted? ? 'bg-rose-100 border-t-4 border-t-rose-600 pt-3' : 'bg-slate-50/60' %>">
            <div class="flex items-start justify-between gap-3">
              <div>
                <p class="text-xs font-semibold uppercase tracking-[0.08em] text-slate-500">Guest</p>
                <div class="flex items-center gap-x-1.5 mt-1">
                  <p class="text-sm font-semibold text-slate-900"><%= presenter.guest_name %></p>
                  <% if presenter.vip? %>
                    <%= cached_icon "crown-simple", library: "phosphor", variant: "duotone", class: "size-4 text-amber-500 fill-amber-500 shrink-0" %>
                  <% end %>
                  <% if presenter.blacklisted? %>
                    <div class="relative size-4 flex items-center justify-center shrink-0">
                      <%= cached_icon "user", library: "phosphor", variant: "light", class: "size-3.5 text-rose-600" %>
                      <%= cached_icon "ban", class: "absolute inset-0 size-4 text-rose-600" %>
                    </div>
                  <% end %>
                  <% if presenter.repeat? %>
                    <%= cached_icon "repeat", library: "lucide", variant: "outline", class: "size-4 text-blue-500 shrink-0" %>
                  <% end %>
                </div>
                <p class="mt-1 text-xs font-mono text-slate-500"><%= presenter.confirmation_token %></p>
              </div>
              <span class="<%= presenter.mobile_status_badge_class %>"><%= presenter.mobile_status_label %></span>
            </div>

            <dl class="mt-4 space-y-3 text-sm">
              <div>
                <dt class="text-xs font-semibold uppercase tracking-[0.08em] text-slate-500">Contact</dt>
                <dd class="mt-1 text-slate-700"><%= presenter.guest_email %></dd>
                <dd class="text-slate-600"><%= presenter.guest_phone %></dd>
              </div>
              <div>
                <dt class="text-xs font-semibold uppercase tracking-[0.08em] text-slate-500">Stay Dates</dt>
                <dd class="mt-1 text-slate-700"><%= presenter.check_in_formatted %> to <%= presenter.check_out_formatted %></dd>
              </div>
              <div>
                <dt class="text-xs font-semibold uppercase tracking-[0.08em] text-slate-500">Checked In</dt>
                <dd class="mt-1 text-slate-700">
                  <span class="block font-medium text-slate-900"><%= presenter.checked_in_at_formatted %></span>
                </dd>
              </div>
              <div>
                <dt class="text-xs font-semibold uppercase tracking-[0.08em] text-slate-500">Rooms</dt>
                <dd class="mt-1 flex flex-wrap gap-1.5">
                  <% if presenter.rooms_assigned? %>
                    <% presenter.rooms_summary.each do |room_summary_text| %>
                      <span class="inline-flex items-center rounded-full border border-slate-200 bg-white px-2 py-1 text-xs font-medium text-slate-700">
                        <%= room_summary_text %>
                      </span>
                    <% end %>
                  <% else %>
                    <span class="text-slate-400">No rooms assigned</span>
                  <% end %>
                </dd>
              </div>
            </dl>

            <div class="mt-4 flex items-center justify-end gap-2">
              <%= link_to "View booking", hotel_booking_path(current_hotel, presenter.booking), class: "inline-flex items-center rounded-lg border border-slate-200 bg-white px-3 py-1.5 text-xs font-semibold text-slate-700 shadow-sm transition hover:border-slate-900 hover:bg-slate-50" %>
              <% if presenter.status == "review_due_out" %>
                <%= link_to "Review late checkout", hotel_booking_transaction_late_checkout_path(current_hotel, presenter.booking), data: { turbo_frame: "offcanvas_drawer", offcanvas_variant: "right" }, class: "inline-flex items-center rounded-lg bg-amber-600 px-3 py-1.5 text-xs font-semibold text-white shadow-sm transition hover:bg-amber-700" %>
              <% elsif presenter.status == "checkout_required" %>
                <%= link_to "Complete checkout", hotel_booking_transaction_check_out_path(current_hotel, presenter.booking), data: { turbo_frame: "offcanvas_drawer", offcanvas_variant: "fullscreen-bottom" }, class: "inline-flex items-center rounded-lg bg-slate-900 px-3 py-1.5 text-xs font-semibold text-white shadow-sm transition hover:bg-slate-700" %>
              <% else %>
                <%= button_to "Check out",
                              check_out_hotel_booking_path(current_hotel, presenter.booking),
                              method: :post,
                              class: "inline-flex items-center rounded-lg bg-slate-900 px-3 py-1.5 text-xs font-semibold text-white shadow-sm transition hover:bg-slate-700",
                              data: { turbo_confirm: "Are you sure you want to check out this guest?" } %>
              <% end %>
            </div>
          </div>
        <% end %>
      <% else %>
        <div class="rounded-2xl border border-dashed border-slate-300 bg-white px-5 py-10 text-center shadow-sm">
          <% if @query.present? && @in_house_count.positive? %>
            <p class="text-sm font-medium text-slate-500">No current in-house stays matched your search.</p>
            <p class="mt-1 text-sm text-slate-500">Try a different guest name, contact detail, or booking reference.</p>
          <% else %>
            <p class="text-sm font-medium text-slate-500">No guests are currently checked in.</p>
            <p class="mt-1 text-sm text-slate-500">Try adjusting your search or check back after the next arrival is checked in.</p>
          <% end %>
        </div>
      <% end %>
    </div>

    <div class="px-6 py-5 border-t border-slate-200 bg-slate-50/50 flex justify-center sm:px-8">
      <%= paginate @in_house_guests %>
    </div>
  </div>
</div>
