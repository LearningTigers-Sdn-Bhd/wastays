<button
  type="button"
  class="text-muted-foreground transition hover:text-brand-primary"
  data-password-toggle-target="button"
  data-action="click->password-toggle#toggle"
  aria-label="Show value"
  aria-pressed="false"
>
  <%= cached_icon "eye", stroke_width: 2, class: "size-4", data: { password_toggle_target: "showIcon" } %>
  <%= cached_icon "eye-off", stroke_width: 2, class: "hidden size-4", data: { password_toggle_target: "hideIcon" } %>
</button>
