<% rate_plans = @presenter.rate_plans.reject { |rp| rp.special_tier_kind == :walk_in && @hotel.pax_pricing_only? } %>

<section aria-labelledby="rate-plans-heading" class="space-y-3">
  <div class="flex flex-col gap-3 sm:flex-row sm:items-start sm:justify-between">
    <div>
      <h2 id="rate-plans-heading" class="text-base font-semibold text-foreground">Rate plans</h2>
      <p class="mt-1 text-sm text-muted-foreground">Configure how guest rates are calculated from occupancy, extra guests, and children.</p>
    </div>
    <%= render PanelsUI::Button.new(href: new_hotel_rate_plan_path(@hotel), size: :sm, class: "shrink-0",
          data: { turbo_frame: "settings_action_sheet" }) do %>
      <%= app_icon "plus", class: "size-4", aria: { hidden: true } %>
      New rate plan
    <% end %>
  </div>

  <%= render PanelsUI::Table.new(caption: "Rate plans", header_style: :sentence, striped: true,
        hoverable: true, bordered: true, wrapper_class: "rounded-md border border-border bg-card",
        class: "min-w-[820px]", data: { testid: "rate-plans-registry" }) do |table| %>
    <% table.with_header do %>
      <tr>
        <th>Name</th>
        <th>Sell mode</th>
        <th>Currency</th>
        <th>Room categories</th>
        <th class="text-right">Action</th>
      </tr>
    <% end %>
    <% table.with_body do %>
      <% rate_plans.each do |rate_plan| %>
        <tr id="rate-plan-row-<%= rate_plan.id %>" class="<%= "opacity-60" if rate_plan.archived? %>">
          <td>
            <div class="flex items-center gap-2">
              <span class="font-medium text-foreground"><%= rate_plan.name %></span>
              <% if rate_plan.archived? %>
                <%= render PanelsUI::Badge.new(label: "Archived", variant: :warning, size: :sm) %>
              <% elsif rate_plan.special_tier? %>
                <%= render PanelsUI::Badge.new(label: "Virtual tier", variant: :neutral, size: :sm) %>
              <% elsif rate_plan.standard_rate? %>
                <%= render PanelsUI::Badge.new(label: "System default", variant: :info, size: :sm) %>
              <% end %>
            </div>
          </td>
          <td class="text-muted-foreground"><%= rate_plan.sell_mode == "per_person" ? "Per person" : "Per room" %></td>
          <td class="text-muted-foreground" translate="no"><%= rate_plan.currency %></td>
          <td class="text-muted-foreground">
            <% if rate_plan.room_types.any? %>
              <%= rate_plan.room_types.map(&:name).join(", ") %>
            <% else %>
              None assigned
            <% end %>
          </td>
          <td class="text-right">
            <div class="inline-flex items-center gap-2">
              <% if rate_plan.archived? %>
                <%= render PanelsUI::Button.new(href: unarchive_hotel_rate_plan_path(@hotel, rate_plan),
                      variant: :ghost, size: :xs,
                      data: { turbo_method: :patch, turbo_frame: "_top" }) do %>
                  Unarchive
                <% end %>
              <% elsif rate_plan.archivable? %>
                <%= render PanelsUI::Button.new(href: archive_hotel_rate_plan_path(@hotel, rate_plan),
                      variant: :ghost, size: :xs,
                      data: {
                        turbo_method: :patch,
                        turbo_frame: "_top",
                        turbo_confirm: "Archive '#{rate_plan.name}'? It will no longer be offered for new bookings, but existing bookings and history are kept. You can unarchive it anytime.",
                        turbo_confirm_title: "Archive rate plan"
                      }) do %>
                  Archive
                <% end %>
              <% end %>
              <%= render PanelsUI::Button.new(href: edit_hotel_rate_plan_path(@hotel, rate_plan),
                    variant: :secondary, size: :xs,
                    data: { turbo_frame: "settings_action_sheet" }) do %>
                Manage
              <% end %>
            </div>
          </td>
        </tr>
      <% end %>
      <% if rate_plans.empty? %>
        <tr><td colspan="5" class="py-8 text-center text-sm text-muted-foreground">No rate plans are configured.</td></tr>
      <% end %>
    <% end %>
  <% end %>
</section>
