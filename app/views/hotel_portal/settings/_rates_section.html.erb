<section class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">
  <div class="flex items-start justify-between gap-4 border-b border-slate-200 px-6 py-5 sm:px-8">
    <div>
      <h2 class="text-lg font-bold tracking-tight text-slate-950 sm:text-xl">Rate Settings & Per-Pax Rules</h2>
      <p class="mt-1 text-sm font-medium text-slate-600">Configure how guest rates are calculated based on occupancy, extra guests, and children.</p>
    </div>
    <%= link_to new_hotel_rate_plan_path(@hotel),
        data: { turbo_frame: "offcanvas_drawer", offcanvas_variant: "right" },
        class: "inline-flex shrink-0 items-center gap-2 rounded-lg bg-slate-900 px-3 py-2 text-sm font-bold text-white transition hover:bg-slate-700",
        aria: { label: "New rate plan" } do %>
      <%= cached_icon "plus", class: "size-4" %>
      <span class="hidden sm:inline">New Rate Plan</span>
    <% end %>
  </div>

  <% rate_plans = @presenter.rate_plans.reject { |rp| rp.special_tier_kind == :walk_in && @hotel.pax_pricing_only? } %>

  <div class="hidden overflow-x-auto md:block">
    <table class="w-full min-w-[820px] text-left text-sm">
      <thead class="border-b border-slate-200 bg-slate-50 text-xs font-bold uppercase tracking-wider text-slate-500">
        <tr>
          <th class="px-6 py-3">Name</th>
          <th class="px-6 py-3">Sell Mode</th>
          <th class="px-6 py-3">Currency</th>
          <th class="px-6 py-3">Room Categories</th>
          <th class="px-6 py-3 text-right">Action</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-slate-100">
        <% if rate_plans.empty? %>
          <tr>
            <td colspan="5" class="px-6 py-8 text-center text-sm font-medium text-slate-400">No rate plans configured yet.</td>
          </tr>
        <% else %>
          <% rate_plans.each do |rate_plan| %>
            <tr>
              <td class="px-6 py-4">
                <div class="flex items-center gap-x-2">
                  <p class="font-semibold text-slate-950"><%= rate_plan.name %></p>
                  <% if rate_plan.special_tier? %>
                    <span class="inline-flex items-center rounded bg-slate-100 px-1.5 py-0.5 text-[10px] font-medium text-slate-600">Virtual Tier</span>
                  <% elsif rate_plan.standard_rate? %>
                    <span class="inline-flex items-center rounded bg-indigo-50 px-1.5 py-0.5 text-[10px] font-medium text-indigo-700">System Default</span>
                  <% end %>
                </div>
              </td>
              <td class="px-6 py-4 text-slate-600">
                <%= rate_plan.sell_mode == "per_person" ? "Per Person" : "Per Room" %>
              </td>
              <td class="px-6 py-4 text-slate-600"><%= rate_plan.currency %></td>
              <td class="px-6 py-4 text-slate-600">
                <% if rate_plan.room_types.any? %>
                  <%= rate_plan.room_types.map(&:name).join(", ") %>
                <% else %>
                  <span class="text-slate-400">None assigned</span>
                <% end %>
              </td>
              <td class="px-6 py-4 text-right">
                <%= link_to edit_hotel_rate_plan_path(@hotel, rate_plan),
                    data: { turbo_frame: "offcanvas_drawer", offcanvas_variant: "right" },
                    class: "inline-flex items-center gap-1 rounded-lg border border-slate-200 px-3 py-1.5 text-xs font-bold text-slate-700 transition hover:bg-slate-50" do %>
                  <%= cached_icon "pencil", class: "size-3.5", aria: { hidden: true } %>
                  Edit
                <% end %>
              </td>
            </tr>
          <% end %>
        <% end %>
      </tbody>
    </table>
  </div>

  <div class="divide-y divide-slate-100 md:hidden">
    <% if rate_plans.empty? %>
      <div class="px-6 py-8 text-center text-sm font-medium text-slate-400">No rate plans configured yet.</div>
    <% else %>
      <% rate_plans.each do |rate_plan| %>
        <article class="p-5">
          <div class="flex items-start justify-between gap-4">
            <div>
              <div class="flex items-center gap-x-2">
                <p class="font-semibold text-slate-950"><%= rate_plan.name %></p>
                <% if rate_plan.special_tier? %>
                  <span class="inline-flex items-center rounded bg-slate-100 px-1.5 py-0.5 text-[10px] font-medium text-slate-600">Virtual Tier</span>
                <% elsif rate_plan.standard_rate? %>
                  <span class="inline-flex items-center rounded bg-indigo-50 px-1.5 py-0.5 text-[10px] font-medium text-indigo-700">System Default</span>
                <% end %>
              </div>
              <p class="mt-1 text-sm font-medium text-slate-500">
                <%= rate_plan.sell_mode == "per_person" ? "Per Person" : "Per Room" %> · <%= rate_plan.currency %>
              </p>
            </div>
          </div>

          <div class="mt-4 space-y-1">
            <p class="text-xs font-bold uppercase tracking-wider text-slate-400">Room Categories</p>
            <p class="text-sm font-medium text-slate-600">
              <% if rate_plan.room_types.any? %>
                <%= rate_plan.room_types.map(&:name).join(", ") %>
              <% else %>
                <span class="text-slate-400">None assigned</span>
              <% end %>
            </p>
          </div>

          <div class="mt-4 flex justify-end">
            <%= link_to edit_hotel_rate_plan_path(@hotel, rate_plan),
                data: { turbo_frame: "offcanvas_drawer", offcanvas_variant: "right" },
                class: "inline-flex items-center gap-1 rounded-lg border border-slate-200 px-3 py-1.5 text-xs font-bold text-slate-700 transition hover:bg-slate-50" do %>
              <%= cached_icon "pencil", class: "size-3.5", aria: { hidden: true } %>
              Edit
            <% end %>
          </div>
        </article>
      <% end %>
    <% end %>
  </div>
</section>
