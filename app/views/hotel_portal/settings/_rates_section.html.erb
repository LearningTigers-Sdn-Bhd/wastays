<% rate_plans = @presenter.rate_plans.reject { |rp| rp.special_tier_kind == :walk_in && @hotel.pax_pricing_only? } %>
<%# Two shapes share this page. A standard plan is created automatically with its
    room category and stays bound to it; everything else is a product the hotelier
    composes across categories. Splitting them keeps the system rows from burying
    the composed ones on properties with many room categories. %>
<% standard_plans, composed_plans = rate_plans.partition(&:standard_rate?) %>
<% active_view = params[:view].to_s == "standard" ? "standard" : "plans" %>

<section aria-labelledby="rate-plans-heading" class="space-y-4">
  <div class="flex flex-col gap-3 sm:flex-row sm:items-start sm:justify-between">
    <div>
      <h2 id="rate-plans-heading" class="text-base font-semibold text-foreground">Rate plans</h2>
      <p class="mt-1 text-sm text-muted-foreground">Configure how guest rates are calculated from occupancy, extra guests, and children.</p>
    </div>
    <%= render PanelsUI::Button.new(href: new_hotel_rate_plan_path(@hotel), size: :sm, class: "shrink-0",
          data: { turbo_frame: "settings_action_sheet" }) do %>
      <%= app_icon "plus", class: "size-4", aria: { hidden: true } %>
      New rate plan
    <% end %>
  </div>

  <%= render PanelsUI::Tabs.new(id: "rate-plan-views", active: active_view, aria_label: "Rate plan types") do |tabs| %>
    <% tabs.with_tab(name: "plans", label: "Rate plans", icon: "badge-dollar-sign",
                     count: composed_plans.size,
                     href: hotel_rates_settings_path(@hotel, view: "plans")) %>
    <% tabs.with_tab(name: "standard", label: "Standard rates", icon: "bed",
                     count: standard_plans.size,
                     href: hotel_rates_settings_path(@hotel, view: "standard")) %>
  <% end %>

  <% if active_view == "standard" %>
    <p class="text-sm text-muted-foreground">
      One per room category, created automatically when you add the category. Each holds that room&rsquo;s anchor price
      and its occupancy rules; the nightly figures are set in Planning &amp; Inventory.
    </p>
    <%= render "hotel_portal/settings/rate_plan_table",
          rate_plans: standard_plans,
          caption: "Standard rates",
          testid: "standard-rates-registry",
          qualify_names: true,
          empty_message: "No room categories yet. Add one under Settings → Property → Room Categories." %>
  <% else %>
    <p class="text-sm text-muted-foreground">
      Products you sell across one or more room categories &mdash; packages, board basis, non-refundable fares.
    </p>
    <%= render "hotel_portal/settings/rate_plan_table",
          rate_plans: composed_plans,
          caption: "Rate plans",
          testid: "rate-plans-registry",
          empty_message: "No rate plans yet. Create one to sell a package or board basis across your room categories." %>
  <% end %>
</section>
