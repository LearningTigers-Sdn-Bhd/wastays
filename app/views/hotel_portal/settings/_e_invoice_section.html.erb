<%= form_with model: @e_invoice_setting,
              url: hotel_e_invoice_settings_path(@hotel),
              method: :patch,
              local: true,
              scope: :e_invoice_setting,
              class: "grid grid-cols-1 gap-x-8 gap-y-10 lg:grid-cols-2 lg:items-start" do |f| %>
  <% if @e_invoice_setting.errors.any? %>
    <div class="lg:col-span-2">
      <%= render PanelsUI::Alert.new(
            tone: :destructive,
            title: pluralize(@e_invoice_setting.errors.count, "error") + " prevented these settings from being saved",
            role: :alert) do |alert| %>
        <% alert.with_description do %>
          <ul class="list-disc space-y-1 ps-5">
            <% @e_invoice_setting.errors.full_messages.each do |message| %>
              <li><%= message %></li>
            <% end %>
          </ul>
        <% end %>
      <% end %>
    </div>
  <% end %>

  <section aria-labelledby="e-invoice-status-heading">
    <div>
      <h2 id="e-invoice-status-heading" class="text-base font-semibold text-foreground">LHDN E-Invoicing</h2>
      <p class="mt-2 text-sm text-muted-foreground">
        This hotel files its own e-invoices to LHDN through MyInvois, under its own tax registration, using the
        credentials below. Guests may request one within the same calendar month as their payment; anything
        unrequested and under RM10,000 goes out in the monthly consolidated batch.
      </p>
    </div>

    <div class="mt-4 space-y-4" data-controller="e-invoice-settings">
      <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
        <%= render PanelsUI::Switch.new(
              form: f,
              attribute: :enabled,
              variant: :card,
              label: "Enable e-invoicing",
              description: "Turn this on before your team sends the first record to LHDN.") %>
      </div>

      <%#
        Digital signing (document version 1.1) is deliberately hidden from this
        form for now - it does not work yet. Confirmed live against LHDN
        preprod on 2026-08-20: a signed submission is rejected at the
        signature-parsing step (Step08-Document Signature Validator, DS300
        "Failed to parse input document"). The cause is understood - see the
        comments in EInvoice::DocumentSigner and
        https://sdk.myinvois.hasil.gov.my/signature-creation-json/ - it needs
        a near-full rewrite of that class (the SignedProperties block is
        missing entirely, and both digests plus the final signature are
        computed over the wrong bytes), which is cryptographically sensitive
        enough to deserve its own careful pass rather than a quick patch.

        `signature_enabled`, `signing_certificate` and `signing_private_key`
        still exist on EInvoiceSetting and DocumentSigner still branches on
        them - nothing there was removed, only this form's ability to turn
        signing on. Unsigned version 1.0 documents are unaffected and are
        what LHDN accepts today regardless. Once DocumentSigner is fixed and
        re-verified live, restore the "Sign documents digitally" Switch (see
        git history for this file around 2026-08-20 for the removed markup)
        and its two signing_certificate / signing_private_key FormFields.
      %>

      <%= render PanelsUI::FormField.new(
            form: f,
            attribute: :api_environment,
            label: "LHDN environment",
            hint: "Use sandbox until the connection is proven, then switch to production.") do |field| %>
        <% field.with_native_select(
             EInvoiceSetting::API_ENVIRONMENTS.map { |value| [ value.titleize, value ] },
             data: {
               e_invoice_settings_target: "environmentSelect",
               action: "change->e-invoice-settings#toggleProductionWarning"
             }) %>
      <% end %>

      <%#
        Shown only when "production" is selected - switching here means every
        submission from this point on files a real e-invoice with LHDN, not a
        sandbox one. The checkbox is enforced server-side in
        HotelPortal::EInvoiceSettingsForm#save regardless of whether this JS
        ran, so it can't be bypassed by skipping the UI.
      %>
      <div
        class="lg:col-span-2 rounded-lg border border-amber-300 bg-amber-50 p-4"
        data-e-invoice-settings-target="productionWarning"
        hidden>
        <p class="text-sm font-medium text-amber-900">This switches the hotel to production</p>
        <p class="mt-1 text-sm text-amber-800">
          Every e-invoice this hotel submits from now on goes to the real LHDN tax authority, not the sandbox.
          Confirm this hotel's credentials and details have already been proven working in sandbox.
        </p>
        <label class="mt-3 flex items-start gap-2 text-sm font-medium text-amber-900">
          <%= check_box_tag "e_invoice_setting[confirm_production]", "1", false,
                id: "e_invoice_setting_confirm_production",
                class: "mt-0.5",
                data: { e_invoice_settings_target: "confirmProductionCheckbox" } %>
          I understand this hotel will file real e-invoices with LHDN.
        </label>
      </div>

      <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
        <%= render PanelsUI::FormField.new(
              form: f,
              attribute: :client_id,
              label: "MyInvois client ID",
              hint: "From this hotel's own LHDN MyInvois account.") do |field| %>
          <% field.with_input(autocomplete: "off") %>
        <% end %>

        <%= render PanelsUI::FormField.new(
              form: f,
              attribute: :client_secret,
              label: "MyInvois client secret",
              hint: @e_invoice_setting.client_secret.present? ? "Saved. Leave blank to keep the current secret." : "Stored encrypted.") do |field| %>
          <% field.with_input(type: "password", value: nil, autocomplete: "off", placeholder: @e_invoice_setting.client_secret.present? ? "••••••••" : nil) %>
        <% end %>
      </div>

      <div class="rounded-lg border border-gray-200 p-4 text-sm text-gray-600" data-controller="tin-validation" data-tin-validation-url-value="<%= hotel_validate_tin_path(@e_invoice_setting.hotel) %>">
        <p class="font-medium text-gray-900">Hotel TIN, BRN and SST registration number</p>
        <p class="mt-1">
          These are filed exactly as entered on the hotel's own
          <%= link_to "profile", edit_hotel_profile_path(@e_invoice_setting.hotel), class: "text-primary-600 underline" %>
          (TIN, BRN) and
          <%= link_to "taxes & fees", hotel_taxes_fees_path(@e_invoice_setting.hotel), class: "text-primary-600 underline" %>
          (SST) settings, so there is one number on file, not two that can disagree.
        </p>
        <dl class="mt-3 grid grid-cols-1 gap-2 sm:grid-cols-3">
          <div>
            <dt class="text-gray-500">TIN</dt>
            <dd class="font-mono text-gray-900"><%= @e_invoice_setting.hotel_tin.presence || "Not set" %></dd>
          </div>
          <div>
            <dt class="text-gray-500">BRN</dt>
            <dd class="font-mono text-gray-900"><%= @e_invoice_setting.hotel_brn.presence || "Not set" %></dd>
          </div>
          <div>
            <dt class="text-gray-500">SST registration number</dt>
            <dd class="font-mono text-gray-900"><%= @e_invoice_setting.supplier_sst_registration_number.presence || "Not registered" %></dd>
          </div>
        </dl>

        <%# Hidden inputs feed the shared tin-validation Stimulus controller (also used on the guest form) the values it needs; the button below fires it on demand instead of on blur. %>
        <input type="hidden" data-tin-validation-target="tin" value="<%= @e_invoice_setting.hotel_tin %>">
        <input type="hidden" data-tin-validation-target="idValue" value="<%= @e_invoice_setting.hotel_brn %>">
        <input type="hidden" data-tin-validation-target="documentType" value="brn">

        <% if @e_invoice_setting.api_credentials_ready? && @e_invoice_setting.hotel_tin.present? && @e_invoice_setting.hotel_brn.present? %>
          <button type="button"
                  class="mt-3 rounded-md border border-gray-300 bg-white px-3 py-1.5 text-xs font-semibold text-gray-700 hover:bg-gray-50"
                  data-action="click->tin-validation#forceCheck">
            Test connection
          </button>
          <p data-tin-validation-target="feedback" class="mt-2 text-xs text-muted-foreground" hidden></p>
        <% else %>
          <p class="mt-3 text-xs text-gray-500">Save a client ID, client secret, TIN and BRN first to test the connection.</p>
        <% end %>
      </div>

      <%= render PanelsUI::FormField.new(form: f, attribute: :supplier_msic_code, label: "MSIC code", hint: "Industry classification code, e.g. 55101 for hotels.") do |field| %>
        <% field.with_input(autocomplete: "off") %>
      <% end %>

      <%= render PanelsUI::FormField.new(form: f, attribute: :supplier_business_description, label: "Business activity description") do |field| %>
        <% field.with_input(autocomplete: "off") %>
      <% end %>
    </div>
  </section>

  <section aria-labelledby="e-invoice-address-heading">
    <div>
      <h2 id="e-invoice-address-heading" class="text-base font-semibold text-foreground">Supplier address &amp; contact</h2>
      <p class="mt-2 text-sm text-muted-foreground">LHDN requires the supplier address on every submitted document.</p>
    </div>

    <div class="mt-4 space-y-4">
      <%= render PanelsUI::FormField.new(form: f, attribute: :supplier_address_line1, label: "Address line 1") do |field| %>
        <% field.with_input(autocomplete: "address-line1") %>
      <% end %>

      <%= render PanelsUI::FormField.new(form: f, attribute: :supplier_address_line2, label: "Address line 2") do |field| %>
        <% field.with_input(autocomplete: "address-line2") %>
      <% end %>

      <div class="grid grid-cols-2 gap-4 xl:grid-cols-4">
        <%= render PanelsUI::FormField.new(form: f, attribute: :supplier_city, label: "City") do |field| %>
          <% field.with_input(autocomplete: "address-level2") %>
        <% end %>

        <%= render PanelsUI::FormField.new(form: f, attribute: :supplier_postal_code, label: "Postal code") do |field| %>
          <% field.with_input(inputmode: "numeric", autocomplete: "postal-code") %>
        <% end %>

        <%# A free-text field here let a typo through to a real LHDN submission -
            this is now the same code list EInvoice::MalaysiaStates validates
            against, so an invalid state simply cannot be selected. %>
        <%= render PanelsUI::FormField.new(form: f, attribute: :supplier_state_code, label: "State") do |field| %>
          <% field.with_native_select(EInvoice::MalaysiaStates.options, include_blank: "Select a state") %>
        <% end %>

        <%# Every hotel on this platform is a Malaysian entity (see
            EInvoiceSetting::COUNTRY_CODE_MAP), so this is shown rather than
            typed - EInvoiceSetting#supplier_country_code_value already
            resolves it, and supplier_country_code is no longer a permitted
            form param (see EInvoiceSettingsForm). If WAStays ever operates
            in another country, make this editable again then. %>
        <div>
          <p class="text-xs font-medium text-muted-foreground">Country code</p>
          <p class="mt-1 font-mono text-sm text-foreground"><%= @e_invoice_setting.supplier_country_code_value %></p>
        </div>
      </div>

      <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
        <%= render PanelsUI::FormField.new(form: f, attribute: :supplier_contact_phone, label: "Contact phone") do |field| %>
          <% field.with_input(type: "tel", autocomplete: "tel") %>
        <% end %>

        <%= render PanelsUI::FormField.new(form: f, attribute: :supplier_contact_email, label: "Contact email") do |field| %>
          <% field.with_input(type: "email", autocomplete: "email") %>
        <% end %>
      </div>
    </div>
  </section>

  <div class="flex justify-end lg:col-span-2">
    <%= render PanelsUI::Button.new(as: :button, type: :submit, data: { turbo_submits_with: "Saving…" }) do %>Save changes<% end %>
  </div>
<% end %>
