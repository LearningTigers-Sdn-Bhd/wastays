<div class="max-w-5xl mx-auto py-10 px-4 sm:px-6 lg:px-8">
  <div class="mb-5">
    <%= link_to hotel_settings_path, class: "inline-flex items-center gap-x-1.5 text-sm text-gray-600 hover:text-blue-600" do %>
      <svg class="flex-shrink-0 size-4" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg>
      Back to Settings
    <% end %>
  </div>

  <div class="bg-white border rounded-xl shadow-xl p-4 sm:p-7">
    <div class="mb-8">
      <h2 class="text-2xl font-bold text-gray-800">Edit Settings</h2>
    </div>

    <%= form_with model: @property_policy, url: hotel_settings_path, method: :patch, local: true do |f| %>
      <div class="grid gap-y-6">
        <div class="grid grid-cols-2 gap-4">
          <div>
            <%= f.label :check_in_time, "Check-in Time", class: "block text-sm mb-2 font-medium" %>
            <%= f.text_field :check_in_time, class: "py-3 px-4 block w-full border rounded-lg text-sm focus:border-blue-500 focus:ring-blue-500", required: true, placeholder: "e.g. 2:00 PM" %>
          </div>
          <div>
            <%= f.label :check_out_time, "Check-out Time", class: "block text-sm mb-2 font-medium" %>
            <%= f.text_field :check_out_time, class: "py-3 px-4 block w-full border rounded-lg text-sm focus:border-blue-500 focus:ring-blue-500", required: true, placeholder: "e.g. 12:00 PM" %>
          </div>
        </div>

        <div class="grid grid-cols-2 gap-4">
          <div>
            <%= f.label :currency, "Currency", class: "block text-sm mb-2 font-medium" %>
            <%= f.select :currency, options_for_select([["MYR", "MYR"], ["USD", "USD"], ["SGD", "SGD"], ["THB", "THB"], ["IDR", "IDR"]], @property_policy.currency.presence || "MYR"), {}, class: "py-3 px-4 block w-full border rounded-lg text-sm focus:border-blue-500 focus:ring-blue-500" %>
          </div>
          <div>
            <%= f.label :usd_rate, "USD Rate", class: "block text-sm mb-2 font-medium" %>
            <%= f.number_field :usd_rate, step: 0.0001, value: (@property_policy.usd_rate || 0.21), class: "py-3 px-4 block w-full border rounded-lg text-sm focus:border-blue-500 focus:ring-blue-500", required: true %>
          </div>
        </div>

        <div class="mt-5 flex items-center justify-end gap-3">
          <%= link_to "Cancel", hotel_settings_path, class: "py-3 px-4 inline-flex justify-center items-center gap-x-2 text-sm font-semibold rounded-lg border border-gray-200 bg-white text-gray-800 hover:bg-gray-50" %>
          <%= f.submit "Save Settings", class: "py-3 px-4 inline-flex justify-center items-center gap-x-2 text-sm font-semibold rounded-lg border border-transparent bg-blue-600 text-white hover:bg-blue-700 disabled:opacity-50 disabled:pointer-events-none" %>
        </div>
      </div>
    <% end %>
  </div>
</div>
