<div class="max-w-5xl mx-auto py-10 px-4 sm:px-6 lg:px-8">
  <div class="mb-5">
    <%= link_to hotel_settings_path, class: "inline-flex items-center gap-x-1.5 text-sm text-gray-600 hover:text-blue-600" do %>
      <svg class="flex-shrink-0 size-4" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg>
      Back to Settings
    <% end %>
  </div>

  <div class="bg-white border rounded-xl shadow-xl p-4 sm:p-7">
    <div class="mb-8">
      <h2 class="text-2xl font-bold text-gray-800">Edit Settings</h2>
    </div>

    <%= form_with model: @hotel, url: hotel_settings_path, method: :patch, local: true do |f| %>
      <div class="grid gap-y-8">
        <!-- Check-in / Check-out Section -->
        <div class="space-y-4">
          <h3 class="text-sm font-bold uppercase tracking-wider text-slate-500">Operation Times</h3>
          
          <div class="grid gap-6 md:grid-cols-2">
            <%= f.fields_for :property_policy, @property_policy do |pp| %>
              <!-- Check-in Time -->
              <div data-controller="time-picker" data-time-picker-next-field-selector-value="#check-out-dropdown" class="relative">
                <%= pp.label :check_in_time, "Standard Check-in", class: "block text-sm mb-2 font-semibold text-slate-700" %>
                
                <div class="relative">
                  <input type="text" 
                         data-time-picker-target="input"
                         data-action="click->time-picker#toggle"
                         class="w-full rounded-xl border border-slate-200 bg-white px-4 py-3 text-lg font-bold text-slate-900 focus:border-blue-400 focus:outline-none focus:ring-4 focus:ring-blue-50 cursor-pointer transition-all"
                         readonly
                         value="<%= @property_policy.check_in_time %>">
                  
                  <%= pp.hidden_field :check_in_time, data: { time_picker_target: "hiddenInput" } %>

                  <div data-time-picker-target="dropdown" 
                       class="absolute z-[100] hidden w-full overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-2xl ring-1 ring-slate-900/5 mt-2">
                    <div class="flex h-[240px]">
                      <!-- Hours Column -->
                      <div class="flex-1 overflow-y-auto custom-scrollbar border-r border-slate-100 p-1">
                        <div class="px-2 py-1 text-[10px] font-black uppercase text-slate-400">Hour</div>
                        <% (0..23).each do |h| %>
                          <% label = Time.current.change(hour: h).strftime("%I %p") %>
                          <button type="button" 
                                  data-time-picker-target="hour"
                                  data-action="click->time-picker#selectHour"
                                  data-value="<%= h %>"
                                  class="w-full rounded-lg px-3 py-2 text-left text-sm font-bold transition-colors">
                            <%= label %>
                          </button>
                        <% end %>
                      </div>
                      <!-- Minutes Column -->
                      <div class="w-[100px] overflow-y-auto custom-scrollbar p-1 bg-slate-50/50">
                        <div class="px-2 py-1 text-[10px] font-black uppercase text-slate-400">Min</div>
                        <% [0, 15, 30, 45].each do |m| %>
                          <button type="button" 
                                  data-time-picker-target="minute"
                                  data-action="click->time-picker#selectMinute"
                                  data-value="<%= m %>"
                                  class="w-full rounded-lg px-3 py-2 text-center text-sm font-bold transition-colors">
                            :<%= m.to_s.rjust(2, '0') %>
                          </button>
                        <% end %>
                      </div>
                    </div>
                  </div>
                </div>
              </div>

              <!-- Check-out Time -->
              <div id="check-out-dropdown" data-controller="time-picker" class="relative">
                <%= pp.label :check_out_time, "Standard Check-out", class: "block text-sm mb-2 font-semibold text-slate-700" %>
                
                <div class="relative">
                  <input type="text" 
                         data-time-picker-target="input"
                         data-action="click->time-picker#toggle"
                         class="w-full rounded-xl border border-slate-200 bg-white px-4 py-3 text-lg font-bold text-slate-900 focus:border-blue-400 focus:outline-none focus:ring-4 focus:ring-blue-50 cursor-pointer transition-all"
                         readonly
                         value="<%= @property_policy.check_out_time %>">
                  
                  <%= pp.hidden_field :check_out_time, data: { time_picker_target: "hiddenInput" } %>

                  <div data-time-picker-target="dropdown" 
                       class="absolute z-[100] hidden w-full overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-2xl ring-1 ring-slate-900/5 mt-2">
                    <div class="flex h-[240px]">
                      <!-- Hours Column -->
                      <div class="flex-1 overflow-y-auto custom-scrollbar border-r border-slate-100 p-1">
                        <div class="px-2 py-1 text-[10px] font-black uppercase text-slate-400">Hour</div>
                        <% (0..23).each do |h| %>
                          <% label = Time.current.change(hour: h).strftime("%I %p") %>
                          <button type="button" 
                                  data-time-picker-target="hour"
                                  data-action="click->time-picker#selectHour"
                                  data-value="<%= h %>"
                                  class="w-full rounded-lg px-3 py-2 text-left text-sm font-bold transition-colors">
                            <%= label %>
                          </button>
                        <% end %>
                      </div>
                      <!-- Minutes Column -->
                      <div class="w-[100px] overflow-y-auto custom-scrollbar p-1 bg-slate-50/50">
                        <div class="px-2 py-1 text-[10px] font-black uppercase text-slate-400">Min</div>
                        <% [0, 15, 30, 45].each do |m| %>
                          <button type="button" 
                                  data-time-picker-target="minute"
                                  data-action="click->time-picker#selectMinute"
                                  data-value="<%= m %>"
                                  class="w-full rounded-lg px-3 py-2 text-center text-sm font-bold transition-colors">
                            :<%= m.to_s.rjust(2, '0') %>
                          </button>
                        <% end %>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            <% end %>
          </div>
        </div>

        <!-- Localization Section -->
        <div class="space-y-4 pt-4 border-t border-slate-100">
          <h3 class="text-sm font-bold uppercase tracking-wider text-slate-500">Localization</h3>
          
          <div class="grid gap-6 md:grid-cols-2">
            <div data-controller="searchable-select">
              <%= f.label :time_zone, "Property Timezone", class: "block text-sm mb-2 font-semibold text-slate-700" %>
              <div class="relative group">
                <input type="text" 
                       data-searchable-select-target="input"
                       data-action="input->searchable-select#filter click->searchable-select#open"
                       class="w-full rounded-xl border border-slate-200 bg-white px-3 py-3 text-sm font-semibold text-slate-700 transition-all focus:border-blue-400 focus:outline-none focus:ring-4 focus:ring-blue-50"
                       placeholder="Search timezone (e.g. GMT, Kuala Lumpur...)"
                       autocomplete="off"
                       value="<%= @hotel.time_zone %>">
                
                <%= f.hidden_field :time_zone, data: { searchable_select_target: "hiddenInput" } %>

                <div data-searchable-select-target="options" 
                     class="absolute z-[100] hidden w-full overflow-hidden rounded-xl border border-slate-200 bg-white shadow-xl ring-1 ring-slate-900/5 mt-2">
                  <div class="max-height-[300px] overflow-y-auto p-1 custom-scrollbar" style="max-height: 300px;">
                    <% ActiveSupport::TimeZone.all.each do |tz| %>
                      <button type="button"
                              data-searchable-select-target="option"
                              data-action="click->searchable-select#select"
                              data-value="<%= tz.name %>"
                              data-label="<%= tz.to_s %>"
                              class="flex w-full items-center gap-3 rounded-lg px-3 py-2 text-left text-sm font-semibold text-slate-700 transition-colors hover:bg-slate-50 hover:text-slate-950">
                        <span class="truncate"><%= tz.to_s %></span>
                      </button>
                    <% end %>
                  </div>
                </div>
              </div>
              <p class="mt-2 text-[11px] font-medium text-slate-400 italic">This affects how your calendar and automated messages are triggered.</p>
            </div>

            <div>
              <%= f.label :default_currency, "Accounting Currency", class: "block text-sm mb-2 font-semibold text-slate-700" %>
              <div class="py-3 px-4 block w-full border border-slate-100 rounded-xl text-sm font-bold text-slate-900 bg-slate-50 shadow-inner">
                <%= @hotel.default_currency %>
              </div>
              <p class="mt-2 text-[11px] font-medium text-slate-400 italic text-rose-500">Contact admin to change base accounting currency.</p>
            </div>
          </div>
        </div>

        <div class="mt-8 flex items-center justify-end gap-3 pt-6 border-t border-slate-100">
          <%= link_to "Cancel", hotel_settings_path, class: "py-3 px-6 inline-flex justify-center items-center gap-x-2 text-sm font-bold rounded-xl border border-slate-200 bg-white text-slate-700 hover:bg-slate-50 transition-colors" %>
          <%= f.submit "Update Property Settings", class: "py-3 px-8 inline-flex justify-center items-center gap-x-2 text-sm font-bold rounded-xl border border-transparent bg-slate-900 text-white hover:bg-slate-700 shadow-sm transition-all" %>
        </div>
      </div>
    <% end %>
  </div>
</div>
