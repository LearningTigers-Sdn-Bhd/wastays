<%# app/views/hotel_portal/settings/_notification_module.html.erb %>
<div class="flex flex-col rounded-xl border border-slate-200 bg-white shadow-sm overflow-hidden transition-all duration-300 hover:border-slate-300 hover:shadow-md group/card <%= 'is-disabled' unless config.enabled %>"
     data-controller="notification-card"
     data-notification-card-active-class="bg-white"
     data-notification-card-inactive-class="bg-slate-50/50">
  <%= form_with model: config, url: hotel_settings_path(@hotel, tab: "notifications"), method: :patch, local: true, class: "flex flex-col h-full" do |f| %>
    <%= hidden_field_tag :form_id, "notification_settings" %>
    <%= hidden_field_tag "notification_config[notification_type]", notification_type %>

    <!-- Card Header -->
    <div class="px-4 py-3 border-b border-slate-100 flex items-center justify-between bg-white relative z-10">
      <div class="flex items-center gap-3">
        <div class="flex h-8 w-8 items-center justify-center rounded-lg bg-slate-50 text-slate-600 border border-slate-100 shadow-sm group-[.is-disabled]/card:opacity-50">
          <%= icon %>
        </div>
        <div>
          <h3 class="text-xs font-bold text-slate-900 leading-tight flex items-center gap-2">
            <%= title %>
            <span class="hidden group-[.is-disabled]/card:inline-block rounded-full bg-slate-200 px-2 py-0.5 text-[10px] font-bold text-slate-500 uppercase tracking-tight">Inactive</span>
          </h3>
          <p class="text-[10px] font-bold text-slate-400 uppercase tracking-wider mt-0.5"><%= subtitle %></p>
        </div>
      </div>
      
      <label class="relative inline-flex cursor-pointer items-center">
        <%= hidden_field_tag "notification_config[enabled]", "0" %>
        <%= check_box_tag "notification_config[enabled]", "1", config.enabled, 
                          class: "sr-only peer", 
                          data: { 
                            notification_card_target: "toggle",
                            action: "change->notification-card#refresh" 
                          } %>
        <div class="peer h-5 w-9 rounded-full bg-slate-200 transition-all after:absolute after:left-[2px] after:top-[2px] after:h-4 after:w-4 after:rounded-full after:bg-white after:shadow-sm after:transition-all after:content-[''] peer-checked:bg-slate-900 peer-checked:after:translate-x-full peer-focus:outline-none"></div>
      </label>
    </div>

    <!-- Card Body -->
    <div class="p-4 flex-grow flex flex-col transition-all duration-300 group-[.is-disabled]/card:opacity-40 group-[.is-disabled]/card:grayscale group-[.is-disabled]/card:pointer-events-none" data-notification-card-target="content">
      <!-- Description -->
      <p class="text-xs text-slate-500 leading-relaxed mb-4">
        <%= description %>
      </p>

      <div class="space-y-4 flex-grow">
        <!-- Channels Selection -->
        <div>
          <span class="mb-2 block text-[10px] font-bold uppercase tracking-widest text-slate-400">Delivery Channels</span>
          <div class="flex flex-wrap gap-2">
            <% ["whatsapp", "email"].each do |channel| %>
              <label class="group relative flex flex-1 min-w-[108px] cursor-pointer items-center justify-between rounded-lg border border-slate-200 p-2 transition-all hover:bg-slate-50 has-[:checked]:border-slate-900 has-[:checked]:bg-slate-50/50 has-[:checked]:ring-1 has-[:checked]:ring-slate-900 has-[:disabled]:cursor-not-allowed">
                <div class="flex items-center gap-2">
                  <div class="flex h-6 w-6 items-center justify-center rounded-md transition-colors <%= channel == 'whatsapp' ? 'bg-emerald-50 text-emerald-600 group-has-[:checked]:bg-emerald-100' : 'bg-blue-50 text-blue-600 group-has-[:checked]:bg-blue-100' %>">
                     <% if channel == 'whatsapp' %>
                       <svg class="h-4 w-4" fill="currentColor" viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/></svg>
                     <% else %>
                       <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
                     <% end %>
                  </div>
                  <span class="text-xs font-bold text-slate-700"><%= channel.humanize %></span>
                </div>
                <%= check_box_tag "notification_config[channels][]", channel, config.channels.include?(channel), class: "h-3.5 w-3.5 rounded border-slate-300 text-slate-900 focus:ring-slate-900 transition-all cursor-pointer disabled:opacity-30" %>
              </label>
            <% end %>
          </div>
        </div>

        <% if block_given? %>
          <div class="pt-4 border-t border-slate-100">
             <%= yield f %>
          </div>
        <% end %>
      </div>
    </div>

    <!-- Card Footer -->
    <div class="px-4 py-3 bg-slate-50/50 border-t border-slate-100 mt-auto relative z-10 flex justify-end" data-notification-card-target="footer">
      <%= f.submit "Save Configuration", class: "rounded-lg bg-slate-900 px-4 py-2 text-xs font-bold text-white transition-all hover:bg-slate-800 hover:shadow-lg active:scale-[0.98] disabled:opacity-50 disabled:cursor-not-allowed" %>
    </div>
  <% end %>
</div>
