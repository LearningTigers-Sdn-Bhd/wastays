<%
  active_group = if settings_group_active?(:general) then :general
                 elsif settings_group_active?(:property) then :property
                 elsif settings_group_active?(:finance) then :finance
                 elsif settings_group_active?(:guest_content) then :guest_content
                 elsif settings_group_active?(:team) then :team
                 end

  settings_tabs = settings_tabs_for_group(active_group)
  active_tab = settings_tabs.find { |tab| tab[:active] }
%>

<% if settings_tabs.present? %>
  <div data-testid="settings-tabs">
    <%= render PanelsUI::Tabs.new(
          id: "settings-#{active_group}-tabs",
          active: active_tab&.fetch(:key),
          aria_label: "Settings sections"
        ) do |tabs| %>
      <% settings_tabs.each do |tab| %>
        <% tabs.with_tab(
             name: tab[:key],
             label: tab[:label],
             icon: tab[:icon],
             href: tab[:path]
           ) %>
      <% end %>
    <% end %>
  </div>
<% end %>
