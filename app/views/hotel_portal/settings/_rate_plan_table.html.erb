<%# Shared by both Rate Settings tabs. `qualify_names` appends the room category
    to rows that all carry the same system name, so they don't read as duplicates. %>
<% qualify_names = local_assigns.fetch(:qualify_names, false) %>
<% empty_message = local_assigns.fetch(:empty_message, "No rate plans are configured.") %>

<%= render PanelsUI::Table.new(caption: caption, header_style: :sentence, striped: true,
      hoverable: true, bordered: true, wrapper_class: "rounded-md border border-border bg-card",
      class: "min-w-[820px]", data: { testid: testid }) do |table| %>
  <% table.with_header do %>
    <tr>
      <th>Name</th>
      <th>How it's charged</th>
      <th>Currency</th>
      <th>Room categories</th>
      <th class="text-right">Action</th>
    </tr>
  <% end %>
  <% table.with_body do %>
    <% rate_plans.each do |rate_plan| %>
      <tr id="rate-plan-row-<%= rate_plan.id %>" class="<%= "opacity-60" if rate_plan.archived? %>">
        <td>
          <div class="flex items-center gap-2">
            <span class="font-medium text-foreground">
              <%= rate_plan.name %><% if qualify_names && rate_plan.room_types.any? %><span class="text-muted-foreground"> · <%= rate_plan.room_types.map(&:name).join(", ") %></span><% end %>
            </span>
            <% if rate_plan.archived? %>
              <%= render PanelsUI::Badge.new(label: "Archived", variant: :warning, size: :sm) %>
            <% elsif rate_plan.special_tier? %>
              <%= render PanelsUI::Badge.new(label: rate_tier_label(rate_plan), variant: :neutral, size: :sm) %>
            <% end %>
          </div>
        </td>
        <td class="text-muted-foreground"><%= rate_plan.sell_mode == "per_person" ? "Per person" : "Per room" %></td>
        <td class="text-muted-foreground" translate="no"><%= rate_plan.currency %></td>
        <td class="text-muted-foreground">
          <% if rate_plan.room_types.any? %>
            <%= rate_plan.room_types.map(&:name).join(", ") %>
          <% else %>
            None assigned
          <% end %>
        </td>
        <td class="text-right">
          <div class="inline-flex items-center justify-end gap-2">
            <% if rate_plan.archived? %>
              <%= render PanelsUI::Button.new(href: unarchive_hotel_rate_plan_path(@hotel, rate_plan),
                    variant: :ghost, size: :xs,
                    data: { turbo_method: :patch, turbo_frame: "_top" }) do %>
                Unarchive
              <% end %>
            <% elsif rate_plan.archivable? %>
              <%= render PanelsUI::Button.new(href: archive_hotel_rate_plan_path(@hotel, rate_plan),
                    variant: :ghost, size: :xs,
                    data: {
                      turbo_method: :patch,
                      turbo_frame: "_top",
                      turbo_confirm: "Archive '#{rate_plan.name}'? It will no longer be offered for new bookings, but existing bookings and history are kept. You can unarchive it anytime.",
                      turbo_confirm_title: "Archive rate plan"
                    }) do %>
                Archive
              <% end %>
            <% end %>
            <%= render PanelsUI::Button.new(href: edit_hotel_rate_plan_path(@hotel, rate_plan),
                  variant: :secondary, size: :xs,
                  data: { turbo_frame: "settings_action_sheet" }) do %>
              Manage
            <% end %>
          </div>
        </td>
      </tr>
    <% end %>
    <% if rate_plans.empty? %>
      <tr><td colspan="5" class="py-8 text-center text-sm text-muted-foreground"><%= empty_message %></td></tr>
    <% end %>
  <% end %>
<% end %>
