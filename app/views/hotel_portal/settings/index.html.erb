        <div data-disclosure-target="content" class="hidden mt-4 rounded-2xl border border-slate-200 bg-white overflow-hidden shadow-sm">
          <div class="px-6 py-4 bg-slate-50 border-b border-slate-100">
            <p class="text-xs text-slate-500">WAStays endeavours to keep this reference up to date, however the information provided is for guidance purposes only. Tax rates and applicability may change without notice. WAStays shall not be held liable for any discrepancies, errors, or omissions. Always verify current rates with the relevant state authority or a qualified tax consultant before configuring and remitting taxes.</p>
          </div>
          <div class="px-6 py-4 border-b border-slate-100">
            <p class="text-xs font-semibold uppercase tracking-widest text-slate-400 mb-3">Federal — applies nationwide</p>
            <table class="w-full text-sm">
              <thead>
                <tr class="text-xs text-slate-500 border-b border-slate-100">
                  <th class="text-left pb-2 font-medium w-1/4">Scope</th>
                  <th class="text-left pb-2 font-medium w-1/4">Tax Name</th>
                  <th class="text-left pb-2 font-medium w-1/4">Rate</th>
                  <th class="text-left pb-2 font-medium w-1/4">Who Pays</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-slate-50">
                <tr>
                  <td class="py-2.5 text-slate-700">All states</td>
                  <td class="py-2.5 font-medium text-slate-900">Tourism Tax (TTx)</td>
                  <td class="py-2.5 text-slate-700">RM 10 / room / night</td>
                  <td class="py-2.5 text-slate-500 text-xs">Foreign tourists only. Malaysians & PR exempt.</td>
                </tr>
                <tr>
                  <td class="py-2.5 text-slate-700">All states (turnover &gt; RM 500k)</td>
                  <td class="py-2.5 font-medium text-slate-900">Service Tax (SST)</td>
                  <td class="py-2.5 text-slate-700">8% of taxable service amount</td>
                  <td class="py-2.5 text-slate-500 text-xs">All guests</td>
                </tr>
              </tbody>
            </table>
          </div>
          <div class="px-6 py-4">
            <p class="text-xs font-semibold uppercase tracking-widest text-slate-400 mb-3">State & Local Government Levies</p>
            <table class="w-full text-sm">
              <thead>
                <tr class="text-xs text-slate-500 border-b border-slate-100">
                  <th class="text-left pb-2 font-medium w-1/5">State</th>
                  <th class="text-left pb-2 font-medium w-1/5">Levy Name</th>
                  <th class="text-left pb-2 font-medium w-2/5">Rate (per room/night)</th>
                  <th class="text-left pb-2 font-medium w-1/5">Notes</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-slate-50 text-xs">
                <tr><td class="py-2.5 font-medium text-slate-900">Melaka</td><td class="py-2.5 text-slate-700">Heritage Fee</td><td class="py-2.5 text-slate-700">Below 3★ — RM 3 · 3★ & 4★ — RM 4 · 5★ — RM 5</td><td class="py-2.5 text-slate-500">All licensed hotels</td></tr>
                <tr><td class="py-2.5 font-medium text-slate-900">Penang</td><td class="py-2.5 text-slate-700">Heritage Fee</td><td class="py-2.5 text-slate-700">3★ & below — RM 2 · 4★ — RM 3</td><td class="py-2.5 text-slate-500">George Town & heritage zones</td></tr>
                <tr><td class="py-2.5 font-medium text-slate-900">Pahang</td><td class="py-2.5 text-slate-700">Pahang Lestari Fee</td><td class="py-2.5 text-slate-700">RM 3 flat</td><td class="py-2.5 text-slate-500">All hotels incl. Cameron Highlands, Genting</td></tr>
                <tr><td class="py-2.5 font-medium text-slate-900">Perak</td><td class="py-2.5 text-slate-700">Perak Local Service Charge</td><td class="py-2.5 text-slate-700">RM 3 flat</td><td class="py-2.5 text-slate-500">Hotels, homestays & STR</td></tr>
                <tr><td class="py-2.5 font-medium text-slate-900">Langkawi (Kedah)</td><td class="py-2.5 text-slate-700">Langkawi Tourism Promotion Fee</td><td class="py-2.5 text-slate-700">1–2★ — RM 1 · 3–4★ — RM 3 · 5★ — RM 5–9</td><td class="py-2.5 text-slate-500">Langkawi island only</td></tr>
                <tr><td class="py-2.5 font-medium text-slate-900">Selangor</td><td class="py-2.5 text-slate-700">Selangor Sustainability (Lestari) Fee</td><td class="py-2.5 text-slate-700">Budget — RM 2 · 1–3★ — RM 5 · 4–5★ — RM 7</td><td class="py-2.5 text-slate-500">New Jan 2026. All licensed accommodation.</td></tr>
                <tr><td class="py-2.5 font-medium text-slate-900">Johor</td><td class="py-2.5 text-slate-700">Johor Hotel Tax</td><td class="py-2.5 text-slate-700">RM 3 flat</td><td class="py-2.5 text-slate-500">New Jan 2026. All accommodation.</td></tr>
                <tr><td class="py-2.5 text-slate-400">Sabah</td><td class="py-2.5 text-slate-400">Local Tourist Levy (Informal)</td><td class="py-2.5 text-slate-400">~RM 10 (not gazetted)</td><td class="py-2.5 text-slate-400">Operator-collected, not standardised</td></tr>
                <tr><td class="py-2.5 text-slate-400">Sarawak, Kelantan, Terengganu, KL, Perlis, N. Sembilan</td><td class="py-2.5 text-slate-400">—</td><td class="py-2.5 text-slate-400">No state levy confirmed</td><td class="py-2.5 text-slate-400">Federal TTx only</td></tr>
              </tbody>
            </table>
          </div>
        </div>
      </div>
      <% end %>

      <% if @presenter.active_tab == "ai" %>
      <section class="rounded-2xl border border-slate-200 bg-white shadow-sm">
        <div class="border-b border-slate-200 px-6 py-5 sm:px-8">
          <h2 class="text-lg font-bold tracking-tight text-slate-950 sm:text-xl">AI Concierge Configuration</h2>
          <p class="mt-1 text-sm font-medium text-slate-600">Configure AI providers and keys for automated assistance.</p>
        </div>

        <div class="px-6 py-5 sm:px-8">
          <%= form_with model: @hotel, url: hotel_settings_path(@hotel, tab: "ai"), method: :patch, local: true, class: "space-y-6" do |f| %>
            <%= hidden_field_tag :form_id, "ai_configuration" %>
            <% if @hotel.errors.any? && params[:form_id] == "ai_configuration" %>
              <div class="rounded-lg border border-red-200 bg-red-50 p-4 text-sm text-red-700">
                <p class="font-semibold"><%= pluralize(@hotel.errors.count, "error") %> prohibited these AI settings from being saved:</p>
                <ul class="mt-2 list-disc space-y-1 ps-5">
                  <% @hotel.errors.full_messages.each do |message| %>
                    <li><%= message %></li>
                  <% end %>
                </ul>
              </div>
            <% end %>

            <div class="grid items-start gap-4 md:grid-cols-2">
              <div>
                <span class="mb-2 block text-sm font-medium text-slate-900">AI Concierge Features</span>
                <label class="flex h-[46px] w-full items-center justify-between rounded-xl border border-slate-200 bg-white px-4">
                  <span class="text-sm text-slate-600">Enable AI Assistance</span>
                  <span class="relative inline-flex items-center">
                    <%= f.check_box :ai_provider_enabled, class: "sr-only peer" %>
                    <span class="peer h-6 w-11 rounded-full bg-gray-200 transition after:absolute after:left-[2px] after:top-[2px] after:h-5 after:w-5 after:rounded-full after:bg-white after:transition-all after:content-[''] peer-checked:bg-slate-900 peer-checked:after:translate-x-full"></span>
                  </span>
                </label>
              </div>

              <div>
                <%= f.label :ai_concierge_tone, "Tone", class: "mb-2 block text-sm font-medium text-slate-900" %>
                <%= f.select :ai_concierge_tone, Hotel.ai_concierge_tones.keys.map { |tone| [tone.humanize, tone] }, {}, class: "w-full rounded-xl border border-slate-200 px-4 py-2.5 text-sm text-slate-700 focus:border-slate-300 focus:outline-none focus:ring-0" %>
              </div>
            </div>

            <div class="grid gap-4 md:grid-cols-2">
              <div>
                <%= f.label :ai_provider_name, "AI Provider", class: "mb-2 block text-sm font-medium text-slate-900" %>
                <% provider_options = { "openai" => "OpenAI", "claude" => "Claude", "deepseek" => "DeepSeek", "gemini" => "Gemini" } %>
                <%= f.select :ai_provider_name, Hotel.ai_provider_names.keys.map { |k| [provider_options[k] || k.humanize, k] }, { include_blank: "Select Provider" }, class: "w-full rounded-xl border border-slate-200 px-4 py-2.5 text-sm text-slate-700 focus:border-slate-300 focus:outline-none focus:ring-0" %>
              </div>

              <div>
                <%= f.label :ai_provider_key, "API Key", class: "mb-2 block text-sm font-medium text-slate-900" %>
                <%= f.password_field :ai_provider_key, value: @hotel.ai_provider_key, class: "w-full rounded-xl border border-slate-200 px-4 py-2.5 text-sm text-slate-700 focus:border-slate-300 focus:outline-none focus:ring-0", placeholder: "sk-..." %>
                <p class="mt-1.5 text-xs text-slate-500">Your API key is securely encrypted before being saved.</p>
              </div>
            </div>

            <div class="flex justify-end border-t border-slate-200 pt-4">
              <%= f.submit "Save AI Concierge Configuration", class: "inline-flex items-center rounded-lg bg-slate-900 px-4 py-2 text-sm font-semibold text-white transition hover:bg-slate-700" %>
            </div>
          <% end %>
        </div>
      </section>
      <% end %>

      <% if @presenter.active_tab == "notifications" %>
      <section class="rounded-2xl border border-slate-200 bg-white shadow-sm">
        <div class="border-b border-slate-200 px-6 py-5 sm:px-8">
          <h2 class="text-lg font-bold tracking-tight text-slate-950 sm:text-xl">Communication & Notifications</h2>
          <p class="mt-1 text-sm font-medium text-slate-600">Configure guest notification automations and channels.</p>
        </div>

        <div class="px-4 py-5 sm:px-6 bg-slate-50/20">
          <%# Error handling for notification settings %>
          <% if params[:form_id] == "notification_settings" && (@notification_config&.errors&.any? || @hotel.errors.any?) %>
            <div class="mb-5 rounded-lg border border-red-200 bg-red-50 p-3 text-xs text-red-700">
              <p class="font-bold flex items-center gap-2">
                <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                Some settings could not be saved:
              </p>
              <ul class="mt-2 list-disc space-y-1 ps-5">
                <% (@notification_config&.errors&.full_messages || []).each do |message| %>
                  <li><%= message %></li>
                <% end %>
                <% @hotel.errors.full_messages.each do |message| %>
                  <li><%= message %></li>
                <% end %>
              </ul>
            </div>
          <% end %>

          <div class="grid gap-4 lg:grid-cols-3">
            <%# 1. Check-In Confirmation %>
            <%= render "notification_module", 
                       config: @presenter.check_in_notification_config, 
                       notification_type: "check_in_confirmation",
                       title: "Check-In Confirmation",
                       subtitle: "Guest Arrival",
                       description: "Send a welcome message with room details and hotel info immediately after check-in.",
                       icon: capture { %>
                         <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                       <% } %>

            <%# 2. Post-Stay Review Request %>
            <% post_stay_config = @presenter.post_stay_review_notification_config %>
            <%= render "notification_module", 
                       config: post_stay_config, 
                       notification_type: "post_stay_review_request",
                       title: "Post-Stay Review",
                       subtitle: "Guest Feedback",
                       description: "Automate review requests after checkout. Best sent within 2-4 hours of departure.",
                       icon: capture { %>
                         <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.197-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118l-3.976-2.888c-.784-.57-.382-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.519-4.674z"/></svg>
                       <% } do |f| %>
              <div class="grid gap-3 sm:grid-cols-2">
                <div>
                  <label class="mb-1 block text-[10px] font-bold uppercase tracking-widest text-slate-400">Review Link</label>
                  <%= text_field_tag "notification_config[settings][review_link]", post_stay_config.settings.to_h["review_link"], placeholder: "Google/Tripadvisor link...", class: "w-full rounded-lg border border-slate-200 px-3 py-1.5 text-xs text-slate-700 focus:border-slate-900 focus:outline-none focus:ring-0" %>
                </div>
                <div>
                  <label class="mb-1 block text-[10px] font-bold uppercase tracking-widest text-slate-400">Delay (Hours)</label>
                  <%= number_field_tag "notification_config[settings][send_delay_hours]", post_stay_config.settings.to_h["send_delay_hours"], min: 0, step: 1, class: "w-full rounded-lg border border-slate-200 px-3 py-1.5 text-xs text-slate-700 focus:border-slate-900 focus:outline-none focus:ring-0" %>
                </div>
              </div>
            <% end %>

            <%# 3. Pre-Arrival Notification %>
            <% pre_arrival_config = @presenter.pre_arrival_notification_config %>
            <%= render "notification_module", 
                       config: pre_arrival_config, 
                       notification_type: "pre_arrival_notification",
                       title: "Pre-Arrival Greeting",
                       subtitle: "Stay Prep",
                       description: "Remind guests of their upcoming stay and offer pre-checkin options or local tips.",
                       icon: capture { %>
                         <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
                       <% } do |f| %>
              <div>
                <span class="mb-2 block text-[10px] font-bold uppercase tracking-widest text-slate-400">Send Stages</span>
                <div class="flex gap-2">
                  <% stages = pre_arrival_config.settings.to_h["stages"] || [] %>
                  <%= hidden_field_tag "notification_config[settings][stages][]", "" %>
                  <% [["d2", "D-2"], ["d1", "D-1"]].each do |val, label| %>
                    <label class="flex flex-1 cursor-pointer items-center justify-between rounded-lg border border-slate-200 p-2 transition-all hover:bg-slate-50 has-[:checked]:border-slate-900 has-[:checked]:bg-slate-50/50">
                      <span class="text-xs font-bold text-slate-700"><%= label %></span>
                      <%= check_box_tag "notification_config[settings][stages][]", val, stages.include?(val), class: "h-4 w-4 rounded border-slate-300 text-slate-900 focus:ring-slate-900" %>
                    </label>
                  <% end %>
                </div>
              </div>
            <% end %>

            <%# 4. Check-Out Receipt Message %>
            <%= render "notification_module", 
                       config: @presenter.check_out_receipt_notification_config, 
                       notification_type: "check_out_receipt_message",
                       title: "Check-Out Invoice / Receipt",
                       subtitle: "Billing",
                       description: "Sent at checkout via WhatsApp/Email. Delivers a receipt if the folio is fully settled, or an invoice if there is an outstanding balance.",
                       icon: capture { %>
                         <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 17v-2m3 2v-4m3 4v-6m2 10H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
                       <% } %>

            <%# 5. In-Stay Guest Messaging %>
            <% in_stay_config = @presenter.in_stay_guest_notification_config %>
            <div class="lg:col-span-3">
              <%= render "notification_module", 
                         config: in_stay_config, 
                         notification_type: "in_stay_guest_messaging",
                         title: "In-Stay Guest Engagement",
                         subtitle: "Experience",
                         description: "Proactive messaging during the guest's stay to ensure satisfaction and promote amenities.",
                         icon: capture { %>
                           <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9"/></svg>
                         <% } do |f| %>
                <div class="space-y-5">
                  <div class="grid gap-4 md:grid-cols-3">
                    <% in_stay_rules = in_stay_config.settings.to_h.fetch("rules", {}) %>
                    <% [["mid_stay", "Mid-stay Check", "Satisfaction survey"], 
                        ["upsell", "Upsell Prompt", "F&B or Spa offers"], 
                        ["activity", "Activity Suggestion", "Local attractions"]].each do |rule_key, label, sub| %>
                      <% rule = in_stay_rules.fetch(rule_key, {}) %>
                      <div class="rounded-lg border border-slate-200 bg-slate-50/50 p-3 transition-all hover:bg-white hover:shadow-sm">
                        <div class="flex items-center justify-between mb-3">
                          <div>
                            <span class="text-xs font-bold text-slate-900 block"><%= label %></span>
                            <span class="text-[10px] text-slate-500 uppercase tracking-wider"><%= sub %></span>
                          </div>
                          <label class="relative inline-flex items-center cursor-pointer">
                            <%= hidden_field_tag "notification_config[settings][rules][#{rule_key}][enabled]", "0" %>
                            <%= check_box_tag "notification_config[settings][rules][#{rule_key}][enabled]", "1", rule.fetch("enabled", true), class: "sr-only peer" %>
                            <div class="peer h-5 w-9 rounded-full bg-slate-200 transition-all after:absolute after:left-[2px] after:top-[2px] after:h-4 after:w-4 after:rounded-full after:bg-white after:transition-all after:content-[''] peer-checked:bg-slate-900 peer-checked:after:translate-x-full"></div>
                          </label>
                        </div>
                        <div>
                          <label class="mb-1 block text-[10px] font-bold uppercase tracking-widest text-slate-400">Send Time</label>
                          <%= time_field_tag "notification_config[settings][rules][#{rule_key}][time]", rule.fetch("time", "12:00"), class: "w-full rounded-lg border border-slate-200 bg-white px-3 py-1.5 text-xs text-slate-700 focus:border-slate-900 focus:ring-0" %>
                        </div>
                      </div>
                    <% end %>
                  </div>

                  <div class="rounded-lg border border-slate-200 bg-slate-50/30 p-4">
                    <% quiet_hours = in_stay_config.settings.to_h.fetch("quiet_hours", {}) %>
                    <div class="flex items-center justify-between mb-3">
                      <div class="flex items-center gap-2 text-slate-700">
                        <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"/></svg>
                        <span class="text-xs font-bold">Do Not Disturb (Quiet Hours)</span>
                      </div>
                      <label class="relative inline-flex items-center cursor-pointer">
                        <%= hidden_field_tag "notification_config[settings][quiet_hours][enabled]", "0" %>
                        <%= check_box_tag "notification_config[settings][quiet_hours][enabled]", "1", quiet_hours.fetch("enabled", true), class: "sr-only peer" %>
                        <div class="peer h-5 w-9 rounded-full bg-slate-200 transition-all after:absolute after:left-[2px] after:top-[2px] after:h-4 after:w-4 after:rounded-full after:bg-white after:transition-all after:content-[''] peer-checked:bg-slate-900 peer-checked:after:translate-x-full"></div>
                      </label>
                    </div>
                    <div class="grid gap-4 md:grid-cols-2">
                      <div>
                        <label class="mb-1 block text-[10px] font-bold uppercase tracking-widest text-slate-400">Start (No messages after)</label>
                        <%= time_field_tag "notification_config[settings][quiet_hours][start]", quiet_hours.fetch("start", "22:00"), class: "w-full rounded-lg border border-slate-200 bg-white px-3 py-1.5 text-xs text-slate-700 focus:border-slate-900 focus:ring-0" %>
                      </div>
                      <div>
                        <label class="mb-1 block text-[10px] font-bold uppercase tracking-widest text-slate-400">End (Resume at)</label>
                        <%= time_field_tag "notification_config[settings][quiet_hours][end]", quiet_hours.fetch("end", "08:00"), class: "w-full rounded-lg border border-slate-200 bg-white px-3 py-1.5 text-xs text-slate-700 focus:border-slate-900 focus:ring-0" %>
                      </div>
                    </div>
                  </div>
                </div>
              <% end %>
            </div>
          </div>
        </div>
      </section>
      <% end %>

      <% if @presenter.active_tab == "banking" && current_user.has_permission?("manage_account") %>
        <section class="rounded-2xl border border-slate-200 bg-white shadow-sm">
          <div class="border-b border-slate-200 px-6 py-5 sm:px-8">
            <h2 class="text-lg font-bold tracking-tight text-slate-950 sm:text-xl">Banking Details</h2>
            <p class="mt-1 text-sm font-medium text-slate-600">Shared account banking details for payout and settlement.</p>
          </div>

          <div class="px-6 py-5 sm:px-8">
            <%= form_with model: @account, url: hotel_settings_path(@hotel, tab: "banking"), method: :patch, local: true, class: "space-y-6" do |f| %>
              <% if @account.errors.any? %>
                <div class="rounded-lg border border-red-200 bg-red-50 p-4 text-sm text-red-700">
                  <p class="font-semibold"><%= pluralize(@account.errors.count, "error") %> prohibited these settings from being saved:</p>
                  <ul class="mt-2 list-disc space-y-1 ps-5">
                    <% @account.errors.full_messages.each do |message| %>
                      <li><%= message %></li>
                    <% end %>
                  </ul>
                </div>
              <% end %>

              <%= f.fields_for :banking_detail do |banking_fields| %>
                <%= banking_fields.hidden_field :id if banking_fields.object.persisted? %>

                <div class="grid gap-4 md:grid-cols-3">
                  <div>
                    <%= banking_fields.label :account_holder_name, "Account Holder Name", class: "mb-2 block text-sm font-medium text-slate-900" %>
                    <%= banking_fields.text_field :account_holder_name, class: "w-full rounded-xl border border-slate-200 px-4 py-2.5 text-sm text-slate-700 focus:border-slate-300 focus:outline-none focus:ring-0" %>
                  </div>

                  <div>
                    <%= banking_fields.label :bank_name, "Bank Name", class: "mb-2 block text-sm font-medium text-slate-900" %>
                    <%= banking_fields.text_field :bank_name, class: "w-full rounded-xl border border-slate-200 px-4 py-2.5 text-sm text-slate-700 focus:border-slate-300 focus:outline-none focus:ring-0" %>
                  </div>

                  <div>
                    <%= banking_fields.label :account_number, "Account Number", class: "mb-2 block text-sm font-medium text-slate-900" %>
                    <%= banking_fields.text_field :account_number, class: "w-full rounded-xl border border-slate-200 px-4 py-2.5 text-sm text-slate-700 focus:border-slate-300 focus:outline-none focus:ring-0" %>
                  </div>
                </div>
              <% end %>

              <div class="flex justify-end border-t border-slate-200 pt-4">
                <%= f.submit "Save Banking Details", class: "inline-flex items-center rounded-lg bg-slate-900 px-4 py-2 text-sm font-semibold text-white transition hover:bg-slate-700" %>
              </div>
            <% end %>
          </div>
        </section>
      <% end %>

      <% if @presenter.active_tab == "general" %>
      <!-- Concierge QR -->
      <section class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">
        <div class="border-b border-slate-200 px-6 py-5 sm:px-8">
          <h2 class="text-lg font-bold tracking-tight text-slate-950 sm:text-xl">Concierge Pages</h2>
          <p class="mt-1 text-sm font-medium text-slate-600">Print and display at your front desk so guests can self-serve check-in, check-out, and requests.</p>
        </div>
        <div class="px-6 py-5 sm:px-8 flex items-center justify-between gap-4">
          <p class="text-sm text-slate-600">Generate a printable QR code that links guests to your hotel's concierge page.</p>
          <%= link_to hotel_concierge_qr_path(current_hotel), class: "inline-flex items-center gap-2 rounded-xl bg-slate-900 px-5 py-2.5 text-sm font-bold text-white shadow-sm hover:bg-slate-700 transition flex-none" do %>
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4 lucide lucide-qr-code-icon lucide-qr-code"><rect width="5" height="5" x="3" y="3" rx="1"/><rect width="5" height="5" x="16" y="3" rx="1"/><rect width="5" height="5" x="3" y="16" rx="1"/><path d="M21 16h-3a2 2 0 0 0-2 2v3"/><path d="M21 21v.01"/><path d="M12 7v3a2 2 0 0 1-2 2H7"/><path d="M3 12h.01"/><path d="M12 3h.01"/><path d="M12 16v.01"/><path d="M16 12h1"/><path d="M21 12v.01"/><path d="M12 21v-1"/></svg>
            View QR Code
          <% end %>
        </div>
      </section>
      <% end %>

    </div>
  <% else %>
    <div class="mx-4 rounded-2xl border border-dashed border-slate-300 bg-white p-10 text-center md:mx-0">
      <h2 class="text-lg font-bold text-slate-900">No settings yet</h2>
      <p class="mt-2 text-sm text-slate-600">Settings will appear once a hotel is selected.</p>
    </div>
  <% end %>
</div>
