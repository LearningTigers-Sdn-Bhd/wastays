<div class="mx-auto max-w-[1600px] space-y-8 pb-20">
  <div class="px-4 md:px-0">
    <div class="mt-5">
      <h1 class="text-2xl font-bold tracking-tight text-slate-950 sm:text-3xl"><%= @presenter.page_title %></h1>
      <p class="mt-1 text-sm font-medium text-slate-600"><%= @presenter.page_description %></p>
    </div>
  </div>

  <% if @presenter %>
    <div class="px-4 md:px-0">
      <%= render "hotel_portal/settings/group_tabs" %>
    </div>

    <div class="space-y-6 px-4 md:px-0">
      <% case @presenter.active_page %>
      <% when "general" %>
        <%= render "hotel_portal/settings/general_section" %>
      <% when "rates" %>
        <%= render "hotel_portal/settings/rates_section" %>
      <% when "ai" %>
        <%= render "hotel_portal/settings/ai_concierge_section" %>
      <% when "notifications" %>
        <%= render "hotel_portal/settings/notifications_section" %>
      <% when "banking" %>
        <%= render "hotel_portal/settings/banking_section" %>
      <% end %>

    </div>
  <% else %>
    <div class="mx-4 rounded-2xl border border-dashed border-slate-300 bg-white p-10 text-center md:mx-0">
      <h2 class="text-lg font-bold text-slate-900">No settings yet</h2>
      <p class="mt-2 text-sm text-slate-600">Settings will appear once a hotel is selected.</p>
    </div>
  <% end %>
</div>
