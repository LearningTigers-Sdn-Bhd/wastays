<div class="max-w-[1600px] mx-auto pb-20 space-y-8">
  <div class="px-4 md:px-0">
    <div class="mt-5">
      <h1 class="text-2xl font-bold tracking-tight text-slate-950 sm:text-3xl">Settings</h1>
      <p class="mt-1 text-sm font-medium text-slate-600">Update hotel policy, taxes, sell currency, and banking details.</p>
    </div>
  </div>

  <% if @presenter %>
    <div class="space-y-6 px-4 md:px-0">
      <% tabs = [
        { key: "general", label: "General" },
        { key: "tax", label: "Tax" },
        { key: "ai", label: "AI Concierge" },
        { key: "notifications", label: "Notifications" }
      ] %>
      <% tabs << { key: "banking", label: "Banking" } if current_user.has_permission?("manage_account") %>

      <nav class="sticky top-2 z-20 overflow-x-auto rounded-2xl border border-slate-200 bg-white/95 p-2 shadow-sm backdrop-blur">
        <ul class="flex min-w-max items-center gap-2">
          <% tabs.each do |tab| %>
            <% active = @presenter.active_tab == tab[:key] %>
            <li>
              <%= link_to tab[:label], hotel_settings_path(current_hotel, tab: tab[:key]), class: "inline-flex items-center rounded-xl px-4 py-2 text-sm font-semibold transition #{active ? 'bg-slate-900 text-white shadow-sm' : 'text-slate-600 hover:bg-slate-100 hover:text-slate-900'}" %>
            </li>
          <% end %>
        </ul>
      </nav>

      <% if @presenter.active_tab == "general" %>
      <section class="rounded-2xl border border-slate-200 bg-white shadow-sm">
        <div class="border-b border-slate-200 px-6 py-5 sm:px-8">
          <h2 class="text-lg font-bold tracking-tight text-slate-950 sm:text-xl">Hotel Settings</h2>
          <p class="mt-1 text-sm font-medium text-slate-600">Control check-in/out timings and currency.</p>
        </div>

        <div class="px-6 py-5 sm:px-8">
          <%= form_with model: @hotel, url: hotel_settings_path(@hotel, tab: "general"), method: :patch, local: true, class: "space-y-6" do |f| %>
            <%= hidden_field_tag :form_id, "hotel_settings" %>
            <% settings_errors = @hotel.errors.full_messages + @presenter.property_policy.errors.full_messages %>
            <% if settings_errors.any? && params[:form_id] == "hotel_settings" %>
              <div class="rounded-lg border border-red-200 bg-red-50 p-4 text-sm text-red-700">
                <p class="font-semibold"><%= pluralize(settings_errors.count, "error") %> prohibited these settings from being saved:</p>
                <ul class="mt-2 list-disc space-y-1 ps-5">
                  <% settings_errors.each do |message| %>
                    <li><%= message %></li>
                  <% end %>
                </ul>
              </div>
            <% end %>

            <div class="grid gap-4 md:grid-cols-2">
              <div>
                <%= f.label :hotel_status_display, "Hotel Status", class: "mb-2 block text-sm font-medium text-slate-900" %>
                <%= f.text_field :hotel_status_display, value: @presenter.settings_summary[:hotel_status], disabled: true, class: "w-full rounded-xl border border-slate-200 bg-slate-50 px-4 py-2.5 text-sm text-slate-500" %>
              </div>

              <div>
                <%= f.label :onboarding_stage_display, "Onboarding Stage", class: "mb-2 block text-sm font-medium text-slate-900" %>
                <%= f.text_field :onboarding_stage_display, value: @presenter.settings_summary[:onboarding_stage], disabled: true, class: "w-full rounded-xl border border-slate-200 bg-slate-50 px-4 py-2.5 text-sm text-slate-500" %>
              </div>
            </div>

            <div class="grid gap-4 md:grid-cols-2">
              <%= f.fields_for :property_policy_attributes, @presenter.property_policy do |property_policy_fields| %>
                <div data-controller="time-picker" data-time-picker-next-field-selector-value="#index-check-out-dropdown" class="relative">
                  <%= property_policy_fields.label :check_in_time, "Standard Check-in Time", class: "mb-2 block text-sm font-medium text-slate-900" %>
                  <div class="relative">
                    <input type="text" 
                           data-time-picker-target="input"
                           data-action="click->time-picker#toggle"
                           class="w-full rounded-xl border border-slate-200 bg-white px-4 py-2.5 text-sm font-bold text-slate-900 focus:border-slate-300 focus:outline-none focus:ring-0 cursor-pointer"
                           readonly
                           value="<%= @presenter.property_policy.check_in_time %>">
                    <%= property_policy_fields.hidden_field :check_in_time, data: { time_picker_target: "hiddenInput" } %>
                    
                    <div data-time-picker-target="dropdown" 
                         class="absolute z-[100] hidden w-full overflow-hidden rounded-xl border border-slate-200 bg-white shadow-xl ring-1 ring-slate-900/5 mt-1">
                      <div class="flex h-[200px]">
                        <div class="flex-1 overflow-y-auto custom-scrollbar border-r border-slate-50 p-1">
                          <% (0..23).each do |h| %>
                            <button type="button" data-time-picker-target="hour" data-action="click->time-picker#selectHour" data-value="<%= h %>" class="w-full rounded-lg px-3 py-1.5 text-left text-xs font-bold transition-colors">
                              <%= Time.current.change(hour: h).strftime("%I %p") %>
                            </button>
                          <% end %>
                        </div>
                        <div class="w-[70px] overflow-y-auto custom-scrollbar p-1 bg-slate-50/30">
                          <% [0, 15, 30, 45].each do |m| %>
                            <button type="button" data-time-picker-target="minute" data-action="click->time-picker#selectMinute" data-value="<%= m %>" class="w-full rounded-lg px-3 py-1.5 text-center text-xs font-bold transition-colors">
                              :<%= m.to_s.rjust(2, '0') %>
                            </button>
                          <% end %>
                        </div>
                      </div>
                    </div>
                  </div>
                </div>

                <div id="index-check-out-dropdown" data-controller="time-picker" class="relative">
                  <%= property_policy_fields.label :check_out_time, "Standard Check-out Time", class: "mb-2 block text-sm font-medium text-slate-900" %>
                  <div class="relative">
                    <input type="text" 
                           data-time-picker-target="input"
                           data-action="click->time-picker#toggle"
                           class="w-full rounded-xl border border-slate-200 bg-white px-4 py-2.5 text-sm font-bold text-slate-900 focus:border-slate-300 focus:outline-none focus:ring-0 cursor-pointer"
                           readonly
                           value="<%= @presenter.property_policy.check_out_time %>">
                    <%= property_policy_fields.hidden_field :check_out_time, data: { time_picker_target: "hiddenInput" } %>
                    
                    <div data-time-picker-target="dropdown" 
                         class="absolute z-[100] hidden w-full overflow-hidden rounded-xl border border-slate-200 bg-white shadow-xl ring-1 ring-slate-900/5 mt-1">
                      <div class="flex h-[200px]">
                        <div class="flex-1 overflow-y-auto custom-scrollbar border-r border-slate-50 p-1">
                          <% (0..23).each do |h| %>
                            <button type="button" data-time-picker-target="hour" data-action="click->time-picker#selectHour" data-value="<%= h %>" class="w-full rounded-lg px-3 py-1.5 text-left text-xs font-bold transition-colors">
                              <%= Time.current.change(hour: h).strftime("%I %p") %>
                            </button>
                          <% end %>
                        </div>
                        <div class="w-[70px] overflow-y-auto custom-scrollbar p-1 bg-slate-50/30">
                          <% [0, 15, 30, 45].each do |m| %>
                            <button type="button" data-time-picker-target="minute" data-action="click->time-picker#selectMinute" data-value="<%= m %>" class="w-full rounded-lg px-3 py-1.5 text-center text-xs font-bold transition-colors">
                              :<%= m.to_s.rjust(2, '0') %>
                            </button>
                          <% end %>
                        </div>
                      </div>
                    </div>
                  </div>
                </div>
              <% end %>
            </div>

            <div class="grid gap-4 md:grid-cols-2">
              <div data-controller="searchable-select">
                <%= f.label :time_zone, "Property Timezone", class: "mb-2 block text-sm font-medium text-slate-900" %>
                <div class="relative group">
                  <input type="text" 
                         data-searchable-select-target="input"
                         data-action="input->searchable-select#filter click->searchable-select#open"
                         class="w-full rounded-xl border border-slate-200 bg-white px-4 py-2.5 text-sm font-semibold text-slate-700 transition-all focus:border-slate-300 focus:outline-none focus:ring-0"
                         placeholder="Search timezone..."
                         autocomplete="off"
                         value="<%= @hotel.time_zone %>">
                  <%= f.hidden_field :time_zone, data: { searchable_select_target: "hiddenInput" } %>
                  <div data-searchable-select-target="options" class="absolute z-[100] hidden w-full overflow-hidden rounded-xl border border-slate-200 bg-white shadow-xl ring-1 ring-slate-900/5 mt-1">
                    <div class="max-height-[240px] overflow-y-auto p-1 custom-scrollbar" style="max-height: 240px;">
                      <% ActiveSupport::TimeZone.all.each do |tz| %>
                        <button type="button" data-searchable-select-target="option" data-action="click->searchable-select#select" data-value="<%= tz.name %>" data-label="<%= tz.to_s %>" class="flex w-full items-center gap-3 rounded-lg px-3 py-2 text-left text-sm font-semibold text-slate-700 hover:bg-slate-50">
                          <span class="truncate text-xs"><%= tz.to_s %></span>
                        </button>
                      <% end %>
                    </div>
                  </div>
                </div>
              </div>

              <div>
                <% can_edit_currency = current_user.has_permission?("manage_hotel_profile") %>
                <%= f.label :default_currency, "Default Currency", class: "mb-2 block text-sm font-medium text-slate-900" %>
                <%= f.select :default_currency, 
                             options_for_select(CurrencyCatalog.options, @presenter.settings_summary[:default_currency] || "MYR"), 
                             {}, 
                             class: "w-full rounded-xl border border-slate-200 px-4 py-2.5 text-sm font-bold text-slate-900 #{can_edit_currency ? 'bg-white focus:border-slate-300 focus:outline-none focus:ring-0' : 'bg-slate-50 cursor-not-allowed'}", 
                             disabled: !can_edit_currency %>
                <% if can_edit_currency %>
                  <p class="mt-1 text-[10px] font-medium text-slate-400 italic">Changing this will affect how rates are stored and synced.</p>
                <% else %>
                  <p class="mt-1 text-[10px] font-medium text-rose-500 italic">Contact admin to change base accounting currency.</p>
                <% end %>
              </div>
            </div>

            <div class="grid gap-4 md:grid-cols-3 mt-6">
              <div data-controller="time-picker" class="relative">
                <%= f.label :business_starts_at, "Business Day Starts At", class: "mb-2 block text-sm font-medium text-slate-900" %>
                <div class="relative">
                  <input type="text" 
                         data-time-picker-target="input"
                         data-action="click->time-picker#toggle"
                         class="w-full rounded-xl border border-slate-200 bg-white px-4 py-2.5 text-sm font-bold text-slate-900 focus:border-slate-300 focus:outline-none focus:ring-0 cursor-pointer"
                         readonly
                         value="<%= @hotel.business_starts_at&.strftime("%I:%M %p") %>">
                  <%= f.hidden_field :business_starts_at, value: @hotel.business_starts_at&.strftime("%H:%M"), data: { time_picker_target: "hiddenInput" } %>
                  
                  <div data-time-picker-target="dropdown" class="absolute z-[100] hidden w-64 overflow-hidden rounded-xl border border-slate-200 bg-white shadow-xl ring-1 ring-slate-900/5 mt-1">
                    <div class="flex h-[240px]">
                      <div class="w-20 overflow-y-auto custom-scrollbar border-r border-slate-50 p-1">
                        <% (1..12).each do |h| %>
                          <button type="button" data-time-picker-target="hour" data-action="click->time-picker#selectHour" data-value="<%= h %>" class="w-full rounded-lg px-2 py-1.5 text-center text-xs font-bold transition-colors">
                            <%= h %>
                          </button>
                        <% end %>
                      </div>
                      <div class="w-20 overflow-y-auto custom-scrollbar border-r border-slate-50 p-1 bg-slate-50/10">
                        <% (0..59).each do |m| %>
                          <button type="button" data-time-picker-target="minute" data-action="click->time-picker#selectMinute" data-value="<%= m %>" class="w-full rounded-lg px-2 py-1.5 text-center text-xs font-bold transition-colors">
                            <%= m.to_s.rjust(2, '0') %>
                          </button>
                        <% end %>
                      </div>
                      <div class="flex-1 p-1 bg-slate-50/30 flex flex-col justify-center gap-1">
                        <% ["AM", "PM"].each do |p| %>
                          <button type="button" data-time-picker-target="period" data-action="click->time-picker#selectPeriod" data-value="<%= p %>" class="w-full rounded-lg py-3 text-center text-xs font-bold transition-colors">
                            <%= p %>
                          </button>
                        <% end %>
                      </div>
                    </div>
                  </div>
                </div>
              </div>

              <div data-controller="time-picker" class="relative">
                <%= f.label :business_ends_at, "Business Day Ends At", class: "mb-2 block text-sm font-medium text-slate-900" %>
                <div class="relative">
                  <input type="text" 
                         data-time-picker-target="input"
                         data-action="click->time-picker#toggle"
                         class="w-full rounded-xl border border-slate-200 bg-white px-4 py-2.5 text-sm font-bold text-slate-900 focus:border-slate-300 focus:outline-none focus:ring-0 cursor-pointer"
                         readonly
                         value="<%= @hotel.business_ends_at&.strftime("%I:%M %p") %>">
                  <%= f.hidden_field :business_ends_at, value: @hotel.business_ends_at&.strftime("%H:%M"), data: { time_picker_target: "hiddenInput" } %>
                  
                  <div data-time-picker-target="dropdown" class="absolute z-[100] hidden w-64 overflow-hidden rounded-xl border border-slate-200 bg-white shadow-xl ring-1 ring-slate-900/5 mt-1">
                    <div class="flex h-[240px]">
                      <div class="w-20 overflow-y-auto custom-scrollbar border-r border-slate-50 p-1">
                        <% (1..12).each do |h| %>
                          <button type="button" data-time-picker-target="hour" data-action="click->time-picker#selectHour" data-value="<%= h %>" class="w-full rounded-lg px-2 py-1.5 text-center text-xs font-bold transition-colors">
                            <%= h %>
                          </button>
                        <% end %>
                      </div>
                      <div class="w-20 overflow-y-auto custom-scrollbar border-r border-slate-50 p-1 bg-slate-50/10">
                        <% (0..59).each do |m| %>
                          <button type="button" data-time-picker-target="minute" data-action="click->time-picker#selectMinute" data-value="<%= m %>" class="w-full rounded-lg px-2 py-1.5 text-center text-xs font-bold transition-colors">
                            <%= m.to_s.rjust(2, '0') %>
                          </button>
                        <% end %>
                      </div>
                      <div class="flex-1 p-1 bg-slate-50/30 flex flex-col justify-center gap-1">
                        <% ["AM", "PM"].each do |p| %>
                          <button type="button" data-time-picker-target="period" data-action="click->time-picker#selectPeriod" data-value="<%= p %>" class="w-full rounded-lg py-3 text-center text-xs font-bold transition-colors">
                            <%= p %>
                          </button>
                        <% end %>
                      </div>
                    </div>
                  </div>
                </div>
              </div>

              <div>
                <%= f.label :arrival_grace_period_hours, "Arrival Grace Period (Hours)", class: "mb-2 block text-sm font-medium text-slate-900" %>
                <%= f.number_field :arrival_grace_period_hours, min: 0, step: 1, class: "w-full rounded-xl border border-slate-200 bg-white px-4 py-2.5 text-sm font-bold text-slate-900 focus:border-slate-300 focus:outline-none focus:ring-0 shadow-sm" %>
                <p class="mt-1 text-[10px] font-medium text-slate-400 italic">Grace period after business hours before marking as No-Show.</p>
              </div>
            </div>

            <div class="flex justify-end border-t border-slate-200 pt-4">
              <%= f.submit "Save Settings", class: "inline-flex items-center rounded-lg bg-slate-900 px-4 py-2 text-sm font-semibold text-white transition hover:bg-slate-700" %>
            </div>
          <% end %>
        </div>
      </section>
      <% end %>

      <% if @presenter.active_tab == "tax" %>
      <!-- Tax Configuration Card -->
      <section class="rounded-2xl border border-slate-200 bg-white shadow-sm">
        <div class="border-b border-slate-200 px-6 py-5 sm:px-8">
          <h2 class="text-lg font-bold tracking-tight text-slate-950 sm:text-xl">Tax Configuration</h2>
          <p class="mt-1 text-sm font-medium text-slate-600">Configure taxes applied to bookings. These appear as separate line items on invoices and receipts.</p>
        </div>

        <div class="px-6 py-5 sm:px-8">
          <%= form_with model: @hotel, url: hotel_settings_path(@hotel, tab: "tax"), method: :patch, local: true, class: "space-y-6" do |f| %>
            <%= hidden_field_tag :form_id, "tax_settings" %>

            <div class="grid items-start gap-4 md:grid-cols-3" data-controller="tourism-tax">
              <div>
                <span class="mb-2 block text-sm font-medium text-slate-900">Tourism Tax (TTx)</span>
                <label class="flex h-[46px] w-full items-center justify-between rounded-xl border border-slate-200 bg-white px-4">
                  <span class="text-sm text-slate-600">Enable Tourism Tax</span>
                  <span class="relative inline-flex items-center">
                    <%= f.check_box :tourism_tax_enabled, class: "sr-only peer", data: { action: "change->tourism-tax#toggle", tourism_tax_target: "enabled" } %>
                    <span class="peer h-6 w-11 rounded-full bg-gray-200 transition after:absolute after:left-[2px] after:top-[2px] after:h-5 after:w-5 after:rounded-full after:bg-white after:transition-all after:content-[''] peer-checked:bg-slate-900 peer-checked:after:translate-x-full"></span>
                  </span>
                </label>
                <p class="mt-1 text-xs text-slate-400">RM 10/room/night. Foreign guests only.</p>
              </div>

              <div>
                <%= f.label :tourism_tax_amount, "Tourism Tax Amount (RM)", class: "mb-2 block text-sm font-medium text-slate-900" %>
                <%= f.number_field :tourism_tax_amount, step: 0.01, disabled: !@hotel.tourism_tax_enabled?, class: "w-full rounded-xl border border-slate-200 px-4 py-2.5 text-sm text-slate-700 focus:border-slate-300 focus:outline-none focus:ring-0 disabled:bg-slate-50 disabled:text-slate-500", data: { tourism_tax_target: "amountInput" } %>
              </div>

              <div>
                <span class="mb-2 block text-sm font-medium text-slate-900">Service Tax (SST)</span>
                <label class="flex h-[46px] w-full items-center justify-between rounded-xl border border-slate-200 bg-white px-4">
                  <span class="text-sm text-slate-600">Enable SST (8%)</span>
                  <span class="relative inline-flex items-center">
                    <%= f.check_box :sst_enabled, class: "sr-only peer" %>
                    <span class="peer h-6 w-11 rounded-full bg-gray-200 transition after:absolute after:left-[2px] after:top-[2px] after:h-5 after:w-5 after:rounded-full after:bg-white after:transition-all after:content-[''] peer-checked:bg-slate-900 peer-checked:after:translate-x-full"></span>
                  </span>
                </label>
                <p class="mt-1 text-xs text-slate-400">8% of room subtotal. Applies to all guests.</p>
              </div>
            </div>

            <div class="flex justify-end border-t border-slate-200 pt-4">
              <%= f.submit "Save Tax Settings", class: "inline-flex items-center rounded-lg bg-slate-900 px-4 py-2 text-sm font-semibold text-white transition hover:bg-slate-700" %>
            </div>
          <% end %>
        </div>
      </section>

      <!-- Custom Taxes Card -->
      <section class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">
        <div class="border-b border-slate-200 px-6 py-5 sm:px-8">
          <h2 class="text-lg font-bold tracking-tight text-slate-950 sm:text-xl">Custom Taxes</h2>
          <p class="mt-1 text-sm font-medium text-slate-600">State levies, heritage fees, and other taxes that appear as line items on invoices and receipts.</p>
        </div>

        <div class="px-6 py-5 sm:px-8 grid gap-6 lg:grid-cols-2">
          <!-- Add form -->
          <div>
            <h3 class="mb-4 text-sm font-semibold text-slate-900">Add New Tax</h3>
            <% new_hotel_tax = @presenter.new_hotel_tax %>
            <%= form_with model: [ current_hotel, new_hotel_tax ], local: true, class: "space-y-4" do |f| %>
              <% if new_hotel_tax.errors.any? %>
                <div class="rounded-xl bg-red-50 px-4 py-3 text-sm text-red-700">
                  <%= new_hotel_tax.errors.full_messages.to_sentence %>
                </div>
              <% end %>

              <div>
                <%= f.label :name, "Tax Name", class: "mb-1.5 block text-sm font-medium text-slate-900" %>
                <%= f.text_field :name, placeholder: "e.g. Tourism Tax, Heritage Fee",
                    class: "w-full rounded-xl border border-slate-200 px-4 py-2.5 text-sm text-slate-700 focus:border-slate-300 focus:outline-none focus:ring-0" %>
              </div>

              <div class="grid grid-cols-2 gap-4">
                <div>
                  <%= f.label :rate_type, "Rate Type", class: "mb-1.5 block text-sm font-medium text-slate-900" %>
                  <%= f.select :rate_type, [["Flat (RM)", "flat"], ["Percentage (%)", "percentage"]],
                      {},
                      class: "w-full rounded-xl border border-slate-200 px-4 py-2.5 text-sm text-slate-700 focus:border-slate-300 focus:outline-none focus:ring-0" %>
                </div>
                <div>
                  <%= f.label :amount, "Amount", class: "mb-1.5 block text-sm font-medium text-slate-900" %>
                  <%= f.number_field :amount, step: 0.01, min: 0, placeholder: "e.g. 10.00",
                      class: "w-full rounded-xl border border-slate-200 px-4 py-2.5 text-sm text-slate-700 focus:border-slate-300 focus:outline-none focus:ring-0" %>
                </div>
              </div>

              <div class="flex items-center gap-3">
                <%= f.check_box :foreign_guests_only, class: "h-4 w-4 rounded border-slate-300 text-slate-900" %>
                <%= f.label :foreign_guests_only, "Foreign guests only (e.g. Tourism Tax)", class: "text-sm text-slate-700" %>
              </div>

              <div class="flex justify-end pt-2">
                <%= f.submit "Add Tax",
                    class: "inline-flex items-center rounded-xl bg-slate-900 px-5 py-2.5 text-sm font-semibold text-white hover:bg-slate-700 transition cursor-pointer" %>
              </div>
            <% end %>
          </div>

          <!-- List -->
          <div class="rounded-xl border border-slate-200 overflow-hidden">
            <div class="px-4 py-3 border-b border-slate-100 bg-slate-50">
              <p class="text-xs font-semibold text-slate-500 uppercase tracking-widest">Current Taxes</p>
            </div>
            <% hotel_taxes = @presenter.hotel_taxes %>
            <% if hotel_taxes.empty? %>
              <div class="px-4 py-8 text-center text-sm text-slate-400">No custom taxes configured yet.</div>
            <% else %>
              <ul class="divide-y divide-slate-100">
                <% hotel_taxes.each do |tax| %>
                  <li class="px-4 py-3 flex items-center justify-between gap-4">
                    <div>
                      <p class="text-sm font-semibold text-slate-900"><%= tax.name %></p>
                      <p class="text-xs text-slate-500 mt-0.5">
                        <% if tax.rate_type == "flat" %>
                          MYR <%= sprintf("%.2f", tax.amount) %> flat
                        <% else %>
                          <%= sprintf("%.2f", tax.amount) %>% of room subtotal
                        <% end %>
                        <% if tax.foreign_guests_only? %> · Foreign guests only<% end %>
                        · <span class="<%= tax.enabled? ? 'text-emerald-600' : 'text-slate-400' %>"><%= tax.enabled? ? "Enabled" : "Disabled" %></span>
                      </p>
                    </div>
                    <div class="flex items-center gap-2 shrink-0">
                      <%= form_with model: [ current_hotel, tax ], method: :patch, local: true, class: "inline" do |f| %>
                        <%= f.hidden_field :enabled, value: !tax.enabled %>
                        <%= f.hidden_field :name, value: tax.name %>
                        <%= f.hidden_field :rate_type, value: tax.rate_type %>
                        <%= f.hidden_field :amount, value: tax.amount %>
                        <%= f.submit tax.enabled? ? "Disable" : "Enable",
                            class: "text-xs font-medium px-3 py-1.5 rounded-lg border border-slate-200 hover:bg-slate-50 cursor-pointer" %>
                      <% end %>
                      <%= button_to hotel_hotel_tax_path(current_hotel, tax), method: :delete,
                          data: { turbo_confirm: "Remove #{tax.name}?" },
                          class: "text-xs font-medium px-3 py-1.5 rounded-lg border border-red-100 text-red-600 hover:bg-red-50" do %>
                        Remove
                      <% end %>
                    </div>
                  </li>
                <% end %>
              </ul>
            <% end %>
          </div>
        </div>
      </section>

      <!-- Malaysia Tax Reference -->
      <div data-controller="disclosure">
        <button type="button" data-action="click->disclosure#toggle" class="flex items-center gap-2 text-sm font-medium text-slate-600 hover:text-slate-900 transition">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
          Malaysia Hotel Tax Reference Table
          <svg class="w-3.5 h-3.5 transition-transform" data-disclosure-target="icon" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
