<div class="max-w-5xl mx-auto py-10 px-4 sm:px-6 lg:px-8">
  <div class="mb-6 flex flex-col gap-4 sm:flex-row sm:items-start sm:justify-between">
    <div>
      <h1 class="text-2xl font-bold text-neutral-text-primary">Settings</h1>
      <p class="mt-1 text-sm text-neutral-text-secondary">Update hotel policy, taxes, conversion rate, and banking details.</p>
    </div>

    <%= link_to "Edit Settings", hotel_edit_settings_path, class: "inline-flex items-center gap-x-2 rounded-lg border border-neutral-border bg-white px-4 py-2 text-sm font-semibold text-neutral-text-primary hover:bg-neutral-bg" %>
  </div>

  <% if @settings.present? %>
    <div class="space-y-6">
      <div class="card overflow-hidden">
        <div class="p-5 sm:p-6 border-b border-neutral-border">
          <h2 class="text-lg font-semibold text-neutral-text-primary">Hotel Settings</h2>
          <p class="mt-1 text-sm text-neutral-text-secondary">Control check-in/out timings, currency, and tourism tax.</p>
        </div>

        <div class="p-5 sm:p-6">
          <%= form_with model: @hotel, url: hotel_settings_path, method: :patch, local: true, class: "space-y-6" do |f| %>
            <% settings_errors = @hotel.errors.full_messages + @property_policy.errors.full_messages %>
            <% if settings_errors.any? %>
              <div class="rounded-lg border border-red-200 bg-red-50 p-4 text-sm text-red-700">
                <p class="font-semibold"><%= pluralize(settings_errors.count, "error") %> prohibited these settings from being saved:</p>
                <ul class="mt-2 list-disc space-y-1 ps-5">
                  <% settings_errors.each do |message| %>
                    <li><%= message %></li>
                  <% end %>
                </ul>
              </div>
            <% end %>

            <div class="grid gap-4 md:grid-cols-2">
              <div>
                <%= f.label :hotel_status_display, "Hotel Status", class: "block text-sm font-medium mb-2 text-neutral-text-primary" %>
                <%= f.text_field :hotel_status_display, value: @settings[:hotel_status], disabled: true, class: "w-full rounded-lg border border-neutral-border bg-neutral-bg px-4 py-3 text-sm text-neutral-text-secondary" %>
              </div>

              <div>
                <%= f.label :onboarding_stage_display, "Onboarding Stage", class: "block text-sm font-medium mb-2 text-neutral-text-primary" %>
                <%= f.text_field :onboarding_stage_display, value: @settings[:onboarding_stage], disabled: true, class: "w-full rounded-lg border border-neutral-border bg-neutral-bg px-4 py-3 text-sm text-neutral-text-secondary" %>
              </div>
            </div>

            <div class="grid gap-4 md:grid-cols-2">
              <%= f.fields_for :property_policy_attributes, @property_policy do |property_policy_fields| %>
                <div>
                  <%= property_policy_fields.label :check_in_time, "Standard Check-in Time", class: "block text-sm font-medium mb-2 text-neutral-text-primary" %>
                  <%= property_policy_fields.time_field :check_in_time, class: "w-full rounded-lg border border-neutral-border px-4 py-3 text-sm focus:border-neutral-text-secondary focus:ring-neutral-border" %>
                </div>

                <div>
                  <%= property_policy_fields.label :check_out_time, "Standard Check-out Time", class: "block text-sm font-medium mb-2 text-neutral-text-primary" %>
                  <%= property_policy_fields.time_field :check_out_time, class: "w-full rounded-lg border border-neutral-border px-4 py-3 text-sm focus:border-neutral-text-secondary focus:ring-neutral-border" %>
                </div>
              <% end %>
            </div>

            <div class="grid gap-4 md:grid-cols-2 items-start" data-controller="tourism-tax">
              <div>
                <span class="block text-sm font-medium mb-2 text-neutral-text-primary">Tourism Tax</span>
                <label class="flex h-[46px] w-full items-center justify-between rounded-lg border border-neutral-border bg-white px-4">
                  <span class="text-sm text-neutral-text-secondary">Enable tax</span>
                  <span class="relative inline-flex items-center">
                    <%= f.check_box :tourism_tax_enabled, class: "sr-only peer", data: { action: "change->tourism-tax#toggle", tourism_tax_target: "enabled" } %>
                    <span class="peer h-6 w-11 rounded-full bg-gray-200 transition after:absolute after:left-[2px] after:top-[2px] after:h-5 after:w-5 after:rounded-full after:bg-white after:transition-all after:content-[''] peer-checked:bg-neutral-text-primary peer-checked:after:translate-x-full"></span>
                  </span>
                </label>
              </div>

              <div>
                <%= f.label :tourism_tax_amount, "Tourism Tax Amount", class: "block text-sm font-medium mb-2 text-neutral-text-primary" %>
                <%= f.number_field :tourism_tax_amount, step: 0.01, disabled: !@hotel.tourism_tax_enabled?, class: "w-full rounded-lg border border-neutral-border px-4 py-3 text-sm focus:border-neutral-text-secondary focus:ring-neutral-border disabled:bg-neutral-bg disabled:text-neutral-text-secondary", data: { tourism_tax_target: "amountInput" } %>
              </div>
            </div>

            <div class="grid gap-4 md:grid-cols-2">
              <div>
                <%= f.label :default_currency, "Default Currency", class: "block text-sm font-medium mb-2 text-neutral-text-primary" %>
                <%= f.text_field :default_currency, value: @settings[:default_currency] || "MYR", disabled: true, class: "w-full rounded-lg border border-neutral-border bg-neutral-bg px-4 py-3 text-sm text-neutral-text-secondary" %>
              </div>

              <div>
                <%= f.label :usd_conversion_rate, "USD Conversion Rate", class: "block text-sm font-medium mb-2 text-neutral-text-primary" %>
                <%= f.number_field :usd_conversion_rate, step: 0.0001, value: @settings[:usd_conversion_rate], class: "w-full rounded-lg border border-neutral-border px-4 py-3 text-sm focus:border-neutral-text-secondary focus:ring-neutral-border" %>
              </div>
            </div>

            <div class="flex justify-end pt-4 border-t border-neutral-border">
              <%= f.submit "Save Settings", class: "inline-flex items-center gap-x-2 rounded-lg bg-neutral-text-primary px-4 py-2 text-sm font-semibold text-white hover:bg-neutral-text-secondary" %>
            </div>
          <% end %>
        </div>
      </div>

      <% if current_user.has_permission?("manage_account") %>
        <div class="card overflow-hidden">
          <div class="p-5 sm:p-6 border-b border-neutral-border">
            <h2 class="text-lg font-semibold text-neutral-text-primary">Banking Details</h2>
            <p class="mt-1 text-sm text-neutral-text-secondary">Shared account banking details for payout and settlement.</p>
          </div>

          <div class="p-5 sm:p-6">
            <%= form_with model: @account, url: hotel_settings_path, method: :patch, local: true, class: "space-y-6" do |f| %>
              <% if @account.errors.any? %>
                <div class="rounded-lg border border-red-200 bg-red-50 p-4 text-sm text-red-700">
                  <p class="font-semibold"><%= pluralize(@account.errors.count, "error") %> prohibited these settings from being saved:</p>
                  <ul class="mt-2 list-disc space-y-1 ps-5">
                    <% @account.errors.full_messages.each do |message| %>
                      <li><%= message %></li>
                    <% end %>
                  </ul>
                </div>
              <% end %>

              <%= f.fields_for :banking_detail do |banking_fields| %>
                <%= banking_fields.hidden_field :id if banking_fields.object.persisted? %>

                <div class="grid gap-4 md:grid-cols-2">
                  <div>
                    <%= banking_fields.label :account_holder_name, "Account Holder Name", class: "block text-sm font-medium mb-2 text-neutral-text-primary" %>
                    <%= banking_fields.text_field :account_holder_name, class: "w-full rounded-lg border border-neutral-border px-4 py-3 text-sm focus:border-neutral-text-secondary focus:ring-neutral-border" %>
                  </div>

                  <div>
                    <%= banking_fields.label :bank_name, "Bank Name", class: "block text-sm font-medium mb-2 text-neutral-text-primary" %>
                    <%= banking_fields.text_field :bank_name, class: "w-full rounded-lg border border-neutral-border px-4 py-3 text-sm focus:border-neutral-text-secondary focus:ring-neutral-border" %>
                  </div>

                  <div>
                    <%= banking_fields.label :account_number, "Account Number", class: "block text-sm font-medium mb-2 text-neutral-text-primary" %>
                    <%= banking_fields.text_field :account_number, class: "w-full rounded-lg border border-neutral-border px-4 py-3 text-sm focus:border-neutral-text-secondary focus:ring-neutral-border" %>
                  </div>

                  <div>
                    <%= banking_fields.label :account_type, "Account Type", class: "block text-sm font-medium mb-2 text-neutral-text-primary" %>
                    <%= banking_fields.select :account_type, BankingDetail::ACCOUNT_TYPES.map { |type| [type.titleize, type] }, { include_blank: "Select account type" }, class: "w-full rounded-lg border border-neutral-border px-4 py-3 text-sm focus:border-neutral-text-secondary focus:ring-neutral-border" %>
                  </div>
                </div>
              <% end %>

              <div class="flex justify-end pt-4 border-t border-neutral-border">
                <%= f.submit "Save Banking Details", class: "inline-flex items-center gap-x-2 rounded-lg bg-neutral-text-primary px-4 py-2 text-sm font-semibold text-white hover:bg-neutral-text-secondary" %>
              </div>
            <% end %>
          </div>
        </div>
      <% end %>
    </div>
  <% else %>
    <div class="rounded-2xl border border-dashed border-neutral-border bg-neutral-bg p-10 text-center">
      <h2 class="text-lg font-bold text-neutral-text-primary">No settings yet</h2>
      <p class="mt-2 text-sm text-neutral-text-secondary">Settings will appear once a hotel is selected.</p>
    </div>
  <% end %>
</div>
