<% content_for :breadcrumbs do %>
  <div class="flex items-center gap-x-2">
    <span class="text-sm font-medium text-slate-600"><%= current_hotel.name %></span>
    <span class="text-sm text-slate-400">/</span>
    <span class="text-sm font-semibold text-slate-900">Settings</span>
  </div>
<% end %>

<div class="max-w-[1600px] mx-auto pb-20 space-y-8">
  <div class="px-4 md:px-0">
    <div class="mt-5">
      <h1 class="text-2xl font-bold tracking-tight text-slate-950 sm:text-3xl">Settings</h1>
      <p class="mt-1 text-sm font-medium text-slate-600">Update hotel policy, taxes, conversion rate, banking details, and payment gateway credentials.</p>
    </div>
  </div>

  <% if @settings.present? %>
    <div class="space-y-6 px-4 md:px-0">
      <section class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">
        <div class="border-b border-slate-200 px-6 py-5 sm:px-8">
          <h2 class="text-lg font-bold tracking-tight text-slate-950 sm:text-xl">Hotel Settings</h2>
          <p class="mt-1 text-sm font-medium text-slate-600">Control check-in/out timings, currency, and tourism tax.</p>
        </div>

        <div class="px-6 py-5 sm:px-8">
          <%= form_with model: @hotel, url: hotel_settings_path(@hotel), method: :patch, local: true, class: "space-y-6" do |f| %>
            <% settings_errors = @hotel.errors.full_messages + @property_policy.errors.full_messages %>
            <% if settings_errors.any? %>
              <div class="rounded-lg border border-red-200 bg-red-50 p-4 text-sm text-red-700">
                <p class="font-semibold"><%= pluralize(settings_errors.count, "error") %> prohibited these settings from being saved:</p>
                <ul class="mt-2 list-disc space-y-1 ps-5">
                  <% settings_errors.each do |message| %>
                    <li><%= message %></li>
                  <% end %>
                </ul>
              </div>
            <% end %>

            <div class="grid gap-4 md:grid-cols-2">
              <div>
                <%= f.label :hotel_status_display, "Hotel Status", class: "mb-2 block text-sm font-medium text-slate-900" %>
                <%= f.text_field :hotel_status_display, value: @settings[:hotel_status], disabled: true, class: "w-full rounded-xl border border-slate-200 bg-slate-50 px-4 py-2.5 text-sm text-slate-500" %>
              </div>

              <div>
                <%= f.label :onboarding_stage_display, "Onboarding Stage", class: "mb-2 block text-sm font-medium text-slate-900" %>
                <%= f.text_field :onboarding_stage_display, value: @settings[:onboarding_stage], disabled: true, class: "w-full rounded-xl border border-slate-200 bg-slate-50 px-4 py-2.5 text-sm text-slate-500" %>
              </div>
            </div>

            <div class="grid gap-4 md:grid-cols-2">
              <%= f.fields_for :property_policy_attributes, @property_policy do |property_policy_fields| %>
                <div>
                  <%= property_policy_fields.label :check_in_time, "Standard Check-in Time", class: "mb-2 block text-sm font-medium text-slate-900" %>
                  <%= property_policy_fields.time_field :check_in_time, class: "w-full rounded-xl border border-slate-200 px-4 py-2.5 text-sm text-slate-700 focus:border-slate-300 focus:outline-none focus:ring-0" %>
                </div>

                <div>
                  <%= property_policy_fields.label :check_out_time, "Standard Check-out Time", class: "mb-2 block text-sm font-medium text-slate-900" %>
                  <%= property_policy_fields.time_field :check_out_time, class: "w-full rounded-xl border border-slate-200 px-4 py-2.5 text-sm text-slate-700 focus:border-slate-300 focus:outline-none focus:ring-0" %>
                </div>
              <% end %>
            </div>

            <div class="grid items-start gap-4 md:grid-cols-2" data-controller="tourism-tax">
              <div>
                <span class="mb-2 block text-sm font-medium text-slate-900">Tourism Tax</span>
                <label class="flex h-[46px] w-full items-center justify-between rounded-xl border border-slate-200 bg-white px-4">
                  <span class="text-sm text-slate-600">Enable tax</span>
                  <span class="relative inline-flex items-center">
                    <%= f.check_box :tourism_tax_enabled, class: "sr-only peer", data: { action: "change->tourism-tax#toggle", tourism_tax_target: "enabled" } %>
                    <span class="peer h-6 w-11 rounded-full bg-gray-200 transition after:absolute after:left-[2px] after:top-[2px] after:h-5 after:w-5 after:rounded-full after:bg-white after:transition-all after:content-[''] peer-checked:bg-slate-900 peer-checked:after:translate-x-full"></span>
                  </span>
                </label>
              </div>

              <div>
                <%= f.label :tourism_tax_amount, "Tourism Tax Amount", class: "mb-2 block text-sm font-medium text-slate-900" %>
                <%= f.number_field :tourism_tax_amount, step: 0.01, disabled: !@hotel.tourism_tax_enabled?, class: "w-full rounded-xl border border-slate-200 px-4 py-2.5 text-sm text-slate-700 focus:border-slate-300 focus:outline-none focus:ring-0 disabled:bg-slate-50 disabled:text-slate-500", data: { tourism_tax_target: "amountInput" } %>
              </div>
            </div>

            <div class="grid gap-4 md:grid-cols-2">
              <div>
                <%= f.label :default_currency, "Default Currency", class: "mb-2 block text-sm font-medium text-slate-900" %>
                <%= f.text_field :default_currency, value: @settings[:default_currency] || "MYR", disabled: true, class: "w-full rounded-xl border border-slate-200 bg-slate-50 px-4 py-2.5 text-sm text-slate-500" %>
              </div>

              <div>
                <%= f.label :usd_conversion_rate, "USD Conversion Rate", class: "mb-2 block text-sm font-medium text-slate-900" %>
                <%= f.number_field :usd_conversion_rate, step: 0.0001, value: @settings[:usd_conversion_rate], class: "w-full rounded-xl border border-slate-200 px-4 py-2.5 text-sm text-slate-700 focus:border-slate-300 focus:outline-none focus:ring-0" %>
              </div>
            </div>

            <div class="flex justify-end border-t border-slate-200 pt-4">
              <%= f.submit "Save Settings", class: "inline-flex items-center rounded-lg bg-slate-900 px-4 py-2 text-sm font-semibold text-white transition hover:bg-slate-700" %>
            </div>
          <% end %>
        </div>
      </section>

      <% if current_user.has_permission?("manage_account") %>
        <section class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">
          <div class="border-b border-slate-200 px-6 py-5 sm:px-8">
            <h2 class="text-lg font-bold tracking-tight text-slate-950 sm:text-xl">Banking Details</h2>
            <p class="mt-1 text-sm font-medium text-slate-600">Shared account banking details for payout and settlement.</p>
          </div>

          <div class="px-6 py-5 sm:px-8">
            <%= form_with model: @account, url: hotel_settings_path(@hotel), method: :patch, local: true, class: "space-y-6" do |f| %>
              <% if @account.errors.any? %>
                <div class="rounded-lg border border-red-200 bg-red-50 p-4 text-sm text-red-700">
                  <p class="font-semibold"><%= pluralize(@account.errors.count, "error") %> prohibited these settings from being saved:</p>
                  <ul class="mt-2 list-disc space-y-1 ps-5">
                    <% @account.errors.full_messages.each do |message| %>
                      <li><%= message %></li>
                    <% end %>
                  </ul>
                </div>
              <% end %>

              <%= f.fields_for :banking_detail do |banking_fields| %>
                <%= banking_fields.hidden_field :id if banking_fields.object.persisted? %>

                <div class="grid gap-4 md:grid-cols-2">
                  <div>
                    <%= banking_fields.label :account_holder_name, "Account Holder Name", class: "mb-2 block text-sm font-medium text-slate-900" %>
                    <%= banking_fields.text_field :account_holder_name, class: "w-full rounded-xl border border-slate-200 px-4 py-2.5 text-sm text-slate-700 focus:border-slate-300 focus:outline-none focus:ring-0" %>
                  </div>

                  <div>
                    <%= banking_fields.label :bank_name, "Bank Name", class: "mb-2 block text-sm font-medium text-slate-900" %>
                    <%= banking_fields.text_field :bank_name, class: "w-full rounded-xl border border-slate-200 px-4 py-2.5 text-sm text-slate-700 focus:border-slate-300 focus:outline-none focus:ring-0" %>
                  </div>

                  <div>
                    <%= banking_fields.label :account_number, "Account Number", class: "mb-2 block text-sm font-medium text-slate-900" %>
                    <%= banking_fields.text_field :account_number, class: "w-full rounded-xl border border-slate-200 px-4 py-2.5 text-sm text-slate-700 focus:border-slate-300 focus:outline-none focus:ring-0" %>
                  </div>
                </div>
              <% end %>

              <div class="flex justify-end border-t border-slate-200 pt-4">
                <%= f.submit "Save Banking Details", class: "inline-flex items-center rounded-lg bg-slate-900 px-4 py-2 text-sm font-semibold text-white transition hover:bg-slate-700" %>
              </div>
            <% end %>
          </div>
        </section>
      <% end %>

      <% if current_user.has_permission?("manage_hotel_profile", hotel: current_hotel) %>
        <section class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">
          <div class="border-b border-slate-200 px-6 py-5 sm:px-8">
            <h2 class="text-lg font-bold tracking-tight text-slate-950 sm:text-xl">Payment Gateway Configuration</h2>
            <p class="mt-1 text-sm font-medium text-slate-600">Set hotel-level payment gateway credentials. These override account defaults for this hotel only.</p>
          </div>

          <div class="px-6 py-5 sm:px-8">
            <%= form_with model: @payment_setting, url: hotel_settings_path(@hotel), method: :patch, local: true, class: "space-y-6" do |f| %>
              <% if @payment_setting.errors.any? %>
                <div class="rounded-lg border border-red-200 bg-red-50 p-4 text-sm text-red-700">
                  <p class="font-semibold"><%= pluralize(@payment_setting.errors.count, "error") %> prohibited this configuration from being saved:</p>
                  <ul class="mt-2 list-disc space-y-1 ps-5">
                    <% @payment_setting.errors.full_messages.each do |message| %>
                      <li><%= message %></li>
                    <% end %>
                  </ul>
                </div>
              <% end %>

              <%= f.hidden_field :id if @payment_setting.persisted? %>

              <div class="grid gap-4 md:grid-cols-2">
                <div>
                  <%= f.label :gateway, "Gateway", class: "mb-2 block text-sm font-medium text-slate-900" %>
                  <%= f.select :gateway,
                               options_for_select([["Razorpay", "razorpay"]], "razorpay"),
                               {},
                               class: "w-full rounded-xl border border-slate-200 bg-white px-4 py-2.5 text-sm text-slate-700 focus:border-slate-300 focus:outline-none focus:ring-0" %>
                </div>

                <div>
                  <%= f.label :status, "Status", class: "mb-2 block text-sm font-medium text-slate-900" %>
                  <%= f.select :status,
                               options_for_select(PaymentSetting::STATUSES.map { |value| [value.titleize, value] }, @payment_setting.status || "active"),
                               {},
                               class: "w-full rounded-xl border border-slate-200 bg-white px-4 py-2.5 text-sm text-slate-700 focus:border-slate-300 focus:outline-none focus:ring-0" %>
                </div>
              </div>

              <div class="grid gap-4 md:grid-cols-3">
                <div>
                  <%= f.label :api_key, "API Key", class: "mb-2 block text-sm font-medium text-slate-900" %>
                  <div class="relative" data-credential-toggle-root>
                    <%= f.password_field :api_key,
                                         value: @payment_setting.api_key,
                                         class: "w-full rounded-xl border border-slate-200 px-4 py-2.5 pr-12 text-sm text-slate-700 focus:border-slate-300 focus:outline-none focus:ring-0",
                                         autocomplete: "off",
                                         data: { credential_toggle_input: true } %>
                    <button type="button"
                            class="absolute inset-y-0 right-3 inline-flex items-center text-slate-500 hover:text-slate-700"
                            data-credential-toggle-button
                            aria-label="Toggle API key visibility">
                      <svg data-credential-toggle-icon-hidden class="size-5" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75" d="M3 12s3-6 9-6 9 6 9 6-3 6-9 6-9-6-9-6z" />
                        <circle cx="12" cy="12" r="3" stroke-width="1.75"></circle>
                      </svg>
                      <svg data-credential-toggle-icon-shown class="hidden size-5" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75" d="M4 4l16 16M10.6 10.6a2 2 0 0 0 2.8 2.8M9.9 5.1A9.8 9.8 0 0 1 12 5c6 0 9 7 9 7a16.7 16.7 0 0 1-3 3.8M6.1 6.1A16.8 16.8 0 0 0 3 12s3 7 9 7a9.7 9.7 0 0 0 4.1-.9" />
                      </svg>
                    </button>
                  </div>
                </div>

                <div>
                  <%= f.label :secret_key, "Secret Key", class: "mb-2 block text-sm font-medium text-slate-900" %>
                  <div class="relative" data-credential-toggle-root>
                    <%= f.password_field :secret_key,
                                         value: @payment_setting.secret_key,
                                         class: "w-full rounded-xl border border-slate-200 px-4 py-2.5 pr-12 text-sm text-slate-700 focus:border-slate-300 focus:outline-none focus:ring-0",
                                         autocomplete: "off",
                                         data: { credential_toggle_input: true } %>
                    <button type="button"
                            class="absolute inset-y-0 right-3 inline-flex items-center text-slate-500 hover:text-slate-700"
                            data-credential-toggle-button
                            aria-label="Toggle secret key visibility">
                      <svg data-credential-toggle-icon-hidden class="size-5" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75" d="M3 12s3-6 9-6 9 6 9 6-3 6-9 6-9-6-9-6z" />
                        <circle cx="12" cy="12" r="3" stroke-width="1.75"></circle>
                      </svg>
                      <svg data-credential-toggle-icon-shown class="hidden size-5" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75" d="M4 4l16 16M10.6 10.6a2 2 0 0 0 2.8 2.8M9.9 5.1A9.8 9.8 0 0 1 12 5c6 0 9 7 9 7a16.7 16.7 0 0 1-3 3.8M6.1 6.1A16.8 16.8 0 0 0 3 12s3 7 9 7a9.7 9.7 0 0 0 4.1-.9" />
                      </svg>
                    </button>
                  </div>
                </div>

                <div>
                  <%= f.label :webhook_secret, "Webhook Secret", class: "mb-2 block text-sm font-medium text-slate-900" %>
                  <div class="relative" data-credential-toggle-root>
                    <%= f.password_field :webhook_secret,
                                         value: @payment_setting.webhook_secret,
                                         class: "w-full rounded-xl border border-slate-200 px-4 py-2.5 pr-12 text-sm text-slate-700 focus:border-slate-300 focus:outline-none focus:ring-0",
                                         autocomplete: "off",
                                         data: { credential_toggle_input: true } %>
                    <button type="button"
                            class="absolute inset-y-0 right-3 inline-flex items-center text-slate-500 hover:text-slate-700"
                            data-credential-toggle-button
                            aria-label="Toggle webhook secret visibility">
                      <svg data-credential-toggle-icon-hidden class="size-5" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75" d="M3 12s3-6 9-6 9 6 9 6-3 6-9 6-9-6-9-6z" />
                        <circle cx="12" cy="12" r="3" stroke-width="1.75"></circle>
                      </svg>
                      <svg data-credential-toggle-icon-shown class="hidden size-5" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75" d="M4 4l16 16M10.6 10.6a2 2 0 0 0 2.8 2.8M9.9 5.1A9.8 9.8 0 0 1 12 5c6 0 9 7 9 7a16.7 16.7 0 0 1-3 3.8M6.1 6.1A16.8 16.8 0 0 0 3 12s3 7 9 7a9.7 9.7 0 0 0 4.1-.9" />
                      </svg>
                    </button>
                  </div>
                  <p class="mt-1 text-xs font-medium text-slate-500">Optional during local testing, required for secure webhook validation in production.</p>
                </div>
              </div>

              <div class="flex justify-end border-t border-slate-200 pt-4">
                <%= f.submit "Save Payment Gateway", class: "inline-flex items-center rounded-lg bg-slate-900 px-4 py-2 text-sm font-semibold text-white transition hover:bg-slate-700" %>
              </div>
            <% end %>
          </div>
        </section>
      <% end %>
    </div>
  <% else %>
    <div class="mx-4 rounded-2xl border border-dashed border-slate-300 bg-white p-10 text-center md:mx-0">
      <h2 class="text-lg font-bold text-slate-900">No settings yet</h2>
      <p class="mt-2 text-sm text-slate-600">Settings will appear once a hotel is selected.</p>
    </div>
  <% end %>
</div>

<script>
  (function() {
    const roots = document.querySelectorAll("[data-credential-toggle-root]");
    if (!roots.length) return;

    roots.forEach(function(root) {
      const input = root.querySelector("[data-credential-toggle-input]");
      const button = root.querySelector("[data-credential-toggle-button]");
      const iconHidden = root.querySelector("[data-credential-toggle-icon-hidden]");
      const iconShown = root.querySelector("[data-credential-toggle-icon-shown]");
      if (!input || !button || !iconHidden || !iconShown) return;

      button.addEventListener("click", function() {
        const reveal = input.type === "password";
        input.type = reveal ? "text" : "password";
        iconHidden.classList.toggle("hidden", reveal);
        iconShown.classList.toggle("hidden", !reveal);
      });
    });
  })();
</script>
