<div class="space-y-6">
  <div class="card">
    <div class="p-4 border-b border-neutral-border">
      <h1 class="text-lg font-bold text-neutral-text-primary">Settings</h1>
    </div>

    <div class="p-4">
      <% if @settings.present? %>
        <%= form_with model: @hotel, url: hotel_settings_path(@hotel), method: :patch, local: true, class: "space-y-4" do |f| %>
          <% settings_errors = @hotel.errors.full_messages + @property_policy.errors.full_messages %>
          <% if settings_errors.any? %>
            <div class="p-4 rounded-lg bg-red-50 text-red-600 border border-red-200">
              <h2 class="text-sm font-bold mb-2"><%= pluralize(settings_errors.count, "error") %> prohibited these settings from being saved:</h2>
              <ul class="list-disc list-inside text-xs">
                <% settings_errors.each do |message| %>
                  <li><%= message %></li>
                <% end %>
              </ul>
            </div>
          <% end %>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <div>
              <%= f.label :hotel_status, "Hotel Status", class: "block text-sm font-medium mb-2 text-gray-700" %>
              <%= f.text_field :hotel_status, value: @settings[:hotel_status], disabled: true, class: "py-3 px-4 block w-full border-gray-200 rounded-lg text-sm focus:border-blue-500 focus:ring-blue-500 border bg-gray-50 text-gray-500" %>
            </div>

            <div>
              <%= f.label :onboarding_stage, "Onboarding Stage", class: "block text-sm font-medium mb-2 text-gray-700" %>
              <%= f.text_field :onboarding_stage, value: @settings[:onboarding_stage], disabled: true, class: "py-3 px-4 block w-full border-gray-200 rounded-lg text-sm focus:border-blue-500 focus:ring-blue-500 border bg-gray-50 text-gray-500" %>
            </div>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-4 gap-4 items-start" data-controller="tourism-tax">
            <%= f.fields_for :property_policy_attributes, @property_policy do |property_policy_fields| %>
              <div>
                <%= property_policy_fields.label :check_in_time, "Standard Check-in Time", class: "block text-sm font-medium mb-2 text-gray-700" %>
                <%= property_policy_fields.time_field :check_in_time, class: "py-3 px-4 block w-full border-gray-200 rounded-lg text-sm focus:border-blue-500 focus:ring-blue-500 border" %>
              </div>

              <div>
                <%= property_policy_fields.label :check_out_time, "Standard Check-out Time", class: "block text-sm font-medium mb-2 text-gray-700" %>
                <%= property_policy_fields.time_field :check_out_time, class: "py-3 px-4 block w-full border-gray-200 rounded-lg text-sm focus:border-blue-500 focus:ring-blue-500 border" %>
              </div>
            <% end %>

            <div>
              <span class="block text-sm font-medium mb-2 text-gray-700">Tourism Tax</span>
              <label class="flex h-[46px] w-full items-center justify-between rounded-lg border border-gray-200 bg-white px-4 cursor-pointer">
                <span class="text-sm text-gray-700">Enable tax</span>
                <span class="relative inline-flex items-center">
                  <%= f.check_box :tourism_tax_enabled, class: "sr-only peer", data: { action: "change->tourism-tax#toggle", tourism_tax_target: "enabled" } %>
                  <span class="w-11 h-6 bg-gray-200 peer-focus:outline-none peer-focus:ring-4 peer-focus:ring-brand-primary/20 rounded-full peer peer-checked:bg-brand-primary after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border after:border-gray-300 after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:after:translate-x-full peer-checked:after:border-white"></span>
                </span>
              </label>
            </div>

            <div>
              <%= f.label :tourism_tax_amount, "Tourism Tax Amount", class: "block text-sm font-medium mb-2 text-gray-700" %>
              <%= f.number_field :tourism_tax_amount, step: 0.01, disabled: !@hotel.tourism_tax_enabled?, class: "py-3 px-4 block w-full border-gray-200 rounded-lg text-sm focus:border-blue-500 focus:ring-blue-500 border disabled:bg-gray-50 disabled:text-gray-400", data: { tourism_tax_target: "amountInput" } %>
            </div>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <div>
              <%= f.label :default_currency, "Default Currency", class: "block text-sm font-medium mb-2 text-gray-700" %>
              <%= f.text_field :default_currency, value: "MYR", disabled: true, class: "py-3 px-4 block w-full border-gray-200 rounded-lg text-sm border bg-gray-50 text-gray-500" %>
            </div>

            <div>
              <%= f.label :usd_conversion_rate, "USD Conversion Rate", class: "block text-sm font-medium mb-2 text-gray-700" %>
              <%= f.number_field :usd_conversion_rate, step: 0.01, class: "py-3 px-4 block w-full border-gray-200 rounded-lg text-sm focus:border-blue-500 focus:ring-blue-500 border" %>
            </div>
          </div>

          <div class="flex justify-end pt-4 border-t border-gray-100">
            <%= f.submit "Save Settings", class: "py-2 px-4 inline-flex items-center gap-x-2 text-sm font-semibold rounded-lg border border-transparent bg-blue-600 text-white hover:bg-blue-700 transition" %>
          </div>
        <% end %>
      <% else %>
        <p class="text-sm text-neutral-text-secondary">Settings will appear once a hotel is selected.</p>
      <% end %>
    </div>
  </div>

  <div class="card">
    <div class="p-4 border-b border-neutral-border">
      <h2 class="text-lg font-bold text-neutral-text-primary">Banking Details</h2>
      <p class="text-sm text-neutral-text-secondary mt-1">Shared account banking details for payout and settlement.</p>
    </div>

    <div class="p-4">
      <%= form_with model: @account, url: hotel_settings_path(@hotel), method: :patch, local: true, class: "space-y-6" do |f| %>
        <% if @account.errors.any? %>
          <div class="p-4 rounded-lg bg-red-50 text-red-600 border border-red-200">
            <h2 class="text-sm font-bold mb-2"><%= pluralize(@account.errors.count, "error") %> prohibited these settings from being saved:</h2>
            <ul class="list-disc list-inside text-xs">
              <% @account.errors.full_messages.each do |message| %>
                <li><%= message %></li>
              <% end %>
            </ul>
          </div>
        <% end %>

        <%= f.fields_for :banking_detail do |banking_fields| %>
          <%= banking_fields.hidden_field :id if banking_fields.object&.persisted? %>

          <div class="grid sm:grid-cols-2 gap-4">
            <div>
              <label class="block text-sm font-medium mb-2 text-gray-700">Account Holder Name</label>
              <%= banking_fields.text_field :account_holder_name, class: "py-3 px-4 block w-full border-gray-200 rounded-lg text-sm focus:border-blue-500 focus:ring-blue-500 border" %>
              <p class="mt-1 text-xs text-gray-500">Use the exact business or account holder name shown on the bank account.</p>
            </div>

            <div>
              <label class="block text-sm font-medium mb-2 text-gray-700">Bank Name</label>
              <%= banking_fields.text_field :bank_name, class: "py-3 px-4 block w-full border-gray-200 rounded-lg text-sm focus:border-blue-500 focus:ring-blue-500 border" %>
            </div>

            <div>
              <label class="block text-sm font-medium mb-2 text-gray-700">Account Number</label>
              <%= banking_fields.text_field :account_number, class: "py-3 px-4 block w-full border-gray-200 rounded-lg text-sm focus:border-blue-500 focus:ring-blue-500 border" %>
              <p class="mt-1 text-xs text-gray-500">Spaces and hyphens are allowed.</p>
            </div>

            <div>
              <label class="block text-sm font-medium mb-2 text-gray-700">Account Type</label>
              <%= banking_fields.select :account_type, BankingDetail::ACCOUNT_TYPES.map { |type| [type.titleize, type] }, { include_blank: "Select account type" }, class: "py-3 px-4 block w-full border-gray-200 rounded-lg text-sm focus:border-blue-500 focus:ring-blue-500 border" %>
            </div>
          </div>
        <% end %>

        <div class="flex justify-end pt-4 border-t border-gray-100">
          <%= f.submit "Save Banking Details", class: "py-2 px-4 inline-flex items-center gap-x-2 text-sm font-semibold rounded-lg border border-transparent bg-blue-600 text-white hover:bg-blue-700 transition" %>
        </div>
      <% end %>
    </div>
  </div>
</div>
