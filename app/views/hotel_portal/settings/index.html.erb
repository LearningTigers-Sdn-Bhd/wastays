<div class="space-y-5">
  <div class="space-y-4">
    <%= render PanelsUI::PageHeader.new(title: @presenter.page_title, description: @presenter.page_description) %>
    <%= render "hotel_portal/settings/group_tabs" %>
  </div>

  <% if @presenter %>

    <% case @presenter.active_page %>
    <% when "general" %>
      <%= render "hotel_portal/settings/general_section" %>
    <% when "ota_logins" %>
      <%= render "hotel_portal/settings/ota_logins_section" %>
    <% when "boat" %>
      <%= render "hotel_portal/settings/boat_section" %>
    <% when "notifications" %>
      <%= render "hotel_portal/settings/notifications_section" %>
    <% when "banking" %>
      <%= render "hotel_portal/settings/banking_section" %>
    <% when "e_invoice" %>
      <%= render "hotel_portal/settings/e_invoice_section" %>
    <% end %>
  <% else %>
    <section class="space-y-2 py-10 text-center" aria-labelledby="empty-settings-title">
      <h2 id="empty-settings-title" class="text-base font-semibold text-foreground">No settings yet</h2>
      <p class="text-sm text-muted-foreground">Settings will appear once a hotel is selected.</p>
    </section>
  <% end %>
</div>
