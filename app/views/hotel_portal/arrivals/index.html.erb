<div class="w-full space-y-8">
 <div>
    <div class="flex flex-col md:flex-row md:items-end md:justify-between gap-4">
      <div>
        <h1 class="text-2xl font-bold tracking-tight text-foreground sm:text-3xl">Arrival Board</h1>
        <p class="mt-1 text-sm font-medium text-muted-foreground">Track and manage guest arrivals for <%= arrivals_header_date(@date) %>.</p>
      </div>

      <div class="flex flex-col w-full gap-2 sm:flex-row sm:items-center sm:w-auto">
        <div class="inline-flex w-full sm:w-auto bg-muted rounded-xl p-1 shadow-sm border border-border">
          <%= link_to hotel_arrivals_path(current_hotel, date: Date.today, q: @query.presence),
              class: "flex-1 sm:flex-none py-1.5 px-4 inline-flex items-center justify-center gap-x-2 text-sm font-semibold rounded-lg transition #{ @date == Date.today ? 'bg-card shadow-sm text-foreground' : 'text-muted-foreground hover:text-foreground' }" do %>
            Today
            <span class="inline-flex items-center py-0.5 px-1.5 rounded-full text-[10px] font-bold bg-muted text-foreground"><%= @today_count %></span>
          <% end %>
          <%= link_to hotel_arrivals_path(current_hotel, date: Date.tomorrow, q: @query.presence),
              class: "flex-1 sm:flex-none py-1.5 px-4 inline-flex items-center justify-center gap-x-2 text-sm font-semibold rounded-lg transition #{ @date == Date.tomorrow ? 'bg-card shadow-sm text-foreground' : 'text-muted-foreground hover:text-foreground' }" do %>
            Tomorrow
            <span class="inline-flex items-center py-0.5 px-1.5 rounded-full text-[10px] font-bold bg-muted text-foreground"><%= @tomorrow_count %></span>
          <% end %>
        </div>

        <%= form_with url: hotel_arrivals_path(current_hotel), method: :get, class: "flex items-center w-full sm:w-auto" do |f| %>
          <%= f.hidden_field :q, value: @query %>
          <%= f.date_field :date, value: @date, onchange: "this.form.submit()",
              class: "w-full sm:w-auto rounded-xl border border-border bg-card px-3 py-2.5 text-sm font-medium text-foreground focus:border-border-interactive focus:outline-none focus:ring-0 shadow-sm" %>
        <% end %>
      </div>
    </div>
  </div>

  <div class="overflow-hidden rounded-2xl border border-border bg-card shadow-sm">
    <div class="flex items-center justify-between border-b border-border px-8 py-6">
      <div>
        <h2 class="text-lg font-bold tracking-tight text-foreground sm:text-xl">Expected Arrivals</h2>
        <p class="mt-1 text-sm font-medium text-muted-foreground">Guests scheduled to arrive at your property.</p>
      </div>
      <span class="text-sm font-medium text-muted-foreground">Total Arrivals <span class="font-semibold text-foreground"><%= @all_arrivals.count %></span></span>
    </div>

    <div class="border-b border-border bg-muted/70 px-8 py-5">
      <%= form_with url: hotel_arrivals_path(current_hotel), method: :get, class: "flex flex-col gap-3 xl:flex-row xl:items-center xl:justify-between", data: { controller: "auto-submit" } do |f| %>
        <%= f.hidden_field :date, value: @date %>
        <div class="flex w-full flex-col gap-3 lg:flex-row">
          <label class="relative block flex-1">
            <span class="sr-only">Search arrivals</span>
            <span class="pointer-events-none absolute inset-y-0 left-0 flex items-center pl-4 text-muted-foreground">
              <%= cached_icon "search", class: "size-4" %>
            </span>
            <%= f.search_field :q,
                               value: @query,
                               id: "arrivals-search",
                               placeholder: "Search guest, contact, or booking reference",
                               class: "w-full rounded-xl border border-border bg-card py-2.5 pl-11 pr-4 text-sm text-foreground placeholder:text-muted-foreground focus:border-border-interactive focus:outline-none focus:ring-0",
                               data: { action: "input->auto-submit#submit" } %>
          </label>
        </div>

        <div class="flex items-center gap-2">
          <% if @query.present? %>
            <%= link_to "Clear", hotel_arrivals_path(current_hotel, date: @date), class: "inline-flex items-center rounded-lg border border-border bg-card px-3 py-2 text-sm font-semibold text-foreground shadow-sm transition hover:border-border-interactive hover:bg-muted" %>
          <% end %>
        </div>
      <% end %>
    </div>

    <div class="hidden lg:block overflow-x-auto">
      <table class="min-w-full table-fixed">
        <colgroup>
          <col class="w-[22%]">
          <col class="w-[20%]">
          <col class="w-[12%]">
          <col class="w-[14%]">
          <col class="w-[12%]">
          <col class="w-[20%]">
        </colgroup>
        <thead class="bg-muted">
          <tr>
            <th scope="col" class="px-8 py-4 text-left text-[11px] font-semibold uppercase tracking-[0.1em] text-muted-foreground sm:px-8">Guest / Reference</th>
            <th scope="col" class="px-8 py-4 text-left text-[11px] font-semibold uppercase tracking-[0.1em] text-muted-foreground">Room Details</th>
            <th scope="col" class="px-8 py-4 text-left text-[11px] font-semibold uppercase tracking-[0.1em] text-muted-foreground">Pre-Checkin</th>
            <th scope="col" class="px-8 py-4 text-left text-[11px] font-semibold uppercase tracking-[0.1em] text-muted-foreground">Guarantee</th>
            <th scope="col" class="px-8 py-4 text-left text-[11px] font-semibold uppercase tracking-[0.1em] text-muted-foreground">Docs / Notes</th>
            <th scope="col" class="px-8 py-4 text-right text-[11px] font-semibold uppercase tracking-[0.1em] text-muted-foreground sm:px-8">Action</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-border bg-card">
          <% if @arrivals.any? %>
            <% @arrivals.each_with_index do |booking, index| %>
              <% presenter = HotelPortal::ArrivalPresenter.new(booking, current_hotel) %>
              <tr class="align-top <%= presenter.blacklisted? ? 'bg-rose-100' : (index.even? ? 'bg-card hover:bg-muted/80 transition-colors' : 'bg-muted/55 hover:bg-muted/80 transition-colors') %>">
                <td class="py-5 pr-8 <%= presenter.blacklisted? ? 'border-l-4 border-l-rose-600 pl-7' : 'pl-8' %>">
                  <div class="flex flex-col gap-1.5">
                    <div class="flex items-center gap-x-1.5">
                      <span class="text-sm font-semibold text-foreground"><%= presenter.guest_name %></span>
                      <% if presenter.vip? %>
                        <%= cached_icon "crown-simple", library: "phosphor", variant: "duotone", class: "size-4 text-amber-500 fill-amber-500 shrink-0" %>
                      <% end %>
                      <% if presenter.blacklisted? %>
                        <div class="relative size-4 flex items-center justify-center shrink-0">
                          <%= cached_icon "user", library: "phosphor", variant: "light", class: "size-3.5 text-rose-600" %>
                          <%= cached_icon "ban", class: "absolute inset-0 size-4 text-rose-600" %>
                        </div>
                      <% end %>
                      <% if presenter.repeat? %>
                        <%= cached_icon "repeat", library: "lucide", variant: "outline", class: "size-4 text-blue-500 shrink-0" %>
                      <% end %>
                    </div>
                    <span class="text-xs font-mono text-muted-foreground"><%= presenter.confirmation_token %></span>
                  </div>
                </td>
                <td class="px-8 py-5">
                  <div class="flex flex-col gap-2">
                    <% presenter.rooms_summary.each do |room_summary_text| %>
                      <span class="text-sm text-foreground"><%= room_summary_text %></span>
                    <% end %>
                    <div class="flex items-center gap-x-3 text-xs text-muted-foreground">
                      <span class="inline-flex items-center gap-x-1">
                        <%= cached_icon "user", class: "w-3.5 h-3.5" %>
                        <%= presenter.adults %>
                      </span>
                      <span class="inline-flex items-center gap-x-1">
                        <%= cached_icon "baby", class: "w-3.5 h-3.5" %>
                        <%= presenter.children %>
                      </span>
                      <% if presenter.status == 'checked_in' %>
                        <span class="inline-flex items-center gap-x-1 font-medium text-emerald-700">
                          <%= cached_icon "bed", class: "w-3.5 h-3.5" %>
                          <%= presenter.room_number_label %>
                        </span>
                      <% end %>
                    </div>
                  </div>
                </td>
                <td class="px-8 py-5 whitespace-nowrap">
                  <span class="inline-flex items-center rounded-full border px-2.5 py-1 text-[11px] font-semibold <%= presenter.pre_checkin_badge_class %>">
                    <%= presenter.pre_checkin_status_label %>
                  </span>
                </td>
                <td class="px-8 py-5 whitespace-nowrap">
                  <div class="flex flex-col gap-0.5">
                    <span class="text-sm font-medium text-foreground"><%= presenter.guarantee_method_display %></span>
                    <span class="text-[11px] font-bold uppercase tracking-wider text-muted-foreground"><%= presenter.deposit_status_label %></span>
                  </div>
                </td>
                <td class="px-8 py-5">
                  <div class="flex items-center gap-x-2">
                    <% if presenter.document_uploaded? %>
                      <span class="text-emerald-600" title="Documents Uploaded">
                        <%= cached_icon "shield-check", class: "w-4 h-4" %>
                      </span>
                    <% else %>
                      <span class="text-primary-foreground">
                        <%= cached_icon "file-x", class: "w-4 h-4" %>
                      </span>
                    <% end %>

                    <% if presenter.has_notes? %>
                      <span class="text-blue-600" title="<%= presenter.notes_count_label %>">
                        <%= cached_icon "message-square", class: "w-4 h-4" %>
                      </span>
                    <% end %>
                  </div>
                </td>
                <td class="px-8 py-5 text-right whitespace-nowrap sm:px-8">
                  <div class="inline-flex items-center gap-2">
                    <%= link_to "View", hotel_booking_control_panel_path(current_hotel, presenter.booking, tab: "booking_details"), class: "inline-flex items-center rounded-lg border border-border bg-card px-3 py-1.5 text-xs font-semibold text-foreground shadow-sm transition hover:border-border-interactive hover:bg-muted" %>
                    <% if presenter.status == 'confirmed' %>
                      <button type="button" onclick="document.getElementById('check-in-modal-<%= presenter.id %>').showModal();" class="inline-flex items-center rounded-lg bg-primary px-3 py-1.5 text-xs font-semibold text-primary-foreground shadow-sm transition hover:bg-primary-hover">
                        Check In
                      </button>
                    <% elsif presenter.status == 'checked_in' %>
                      <div class="inline-flex flex-col items-end gap-1">
                        <span class="inline-flex items-center rounded-full border border-emerald-200 bg-emerald-50 px-2 py-0.5 text-[10px] font-bold text-emerald-700">CHECKED IN</span>
                        <button type="button" onclick="document.getElementById('check-in-modal-<%= presenter.id %>').showModal();" class="text-[10px] font-bold text-muted-foreground hover:text-foreground underline underline-offset-2">Edit Time</button>
                      </div>
                    <% end %>

                    <%= render "hotel_portal/bookings/transactions/check_in_reservation/partials/legacy_modal", booking: presenter.booking, hotel: current_hotel %>
                  </div>
                </td>
              </tr>
            <% end %>
          <% else %>
            <tr>
              <td colspan="6" class="px-8 py-20 text-center sm:px-8">
                <p class="text-sm font-medium text-muted-foreground">No arrivals scheduled for this date.</p>
                <% if @query.present? %>
                  <p class="mt-1 text-sm text-muted-foreground">Try adjusting your search criteria.</p>
                <% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>

    <!-- Mobile View -->
    <div class="space-y-4 p-5 lg:hidden">
      <% if @arrivals.any? %>
        <% @arrivals.each do |booking| %>
          <% presenter = HotelPortal::ArrivalPresenter.new(booking, current_hotel) %>
          <div class="rounded-2xl border border-border p-5 shadow-sm <%= presenter.blacklisted? ? 'bg-rose-100 border-t-4 border-t-rose-600 pt-4' : 'bg-muted/60' %>">
            <div class="flex items-start justify-between gap-3">
              <div>
                <p class="text-xs font-semibold uppercase tracking-[0.08em] text-muted-foreground">Guest</p>
                <div class="flex items-center gap-x-1.5 mt-1">
                  <p class="text-sm font-semibold text-foreground"><%= presenter.guest_name %></p>
                  <% if presenter.vip? %>
                    <%= cached_icon "crown-simple", library: "phosphor", variant: "duotone", class: "size-4 text-amber-500 fill-amber-500 shrink-0" %>
                  <% end %>
                  <% if presenter.blacklisted? %>
                    <div class="relative size-4 flex items-center justify-center shrink-0">
                      <%= cached_icon "user", library: "phosphor", variant: "light", class: "size-3.5 text-rose-600" %>
                      <%= cached_icon "ban", class: "absolute inset-0 size-4 text-rose-600" %>
                    </div>
                  <% end %>
                  <% if presenter.repeat? %>
                    <%= cached_icon "repeat", library: "lucide", variant: "outline", class: "size-4 text-blue-500 shrink-0" %>
                  <% end %>
                </div>
                <p class="mt-1 text-xs font-mono text-muted-foreground"><%= presenter.confirmation_token %></p>
              </div>
              <% if presenter.status == 'checked_in' %>
                <span class="inline-flex items-center rounded-full border border-emerald-200 bg-emerald-50 px-2.5 py-1 text-[11px] font-semibold text-emerald-700">Checked in</span>
              <% end %>
            </div>

            <dl class="mt-4 space-y-3 text-sm">
              <div>
                <dt class="text-xs font-semibold uppercase tracking-[0.08em] text-muted-foreground">Room Details</dt>
                <dd class="mt-1 space-y-1">
                  <% presenter.rooms_summary.each do |room_summary_text| %>
                    <p class="text-foreground text-sm font-medium"><%= room_summary_text %></p>
                  <% end %>
                  <div class="flex items-center gap-x-3 mt-2 text-xs text-muted-foreground">
                    <span class="inline-flex items-center gap-x-1">
                      <%= cached_icon "user", class: "w-3.5 h-3.5" %>
                      <%= presenter.adults %> Adults
                    </span>
                    <span class="inline-flex items-center gap-x-1">
                      <%= cached_icon "baby", class: "w-3.5 h-3.5" %>
                      <%= presenter.children %> Kids
                    </span>
                  </div>
                </dd>
              </div>

              <div class="flex items-start justify-between gap-4">
                <div>
                  <dt class="text-xs font-semibold uppercase tracking-[0.08em] text-muted-foreground">Pre-Checkin</dt>
                  <dd class="mt-1">
                    <span class="text-[11px] font-bold uppercase tracking-wider border rounded-full px-2.5 py-1 <%= presenter.pre_checkin_badge_class(mobile: true) %>">
                      <%= presenter.pre_checkin_status_label %>
                    </span>
                  </dd>
                </div>
                <div class="text-right">
                  <dt class="text-xs font-semibold uppercase tracking-[0.08em] text-muted-foreground">Guarantee</dt>
                  <dd class="mt-1 text-foreground font-medium"><%= presenter.guarantee_method_display %></dd>
                </div>
              </div>
            </dl>

            <div class="mt-6 flex items-center justify-end gap-2">
              <%= link_to "View", hotel_booking_control_panel_path(current_hotel, presenter.booking, tab: "booking_details"), class: "inline-flex items-center rounded-lg border border-border bg-card px-3 py-1.5 text-xs font-semibold text-foreground shadow-sm transition hover:border-border-interactive hover:bg-muted" %>
              <% if presenter.status == 'confirmed' %>
                <button type="button" onclick="document.getElementById('check-in-modal-<%= presenter.id %>-mob').showModal();" class="inline-flex items-center rounded-lg bg-primary px-3 py-1.5 text-xs font-semibold text-primary-foreground shadow-sm transition hover:bg-primary-hover">
                  Check In Now
                </button>
              <% elsif presenter.status == 'checked_in' %>
                <button type="button" onclick="document.getElementById('check-in-modal-<%= presenter.id %>-mob').showModal();" class="inline-flex items-center rounded-lg border border-emerald-200 bg-emerald-50 px-3 py-1.5 text-xs font-semibold text-emerald-700 shadow-sm transition hover:bg-emerald-100">
                  Edit Time
                </button>
              <% end %>
            </div>

            <%= render "hotel_portal/bookings/transactions/check_in_reservation/partials/legacy_modal", booking: presenter.booking, hotel: current_hotel, id_suffix: "mob" %>
          </div>
        <% end %>
      <% else %>
        <div class="rounded-2xl border border-dashed border-border-interactive bg-card px-5 py-12 text-center shadow-sm">
          <p class="text-sm font-medium text-muted-foreground">No arrivals scheduled for this date.</p>
        </div>
      <% end %>
    </div>

    <div class="px-8 py-5 border-t border-border bg-muted/50 flex justify-center">
      <%= paginate @arrivals %>
    </div>
  </div>
</div>
