<% content_for :breadcrumbs do %>
  <div class="flex items-center gap-x-2">
    <span class="text-sm font-medium text-slate-600"><%= current_hotel.name %></span>
    <span class="text-sm text-slate-400">/</span>
    <span class="text-sm font-semibold text-slate-900">Arrivals</span>
  </div>
<% end %>

<div class="max-w-[1600px] mx-auto pb-20 space-y-8">
  <div class="px-4 md:px-0 mt-5">
    <div class="flex flex-col md:flex-row md:items-end md:justify-between gap-4">
      <div>
        <h1 class="text-2xl font-bold tracking-tight text-slate-950 sm:text-3xl">Arrival Board</h1>
        <p class="mt-1 text-sm font-medium text-slate-600">Track and manage guest arrivals for <%= @date.strftime("%d %b %Y") %>.</p>
      </div>

      <div class="flex items-center gap-2">
        <div class="inline-flex bg-slate-100 rounded-xl p-1 shadow-sm border border-slate-200">
          <%= link_to hotel_arrivals_path(current_hotel, date: Date.today, q: @query.presence), 
              class: "py-1.5 px-4 inline-flex items-center justify-center gap-x-2 text-sm font-semibold rounded-lg transition #{ @date == Date.today ? 'bg-white shadow-sm text-slate-900' : 'text-slate-500 hover:text-slate-700' }" do %>
            Today
            <span class="inline-flex items-center py-0.5 px-1.5 rounded-full text-[10px] font-bold bg-slate-200 text-slate-700"><%= @today_count %></span>
          <% end %>
          <%= link_to hotel_arrivals_path(current_hotel, date: Date.tomorrow, q: @query.presence), 
              class: "py-1.5 px-4 inline-flex items-center justify-center gap-x-2 text-sm font-semibold rounded-lg transition #{ @date == Date.tomorrow ? 'bg-white shadow-sm text-slate-900' : 'text-slate-500 hover:text-slate-700' }" do %>
            Tomorrow
            <span class="inline-flex items-center py-0.5 px-1.5 rounded-full text-[10px] font-bold bg-slate-200 text-slate-700"><%= @tomorrow_count %></span>
          <% end %>
        </div>
        
        <%= form_with url: hotel_arrivals_path(current_hotel), method: :get, class: "flex items-center" do |f| %>
          <%= f.hidden_field :q, value: @query %>
          <%= f.date_field :date, value: @date, onchange: "this.form.submit()", 
              class: "rounded-xl border border-slate-200 bg-white px-3 py-2.5 text-sm font-medium text-slate-700 focus:border-slate-300 focus:outline-none focus:ring-0 shadow-sm" %>
        <% end %>
      </div>
    </div>
  </div>

  <div class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">
    <div class="flex items-center justify-between border-b border-slate-200 px-8 py-6">
      <div>
        <h2 class="text-lg font-bold tracking-tight text-slate-950 sm:text-xl">Expected Arrivals</h2>
        <p class="mt-1 text-sm font-medium text-slate-600">Guests scheduled to arrive at your property.</p>
      </div>
      <span class="text-sm font-medium text-slate-500">Total Arrivals <span class="font-semibold text-slate-900"><%= @all_arrivals.count %></span></span>
    </div>

    <div class="border-b border-slate-200 bg-slate-50/70 px-8 py-5">
      <%= form_with url: hotel_arrivals_path(current_hotel), method: :get, class: "flex flex-col gap-3 xl:flex-row xl:items-center xl:justify-between", data: { controller: "auto-submit" } do |f| %>
        <%= f.hidden_field :date, value: @date %>
        <div class="flex w-full flex-col gap-3 lg:flex-row">
          <label class="relative block flex-1">
            <span class="sr-only">Search arrivals</span>
            <span class="pointer-events-none absolute inset-y-0 left-0 flex items-center pl-4 text-slate-400">
              <svg class="size-4" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
            </span>
            <%= f.search_field :q,
                               value: @query,
                               id: "arrivals-search",
                               placeholder: "Search guest, contact, or booking reference",
                               class: "w-full rounded-xl border border-slate-200 bg-white py-2.5 pl-11 pr-4 text-sm text-slate-700 placeholder:text-slate-400 focus:border-slate-300 focus:outline-none focus:ring-0",
                               data: { action: "input->auto-submit#submit" } %>
          </label>
        </div>

        <div class="flex items-center gap-2">
          <% if @query.present? %>
            <%= link_to "Clear", hotel_arrivals_path(current_hotel, date: @date), class: "inline-flex items-center rounded-lg border border-slate-200 bg-white px-3 py-2 text-sm font-semibold text-slate-700 shadow-sm transition hover:border-slate-900 hover:bg-slate-50" %>
          <% end %>
        </div>
      <% end %>
    </div>

    <div class="hidden lg:block overflow-x-auto">
      <table class="min-w-full table-fixed">
        <colgroup>
          <col class="w-[22%]">
          <col class="w-[20%]">
          <col class="w-[12%]">
          <col class="w-[14%]">
          <col class="w-[12%]">
          <col class="w-[20%]">
        </colgroup>
        <thead class="bg-slate-100">
          <tr>
            <th scope="col" class="px-8 py-4 text-left text-[11px] font-semibold uppercase tracking-[0.1em] text-slate-600 sm:px-8">Guest / Reference</th>
            <th scope="col" class="px-8 py-4 text-left text-[11px] font-semibold uppercase tracking-[0.1em] text-slate-600">Room Details</th>
            <th scope="col" class="px-8 py-4 text-left text-[11px] font-semibold uppercase tracking-[0.1em] text-slate-600">Pre-Checkin</th>
            <th scope="col" class="px-8 py-4 text-left text-[11px] font-semibold uppercase tracking-[0.1em] text-slate-600">Guarantee</th>
            <th scope="col" class="px-8 py-4 text-left text-[11px] font-semibold uppercase tracking-[0.1em] text-slate-600">Docs / Notes</th>
            <th scope="col" class="px-8 py-4 text-right text-[11px] font-semibold uppercase tracking-[0.1em] text-slate-600 sm:px-8">Action</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-200 bg-white">
          <% if @arrivals.any? %>
            <% @arrivals.each_with_index do |booking, index| %>
              <% room_number = booking.hotel_snapshot.is_a?(Hash) ? booking.hotel_snapshot['room_number'].presence || booking.hotel_snapshot.dig('assignment', 'room_number').presence : nil %>
              <tr class="align-top transition-colors hover:bg-slate-100/80 <%= index.even? ? 'bg-white' : 'bg-slate-50/55' %>">
                <td class="px-8 py-5">
                  <div class="flex flex-col gap-1.5">
                    <span class="text-sm font-semibold text-slate-900"><%= booking.guest_name %></span>
                    <span class="text-xs font-mono text-slate-500"><%= booking.confirmation_token %></span>
                  </div>
                </td>
                <td class="px-8 py-5">
                  <div class="flex flex-col gap-2">
                    <% booking.booking_rooms.each do |br| %>
                      <span class="text-sm text-slate-800"><%= br.quantity %>x <%= br.room_type_snapshot['name'] %></span>
                    <% end %>
                    <div class="flex items-center gap-x-3 text-xs text-slate-500">
                      <span class="inline-flex items-center gap-x-1">
                        <svg class="w-3.5 h-3.5" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M15.75 6.75a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0zM4.5 20.25a7.5 7.5 0 1115 0v.75h-15v-.75z" /></svg>
                        <%= booking.adults %>
                      </span>
                      <span class="inline-flex items-center gap-x-1">
                        <svg class="w-3.5 h-3.5" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M12 3.75a2.25 2.25 0 012.25 2.25v.75a2.25 2.25 0 01-4.5 0V6A2.25 2.25 0 0112 3.75zM8.25 21v-3.375a3.75 3.75 0 017.5 0V21M6 12.75h12M12 12.75v8.25" /></svg>
                        <%= booking.children %>
                      </span>
                      <% if booking.status == 'checked_in' %>
                        <span class="inline-flex items-center gap-x-1 font-medium text-emerald-700">
                          <svg class="w-3.5 h-3.5" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M2.25 21h19.5M4.5 18.75V9.75a2.25 2.25 0 012.25-2.25h10.5a2.25 2.25 0 012.25 2.25v9M9 12h.008v.008H9V12zm3 0h.008v.008H12V12zm3 0h.008v.008H15V12z" /></svg>
                          <%= room_number || 'TBA' %>
                        </span>
                      <% end %>
                    </div>
                  </div>
                </td>
                <td class="px-8 py-5 whitespace-nowrap">
                  <%
                    pc_status = booking.pre_checkin_status || 'not_started'
                    pc_class = case pc_status
                    when 'completed' then 'border-emerald-200 bg-emerald-50 text-emerald-700'
                    when 'pending' then 'border-amber-200 bg-amber-50 text-amber-700'
                    when 'failed' then 'border-red-200 bg-red-50 text-red-700'
                    else 'border-slate-200 bg-slate-50 text-slate-700'
                    end
                  %>
                  <span class="inline-flex items-center rounded-full border px-2.5 py-1 text-[11px] font-semibold <%= pc_class %>">
                    <%= pc_status.titleize %>
                  </span>
                </td>
                <td class="px-8 py-5 whitespace-nowrap">
                  <div class="flex flex-col gap-0.5">
                    <span class="text-sm font-medium text-slate-900"><%= (booking.guarantee_method || 'none').titleize %></span>
                    <span class="text-[11px] font-bold uppercase tracking-wider text-slate-500"><%= (booking.deposit_status || 'not_required').titleize %></span>
                  </div>
                </td>
                <td class="px-8 py-5">
                  <div class="flex items-center gap-x-2">
                    <% if booking.pre_checkin&.document_status == 'uploaded' %>
                      <span class="text-emerald-600" title="Documents Uploaded">
                        <svg class="w-4 h-4" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75m-3-7.036A11.959 11.959 0 013.598 6 11.99 11.99 0 003 9.744c0 5.052 3.823 9.213 8.722 9.637.85.073 1.711.11 2.578.11 8.598 0 15.598-6.999 15.598-15.598 0-.113-.001-.225-.004-.337A11.996 11.996 0 0112 2.714z" /></svg>
                      </span>
                    <% else %>
                      <span class="text-slate-300">
                        <svg class="w-4 h-4" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M19.5 14.25v-2.625a3.375 3.375 0 00-3.375-3.375h-1.5A1.125 1.125 0 0113.5 7.125v-1.5a3.375 3.375 0 00-3.375-3.375H8.25m0 12.75h7.5m-7.5 3H12M10.5 2.25H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 00-9-9z" /></svg>
                      </span>
                    <% end %>

                    <% if booking.booking_notes.any? %>
                      <span class="text-blue-600" title="<%= pluralize(booking.booking_notes.count, 'note') %>">
                        <svg class="w-4 h-4" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M7.5 8.25h9m-9 3H12m-9.75 1.51c0 1.6 1.123 2.994 2.707 3.227 1.129.166 2.27.293 3.423.379.35.026.67.21.865.501L12 21l2.755-4.133a1.14 1.14 0 01.865-.501 48.172 48.172 0 003.423-.379c1.584-.233 2.707-1.626 2.707-3.228V6.741c0-1.602-1.123-2.995-2.707-3.228A48.394 48.394 0 0012 3c-2.392 0-4.744.175-7.043.513C3.373 3.746 2.25 5.14 2.25 6.741v6.018z" /></svg>
                      </span>
                    <% end %>
                  </div>
                </td>
                <td class="px-8 py-5 text-right whitespace-nowrap sm:px-8">
                  <div class="inline-flex items-center gap-2">
                    <%= link_to "View", hotel_booking_path(current_hotel, booking), class: "inline-flex items-center rounded-lg border border-slate-200 bg-white px-3 py-1.5 text-xs font-semibold text-slate-700 shadow-sm transition hover:border-slate-900 hover:bg-slate-50" %>
                    <% if booking.status == 'confirmed' %>
                      <button type="button" onclick="document.getElementById('check-in-modal-<%= booking.id %>').showModal();" class="inline-flex items-center rounded-lg bg-slate-900 px-3 py-1.5 text-xs font-semibold text-white shadow-sm transition hover:bg-slate-700">
                        Check In
                      </button>
                    <% elsif booking.status == 'checked_in' %>
                      <div class="inline-flex flex-col items-end gap-1">
                        <span class="inline-flex items-center rounded-full border border-emerald-200 bg-emerald-50 px-2 py-0.5 text-[10px] font-bold text-emerald-700">CHECKED IN</span>
                        <button type="button" onclick="document.getElementById('check-in-modal-<%= booking.id %>').showModal();" class="text-[10px] font-bold text-slate-500 hover:text-slate-900 underline underline-offset-2">Edit Time</button>
                      </div>
                    <% end %>

                    <dialog id="check-in-modal-<%= booking.id %>" class="fixed inset-0 m-auto rounded-2xl p-0 w-[min(92vw,28rem)] max-w-md shadow-2xl backdrop:bg-slate-900/50" onclick="if(event.target===this){this.close()}">
                      <div class="p-6 bg-white text-left" onclick="event.stopPropagation()">
                        <h3 class="text-lg font-bold text-slate-900"><%= booking.status == 'checked_in' ? 'Edit Check-In' : 'Confirm Check-In' %></h3>
                        <p class="text-sm text-slate-500 mt-1">Set check-in time for <%= booking.guest_name %>.</p>
                        
                        <div class="mt-4 flex items-center justify-between p-3.5 bg-slate-50 rounded-xl border border-slate-100">
                          <div>
                            <span class="block text-[10px] font-bold text-slate-400 uppercase tracking-widest">Guarantee</span>
                            <div class="mt-0.5 flex items-center gap-1.5">
                              <svg class="w-3.5 h-3.5 text-slate-400" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75m-3-7.036A11.959 11.959 0 013.598 6 11.99 11.99 0 003 9.744c0 5.052 3.823 9.213 8.722 9.637.85.073 1.711.11 2.578.11 8.598 0 15.598-6.999 15.598-15.598 0-.113-.001-.225-.004-.337A11.996 11.996 0 0112 2.714z" /></svg>
                              <span class="text-sm font-bold text-slate-700"><%= (booking.guarantee_method || 'none').titleize %></span>
                            </div>
                          </div>
                          <div class="text-right">
                            <span class="block text-[10px] font-bold text-slate-400 uppercase tracking-widest">Status</span>
                            <span class="mt-0.5 inline-flex items-center rounded-full bg-slate-200 px-2 py-0.5 text-[10px] font-bold text-slate-700 uppercase"><%= booking.status %></span>
                          </div>
                        </div>

                        <%= form_with url: check_in_hotel_booking_path(current_hotel, booking), method: :post, local: true, class: "mt-4 space-y-4" do |f| %>
                          <div>
                            <label class="block text-[11px] font-bold text-slate-500 uppercase tracking-wider mb-2">Check-in Date & Time</label>
                            <%= f.datetime_local_field :checked_in_at, 
                                value: (booking.checked_in_at || Time.current).strftime("%Y-%m-%dT%H:%M"), 
                                class: "w-full rounded-xl border border-slate-200 bg-white py-2.5 px-4 text-sm text-slate-700 focus:border-slate-300 focus:outline-none focus:ring-0" %>
                          </div>
                          
                          <div class="flex items-center justify-end gap-x-3 pt-2">
                            <button type="button" class="px-4 py-2 text-sm font-semibold text-slate-700 hover:bg-slate-50 rounded-lg transition" onclick="this.closest('dialog').close()">Cancel</button>
                            <%= f.submit booking.status == 'checked_in' ? "Save Changes" : "Confirm Check In", class: "px-4 py-2 text-sm font-bold bg-slate-900 text-white rounded-lg hover:bg-slate-700 transition shadow-sm" %>
                          </div>
                        <% end %>
                      </div>
                    </dialog>
                  </div>
                </td>
              </tr>
            <% end %>
          <% else %>
            <tr>
              <td colspan="6" class="px-8 py-20 text-center sm:px-8">
                <p class="text-sm font-medium text-slate-500">No arrivals scheduled for this date.</p>
                <% if @query.present? %>
                  <p class="mt-1 text-sm text-slate-500 text-sm">Try adjusting your search criteria.</p>
                <% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>

    <!-- Mobile View -->
    <div class="space-y-4 p-5 lg:hidden">
      <% if @arrivals.any? %>
        <% @arrivals.each do |booking| %>
          <% room_number = booking.hotel_snapshot.is_a?(Hash) ? booking.hotel_snapshot['room_number'].presence || booking.hotel_snapshot.dig('assignment', 'room_number').presence : nil %>
          <div class="rounded-2xl border border-slate-200 bg-slate-50/60 p-5 shadow-sm">
            <div class="flex items-start justify-between gap-3">
              <div>
                <p class="text-xs font-semibold uppercase tracking-[0.08em] text-slate-500">Guest</p>
                <p class="mt-1 text-sm font-semibold text-slate-900"><%= booking.guest_name %></p>
                <p class="mt-1 text-xs font-mono text-slate-500"><%= booking.confirmation_token %></p>
              </div>
              <% if booking.status == 'checked_in' %>
                <span class="inline-flex items-center rounded-full border border-emerald-200 bg-emerald-50 px-2.5 py-1 text-[11px] font-semibold text-emerald-700">Checked in</span>
              <% end %>
            </div>

            <dl class="mt-4 space-y-3 text-sm">
              <div>
                <dt class="text-xs font-semibold uppercase tracking-[0.08em] text-slate-500">Room Details</dt>
                <dd class="mt-1 space-y-1">
                  <% booking.booking_rooms.each do |br| %>
                    <p class="text-slate-700 text-sm font-medium"><%= br.quantity %>x <%= br.room_type_snapshot['name'] %></p>
                  <% end %>
                  <div class="flex items-center gap-x-3 mt-2 text-xs text-slate-500">
                    <span class="inline-flex items-center gap-x-1">
                      <svg class="w-3.5 h-3.5" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M15.75 6.75a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0zM4.5 20.25a7.5 7.5 0 1115 0v.75h-15v-.75z" /></svg>
                      <%= booking.adults %> Adults
                    </span>
                    <span class="inline-flex items-center gap-x-1">
                      <svg class="w-3.5 h-3.5" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M12 3.75a2.25 2.25 0 012.25 2.25v.75a2.25 2.25 0 01-4.5 0V6A2.25 2.25 0 0112 3.75zM8.25 21v-3.375a3.75 3.75 0 017.5 0V21M6 12.75h12M12 12.75v8.25" /></svg>
                      <%= booking.children %> Kids
                    </span>
                  </div>
                </dd>
              </div>

              <div class="flex items-start justify-between gap-4">
                <div>
                  <dt class="text-xs font-semibold uppercase tracking-[0.08em] text-slate-500">Pre-Checkin</dt>
                  <dd class="mt-1">
                    <%
                      pc_status = booking.pre_checkin_status || 'not_started'
                      pc_class = case pc_status
                      when 'completed' then 'bg-emerald-50 text-emerald-700'
                      when 'pending' then 'bg-amber-50 text-amber-700'
                      when 'failed' then 'bg-red-50 text-red-700'
                      else 'bg-slate-50 text-slate-700'
                      end
                    %>
                    <span class="text-[11px] font-bold uppercase tracking-wider <%= pc_class %>"><%= pc_status.titleize %></span>
                  </dd>
                </div>
                <div class="text-right">
                  <dt class="text-xs font-semibold uppercase tracking-[0.08em] text-slate-500">Guarantee</dt>
                  <dd class="mt-1 text-slate-700 font-medium"><%= (booking.guarantee_method || 'none').titleize %></dd>
                </div>
              </div>
            </dl>

            <div class="mt-6 flex items-center justify-end gap-2">
              <%= link_to "View", hotel_booking_path(current_hotel, booking), class: "inline-flex items-center rounded-lg border border-slate-200 bg-white px-3 py-1.5 text-xs font-semibold text-slate-700 shadow-sm transition hover:border-slate-900 hover:bg-slate-50" %>
              <% if booking.status == 'confirmed' %>
                <button type="button" onclick="document.getElementById('check-in-modal-<%= booking.id %>-mob').showModal();" class="inline-flex items-center rounded-lg bg-slate-900 px-3 py-1.5 text-xs font-semibold text-white shadow-sm transition hover:bg-slate-700">
                  Check In Now
                </button>
              <% elsif booking.status == 'checked_in' %>
                <button type="button" onclick="document.getElementById('check-in-modal-<%= booking.id %>-mob').showModal();" class="inline-flex items-center rounded-lg border border-emerald-200 bg-emerald-50 px-3 py-1.5 text-xs font-semibold text-emerald-700 shadow-sm transition hover:bg-emerald-100">
                  Edit Time
                </button>
              <% end %>
            </div>

            <dialog id="check-in-modal-<%= booking.id %>-mob" class="fixed inset-0 m-auto rounded-2xl p-0 w-[min(92vw,28rem)] max-w-md shadow-2xl backdrop:bg-slate-900/50" onclick="if(event.target===this){this.close()}">
              <div class="p-6 bg-white text-left" onclick="event.stopPropagation()">
                <h3 class="text-lg font-bold text-slate-900"><%= booking.status == 'checked_in' ? 'Edit Check-In' : 'Confirm Check-In' %></h3>
                <p class="text-sm text-slate-500 mt-1">Set check-in time for <%= booking.guest_name %>.</p>

                <div class="mt-4 flex items-center justify-between p-3.5 bg-slate-50 rounded-xl border border-slate-100">
                  <div>
                    <span class="block text-[10px] font-bold text-slate-400 uppercase tracking-widest">Guarantee</span>
                    <div class="mt-0.5 flex items-center gap-1.5">
                      <svg class="w-3.5 h-3.5 text-slate-400" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75m-3-7.036A11.959 11.959 0 013.598 6 11.99 11.99 0 003 9.744c0 5.052 3.823 9.213 8.722 9.637.85.073 1.711.11 2.578.11 8.598 0 15.598-6.999 15.598-15.598 0-.113-.001-.225-.004-.337A11.996 11.996 0 0112 2.714z" /></svg>
                      <span class="text-sm font-bold text-slate-700"><%= (booking.guarantee_method || 'none').titleize %></span>
                    </div>
                  </div>
                  <div class="text-right">
                    <span class="block text-[10px] font-bold text-slate-400 uppercase tracking-widest">Status</span>
                    <span class="mt-0.5 inline-flex items-center rounded-full bg-slate-200 px-2 py-0.5 text-[10px] font-bold text-slate-700 uppercase"><%= booking.status %></span>
                  </div>
                </div>

                <%= form_with url: check_in_hotel_booking_path(current_hotel, booking), method: :post, local: true, class: "mt-4 space-y-4" do |f| %>
                  <div>
                    <label class="block text-[11px] font-bold text-slate-500 uppercase tracking-wider mb-2">Check-in Date & Time</label>
                    <%= f.datetime_local_field :checked_in_at, 
                        value: (booking.checked_in_at || Time.current).strftime("%Y-%m-%dT%H:%M"), 
                        class: "w-full rounded-xl border border-slate-200 bg-white py-2.5 px-4 text-sm text-slate-700 focus:border-slate-300 focus:outline-none focus:ring-0" %>
                  </div>
                  
                  <div class="flex flex-col gap-2 pt-2">
                    <%= f.submit booking.status == 'checked_in' ? "Save Changes" : "Confirm Check In", class: "w-full py-2.5 text-sm font-bold bg-slate-900 text-white rounded-lg hover:bg-slate-700 transition shadow-sm" %>
                    <button type="button" class="w-full py-2.5 text-sm font-semibold text-slate-700 hover:bg-slate-50 rounded-lg transition" onclick="this.closest('dialog').close()">Cancel</button>
                  </div>
                <% end %>
              </div>
            </dialog>
          </div>
        <% end %>
      <% else %>
        <div class="rounded-2xl border border-dashed border-slate-300 bg-white px-5 py-12 text-center shadow-sm">
          <p class="text-sm font-medium text-slate-500">No arrivals scheduled for this date.</p>
        </div>
      <% end %>
    </div>

    <div class="px-8 py-5 border-t border-slate-200 bg-slate-50/50 flex justify-center">
      <%= paginate @arrivals %>
    </div>
  </div>
