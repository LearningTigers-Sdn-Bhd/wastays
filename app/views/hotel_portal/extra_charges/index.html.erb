<div class="w-full space-y-4">
  <%= render PanelsUI::PageHeader.new(title: "Extra Charges", description: "Manage the charges staff can add to guest folios.") %>

  <section aria-labelledby="extra-charges-heading" class="space-y-3">
    <div class="flex flex-col gap-3 sm:flex-row sm:items-start sm:justify-between">
      <div>
        <h2 id="extra-charges-heading" class="text-base font-semibold text-foreground">Extra Charges Registry</h2>
        <p class="mt-1 text-sm text-muted-foreground">Set default pricing, tax treatment, and reporting categories for additional hotel services.</p>
      </div>

      <%= render PanelsUI::Button.new(
            href: new_hotel_extra_charge_path(current_hotel),
            size: :sm,
            class: "shrink-0",
            data: { turbo_frame: "settings_action_sheet" }) do %>
        <%= app_icon "plus", class: "size-4", aria: { hidden: true } %>
        Add Extra Charge
      <% end %>
    </div>

    <%= render PanelsUI::Table.new(
          caption: "Extra charges registry",
          header_style: :sentence,
          striped: true,
          hoverable: true,
          bordered: true,
          wrapper_class: "rounded-md border border-border bg-card",
          class: "min-w-[900px]",
          data: { testid: "extra-charges-registry" }) do |table| %>
      <% table.with_header do %>
        <tr>
          <th scope="col">Status</th>
          <th scope="col">Charge</th>
          <th scope="col">Code</th>
          <th scope="col">Pricing</th>
          <th scope="col">Category</th>
          <th scope="col">Taxes</th>
          <th scope="col" class="text-right">Action</th>
        </tr>
      <% end %>

      <% table.with_body do %>
        <% if @extra_charges.any? %>
          <% @extra_charges.each do |extra_charge| %>
            <tr id="extra-charge-row-<%= extra_charge.id %>">
              <td class="align-middle">
                <%= form_with url: status_hotel_extra_charge_path(current_hotel, extra_charge), method: :patch,
                              class: "inline-flex",
                              data: {
                                controller: "tax-registry-status",
                                action: "turbo:submit-start->tax-registry-status#start turbo:submit-end->tax-registry-status#finish",
                                turbo_frame: "_top",
                                turbo_confirm: extra_charge.active? ? "Deactivate #{extra_charge.name}?" : nil,
                                turbo_confirm_title: extra_charge.active? ? "Deactivate #{extra_charge.name}?" : nil,
                                turbo_confirm_text: extra_charge.active? ? "Staff will no longer be able to select this charge. Existing folio transactions remain unchanged." : nil,
                                turbo_confirm_tone: extra_charge.active? ? "warning" : nil
                              } do %>
                  <%= hidden_field_tag :active, "0" %>
                  <%= submit_tag "Update status", hidden: true, data: { tax_registry_status_target: "submit" } %>
                  <%= render PanelsUI::Switch.new(
                        name: :active,
                        label: tag.span("#{extra_charge.active? ? 'Deactivate' : 'Activate'} #{extra_charge.name}", class: "sr-only"),
                        checked: extra_charge.active?,
                        size: :sm,
                        data: { tax_registry_status_target: "switch", action: "change->tax-registry-status#change" }) %>
                <% end %>
              </td>
              <td class="align-middle">
                <div class="flex flex-wrap items-center gap-2">
                  <span class="font-medium text-foreground"><%= extra_charge.name %></span>
                  <% if extra_charge.transaction_code.system_required? %>
                    <span class="rounded-full border border-border bg-muted px-2 py-0.5 text-xs font-medium text-muted-foreground">System</span>
                  <% end %>
                </div>
                <p class="mt-0.5 max-w-xs truncate text-xs text-muted-foreground"><%= extra_charge.description.presence || "No description" %></p>
              </td>
              <td class="align-middle font-mono text-xs text-foreground" translate="no"><%= extra_charge.code %></td>
              <td class="align-middle text-muted-foreground"><%= extra_charge.pricing_label %></td>
              <td class="align-middle text-muted-foreground"><%= extra_charge.category.humanize %></td>
              <td class="align-middle text-muted-foreground">
                <% tax_names = extra_charge.transaction_code.transaction_code_taxes.map(&:tax_rule_key) %>
                <%= tax_names.any? ? pluralize(tax_names.size, "rule") : "None" %>
              </td>
              <td class="text-right align-middle">
                <%= render PanelsUI::Button.new(
                      href: edit_hotel_extra_charge_path(current_hotel, extra_charge),
                      variant: :secondary,
                      size: :xs,
                      data: { turbo_frame: "settings_action_sheet" }) do %>
                  Manage
                <% end %>
              </td>
            </tr>
          <% end %>
        <% else %>
          <tr><td colspan="7" class="py-8 text-center text-sm text-muted-foreground">No extra charges are configured.</td></tr>
        <% end %>
      <% end %>
    <% end %>
  </section>
</div>
