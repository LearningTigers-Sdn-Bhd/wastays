<% presenter = conversation_presenter(conversation) %>
<% badge = presenter.status_badge %>

<div class="flex min-h-[24rem] flex-col overflow-hidden rounded-xl border border-border bg-card">
  <div class="flex flex-wrap items-start justify-between gap-3 border-b border-border p-4">
    <div class="space-y-1">
      <div class="flex items-center gap-2">
        <h2 class="text-base font-semibold text-foreground"><%= presenter.display_name %></h2>
        <% if presenter.returning_guest? %>
          <%= render PanelsUI::Badge.new(label: "Returning", variant: :info, size: :xs) %>
        <% end %>
      </div>
      <p class="flex flex-wrap items-center gap-1.5 text-xs text-muted-foreground">
        <%= app_icon presenter.channel_icon, class: "size-3.5", aria: { hidden: "true" } %>
        <span><%= presenter.channel_label %></span>
        <% if presenter.subtitle %>
          <span aria-hidden="true">·</span>
          <span><%= presenter.subtitle %></span>
        <% end %>
        <span aria-hidden="true">·</span>
        <span><%= presenter.assignee_label %></span>
      </p>
    </div>

    <div class="flex items-center gap-2">
      <%= render PanelsUI::Badge.new(label: badge[:label], variant: badge[:variant], size: :sm) %>
      <%= link_to hotel_conversations_path(current_hotel),
            class: "lg:hidden inline-flex items-center gap-1 text-sm text-muted-foreground hover:text-foreground",
            data: { turbo_frame: "_top" } do %>
        <%= app_icon "arrow-left", class: "size-4", aria: { hidden: "true" } %>
        Back
      <% end %>
    </div>
  </div>

  <%= render PanelsUI::ScrollArea.new(class: "max-h-[32rem] flex-1") do %>
    <ol class="space-y-3 p-4" role="list">
      <% messages.each do |message| %>
        <%= render "hotel_portal/conversations/message", message: message %>
      <% end %>
    </ol>
  <% end %>

  <%#
    Read-only on purpose. A reply typed here would have nowhere to go: WhatsApp
    needs the outbound webhook and the web chat page does not exist yet. Saying
    so is better than a box that silently loses what someone wrote.
  %>
  <div class="border-t border-border p-4">
    <%= render PanelsUI::Alert.new(
          tone: :info,
          title: "Replies are not switched on yet") do |alert| %>
      <% alert.with_description do %>
        You can read every conversation here. Sending a reply needs a delivery
        route to the guest, which is the next piece of work.
      <% end %>
    <% end %>
  </div>
</div>
