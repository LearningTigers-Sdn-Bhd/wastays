<% meal_title = params[:meal_type].present? ? "Meal prep — #{params[:meal_type].titleize}" : "Meal prep" %>
<section class="space-y-3 print:space-y-3 print:break-inside-avoid" aria-labelledby="meal-prep-heading">
  <h2 id="meal-prep-heading" class="text-base font-semibold text-foreground">
    <%= meal_title %>
  </h2>

  <%= render PanelsUI::Table.new(
        caption: meal_title,
        density: :compact,
        header_style: :sentence,
        hoverable: true,
        class: "min-w-[760px] print:min-w-0 print:w-auto",
        wrapper_class: "rounded-lg border border-border bg-card print:overflow-visible"
      ) do |table| %>
    <% table.with_header do %>
      <tr>
        <th scope="col">Guest</th>
        <th scope="col">Pax</th>
        <th scope="col">Room type</th>
        <th scope="col">Room</th>
        <th scope="col">Transfer</th>
        <th scope="col">Boat time</th>
      </tr>
    <% end %>
    <% table.with_body do %>
      <% if report.records.any? %>
        <% report.records.each do |row| %>
          <tr>
            <th scope="row">
              <div class="min-w-0">
                <p class="font-semibold text-foreground"><%= row[:guest_name] %></p>
                <p class="mt-1 font-mono text-xs text-muted-foreground"><%= row[:confirmation_token] %></p>
              </div>
            </th>
            <td class="tabular-nums"><%= row[:pax] %></td>
            <td><%= row[:room_type] %></td>
            <td><%= row[:room_number] %></td>
            <td>
              <%= render PanelsUI::Badge.new(
                    label: row[:type],
                    variant: row[:type] == "Boat-in" ? :info : :warning,
                    size: :lg,
                    shape: :rounded
                  ) %>
            </td>
            <td>
              <%= render PanelsUI::Badge.new(label: row[:formatted_boat_time], variant: :neutral, size: :lg, shape: :rounded) %>
            </td>
          </tr>
        <% end %>
      <% else %>
        <%= render "table_empty_state", colspan: 6, message: "No boat transfers or meal records found for the selected period." %>
      <% end %>
    <% end %>
  <% end %>
</section>
