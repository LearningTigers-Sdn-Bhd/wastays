<% content_for :breadcrumbs do %>
  <div class="flex items-center gap-x-2">
    <span class="text-sm font-medium text-slate-600"><%= current_hotel.name %></span>
    <span class="text-sm text-slate-400">/</span>
    <%= link_to "Reports", hotel_reports_path(current_hotel), class: "text-sm font-medium text-slate-600 hover:text-slate-900" %>
    <span class="text-sm text-slate-400">/</span>
    <span class="text-sm font-semibold text-slate-900">Payouts</span>
  </div>
<% end %>

<div class="max-w-[1600px] mx-auto pb-20 space-y-8">
  <!-- Header -->
  <div class="px-4 md:px-0">
    <div class="mt-5">
      <h1 class="text-2xl font-bold tracking-tight text-slate-950 sm:text-3xl">Weekly Settlements</h1>
      <p class="mt-1 text-sm font-medium text-slate-600">Track your weekly payouts and payment history.</p>
    </div>
  </div>

  <%= turbo_frame_tag "payouts_content", class: "block space-y-8" do %>
    <div data-controller="tab-field" class="space-y-8">
      <%= form_with url: payouts_hotel_reports_path(current_hotel), method: :get, id: "hotel-payout-filter-form", data: { turbo_frame: "payouts_content" } do %>
        <%= hidden_field_tag :tab, @active_tab, id: "hotel-payout-active-tab-input", data: { "tab-field-target": "input" } %>
      <% end %>

      <!-- Preline Style Full-Width Underlined Tabs -->
      <nav class="relative z-0 flex border border-slate-200 rounded-xl overflow-hidden" aria-label="Tabs" role="tablist">
        <% upcoming_active = @active_tab == "upcoming" %>
        <% paid_active = @active_tab == "paid" %>
        
        <button type="button" 
                class="relative min-w-0 flex-1 bg-white first:border-s-0 border-s border-b-2 border-slate-200 py-4 px-4 text-slate-500 hover:text-slate-900 text-sm font-bold text-center overflow-hidden transition-all
                       <%= upcoming_active ? 'border-b-blue-600 text-slate-950 bg-slate-50/50' : '' %>" 
                data-action="click->tab-field#update"
                data-tab-value="upcoming">
          Upcoming & Processing
        </button>
        <button type="button" 
                class="relative min-w-0 flex-1 bg-white first:border-s-0 border-s border-b-2 border-slate-200 py-4 px-4 text-slate-500 hover:text-slate-900 text-sm font-bold text-center overflow-hidden transition-all
                       <%= paid_active ? 'border-b-blue-600 text-slate-950 bg-slate-50/50' : '' %> flex items-center justify-center gap-2" 
                data-action="click->tab-field#update"
                data-tab-value="paid">
          Paid History
          <span class="inline-flex items-center justify-center size-5 rounded-full bg-slate-100 text-[10px] font-black text-slate-700">
            <%= @payout_history.total_count %>
          </span>
        </button>
      </nav>

      <div class="space-y-8">
        <% if upcoming_active %>
          <div class="space-y-8 animate-in fade-in duration-300">
            <!-- Integrated Stats Grid (Dashboard Style) -->
            <div class="grid grid-cols-1 overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm <%= @processing_batches.any? ? 'md:grid-cols-2' : 'md:grid-cols-1' %>">
              <div class="p-6 md:p-8 <%= @processing_batches.any? ? 'md:border-r md:border-slate-200' : '' %>">
                <p class="mb-2 text-[11px] font-semibold uppercase tracking-wider text-slate-500">Accumulating (Current Cycle)</p>
                <h2 class="text-3xl font-bold tabular-nums tracking-tight text-slate-950">MYR <%= number_with_precision(@upcoming_payout_amount, precision: 2) %></h2>
                <p class="mt-2 text-sm font-medium text-slate-600"><%= pluralize(@upcoming_bookings.count, 'stay') %> completed and ready for settlement</p>
              </div>

              <% if @processing_batches.any? %>
                <div class="bg-amber-50/30 p-6 md:p-8">
                  <p class="mb-2 text-[11px] font-semibold uppercase tracking-wider text-amber-700">Processing Batch</p>
                  <h2 class="text-3xl font-bold tabular-nums tracking-tight text-amber-900">MYR <%= number_with_precision(@processing_batches.sum(&:amount), precision: 2) %></h2>
                  <p class="mt-2 text-sm font-medium text-amber-700/80">Funds currently being processed by the platform</p>
                </div>
              <% end %>
            </div>

            <div class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">
              <div class="border-b border-slate-200 bg-slate-50/70 px-6 py-5 sm:px-8">
                <h2 class="text-lg font-bold tracking-tight text-slate-950">Current Cycle Breakdown</h2>
                <p class="mt-1 text-sm font-medium text-slate-600">Individual bookings ready for next payout.</p>
              </div>
              <div class="overflow-x-auto">
                <table class="min-w-full table-fixed">
                  <thead class="bg-slate-100">
                    <tr>
                      <th scope="col" class="px-6 py-4 text-left text-[11px] font-semibold uppercase tracking-[0.1em] text-slate-600 sm:px-8">Booking Reference</th>
                      <th scope="col" class="px-6 py-4 text-left text-[11px] font-semibold uppercase tracking-[0.1em] text-slate-600">Checkout Date</th>
                      <th scope="col" class="px-6 py-4 text-right text-[11px] font-semibold uppercase tracking-[0.1em] text-slate-600 sm:px-8">Net Payout</th>
                    </tr>
                  </thead>
                  <tbody class="divide-y divide-slate-200 bg-white">
                    <% if @upcoming_bookings.any? %>
                      <% @upcoming_bookings.each_with_index do |booking, index| %>
                        <tr class="align-top transition-colors hover:bg-slate-100/80 <%= index.even? ? 'bg-white' : 'bg-slate-50/55' %>">
                          <td class="px-6 py-4 sm:px-8">
                            <span class="text-sm font-mono font-semibold text-slate-900">#<%= booking.confirmation_token %></span>
                          </td>
                          <td class="px-6 py-4 text-sm text-slate-600 font-medium">
                            <%= booking.checked_out_at&.strftime("%d %b %Y, %I:%M %p") %>
                          </td>
                          <td class="px-6 py-4 text-right whitespace-nowrap sm:px-8">
                            <span class="text-sm font-bold text-slate-900">RM <%= number_with_precision(booking.net_amount, precision: 2) %></span>
                          </td>
                        </tr>
                      <% end %>
                    <% else %>
                      <tr>
                        <td colspan="3" class="px-6 py-20 text-center text-sm font-medium text-slate-500 italic">
                          No completed bookings in the current cycle yet.
                        </td>
                      </tr>
                    <% end %>
                  </tbody>
                </table>
              </div>
            </div>
          </div>
        <% end %>

        <% if paid_active %>
          <div class="space-y-8 animate-in fade-in duration-300">
            <div class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">
              <div class="border-b border-slate-200 bg-slate-50/70 px-6 py-5 sm:px-8">
                <%= form_with url: payouts_hotel_reports_path(current_hotel), method: :get, class: "flex flex-col gap-4 md:flex-row md:items-end md:justify-end", data: { turbo_frame: "payouts_content" } do |f| %>
                  <%= hidden_field_tag :tab, "paid" %>
                  <div class="flex-1 max-w-xs">
                    <label class="block text-[11px] font-bold text-slate-500 uppercase tracking-wider mb-2">From Date</label>
                    <%= f.date_field :paid_start_date, value: @paid_start_date, class: "w-full rounded-xl border border-slate-200 bg-white px-4 py-2.5 text-sm font-medium text-slate-700 focus:border-slate-300 focus:outline-none focus:ring-0 shadow-sm" %>
                  </div>
                  <div class="flex-1 max-w-xs">
                    <label class="block text-[11px] font-bold text-slate-500 uppercase tracking-wider mb-2">To Date</label>
                    <%= f.date_field :paid_end_date, value: @paid_end_date, class: "w-full rounded-xl border border-slate-200 bg-white px-4 py-2.5 text-sm font-medium text-slate-700 focus:border-slate-300 focus:outline-none focus:ring-0 shadow-sm" %>
                  </div>
                  <div class="flex items-center gap-2">
                    <%= f.submit "Filter", class: "inline-flex items-center rounded-xl bg-slate-900 px-4 py-2.5 text-sm font-bold text-white shadow-sm transition hover:bg-slate-700" %>
                    <%= link_to "Reset", payouts_hotel_reports_path(current_hotel, tab: "paid"), class: "inline-flex items-center rounded-xl border border-slate-200 bg-white px-4 py-2.5 text-sm font-semibold text-slate-700 shadow-sm transition hover:bg-slate-50", data: { turbo_frame: "payouts_content" } %>
                  </div>
                <% end %>
              </div>

              <div class="overflow-x-auto">
                <table class="min-w-full table-fixed">
                  <thead class="bg-slate-100">
                    <tr>
                      <th scope="col" class="px-6 py-4 text-left text-[11px] font-semibold uppercase tracking-[0.1em] text-slate-600 sm:px-8">Period</th>
                      <th scope="col" class="px-6 py-4 text-left text-[11px] font-semibold uppercase tracking-[0.1em] text-slate-600">Settled At</th>
                      <th scope="col" class="px-6 py-4 text-left text-[11px] font-semibold uppercase tracking-[0.1em] text-slate-600">Platform Reference</th>
                      <th scope="col" class="px-6 py-4 text-right text-[11px] font-semibold uppercase tracking-[0.1em] text-slate-600">Net Amount</th>
                      <th scope="col" class="px-6 py-4 text-center text-[11px] font-semibold uppercase tracking-[0.1em] text-slate-600 sm:px-8">Receipt</th>
                    </tr>
                  </thead>
                  <tbody class="divide-y divide-slate-200 bg-white">
                    <% if @payout_history.any? %>
                      <% @payout_history.each_with_index do |batch, index| %>
                        <tr class="align-top transition-colors hover:bg-slate-100/80 <%= index.even? ? 'bg-white' : 'bg-slate-50/55' %>">
                          <td class="px-6 py-4 sm:px-8">
                            <span class="text-sm font-medium text-slate-900">
                              <%= batch.period_start.strftime("%d %b") %> – <%= batch.period_end.strftime("%d %b %Y") %>
                            </span>
                          </td>
                          <td class="px-6 py-4 text-sm text-slate-600 font-medium">
                            <%= batch.payout_at&.strftime("%d %b %Y") || "Pending" %>
                          </td>
                          <td class="px-6 py-4 text-sm font-mono text-slate-500">
                            <%= batch.payout_reference.presence || "—" %>
                          </td>
                          <td class="px-6 py-4 text-right whitespace-nowrap">
                            <span class="text-sm font-bold text-slate-900">MYR <%= number_with_precision(batch.amount, precision: 2) %></span>
                          </td>
                          <td class="px-6 py-4 text-center sm:px-8">
                            <% if batch.receipt.attached? %>
                              <%= link_to url_for(batch.receipt), target: "_blank", class: "inline-flex items-center gap-1 text-xs font-bold text-slate-700 hover:text-slate-950 underline underline-offset-4", data: { turbo: false } do %>
                                <svg class="size-3" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
                                PDF
                              <% end %>
                            <% else %>
                              <span class="text-xs font-medium text-slate-400 italic">None</span>
                            <% end %>
                          </td>
                        </tr>
                      <% end %>
                    <% else %>
                      <tr>
                        <td colspan="5" class="px-6 py-20 text-center text-sm font-medium text-slate-500 italic">No settlement history found for this criteria.</td>
                      </tr>
                    <% end %>
                  </tbody>
                </table>
              </div>

              <div class="px-6 py-4 border-t border-slate-200 bg-slate-50/50 flex justify-center sm:px-8">
                <%= paginate @payout_history, params: { tab: "paid", paid_start_date: @paid_start_date, paid_end_date: @paid_end_date } %>
              </div>
            </div>
          </div>
        <% end %>
      </div>
    </div>
  <% end %>

  <!-- Light Blue Info Box (Better alternative to dark card) -->
  <div class="p-5 rounded-2xl bg-blue-50 border border-blue-100 overflow-hidden relative">
    <div class="flex items-start gap-4">
      <div class="flex-none size-10 rounded-xl bg-blue-600/10 flex items-center justify-center border border-blue-600/10">
        <svg class="size-5 text-blue-600" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M12 16v-4"/><path d="M12 8h.01"/></svg>
      </div>
      <div class="min-w-0">
        <h4 class="text-xs font-bold uppercase tracking-wider text-blue-900 mb-1">Settlement Cycle</h4>
        <p class="text-sm font-medium leading-relaxed text-blue-800/80">
          WAStays operates on a weekly payout cycle. Bookings completed from <span class="font-bold text-blue-900">Saturday to Friday</span> are compiled and processed for payout on the following <span class="font-bold text-blue-900">Monday</span>.
        </p>
      </div>
    </div>
  </div>
</div>
