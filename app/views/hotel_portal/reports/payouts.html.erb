<div class="mx-auto max-w-[1600px] space-y-8 pb-20">
  <div class="px-4 md:px-0">
    <div class="mt-5">
      <h1 class="text-2xl font-bold tracking-tight text-slate-950 sm:text-3xl">Weekly Settlements</h1>
      <p class="mt-1 text-sm font-medium text-slate-600">Track your weekly payouts and payment history.</p>
    </div>
  </div>

  <%= turbo_frame_tag "payouts_content", class: "block space-y-8" do %>
    <div data-controller="tabs"
         data-tabs-default-tab-value="<%= @active_tab %>"
         class="space-y-8">
      <%= render "payout_tabs" %>

      <div id="upcoming-panel"
           data-tabs-target="panel"
           data-tab-panel="upcoming"
           class="<%= @active_tab == "upcoming" ? "space-y-8" : "hidden space-y-8" %>"
           role="tabpanel"
           data-testid="payouts-upcoming-panel">
        <%= render "upcoming_payouts_section" %>
      </div>

      <div id="paid-panel"
           data-tabs-target="panel"
           data-tab-panel="paid"
           class="<%= @active_tab == "paid" ? "space-y-8" : "hidden space-y-8" %>"
           role="tabpanel"
           data-testid="payouts-paid-panel">
        <%= render "paid_history_section" %>
      </div>
    </div>
  <% end %>

  <div class="relative overflow-hidden rounded-2xl border border-blue-100 bg-blue-50 p-5">
    <div class="flex items-start gap-4">
      <div class="flex size-10 flex-none items-center justify-center rounded-xl border border-blue-600/10 bg-blue-600/10">
        <svg class="size-5 text-blue-600" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M12 16v-4"/><path d="M12 8h.01"/></svg>
      </div>
      <div class="min-w-0">
        <h4 class="mb-1 text-xs font-bold uppercase tracking-wider text-blue-900">Settlement Cycle</h4>
        <p class="text-sm font-medium leading-relaxed text-blue-800/80">
          WAStays operates on a weekly payout cycle. Bookings completed from <span class="font-bold text-blue-900">Saturday to Friday</span> are compiled and processed for payout on the following <span class="font-bold text-blue-900">Monday</span>.
        </p>
      </div>
    </div>
  </div>
</div>
