<div class="w-full space-y-3.5">
  <div>
    <%= render PanelsUI::PageHeader.new(title: "Extra Charge Report") do |header| %>
      <% header.with_caption do %>
        <p class="text-sm font-medium text-muted-foreground">
          <%= current_hotel.name %> ·
          <% if @report.start_date == @report.end_date %>
            <%= @report.start_date.strftime("%A, %d %b %Y") %>
          <% else %>
            <%= @report.start_date.strftime("%d %b %Y") %> - <%= @report.end_date.strftime("%d %b %Y") %>
          <% end %>
        </p>
      <% end %>
      <% header.with_actions do %>
        <%= render "preset_report_actions",
          form_url: extra_charge_hotel_reports_path(current_hotel), date_preset: @date_preset,
          start_date: @report.start_date, end_date: @report.end_date,
          hidden_params: { tab: @active_extra_charge_tab },
          show_export: feature_enabled_for_hotel?("excel_pdf_export"), export_menu_id: "extra-charge-export",
          export_items: [
            ["Export PDF", extra_charge_hotel_reports_path(current_hotel, start_date: @report.start_date, end_date: @report.end_date, date_preset: @date_preset, tab: @active_extra_charge_tab, format: :pdf)],
            ["Export Excel", extra_charge_hotel_reports_path(current_hotel, start_date: @report.start_date, end_date: @report.end_date, date_preset: @date_preset, tab: @active_extra_charge_tab, format: :xlsx)],
            ["Export CSV", extra_charge_hotel_reports_path(current_hotel, start_date: @report.start_date, end_date: @report.end_date, date_preset: @date_preset, tab: @active_extra_charge_tab, format: :csv)]
          ] %>
      <% end %>
    <% end %>
  </div>

  <% preserved_params = { start_date: @report.start_date, end_date: @report.end_date, date_preset: @date_preset } %>
  <%= render PanelsUI::Tabs.new(
        id: "extra-charge-tabs",
        active: @active_extra_charge_tab,
        variant: :line,
        aria_label: "Extra Charge sections") do |tabs| %>
    <% tabs.with_tab(name: "fb", label: "F&B", href: extra_charge_hotel_reports_path(current_hotel, preserved_params.merge(tab: "fb")), data: { testid: "extra-charge-tab-fb" }) %>
    <% tabs.with_tab(name: "non_fb", label: "Non-F&B", href: extra_charge_hotel_reports_path(current_hotel, preserved_params.merge(tab: "non_fb")), data: { testid: "extra-charge-tab-non-fb" }) %>
  <% end %>

  <div class="grid grid-cols-1 overflow-hidden rounded-2xl border border-border bg-card shadow-sm md:grid-cols-2">
    <div class="p-6 md:border-r md:border-border">
      <p class="mb-2 text-[11px] font-semibold uppercase tracking-wider text-muted-foreground">Transactions</p>
      <h2 class="text-2xl font-bold tracking-tight text-foreground"><%= @report.totals[:transaction_count] %></h2>
    </div>
    <div class="bg-muted/30 p-6">
      <p class="mb-2 text-[11px] font-semibold uppercase tracking-wider text-muted-foreground">Total Amount</p>
      <h2 class="text-2xl font-bold tracking-tight text-foreground">MYR <%= number_with_precision(@report.totals[:total_amount], precision: 2) %></h2>
    </div>
  </div>

  <% if @date_preset == "this_year" %>
    <section class="space-y-4" aria-labelledby="extra-charge-monthly-breakdown-heading">
      <h2 id="extra-charge-monthly-breakdown-heading" class="text-base font-semibold">Monthly Breakdown</h2>
      <div class="overflow-x-auto rounded-xl border border-border">
        <table class="min-w-full">
          <thead class="bg-muted">
            <tr>
              <th class="px-4 py-3 text-left text-sm font-medium text-muted-foreground">Month</th>
              <th class="px-4 py-3 text-right text-sm font-medium text-muted-foreground">Transactions</th>
              <th class="px-4 py-3 text-right text-sm font-medium text-muted-foreground">Total Amount</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-border bg-card">
            <% @report.monthly_rows.each do |row| %>
              <tr class="hover:bg-muted/50">
                <td class="whitespace-nowrap px-4 py-3 text-sm font-semibold text-foreground"><%= row[:date].strftime("%b %Y") %></td>
                <td class="px-4 py-3 text-right text-sm text-foreground"><%= row[:transaction_count] %></td>
                <td class="px-4 py-3 text-right text-sm font-semibold text-foreground">MYR <%= number_with_precision(row[:total_amount], precision: 2) %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </section>
  <% end %>

  <div class="overflow-hidden rounded-2xl border border-border bg-card shadow-sm">
    <div class="overflow-x-auto">
      <table class="min-w-full">
        <thead class="bg-muted">
          <tr>
            <th class="px-6 py-4 text-left text-[11px] font-semibold uppercase tracking-[0.1em] text-muted-foreground">Posting Date</th>
            <th class="px-6 py-4 text-left text-[11px] font-semibold uppercase tracking-[0.1em] text-muted-foreground">Guest / Booking</th>
            <th class="px-6 py-4 text-left text-[11px] font-semibold uppercase tracking-[0.1em] text-muted-foreground">Folio</th>
            <th class="px-6 py-4 text-left text-[11px] font-semibold uppercase tracking-[0.1em] text-muted-foreground">Description</th>
            <th class="px-6 py-4 text-left text-[11px] font-semibold uppercase tracking-[0.1em] text-muted-foreground">Category</th>
            <th class="px-6 py-4 text-right text-[11px] font-semibold uppercase tracking-[0.1em] text-muted-foreground">Amount</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-border bg-card">
          <% if @report.rows.any? %>
            <% @report.rows.each do |row| %>
              <tr class="hover:bg-muted/50">
                <td class="px-6 py-4 text-sm font-medium text-foreground"><%= row[:posting_date].strftime("%d %b %Y") %></td>
                <td class="px-6 py-4">
                  <p class="text-sm font-semibold text-foreground"><%= row[:guest_name] %></p>
                  <p class="mt-1 text-xs font-mono text-muted-foreground"><%= row[:booking_reference] %></p>
                </td>
                <td class="px-6 py-4 text-sm text-foreground"><%= row[:folio_number] %></td>
                <td class="px-6 py-4 text-sm text-foreground"><%= row[:description] %></td>
                <td class="px-6 py-4 text-sm font-semibold text-foreground"><%= row[:category].to_s == "fb" ? "F&B" : row[:category].to_s.upcase %></td>
                <td class="px-6 py-4 text-right text-sm font-semibold text-foreground">MYR <%= number_with_precision(row[:amount], precision: 2) %></td>
              </tr>
            <% end %>
          <% else %>
            <tr>
              <td colspan="6" class="px-6 py-16 text-center text-sm font-medium text-muted-foreground">
                No extra charges found for this selected period.
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
</div>
