<div class="w-full space-y-8">
  <div class="">
 <div class="flex flex-col gap-4 md:flex-row md:items-end md:justify-between">
      <div>
        <h1 class="text-2xl font-bold tracking-tight text-foreground sm:text-3xl">Extra Charge Report</h1>
        <p class="mt-1 text-sm font-medium text-muted-foreground">
          <%= current_hotel.name %> ·
          <% if @report.start_date == @report.end_date %>
            <%= @report.start_date.strftime("%A, %d %b %Y") %>
          <% else %>
            <%= @report.start_date.strftime("%d %b %Y") %> - <%= @report.end_date.strftime("%d %b %Y") %>
          <% end %>
        </p>
      </div>

      <%= form_with url: extra_charge_hotel_reports_path(current_hotel), method: :get, local: true, class: "flex flex-col gap-3 md:flex-row md:items-end", data: { controller: "date-preset" } do |f| %>
        <%= hidden_field_tag :tab, @active_extra_charge_tab %>
        <div>
          <label class="mb-2 block text-[11px] font-bold uppercase tracking-wider text-muted-foreground">Time Period</label>
          <%= select_tag :date_preset, options_for_select(date_preset_options, @date_preset), class: "rounded-xl border border-border bg-card px-4 py-2.5 text-sm font-bold text-foreground shadow-sm transition focus:border-border-interactive focus:outline-none", data: { action: "change->date-preset#toggleCustom" } %>
        </div>
        <div id="custom-date-range" class="<%= @date_preset == 'custom' ? 'flex' : 'hidden' %> gap-3">
          <div>
            <label class="mb-2 block text-[11px] font-bold uppercase tracking-wider text-muted-foreground">Start Date</label>
            <%= f.date_field :start_date, value: @report.start_date, class: "rounded-xl border border-border bg-card px-4 py-2.5 text-sm font-bold text-foreground" %>
          </div>
          <div>
            <label class="mb-2 block text-[11px] font-bold uppercase tracking-wider text-muted-foreground">End Date</label>
            <%= f.date_field :end_date, value: @report.end_date, class: "rounded-xl border border-border bg-card px-4 py-2.5 text-sm font-bold text-foreground" %>
          </div>
        </div>
        <% if feature_enabled_for_hotel?("excel_pdf_export") %>
        <details class="relative min-w-[170px]">
          <summary class="list-none inline-flex w-full cursor-pointer items-center justify-center rounded-xl border border-border bg-card px-4 py-2.5 text-sm font-bold text-foreground shadow-sm transition hover:border-border-interactive hover:bg-muted">
            <svg class="size-4 me-2" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
            Export
          </summary>
          <div class="absolute right-0 z-20 mt-2 w-44 overflow-hidden rounded-xl border border-border bg-card shadow-xl">
            <%= link_to "Export PDF", extra_charge_hotel_reports_path(current_hotel, start_date: @report.start_date, end_date: @report.end_date, date_preset: @date_preset, tab: @active_extra_charge_tab, format: :pdf), class: "block px-4 py-2.5 text-sm font-semibold text-foreground transition hover:bg-muted" %>
            <%= link_to "Export Excel", extra_charge_hotel_reports_path(current_hotel, start_date: @report.start_date, end_date: @report.end_date, date_preset: @date_preset, tab: @active_extra_charge_tab, format: :xls), class: "block border-t border-border px-4 py-2.5 text-sm font-semibold text-foreground transition hover:bg-muted" %>
            <%= link_to "Export CSV", extra_charge_hotel_reports_path(current_hotel, start_date: @report.start_date, end_date: @report.end_date, date_preset: @date_preset, tab: @active_extra_charge_tab, format: :csv), class: "block border-t border-border px-4 py-2.5 text-sm font-semibold text-foreground transition hover:bg-muted" %>
          </div>
        </details>
        <% end %>
      <% end %>
    </div>
  </div>

  <div class="grid grid-cols-1 gap-4 md:grid-cols-3">
    <div class="rounded-2xl border border-border bg-card p-6 shadow-sm">
      <p class="mb-2 text-[11px] font-semibold uppercase tracking-wider text-muted-foreground">Active Tab</p>
      <h2 class="text-2xl font-bold tracking-tight text-foreground"><%= @active_extra_charge_tab == "fb" ? "F&B" : "Non-F&B" %></h2>
    </div>
    <div class="rounded-2xl border border-border bg-card p-6 shadow-sm">
      <p class="mb-2 text-[11px] font-semibold uppercase tracking-wider text-muted-foreground">Transactions</p>
      <h2 class="text-2xl font-bold tracking-tight text-foreground"><%= @report.totals[:transaction_count] %></h2>
    </div>
    <div class="rounded-2xl border border-border bg-card p-6 shadow-sm">
      <p class="mb-2 text-[11px] font-semibold uppercase tracking-wider text-muted-foreground">Total Amount</p>
      <h2 class="text-2xl font-bold tracking-tight text-foreground">MYR <%= number_with_precision(@report.totals[:total_amount], precision: 2) %></h2>
    </div>
  </div>

  <div class="flex flex-wrap items-center gap-2">
    <% {
      "fb" => { label: "F&B" },
      "non_fb" => { label: "Non-F&B" }
    }.each do |tab, config| %>
      <% active = @active_extra_charge_tab == tab %>
      <%= link_to extra_charge_hotel_reports_path(current_hotel, tab: tab, start_date: @report.start_date, end_date: @report.end_date, date_preset: @date_preset),
        class: "inline-flex h-10 items-center whitespace-nowrap rounded-xl border px-4 text-sm font-semibold transition #{active ? 'border-blue-600 bg-blue-600 text-primary-foreground shadow-sm' : 'border-border bg-card text-foreground hover:border-border-interactive hover:bg-muted'}" do %>
        <span><%= config[:label] %></span>
      <% end %>
    <% end %>
  </div>

  <div class="overflow-hidden rounded-2xl border border-border bg-card shadow-sm">
    <div class="overflow-x-auto">
      <table class="min-w-full">
        <thead class="bg-muted">
          <tr>
            <th class="px-6 py-4 text-left text-[11px] font-semibold uppercase tracking-[0.1em] text-muted-foreground">Posting Date</th>
            <th class="px-6 py-4 text-left text-[11px] font-semibold uppercase tracking-[0.1em] text-muted-foreground">Guest / Booking</th>
            <th class="px-6 py-4 text-left text-[11px] font-semibold uppercase tracking-[0.1em] text-muted-foreground">Folio</th>
            <th class="px-6 py-4 text-left text-[11px] font-semibold uppercase tracking-[0.1em] text-muted-foreground">Description</th>
            <th class="px-6 py-4 text-left text-[11px] font-semibold uppercase tracking-[0.1em] text-muted-foreground">Category</th>
            <th class="px-6 py-4 text-right text-[11px] font-semibold uppercase tracking-[0.1em] text-muted-foreground">Amount</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-border bg-card">
          <% if @report.rows.any? %>
            <% @report.rows.each do |row| %>
              <tr class="hover:bg-muted/50">
                <td class="px-6 py-4 text-sm font-medium text-foreground"><%= row[:posting_date].strftime("%d %b %Y") %></td>
                <td class="px-6 py-4">
                  <p class="text-sm font-semibold text-foreground"><%= row[:guest_name] %></p>
                  <p class="mt-1 text-xs font-mono text-muted-foreground"><%= row[:booking_reference] %></p>
                </td>
                <td class="px-6 py-4 text-sm text-foreground"><%= row[:folio_number] %></td>
                <td class="px-6 py-4 text-sm text-foreground"><%= row[:description] %></td>
                <td class="px-6 py-4 text-sm font-semibold text-foreground"><%= row[:category].to_s == "fb" ? "F&B" : row[:category].to_s.upcase %></td>
                <td class="px-6 py-4 text-right text-sm font-semibold text-foreground">MYR <%= number_with_precision(row[:amount], precision: 2) %></td>
              </tr>
            <% end %>
          <% else %>
            <tr>
              <td colspan="6" class="px-6 py-16 text-center text-sm font-medium text-muted-foreground">
                No extra charges found for this selected period.
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
</div>
