<%= render HotelPortal::Reports::MetricStrip.new(metrics: [
  { label: "Bookings", value: @report.totals[:booking_count].to_s, detail: "Selected period" },
  { label: "Taxable amount", value: "MYR #{number_with_precision(@report.totals[:taxable_amount], precision: 2)}", detail: "Selected period" },
  { label: "SST collected (8%)", value: "MYR #{number_with_precision(@report.totals[:sst_amount], precision: 2)}", detail: "Selected period" },
  { label: "Grand total", value: "MYR #{number_with_precision(@report.totals[:total_amount], precision: 2)}", detail: "Selected period" }
]) %>

<section class="space-y-3" aria-labelledby="sst-transactions-heading">
  <h2 id="sst-transactions-heading" class="text-base font-semibold text-foreground">SST transactions</h2>

  <% grouped_rows = @date_preset == "this_year" ? @report.rows.group_by { |row| row[:report_month] } : { nil => @report.rows } %>
  <div class="space-y-3">
    <% grouped_rows.each do |month, rows| %>
      <section class="space-y-2">
        <% if month.present? %>
          <h3 id="sst-month-<%= month.strftime('%Y-%m') %>" class="text-sm font-semibold text-foreground"><%= month.strftime("%B %Y") %></h3>
        <% end %>

        <%= render PanelsUI::Table.new(
              caption: month.present? ? "SST transactions for #{month.strftime('%B %Y')}" : "SST transactions",
              density: :compact,
              header_style: :sentence,
              hoverable: true,
              class: "min-w-[760px]",
              wrapper_class: "rounded-lg border border-border bg-card"
            ) do |table| %>
          <% table.with_header do %>
            <tr>
              <th scope="col">Invoice / ref</th>
              <th scope="col">Guest</th>
              <th scope="col">Stay</th>
              <th scope="col" class="text-right">Taxable amount</th>
              <th scope="col" class="text-right">SST 8%</th>
              <th scope="col" class="text-right">Total</th>
            </tr>
          <% end %>
          <% table.with_body do %>
            <% if rows.any? %>
              <% rows.each do |row| %>
                <tr class="align-top">
                  <th scope="row" class="whitespace-nowrap font-semibold text-foreground"><%= row[:invoice_number] %></th>
                  <td class="whitespace-nowrap"><%= row[:guest_name] %></td>
                  <td class="whitespace-nowrap"><%= row[:stay_dates] %></td>
                  <td class="whitespace-nowrap text-right tabular-nums">MYR <%= number_with_precision(row[:taxable_amount], precision: 2) %></td>
                  <td class="whitespace-nowrap text-right tabular-nums">MYR <%= number_with_precision(row[:sst_amount], precision: 2) %></td>
                  <td class="whitespace-nowrap text-right font-semibold tabular-nums">MYR <%= number_with_precision(row[:total_amount], precision: 2) %></td>
                </tr>
              <% end %>
              <% if month.nil? %>
                <tr class="bg-muted/55 font-semibold">
                  <th scope="row" colspan="3">Total (<%= @report.totals[:booking_count] %> bookings)</th>
                  <td class="whitespace-nowrap text-right tabular-nums">MYR <%= number_with_precision(@report.totals[:taxable_amount], precision: 2) %></td>
                  <td class="whitespace-nowrap text-right tabular-nums">MYR <%= number_with_precision(@report.totals[:sst_amount], precision: 2) %></td>
                  <td class="whitespace-nowrap text-right tabular-nums">MYR <%= number_with_precision(@report.totals[:total_amount], precision: 2) %></td>
                </tr>
              <% end %>
            <% else %>
              <%= render "table_empty_state", colspan: 6, message: "No SST transactions found for this period." %>
            <% end %>
          <% end %>
        <% end %>
      </section>
    <% end %>
  </div>
</section>
