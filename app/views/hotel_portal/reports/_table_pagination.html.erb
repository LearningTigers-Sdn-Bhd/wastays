<% if pagy.pages > 1 %>
  <div class="flex justify-center border-t border-border px-3 py-2" data-slot="report-pagination">
    <%= render PanelsUI::Pagination.new(
          pagy: pagy,
          aria_label: local_assigns.fetch(:aria_label, "Report pagination"),
          link_data: local_assigns.fetch(:link_data, {})
        ) %>
  </div>
<% end %>
