<% adjustment = daily_report_adjustment_presentation(@revenue_report.totals[:adjustments]) %>
<%= render "daily_report_metric_row", aria_label: "Revenue summary", metrics: [
  { label: "Bookings engaged", value: @revenue_report.totals[:booking_count].to_s, detail: "Bookings with posted revenue" },
  { label: "Total charges", value: "MYR #{number_with_precision(@revenue_report.totals[:total_charges], precision: 2)}", detail: "Before adjustments" },
  { label: "Adjustments", value: adjustment[:value], detail: adjustment[:detail], detail_variant: adjustment[:variant] },
  { label: "Net revenue", value: "MYR #{number_with_precision(@revenue_report.totals[:net_revenue], precision: 2)}", detail: "After adjustments", detail_variant: :success }
] %>

<section class="space-y-3" aria-labelledby="revenue-breakdown-heading">
  <h2 id="revenue-breakdown-heading" class="text-base font-semibold text-foreground"><%= @date_preset == "this_year" ? "Monthly breakdown" : "Daily breakdown" %></h2>
  <%= render PanelsUI::Table.new(
        caption: @date_preset == "this_year" ? "Monthly revenue breakdown" : "Daily revenue breakdown",
        density: :compact,
        header_style: :sentence,
        hoverable: true,
        wrapper_class: "rounded-lg border border-border bg-card"
      ) do |table| %>
    <% table.with_header do %>
      <tr>
        <% [@date_preset == "this_year" ? "Month" : "Date", "Bookings", "Accommodation", "Other charges", "Tax", "Total charges", "Adjustments", "Net revenue"].each_with_index do |heading, index| %>
          <th scope="col" class="<%= index >= 2 ? "text-right" : "text-left" %>"><%= heading %></th>
        <% end %>
      </tr>
    <% end %>
    <% table.with_body do %>
      <% if @revenue_report.rows.any? %>
        <% @revenue_report.rows.each do |row| %>
          <tr>
            <th scope="row" class="whitespace-nowrap font-semibold text-foreground"><%= @date_preset == "this_year" ? row[:date].strftime("%b %Y") : row[:date].strftime("%d %b") %></th>
            <td><%= row[:booking_count] %></td>
            <td class="text-right">MYR <%= number_with_precision(row[:accommodation], precision: 2) %></td>
            <td class="text-right">MYR <%= number_with_precision(row[:other_charges], precision: 2) %></td>
            <td class="text-right">MYR <%= number_with_precision(row[:tax], precision: 2) %></td>
            <td class="text-right font-semibold">MYR <%= number_with_precision(row[:total_charges], precision: 2) %></td>
            <% row_adjustment = daily_report_adjustment_presentation(row[:adjustments]) %>
            <td class="text-right <%= row[:adjustments].positive? ? "text-success" : (row[:adjustments].negative? ? "text-destructive" : "text-foreground") %>"><%= row_adjustment[:value] %></td>
            <td class="text-right font-semibold text-success">MYR <%= number_with_precision(row[:net_revenue], precision: 2) %></td>
          </tr>
        <% end %>
      <% else %>
        <%= render "table_empty_state", colspan: 8, message: "No revenue data for this selected period." %>
      <% end %>
    <% end %>
  <% end %>
</section>

<section class="space-y-3" aria-labelledby="revenue-source-heading">
  <h2 id="revenue-source-heading" class="text-base font-semibold text-foreground">Revenue by source</h2>
  <%= render PanelsUI::Table.new(
        caption: "Revenue by source",
        density: :compact,
        header_style: :sentence,
        hoverable: true,
        wrapper_class: "rounded-lg border border-border bg-card"
      ) do |table| %>
    <% table.with_header do %>
      <tr>
        <% ["Source", "Bookings", "Accommodation", "Other charges", "Tax", "Total charges", "Adjustments", "Net revenue"].each_with_index do |heading, index| %>
          <th scope="col" class="<%= index >= 2 ? "text-right" : "text-left" %>"><%= heading %></th>
        <% end %>
      </tr>
    <% end %>
    <% table.with_body do %>
      <% if @revenue_report.source_rows.any? %>
        <% @revenue_report.source_rows.each do |row| %>
          <tr>
            <th scope="row" class="font-semibold text-foreground"><%= row[:source] %></th>
            <td><%= row[:booking_count] %></td>
            <td class="text-right">MYR <%= number_with_precision(row[:accommodation], precision: 2) %></td>
            <td class="text-right">MYR <%= number_with_precision(row[:other_charges], precision: 2) %></td>
            <td class="text-right">MYR <%= number_with_precision(row[:tax], precision: 2) %></td>
            <td class="text-right font-semibold">MYR <%= number_with_precision(row[:total_charges], precision: 2) %></td>
            <% source_adjustment = daily_report_adjustment_presentation(row[:adjustments]) %>
            <td class="text-right <%= row[:adjustments].positive? ? "text-success" : (row[:adjustments].negative? ? "text-destructive" : "text-foreground") %>"><%= source_adjustment[:value] %></td>
            <td class="text-right font-semibold">MYR <%= number_with_precision(row[:net_revenue], precision: 2) %></td>
          </tr>
        <% end %>
      <% else %>
        <%= render "table_empty_state", colspan: 8, message: "No source revenue data for this selected period." %>
      <% end %>
    <% end %>
  <% end %>
</section>

<section class="space-y-3" aria-labelledby="revenue-register-heading">
  <div class="flex items-center justify-between gap-4">
    <h2 id="revenue-register-heading" class="text-base font-semibold text-foreground">Revenue register</h2>
    <p class="text-sm text-muted-foreground"><%= @charge_register_count %> transaction<%= "s" unless @charge_register_count == 1 %></p>
  </div>
  <%= render PanelsUI::Table.new(
        caption: "Revenue register",
        density: :compact,
        header_style: :sentence,
        hoverable: true,
        wrapper_class: "rounded-lg border border-border bg-card",
        data: { testid: "charge-register-rows" }
      ) do |table| %>
    <% table.with_header do %>
      <tr>
        <% ["Date", "Service", "Booking / folio", "Guest", "Status", "Base amount", "Tax", "Total amount"].each_with_index do |heading, index| %>
          <th scope="col" class="<%= index >= 5 ? "text-right" : "text-left" %>"><%= heading %></th>
        <% end %>
      </tr>
    <% end %>
    <% table.with_body do %>
      <% if @charge_register_rows.present? %>
        <% @charge_register_rows.each do |row| %>
          <tr data-testid="charge-register-row">
            <td class="whitespace-nowrap">
              <%= row.posting_date.strftime("%d %b %Y") %>
              <span class="block text-xs text-muted-foreground"><%= row.transaction_time.strftime("%-I:%M %p") %></span>
            </td>
            <td>
              <%= row.service_name %>
              <% if row.transaction_code != "—" %>
                <span class="block text-xs text-muted-foreground"><%= row.transaction_code %></span>
              <% end %>
            </td>
            <td>
              <%= link_to row.booking_reference, hotel_booking_control_panel_path(current_hotel, row.booking, tab: "folio_operations", folio_id: row.folio.id) %>
              <span class="block text-xs text-muted-foreground">Folio <%= row.folio_number %></span>
            </td>
            <td>
              <%= row.guest_name %>
              <% if row.room_details.present? %>
                <span class="block whitespace-nowrap text-xs text-muted-foreground"><%= row.room_details %></span>
              <% end %>
            </td>
            <td><%= row.relationship_status %></td>
            <td class="whitespace-nowrap text-right font-semibold <%= row.signed_amount.negative? ? "text-destructive" : "text-foreground" %>">
              <%= row.currency %> <%= number_with_precision(row.signed_amount, precision: 2) %>
            </td>
            <td class="whitespace-nowrap text-right font-semibold <%= row.tax_amount.negative? ? "text-destructive" : "text-foreground" %>">
              <%= row.currency %> <%= number_with_precision(row.tax_amount, precision: 2) %>
            </td>
            <td class="whitespace-nowrap text-right font-semibold <%= row.total_amount.negative? ? "text-destructive" : "text-foreground" %>">
              <%= row.currency %> <%= number_with_precision(row.total_amount, precision: 2) %>
            </td>
          </tr>
        <% end %>
      <% else %>
        <%= render "table_empty_state", colspan: 8, message: "No revenue transactions found for this selected period." %>
      <% end %>
    <% end %>
  <% end %>
  <%= render "table_pagination", collection: @charge_register_rows %>
</section>
