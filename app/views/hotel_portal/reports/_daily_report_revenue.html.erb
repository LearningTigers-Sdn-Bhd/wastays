<% adjustment = daily_report_adjustment_presentation(@revenue_report.totals[:adjustments]) %>
<section class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4" aria-label="Revenue metrics">
  <%= render PanelsUI::MetricCard.new(label: "Bookings Engaged", value: @revenue_report.totals[:booking_count].to_s, detail: "Bookings with posted revenue") %>
  <%= render PanelsUI::MetricCard.new(label: "Total Charges", value: "MYR #{number_with_precision(@revenue_report.totals[:total_charges], precision: 2)}", detail: "Before adjustments") %>
  <%= render PanelsUI::MetricCard.new(label: "Adjustments", value: adjustment[:value], detail: adjustment[:detail], detail_variant: adjustment[:variant]) %>
  <%= render PanelsUI::MetricCard.new(label: "Net Revenue", value: "MYR #{number_with_precision(@revenue_report.totals[:net_revenue], precision: 2)}", detail: "After adjustments", detail_variant: :success) %>
</section>

<section class="space-y-4" aria-labelledby="revenue-breakdown-heading">
  <h2 id="revenue-breakdown-heading" class="text-base font-semibold"><%= @date_preset == "this_year" ? "Monthly Breakdown" : "Daily Breakdown" %></h2>
  <div class="overflow-x-auto rounded-xl border border-border">
    <table class="min-w-full">
      <thead class="bg-muted">
        <tr>
          <% [@date_preset == "this_year" ? "Month" : "Date", "Bookings", "Accommodation", "Other Charges", "Tax", "Total Charges", "Adjustments", "Net Revenue"].each_with_index do |heading, index| %>
            <th class="px-4 py-3 text-sm font-medium text-muted-foreground <%= index >= 2 ? "text-right" : "text-left" %>"><%= heading %></th>
          <% end %>
        </tr>
      </thead>
      <tbody class="divide-y divide-border bg-card">
        <% if @revenue_report.rows.any? %>
          <% @revenue_report.rows.each do |row| %>
            <tr class="hover:bg-muted/50">
              <td class="px-4 py-3 text-sm font-semibold text-foreground whitespace-nowrap"><%= @date_preset == "this_year" ? row[:date].strftime("%b %Y") : row[:date].strftime("%d %b") %></td>
              <td class="px-4 py-3 text-sm text-foreground"><%= row[:booking_count] %></td>
              <td class="px-4 py-3 text-sm text-foreground text-right">MYR <%= number_with_precision(row[:accommodation], precision: 2) %></td>
              <td class="px-4 py-3 text-sm text-foreground text-right">MYR <%= number_with_precision(row[:other_charges], precision: 2) %></td>
              <td class="px-4 py-3 text-sm text-foreground text-right">MYR <%= number_with_precision(row[:tax], precision: 2) %></td>
              <td class="px-4 py-3 text-sm font-semibold text-foreground text-right">MYR <%= number_with_precision(row[:total_charges], precision: 2) %></td>
              <% row_adjustment = daily_report_adjustment_presentation(row[:adjustments]) %>
              <td class="px-4 py-3 text-sm <%= row[:adjustments].positive? ? "text-success" : (row[:adjustments].negative? ? "text-destructive" : "text-foreground") %> text-right"><%= row_adjustment[:value] %></td>
              <td class="px-4 py-3 text-sm font-semibold text-success text-right">MYR <%= number_with_precision(row[:net_revenue], precision: 2) %></td>
            </tr>
          <% end %>
        <% else %>
          <tr><td colspan="8" class="px-6 py-20 text-center text-sm text-muted-foreground">No revenue data for this selected period.</td></tr>
        <% end %>
      </tbody>
    </table>
  </div>
</section>

<section class="space-y-4" aria-labelledby="revenue-source-heading">
  <h2 id="revenue-source-heading" class="text-base font-semibold">Revenue by Source</h2>
  <div class="overflow-x-auto rounded-xl border border-border">
    <table class="min-w-full">
      <thead class="bg-muted">
        <tr>
          <% ["Source", "Bookings", "Accommodation", "Other Charges", "Tax", "Total Charges", "Adjustments", "Net Revenue"].each_with_index do |heading, index| %>
            <th class="px-6 py-4 text-sm font-medium text-muted-foreground <%= index >= 2 ? "text-right" : "text-left" %>"><%= heading %></th>
          <% end %>
        </tr>
      </thead>
      <tbody class="divide-y divide-border bg-card">
        <% if @revenue_report.source_rows.any? %>
          <% @revenue_report.source_rows.each do |row| %>
            <tr>
              <td class="px-6 py-4 text-sm font-semibold text-foreground"><%= row[:source] %></td>
              <td class="px-6 py-4 text-sm text-foreground"><%= row[:booking_count] %></td>
              <td class="px-6 py-4 text-sm text-foreground text-right">MYR <%= number_with_precision(row[:accommodation], precision: 2) %></td>
              <td class="px-6 py-4 text-sm text-foreground text-right">MYR <%= number_with_precision(row[:other_charges], precision: 2) %></td>
              <td class="px-6 py-4 text-sm text-foreground text-right">MYR <%= number_with_precision(row[:tax], precision: 2) %></td>
              <td class="px-6 py-4 text-sm font-semibold text-foreground text-right">MYR <%= number_with_precision(row[:total_charges], precision: 2) %></td>
              <% source_adjustment = daily_report_adjustment_presentation(row[:adjustments]) %>
              <td class="px-6 py-4 text-sm <%= row[:adjustments].positive? ? "text-success" : (row[:adjustments].negative? ? "text-destructive" : "text-foreground") %> text-right"><%= source_adjustment[:value] %></td>
              <td class="px-6 py-4 text-sm font-semibold text-foreground text-right">MYR <%= number_with_precision(row[:net_revenue], precision: 2) %></td>
            </tr>
          <% end %>
        <% else %>
          <tr><td colspan="8" class="px-6 py-20 text-center text-sm text-muted-foreground">No source revenue data for this selected period.</td></tr>
        <% end %>
      </tbody>
    </table>
  </div>
</section>

<section class="space-y-4" aria-labelledby="charge-register-heading">
  <div class="flex items-center justify-between gap-4">
    <h2 id="charge-register-heading" class="text-base font-semibold">Charge Register</h2>
    <p class="text-sm text-muted-foreground"><%= @charge_register_count %> charge<%= "s" unless @charge_register_count == 1 %></p>
  </div>
  <div class="overflow-hidden rounded-xl border border-border bg-card">
    <div class="overflow-x-auto">
    <table class="min-w-full">
      <thead class="bg-muted">
        <tr>
          <% ["Date", "Code", "Service", "Type", "Booking / Folio", "Guest", "Status", "Amount"].each_with_index do |heading, index| %>
            <th class="px-4 py-3 text-sm font-medium text-muted-foreground <%= index == 7 ? "text-right" : "text-left" %>"><%= heading %></th>
          <% end %>
        </tr>
      </thead>
      <tbody class="divide-y divide-border bg-card" data-testid="charge-register-rows">
        <% if @charge_register_rows.present? %>
          <% @charge_register_rows.each do |row| %>
            <tr class="hover:bg-muted/50" data-testid="charge-register-row">
              <td class="px-4 py-3 text-sm text-foreground whitespace-nowrap">
                <%= row.posting_date.strftime("%d %b %Y") %>
                <% if row.posted_at %><span class="block text-xs text-muted-foreground"><%= row.posted_at.strftime("%H:%M") %></span><% end %>
              </td>
              <td class="px-4 py-3 text-sm text-foreground"><%= row.transaction_code %></td>
              <td class="px-4 py-3 text-sm text-foreground"><%= row.service_name %></td>
              <td class="px-4 py-3 text-sm text-muted-foreground"><%= row.transaction_type.to_s.humanize %> · <%= row.category.to_s.humanize %></td>
              <td class="px-4 py-3 text-sm text-foreground">
                <%= link_to row.booking_reference, hotel_booking_control_panel_path(current_hotel, row.booking, tab: "folio_operations", folio_id: row.folio.id) %>
                <span class="block text-xs text-muted-foreground">Folio <%= row.folio_number %></span>
              </td>
              <td class="px-4 py-3 text-sm text-foreground"><%= row.guest_name %></td>
              <td class="px-4 py-3 text-sm text-foreground"><%= row.relationship_status %></td>
              <td class="px-4 py-3 text-sm font-semibold text-foreground text-right"><%= row.currency %> <%= number_with_precision(row.signed_amount, precision: 2) %></td>
            </tr>
          <% end %>
        <% else %>
          <tr><td colspan="8" class="px-6 py-20 text-center text-sm text-muted-foreground">No posted charges found for this selected period.</td></tr>
        <% end %>
      </tbody>
    </table>
    </div>
    <% if @charge_register_transactions.present? %>
      <div class="border-t border-border px-4 py-3 flex justify-center">
        <%= paginate @charge_register_transactions %>
      </div>
    <% end %>
  </div>
</section>
