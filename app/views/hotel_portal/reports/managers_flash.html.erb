<div class="w-full space-y-8">
  <div class="">
 <div class="flex flex-col gap-4 md:flex-row md:items-end md:justify-between">
      <div>
        <h1 class="text-2xl font-bold tracking-tight text-foreground sm:text-3xl">Manager Flash Report</h1>
        <p class="mt-1 text-sm font-medium text-muted-foreground">
          <%= current_hotel.name %> ·
          <% if @report.start_date == @report.end_date %>
            <%= @report.start_date.strftime("%A, %d %b %Y") %>
          <% else %>
            <%= @report.start_date.strftime("%d %b %Y") %> - <%= @report.end_date.strftime("%d %b %Y") %>
          <% end %>
        </p>
      </div>

      <%= form_with url: managers_flash_hotel_reports_path(current_hotel), method: :get, local: true, class: "flex flex-col gap-3 md:flex-row md:items-end", id: "managers-flash-range-form", data: { controller: "date-preset" } do |f| %>
        <div>
          <label class="mb-2 block text-[11px] font-bold uppercase tracking-wider text-muted-foreground">Time Period</label>
          <%= select_tag :date_preset, options_for_select(date_preset_options, @date_preset), class: "rounded-xl border border-border bg-card px-4 py-2.5 text-sm font-bold text-foreground shadow-sm transition focus:border-border-interactive focus:outline-none", data: { action: "change->date-preset#toggleCustom" } %>
        </div>
        <div id="custom-date-range" class="<%= @date_preset == 'custom' ? 'flex' : 'hidden' %> gap-3">
          <div>
            <label class="mb-2 block text-[11px] font-bold uppercase tracking-wider text-muted-foreground">Start Date</label>
            <%= f.date_field :start_date, value: @report.start_date, class: "rounded-xl border border-border bg-card px-4 py-2.5 text-sm font-bold text-foreground" %>
          </div>
          <div>
            <label class="mb-2 block text-[11px] font-bold uppercase tracking-wider text-muted-foreground">End Date</label>
            <%= f.date_field :end_date, value: @report.end_date, class: "rounded-xl border border-border bg-card px-4 py-2.5 text-sm font-bold text-foreground" %>
          </div>
        </div>
        <details class="relative min-w-[170px]">
          <summary class="list-none inline-flex w-full cursor-pointer items-center justify-center rounded-xl border border-border bg-card px-4 py-2.5 text-sm font-bold text-foreground shadow-sm transition hover:border-border-interactive hover:bg-muted">
            <svg class="size-4 me-2" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
            Export
          </summary>
          <div class="absolute right-0 z-20 mt-2 w-44 overflow-hidden rounded-xl border border-border bg-card shadow-xl">
            <%= link_to "Export PDF", managers_flash_hotel_reports_path(current_hotel, start_date: @report.start_date, end_date: @report.end_date, format: :pdf), class: "block px-4 py-2.5 text-sm font-semibold text-foreground transition hover:bg-muted" %>
            <%= link_to "Export Excel", managers_flash_hotel_reports_path(current_hotel, start_date: @report.start_date, end_date: @report.end_date, format: :xls), class: "block border-t border-border px-4 py-2.5 text-sm font-semibold text-foreground transition hover:bg-muted" %>
            <%= link_to "Export CSV", managers_flash_hotel_reports_path(current_hotel, start_date: @report.start_date, end_date: @report.end_date, format: :csv), class: "block border-t border-border px-4 py-2.5 text-sm font-semibold text-foreground transition hover:bg-muted" %>
          </div>
        </details>
      <% end %>
    </div>
  </div>

  <!-- Metrics Dashboard -->
  <div class="bg-card border border-border shadow-sm rounded-2xl overflow-hidden">
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-6 divide-y sm:divide-y-0 sm:divide-x divide-border">

      <div class="p-6 lg:p-8 flex flex-col justify-between min-h-[160px] group transition-colors hover:bg-muted">
        <p class="text-[11px] font-semibold tracking-wide text-muted-foreground uppercase leading-snug pe-4">Rooms Sold</p>
        <div class="mt-4">
          <h2 class="text-3xl font-medium tracking-tight text-foreground tabular-nums"><%= @report.totals[:rooms_sold] %></h2>
        </div>
      </div>

      <div class="p-6 lg:p-8 flex flex-col justify-between min-h-[160px] group transition-colors hover:bg-muted">
        <p class="text-[11px] font-semibold tracking-wide text-muted-foreground uppercase leading-snug pe-4">Occupancy %</p>
        <div class="mt-4">
          <h2 class="text-3xl font-medium tracking-tight text-foreground tabular-nums"><%= number_to_percentage(@report.totals[:occupancy_rate] * 100, precision: 2) %></h2>
        </div>
      </div>

      <div class="p-6 lg:p-8 flex flex-col justify-between min-h-[160px] group transition-colors hover:bg-muted">
        <p class="text-[11px] font-semibold tracking-wide text-muted-foreground uppercase leading-snug pe-4">Average Daily Rate<br><span class="text-muted-foreground">(ADR)</span></p>
        <div class="mt-4 flex items-baseline gap-1">
          <span class="text-xs font-semibold text-muted-foreground">MYR</span>
          <h2 class="text-3xl font-medium tracking-tight text-foreground tabular-nums"><%= number_with_precision(@report.totals[:adr], precision: 2) %></h2>
        </div>
      </div>

      <div class="p-6 lg:p-8 flex flex-col justify-between min-h-[160px] group transition-colors hover:bg-muted">
        <p class="text-[11px] font-semibold tracking-wide text-muted-foreground uppercase leading-snug pe-4">Revenue per Available Room<br><span class="text-muted-foreground">(RevPAR)</span></p>
        <div class="mt-4 flex items-baseline gap-1">
          <span class="text-xs font-semibold text-muted-foreground">MYR</span>
          <h2 class="text-3xl font-medium tracking-tight text-foreground tabular-nums"><%= number_with_precision(@report.totals[:revpar], precision: 2) %></h2>
        </div>
      </div>

      <div class="p-6 lg:p-8 flex flex-col justify-between min-h-[160px] group transition-colors hover:bg-muted">
        <p class="text-[11px] font-semibold tracking-wide text-muted-foreground uppercase leading-snug pe-4">Room Revenue</p>
        <div class="mt-4 flex items-baseline gap-1">
          <span class="text-xs font-semibold text-muted-foreground">MYR</span>
          <h2 class="text-3xl font-medium tracking-tight text-foreground tabular-nums"><%= number_with_precision(@report.totals[:room_revenue], precision: 2) %></h2>
        </div>
      </div>

      <div class="p-6 lg:p-8 flex flex-col justify-between min-h-[160px] bg-primary transition-colors hover:bg-primary-hover">
        <p class="text-[11px] font-semibold tracking-wide text-muted-foreground uppercase leading-snug pe-4">Total Revenue</p>
        <div class="mt-4 flex items-baseline gap-1">
          <span class="text-xs font-semibold text-muted-foreground">MYR</span>
          <h2 class="text-3xl font-medium tracking-tight text-primary-foreground tabular-nums"><%= number_with_precision(@report.totals[:total_revenue], precision: 2) %></h2>
        </div>
      </div>

    </div>
  </div>

  <div class="overflow-hidden rounded-2xl border border-border bg-card shadow-sm">
    <div class="overflow-x-auto">
      <table class="min-w-full">
        <thead class="bg-muted">
          <tr>
            <th class="px-6 py-4 text-left text-[11px] font-semibold uppercase tracking-[0.1em] text-muted-foreground"><%= @date_preset == "this_year" ? "Month" : "Date" %></th>
            <th class="px-6 py-4 text-left text-[11px] font-semibold uppercase tracking-[0.1em] text-muted-foreground">Sold</th>
            <th class="px-6 py-4 text-left text-[11px] font-semibold uppercase tracking-[0.1em] text-muted-foreground">Avail</th>
            <th class="px-6 py-4 text-left text-[11px] font-semibold uppercase tracking-[0.1em] text-muted-foreground">Occupancy %</th>
            <th class="px-6 py-4 text-left text-[11px] font-semibold uppercase tracking-[0.1em] text-muted-foreground">Average Daily Rate (ADR)</th>
            <th class="px-6 py-4 text-left text-[11px] font-semibold uppercase tracking-[0.1em] text-muted-foreground">Revenue per Available Room (RevPAR)</th>
            <th class="px-6 py-4 text-left text-[11px] font-semibold uppercase tracking-[0.1em] text-muted-foreground">Room Revenue</th>
            <th class="px-6 py-4 text-left text-[11px] font-semibold uppercase tracking-[0.1em] text-muted-foreground">Tax</th>
            <th class="px-6 py-4 text-left text-[11px] font-semibold uppercase tracking-[0.1em] text-muted-foreground">Total Revenue</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-border bg-card">
          <% if @report.rows.any? %>
            <% @report.rows.each do |row| %>
              <tr>
                <td class="px-6 py-4 text-sm font-semibold text-foreground"><%= @date_preset == "this_year" ? row[:date].strftime("%B %Y") : row[:date].strftime("%d %b %Y") %></td>
                <td class="px-6 py-4 text-sm text-foreground"><%= row[:rooms_sold] %></td>
                <td class="px-6 py-4 text-sm text-foreground"><%= row[:rooms_available] %></td>
                <td class="px-6 py-4 text-sm text-foreground"><%= number_to_percentage(row[:occupancy_rate] * 100, precision: 2) %></td>
                <td class="px-6 py-4 text-sm text-foreground">MYR <%= number_with_precision(row[:adr], precision: 2) %></td>
                <td class="px-6 py-4 text-sm text-foreground">MYR <%= number_with_precision(row[:revpar], precision: 2) %></td>
                <td class="px-6 py-4 text-sm text-foreground">MYR <%= number_with_precision(row[:room_revenue], precision: 2) %></td>
                <td class="px-6 py-4 text-sm text-foreground">MYR <%= number_with_precision(row[:tax_amount], precision: 2) %></td>
                <td class="px-6 py-4 text-sm text-foreground font-semibold">MYR <%= number_with_precision(row[:total_revenue], precision: 2) %></td>
              </tr>
            <% end %>
          <% else %>
            <tr><td colspan="9" class="px-6 py-20 text-center text-sm font-medium text-muted-foreground">No report data for this selected period.</td></tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
</div>
