<div class="w-full space-y-4" data-slot="report-page" data-report="refund">
  <%= render PanelsUI::PageHeader.new(title: "Monthly refund report", description: "Review completed refunds, payment sources, and related booking details for the selected period.") do |header| %>
    <% header.with_caption do %>
      <p class="text-sm font-medium text-muted-foreground">
        <%= current_hotel.name %> ·
        <% if @report.start_date == @report.end_date %>
          <%= @report.start_date.strftime("%A, %d %b %Y") %>
        <% else %>
          <%= @report.start_date.strftime("%d %b %Y") %> - <%= @report.end_date.strftime("%d %b %Y") %>
        <% end %>
      </p>
    <% end %>
    <% header.with_actions do %>
      <%= render "preset_report_actions",
        form_url: refund_report_hotel_reports_path(current_hotel), form_id: "refund-report-range-form",
        date_preset: @date_preset, start_date: @report.start_date, end_date: @report.end_date,
        show_export: feature_enabled_for_hotel?("excel_pdf_export"), export_menu_id: "refund-report-export",
        export_items: [
          ["Export PDF", refund_report_hotel_reports_path(current_hotel, start_date: @report.start_date, end_date: @report.end_date, date_preset: @date_preset, format: :pdf)],
          ["Export Excel", refund_report_hotel_reports_path(current_hotel, start_date: @report.start_date, end_date: @report.end_date, date_preset: @date_preset, format: :xlsx)],
          ["Export CSV", refund_report_hotel_reports_path(current_hotel, start_date: @report.start_date, end_date: @report.end_date, date_preset: @date_preset, format: :csv)]
        ] %>
    <% end %>
  <% end %>

  <%= render HotelPortal::Reports::MetricStrip.new(metrics: [
    { label: "Refund count", value: format_number(@report.totals[:refund_count]), detail: "Selected period" },
    { label: "Total refund", value: "- MYR #{format_number(@report.totals[:total_amount], precision: 2)}", detail: "Amount out", detail_variant: :destructive }
  ]) %>

  <section class="space-y-3" aria-labelledby="refund-records-heading">
    <h2 id="refund-records-heading" class="text-base font-semibold text-foreground">Refund records</h2>

    <%= render PanelsUI::Table.new(
          caption: "Refund records",
          density: :compact,
          header_style: :sentence,
          hoverable: true,
          wrapper_class: "rounded-lg border border-border bg-card"
        ) do |table| %>
      <% table.with_header do %>
        <tr>
          <th scope="col">Date</th>
          <th scope="col">Room</th>
          <th scope="col">Guest</th>
          <th scope="col">Booking</th>
          <th scope="col">Refund method</th>
          <th scope="col">Reference</th>
          <th scope="col">Status</th>
          <th scope="col">Reason</th>
          <th scope="col" class="text-right">Refund</th>
        </tr>
      <% end %>
      <% table.with_body do %>
        <% if @report.rows.any? %>
          <% report_rows_grouped_by_month(@report.rows, date_preset: @date_preset) { |row| row[:date] }.each do |month, rows| %>
            <% if month %>
              <tr class="bg-muted/55" data-slot="report-month-group">
                <th scope="rowgroup" colspan="9" class="text-xs font-semibold text-muted-foreground"><%= month.strftime("%B %Y") %></th>
              </tr>
            <% end %>
          <% rows.each do |row| %>
            <tr class="align-top">
              <th scope="row" class="whitespace-nowrap font-semibold text-foreground"><%= row[:date].strftime("%d %b %Y") %></th>
              <td><%= row[:room] %></td>
              <td class="whitespace-nowrap"><%= row[:guest_name] %></td>
              <td class="whitespace-nowrap font-medium"><%= row[:booking_reference] %></td>
              <td class="whitespace-nowrap"><%= row[:refund_method] %></td>
              <td class="whitespace-nowrap"><%= row[:reference] %></td>
              <td class="whitespace-nowrap"><%= row[:status] %></td>
              <td><%= row[:reason] %></td>
              <td class="whitespace-nowrap text-right font-semibold tabular-nums text-destructive">- MYR <%= format_number(row[:refund_amount], precision: 2) %></td>
            </tr>
          <% end %>
          <% end %>
        <% else %>
          <%= render "table_empty_state", colspan: 9, message: "No refund data for this selected period." %>
        <% end %>
      <% end %>
    <% end %>
  </section>
</div>
