<div class="max-w-[1600px] mx-auto pb-20 space-y-8">
  <div class="px-4 md:px-0">
    <div class="mt-5 flex flex-col gap-4 md:flex-row md:items-end md:justify-between">
      <div>
        <h1 class="text-2xl font-bold tracking-tight text-slate-950 sm:text-3xl">Monthly Refund Report</h1>
        <p class="mt-1 text-sm font-medium text-slate-600">
          <%= current_hotel.name %> ·
          <% if @report.start_date == @report.end_date %>
            <%= @report.start_date.strftime("%A, %d %b %Y") %>
          <% else %>
            <%= @report.start_date.strftime("%d %b %Y") %> - <%= @report.end_date.strftime("%d %b %Y") %>
          <% end %>
        </p>
      </div>

      <%= form_with url: refund_report_hotel_reports_path(current_hotel), method: :get, local: true, class: "flex flex-col gap-3 md:flex-row md:items-end", id: "refund-report-range-form", data: { controller: "date-preset" } do |f| %>
        <div>
          <label class="mb-2 block text-[11px] font-bold uppercase tracking-wider text-slate-500">Time Period</label>
          <%= select_tag :date_preset, options_for_select(date_preset_options, params[:date_preset] || "this_month"), class: "rounded-xl border border-slate-200 bg-white px-4 py-2.5 text-sm font-bold text-slate-700 shadow-sm transition focus:border-slate-300 focus:outline-none", data: { action: "change->date-preset#toggleCustom" } %>
        </div>
        <div id="custom-date-range" class="<%= params[:date_preset] == 'custom' ? 'flex' : 'hidden' %> gap-3">
          <div>
            <label class="mb-2 block text-[11px] font-bold uppercase tracking-wider text-slate-500">Start Date</label>
            <%= f.date_field :start_date, value: @report.start_date, class: "rounded-xl border border-slate-200 bg-white px-4 py-2.5 text-sm font-bold text-slate-700" %>
          </div>
          <div>
            <label class="mb-2 block text-[11px] font-bold uppercase tracking-wider text-slate-500">End Date</label>
            <%= f.date_field :end_date, value: @report.end_date, class: "rounded-xl border border-slate-200 bg-white px-4 py-2.5 text-sm font-bold text-slate-700" %>
          </div>
        </div>
        <% if feature_enabled_for_hotel?("excel_pdf_export") %>
        <details class="relative min-w-[170px]">
          <summary class="list-none inline-flex w-full cursor-pointer items-center justify-center rounded-xl border border-slate-200 bg-white px-4 py-2.5 text-sm font-bold text-slate-700 shadow-sm transition hover:border-slate-900 hover:bg-slate-50">
            <svg class="size-4 me-2" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
            Export
          </summary>
          <div class="absolute right-0 z-20 mt-2 w-44 overflow-hidden rounded-xl border border-slate-200 bg-white shadow-xl">
            <%= link_to "Export PDF", refund_report_hotel_reports_path(current_hotel, start_date: @report.start_date, end_date: @report.end_date, format: :pdf), class: "block px-4 py-2.5 text-sm font-semibold text-slate-700 transition hover:bg-slate-50" %>
            <%= link_to "Export Excel", refund_report_hotel_reports_path(current_hotel, start_date: @report.start_date, end_date: @report.end_date, format: :xls), class: "block border-t border-slate-100 px-4 py-2.5 text-sm font-semibold text-slate-700 transition hover:bg-slate-50" %>
            <%= link_to "Export CSV", refund_report_hotel_reports_path(current_hotel, start_date: @report.start_date, end_date: @report.end_date, format: :csv), class: "block border-t border-slate-100 px-4 py-2.5 text-sm font-semibold text-slate-700 transition hover:bg-slate-50" %>
          </div>
        </details>
        <% end %>
      <% end %>
    </div>
  </div>

  <div class="grid grid-cols-1 overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm md:grid-cols-2">
    <div class="p-6 md:border-r md:border-slate-200">
      <p class="mb-2 text-[11px] font-semibold uppercase tracking-wider text-slate-500">Refund Count</p>
      <h2 class="text-2xl font-bold tabular-nums tracking-tight text-slate-950"><%= @report.totals[:refund_count] %></h2>
    </div>
    <div class="bg-slate-50/30 p-6">
      <p class="mb-2 text-[11px] font-semibold uppercase tracking-wider text-slate-500">Total Refund</p>
      <h2 class="text-2xl font-bold tabular-nums tracking-tight text-red-600">MYR <%= number_with_precision(@report.totals[:total_amount], precision: 2) %></h2>
    </div>
  </div>

  <div class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">
    <div class="border-b border-slate-100 px-6 py-5">
      <h2 class="text-lg font-bold tracking-tight text-slate-950">Refund Records</h2>
    </div>
    <div class="overflow-x-auto">
      <table class="min-w-full">
        <thead class="bg-slate-100">
          <tr>
            <th class="px-4 py-3 text-left text-[10px] font-semibold uppercase tracking-[0.1em] text-slate-600"><%= params[:date_preset] == "this_year" ? "Month" : "Date" %></th>
            <th class="px-4 py-3 text-left text-[10px] font-semibold uppercase tracking-[0.1em] text-slate-600">Room</th>
            <th class="px-4 py-3 text-left text-[10px] font-semibold uppercase tracking-[0.1em] text-slate-600">Guest</th>
            <th class="px-4 py-3 text-left text-[10px] font-semibold uppercase tracking-[0.1em] text-slate-600">Booking</th>
            <th class="px-4 py-3 text-left text-[10px] font-semibold uppercase tracking-[0.1em] text-slate-600">Refund Method</th>
            <th class="px-4 py-3 text-left text-[10px] font-semibold uppercase tracking-[0.1em] text-slate-600">Reference</th>
            <th class="px-4 py-3 text-left text-[10px] font-semibold uppercase tracking-[0.1em] text-slate-600">Status</th>
            <th class="px-4 py-3 text-left text-[10px] font-semibold uppercase tracking-[0.1em] text-slate-600">Reason</th>
            <th class="px-4 py-3 text-right text-[10px] font-semibold uppercase tracking-[0.1em] text-slate-600">Refund</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-200 bg-white">
          <% if @report.rows.any? %>
            <% @report.rows.each do |row| %>
              <tr class="hover:bg-slate-50/50">
                <td class="px-4 py-3 whitespace-nowrap text-sm font-semibold text-slate-900"><%= params[:date_preset] == "this_year" ? row[:month_label] : row[:date].strftime("%d %b %Y") %></td>
                <td class="px-4 py-3 text-sm text-slate-700"><%= row[:room] %></td>
                <td class="px-4 py-3 whitespace-nowrap text-sm text-slate-700"><%= row[:guest_name] %></td>
                <td class="px-4 py-3 whitespace-nowrap text-sm font-medium text-slate-900"><%= row[:booking_reference] %></td>
                <td class="px-4 py-3 whitespace-nowrap text-sm text-slate-700"><%= row[:refund_method] %></td>
                <td class="px-4 py-3 whitespace-nowrap text-sm text-slate-700"><%= row[:reference] %></td>
                <td class="px-4 py-3 whitespace-nowrap text-sm text-slate-700"><%= row[:status] %></td>
                <td class="px-4 py-3 text-sm text-slate-700"><%= row[:reason] %></td>
                <td class="px-4 py-3 whitespace-nowrap text-right text-sm font-semibold text-red-600">MYR <%= number_with_precision(row[:refund_amount], precision: 2) %></td>
              </tr>
            <% end %>
          <% else %>
            <tr><td colspan="9" class="px-6 py-20 text-center text-sm font-medium text-slate-500">No refund data for this selected period.</td></tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
</div>
