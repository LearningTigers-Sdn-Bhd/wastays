<div class="w-full space-y-4" data-slot="report-page" data-report="channel-settlements">
  <%= render PanelsUI::PageHeader.new(title: "OTA settlement report", description: "Reconcile expected OTA remittances with received settlement amounts by provider and currency.") do |header| %>
    <% header.with_caption do %>
      <p class="text-sm font-medium text-muted-foreground">
        <%= current_hotel.name %> ·
        <% if @report.start_date == @report.end_date %>
          <%= @report.start_date.strftime("%A, %d %b %Y") %>
        <% else %>
          <%= @report.start_date.strftime("%d %b %Y") %> - <%= @report.end_date.strftime("%d %b %Y") %>
        <% end %>
      </p>
    <% end %>
    <% header.with_actions do %>
      <% if current_user.has_permission?("manage_ar_payments", hotel: current_hotel) %>
        <%= render PanelsUI::Button.new(
              label: "Record receipt",
              as: :a,
              href: new_hotel_channel_settlement_receipt_path(current_hotel),
              variant: :primary) %>
      <% end %>
      <%= render "preset_report_actions",
        form_url: channel_settlements_hotel_reports_path(current_hotel), form_id: "channel-settlements-range-form",
        date_preset: @date_preset, start_date: @report.start_date, end_date: @report.end_date,
        show_export: feature_enabled_for_hotel?("excel_pdf_export"), export_menu_id: "channel-settlements-export",
        export_items: [
          ["Export Excel", channel_settlements_hotel_reports_path(current_hotel, start_date: @report.start_date, end_date: @report.end_date, date_preset: @date_preset, format: :xlsx)],
          ["Export CSV", channel_settlements_hotel_reports_path(current_hotel, start_date: @report.start_date, end_date: @report.end_date, date_preset: @date_preset, format: :csv)]
        ] %>
    <% end %>
  <% end %>

  <% if @report.attention_rows.any? %>
    <%= render PanelsUI::Alert.new(tone: :warning, title: "Settlement review needed", role: :status) do %>
      <ul class="space-y-2 text-sm">
        <% @report.attention_rows.each do |row| %>
          <li>
            <span class="font-medium"><%= row[:booking_source] %> · <%= row[:reference] %></span>
            <span class="text-muted-foreground">— <%= row[:message] %></span>
          </li>
        <% end %>
      </ul>
    <% end %>
  <% end %>

  <% if @report.currency_totals.any? %>
    <% @report.currency_totals.each do |total| %>
      <% currency = total.fetch(:currency) %>
      <section class="space-y-3" aria-labelledby="channel-settlements-<%= currency.parameterize %>-heading">
        <h2 id="channel-settlements-<%= currency.parameterize %>-heading" class="text-base font-semibold text-foreground"><%= currency %> reconciliation</h2>

        <%= render HotelPortal::Reports::MetricStrip.new(metrics: [
          { label: "Expected net", value: "#{currency} #{format_number(total[:expected_net_amount], precision: 2)}", detail: "OTA remittance due" },
          { label: "Received", value: "#{currency} #{format_number(total[:received_amount], precision: 2)}", detail: "Receipts allocated" },
          { label: "Outstanding", value: "#{currency} #{format_number(total[:outstanding_amount], precision: 2)}", detail: "Still to be received", detail_variant: total[:outstanding_amount].positive? ? :destructive : :default },
          { label: "Variance", value: "#{currency} #{format_number(total[:variance_amount], precision: 2)}", detail: "Received less expected", detail_variant: total[:variance_amount].negative? ? :destructive : :default }
        ], aria_label: "#{currency} settlement summary") %>

        <%= render PanelsUI::Table.new(
              caption: "#{currency} OTA settlement reconciliation",
              density: :compact,
              header_style: :sentence,
              hoverable: true,
              wrapper_class: "rounded-lg border border-border bg-card"
            ) do |table| %>
          <% table.with_header do %>
            <tr>
              <th scope="col">Provider</th>
              <th scope="col" class="text-right">Expected net</th>
              <th scope="col" class="text-right">Received</th>
              <th scope="col" class="text-right">Outstanding</th>
              <th scope="col" class="text-right">Variance</th>
            </tr>
          <% end %>
          <% table.with_body do %>
            <% @report.rows.select { |row| row[:currency] == currency }.each do |row| %>
              <tr>
                <th scope="row" class="font-semibold text-foreground"><%= row[:provider].to_s.titleize %></th>
                <td class="whitespace-nowrap text-right tabular-nums"><%= currency %> <%= format_number(row[:expected_net_amount], precision: 2) %></td>
                <td class="whitespace-nowrap text-right tabular-nums"><%= currency %> <%= format_number(row[:received_amount], precision: 2) %></td>
                <td class="whitespace-nowrap text-right tabular-nums"><%= currency %> <%= format_number(row[:outstanding_amount], precision: 2) %></td>
                <td class="whitespace-nowrap text-right tabular-nums"><%= currency %> <%= format_number(row[:variance_amount], precision: 2) %></td>
              </tr>
            <% end %>
          <% end %>
          <% table.with_footer do %>
            <tr>
              <th scope="row">Total</th>
              <td class="whitespace-nowrap text-right tabular-nums"><%= currency %> <%= format_number(total[:expected_net_amount], precision: 2) %></td>
              <td class="whitespace-nowrap text-right tabular-nums"><%= currency %> <%= format_number(total[:received_amount], precision: 2) %></td>
              <td class="whitespace-nowrap text-right tabular-nums"><%= currency %> <%= format_number(total[:outstanding_amount], precision: 2) %></td>
              <td class="whitespace-nowrap text-right tabular-nums"><%= currency %> <%= format_number(total[:variance_amount], precision: 2) %></td>
            </tr>
          <% end %>
        <% end %>
      </section>
    <% end %>
  <% else %>
    <section class="space-y-3" aria-labelledby="channel-settlements-heading">
      <h2 id="channel-settlements-heading" class="text-base font-semibold text-foreground">Provider reconciliation</h2>
      <%= render PanelsUI::Table.new(
            caption: "OTA settlement reconciliation",
            density: :compact,
            header_style: :sentence,
            wrapper_class: "rounded-lg border border-border bg-card"
          ) do |table| %>
        <% table.with_header do %>
          <tr>
            <th scope="col">Provider</th>
            <th scope="col">Currency</th>
            <th scope="col" class="text-right">Expected net</th>
            <th scope="col" class="text-right">Received</th>
            <th scope="col" class="text-right">Outstanding</th>
            <th scope="col" class="text-right">Variance</th>
          </tr>
        <% end %>
        <% table.with_body do %>
          <%= render "table_empty_state", colspan: 6, message: "No OTA settlements for this selected period." %>
        <% end %>
      <% end %>
    </section>
  <% end %>
</div>
