<% cashier_state = {
     tab: "cashier", start_date: @revenue_report.start_date, end_date: @revenue_report.end_date,
     date_preset: @date_preset, cashier_start_time: params[:cashier_start_time], cashier_end_time: params[:cashier_end_time],
     cashier_group_by: @cashier_group_by, cashier_handling: params[:cashier_handling],
     cashier_payment_modes: params[:cashier_payment_modes], cashier_stages: params[:cashier_stages],
     cashier_received_by: params[:cashier_received_by], cashier_currencies: params[:cashier_currencies]
   }.compact_blank %>

<div class="flex flex-wrap items-center justify-between gap-3">
  <div class="flex items-center gap-2">
    <span class="text-sm font-medium text-foreground">Show</span>
    <%= render PanelsUI::ToggleGroup.new(
          id: "cashier-report-view", type: :single, value: @cashier_view,
          variant: :outline, size: :sm, spacing: 0, required: true,
          aria_label: "Cashier activity view") do |group| %>
      <% [["full", "Full report", "file-text"], ["activity", "Activity", "list"], ["summary", "Summary", "chart-bar"]].each do |value, label, icon| %>
        <% group.with_item(value:, data: {
             action: "click->cashier-report-table#openView",
             href: daily_report_hotel_reports_path(current_hotel, cashier_state.merge(cashier_view: value))
           }) do %>
          <%= app_icon icon, class: "size-3.5", aria: { hidden: true } %>
          <span><%= label %></span>
        <% end %>
      <% end %>
    <% end %>
  </div>

  <div class="flex flex-wrap items-center gap-2">
    <% if %w[full activity].include?(@cashier_view) %>
      <%= render PanelsUI::DropdownMenu.new(id: "cashier-columns-menu", placement: :bottom_end, class: "w-56") do |menu| %>
        <% menu.with_trigger(variant: :neutral, size: :md) do %>
          <%= cached_icon "columns-3", class: "size-4", aria: { hidden: true } %>
          Columns
          <%= app_icon "chevron-down", class: "size-3.5", aria: { hidden: true } %>
        <% end %>
        <% menu.with_group(label: "Visible columns") do |group| %>
          <% HotelPortal::Reports::CashierActivityColumns::ALL.each do |column| %>
            <% group.with_checkbox(
                 name: "visible_columns[]", value: column.key,
                 checked: @cashier_visible_columns.include?(column.key),
                 disabled: @cashier_visible_columns.one? && @cashier_visible_columns.include?(column.key)
               ) { column.label } %>
          <% end %>
        <% end %>
        <% menu.with_separator %>
        <% menu.with_item(data: { action: "click->cashier-report-table#resetColumns" }) { "Restore defaults" } %>
      <% end %>
    <% end %>

    <% if local_assigns[:export_enabled] %>
      <%= render "hotel_portal/reports/export_dropdown",
            menu_id: "daily-revenue-export",
            items: local_assigns.fetch(:export_items),
            label: local_assigns.fetch(:export_label),
            disabled: local_assigns.fetch(:export_disabled) %>
    <% end %>
  </div>
</div>

<p class="sr-only" role="status" aria-live="polite" aria-atomic="true" data-cashier-preference-status></p>

<% if @cashier_view == "full" %>
  <section class="space-y-5" aria-label="Cashier activity totals">
    <%= render "cashier_activity_metrics" %>
  </section>
<% end %>

<% if %w[full activity].include?(@cashier_view) %>
  <section class="space-y-3" aria-labelledby="cashier-activity-heading" data-cashier-section>
    <div class="flex flex-wrap items-center justify-between gap-3">
      <div>
        <h2 id="cashier-activity-heading" class="text-base font-semibold text-foreground">Payment activity</h2>
        <p class="text-sm text-muted-foreground" aria-live="polite" aria-atomic="true">
          <span data-cashier-filtered-summary><%= pluralize(@cashier_report.all_totals[:movement_count], "movement") %> matching the current filters</span>
          <span hidden data-cashier-selection-summary><span data-cashier-selection-count>0</span> transactions selected for export</span>
        </p>
      </div>
      <div class="flex items-center gap-2">
        <span class="text-sm font-medium text-foreground">Group by</span>
        <%= render PanelsUI::ToggleGroup.new(
              id: "cashier-activity-grouping", type: :single, value: @cashier_group_by,
              variant: :outline, size: :sm, spacing: 0, required: true,
              name: "cashier_group_by", aria_label: "Payment activity grouping") do |group| %>
          <% [["handling", "Handling", "group"], ["payment_mode", "Payment mode", "credit-card"], ["stage", "Stage", "list-checks"], ["received_by", "Received by", "user"]].each do |value, label, icon| %>
            <% group.with_item(value:) do %>
              <%= app_icon icon, class: "size-3.5", aria: { hidden: true } %>
              <span><%= label %></span>
            <% end %>
          <% end %>
        <% end %>
      </div>
    </div>

    <%= render PanelsUI::ScrollArea.new(
          orientation: :both,
          max_height: @cashier_view == "full" ? "max-h-[60dvh]" : "max-h-[79dvh]",
          class: "overflow-hidden rounded-lg border border-border bg-card",
          data: { testid: "cashier-table-scroll-area" }) do %>
      <%= render PanelsUI::Table.new(
            caption: "Payment movements grouped by #{@cashier_group_by.humanize.downcase}",
            density: :compact, header_style: :sentence, hoverable: true, sticky_header: true,
            wrapper_class: "overflow-visible",
            data: { testid: "cashier-rows" }) do |table| %>
      <% table.with_header do %>
        <tr>
          <th scope="col" class="w-10 text-center">
            <%= render PanelsUI::Checkbox.new(
                  name: "select_page_cashier_transactions", id: "select-page-cashier-transactions",
                  label: "Select all transactions on this page", label_hidden: true, include_hidden: false,
                  data: { cashier_select_page: true }) %>
          </th>
          <% HotelPortal::Reports::CashierActivityColumns.selected(@cashier_visible_columns).each do |column| %>
            <% filter_config = {
                 "handling" => ["Handling", "cashier_handling", @cashier_report.filter_options[:handling]],
                 "payment_mode" => ["Payment mode", "cashier_payment_modes", @cashier_report.filter_options[:payment_modes]],
                 "stage" => ["Stage", "cashier_stages", @cashier_report.filter_options[:stages]],
                 "received_by" => ["Received by", "cashier_received_by", @cashier_report.filter_options[:received_by]],
                 "currency" => ["Currency", "cashier_currencies", @cashier_report.filter_options[:currencies]]
               }[column.key] %>
            <th scope="col" class="<%= column.key == 'amount' ? 'text-right' : 'text-left' %>" data-column-key="<%= column.key %>">
              <% if filter_config %>
                <%= render "cashier_activity_filter", title: filter_config[0], param_name: filter_config[1], options: filter_config[2] %>
              <% else %>
                <%= column.label %>
              <% end %>
            </th>
          <% end %>
        </tr>
      <% end %>
      <% table.with_body do %>
        <% if @cashier_rows.empty? %>
          <%= render "table_empty_state", colspan: @cashier_visible_columns.size + 1, message: "No payment movements match the current filters." %>
        <% else %>
          <% current_group = nil %>
          <% current_month = nil %>
          <% @cashier_rows.each do |row| %>
            <% group_key = @cashier_activity_table.group_key(row.transaction) %>
            <% if group_key != current_group %>
              <% current_group = group_key %>
              <% current_month = nil %>
              <% group = @cashier_group_totals.fetch(group_key) %>
              <tr data-table-group-row data-cashier-group-row data-cashier-group="<%= group_key %>" data-cashier-group-count="<%= group.count %>">
                <td class="w-10 text-center">
                  <%= render PanelsUI::Checkbox.new(
                        name: "select_cashier_group_#{group_key}", id: "select-cashier-group-#{group_key.parameterize}",
                        label: "Select all #{pluralize(group.count, 'transaction')} in #{group.label}",
                        label_hidden: true, include_hidden: false,
                        data: { cashier_group_selection: group_key }) %>
                </td>
                <th scope="rowgroup" colspan="<%= @cashier_visible_columns.size %>" class="text-start text-xs font-semibold uppercase tracking-wide text-muted-foreground">
                  <span><%= group.label %></span>
                  <span class="ms-2 font-normal normal-case tracking-normal"><%= pluralize(group.count, "movement") %></span>
                  <span class="float-end"><%= format_number(group.balance, precision: 2) %></span>
                </th>
              </tr>
            <% end %>
            <% row_month = @date_preset == "this_year" ? row.posting_date.beginning_of_month : nil %>
            <% if row_month && row_month != current_month %>
              <% current_month = row_month %>
              <tr data-slot="report-month-group">
                <th scope="rowgroup" colspan="<%= @cashier_visible_columns.size + 1 %>" class="text-xs font-semibold text-muted-foreground">
                  <%= row_month.strftime("%B %Y") %>
                </th>
              </tr>
            <% end %>
            <tr data-testid="cashier-row" data-cashier-transaction-row data-cashier-group="<%= group_key %>">
              <td class="text-center">
                <%= render PanelsUI::Checkbox.new(
                      name: "selected_transaction_ids[]", id: "select-cashier-transaction-#{row.transaction.id}",
                      value: row.transaction.id, label: "Select transaction #{row.transaction.id}",
                      label_hidden: true, include_hidden: false,
                      data: { cashier_transaction_selection: true }) %>
              </td>
              <% @cashier_visible_columns.each do |key| %>
                <% case key %>
                <% when "date_time" %>
                  <td class="whitespace-nowrap text-muted-foreground"><%= row.posting_date.strftime("%d %b %Y") %><% if row.posted_at %><span class="block text-xs"><%= row.posted_at.strftime("%H:%M") %></span><% end %></td>
                <% when "date" %><td class="whitespace-nowrap text-muted-foreground"><%= row.posting_date.strftime("%d %b %Y") %></td>
                <% when "time" %><td class="whitespace-nowrap text-muted-foreground"><%= row.posted_at&.strftime("%H:%M") %></td>
                <% when "reservation" %><td class="whitespace-nowrap"><%= row.booking_number %><span class="block text-xs text-muted-foreground">Confirmation <%= row.confirmation_code %></span></td>
                <% when "guest_details" %><td><%= row.guest_name %><span class="block text-xs text-muted-foreground">Room <%= row.room_number %></span></td>
                <% when "folio" %><td><%= row.folio_number %></td>
                <% when "invoice" %><td><%= row.invoice_number %></td>
                <% when "handling" %><td><%= row.handling %></td>
                <% when "payment_mode" %><td><%= row.settlement_mode %></td>
                <% when "stage" %><td><%= row.section %></td>
                <% when "received_by" %><td><%= row.received_by %></td>
                <% when "remarks" %><td><%= row.description %></td>
                <% when "currency" %><td><%= row.currency %></td>
                <% when "amount" %><td class="whitespace-nowrap text-right font-semibold"><%= format_number(row.signed_amount, precision: 2) %></td>
                <% end %>
              <% end %>
            </tr>
          <% end %>
        <% end %>
      <% end %>
      <% end %>
    <% end %>
    <% if @cashier_transactions.total_pages > 1 %>
      <nav class="flex justify-center px-3 py-2" aria-label="Payment activity pagination" data-slot="report-pagination">
        <%= paginate @cashier_transactions, param_name: "cashier_page" %>
      </nav>
    <% end %>
  </section>
<% end %>

<% if %w[full summary].include?(@cashier_view) %>
  <section class="space-y-5" aria-labelledby="cashier-summary-heading">
    <h2 id="cashier-summary-heading" class="text-base font-semibold text-foreground">Summary</h2>
    <% if @cashier_view == "summary" %>
      <%= render "cashier_activity_metrics" %>
    <% end %>
    <%= render "cashier_activity_summaries" %>
  </section>
<% end %>
