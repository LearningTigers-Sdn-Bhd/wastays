<div class="w-full space-y-8 print:max-w-none print:pb-0 print:space-y-4">
  <% guest_report_tabs = [["Arrivals", "arrivals"], ["In-House", "in_house"], ["Departures", "departures"], ["Checkout", "checkout"], ["Registration Cards", "registration_cards"]] %>
  <div class=" print:px-0">
 <div class="flex flex-col gap-4 md:flex-row md:items-end md:justify-between print:mt-0 print:block">
      <div>
        <h1 class="text-2xl font-bold tracking-tight text-foreground sm:text-3xl print:text-xl">Guest Reports</h1>
        <p class="mt-1 text-sm font-medium text-muted-foreground print:text-xs">
          <%= current_hotel.name %> ·
          <% if @report.start_date == @report.end_date %>
            <%= @report.start_date.strftime("%A, %d %b %Y") %>
          <% else %>
            <%= @report.start_date.strftime("%d %b %Y") %> - <%= @report.end_date.strftime("%d %b %Y") %>
          <% end %>
        </p>
      </div>

      <div class="print:hidden">
        <%= form_with url: guest_reports_hotel_reports_path(current_hotel), method: :get, local: true, class: "flex flex-col gap-3 md:flex-row md:items-end", id: "arrivals-date-range-form", data: { controller: "date-preset" } do |f| %>
          <%= hidden_field_tag :tab, @active_guest_report_tab %>
          <div>
            <label class="block text-[11px] font-bold uppercase tracking-wider text-muted-foreground mb-2">Time Period</label>
            <%= select_tag :date_preset, options_for_select(date_preset_options, @date_preset), class: "rounded-xl border border-border bg-card px-4 py-2.5 text-sm font-bold text-foreground shadow-sm transition focus:border-border-interactive focus:outline-none focus:ring-0", data: { action: "change->date-preset#toggleCustom" } %>
          </div>

          <div id="custom-date-range" class="<%= @date_preset == 'custom' ? 'flex' : 'hidden' %> gap-3">
            <div>
              <label class="block text-[11px] font-bold uppercase tracking-wider text-muted-foreground mb-2">Start Date</label>
              <%= f.date_field :start_date, value: @report.start_date, class: "rounded-xl border border-border bg-card px-4 py-2.5 text-sm font-bold text-foreground focus:border-border-interactive focus:outline-none focus:ring-0 shadow-sm", id: "arrivals-start-date" %>
            </div>

            <div>
              <label class="block text-[11px] font-bold uppercase tracking-wider text-muted-foreground mb-2">End Date</label>
              <%= f.date_field :end_date, value: @report.end_date, class: "rounded-xl border border-border bg-card px-4 py-2.5 text-sm font-bold text-foreground focus:border-border-interactive focus:outline-none focus:ring-0 shadow-sm", id: "arrivals-end-date" %>
            </div>
          </div>

          <% if feature_enabled_for_hotel?("excel_pdf_export") && @active_guest_report_tab != "registration_cards" %>
          <details class="relative min-w-[160px]">
            <summary class="list-none inline-flex w-full cursor-pointer items-center justify-center rounded-xl border border-border bg-card px-4 py-2.5 text-sm font-bold text-foreground shadow-sm transition hover:border-border-interactive hover:bg-muted">
              <svg class="size-4 me-2" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
              Export
            </summary>
            <div class="absolute right-0 z-20 mt-2 w-44 overflow-hidden rounded-xl border border-border bg-card shadow-xl">
              <%= link_to "Export PDF",
                guest_reports_hotel_reports_path(
                  current_hotel,
                  start_date: @report.start_date,
                  end_date: @report.end_date,
                  date_preset: @date_preset,
                  tab: @active_guest_report_tab,
                  format: :pdf
                ),
                class: "block px-4 py-2.5 text-sm font-semibold text-foreground transition hover:bg-muted" %>
              <%= link_to "Export Excel",
                guest_reports_hotel_reports_path(
                  current_hotel,
                  start_date: @report.start_date,
                  end_date: @report.end_date,
                  date_preset: @date_preset,
                  tab: @active_guest_report_tab,
                  format: :xls
                ),
                class: "block border-t border-border px-4 py-2.5 text-sm font-semibold text-foreground transition hover:bg-muted" %>
              <%= link_to "Export CSV",
                guest_reports_hotel_reports_path(
                  current_hotel,
                  start_date: @report.start_date,
                  end_date: @report.end_date,
                  date_preset: @date_preset,
                  tab: @active_guest_report_tab,
                  format: :csv
                ),
                class: "block border-t border-border px-4 py-2.5 text-sm font-semibold text-foreground transition hover:bg-muted" %>
            </div>
          </details>
          <% end %>
        <% end %>
      </div>
    </div>
  </div>

  <div class=" print:hidden">
    <div class="flex flex-wrap items-center gap-2">
      <% guest_report_tabs.each do |label, value| %>
        <% count = {
          "arrivals" => @report.arrival_count,
          "in_house" => @report.in_house_count,
          "departures" => @report.departure_count,
          "checkout" => @report.checkout_count,
          "registration_cards" => @grc_total_count
        }[value] %>
        <% active = value == @active_guest_report_tab %>
        <%= link_to guest_reports_hotel_reports_path(
            current_hotel,
            start_date: @report.start_date,
            end_date: @report.end_date,
            date_preset: @date_preset,
            tab: value
          ),
          class: "inline-flex h-10 items-center gap-2 whitespace-nowrap rounded-xl border px-4 text-sm font-semibold transition #{active ? 'border-blue-600 bg-blue-600 text-primary-foreground shadow-sm' : 'border-border bg-card text-foreground hover:border-border-interactive hover:bg-muted'}" do %>
          <span><%= label %></span>
          <span class="rounded-full px-1.5 py-0.5 text-[10px] font-bold <%= active ? 'bg-card/20 text-primary-foreground' : 'bg-muted text-muted-foreground' %>">
            <%= count %>
          </span>
        <% end %>
      <% end %>
    </div>
  </div>

  <% unless @active_guest_report_tab == "registration_cards" %>
    <div class="grid grid-cols-1 overflow-hidden rounded-2xl border border-border bg-card shadow-sm md:grid-cols-2 xl:grid-cols-4 print:grid-cols-2 print:rounded-none print:shadow-none">
      <div class="p-6 md:border-r md:border-border print:p-3">
        <p class="mb-2 text-[11px] font-semibold uppercase tracking-wider text-muted-foreground">Arrivals</p>
        <h2 class="text-3xl font-bold tabular-nums tracking-tight text-foreground print:text-xl"><%= @report.arrival_count %></h2>
      </div>
      <div class="bg-muted/30 p-6 xl:border-r xl:border-border print:p-3 print:bg-card">
        <p class="mb-2 text-[11px] font-semibold uppercase tracking-wider text-muted-foreground">In-House</p>
        <h2 class="text-3xl font-bold tabular-nums tracking-tight text-foreground print:text-xl"><%= @report.in_house_count %></h2>
      </div>
      <div class="p-6 md:border-r md:border-border print:p-3">
        <p class="mb-2 text-[11px] font-semibold uppercase tracking-wider text-muted-foreground">Departures</p>
        <h2 class="text-3xl font-bold tabular-nums tracking-tight text-foreground print:text-xl"><%= @report.departure_count %></h2>
      </div>
      <div class="bg-muted/30 p-6 print:p-3 print:bg-card">
        <p class="mb-2 text-[11px] font-semibold uppercase tracking-wider text-muted-foreground">Checkout</p>
        <h2 class="text-3xl font-bold tabular-nums tracking-tight text-foreground print:text-xl"><%= @report.checkout_count %></h2>
      </div>
    </div>
  <% end %>

  <% if @active_guest_report_tab == "arrivals" %>
    <%= render partial: "hotel_portal/reports/arrivals_departures_section", locals: {
      title: "Expected Arrivals",
      empty_message: "No arrivals scheduled for this selected period.",
      rows: @report.arrivals,
      type: :arrival
    } %>
  <% elsif @active_guest_report_tab == "in_house" %>
    <%= render partial: "hotel_portal/reports/arrivals_departures_section", locals: {
      title: "In-House Guests",
      empty_message: "No in-house guests for this selected period.",
      rows: @report.in_house,
      type: :departure
    } %>
  <% elsif @active_guest_report_tab == "departures" %>
    <%= render partial: "hotel_portal/reports/arrivals_departures_section", locals: {
      title: "Expected Departures",
      empty_message: "No departures scheduled for this selected period.",
      rows: @report.departures,
      type: :departure
    } %>
  <% elsif @active_guest_report_tab == "checkout" %>
    <%= render partial: "hotel_portal/reports/arrivals_departures_section", locals: {
      title: "Checked-Out Guests",
      empty_message: "No checked-out guests for this selected period.",
      rows: @report.checkout,
      type: :departure
    } %>
  <% else %>
    <%= render "hotel_portal/reports/guest_registration_cards_section",
      form_url: guest_reports_hotel_reports_path(current_hotel),
      hidden_fields: {
        tab: @active_guest_report_tab,
        start_date: @report.start_date,
        end_date: @report.end_date,
        date_preset: @date_preset
      } %>
  <% end %>
</div>
