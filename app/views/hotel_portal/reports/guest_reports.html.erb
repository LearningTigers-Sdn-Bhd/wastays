<div class="w-full space-y-3.5 print:max-w-none print:pb-0 print:space-y-4">
  <% guest_report_tabs = [["Arrivals", "arrivals"], ["In-House", "in_house"], ["Departures", "departures"], ["Checkout", "checkout"], ["Registration Cards", "registration_cards"]] %>
  <div class="print:px-0">
    <%= render PanelsUI::PageHeader.new(title: "Guest Reports", class: "print:block") do |header| %>
      <% header.with_caption do %>
        <p class="text-sm font-medium text-muted-foreground print:text-xs">
          <%= current_hotel.name %> ·
          <% if @report.start_date == @report.end_date %>
            <%= @report.start_date.strftime("%A, %d %b %Y") %>
          <% else %>
            <%= @report.start_date.strftime("%d %b %Y") %> - <%= @report.end_date.strftime("%d %b %Y") %>
          <% end %>
        </p>
      <% end %>
      <% header.with_actions do %>
        <div class="print:hidden">
          <%= render "preset_report_actions",
            form_url: guest_reports_hotel_reports_path(current_hotel), form_id: "arrivals-date-range-form",
            date_preset: @date_preset, start_date: @report.start_date, end_date: @report.end_date,
            hidden_params: { tab: @active_guest_report_tab, q: params[:q], status: params[:status] }.compact,
            show_export: feature_enabled_for_hotel?("excel_pdf_export") && @active_guest_report_tab != "registration_cards",
            export_menu_id: "guest-reports-export",
            export_items: [
              ["Export PDF", guest_reports_hotel_reports_path(current_hotel, start_date: @report.start_date, end_date: @report.end_date, date_preset: @date_preset, tab: @active_guest_report_tab, q: params[:q], format: :pdf)],
              ["Export Excel", guest_reports_hotel_reports_path(current_hotel, start_date: @report.start_date, end_date: @report.end_date, date_preset: @date_preset, tab: @active_guest_report_tab, q: params[:q], format: :xls)],
              ["Export CSV", guest_reports_hotel_reports_path(current_hotel, start_date: @report.start_date, end_date: @report.end_date, date_preset: @date_preset, tab: @active_guest_report_tab, q: params[:q], format: :csv)]
            ] %>
        </div>
      <% end %>
    <% end %>
  </div>

  <div class=" print:hidden">
    <div class="flex flex-wrap items-center gap-2">
      <% guest_report_tabs.each do |label, value| %>
        <% count = {
          "arrivals" => @report.arrival_count,
          "in_house" => @report.in_house_count,
          "departures" => @report.departure_count,
          "checkout" => @report.checkout_count,
          "registration_cards" => @grc_total_count
        }[value] %>
        <% active = value == @active_guest_report_tab %>
        <%= link_to guest_reports_hotel_reports_path(
            current_hotel,
            start_date: @report.start_date,
            end_date: @report.end_date,
            date_preset: @date_preset,
            tab: value
          ),
          class: "inline-flex h-10 items-center gap-2 whitespace-nowrap rounded-xl border px-4 text-sm font-semibold transition #{active ? 'border-blue-600 bg-blue-600 text-primary-foreground shadow-sm' : 'border-border bg-card text-foreground hover:border-border-interactive hover:bg-muted'}" do %>
          <span><%= label %></span>
          <span class="rounded-full px-1.5 py-0.5 text-[10px] font-bold <%= active ? 'bg-card/20 text-primary-foreground' : 'bg-muted text-muted-foreground' %>">
            <%= count %>
          </span>
        <% end %>
      <% end %>
    </div>
  </div>

  <% unless @active_guest_report_tab == "registration_cards" %>
    <div class="grid grid-cols-1 overflow-hidden rounded-2xl border border-border bg-card shadow-sm md:grid-cols-2 xl:grid-cols-4 print:grid-cols-2 print:rounded-none print:shadow-none">
      <div class="p-6 md:border-r md:border-border print:p-3">
        <p class="mb-2 text-[11px] font-semibold uppercase tracking-wider text-muted-foreground">Arrivals</p>
        <h2 class="text-3xl font-bold tabular-nums tracking-tight text-foreground print:text-xl"><%= @report.arrival_count %></h2>
      </div>
      <div class="bg-muted/30 p-6 xl:border-r xl:border-border print:p-3 print:bg-card">
        <p class="mb-2 text-[11px] font-semibold uppercase tracking-wider text-muted-foreground">In-House</p>
        <h2 class="text-3xl font-bold tabular-nums tracking-tight text-foreground print:text-xl"><%= @report.in_house_count %></h2>
      </div>
      <div class="p-6 md:border-r md:border-border print:p-3">
        <p class="mb-2 text-[11px] font-semibold uppercase tracking-wider text-muted-foreground">Departures</p>
        <h2 class="text-3xl font-bold tabular-nums tracking-tight text-foreground print:text-xl"><%= @report.departure_count %></h2>
      </div>
      <div class="bg-muted/30 p-6 print:p-3 print:bg-card">
        <p class="mb-2 text-[11px] font-semibold uppercase tracking-wider text-muted-foreground">Checkout</p>
        <h2 class="text-3xl font-bold tabular-nums tracking-tight text-foreground print:text-xl"><%= @report.checkout_count %></h2>
      </div>
    </div>
  <% end %>

  <% if @active_guest_report_tab == "arrivals" %>
    <%= render partial: "hotel_portal/reports/arrivals_departures_section", locals: {
      title: "Expected Arrivals",
      empty_message: "No arrivals scheduled for this selected period.",
      rows: @report.arrivals,
      type: :arrival
    } %>
  <% elsif @active_guest_report_tab == "in_house" %>
    <%= render partial: "hotel_portal/reports/arrivals_departures_section", locals: {
      title: "In-House Guests",
      empty_message: "No in-house guests for this selected period.",
      rows: @report.in_house,
      type: :departure,
      show_boat_departure: current_hotel.allow_boat_information?
    } %>
  <% elsif @active_guest_report_tab == "departures" %>
    <%= render partial: "hotel_portal/reports/arrivals_departures_section", locals: {
      title: "Expected Departures",
      empty_message: "No departures scheduled for this selected period.",
      rows: @report.departures,
      type: :departure
    } %>
  <% elsif @active_guest_report_tab == "checkout" %>
    <%= render partial: "hotel_portal/reports/arrivals_departures_section", locals: {
      title: "Checked-Out Guests",
      empty_message: "No checked-out guests for this selected period.",
      rows: @report.checkout,
      type: :departure
    } %>
  <% elsif @active_guest_report_tab == "bibo" %>
    <%= render partial: "hotel_portal/reports/bibo_section", locals: {
      report: @bibo_report
    } %>
  <% else %>
    <%= render "hotel_portal/reports/guest_registration_cards_section",
      form_url: guest_reports_hotel_reports_path(current_hotel),
      hidden_fields: {
        tab: @active_guest_report_tab,
        start_date: @report.start_date,
        end_date: @report.end_date,
        date_preset: @date_preset
      } %>
  <% end %>
</div>
