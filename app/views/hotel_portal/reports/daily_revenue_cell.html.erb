<%= turbo_frame_tag "offcanvas_drawer", data: { offcanvas_variant: "right" } do %>
  <div class="flex h-full min-h-0 flex-col bg-background text-foreground">
    <header class="shrink-0 border-b border-border bg-card p-3">
      <div class="flex items-start justify-between gap-3">
        <div>
          <p class="text-xs font-medium text-muted-foreground">Daily revenue report</p>
          <h2 class="mt-1 text-base font-semibold tracking-tight"><%= @detail.category_label %></h2>
          <p class="mt-1 text-xs text-muted-foreground">
            <% if @detail.start_date == @detail.end_date %>
              <%= @detail.start_date.strftime("%A, %d %b %Y") %>
            <% else %>
              <%= @detail.start_date.strftime("%d %b") %> – <%= @detail.end_date.strftime("%d %b %Y") %>
            <% end %>
          </p>
        </div>
        <button type="button" class="flex size-8 shrink-0 items-center justify-center rounded-md text-muted-foreground transition-colors hover:bg-muted hover:text-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-border-interactive" data-action="click->offcanvas#close" aria-label="Close">
          <%= app_icon "x", class: "size-4", aria: { hidden: "true" } %>
        </button>
      </div>
    </header>

    <div class="min-h-0 flex-1 overflow-y-auto p-3">
      <%= render PanelsUI::Table.new(
            caption: "#{@detail.category_label} revenue details",
            density: :compact,
            header_style: :sentence,
            hoverable: true,
            wrapper_class: "rounded-lg border border-border bg-card"
          ) do |table| %>
        <% table.with_header do %>
          <tr>
            <th scope="col">Date</th>
            <th scope="col">Description</th>
            <th scope="col">Booking</th>
            <th scope="col">Source</th>
            <th scope="col" class="text-right">Amount</th>
          </tr>
        <% end %>
        <% table.with_body do %>
          <% if @detail.entries.any? %>
            <% @detail.entries.each do |entry| %>
              <tr>
                <td class="whitespace-nowrap text-muted-foreground"><%= entry.date.strftime("%d %b %Y") %></td>
                <th scope="row" class="font-semibold"><%= entry.description %></th>
                <td class="text-muted-foreground">
                  <% if entry.booking_reference.present? %>
                    <%= entry.booking_reference %><% if entry.folio_reference.present? && entry.folio_reference != entry.booking_reference %> · <%= entry.folio_reference %><% end %>
                  <% else %>
                    —
                  <% end %>
                </td>
                <td class="text-muted-foreground"><%= entry.source_label %></td>
                <td class="whitespace-nowrap text-right font-semibold tabular-nums"><%= entry.currency %> <%= report_amount(entry.amount) %></td>
              </tr>
            <% end %>
          <% else %>
            <%= render "table_empty_state", colspan: 5, message: "No records found for this cell." %>
          <% end %>
        <% end %>
      <% end %>
    </div>
  </div>
<% end %>
