<div class="w-full space-y-4" data-slot="report-page" data-report="journal-batches">
  <%= render PanelsUI::PageHeader.new(title: "Journal batches", description: "Summarized daily transaction batches by general ledger code (GL code).") do |header| %>
    <% header.with_caption do %>
      <p class="text-sm font-medium text-muted-foreground">
        <%= current_hotel.name %> ·
        <% if @report_start_date == @report_end_date %>
          <%= @report_start_date.strftime("%A, %d %b %Y") %>
        <% else %>
          <%= @report_start_date.strftime("%d %b %Y") %> - <%= @report_end_date.strftime("%d %b %Y") %>
        <% end %>
      </p>
    <% end %>
    <% header.with_actions do %>
      <%= form_with url: journal_batches_hotel_reports_path(current_hotel), method: :get, local: true,
            class: "flex flex-col gap-2 sm:flex-row sm:items-end", data: { controller: "date-preset" } do |f| %>
        <%= render PanelsUI::FormField.new(form: f, attribute: :date_range, label: "Date range", label_hidden: true, size: :sm, class: "w-full sm:w-64") do |field| %>
          <% field.with_date_picker(
               range: true,
               months: 2,
               responsive_months: true,
               value: "#{@report_start_date.iso8601}/#{@report_end_date.iso8601}",
               placeholder: "Date range",
               data: { action: "change->date-preset#submitDate" }) %>
        <% end %>
        <% if feature_enabled_for_hotel?("excel_pdf_export") %>
          <%= render "export_dropdown",
            menu_id: "journal-batches-export",
            items: [
              ["Export PDF", journal_batches_hotel_reports_path(current_hotel, start_date: @report_start_date, end_date: @report_end_date, format: :pdf)],
              ["Export Excel", journal_batches_hotel_reports_path(current_hotel, start_date: @report_start_date, end_date: @report_end_date, format: :xlsx)],
              ["Export CSV", journal_batches_hotel_reports_path(current_hotel, start_date: @report_start_date, end_date: @report_end_date, format: :csv)]
            ] %>
        <% end %>
      <% end %>
    <% end %>
  <% end %>

  <%= render HotelPortal::Reports::MetricStrip.new(metrics: [
    { label: "Journal batches", value: format_number(@journal_summary.batch_count), detail: "Selected period" },
    { label: "Total debit", value: "MYR #{format_number(@journal_summary.total_debit, precision: 2)}", detail: "Selected period" },
    { label: "Total credit", value: "MYR #{format_number(@journal_summary.total_credit, precision: 2)}", detail: "Selected period" }
  ], aria_label: "Journal batch summary") %>

  <section class="space-y-4" aria-label="Journal batches">
    <% if @paginated_batches.any? %>
      <% @paginated_batches.each do |batch| %>
        <% status_variant = case batch.status
                            when "finalized" then :success
                            when "pending" then :warning
                            else :neutral
                            end %>
        <section aria-labelledby="journal-batch-<%= batch.id %>-heading">
          <div class="flex flex-wrap items-center justify-between gap-2 border-b border-border px-3 py-2">
            <div class="flex flex-wrap items-center gap-2">
              <h2 id="journal-batch-<%= batch.id %>-heading" class="text-base font-semibold text-foreground">
                <%= batch.business_date.strftime("%d %b %Y") %>
              </h2>
              <%= render PanelsUI::Badge.new(label: batch.status.humanize, variant: status_variant, size: :sm) %>
            </div>
            <p class="text-xs text-muted-foreground">
              Finalized at <%= batch.finalized_at&.strftime("%d %b %Y %H:%M") %>
            </p>
          </div>

          <%= render PanelsUI::Table.new(
                caption: "Journal entries for #{batch.business_date.strftime('%d %b %Y')}",
                density: :compact,
                header_style: :sentence,
                hoverable: true,
                wrapper_class: "rounded-b-lg border-x border-b border-border bg-card"
              ) do |table| %>
            <% table.with_header do %>
              <tr>
                <th scope="col">General ledger code (GL code)</th>
                <th scope="col">Type</th>
                <th scope="col" class="text-right">Debit</th>
                <th scope="col" class="text-right">Credit</th>
                <th scope="col">Description</th>
              </tr>
            <% end %>
            <% table.with_body do %>
              <% batch.entries.each do |entry| %>
                <tr>
                  <th scope="row" class="whitespace-nowrap font-semibold text-foreground"><%= entry.gl_code %></th>
                  <td class="whitespace-nowrap text-muted-foreground"><%= entry.transaction_type.humanize %></td>
                  <td class="whitespace-nowrap text-right tabular-nums <%= entry.debit_amount.positive? ? 'font-semibold text-foreground' : 'text-muted-foreground' %>">
                    <%= format_number(entry.debit_amount, precision: 2) %>
                  </td>
                  <td class="whitespace-nowrap text-right tabular-nums <%= entry.credit_amount.positive? ? 'font-semibold text-foreground' : 'text-muted-foreground' %>">
                    <%= format_number(entry.credit_amount, precision: 2) %>
                  </td>
                  <td class="text-muted-foreground"><%= entry.description %></td>
                </tr>
              <% end %>
            <% end %>
            <% table.with_footer do %>
              <tr class="bg-muted/55">
                <th scope="row" colspan="2" class="text-xs font-semibold text-foreground">Total</th>
                <td class="whitespace-nowrap text-right font-semibold tabular-nums text-foreground">
                  <%= format_number(batch.entries.sum(:debit_amount), precision: 2) %>
                </td>
                <td class="whitespace-nowrap text-right font-semibold tabular-nums text-foreground">
                  <%= format_number(batch.entries.sum(:credit_amount), precision: 2) %>
                </td>
                <td></td>
              </tr>
            <% end %>
          <% end %>
        </section>
      <% end %>

      <%= render "table_pagination", pagy: @batches_pagy %>
    <% else %>
      <%= render PanelsUI::Table.new(
            caption: "Journal batches",
            density: :compact,
            header_style: :sentence,
            wrapper_class: "rounded-lg border border-border bg-card"
          ) do |table| %>
        <% table.with_header do %>
          <tr>
            <th scope="col">General ledger code (GL code)</th>
            <th scope="col">Type</th>
            <th scope="col" class="text-right">Debit</th>
            <th scope="col" class="text-right">Credit</th>
            <th scope="col">Description</th>
          </tr>
        <% end %>
        <% table.with_body do %>
          <%= render "table_empty_state", colspan: 5, message: "No journal batches found. Adjust the date range or complete a night audit to generate batches." %>
        <% end %>
      <% end %>
    <% end %>
  </section>
</div>
