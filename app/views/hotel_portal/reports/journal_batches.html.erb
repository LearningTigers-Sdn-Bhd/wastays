<% content_for :breadcrumbs do %>
  <div class="flex items-center gap-x-2">
    <span class="text-sm font-medium text-slate-600"><%= current_hotel.name %></span>
    <span class="text-sm text-slate-400">/</span>
    <%= link_to "Reports", hotel_reports_path(current_hotel), class: "text-sm font-medium text-slate-600 hover:text-slate-900" %>
    <span class="text-sm text-slate-400">/</span>
    <span class="text-sm font-semibold text-slate-900">Journal Batches</span>
  </div>
<% end %>

<div class="max-w-[1600px] mx-auto pb-20 space-y-8">
  <div class="px-4 md:px-0">
    <div class="mt-5 flex flex-col gap-4 md:flex-row md:items-end md:justify-between">
      <div>
        <h1 class="text-2xl font-bold tracking-tight text-slate-950 sm:text-3xl">Journal Batches</h1>
        <p class="mt-1 text-sm font-medium text-slate-600">
          Summarized daily transaction batches by General Ledger Code (GL Code).
        </p>
      </div>

      <%= form_with url: journal_batches_hotel_reports_path(current_hotel), method: :get, local: true, class: "flex flex-col gap-3 md:flex-row md:items-end" do |f| %>
        <div>
          <label class="mb-2 block text-[11px] font-bold uppercase tracking-wider text-slate-500">Start Date</label>
          <%= f.date_field :start_date, value: @report_start_date, class: "rounded-xl border border-slate-200 bg-white px-4 py-2.5 text-sm font-bold text-slate-700" %>
        </div>
        <div>
          <label class="mb-2 block text-[11px] font-bold uppercase tracking-wider text-slate-500">End Date</label>
          <%= f.date_field :end_date, value: @report_end_date, class: "rounded-xl border border-slate-200 bg-white px-4 py-2.5 text-sm font-bold text-slate-700" %>
        </div>
        <div class="flex gap-2">
          <%= f.submit "Filter", class: "inline-flex items-center rounded-xl bg-slate-900 px-4 py-2.5 text-sm font-bold text-white shadow-sm transition hover:bg-slate-700 cursor-pointer" %>
          
          <details class="relative min-w-[120px]">
            <summary class="list-none inline-flex w-full cursor-pointer items-center justify-center rounded-xl border border-slate-200 bg-white px-4 py-2.5 text-sm font-bold text-slate-700 shadow-sm transition hover:border-slate-900 hover:bg-slate-50">
              <svg class="size-4 me-2" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
              Export
            </summary>
            <div class="absolute right-0 z-20 mt-2 w-44 overflow-hidden rounded-xl border border-slate-200 bg-white shadow-xl">
              <%= link_to "Export CSV", journal_batches_hotel_reports_path(current_hotel, start_date: @report_start_date, end_date: @report_end_date, format: :csv), class: "block px-4 py-2.5 text-sm font-semibold text-slate-700 transition hover:bg-slate-50" %>
            </div>
          </details>
        </div>
      <% end %>
    </div>
  </div>

  <div class="space-y-6">
    <% if @paginated_batches.any? %>
      <% @paginated_batches.each do |batch| %>
        <div class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">
          <div class="bg-slate-50/50 px-6 py-4 flex items-center justify-between border-b border-slate-200">
            <div class="flex items-center gap-4">
              <h3 class="text-lg font-bold text-slate-900"><%= batch.business_date.strftime("%d %b %Y") %></h3>
              <span class="inline-flex items-center rounded-full bg-emerald-50 px-2.5 py-0.5 text-xs font-bold text-emerald-700 uppercase tracking-wider border border-emerald-100">
                <%= batch.status %>
              </span>
            </div>
            <span class="text-xs font-medium text-slate-500 italic">
              Finalized at <%= batch.finalized_at&.strftime("%d %b %Y %H:%M") %>
            </span>
          </div>
          
          <div class="overflow-x-auto">
            <table class="min-w-full">
              <thead class="bg-slate-50">
                <tr>
                  <th class="px-6 py-3 text-left text-[11px] font-semibold uppercase tracking-wider text-slate-500">General Ledger Code (GL Code)</th>
                  <th class="px-6 py-3 text-left text-[11px] font-semibold uppercase tracking-wider text-slate-500">Type</th>
                  <th class="px-6 py-3 text-right text-[11px] font-semibold uppercase tracking-wider text-slate-500">Debit</th>
                  <th class="px-6 py-3 text-right text-[11px] font-semibold uppercase tracking-wider text-slate-500">Credit</th>
                  <th class="px-6 py-3 text-left text-[11px] font-semibold uppercase tracking-wider text-slate-500">Description</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-slate-100">
                <% batch.entries.each do |entry| %>
                  <tr class="hover:bg-slate-50/50 transition-colors">
                    <td class="px-6 py-4 text-sm font-bold text-slate-900"><%= entry.gl_code %></td>
                    <td class="px-6 py-4 text-sm font-medium text-slate-600 uppercase"><%= entry.transaction_type %></td>
                    <td class="px-6 py-4 text-sm text-right tabular-nums <%= entry.debit_amount > 0 ? 'font-bold text-slate-900' : 'text-slate-400' %>">
                      <%= number_with_precision(entry.debit_amount, precision: 2) %>
                    </td>
                    <td class="px-6 py-4 text-sm text-right tabular-nums <%= entry.credit_amount > 0 ? 'font-bold text-emerald-700' : 'text-slate-400' %>">
                      <%= number_with_precision(entry.credit_amount, precision: 2) %>
                    </td>
                    <td class="px-6 py-4 text-xs text-slate-500"><%= entry.description %></td>
                  </tr>
                <% end %>
                <tr class="bg-slate-50/30">
                  <td colspan="2" class="px-6 py-3 text-xs font-bold uppercase text-slate-900">Total</td>
                  <td class="px-6 py-3 text-sm text-right font-black text-slate-900">
                    <%= number_with_precision(batch.entries.sum(:debit_amount), precision: 2) %>
                  </td>
                  <td class="px-6 py-3 text-sm text-right font-black text-emerald-700">
                    <%= number_with_precision(batch.entries.sum(:credit_amount), precision: 2) %>
                  </td>
                  <td></td>
                </tr>
              </tbody>
            </table>
          </div>
        </div>
      <% end %>
      
      <div class="py-10 flex justify-center">
        <%= paginate @paginated_batches %>
      </div>
    <% else %>
      <div class="py-32 text-center bg-white rounded-2xl border border-dashed border-slate-300">
        <div class="size-16 rounded-full bg-slate-50 flex items-center justify-center mx-auto mb-4">
          <svg class="size-8 text-slate-300" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><path d="M14 2v6h6"/><path d="M16 13H8"/><path d="M16 17H8"/><path d="M10 9H8"/></svg>
        </div>
        <h3 class="text-sm font-bold text-slate-900 uppercase tracking-widest">No journal batches found</h3>
        <p class="mt-1 text-sm text-slate-500">Try adjusting your date range or complete a Night Audit to generate batches.</p>
      </div>
    <% end %>
  </div>
</div>
