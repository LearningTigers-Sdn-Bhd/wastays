<% content_for :title, "Booking Performance | WAStays" %>
<% selection_state = {
     selected_booking_ids: @booking_selection.ids.to_a,
     selected_booking_groups: @booking_selection.group_values.to_a,
     excluded_booking_ids: @booking_selection.excluded_ids.to_a,
     selection_group_by: params[:selection_group_by].presence || @booking_group_by
   } %>
<%# A filter that holds no value must survive the round trip, so send the
    "match nothing" marker rather than an empty parameter that compact_blank drops. %>
<% filter_state = @booking_filters.transform_values { |values| values.nil? ? nil : values.presence || %w[__none__] } %>
<% report_state = {
     date_preset: @date_preset, start_date: @start_date, end_date: @end_date, q: params[:q],
     group_by: @booking_group_by
   }.compact_blank.merge(filter_state.compact) %>
<% export_state = report_state.merge(selection_state).compact_blank %>
<% header_filters = {
     "source" => [ "Source", "booking_sources", nil ],
     "fund_collector" => [ "Collected by", "fund_collectors", "fund_collector" ],
     "status" => [ "Status", "statuses", nil ],
     "payment_status" => [ "Payment status", "payment_statuses", nil ],
     "currency" => [ "Currency", "currencies", nil ]
   } %>
<% booking_group_slot = if @booking_group_by != "booking_date"
     "report-group"
   elsif @date_preset == "this_year"
     "report-month-group"
   else
     "report-date-group"
   end %>
<% filter_options = {
     "booking_sources" => @booking_performance_report.filter_options[:booking_sources],
     "fund_collectors" => @booking_performance_report.filter_options[:fund_collectors],
     "statuses" => @booking_performance_report.filter_options[:statuses],
     "payment_statuses" => @booking_performance_report.filter_options[:payment_statuses],
     "currencies" => @booking_performance_report.filter_options[:currencies]
   } %>

<div class="w-full" data-slot="report-page" data-report="booking-performance">
  <%= turbo_frame_tag "breakdown_results", class: "block" do %>
    <%# The Stimulus controller sits inside the frame. Turbo swaps the children
        of the frame on every reload, so the URL and the selection state that
        the controller reads always match the report on screen. %>
    <div class="space-y-4" data-controller="report-table"
         data-action="change->report-table#changed"
         data-report-table-url="<%= breakdown_hotel_reports_path(current_hotel, report_state) %>"
         data-report-table-preference-url-value="<%= hotel_booking_performance_view_preference_path(current_hotel) %>"
         data-report-table-id-param-value="selected_booking_ids"
         data-report-table-group-param-value="selected_booking_groups"
         data-report-table-excluded-param-value="excluded_booking_ids"
         data-report-table-selection-group-param-value="selection_group_by"
         data-report-table-grouping-param-value="group_by"
         data-report-table-page-param-value="page"
         data-report-table-default-grouping-value="<%= HotelPortal::Reports::BookingPerformanceReport::DEFAULT_GROUPING %>"
         data-report-table-sync-pagination-value="true"
         data-report-table-filter-params-value="<%= filter_options.keys.to_json %>"
         data-report-table-drop-params-value="<%= %w[fund_collector].to_json %>"
         data-report-table-export-link-ids-value="<%= %w[booking-export-pdf-link booking-export-excel-link booking-export-csv-link].to_json %>"
         data-report-table-column-filters-value="<%= header_filters.transform_values { |(_title, param, _fallback)| "#{param}[]" }.to_json %>"
         data-report-table-column-groupings-value="<%= HotelPortal::Reports::BookingPerformanceRequest::GROUPING_COLUMNS.invert.compact.to_json %>"
         data-report-table-selected-ids-value="<%= @booking_selection.ids.to_a.to_json %>"
         data-report-table-selected-groups-value="<%= @booking_selection.group_values.to_a.to_json %>"
         data-report-table-excluded-ids-value="<%= @booking_selection.excluded_ids.to_a.to_json %>"
         data-report-table-selected-id-groups-value="<%= @booking_selection.id_group_keys.to_json %>"
         data-report-table-excluded-id-groups-value="<%= @booking_selection.excluded_id_group_keys.to_json %>"
         data-report-table-group-counts-value="<%= @booking_group_totals.transform_values(&:count).to_json %>">
    <%= render PanelsUI::PageHeader.new(
          title: "Booking performance",
          description: "Review bookings created during the selected period, including source, taxes, commission, and net payout."
        ) do |header| %>
      <% header.with_caption do %>
        <p class="text-sm font-medium text-muted-foreground">
          <%= current_hotel.name %> ·
          <%= @start_date.strftime("%d %b %Y") %> - <%= @end_date.strftime("%d %b %Y") %>
        </p>
      <% end %>
      <% header.with_actions do %>
        <%= render "preset_report_actions",
          form_url: breakdown_hotel_reports_path(current_hotel),
          date_preset: @date_preset,
          start_date: @start_date,
          end_date: @end_date,
          export_menu_id: "booking-performance-export",
          export_items: [],
          show_export: false,
          hidden_params: report_state.except(:date_preset, :start_date, :end_date),
          form_data: { turbo_frame: "breakdown_results", turbo_action: "advance" },
          class_name: "flex w-full flex-col gap-2 sm:flex-row sm:items-end lg:w-auto" %>
      <% end %>
    <% end %>

    <% if @booking_performance_report.totals_by_currency.any? %>
      <section class="space-y-3" aria-labelledby="booking-performance-summary-heading">
        <h2 id="booking-performance-summary-heading" class="text-base font-semibold text-foreground">Financial summary</h2>
        <% @booking_performance_report.totals_by_currency.each do |totals| %>
          <% currency = totals.fetch(:currency) %>
          <%= render HotelPortal::Reports::MetricStrip.new(
                aria_label: "#{currency} booking performance summary",
                metrics: [
                  { label: "Gross price", value: report_money(totals.fetch(:gross), currency), detail: pluralize(totals.fetch(:booking_count), "booking") },
                  { label: "Taxes", value: report_money(totals.fetch(:taxes), currency), detail: "Included in gross price" },
                  { label: "Commission", value: report_money(totals.fetch(:commission), currency), detail: "WAStays commission" },
                  { label: "Net payout", value: report_money(totals.fetch(:net), currency), detail: "Gross price less commission" }
                ]
              ) %>
        <% end %>
      </section>
    <% end %>

    <section class="space-y-3" aria-labelledby="booking-performance-records-heading">
      <%= render "booking_performance_toolbar",
            report: @booking_performance_report,
            selection: @booking_selection,
            visible_columns: @booking_visible_columns,
            group_by: @booking_group_by,
            export_state: %>

      <p class="sr-only" role="status" aria-live="polite" aria-atomic="true" data-report-table-status></p>

      <%= render PanelsUI::ScrollArea.new(
            orientation: :both,
            max_height: "max-h-[72dvh]",
            class: "overflow-hidden rounded-lg border border-border bg-card",
            data: { testid: "booking-performance-scroll-area" }) do %>
        <%= render PanelsUI::Table.new(
              caption: "Bookings grouped by #{@booking_group_by.humanize.downcase}",
              density: :compact, header_style: :sentence, hoverable: true, sticky_header: true,
              wrapper_class: "overflow-visible",
              data: { testid: "booking-performance-rows" }) do |table| %>
          <% table.with_header do %>
            <tr>
              <th scope="col" class="w-10 text-center">
                <%= render PanelsUI::Checkbox.new(
                      name: "select_page_bookings", id: "select-page-bookings",
                      label: "Select all bookings on this page", label_hidden: true, include_hidden: false,
                      data: { select_page: "" }) %>
              </th>
              <% HotelPortal::Reports::BookingPerformanceColumns.selected(@booking_visible_columns).each do |column| %>
                <% money_column = %w[gross taxes commission net].include?(column.key) %>
                <th scope="col" class="<%= money_column ? 'text-right' : 'text-left' %>" data-column-key="<%= column.key %>">
                  <% if (filter = header_filters[column.key]) %>
                    <%= render "report_column_filter",
                          title: filter[0], param_name: filter[1],
                          options: filter_options.fetch(filter[1]), fallback_param: filter[2] %>
                  <% else %>
                    <%= column.label %>
                  <% end %>
                </th>
              <% end %>
            </tr>
          <% end %>

          <% table.with_body do %>
            <% if @booking_rows.empty? %>
              <%= render "table_empty_state", colspan: @booking_visible_columns.size + 1, message: "No bookings match the current filters." %>
            <% else %>
              <% current_group = nil %>
              <% @booking_rows.each do |row| %>
                <% group_key = @booking_performance_report.group_key_for(row) %>
                <% if group_key != current_group %>
                  <% current_group = group_key %>
                  <%= render "booking_performance_group_row",
                        group: @booking_group_totals.fetch(group_key),
                        selection: @booking_selection,
                        colspan: @booking_visible_columns.size,
                        group_slot: booking_group_slot %>
                <% end %>
                <%= render "booking_performance_row",
                      row:, group_key:,
                      selection: @booking_selection,
                      visible_columns: @booking_visible_columns %>
              <% end %>
            <% end %>
          <% end %>
        <% end %>
      <% end %>

      <%= render "table_pagination", pagy: @bookings_pagy,
            aria_label: "Booking performance pagination",
            link_data: { turbo_frame: "breakdown_results", turbo_action: "advance" } %>
      </section>
    </div>
  <% end %>
</div>
