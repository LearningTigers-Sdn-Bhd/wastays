<div class="w-full space-y-4" data-slot="report-page" data-report="financial-breakdown">
  <%= turbo_frame_tag "breakdown_results", class: "block space-y-4" do %>
    <%= render PanelsUI::PageHeader.new(title: "Financial breakdown", description: "Review booking revenue, taxes, commission, and net payout for the selected period.") do |header| %>
      <% header.with_caption do %>
        <p class="text-sm font-medium text-muted-foreground">
          <%= current_hotel.name %> ·
          <% if @start_date == @end_date %>
            <%= @start_date.strftime("%A, %d %b %Y") %>
          <% else %>
            <%= @start_date.strftime("%d %b %Y") %> - <%= @end_date.strftime("%d %b %Y") %>
          <% end %>
        </p>
      <% end %>
    <% end %>

    <section class="rounded-lg border border-border bg-card p-3" aria-label="Financial breakdown filters">
      <div class="flex flex-col gap-3 lg:flex-row lg:items-end">
        <%= render "preset_report_actions",
          form_url: breakdown_hotel_reports_path(current_hotel),
          date_preset: @date_preset,
          start_date: @start_date,
          end_date: @end_date,
          export_menu_id: "financial-breakdown-export",
          export_items: [],
          show_export: false,
          hidden_params: { q: params[:q], fund_collector: @fund_collector },
          class_name: "flex w-full flex-col gap-2 sm:flex-row sm:items-end lg:w-auto" %>

        <%= form_with url: breakdown_hotel_reports_path(current_hotel), method: :get,
              class: "grid w-full gap-3 sm:grid-cols-[minmax(0,1fr)_14rem] lg:min-w-96 lg:flex-1",
              data: { controller: "auto-submit", turbo_frame: "breakdown_results" } do |form| %>
          <%= hidden_field_tag :date_preset, @date_preset %>
          <%= hidden_field_tag :start_date, @start_date %>
          <%= hidden_field_tag :end_date, @end_date %>
          <%= render PanelsUI::FormField.new(form: form, attribute: :q, label: "Search records") do |field| %>
            <% field.with_input(
                 type: :search,
                 value: params[:q],
                 placeholder: "Guest, email, booking number, or confirmation code…",
                 data: { action: "input->auto-submit#submit" }) %>
          <% end %>
          <%= render PanelsUI::FormField.new(form: form, attribute: :fund_collector, label: "Payment collected by") do |field| %>
            <% field.with_select_menu(
                 [
                   { label: "All bookings", value: "" },
                   { label: "WAStays", value: "wastays" },
                   { label: "Hotel", value: "hotel" }
                 ],
                 selected: @fund_collector,
                 data: { action: "change->auto-submit#submitNow" }) %>
          <% end %>
        <% end %>

        <% if feature_enabled_for_hotel?("excel_pdf_export") %>
          <%= render "export_dropdown", menu_id: "financial-breakdown-export", items: [
            ["Export PDF", breakdown_hotel_reports_path(current_hotel, start_date: @start_date, end_date: @end_date, q: params[:q], fund_collector: @fund_collector, date_preset: @date_preset, format: :pdf)],
            ["Export Excel", breakdown_hotel_reports_path(current_hotel, start_date: @start_date, end_date: @end_date, q: params[:q], fund_collector: @fund_collector, date_preset: @date_preset, format: :xlsx)],
            ["Export CSV", breakdown_hotel_reports_path(current_hotel, start_date: @start_date, end_date: @end_date, q: params[:q], fund_collector: @fund_collector, date_preset: @date_preset, format: :csv)]
          ] %>
        <% end %>
      </div>
    </section>

    <% if @financial_breakdown_report.currency_totals.any? %>
      <section class="space-y-3" aria-labelledby="financial-summary-heading">
        <h2 id="financial-summary-heading" class="text-base font-semibold text-foreground">Financial summary</h2>
        <% @financial_breakdown_report.currency_totals.each do |totals| %>
          <% currency = totals.fetch(:currency) %>
          <% format_amount = ->(amount) { number_to_currency(amount, unit: "#{currency} ", format: "%u%n") } %>
          <%= render HotelPortal::Reports::MetricStrip.new(
                aria_label: "#{currency} financial summary",
                metrics: [
                  { label: "Gross price", value: format_amount.call(totals.fetch(:gross)), detail: pluralize(totals.fetch(:booking_count), "booking") },
                  { label: "Taxes", value: format_amount.call(totals.fetch(:taxes)), detail: "Included in gross price" },
                  { label: "Commission", value: format_amount.call(totals.fetch(:margin)), detail: "WAStays commission" },
                  { label: "Net payout", value: format_amount.call(totals.fetch(:net)), detail: "Gross price less commission" }
                ]
              ) %>
        <% end %>
      </section>
    <% end %>

    <section class="space-y-3" aria-labelledby="financial-breakdown-heading">
      <h2 id="financial-breakdown-heading" class="text-base font-semibold text-foreground">Booking records</h2>

      <%= render PanelsUI::Table.new(
            caption: "Financial breakdown",
            density: :compact,
            header_style: :sentence,
            hoverable: true,
            wrapper_class: "rounded-lg border border-border bg-card"
          ) do |table| %>
        <% table.with_header do %>
          <tr>
            <th scope="col">Booking</th>
            <th scope="col">Guest name</th>
            <th scope="col">Status</th>
            <th scope="col" class="text-right">Gross price</th>
            <th scope="col" class="text-right">Taxes</th>
            <th scope="col" class="text-right">Commission</th>
            <th scope="col" class="text-right">Net payout</th>
          </tr>
        <% end %>
        <% table.with_body do %>
          <% if @grouped_bookings.any? %>
            <% @grouped_bookings.each do |date, bookings| %>
              <tr class="bg-muted/55" data-slot="<%= @date_preset == 'this_year' ? 'report-month-group' : 'report-date-group' %>">
                <th scope="rowgroup" colspan="7" class="text-xs font-semibold text-muted-foreground">
                  <%= date.strftime(@date_preset == "this_year" ? "%B %Y" : "%d %b %Y") %>
                </th>
              </tr>
              <% bookings.each do |presenter| %>
                <tr class="align-top">
                  <th scope="row" class="min-w-44">
                    <%= link_to presenter.booking_number,
                          hotel_booking_workspace_path(current_hotel, presenter.booking, tab: "booking_details"),
                          class: "block break-words font-mono text-sm font-semibold text-primary hover:underline focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-border-interactive",
                          data: { turbo: false } %>
                    <span class="mt-1 block break-all font-mono text-xs font-normal text-muted-foreground" translate="no">
                      Code: <%= presenter.confirmation_token %>
                    </span>
                  </th>
                  <td class="font-medium text-foreground"><%= presenter.guest_name %></td>
                  <td class="whitespace-nowrap">
                    <%= render PanelsUI::Badge.new(
                          label: presenter.status_label,
                          variant: presenter.status_badge_variant,
                          size: :sm
                        ) %>
                  </td>
                  <td class="whitespace-nowrap text-right tabular-nums text-muted-foreground"><%= presenter.total_amount %></td>
                  <td class="whitespace-nowrap text-right tabular-nums text-muted-foreground"><%= presenter.tax_total %></td>
                  <td class="whitespace-nowrap text-right tabular-nums text-muted-foreground"><%= presenter.margin_amount %></td>
                  <td class="whitespace-nowrap text-right font-semibold tabular-nums text-foreground"><%= presenter.net_amount %></td>
                </tr>
              <% end %>
            <% end %>
          <% else %>
            <%= render "table_empty_state", colspan: 7, message: "No bookings found for the selected criteria." %>
          <% end %>
        <% end %>
      <% end %>

      <%= render "table_pagination", pagy: @bookings_pagy %>
    </section>
  <% end %>
</div>
