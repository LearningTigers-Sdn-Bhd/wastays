<div class="grid grid-cols-1 gap-4 md:grid-cols-2">
  <div class="rounded-2xl border border-border bg-card p-6 shadow-sm">
    <p class="mb-2 text-[11px] font-semibold uppercase tracking-wider text-muted-foreground">In-House Foreign Guests</p>
    <h2 class="text-2xl font-bold tracking-tight text-foreground"><%= @report.totals[:guest_count] %></h2>
  </div>
  <div class="rounded-2xl border border-border bg-card p-6 shadow-sm">
    <p class="mb-2 text-[11px] font-semibold uppercase tracking-wider text-muted-foreground">Total Nights</p>
    <h2 class="text-2xl font-bold tracking-tight text-foreground"><%= @report.totals[:nights] %></h2>
  </div>
</div>

<div class="overflow-hidden rounded-2xl border border-border bg-card shadow-sm">
  <div class="overflow-x-auto">
    <table class="min-w-full">
      <thead class="bg-muted">
        <tr>
          <th class="px-6 py-4 text-left text-[11px] font-semibold uppercase tracking-[0.1em] text-muted-foreground">Full Name</th>
          <th class="px-6 py-4 text-left text-[11px] font-semibold uppercase tracking-[0.1em] text-muted-foreground">Nationality</th>
          <th class="px-6 py-4 text-left text-[11px] font-semibold uppercase tracking-[0.1em] text-muted-foreground">Date of Birth</th>
          <th class="px-6 py-4 text-left text-[11px] font-semibold uppercase tracking-[0.1em] text-muted-foreground">Home Address</th>
          <th class="px-6 py-4 text-left text-[11px] font-semibold uppercase tracking-[0.1em] text-muted-foreground">Check In Date</th>
          <th class="px-6 py-4 text-left text-[11px] font-semibold uppercase tracking-[0.1em] text-muted-foreground">Check In Time</th>
          <th class="px-6 py-4 text-left text-[11px] font-semibold uppercase tracking-[0.1em] text-muted-foreground">Check Out Date</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-border bg-card">
        <% if @report.rows.any? %>
          <% @report.rows.each do |row| %>
            <tr class="hover:bg-muted/50">
              <td class="px-6 py-4 text-sm font-semibold text-foreground"><%= row[:guest_name] %></td>
              <td class="px-6 py-4 text-sm text-foreground"><%= row[:guest_country] %></td>
              <td class="px-6 py-4 text-sm text-foreground"><%= row[:date_of_birth]&.strftime("%d %b %Y") || "-" %></td>
              <td class="px-6 py-4 text-sm text-foreground"><%= row[:guest_home_address].presence || "-" %></td>
              <td class="px-6 py-4 text-sm text-foreground"><%= row[:check_in].strftime("%d %b %Y") %></td>
              <td class="px-6 py-4 text-sm text-foreground"><%= row[:checked_in_at]&.strftime("%I:%M %p") || "-" %></td>
              <td class="px-6 py-4 text-sm text-foreground"><%= row[:check_out].strftime("%d %b %Y") %></td>
            </tr>
          <% end %>
        <% else %>
          <tr>
            <td colspan="7" class="px-6 py-16 text-center text-sm font-medium text-muted-foreground">
              No in-house foreign guests found for this selected period.
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>
