<div class="w-full space-y-3.5">
  <div>
    <%= render PanelsUI::PageHeader.new(title: "Daily Revenue Report") do |header| %>
      <% header.with_caption do %>
        <p class="text-sm font-medium text-muted-foreground">
          <%= current_hotel.name %> ·
          <% if @report.start_date == @report.end_date %>
            <%= @report.start_date.strftime("%A, %d %b %Y") %>
          <% else %>
            <%= @report.start_date.strftime("%d %b %Y") %> - <%= @report.end_date.strftime("%d %b %Y") %>
          <% end %>
        </p>
      <% end %>
      <% header.with_actions do %>
        <%= render "preset_report_actions",
          form_url: daily_revenue_hotel_reports_path(current_hotel),
          form_id: "daily-revenue-range-form",
          date_preset: @date_preset,
          start_date: @report.start_date,
          end_date: @report.end_date,
          show_export: feature_enabled_for_hotel?("excel_pdf_export"),
          export_disabled: @report.rows.empty?,
          export_menu_id: "daily-revenue-export",
          export_items: [
            ["Export PDF", daily_revenue_hotel_reports_path(current_hotel, start_date: @report.start_date, end_date: @report.end_date, date_preset: @date_preset, format: :pdf)],
            ["Export Excel", daily_revenue_hotel_reports_path(current_hotel, start_date: @report.start_date, end_date: @report.end_date, date_preset: @date_preset, format: :xls)],
            ["Export CSV", daily_revenue_hotel_reports_path(current_hotel, start_date: @report.start_date, end_date: @report.end_date, date_preset: @date_preset, format: :csv)]
          ] %>
      <% end %>
    <% end %>
  </div>

  <!-- Summary Cards -->
  <div class="grid grid-cols-2 overflow-hidden rounded-2xl border border-border bg-card shadow-sm md:grid-cols-4">
    <div class="p-6 md:border-r md:border-border">
      <p class="mb-2 text-[11px] font-semibold uppercase tracking-wider text-muted-foreground">Bookings</p>
      <h2 class="text-3xl font-bold tabular-nums tracking-tight text-foreground"><%= @report.totals[:booking_count] %></h2>
    </div>
    <div class="p-6 md:border-r md:border-border">
      <p class="mb-2 text-[11px] font-semibold uppercase tracking-wider text-muted-foreground">Total Charges</p>
      <h2 class="text-2xl font-bold tabular-nums tracking-tight text-foreground">MYR <%= number_with_precision(@report.totals[:total_charges], precision: 2) %></h2>
    </div>
    <div class="bg-muted/30 p-6 md:border-r md:border-border">
      <p class="mb-2 text-[11px] font-semibold uppercase tracking-wider text-muted-foreground">Total Payments</p>
      <h2 class="text-2xl font-bold tabular-nums tracking-tight text-foreground">MYR <%= number_with_precision(@report.totals[:total_payments], precision: 2) %></h2>
    </div>
    <div class="bg-muted/30 p-6">
      <p class="mb-2 text-[11px] font-semibold uppercase tracking-wider text-muted-foreground">Net Amount</p>
      <h2 class="text-2xl font-bold tabular-nums tracking-tight text-emerald-700">MYR <%= number_with_precision(@report.totals[:net_amount], precision: 2) %></h2>
    </div>
  </div>

  <!-- Daily Breakdown -->
  <div class="overflow-hidden rounded-2xl border border-border bg-card shadow-sm">
    <div class="px-6 py-5 border-b border-border">
      <h2 class="text-lg font-bold tracking-tight text-foreground"><%= @date_preset == "this_year" ? "Monthly Breakdown" : "Daily Breakdown" %></h2>
    </div>
    <div class="overflow-x-auto">
      <table class="min-w-full">
        <thead class="bg-muted">
          <tr>
            <th class="px-4 py-3 text-left text-[10px] font-semibold uppercase tracking-[0.1em] text-muted-foreground"><%= @date_preset == "this_year" ? "Month" : "Date" %></th>
            <th class="px-4 py-3 text-left text-[10px] font-semibold uppercase tracking-[0.1em] text-muted-foreground">Bookings</th>
            <th class="px-4 py-3 text-right text-[10px] font-semibold uppercase tracking-[0.1em] text-muted-foreground">Accommodation</th>
            <th class="px-4 py-3 text-right text-[10px] font-semibold uppercase tracking-[0.1em] text-muted-foreground">Other Charges</th>
            <th class="px-4 py-3 text-right text-[10px] font-semibold uppercase tracking-[0.1em] text-muted-foreground">Tax</th>
            <th class="px-4 py-3 text-right text-[10px] font-semibold uppercase tracking-[0.1em] text-muted-foreground">Total Charges</th>
            <th class="px-4 py-3 text-right text-[10px] font-semibold uppercase tracking-[0.1em] text-muted-foreground">Discount</th>
            <th class="px-4 py-3 text-right text-[10px] font-semibold uppercase tracking-[0.1em] text-muted-foreground">Online</th>
            <th class="px-4 py-3 text-right text-[10px] font-semibold uppercase tracking-[0.1em] text-muted-foreground">Cash</th>
            <th class="px-4 py-3 text-right text-[10px] font-semibold uppercase tracking-[0.1em] text-muted-foreground">Deposit</th>
            <th class="px-4 py-3 text-right text-[10px] font-semibold uppercase tracking-[0.1em] text-muted-foreground">Agent Transfer</th>
            <th class="px-4 py-3 text-right text-[10px] font-semibold uppercase tracking-[0.1em] text-muted-foreground">Refund</th>
            <th class="px-4 py-3 text-right text-[10px] font-semibold uppercase tracking-[0.1em] text-muted-foreground">Net</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-border bg-card">
          <% if @report.rows.any? %>
            <% @report.rows.each do |row| %>
              <tr class="hover:bg-muted/50">
                <td class="px-4 py-3 text-sm font-semibold text-foreground whitespace-nowrap"><%= @date_preset == "this_year" ? row[:date].strftime("%b %Y") : row[:date].strftime("%d %b") %></td>
                <td class="px-4 py-3 text-sm text-foreground"><%= row[:booking_count] %></td>
                <td class="px-4 py-3 text-sm text-foreground text-right">MYR <%= number_with_precision(row[:accommodation], precision: 2) %></td>
                <td class="px-4 py-3 text-sm text-foreground text-right">MYR <%= number_with_precision(row[:other_charges], precision: 2) %></td>
                <td class="px-4 py-3 text-sm text-foreground text-right">MYR <%= number_with_precision(row[:tax], precision: 2) %></td>
                <td class="px-4 py-3 text-sm font-semibold text-foreground text-right">MYR <%= number_with_precision(row[:total_charges], precision: 2) %></td>
                <td class="px-4 py-3 text-sm text-red-500 text-right">- MYR <%= number_with_precision(row[:discount], precision: 2) %></td>
                <td class="px-4 py-3 text-sm text-foreground text-right">MYR <%= number_with_precision(row[:gateway_payment], precision: 2) %></td>
                <td class="px-4 py-3 text-sm text-foreground text-right">MYR <%= number_with_precision(row[:cash_payment], precision: 2) %></td>
                <td class="px-4 py-3 text-sm text-foreground text-right">MYR <%= number_with_precision(row[:booking_payment], precision: 2) %></td>
                <td class="px-4 py-3 text-sm text-foreground text-right">MYR <%= number_with_precision(row[:ar_bank_transfer], precision: 2) %></td>
                <td class="px-4 py-3 text-sm text-red-500 text-right">- MYR <%= number_with_precision(row[:refund], precision: 2) %></td>
                <td class="px-4 py-3 text-sm font-bold text-emerald-700 text-right">MYR <%= number_with_precision(row[:net_amount], precision: 2) %></td>
              </tr>
            <% end %>
          <% else %>
            <tr><td colspan="13" class="px-6 py-20 text-center text-sm font-medium text-muted-foreground">No daily revenue data for this selected period.</td></tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>

  <!-- Revenue by Source -->
  <div class="overflow-hidden rounded-2xl border border-border bg-card shadow-sm">
    <div class="px-6 py-5 border-b border-border">
      <h2 class="text-lg font-bold tracking-tight text-foreground">Revenue by Source</h2>
    </div>
    <div class="overflow-x-auto">
      <table class="min-w-full">
        <thead class="bg-muted">
          <tr>
            <th class="px-6 py-4 text-left text-[11px] font-semibold uppercase tracking-[0.1em] text-muted-foreground">Source</th>
            <th class="px-6 py-4 text-left text-[11px] font-semibold uppercase tracking-[0.1em] text-muted-foreground">Bookings</th>
            <th class="px-6 py-4 text-right text-[11px] font-semibold uppercase tracking-[0.1em] text-muted-foreground">Accommodation</th>
            <th class="px-6 py-4 text-right text-[11px] font-semibold uppercase tracking-[0.1em] text-muted-foreground">Other Charges</th>
            <th class="px-6 py-4 text-right text-[11px] font-semibold uppercase tracking-[0.1em] text-muted-foreground">Tax</th>
            <th class="px-6 py-4 text-right text-[11px] font-semibold uppercase tracking-[0.1em] text-muted-foreground">Total Charges</th>
            <th class="px-6 py-4 text-right text-[11px] font-semibold uppercase tracking-[0.1em] text-muted-foreground">Payments</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-border bg-card">
          <% if @report.source_rows.any? %>
            <% @report.source_rows.each do |row| %>
              <tr>
                <td class="px-6 py-4 text-sm font-semibold text-foreground"><%= row[:source] %></td>
                <td class="px-6 py-4 text-sm text-foreground"><%= row[:booking_count] %></td>
                <td class="px-6 py-4 text-sm text-foreground text-right">MYR <%= number_with_precision(row[:accommodation], precision: 2) %></td>
                <td class="px-6 py-4 text-sm text-foreground text-right">MYR <%= number_with_precision(row[:other_charges], precision: 2) %></td>
                <td class="px-6 py-4 text-sm text-foreground text-right">MYR <%= number_with_precision(row[:tax], precision: 2) %></td>
                <td class="px-6 py-4 text-sm font-semibold text-foreground text-right">MYR <%= number_with_precision(row[:total_charges], precision: 2) %></td>
                <td class="px-6 py-4 text-sm font-semibold text-emerald-700 text-right">MYR <%= number_with_precision(row[:net_amount], precision: 2) %></td>
              </tr>
            <% end %>
          <% else %>
            <tr><td colspan="7" class="px-6 py-20 text-center text-sm font-medium text-muted-foreground">No source revenue data for this selected period.</td></tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
</div>
