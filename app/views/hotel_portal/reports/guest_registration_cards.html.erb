<div class="mx-auto max-w-[1600px] space-y-8 pb-20">
  <div class="px-4 md:px-0">
    <div class="mt-5 flex flex-col gap-4 md:flex-row md:items-end md:justify-between">
      <div>
        <h1 class="text-2xl font-bold tracking-tight text-slate-950 sm:text-3xl">Guest Registration Cards</h1>
        <p class="mt-1 text-sm font-medium text-slate-600">Review printable and signed GRC documents.</p>
      </div>
    </div>
  </div>

  <div class="grid grid-cols-1 gap-4 md:grid-cols-3">
    <div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
      <p class="mb-2 text-[11px] font-semibold uppercase tracking-wider text-slate-500">Total Cards</p>
      <h2 class="text-2xl font-bold tracking-tight text-slate-950"><%= @grc_total_count %></h2>
    </div>
    <div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
      <p class="mb-2 text-[11px] font-semibold uppercase tracking-wider text-slate-500">Signed</p>
      <h2 class="text-2xl font-bold tracking-tight text-emerald-700"><%= @grc_signed_count %></h2>
    </div>
    <div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
      <p class="mb-2 text-[11px] font-semibold uppercase tracking-wider text-slate-500">Draft</p>
      <h2 class="text-2xl font-bold tracking-tight text-amber-700"><%= @grc_draft_count %></h2>
    </div>
  </div>

  <div class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">
    <div class="border-b border-slate-200 bg-slate-50/50 px-6 py-5">
      <%= form_with url: guest_registration_cards_hotel_reports_path(current_hotel), method: :get, class: "flex flex-col gap-3 lg:flex-row lg:items-end", data: { controller: "auto-submit", turbo_frame: "grc_results", turbo_action: "advance" } do |f| %>
        <div class="w-full lg:flex-1">
          <label class="mb-2 block text-[11px] font-bold uppercase tracking-wider text-slate-500">Search</label>
          <%= f.search_field :q, value: @grc_query, placeholder: "Search GRC no, guest name, or booking ref...", class: "w-full rounded-xl border border-slate-200 bg-white px-4 py-2.5 text-sm font-bold text-slate-700 shadow-sm", data: { action: "input->auto-submit#submit" } %>
        </div>
        <div class="w-full sm:w-56">
          <label class="mb-2 block text-[11px] font-bold uppercase tracking-wider text-slate-500">Status</label>
          <%= select_tag :status, options_for_select([ [ "All", "" ], [ "Draft", "draft" ], [ "Signed", "signed" ] ], @status_filter), class: "w-full rounded-xl border border-slate-200 bg-white px-4 py-2.5 text-sm font-bold text-slate-700 shadow-sm", data: { action: "change->auto-submit#submitNow" } %>
        </div>
      <% end %>
    </div>

    <%= turbo_frame_tag "grc_results" do %>
      <div class="overflow-x-auto">
        <table class="min-w-full">
          <thead class="bg-slate-100">
            <tr>
              <th class="px-6 py-4 text-left text-[11px] font-semibold uppercase tracking-[0.1em] text-slate-600">GRC No.</th>
              <th class="px-6 py-4 text-left text-[11px] font-semibold uppercase tracking-[0.1em] text-slate-600">Guest</th>
              <th class="px-6 py-4 text-left text-[11px] font-semibold uppercase tracking-[0.1em] text-slate-600">Stay</th>
              <th class="px-6 py-4 text-left text-[11px] font-semibold uppercase tracking-[0.1em] text-slate-600">Status</th>
              <th class="px-6 py-4 text-right text-[11px] font-semibold uppercase tracking-[0.1em] text-slate-600">Action</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-200 bg-white">
            <% if @grc_cards.any? %>
              <% @grc_cards.each do |card| %>
                <% booking = card.booking %>
                <tr class="hover:bg-slate-50">
                  <td class="px-6 py-4 text-sm font-black text-slate-950"><%= booking.guest_registration_card_number_display %></td>
                  <td class="px-6 py-4">
                    <p class="text-sm font-semibold text-slate-950"><%= booking.guest_name %></p>
                    <p class="text-xs text-slate-500"><%= booking.confirmation_token %></p>
                  </td>
                  <td class="px-6 py-4 text-sm text-slate-700">
                    <%= l(booking.check_in.to_date) %> -> <%= l(booking.check_out.to_date) %>
                  </td>
                  <td class="px-6 py-4">
                    <span class="rounded-full px-2 py-1 text-xs font-bold <%= card.signed? ? 'bg-emerald-50 text-emerald-700' : 'bg-amber-50 text-amber-700' %>"><%= card.status.titleize %></span>
                  </td>
                  <td class="px-6 py-4 text-right">
                    <%= link_to "View", hotel_booking_guest_registration_card_path(current_hotel, booking), class: "inline-flex rounded-lg border border-slate-200 px-3 py-2 text-sm font-semibold text-slate-700 hover:bg-slate-50", data: { turbo: false } %>
                    <%= link_to "Print / Save as PDF", hotel_booking_guest_registration_card_path(current_hotel, booking), class: "ml-2 inline-flex rounded-lg bg-slate-900 px-3 py-2 text-sm font-semibold text-white hover:bg-slate-700", data: { turbo: false } %>
                  </td>
                </tr>
              <% end %>
            <% else %>
              <tr>
                <td colspan="5" class="px-6 py-14 text-center text-sm font-medium text-slate-500">No guest registration cards found.</td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>

      <div class="flex justify-center border-t border-slate-200 bg-slate-50/50 px-6 py-4 sm:px-8">
        <%= paginate @grc_cards if @grc_cards.respond_to?(:total_pages) %>
      </div>
    <% end %>
  </div>
</div>
