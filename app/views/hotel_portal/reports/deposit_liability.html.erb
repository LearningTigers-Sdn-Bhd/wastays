<div class="w-full space-y-4" data-slot="report-page" data-report="deposit-liability">
  <%= render PanelsUI::PageHeader.new(title: "Deposit liability report") do |header| %>
    <% header.with_caption do %>
      <p class="text-sm font-medium text-muted-foreground">
        <%= current_hotel.name %> · As of <%= @report.as_of_date.strftime("%A, %d %b %Y") %>
      </p>
    <% end %>
    <% header.with_actions do %>
      <%= render "preset_report_actions",
        form_url: deposit_liability_hotel_reports_path(current_hotel), form_id: "deposit-liability-date-form",
        date_preset: @date_preset, start_date: @report.as_of_date, end_date: @report.as_of_date, single_date: true,
        show_export: feature_enabled_for_hotel?("excel_pdf_export"), export_menu_id: "deposit-liability-export",
        export_items: [
          ["Export PDF", deposit_liability_hotel_reports_path(current_hotel, as_of_date: @report.as_of_date, date_preset: @date_preset, format: :pdf)],
          ["Export Excel", deposit_liability_hotel_reports_path(current_hotel, as_of_date: @report.as_of_date, date_preset: @date_preset, format: :xlsx)],
          ["Export CSV", deposit_liability_hotel_reports_path(current_hotel, as_of_date: @report.as_of_date, date_preset: @date_preset, format: :csv)]
        ] %>
    <% end %>
  <% end %>

  <%= render HotelPortal::Reports::MetricStrip.new(metrics: [
    { label: "Bookings", value: @report.totals[:booking_count].to_s, detail: "Open liabilities" },
    { label: "Booking payments", value: "MYR #{number_with_precision(@report.totals[:booking_payment_amount], precision: 2)}", detail: "Held amount", detail_variant: :warning },
    { label: "Earned", value: "MYR #{number_with_precision(@report.totals[:earned_amount], precision: 2)}", detail: "Recognised charges" },
    { label: "Refunds", value: "MYR #{number_with_precision(@report.totals[:refund_amount], precision: 2)}", detail: "Released amount" },
    { label: "Remaining liability", value: "MYR #{number_with_precision(@report.totals[:remaining_liability], precision: 2)}", detail: "Still held", detail_variant: :warning }
  ]) %>

  <aside class="rounded-lg border border-warning/40 bg-warning/10 px-3 py-2 text-sm text-foreground" aria-label="Deposit liability scope">
    This report only includes explicit <span class="font-semibold">booking payment</span> folio payments. Security deposits are tracked separately and do not reduce folio balances unless applied later.
  </aside>

  <section class="space-y-3" aria-labelledby="deposit-liabilities-heading">
    <h2 id="deposit-liabilities-heading" class="text-base font-semibold text-foreground">Open deposit liabilities</h2>

    <% grouped_rows = @date_preset == "this_year" ? @report.rows.group_by { |row| row[:latest_deposit_posting_date].to_date.beginning_of_month } : { nil => @report.rows } %>
    <% grouped_rows = { nil => [] } if grouped_rows.empty? %>
    <% grouped_rows.each do |month, rows| %>
      <div class="space-y-2">
        <% if month.present? %>
          <h3 class="text-sm font-semibold text-foreground"><%= month.strftime("%B %Y") %></h3>
        <% end %>

        <%= render PanelsUI::Table.new(
              caption: month.present? ? "Deposit liabilities for #{month.strftime('%B %Y')}" : "Deposit liabilities",
              density: :compact,
              header_style: :sentence,
              hoverable: true,
              wrapper_class: "rounded-lg border border-border bg-card"
            ) do |table| %>
          <% table.with_header do %>
            <tr>
              <th scope="col">Guest / reference</th>
              <th scope="col">Stay</th>
              <th scope="col">Status</th>
              <th scope="col">Rooms / folio</th>
              <th scope="col" class="text-right">Booking payment</th>
              <th scope="col" class="text-right">Earned</th>
              <th scope="col" class="text-right">Refunds</th>
              <th scope="col" class="text-right">Liability</th>
            </tr>
          <% end %>
          <% table.with_body do %>
            <% if rows.any? %>
              <% rows.each do |row| %>
                <tr class="align-top">
                  <th scope="row">
                    <p class="font-semibold text-foreground"><%= row[:guest_name] %></p>
                    <%= link_to row[:confirmation_token],
                          hotel_booking_control_panel_path(current_hotel, row[:booking_id], tab: "booking_details"),
                          class: "font-mono text-xs font-semibold text-primary hover:underline focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-border-interactive",
                          data: { turbo: false } %>
                  </th>
                  <td class="whitespace-nowrap"><%= row[:stay_dates] %></td>
                  <td><%= row[:booking_status] %></td>
                  <td>
                    <p><%= row[:room_details] %></p>
                    <p class="text-xs text-muted-foreground">Folio: <%= row[:folio_number] %></p>
                  </td>
                  <td class="whitespace-nowrap text-right font-semibold tabular-nums">MYR <%= number_with_precision(row[:booking_payment_amount], precision: 2) %></td>
                  <td class="whitespace-nowrap text-right font-semibold tabular-nums">MYR <%= number_with_precision(row[:earned_amount], precision: 2) %></td>
                  <td class="whitespace-nowrap text-right font-semibold tabular-nums">MYR <%= number_with_precision(row[:refund_amount], precision: 2) %></td>
                  <td class="whitespace-nowrap text-right font-semibold tabular-nums text-warning">MYR <%= number_with_precision(row[:remaining_liability], precision: 2) %></td>
                </tr>
              <% end %>
            <% else %>
              <%= render "table_empty_state", colspan: 8, message: "No deposit liabilities for this as-of date." %>
            <% end %>
          <% end %>
        <% end %>
      </div>
    <% end %>
  </section>
</div>
