<div class="w-full space-y-3.5">
  <div>
    <%= render PanelsUI::PageHeader.new(title: "Deposit Liability Report") do |header| %>
      <% header.with_caption do %>
        <p class="text-sm font-medium text-muted-foreground">
          <%= current_hotel.name %> · As of <%= @report.as_of_date.strftime("%A, %d %b %Y") %>
        </p>
      <% end %>
      <% header.with_actions do %>
        <%= render "preset_report_actions",
          form_url: deposit_liability_hotel_reports_path(current_hotel), form_id: "deposit-liability-date-form",
          date_preset: @date_preset, start_date: @report.as_of_date, end_date: @report.as_of_date, single_date: true,
          show_export: feature_enabled_for_hotel?("excel_pdf_export"), export_menu_id: "deposit-liability-export",
          export_items: [
            ["Export PDF", deposit_liability_hotel_reports_path(current_hotel, as_of_date: @report.as_of_date, date_preset: @date_preset, format: :pdf)],
            ["Export Excel", deposit_liability_hotel_reports_path(current_hotel, as_of_date: @report.as_of_date, date_preset: @date_preset, format: :xlsx)],
            ["Export CSV", deposit_liability_hotel_reports_path(current_hotel, as_of_date: @report.as_of_date, date_preset: @date_preset, format: :csv)]
          ] %>
      <% end %>
    <% end %>
  </div>

  <div class="grid grid-cols-1 overflow-hidden rounded-2xl border border-border bg-card shadow-sm md:grid-cols-5">
    <div class="p-6 md:border-r md:border-border">
      <p class="mb-2 text-[11px] font-semibold uppercase tracking-wider text-muted-foreground">Bookings</p>
      <h2 class="text-3xl font-bold tabular-nums tracking-tight text-foreground"><%= @report.totals[:booking_count] %></h2>
    </div>
    <div class="bg-amber-50/50 p-6 md:border-r md:border-border">
      <p class="mb-2 text-[11px] font-semibold uppercase tracking-wider text-amber-700">Booking Payments</p>
      <h2 class="text-2xl font-bold tabular-nums tracking-tight text-amber-900">MYR <%= number_with_precision(@report.totals[:booking_payment_amount], precision: 2) %></h2>
    </div>
    <div class="p-6 md:border-r md:border-border">
      <p class="mb-2 text-[11px] font-semibold uppercase tracking-wider text-muted-foreground">Earned</p>
      <h2 class="text-2xl font-bold tabular-nums tracking-tight text-foreground">MYR <%= number_with_precision(@report.totals[:earned_amount], precision: 2) %></h2>
    </div>
    <div class="bg-muted/50 p-6 md:border-r md:border-border">
      <p class="mb-2 text-[11px] font-semibold uppercase tracking-wider text-muted-foreground">Refunds</p>
      <h2 class="text-2xl font-bold tabular-nums tracking-tight text-foreground">MYR <%= number_with_precision(@report.totals[:refund_amount], precision: 2) %></h2>
    </div>
    <div class="bg-emerald-50/60 p-6">
      <p class="mb-2 text-[11px] font-semibold uppercase tracking-wider text-emerald-700">Remaining Liability</p>
      <h2 class="text-2xl font-bold tabular-nums tracking-tight text-emerald-900">MYR <%= number_with_precision(@report.totals[:remaining_liability], precision: 2) %></h2>
    </div>
  </div>

  <div class="rounded-2xl border border-amber-200 bg-amber-50 px-5 py-4 text-sm font-medium text-amber-950">
    This report only includes explicit <span class="font-bold">booking payment</span> folio payments. Security deposits are tracked separately and do not reduce folio balances unless applied later.
  </div>

  <div class="overflow-hidden rounded-2xl border border-border bg-card shadow-sm">
    <div class="overflow-x-auto">
      <% grouped_rows = @date_preset == "this_year" ? @report.rows.group_by { |row| row[:latest_deposit_posting_date].to_date.beginning_of_month } : { nil => @report.rows } %>
      <% grouped_rows.each do |month, rows| %>
        <% if month.present? %>
          <div class="border-b border-border bg-amber-50 px-6 py-3 text-sm font-bold text-amber-800"><%= month.strftime("%B %Y") %></div>
        <% end %>
      <table class="min-w-full">
        <thead class="bg-muted">
          <tr>
            <th class="px-6 py-4 text-left text-[11px] font-semibold uppercase tracking-[0.1em] text-muted-foreground">Guest / Ref</th>
            <th class="px-6 py-4 text-left text-[11px] font-semibold uppercase tracking-[0.1em] text-muted-foreground">Stay</th>
            <th class="px-6 py-4 text-left text-[11px] font-semibold uppercase tracking-[0.1em] text-muted-foreground">Status</th>
            <th class="px-6 py-4 text-left text-[11px] font-semibold uppercase tracking-[0.1em] text-muted-foreground">Rooms / Folio</th>
            <th class="px-6 py-4 text-right text-[11px] font-semibold uppercase tracking-[0.1em] text-muted-foreground">Booking Payment</th>
            <th class="px-6 py-4 text-right text-[11px] font-semibold uppercase tracking-[0.1em] text-muted-foreground">Earned</th>
            <th class="px-6 py-4 text-right text-[11px] font-semibold uppercase tracking-[0.1em] text-muted-foreground">Refunds</th>
            <th class="px-6 py-4 text-right text-[11px] font-semibold uppercase tracking-[0.1em] text-muted-foreground">Liability</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-border bg-card">
          <% if rows.any? %>
            <% rows.each do |row| %>
              <tr class="align-top transition hover:bg-amber-50/40">
                <td class="px-6 py-4 text-sm text-foreground">
                  <p class="font-semibold"><%= row[:guest_name] %></p>
                  <p class="text-xs text-muted-foreground"><%= row[:confirmation_token] %></p>
                </td>
                <td class="px-6 py-4 text-sm text-foreground"><%= row[:stay_dates] %></td>
                <td class="px-6 py-4 text-sm text-foreground"><%= row[:booking_status] %></td>
                <td class="px-6 py-4 text-sm text-foreground">
                  <p><%= row[:room_details] %></p>
                  <p class="text-xs text-muted-foreground">Folio: <%= row[:folio_number] %></p>
                </td>
                <td class="px-6 py-4 text-right text-sm font-semibold text-foreground">MYR <%= number_with_precision(row[:booking_payment_amount], precision: 2) %></td>
                <td class="px-6 py-4 text-right text-sm font-semibold text-foreground">MYR <%= number_with_precision(row[:earned_amount], precision: 2) %></td>
                <td class="px-6 py-4 text-right text-sm font-semibold text-foreground">MYR <%= number_with_precision(row[:refund_amount], precision: 2) %></td>
                <td class="px-6 py-4 text-right text-sm font-bold text-emerald-800">MYR <%= number_with_precision(row[:remaining_liability], precision: 2) %></td>
              </tr>
            <% end %>
          <% else %>
            <tr><td colspan="8" class="px-6 py-20 text-center text-sm font-medium text-muted-foreground">No deposit liabilities for this as-of date.</td></tr>
          <% end %>
        </tbody>
      </table>
      <% end %>
    </div>
  </div>
</div>
