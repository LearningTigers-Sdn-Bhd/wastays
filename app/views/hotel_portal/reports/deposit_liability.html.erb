<div class="max-w-[1600px] mx-auto pb-20 space-y-8">
  <div class="px-4 md:px-0">
    <div class="mt-5 flex flex-col gap-4 md:flex-row md:items-end md:justify-between">
      <div>
        <p class="mb-2 text-[11px] font-bold uppercase tracking-[0.18em] text-amber-700">Unearned Guest Funds</p>
        <h1 class="text-2xl font-bold tracking-tight text-slate-950 sm:text-3xl">Deposit Liability Report</h1>
        <p class="mt-1 text-sm font-medium text-slate-600">
          <%= current_hotel.name %> · As of <%= @report.as_of_date.strftime("%A, %d %b %Y") %>
        </p>
      </div>

      <%= form_with url: deposit_liability_hotel_reports_path(current_hotel), method: :get, local: true, class: "flex flex-col gap-3 md:flex-row md:items-end", id: "deposit-liability-date-form" do |f| %>
        <div>
          <label class="mb-2 block text-[11px] font-bold uppercase tracking-wider text-slate-500">As Of Date</label>
          <%= f.date_field :as_of_date, value: @report.as_of_date, class: "rounded-xl border border-slate-200 bg-white px-4 py-2.5 text-sm font-bold text-slate-700" %>
        </div>
        <details class="relative min-w-[170px]">
          <summary class="list-none inline-flex w-full cursor-pointer items-center justify-center rounded-xl border border-slate-200 bg-white px-4 py-2.5 text-sm font-bold text-slate-700 shadow-sm transition hover:border-slate-900 hover:bg-slate-50">
            <svg class="size-4 me-2" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
            Export
          </summary>
          <div class="absolute right-0 z-20 mt-2 w-44 overflow-hidden rounded-xl border border-slate-200 bg-white shadow-xl">
            <%= link_to "Export PDF", deposit_liability_hotel_reports_path(current_hotel, as_of_date: @report.as_of_date, format: :pdf), class: "block px-4 py-2.5 text-sm font-semibold text-slate-700 transition hover:bg-slate-50" %>
            <%= link_to "Export Excel", deposit_liability_hotel_reports_path(current_hotel, as_of_date: @report.as_of_date, format: :xls), class: "block border-t border-slate-100 px-4 py-2.5 text-sm font-semibold text-slate-700 transition hover:bg-slate-50" %>
            <%= link_to "Export CSV", deposit_liability_hotel_reports_path(current_hotel, as_of_date: @report.as_of_date, format: :csv), class: "block border-t border-slate-100 px-4 py-2.5 text-sm font-semibold text-slate-700 transition hover:bg-slate-50" %>
          </div>
        </details>
      <% end %>
    </div>
  </div>

  <div class="grid grid-cols-1 overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm md:grid-cols-5">
    <div class="p-6 md:border-r md:border-slate-200">
      <p class="mb-2 text-[11px] font-semibold uppercase tracking-wider text-slate-500">Bookings</p>
      <h2 class="text-3xl font-bold tabular-nums tracking-tight text-slate-950"><%= @report.totals[:booking_count] %></h2>
    </div>
    <div class="bg-amber-50/50 p-6 md:border-r md:border-slate-200">
      <p class="mb-2 text-[11px] font-semibold uppercase tracking-wider text-amber-700">Booking Payments</p>
      <h2 class="text-2xl font-bold tabular-nums tracking-tight text-amber-900">MYR <%= number_with_precision(@report.totals[:booking_payment_amount], precision: 2) %></h2>
    </div>
    <div class="p-6 md:border-r md:border-slate-200">
      <p class="mb-2 text-[11px] font-semibold uppercase tracking-wider text-slate-500">Earned</p>
      <h2 class="text-2xl font-bold tabular-nums tracking-tight text-slate-950">MYR <%= number_with_precision(@report.totals[:earned_amount], precision: 2) %></h2>
    </div>
    <div class="bg-slate-50/50 p-6 md:border-r md:border-slate-200">
      <p class="mb-2 text-[11px] font-semibold uppercase tracking-wider text-slate-500">Refunds</p>
      <h2 class="text-2xl font-bold tabular-nums tracking-tight text-slate-950">MYR <%= number_with_precision(@report.totals[:refund_amount], precision: 2) %></h2>
    </div>
    <div class="bg-emerald-50/60 p-6">
      <p class="mb-2 text-[11px] font-semibold uppercase tracking-wider text-emerald-700">Remaining Liability</p>
      <h2 class="text-2xl font-bold tabular-nums tracking-tight text-emerald-900">MYR <%= number_with_precision(@report.totals[:remaining_liability], precision: 2) %></h2>
    </div>
  </div>

  <div class="rounded-2xl border border-amber-200 bg-amber-50 px-5 py-4 text-sm font-medium text-amber-950">
    This report only includes explicit <span class="font-bold">booking payment</span> folio payments. Security deposits are tracked separately and do not reduce folio balances unless applied later.
  </div>

  <div class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">
    <div class="overflow-x-auto">
      <table class="min-w-full">
        <thead class="bg-slate-100">
          <tr>
            <th class="px-6 py-4 text-left text-[11px] font-semibold uppercase tracking-[0.1em] text-slate-600">Guest / Ref</th>
            <th class="px-6 py-4 text-left text-[11px] font-semibold uppercase tracking-[0.1em] text-slate-600">Stay</th>
            <th class="px-6 py-4 text-left text-[11px] font-semibold uppercase tracking-[0.1em] text-slate-600">Status</th>
            <th class="px-6 py-4 text-left text-[11px] font-semibold uppercase tracking-[0.1em] text-slate-600">Rooms / Folio</th>
            <th class="px-6 py-4 text-right text-[11px] font-semibold uppercase tracking-[0.1em] text-slate-600">Booking Payment</th>
            <th class="px-6 py-4 text-right text-[11px] font-semibold uppercase tracking-[0.1em] text-slate-600">Earned</th>
            <th class="px-6 py-4 text-right text-[11px] font-semibold uppercase tracking-[0.1em] text-slate-600">Refunds</th>
            <th class="px-6 py-4 text-right text-[11px] font-semibold uppercase tracking-[0.1em] text-slate-600">Liability</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-200 bg-white">
          <% if @report.rows.any? %>
            <% @report.rows.each do |row| %>
              <tr class="align-top transition hover:bg-amber-50/40">
                <td class="px-6 py-4 text-sm text-slate-900">
                  <p class="font-semibold"><%= row[:guest_name] %></p>
                  <p class="text-xs text-slate-500"><%= row[:confirmation_token] %></p>
                </td>
                <td class="px-6 py-4 text-sm text-slate-700"><%= row[:stay_dates] %></td>
                <td class="px-6 py-4 text-sm text-slate-700"><%= row[:booking_status] %></td>
                <td class="px-6 py-4 text-sm text-slate-700">
                  <p><%= row[:room_details] %></p>
                  <p class="text-xs text-slate-500">Folio: <%= row[:folio_number] %></p>
                </td>
                <td class="px-6 py-4 text-right text-sm font-semibold text-slate-900">MYR <%= number_with_precision(row[:booking_payment_amount], precision: 2) %></td>
                <td class="px-6 py-4 text-right text-sm font-semibold text-slate-900">MYR <%= number_with_precision(row[:earned_amount], precision: 2) %></td>
                <td class="px-6 py-4 text-right text-sm font-semibold text-slate-900">MYR <%= number_with_precision(row[:refund_amount], precision: 2) %></td>
                <td class="px-6 py-4 text-right text-sm font-bold text-emerald-800">MYR <%= number_with_precision(row[:remaining_liability], precision: 2) %></td>
              </tr>
            <% end %>
          <% else %>
            <tr><td colspan="8" class="px-6 py-20 text-center text-sm font-medium text-slate-500">No deposit liabilities for this as-of date.</td></tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
</div>

<script>
  (() => {
    const init = () => {
      const form = document.getElementById("deposit-liability-date-form");
      if (!form || form.dataset.bound === "true") return;
      form.dataset.bound = "true";

      const dateInput = form.querySelector('input[name="as_of_date"]');
      if (!dateInput) return;

      dateInput.addEventListener("change", () => form.requestSubmit());
    };

    document.addEventListener("turbo:load", init);
    document.addEventListener("DOMContentLoaded", init);
  })();
</script>
