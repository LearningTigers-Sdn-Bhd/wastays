<div class="space-y-5">
  <% bibo_sections(report).each do |section| %>
    <% heading_id = "#{section[:title].parameterize}-heading" %>
    <section class="space-y-3 print:space-y-3 print:break-inside-avoid" aria-labelledby="<%= heading_id %>">
      <h2 id="<%= heading_id %>" class="text-base font-semibold text-foreground"><%= section[:title] %></h2>

      <%= render PanelsUI::Table.new(
            caption: section[:title],
            density: :compact,
            header_style: :sentence,
            hoverable: true,
            class: "min-w-[720px] print:min-w-0 print:w-auto",
            wrapper_class: "rounded-lg border border-border bg-card print:overflow-visible"
          ) do |table| %>
        <% table.with_header do %>
          <tr>
            <th scope="col">Guest</th>
            <th scope="col">Room type</th>
            <th scope="col">Room</th>
            <th scope="col">Stay dates</th>
            <th scope="col">Boat time</th>
          </tr>
        <% end %>
        <% table.with_body do %>
          <% if section[:rows].any? %>
            <% section[:rows].each do |row| %>
              <tr>
                <th scope="row">
                  <div class="min-w-0">
                    <p class="font-semibold text-foreground"><%= row[:guest_name] %></p>
                    <p class="mt-1 font-mono text-xs text-muted-foreground"><%= row[:confirmation_token] %></p>
                  </div>
                </th>
                <td><%= row[:room_type] %></td>
                <td><%= row[:room_number] %></td>
                <td><%= row[:stay_dates] %></td>
                <td>
                  <%= render PanelsUI::Badge.new(label: row[:boat_time], variant: :neutral, size: :lg, shape: :rounded) %>
                </td>
              </tr>
            <% end %>
          <% else %>
            <%= render "table_empty_state", colspan: 5, message: section[:empty_message] %>
          <% end %>
        <% end %>
      <% end %>
    </section>
  <% end %>
</div>
