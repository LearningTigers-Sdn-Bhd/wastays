<%= render HotelPortal::Reports::MetricStrip.new(
      metrics: [
        { label: "Total cards", value: @grc_total_count.to_s, detail: "Selected period" },
        { label: "Signed", value: @grc_signed_count.to_s, detail: "Completed cards", detail_variant: :success },
        { label: "Draft", value: @grc_draft_count.to_s, detail: "Awaiting signature", detail_variant: :warning }
      ],
      aria_label: "Registration card summary"
    ) %>

<section class="rounded-lg border border-border bg-card p-3" aria-label="Registration card filters">
  <%= form_with url: form_url, method: :get,
        class: "flex flex-col gap-3 lg:flex-row lg:items-end",
        data: { controller: "auto-submit", turbo_frame: "grc_results", turbo_action: "advance" } do |form| %>
    <% hidden_fields.each do |name, value| %>
      <%= hidden_field_tag name, value %>
    <% end %>

    <%= render PanelsUI::FormField.new(
          form: form,
          attribute: :q,
          label: "Search",
          size: :sm,
          class: "w-full lg:flex-1"
        ) do |field| %>
      <% field.with_input(
           type: :search,
           value: @grc_query,
           placeholder: "Search GRC no, guest name, or booking ref…",
           data: { action: "input->auto-submit#submit" }) %>
    <% end %>

    <%= render PanelsUI::FormField.new(
          form: form,
          attribute: :status,
          label: "Status",
          size: :sm,
          class: "w-full sm:w-56"
        ) do |field| %>
      <% field.with_select_menu(
           [ [ "All", "" ], [ "Draft", "draft" ], [ "Signed", "signed" ] ],
           selected: @status_filter,
           data: { action: "change->auto-submit#submitNow" }) %>
    <% end %>
  <% end %>
</section>

<%= turbo_frame_tag "grc_results", class: "block" do %>
  <section class="space-y-3" aria-labelledby="registration-card-records-heading">
    <h2 id="registration-card-records-heading" class="text-base font-semibold text-foreground">Registration card records</h2>

    <%= render PanelsUI::Table.new(
          caption: "Guest registration cards",
          density: :compact,
          header_style: :sentence,
          hoverable: true,
          class: "min-w-[880px] print:min-w-0 print:w-auto",
          wrapper_class: "rounded-lg border border-border bg-card print:overflow-visible"
        ) do |table| %>
      <% table.with_header do %>
        <tr>
          <th scope="col">GRC no.</th>
          <th scope="col">Guest</th>
          <th scope="col">Stay</th>
          <th scope="col">Status</th>
          <th scope="col" class="text-right"><span class="sr-only">Action</span></th>
        </tr>
      <% end %>
      <% table.with_body do %>
        <% if @grc_cards.any? %>
          <% @grc_cards.each do |card| %>
            <% booking = card.booking %>
            <tr class="align-top">
              <th scope="row" class="whitespace-nowrap font-semibold text-foreground">
                <%= booking.guest_registration_card_number_display %>
              </th>
              <td>
                <p class="font-semibold text-foreground"><%= booking.guest_name %></p>
                <p class="mt-1 font-mono text-xs text-muted-foreground"><%= booking.confirmation_token %></p>
              </td>
              <td class="whitespace-nowrap text-foreground">
                <%= l(booking.check_in.to_date) %> → <%= l(booking.check_out.to_date) %>
              </td>
              <td class="whitespace-nowrap">
                <%= render PanelsUI::Badge.new(
                      label: card.status.titleize,
                      variant: card.signed? ? :success : :warning,
                      size: :lg,
                      shape: :rounded
                    ) %>
              </td>
              <td class="text-right">
                <div class="inline-flex items-center gap-2">
                  <%= link_to "View", hotel_booking_guest_registration_card_path(current_hotel, booking), class: "inline-flex rounded-lg border border-border px-3 py-2 text-sm font-semibold text-foreground hover:bg-muted focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-border-interactive", data: { turbo: false } %>
                  <%= link_to "Print / save as PDF", hotel_booking_guest_registration_card_path(current_hotel, booking), class: "inline-flex rounded-lg bg-primary px-3 py-2 text-sm font-semibold text-primary-foreground hover:bg-primary-hover focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-border-interactive", data: { turbo: false } %>
                </div>
              </td>
            </tr>
          <% end %>
        <% else %>
          <%= render "table_empty_state", colspan: 5, message: "No guest registration cards found." %>
        <% end %>
      <% end %>
    <% end %>

    <%= render "table_pagination", collection: @grc_cards %>
  </section>
<% end %>
