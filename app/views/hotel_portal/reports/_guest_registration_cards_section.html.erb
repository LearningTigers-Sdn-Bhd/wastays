<div class="grid grid-cols-1 gap-4 md:grid-cols-3">
  <div class="rounded-2xl border border-border bg-card p-6 shadow-sm">
    <p class="mb-2 text-[11px] font-semibold uppercase tracking-wider text-muted-foreground">Total Cards</p>
    <h2 class="text-2xl font-bold tracking-tight text-foreground"><%= @grc_total_count %></h2>
  </div>
  <div class="rounded-2xl border border-border bg-card p-6 shadow-sm">
    <p class="mb-2 text-[11px] font-semibold uppercase tracking-wider text-muted-foreground">Signed</p>
    <h2 class="text-2xl font-bold tracking-tight text-emerald-700"><%= @grc_signed_count %></h2>
  </div>
  <div class="rounded-2xl border border-border bg-card p-6 shadow-sm">
    <p class="mb-2 text-[11px] font-semibold uppercase tracking-wider text-muted-foreground">Draft</p>
    <h2 class="text-2xl font-bold tracking-tight text-amber-700"><%= @grc_draft_count %></h2>
  </div>
</div>

<div class="overflow-hidden rounded-2xl border border-border bg-card shadow-sm">
  <div class="border-b border-border bg-muted/50 px-6 py-5">
    <%= form_with url: form_url, method: :get, class: "flex flex-col gap-3 lg:flex-row lg:items-end", data: { controller: "auto-submit", turbo_frame: "grc_results", turbo_action: "advance" } do |f| %>
      <% hidden_fields.each do |name, value| %>
        <%= hidden_field_tag name, value %>
      <% end %>
      <div class="w-full lg:flex-1">
        <label class="mb-2 block text-[11px] font-bold uppercase tracking-wider text-muted-foreground">Search</label>
        <%= f.search_field :q, value: @grc_query, placeholder: "Search GRC no, guest name, or booking ref...", class: "w-full rounded-xl border border-border bg-card px-4 py-2.5 text-sm font-bold text-foreground shadow-sm", data: { action: "input->auto-submit#submit" } %>
      </div>
      <div class="w-full sm:w-56">
        <label class="mb-2 block text-[11px] font-bold uppercase tracking-wider text-muted-foreground">Status</label>
        <%= select_tag :status, options_for_select([ [ "All", "" ], [ "Draft", "draft" ], [ "Signed", "signed" ] ], @status_filter), class: "w-full rounded-xl border border-border bg-card px-4 py-2.5 text-sm font-bold text-foreground shadow-sm", data: { action: "change->auto-submit#submitNow" } %>
      </div>
    <% end %>
  </div>

  <%= turbo_frame_tag "grc_results" do %>
    <%= render PanelsUI::Table.new(
          caption: "Guest Registration Cards",
          hoverable: true,
          wrapper_class: "border-0 bg-transparent rounded-none"
        ) do |table| %>
      <% table.with_header do %>
        <tr>
          <th scope="col">GRC No.</th>
          <th scope="col">Guest</th>
          <th scope="col">Stay</th>
          <th scope="col">Status</th>
          <th scope="col" class="text-right"><span class="sr-only">Action</span></th>
        </tr>
      <% end %>
      <% table.with_body do %>
        <% if @grc_cards.any? %>
          <% @grc_cards.each do |card| %>
            <% booking = card.booking %>
            <tr>
              <th scope="row" class="font-black text-foreground">
                <%= booking.guest_registration_card_number_display %>
              </th>
              <td>
                <p class="font-semibold text-foreground"><%= booking.guest_name %></p>
                <p class="text-xs text-muted-foreground"><%= booking.confirmation_token %></p>
              </td>
              <td class="whitespace-nowrap text-foreground">
                <%= l(booking.check_in.to_date) %> -> <%= l(booking.check_out.to_date) %>
              </td>
              <td>
                <span class="inline-flex items-center rounded-full px-2.5 py-0.5 text-xs font-bold <%= card.signed? ? 'bg-emerald-50 text-emerald-700' : 'bg-amber-50 text-amber-700' %>">
                  <%= card.status.titleize %>
                </span>
              </td>
              <td class="text-right">
                <div class="inline-flex items-center gap-2">
                  <%= link_to "View", hotel_booking_guest_registration_card_path(current_hotel, booking), class: "inline-flex rounded-lg border border-border px-3 py-2 text-sm font-semibold text-foreground hover:bg-muted", data: { turbo: false } %>
                  <%= link_to "Print / Save as PDF", hotel_booking_guest_registration_card_path(current_hotel, booking), class: "inline-flex rounded-lg bg-primary px-3 py-2 text-sm font-semibold text-primary-foreground hover:bg-primary-hover", data: { turbo: false } %>
                </div>
              </td>
            </tr>
          <% end %>
        <% else %>
          <tr>
            <td colspan="5" class="h-32 text-center text-sm text-muted-foreground">
              No guest registration cards found.
            </td>
          </tr>
        <% end %>
      <% end %>
    <% end %>

    <div class="flex justify-center border-t border-border bg-muted/50 px-6 py-4 sm:px-8">
      <%= paginate @grc_cards if @grc_cards.respond_to?(:total_pages) %>
    </div>
  <% end %>
</div>
