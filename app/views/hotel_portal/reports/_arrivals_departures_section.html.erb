<div class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm print:rounded-none print:shadow-none print:break-inside-avoid">
  <div class="border-b border-slate-200 bg-slate-50/70 px-6 py-5 sm:px-8 print:bg-white print:px-3 print:py-2">
    <h2 class="text-lg font-bold tracking-tight text-slate-950 print:text-base"><%= title %></h2>
  </div>

  <div class="overflow-x-auto">
    <table class="min-w-full table-fixed print:table-auto">
      <thead class="bg-slate-100 print:bg-white">
        <tr>
          <th class="px-6 py-4 text-left text-[11px] font-semibold uppercase tracking-[0.1em] text-slate-600 sm:px-8 print:px-2 print:py-2">Guest / Ref</th>
          <th class="px-6 py-4 text-left text-[11px] font-semibold uppercase tracking-[0.1em] text-slate-600 print:px-2 print:py-2">Rooms</th>
          <th class="px-6 py-4 text-left text-[11px] font-semibold uppercase tracking-[0.1em] text-slate-600 print:px-2 print:py-2">Stay</th>
          <th class="px-6 py-4 text-left text-[11px] font-semibold uppercase tracking-[0.1em] text-slate-600 print:px-2 print:py-2"><%= type == :arrival ? "Readiness" : "Departure" %></th>
          <% if local_assigns[:show_boat_departure] %>
            <th class="px-6 py-4 text-left text-[11px] font-semibold uppercase tracking-[0.1em] text-slate-600 print:px-2 print:py-2">
              <%= type == :arrival ? "Boat-in" : "Boat-out" %>
            </th>
          <% end %>
          <th class="px-6 py-4 text-left text-[11px] font-semibold uppercase tracking-[0.1em] text-slate-600 sm:px-8 print:px-2 print:py-2">Notes</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-slate-200 bg-white">
        <% if rows.any? %>
          <% rows.each_with_index do |row, index| %>
            <tr class="<%= arrivals_departures_row_class(index) %>">
              <td class="px-6 py-4 sm:px-8 print:px-2 print:py-2">
                <p class="text-sm font-bold text-slate-900 print:text-xs"><%= row[:guest_name] %></p>
                <p class="mt-1 text-xs font-mono text-slate-500 print:text-[10px]"><%= row[:confirmation_token] %></p>
                <p class="mt-1 text-xs font-medium text-slate-500 print:text-[10px]"><%= row[:guest_count] %></p>
              </td>
              <td class="px-6 py-4 print:px-2 print:py-2">
                <p class="text-sm font-semibold text-slate-900 print:text-xs"><%= row[:room_details] %></p>
                <p class="mt-1 text-xs font-medium text-slate-500 print:text-[10px]">Room: <%= row[:room_numbers] %></p>
              </td>
              <td class="px-6 py-4 text-sm font-medium text-slate-700 print:px-2 print:py-2 print:text-xs"><%= row[:stay_dates] %></td>
              <td class="px-6 py-4 print:px-2 print:py-2">
                <% if type == :arrival %>
                  <p class="text-sm font-semibold text-slate-900 print:text-xs"><%= row[:pre_checkin_status] %></p>
                  <p class="mt-1 text-xs font-medium text-slate-500 print:text-[10px]"><%= row[:guarantee_status] %></p>
                <% else %>
                  <p class="text-sm font-semibold text-slate-900 print:text-xs"><%= row[:departure_status] %></p>
                <% end %>
              </td>
              <% if local_assigns[:show_boat_departure] %>
                <td class="px-6 py-4 print:px-2 print:py-2">
                  <% formatted = arrivals_departures_boat_time(row, type, current_hotel) %>
                  <% if formatted %>
                    <p class="text-sm font-semibold text-slate-900 print:text-xs"><%= formatted[:date] %></p>
                    <p class="mt-1 text-xs font-medium text-slate-500 print:text-[10px]"><%= formatted[:time] %></p>
                  <% else %>
                    <p class="text-sm font-semibold text-slate-900 print:text-xs">—</p>
                  <% end %>
                </td>
              <% end %>
              <td class="px-6 py-4 sm:px-8 print:px-2 print:py-2">
                <p class="text-sm text-slate-700 print:text-xs"><%= display_latest_note(row[:latest_note]) %></p>
              </td>
            </tr>
          <% end %>
        <% else %>
          <tr>
            <td colspan="<%= local_assigns[:show_boat_departure] ? 6 : 5 %>" class="px-6 py-16 text-center text-sm font-medium text-slate-500 sm:px-8 print:px-2 print:py-6 print:text-xs">
              <%= empty_message %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>
