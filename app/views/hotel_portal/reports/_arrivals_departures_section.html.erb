<section class="space-y-3 print:space-y-3 print:break-inside-avoid" aria-labelledby="guest-list-heading">
  <h2 id="guest-list-heading" class="text-base font-semibold text-foreground"><%= title %></h2>

  <%= render PanelsUI::Table.new(
        caption: title,
        density: :compact,
        header_style: :sentence,
        hoverable: true,
        class: "min-w-[960px] print:min-w-0 print:w-auto",
        wrapper_class: "rounded-lg border border-border bg-card print:overflow-visible"
      ) do |table| %>
    <% table.with_header do %>
      <tr>
        <th scope="col">Guest / ref</th>
        <th scope="col">Rooms</th>
        <th scope="col">Stay</th>
        <th scope="col"><%= type == :arrival ? "Readiness" : "Departure" %></th>
        <% if local_assigns[:show_boat_departure] %>
          <th scope="col">
            <%= type == :arrival ? "Boat arrival" : "Boat departure" %>
          </th>
        <% end %>
        <th scope="col">Notes</th>
      </tr>
    <% end %>
    <% table.with_body do %>
      <% if rows.any? %>
        <% report_rows_grouped_by_month(rows, date_preset: date_preset) { |row| type == :arrival ? row[:check_in] : row[:check_out] }.each do |month, period_rows| %>
          <% if month %>
            <tr class="bg-muted/55" data-slot="report-month-group">
              <th scope="rowgroup" colspan="<%= local_assigns[:show_boat_departure] ? 6 : 5 %>" class="text-xs font-semibold text-muted-foreground"><%= month.strftime("%B %Y") %></th>
            </tr>
          <% end %>
        <% period_rows.each do |row| %>
          <tr>
            <th scope="row">
              <div class="min-w-0">
                <p class="font-semibold text-foreground"><%= row[:guest_name] %></p>
                <p class="mt-1 font-mono text-xs text-muted-foreground"><%= row[:confirmation_token] %></p>
                <p class="mt-1 text-xs font-medium text-muted-foreground"><%= row[:guest_count] %></p>
              </div>
            </th>
            <td>
              <p class="font-semibold text-foreground"><%= row[:room_details] %></p>
              <p class="mt-1 text-xs text-muted-foreground">Room: <%= row[:room_numbers] %></p>
            </td>
            <td><%= row[:stay_dates] %></td>
            <td>
              <% if type == :arrival %>
                <p class="font-semibold text-foreground"><%= row[:pre_checkin_status] %></p>
                <p class="mt-1 text-xs text-muted-foreground"><%= row[:guarantee_status] %></p>
              <% else %>
                <p class="font-semibold text-foreground"><%= row[:departure_status] %></p>
              <% end %>
            </td>
            <% if local_assigns[:show_boat_departure] %>
              <td>
                <% formatted = arrivals_departures_boat_time(row, type, current_hotel) %>
                <% if formatted %>
                  <p class="font-semibold text-foreground"><%= formatted[:date] %></p>
                  <p class="mt-1 text-xs text-muted-foreground"><%= formatted[:time] %></p>
                <% else %>
                  <p class="font-semibold text-foreground">—</p>
                <% end %>
              </td>
            <% end %>
            <td>
              <p class="text-foreground"><%= row[:latest_note].presence || "-" %></p>
            </td>
          </tr>
        <% end %>
        <% end %>
      <% else %>
        <%= render "table_empty_state", colspan: (local_assigns[:show_boat_departure] ? 6 : 5), message: empty_message %>
      <% end %>
    <% end %>
  <% end %>
</section>
