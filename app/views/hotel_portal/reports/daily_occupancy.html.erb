<div class="w-full space-y-3.5">
  <div>
    <%= render PanelsUI::PageHeader.new(title: "Daily Occupancy Report") do |header| %>
      <% header.with_caption do %>
        <p class="text-sm font-medium text-muted-foreground">
          <%= current_hotel.name %> ·
          <% if @report.start_date == @report.end_date %>
            <%= @report.start_date.strftime("%A, %d %b %Y") %>
          <% else %>
            <%= @report.start_date.strftime("%d %b %Y") %> - <%= @report.end_date.strftime("%d %b %Y") %>
          <% end %>
        </p>
      <% end %>
      <% header.with_actions do %>
        <%= render "preset_report_actions",
          form_url: daily_occupancy_hotel_reports_path(current_hotel),
          form_id: "daily-occupancy-range-form",
          date_preset: @date_preset,
          start_date: @report.start_date,
          end_date: @report.end_date,
          export_menu_id: "daily-occupancy-export",
          export_items: [
            ["Export PDF", daily_occupancy_hotel_reports_path(current_hotel, start_date: @report.start_date, end_date: @report.end_date, date_preset: @date_preset, format: :pdf)],
            ["Export Excel", daily_occupancy_hotel_reports_path(current_hotel, start_date: @report.start_date, end_date: @report.end_date, date_preset: @date_preset, format: :xlsx)],
            ["Export CSV", daily_occupancy_hotel_reports_path(current_hotel, start_date: @report.start_date, end_date: @report.end_date, date_preset: @date_preset, format: :csv)]
          ] %>
      <% end %>
    <% end %>
  </div>

  <div class="grid grid-cols-1 overflow-hidden rounded-2xl border border-border bg-card shadow-sm md:grid-cols-4 lg:grid-cols-7">
    <div class="p-6 md:border-r md:border-border">
      <p class="mb-2 text-[11px] font-semibold uppercase tracking-wider text-muted-foreground">Rooms Sold</p>
      <h2 class="text-3xl font-bold tabular-nums tracking-tight text-foreground"><%= @report.totals[:rooms_sold] %></h2>
    </div>
    <div class="bg-muted/30 p-6 md:border-r md:border-border">
      <p class="mb-2 text-[11px] font-semibold uppercase tracking-wider text-muted-foreground">Rooms Available</p>
      <h2 class="text-3xl font-bold tabular-nums tracking-tight text-foreground"><%= @report.totals[:rooms_available] %></h2>
    </div>
    <div class="p-6 md:border-r md:border-border">
      <p class="mb-2 text-[11px] font-semibold uppercase tracking-wider text-muted-foreground">Occupancy</p>
      <h2 class="text-3xl font-bold tabular-nums tracking-tight text-foreground"><%= number_to_percentage(@report.totals[:occupancy_rate] * 100, precision: 2) %></h2>
    </div>
    <div class="bg-muted/30 p-6 md:border-r md:border-border">
      <p class="mb-2 text-[11px] font-semibold uppercase tracking-wider text-muted-foreground">Average Daily Rate (ADR)</p>
      <h2 class="text-3xl font-bold tabular-nums tracking-tight text-foreground">MYR <%= number_with_precision(@report.totals[:adr], precision: 2) %></h2>
    </div>
    <div class="p-6 md:border-r md:border-border">
      <p class="mb-2 text-[11px] font-semibold uppercase tracking-wider text-muted-foreground">Revenue per Available Room (RevPAR)</p>
      <h2 class="text-3xl font-bold tabular-nums tracking-tight text-foreground">MYR <%= number_with_precision(@report.totals[:revpar], precision: 2) %></h2>
    </div>
    <div class="bg-muted/30 p-6 md:border-r md:border-border">
      <p class="mb-2 text-[11px] font-semibold uppercase tracking-wider text-muted-foreground">Tax</p>
      <h2 class="text-3xl font-bold tabular-nums tracking-tight text-foreground">MYR <%= number_with_precision(@report.totals[:tax_amount], precision: 2) %></h2>
    </div>
    <div class="p-6">
      <p class="mb-2 text-[11px] font-semibold uppercase tracking-wider text-muted-foreground">Total Revenue</p>
      <h2 class="text-3xl font-bold tabular-nums tracking-tight text-foreground">MYR <%= number_with_precision(@report.totals[:total_revenue], precision: 2) %></h2>
    </div>
  </div>

  <div class="overflow-hidden rounded-2xl border border-border bg-card shadow-sm">
    <div class="overflow-x-auto">
      <table class="min-w-full">
        <thead class="bg-muted">
          <tr>
            <th class="px-6 py-4 text-left text-[11px] font-semibold uppercase tracking-[0.1em] text-muted-foreground"><%= @date_preset == "this_year" ? "Month" : "Date" %></th>
            <th class="px-6 py-4 text-left text-[11px] font-semibold uppercase tracking-[0.1em] text-muted-foreground">Rooms Sold</th>
            <th class="px-6 py-4 text-left text-[11px] font-semibold uppercase tracking-[0.1em] text-muted-foreground">Rooms Available</th>
            <th class="px-6 py-4 text-left text-[11px] font-semibold uppercase tracking-[0.1em] text-muted-foreground">Occupancy</th>
            <th class="px-6 py-4 text-left text-[11px] font-semibold uppercase tracking-[0.1em] text-muted-foreground">Room Revenue</th>
            <th class="px-6 py-4 text-left text-[11px] font-semibold uppercase tracking-[0.1em] text-muted-foreground">Average Daily Rate (ADR)</th>
            <th class="px-6 py-4 text-left text-[11px] font-semibold uppercase tracking-[0.1em] text-muted-foreground">Revenue per Available Room (RevPAR)</th>
            <th class="px-6 py-4 text-left text-[11px] font-semibold uppercase tracking-[0.1em] text-muted-foreground">Tax</th>
            <th class="px-6 py-4 text-left text-[11px] font-semibold uppercase tracking-[0.1em] text-muted-foreground">Total Revenue</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-border bg-card">
          <% if @report.rows.any? %>
            <% @report.rows.each do |row| %>
              <tr>
                <td class="px-6 py-4 text-sm font-semibold text-foreground"><%= @date_preset == "this_year" ? row[:date].strftime("%B %Y") : row[:date].strftime("%d %b %Y") %></td>
                <td class="px-6 py-4 text-sm text-foreground"><%= row[:rooms_sold] %></td>
                <td class="px-6 py-4 text-sm text-foreground"><%= row[:rooms_available] %></td>
                <td class="px-6 py-4 text-sm text-foreground"><%= number_to_percentage(row[:occupancy_rate] * 100, precision: 2) %></td>
                <td class="px-6 py-4 text-sm text-foreground">MYR <%= number_with_precision(row[:room_revenue], precision: 2) %></td>
                <td class="px-6 py-4 text-sm text-foreground">MYR <%= number_with_precision(row[:adr], precision: 2) %></td>
                <td class="px-6 py-4 text-sm text-foreground">MYR <%= number_with_precision(row[:revpar], precision: 2) %></td>
                <td class="px-6 py-4 text-sm text-foreground">MYR <%= number_with_precision(row[:tax_amount], precision: 2) %></td>
                <td class="px-6 py-4 text-sm text-foreground font-semibold">MYR <%= number_with_precision(row[:total_revenue], precision: 2) %></td>
              </tr>
            <% end %>
          <% else %>
            <tr><td colspan="9" class="px-6 py-20 text-center text-sm font-medium text-muted-foreground">No occupancy data for this selected period.</td></tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
</div>
