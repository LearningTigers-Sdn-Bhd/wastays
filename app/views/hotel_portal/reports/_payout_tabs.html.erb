<div class="rounded-xl border border-border bg-card p-1.5 shadow-sm" data-testid="payout-tabs">
  <nav class="flex items-center gap-1 overflow-x-auto" aria-label="Payout sections" role="tablist">
    <button type="button"
            data-tabs-target="tab"
            data-tab-name="upcoming"
            data-tab-label="Upcoming & Processing"
            data-action="click->tabs#switch"
            data-active="<%= @active_tab == "upcoming" %>"
            class="group inline-flex h-9 items-center gap-2 whitespace-nowrap rounded-lg px-4 text-sm font-medium text-muted-foreground transition-all duration-150 hover:bg-muted hover:text-foreground data-[active=true]:bg-blue-600 data-[active=true]:font-semibold data-[active=true]:text-primary-foreground"
            aria-controls="upcoming-panel"
            role="tab">
      <%= cached_icon "clock-3", class: "size-4", aria: { hidden: true } %>
      <span>Upcoming & Processing</span>
    </button>

    <button type="button"
            data-tabs-target="tab"
            data-tab-name="paid"
            data-tab-label="Paid History"
            data-action="click->tabs#switch"
            data-active="<%= @active_tab == "paid" %>"
            class="group inline-flex h-9 items-center gap-2 whitespace-nowrap rounded-lg px-4 text-sm font-medium text-muted-foreground transition-all duration-150 hover:bg-muted hover:text-foreground data-[active=true]:bg-blue-600 data-[active=true]:font-semibold data-[active=true]:text-primary-foreground"
            aria-controls="paid-panel"
            role="tab">
      <%= cached_icon "history", class: "size-4", aria: { hidden: true } %>
      <span>Paid History</span>
      <span class="rounded-full bg-muted px-1.5 py-0.5 text-[10px] font-bold text-muted-foreground transition-colors duration-150 group-data-[active=true]:bg-card/20 group-data-[active=true]:text-primary-foreground">
        <%= @payout_history.total_count %>
      </span>
    </button>
  </nav>
</div>
