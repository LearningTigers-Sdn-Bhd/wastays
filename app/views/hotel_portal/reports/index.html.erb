<div class="w-full space-y-8">
  <%= render PanelsUI::PageHeader.new(title: "Financial Summary", description: "Review your earnings and booking activity.") do |header| %>
    <% header.with_actions do %>
      <div class="inline-flex gap-x-2">
        <%= render PanelsUI::Button.new(href: breakdown_hotel_reports_path(current_hotel, start_date: @start_date, end_date: @end_date, date_preset: @date_preset), data: { turbo: false }) do %>
          <svg class="size-4 me-2" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M3 3v18h18"/><path d="M7 14v4"/><path d="M12 10v8"/><path d="M17 6v12"/></svg>
          View Breakdown
        <% end %>
      </div>
    <% end %>
  <% end %>

  <%= turbo_frame_tag "reports_content", class: "block space-y-8" do %>
    <!-- Integrated Stats Grid (Dashboard Style) -->
    <div class="grid grid-cols-1 overflow-hidden rounded-2xl border border-border bg-card shadow-sm md:grid-cols-3">
      <div class="p-8 md:border-r md:border-border">
        <p class="mb-2 text-[11px] font-semibold uppercase tracking-wider text-muted-foreground">Gross Bookings</p>
        <h2 class="text-3xl font-bold tabular-nums tracking-tight text-foreground">MYR <%= number_with_delimiter(number_with_precision(@total_gross, precision: 2)) %></h2>
        <p class="mt-2 text-sm font-medium text-muted-foreground">Total gross sales before commission</p>
      </div>

      <div class="bg-muted/30 p-8 md:border-r md:border-border">
        <p class="mb-2 text-[11px] font-semibold uppercase tracking-wider text-muted-foreground">Net Earnings</p>
        <h2 class="text-3xl font-bold tabular-nums tracking-tight text-emerald-700">MYR <%= number_with_delimiter(number_with_precision(@total_net, precision: 2)) %></h2>
        <p class="mt-2 text-sm font-medium text-muted-foreground">Total settlement amount after commission</p>
      </div>

      <div class="p-8">
        <p class="mb-2 text-[11px] font-semibold uppercase tracking-wider text-muted-foreground">Total Reservations</p>
        <h2 class="text-3xl font-bold tabular-nums tracking-tight text-foreground"><%= @booking_count %></h2>
        <p class="mt-2 text-sm font-medium text-muted-foreground">Total reservations processed in period</p>
      </div>
    </div>

    <!-- Daily Performance Section -->
    <div class="overflow-hidden rounded-2xl border border-border bg-card shadow-sm">
      <div class="border-b border-border bg-muted/50 px-8 py-6">
        <%= form_with url: hotel_reports_path, method: :get, class: "flex flex-col gap-4 lg:flex-row lg:items-end lg:justify-between", data: { controller: "auto-submit date-preset", turbo_frame: "reports_content" } do |f| %>
          <%= hidden_field_tag :q, params[:q] if params[:q].present? %>
          <div class="flex flex-col gap-4 lg:flex-row lg:items-end flex-1">
            <%= render PanelsUI::FormField.new(form: f, attribute: :date_preset, label: "Time Period", class: "w-full lg:w-64") do |field| %>
              <% field.with_select_menu(date_preset_options, selected: @date_preset, data: { action: "change->date-preset#toggleCustom" }) %>
            <% end %>

            <div id="custom-date-range" class="<%= @date_preset == 'custom' ? 'flex' : 'hidden' %> w-full max-w-md items-end animate-in fade-in slide-in-from-left-2 duration-300">
              <%= render PanelsUI::FormField.new(form: f, attribute: :date_range, label: "Date Range", label_hidden: true) do |field| %>
                <% field.with_date_picker(
                     range: true,
                     months: 2,
                     responsive_months: true,
                     value: "#{@start_date.iso8601}/#{@end_date.iso8601}",
                     placeholder: "Date range",
                     data: { action: "change->date-preset#submitDate" }) %>
              <% end %>
            </div>
          </div>

          <div class="hidden lg:flex lg:items-center">
            <% if feature_enabled_for_hotel?("excel_pdf_export") %>
              <%= render "export_dropdown", menu_id: "financial-summary-export", items: [
                ["Export PDF", hotel_reports_path(current_hotel, start_date: @start_date, end_date: @end_date, q: params[:q], date_preset: @date_preset, format: :pdf)],
                ["Export Excel", hotel_reports_path(current_hotel, start_date: @start_date, end_date: @end_date, q: params[:q], date_preset: @date_preset, format: :xls)],
                ["Export CSV", hotel_reports_path(current_hotel, start_date: @start_date, end_date: @end_date, q: params[:q], date_preset: @date_preset, format: :csv)]
              ] %>
            <% end %>
          </div>
        <% end %>
      </div>

      <div class="px-8 py-6 border-b border-border">
        <h2 class="text-lg font-bold tracking-tight text-foreground sm:text-xl">Daily Performance Snapshot</h2>
        <p class="mt-1 text-sm font-medium text-muted-foreground">A detailed breakdown of revenue and volume across the selected range.</p>
      </div>

      <div class="overflow-x-auto">
        <table class="min-w-full table-fixed">
          <colgroup>
            <col class="w-[22%]">
            <col class="w-[15%]">
            <col class="w-[21%]">
            <col class="w-[18%]">
            <col class="w-[24%]">
          </colgroup>
          <thead class="bg-muted">
            <tr>
              <th scope="col" class="px-8 py-4 text-left text-[11px] font-semibold uppercase tracking-[0.1em] text-muted-foreground">Date</th>
              <th scope="col" class="px-8 py-4 text-left text-[11px] font-semibold uppercase tracking-[0.1em] text-muted-foreground">Bookings</th>
              <th scope="col" class="px-8 py-4 text-left text-[11px] font-semibold uppercase tracking-[0.1em] text-muted-foreground">Gross</th>
              <th scope="col" class="px-8 py-4 text-left text-[11px] font-semibold uppercase tracking-[0.1em] text-muted-foreground">Margin</th>
              <th scope="col" class="px-8 py-4 text-right text-[11px] font-semibold uppercase tracking-[0.1em] text-muted-foreground">Net</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-border bg-card">
            <% if @paginated_daily_data.any? %>
              <% @paginated_daily_data.each_with_index do |(date, gross), index| %>
                <%
                  daily_bookings = @base_bookings.select { |b| b.created_at.to_date == date }
                  daily_margin = daily_bookings.sum { |b| b.margin_amount || 0 }
                  daily_net = daily_bookings.sum { |b| b.net_amount || 0 }
                  date_key = date.strftime("%Y%m%d")
                %>
                <tr class="group align-top transition-colors hover:bg-muted/80 cursor-pointer <%= index.even? ? 'bg-card' : 'bg-muted/55' %>" onclick="document.getElementById('daily-performance-modal-<%= date_key %>').showModal()">
                  <td class="px-8 py-5">
                    <div class="flex flex-col">
                      <span class="text-sm font-bold text-foreground"><%= date.strftime("%d %b %Y") %></span>
                      <span class="text-[10px] font-medium text-muted-foreground"><%= date.strftime("%A") %></span>
                    </div>
                  </td>
                  <td class="px-8 py-5 text-sm text-foreground font-medium">
                    <%= daily_bookings.count %>
                  </td>
                  <td class="px-8 py-5 text-sm font-bold text-foreground">
                    MYR <%= number_with_delimiter(number_with_precision(gross, precision: 2)) %>
                  </td>
                  <td class="px-8 py-5 text-sm font-bold text-red-500/80">
                    - <%= number_with_delimiter(number_with_precision(daily_margin, precision: 2)) %>
                  </td>
                  <td class="px-8 py-5 text-right whitespace-nowrap">
                    <div class="flex items-center justify-end gap-3">
                      <span class="text-sm font-black text-emerald-700">MYR <%= number_with_delimiter(number_with_precision(daily_net, precision: 2)) %></span>
                      <svg class="size-4 text-primary-foreground group-hover:text-foreground transition-colors" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg>
                    </div>
                  </td>
                </tr>

                <dialog id="daily-performance-modal-<%= date_key %>" class="fixed inset-0 m-auto w-[min(94vw,64rem)] rounded-3xl p-0 shadow-2xl backdrop:bg-primary/60 transition-all" onclick="if(event.target===this){this.close()}">
                  <div class="max-h-[85vh] overflow-hidden flex flex-col bg-card" onclick="event.stopPropagation()">
                    <div class="sticky top-0 z-10 flex items-center justify-between border-b border-border bg-card px-8 py-6">
                      <div>
                        <p class="text-[10px] font-bold uppercase tracking-wider text-muted-foreground">Daily Ledger</p>
                        <h3 class="text-2xl font-bold text-foreground mt-1"><%= date.strftime("%A, %d %b %Y") %></h3>
                      </div>
                      <button type="button" class="size-10 flex items-center justify-center rounded-full bg-muted text-muted-foreground hover:bg-muted hover:text-foreground transition" onclick="this.closest('dialog').close()">
                        <svg class="size-5" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg>
                      </button>
                    </div>

                    <div class="grid grid-cols-2 gap-px bg-muted border-b border-border md:grid-cols-4">
                      <div class="bg-card p-8">
                        <p class="text-[10px] font-bold uppercase tracking-widest text-muted-foreground mb-1">Volume</p>
                        <p class="text-xl font-bold text-foreground"><%= daily_bookings.count %></p>
                      </div>
                      <div class="bg-card p-8">
                        <p class="text-[10px] font-bold uppercase tracking-widest text-muted-foreground mb-1">Gross Sale</p>
                        <p class="text-xl font-bold text-foreground">MYR <%= number_with_precision(gross, precision: 2) %></p>
                      </div>
                      <div class="bg-card p-8">
                        <p class="text-[10px] font-bold uppercase tracking-widest text-muted-foreground mb-1">Commission</p>
                        <p class="text-xl font-bold text-red-600">- <%= number_with_precision(daily_margin, precision: 2) %></p>
                      </div>
                      <div class="bg-card p-8">
                        <p class="text-[10px] font-bold uppercase tracking-widest text-muted-foreground mb-1">Settlement</p>
                        <p class="text-xl font-bold text-emerald-700">MYR <%= number_with_precision(daily_net, precision: 2) %></p>
                      </div>
                    </div>

                    <div class="flex-1 overflow-y-auto custom-scrollbar bg-muted/50 p-8">
                      <div class="space-y-4">
                        <% if daily_bookings.any? %>
                          <% daily_bookings.each do |booking| %>
                            <div class="group relative bg-card border border-border rounded-2xl p-6 shadow-sm transition hover:border-border-interactive hover:shadow-md">
                              <div class="flex flex-col gap-6 md:flex-row md:items-start md:justify-between">
                                <div class="flex-1">
                                  <div class="flex items-center gap-3 mb-2">
                                    <span class="text-sm font-mono font-bold text-foreground bg-muted px-2 py-0.5 rounded">#<%= booking.confirmation_token %></span>
                                    <span class="text-sm font-bold text-foreground"><%= booking.guest_name %></span>
                                  </div>
                                  <p class="text-xs font-bold text-muted-foreground uppercase tracking-tight"><%= booking.guest_email %> · <%= booking.guest_phone %></p>

                                  <div class="mt-4 flex items-center gap-2">
                                     <div class="px-3 py-1.5 rounded-xl bg-muted border border-border flex items-center gap-2">
                                        <svg class="size-3.5 text-muted-foreground" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="18" x="3" y="4" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
                                        <span class="text-xs font-bold text-muted-foreground">
                                          <%= booking.check_in&.strftime("%d %b") %> — <%= booking.check_out&.strftime("%d %b %Y") %>
                                        </span>
                                     </div>
                                  </div>
                                </div>

                                <div class="text-left md:text-right border-t border-border pt-4 md:border-0 md:pt-0">
                                  <p class="text-[10px] font-bold uppercase tracking-wider text-muted-foreground mb-1">Net Settlement</p>
                                  <p class="text-xl font-bold text-foreground">MYR <%= number_with_precision(booking.net_amount, precision: 2) %></p>
                                  <%= link_to hotel_booking_control_panel_path(current_hotel, booking, tab: "booking_details"), class: "mt-4 inline-flex items-center text-xs font-bold text-foreground uppercase tracking-widest border-b-2 border-border-interactive pb-0.5 hover:text-blue-600 hover:border-blue-600 transition-all", data: { turbo: false } do %>
                                    Details
                                    <svg class="ms-1 size-3" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg>
                                  <% end %>
                                </div>
                              </div>

                              <% if booking.booking_rooms.any? %>
                                <div class="mt-6 pt-6 border-t border-border flex flex-wrap gap-2">
                                  <% booking.booking_rooms.each do |room| %>
                                    <% room_name = room.room_type_snapshot.is_a?(Hash) ? room.room_type_snapshot["name"].presence : nil %>
                                    <% room_name = room_name.presence || room.room_type&.name || "Room" %>
                                    <span class="inline-flex items-center rounded-lg bg-muted border border-border px-3 py-1.5 text-[10px] font-bold text-muted-foreground uppercase">
                                      <span class="text-foreground mr-2">1x</span> <%= room_name %>
                                    </span>
                                  <% end %>
                                </div>
                              <% end %>
                            </div>
                          <% end %>
                        <% else %>
                          <div class="py-20 text-center">
                            <div class="size-16 rounded-full bg-muted flex items-center justify-center mx-auto mb-4">
                               <svg class="size-8 text-primary-foreground" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14.5 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7.5L14.5 2z"/><polyline points="14 2 14 8 20 8"/></svg>
                            </div>
                            <p class="text-sm font-bold text-muted-foreground uppercase tracking-widest">No entries found</p>
                          </div>
                        <% end %>
                      </div>
                    </div>
                  </div>
                </dialog>
              <% end %>
            <% else %>
              <tr>
                <td colspan="5" class="px-8 py-24 text-center sm:px-8">
                  <div class="flex flex-col items-center">
                    <p class="text-sm font-bold text-muted-foreground uppercase tracking-wider">No financial data</p>
                    <p class="mt-2 text-sm font-medium text-muted-foreground">Try selecting a different time period.</p>
                  </div>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>

      <div class="px-8 py-5 border-t border-border bg-muted/50 flex justify-center">
        <%= paginate @paginated_daily_data %>
      </div>
    </div>
  <% end %>
</div>

<script>
  // Simple listener to show/hide custom date range if needed between turbo loads
  document.addEventListener('change', function(e) {
    if (e.target && e.target.name === 'date_preset') {
      const customRange = document.getElementById('custom-date-range');
      if (!customRange) return;
      if (e.target.value === 'custom') {
        customRange.classList.remove('hidden');
        customRange.classList.add('flex');
      } else {
        customRange.classList.add('hidden');
        customRange.classList.remove('flex');
      }
    }
  });
</script>
