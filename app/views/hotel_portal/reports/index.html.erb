<div class="max-w-[85rem] px-4 py-10 sm:px-6 lg:px-8 lg:py-14 mx-auto">
  <!-- Header -->
  <div class="flex flex-col md:flex-row justify-between items-center mb-8 gap-4">
    <div>
      <h1 class="text-3xl font-bold text-gray-800">Financial Performance</h1>
      <p class="text-sm text-gray-600">Review your earnings and booking activity.</p>
    </div>

    <div class="inline-flex gap-x-2">
      <%= link_to breakdown_hotel_reports_path(current_hotel, start_date: @start_date, end_date: @end_date, date_preset: @date_preset), class: "py-2 px-3 inline-flex items-center gap-x-2 text-sm font-semibold rounded-lg border border-gray-200 bg-white text-gray-800 shadow-sm hover:bg-gray-50 focus:outline-none focus:bg-gray-50", data: { turbo: false } do %>
        <svg class="size-4" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
        View Breakdown
      <% end %>
    </div>
  </div>

  <%= turbo_frame_tag "reports_content" do %>
    <!-- Quick Stats -->
    <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-4 sm:gap-6 mb-8">
      <!-- Card -->
      <div class="flex flex-col bg-white border border-gray-200 rounded-xl shadow-sm">
        <div class="p-4 md:p-5">
          <p class="text-xs uppercase tracking-wide text-gray-500">Gross Bookings</p>
          <div class="mt-1 flex items-center gap-x-2">
            <h3 class="text-xl sm:text-2xl font-medium text-gray-800"><%= number_to_currency(@total_gross, unit: "MYR ", precision: 2) %></h3>
          </div>
        </div>
      </div>

      <!-- Card -->
      <div class="flex flex-col bg-blue-50 border border-blue-200 rounded-xl shadow-sm">
        <div class="p-4 md:p-5">
          <p class="text-xs uppercase tracking-wide text-blue-600 font-bold">Net Earnings</p>
          <div class="mt-1 flex items-center gap-x-2">
            <h3 class="text-xl sm:text-2xl font-bold text-blue-800"><%= number_to_currency(@total_net, unit: "MYR ", precision: 2) %></h3>
          </div>
        </div>
      </div>

      <!-- Card -->
      <div class="flex flex-col bg-white border border-gray-200 rounded-xl shadow-sm">
        <div class="p-4 md:p-5">
          <p class="text-xs uppercase tracking-wide text-gray-500">Booking Count</p>
          <div class="mt-1 flex items-center gap-x-2">
            <h3 class="text-xl sm:text-2xl font-medium text-gray-800"><%= @booking_count %></h3>
          </div>
        </div>
      </div>
    </div>

    <!-- Time Period Filter -->
    <div class="bg-white border border-gray-200 rounded-xl p-4 md:p-6 mb-6 shadow-sm">
      <%= form_with url: hotel_reports_path, method: :get, class: "space-y-4", data: { controller: "auto-submit", turbo_frame: "reports_content" } do |f| %>
        <div class="grid grid-cols-1 md:grid-cols-8 gap-4 items-end">
          <div class="md:col-span-3">
            <label class="block text-xs font-bold text-gray-500 uppercase mb-1">Time Period</label>
            <%= f.select :date_preset, options_for_select(date_preset_options, @date_preset), {}, class: "form-select py-2 px-3 text-sm", data: { action: "change->auto-submit#submitNow" } %>
          </div>

          <div id="custom-date-range" class="<%= @date_preset == 'custom' ? 'grid' : 'hidden' %> md:col-span-5 grid-cols-2 gap-2">
            <div>
              <label class="block text-[10px] font-bold text-gray-400 uppercase mb-1">From</label>
              <%= f.date_field :start_date, value: @start_date, class: "form-input py-2 px-2 text-xs", data: { action: "change->auto-submit#submitNow" } %>
            </div>
            <div>
              <label class="block text-[10px] font-bold text-gray-400 uppercase mb-1">To</label>
              <%= f.date_field :end_date, value: @end_date, class: "form-input py-2 px-2 text-xs", data: { action: "change->auto-submit#submitNow" } %>
            </div>
          </div>
        </div>
      <% end %>
    </div>

    <!-- Details Table -->
    <div class="bg-white border border-gray-200 rounded-xl shadow-sm overflow-hidden">
      <div class="px-6 py-4 border-b border-gray-200 bg-gray-50">
        <h2 class="text-lg font-semibold text-gray-800">Daily Performance Snapshot</h2>
      </div>
      <table class="min-w-full divide-y divide-gray-200">
        <thead class="bg-gray-50">
          <tr>
            <th scope="col" class="px-6 py-3 text-start text-xs font-semibold uppercase text-gray-800">Date</th>
            <th scope="col" class="px-6 py-3 text-start text-xs font-semibold uppercase text-gray-800">Bookings</th>
            <th scope="col" class="px-6 py-3 text-start text-xs font-semibold uppercase text-gray-800">Gross</th>
            <th scope="col" class="px-6 py-3 text-start text-xs font-semibold uppercase text-gray-800">Margin</th>
            <th scope="col" class="px-6 py-3 text-start text-xs font-semibold uppercase text-gray-800">Net</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-gray-200">
          <% if @daily_data.any? %>
            <% @daily_data.each do |date, gross| %>
              <% 
                daily_bookings = @base_bookings.select { |b| b.created_at.to_date == date }
                daily_margin = daily_bookings.sum { |b| b.margin_amount || 0 }
                daily_net = daily_bookings.sum { |b| b.net_amount || 0 }
                date_key = date.strftime("%Y%m%d")
              %>
              <tr class="cursor-pointer transition-colors hover:bg-slate-50" onclick="document.getElementById('daily-performance-modal-<%= date_key %>').showModal()">
                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-800 font-medium"><%= date.strftime("%d %b %Y") %></td>
                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-800"><%= daily_bookings.count %></td>
                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-800"><%= number_to_currency(gross, unit: "MYR ", precision: 2) %></td>
                <td class="px-6 py-4 whitespace-nowrap text-sm text-red-600">- <%= number_with_delimiter(number_with_precision(daily_margin, precision: 2)) %></td>
                <td class="px-6 py-4 whitespace-nowrap text-sm font-bold text-gray-800"><%= number_to_currency(daily_net, unit: "MYR ", precision: 2) %></td>
              </tr>
              <dialog id="daily-performance-modal-<%= date_key %>" class="fixed inset-0 m-auto w-[min(94vw,64rem)] rounded-2xl p-0 backdrop:bg-black/40" onclick="if(event.target===this){this.close()}">
                <div class="max-h-[85vh] overflow-y-auto bg-white">
                  <div class="sticky top-0 z-10 flex items-center justify-between border-b border-gray-200 bg-white px-5 py-4">
                    <div>
                      <p class="text-xs font-semibold uppercase tracking-wide text-gray-500">Daily Performance Snapshot</p>
                      <h3 class="text-lg font-bold text-gray-900"><%= date.strftime("%A, %d %b %Y") %></h3>
                    </div>
                    <button type="button" class="rounded-lg border border-gray-200 bg-white px-3 py-1.5 text-sm font-semibold text-gray-700 hover:bg-gray-50" onclick="this.closest('dialog').close()">Close</button>
                  </div>

                  <div class="grid grid-cols-1 gap-3 border-b border-gray-100 bg-slate-50 px-5 py-4 md:grid-cols-4">
                    <div>
                      <p class="text-[11px] font-semibold uppercase tracking-wide text-gray-500">Bookings</p>
                      <p class="mt-1 text-sm font-bold text-gray-900"><%= daily_bookings.count %></p>
                    </div>
                    <div>
                      <p class="text-[11px] font-semibold uppercase tracking-wide text-gray-500">Gross</p>
                      <p class="mt-1 text-sm font-bold text-gray-900"><%= number_to_currency(gross, unit: "MYR ", precision: 2) %></p>
                    </div>
                    <div>
                      <p class="text-[11px] font-semibold uppercase tracking-wide text-gray-500">Margin</p>
                      <p class="mt-1 text-sm font-bold text-red-600">- <%= number_with_delimiter(number_with_precision(daily_margin, precision: 2)) %></p>
                    </div>
                    <div>
                      <p class="text-[11px] font-semibold uppercase tracking-wide text-gray-500">Net</p>
                      <p class="mt-1 text-sm font-bold text-emerald-700"><%= number_to_currency(daily_net, unit: "MYR ", precision: 2) %></p>
                    </div>
                  </div>

                  <div class="space-y-3 px-5 py-4">
                    <% daily_bookings.each do |booking| %>
                      <div class="rounded-xl border border-gray-200 bg-white p-4">
                        <div class="flex flex-col gap-3 md:flex-row md:items-start md:justify-between">
                          <div>
                            <p class="text-sm font-bold text-gray-900"><%= booking.confirmation_token %> · <%= booking.guest_name %></p>
                            <p class="mt-1 text-xs text-gray-500"><%= booking.guest_email %> · <%= booking.guest_phone %></p>
                            <p class="mt-1 text-xs text-gray-500">Stay: <%= booking.check_in&.strftime("%d %b %Y") %> → <%= booking.check_out&.strftime("%d %b %Y") %></p>
                          </div>
                          <div class="text-left md:text-right">
                            <p class="text-xs font-semibold uppercase tracking-wide text-gray-500">Net Payout</p>
                            <p class="mt-1 text-sm font-bold text-gray-900">MYR <%= number_with_precision(booking.net_amount, precision: 2) %></p>
                            <%= link_to "Open booking", hotel_booking_path(current_hotel, booking), class: "mt-2 inline-flex items-center text-xs font-semibold text-brand-primary hover:text-red-700" %>
                          </div>
                        </div>

                        <% if booking.booking_rooms.any? %>
                          <div class="mt-3 border-t border-gray-100 pt-3">
                            <p class="text-[11px] font-semibold uppercase tracking-wide text-gray-500">Room Details</p>
                            <div class="mt-2 space-y-1.5">
                              <% booking.booking_rooms.each do |room| %>
                                <% room_name = room.room_type_snapshot.is_a?(Hash) ? room.room_type_snapshot["name"].presence : nil %>
                                <% room_name = room_name.presence || room.room_type&.name || "Room" %>
                                <p class="text-sm text-gray-700"><span class="font-semibold text-gray-900"><%= room.quantity %>x</span> <%= room_name %></p>
                              <% end %>
                            </div>
                          </div>
                        <% end %>
                      </div>
                    <% end %>
                  </div>
                </div>
              </dialog>
            <% end %>
          <% else %>
            <tr>
              <td colspan="5" class="px-6 py-10 text-center text-sm text-gray-500 italic">
                No financial data for this period.
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% end %>
</div>

<script>
  document.querySelector('select[name="date_preset"]')?.addEventListener('change', function(e) {
    const customRange = document.getElementById('custom-date-range');
    if (!customRange) return;
    if (e.target.value === 'custom') {
      customRange.classList.remove('hidden');
      customRange.classList.add('grid');
    } else {
      customRange.classList.add('hidden');
      customRange.classList.remove('grid');
    }
  });
</script>
