<div class="w-full space-y-4" data-slot="report-page" data-report="reports-summary">
  <%= turbo_frame_tag "reports_content", class: "block space-y-4" do %>
    <%= render PanelsUI::PageHeader.new(title: "Reports summary", description: "Review the key results across financial, compliance, guest, and accounting reports.") do |header| %>
      <% header.with_caption do %>
        <p class="text-sm font-medium text-muted-foreground">
          <%= current_hotel.name %> ·
          <% if @start_date == @end_date %>
            <%= @start_date.strftime("%A, %d %b %Y") %>
          <% else %>
            <%= @start_date.strftime("%d %b %Y") %> - <%= @end_date.strftime("%d %b %Y") %>
          <% end %>
        </p>
      <% end %>
      <% header.with_actions do %>
        <%= render "preset_report_actions",
          form_url: hotel_reports_path(current_hotel),
          date_preset: @date_preset,
          start_date: @start_date,
          end_date: @end_date,
          export_menu_id: "reports-summary-export",
          export_items: [],
          show_export: false,
          class_name: "flex flex-col gap-2 sm:flex-row sm:items-end" %>
      <% end %>
    <% end %>

    <section class="space-y-3" aria-labelledby="financial-summary-heading" data-slot="reports-summary-group">
      <div>
        <h2 id="financial-summary-heading" class="text-base font-semibold text-foreground">Financial</h2>
        <p class="mt-1 text-sm text-muted-foreground">Bookings, revenue, refunds, and balances.</p>
      </div>
      <%= render HotelPortal::Reports::MetricStrip.new(metrics: [
        { label: "Gross bookings", value: "MYR #{number_with_delimiter(number_with_precision(@total_gross, precision: 2))}", detail: "Booking date" },
        { label: "Net earnings", value: "MYR #{number_with_delimiter(number_with_precision(@total_net, precision: 2))}", detail: "Booking date", detail_variant: :success },
        { label: "Refunds", value: "MYR #{number_with_delimiter(number_with_precision(@reports_summary[:financial][:refunds], precision: 2))}", detail: "Posting date", detail_variant: :destructive },
        { label: "Extra charges", value: "MYR #{number_with_delimiter(number_with_precision(@reports_summary[:financial][:extra_charges], precision: 2))}", detail: "Posting date" },
        { label: "Outstanding balance", value: "MYR #{number_with_delimiter(number_with_precision(@reports_summary[:financial][:outstanding], precision: 2))}", detail: "Stay date", detail_variant: :warning },
        { label: "Deposit liability", value: "MYR #{number_with_delimiter(number_with_precision(@reports_summary[:financial][:deposit_liability], precision: 2))}", detail: "As of #{@end_date.strftime('%d %b %Y')}" }
      ], aria_label: "Financial report summary") %>
    </section>

    <section class="space-y-3" aria-labelledby="tax-compliance-summary-heading" data-slot="reports-summary-group">
      <div>
        <h2 id="tax-compliance-summary-heading" class="text-base font-semibold text-foreground">Tax &amp; compliance</h2>
        <p class="mt-1 text-sm text-muted-foreground">Tax collections and non-national guest activity.</p>
      </div>
      <%= render HotelPortal::Reports::MetricStrip.new(metrics: [
        { label: "Tourism tax collected", value: "MYR #{number_with_delimiter(number_with_precision(@reports_summary[:tax_compliance][:tourism_tax], precision: 2))}", detail: "Stay date" },
        { label: "SST", value: "MYR #{number_with_delimiter(number_with_precision(@reports_summary[:tax_compliance][:sst], precision: 2))}", detail: "Posting date" },
        { label: "Non-national guests", value: @reports_summary[:tax_compliance][:non_national_guests].to_s, detail: "Stay date" }
      ], aria_label: "Tax and compliance report summary") %>
    </section>

    <section class="space-y-3" aria-labelledby="guest-operations-summary-heading" data-slot="reports-summary-group">
      <div>
        <h2 id="guest-operations-summary-heading" class="text-base font-semibold text-foreground">Guest operations</h2>
        <p class="mt-1 text-sm text-muted-foreground">Key movement counts for the selected stay dates.</p>
      </div>
      <%= render HotelPortal::Reports::MetricStrip.new(metrics: [
        { label: "Arrivals", value: @reports_summary[:guest_operations][:arrivals].to_s, detail: "Check-in date" },
        { label: "In house", value: @reports_summary[:guest_operations][:in_house].to_s, detail: "Stay date" },
        { label: "Departures", value: @reports_summary[:guest_operations][:departures].to_s, detail: "Check-out date" },
        { label: "Checkouts", value: @reports_summary[:guest_operations][:checkouts].to_s, detail: "Check-out date" }
      ], aria_label: "Guest operations report summary") %>
    </section>

    <section class="space-y-3" aria-labelledby="accounting-summary-heading" data-slot="reports-summary-group">
      <div>
        <h2 id="accounting-summary-heading" class="text-base font-semibold text-foreground">Accounting</h2>
        <p class="mt-1 text-sm text-muted-foreground">Journal activity recorded for the selected business dates.</p>
      </div>
      <%= render HotelPortal::Reports::MetricStrip.new(metrics: [
        { label: "Journal batches", value: @reports_summary[:accounting][:batches].to_s, detail: "Business date" },
        { label: "Total debit", value: "MYR #{number_with_delimiter(number_with_precision(@reports_summary[:accounting][:debit], precision: 2))}", detail: "Business date" },
        { label: "Total credit", value: "MYR #{number_with_delimiter(number_with_precision(@reports_summary[:accounting][:credit], precision: 2))}", detail: "Business date" }
      ], aria_label: "Accounting report summary") %>
    </section>
  <% end %>
</div>
