<div class="max-w-[85rem] px-4 py-10 sm:px-6 lg:px-8 lg:py-14 mx-auto">
  <!-- Header -->
  <div class="flex flex-col md:flex-row justify-between items-center mb-8 gap-4">
    <div>
      <h1 class="text-3xl font-bold text-gray-800">Financial Performance</h1>
      <p class="text-sm text-gray-600">Review your earnings and booking activity for the selected period.</p>
    </div>

    <div class="inline-flex gap-x-2">
      <%= form_with url: hotel_reports_path, method: :get, class: "flex gap-x-2" do |f| %>
        <%= f.date_field :start_date, value: @start_date, class: "py-2 px-3 block border-gray-200 rounded-lg text-sm focus:border-blue-500 focus:ring-blue-500 border" %>
        <%= f.date_field :end_date, value: @end_date, class: "py-2 px-3 block border-gray-200 rounded-lg text-sm focus:border-blue-500 focus:ring-blue-500 border" %>
        <%= f.submit "Update", class: "py-2 px-3 inline-flex items-center gap-x-2 text-sm font-semibold rounded-lg border border-transparent bg-blue-600 text-white hover:bg-blue-700" %>
      <% end %>
    </div>
  </div>

  <!-- Quick Stats -->
  <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-4 sm:gap-6 mb-8">
    <!-- Card -->
    <div class="flex flex-col bg-white border border-gray-200 rounded-xl shadow-sm">
      <div class="p-4 md:p-5">
        <div class="flex items-center gap-x-2">
          <p class="text-xs uppercase tracking-wide text-gray-500">Gross Bookings</p>
        </div>
        <div class="mt-1 flex items-center gap-x-2">
          <h3 class="text-xl sm:text-2xl font-medium text-gray-800">MYR <%= number_with_precision(@total_gross, precision: 2) %></h3>
        </div>
      </div>
    </div>
    <!-- End Card -->

    <!-- Card -->
    <div class="flex flex-col bg-white border border-gray-200 rounded-xl shadow-sm">
      <div class="p-4 md:p-5">
        <div class="flex items-center gap-x-2">
          <p class="text-xs uppercase tracking-wide text-gray-500">WAStays Margin</p>
        </div>
        <div class="mt-1 flex items-center gap-x-2">
          <h3 class="text-xl sm:text-2xl font-medium text-red-600">- MYR <%= number_with_precision(@total_margin, precision: 2) %></h3>
        </div>
      </div>
    </div>
    <!-- End Card -->

    <!-- Card -->
    <div class="flex flex-col bg-blue-50 border border-blue-200 rounded-xl shadow-sm">
      <div class="p-4 md:p-5">
        <div class="flex items-center gap-x-2">
          <p class="text-xs uppercase tracking-wide text-blue-600 font-bold">Net Earnings</p>
        </div>
        <div class="mt-1 flex items-center gap-x-2">
          <h3 class="text-xl sm:text-2xl font-bold text-blue-800">MYR <%= number_with_precision(@total_net, precision: 2) %></h3>
        </div>
      </div>
    </div>
    <!-- End Card -->

    <!-- Card -->
    <div class="flex flex-col bg-white border border-gray-200 rounded-xl shadow-sm">
      <div class="p-4 md:p-5">
        <div class="flex items-center gap-x-2">
          <p class="text-xs uppercase tracking-wide text-gray-500">Booking Count</p>
        </div>
        <div class="mt-1 flex items-center gap-x-2">
          <h3 class="text-xl sm:text-2xl font-medium text-gray-800"><%= @booking_count %></h3>
        </div>
      </div>
    </div>
    <!-- End Card -->
  </div>

  <!-- Details Table -->
  <div class="bg-white border border-gray-200 rounded-xl shadow-sm overflow-hidden">
    <div class="px-6 py-4 border-b border-gray-200">
      <h2 class="text-lg font-semibold text-gray-800">Daily Performance</h2>
    </div>
    <table class="min-w-full divide-y divide-gray-200">
      <thead class="bg-gray-50">
        <tr>
          <th scope="col" class="px-6 py-3 text-start text-xs font-semibold uppercase tracking-wide text-gray-800">Date</th>
          <th scope="col" class="px-6 py-3 text-start text-xs font-semibold uppercase tracking-wide text-gray-800">Bookings</th>
          <th scope="col" class="px-6 py-3 text-start text-xs font-semibold uppercase tracking-wide text-gray-800">Gross</th>
          <th scope="col" class="px-6 py-3 text-start text-xs font-semibold uppercase tracking-wide text-gray-800">Margin</th>
          <th scope="col" class="px-6 py-3 text-start text-xs font-semibold uppercase tracking-wide text-gray-800">Net</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-gray-200">
        <% if @daily_data.any? %>
          <% @daily_data.each do |date, gross| %>
            <% 
              daily_bookings = @bookings.select { |b| b.created_at.to_date == date }
              daily_margin = daily_bookings.sum { |b| b.margin_amount || 0 }
              daily_net = daily_bookings.sum { |b| b.net_amount || 0 }
            %>
            <tr>
              <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-800"><%= date.strftime("%d %b %Y") %></td>
              <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-800"><%= daily_bookings.count %></td>
              <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-800">MYR <%= number_with_precision(gross, precision: 2) %></td>
              <td class="px-6 py-4 whitespace-nowrap text-sm text-red-600">- <%= number_with_precision(daily_margin, precision: 2) %></td>
              <td class="px-6 py-4 whitespace-nowrap text-sm font-bold text-gray-800">MYR <%= number_with_precision(daily_net, precision: 2) %></td>
            </tr>
          <% end %>
        <% else %>
          <tr>
            <td colspan="5" class="px-6 py-10 text-center text-sm text-gray-500 italic">
              No financial data for this period.
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>
