<% content_for :breadcrumbs do %>
  <div class="flex items-center gap-x-2">
    <span class="text-sm font-medium text-slate-600"><%= current_hotel.name %></span>
    <span class="text-sm text-slate-400">/</span>
    <%= link_to "Reports", hotel_reports_path(current_hotel), class: "text-sm font-medium text-slate-600 hover:text-slate-900" %>
    <span class="text-sm text-slate-400">/</span>
    <span class="text-sm font-semibold text-slate-900">Outstanding Balance</span>
  </div>
<% end %>

<div class="max-w-[1600px] mx-auto pb-20 space-y-8">
  <div class="px-4 md:px-0">
    <div class="mt-5 flex flex-col gap-4 md:flex-row md:items-end md:justify-between">
      <div>
        <h1 class="text-2xl font-bold tracking-tight text-slate-950 sm:text-3xl">Outstanding Balance Report</h1>
        <p class="mt-1 text-sm font-medium text-slate-600">
          <%= current_hotel.name %> ·
          <% if @report.start_date == @report.end_date %>
            <%= @report.start_date.strftime("%A, %d %b %Y") %>
          <% else %>
            <%= @report.start_date.strftime("%d %b %Y") %> - <%= @report.end_date.strftime("%d %b %Y") %>
          <% end %>
        </p>
      </div>

      <%= form_with url: outstanding_balance_hotel_reports_path(current_hotel), method: :get, local: true, class: "flex flex-col gap-3 md:flex-row md:items-end", id: "outstanding-balance-range-form" do |f| %>
        <div>
          <label class="mb-2 block text-[11px] font-bold uppercase tracking-wider text-slate-500">Start Date</label>
          <%= f.date_field :start_date, value: @report.start_date, class: "rounded-xl border border-slate-200 bg-white px-4 py-2.5 text-sm font-bold text-slate-700" %>
        </div>
        <div>
          <label class="mb-2 block text-[11px] font-bold uppercase tracking-wider text-slate-500">End Date</label>
          <%= f.date_field :end_date, value: @report.end_date, class: "rounded-xl border border-slate-200 bg-white px-4 py-2.5 text-sm font-bold text-slate-700" %>
        </div>
        <% if feature_enabled_for_hotel?("excel_pdf_export") %>
        <details class="relative min-w-[170px]">
          <summary class="list-none inline-flex w-full cursor-pointer items-center justify-center rounded-xl border border-slate-200 bg-white px-4 py-2.5 text-sm font-bold text-slate-700 shadow-sm transition hover:border-slate-900 hover:bg-slate-50">
            <svg class="size-4 me-2" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
            Export
          </summary>
          <div class="absolute right-0 z-20 mt-2 w-44 overflow-hidden rounded-xl border border-slate-200 bg-white shadow-xl">
            <%= link_to "Export PDF", outstanding_balance_hotel_reports_path(current_hotel, start_date: @report.start_date, end_date: @report.end_date, format: :pdf), class: "block px-4 py-2.5 text-sm font-semibold text-slate-700 transition hover:bg-slate-50" %>
            <%= link_to "Export Excel", outstanding_balance_hotel_reports_path(current_hotel, start_date: @report.start_date, end_date: @report.end_date, format: :xls), class: "block border-t border-slate-100 px-4 py-2.5 text-sm font-semibold text-slate-700 transition hover:bg-slate-50" %>
            <%= link_to "Export CSV", outstanding_balance_hotel_reports_path(current_hotel, start_date: @report.start_date, end_date: @report.end_date, format: :csv), class: "block border-t border-slate-100 px-4 py-2.5 text-sm font-semibold text-slate-700 transition hover:bg-slate-50" %>
          </div>
        </details>
        <% end %>
      <% end %>
    </div>
  </div>

  <div class="grid grid-cols-1 overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm md:grid-cols-2">
    <div class="p-6 md:border-r md:border-slate-200">
      <p class="mb-2 text-[11px] font-semibold uppercase tracking-wider text-slate-500">Outstanding Bookings</p>
      <h2 class="text-3xl font-bold tabular-nums tracking-tight text-slate-950"><%= @report.totals[:booking_count] %></h2>
    </div>
    <div class="bg-slate-50/30 p-6">
      <p class="mb-2 text-[11px] font-semibold uppercase tracking-wider text-slate-500">Outstanding Amount</p>
      <h2 class="text-3xl font-bold tabular-nums tracking-tight text-slate-950">MYR <%= number_with_precision(@report.totals[:outstanding_amount], precision: 2) %></h2>
    </div>
  </div>

  <div class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">
    <div class="overflow-x-auto">
      <table class="min-w-full">
        <thead class="bg-slate-100">
          <tr>
            <th class="px-6 py-4 text-left text-[11px] font-semibold uppercase tracking-[0.1em] text-slate-600">Guest / Ref</th>
            <th class="px-6 py-4 text-left text-[11px] font-semibold uppercase tracking-[0.1em] text-slate-600">Stay</th>
            <th class="px-6 py-4 text-left text-[11px] font-semibold uppercase tracking-[0.1em] text-slate-600">Rooms</th>
            <th class="px-6 py-4 text-left text-[11px] font-semibold uppercase tracking-[0.1em] text-slate-600">Payment Status</th>
            <th class="px-6 py-4 text-left text-[11px] font-semibold uppercase tracking-[0.1em] text-slate-600">Outstanding Amount</th>
            <th class="px-6 py-4 text-left text-[11px] font-semibold uppercase tracking-[0.1em] text-slate-600">Notes</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-200 bg-white">
          <% if @report.rows.any? %>
            <% @report.rows.each do |row| %>
              <tr>
                <td class="px-6 py-4 text-sm text-slate-900"><p class="font-semibold"><%= row[:guest_name] %></p><p class="text-xs text-slate-500"><%= row[:confirmation_token] %></p></td>
                <td class="px-6 py-4 text-sm text-slate-700"><%= row[:stay_dates] %></td>
                <td class="px-6 py-4 text-sm text-slate-700"><p><%= row[:room_details] %></p><p class="text-xs text-slate-500">Room: <%= row[:room_numbers] %></p></td>
                <td class="px-6 py-4 text-sm text-slate-700"><%= row[:payment_status] %></td>
                <td class="px-6 py-4 text-sm font-semibold text-slate-900">MYR <%= number_with_precision(row[:outstanding_amount], precision: 2) %></td>
                <td class="px-6 py-4 text-sm text-slate-700"><%= row[:latest_note].presence || "-" %></td>
              </tr>
            <% end %>
          <% else %>
            <tr><td colspan="6" class="px-6 py-20 text-center text-sm font-medium text-slate-500">No outstanding bookings for this selected period.</td></tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
</div>

<script>
  (() => {
    const init = () => {
      const form = document.getElementById("outstanding-balance-range-form");
      if (!form || form.dataset.bound === "true") return;
      form.dataset.bound = "true";

      const startInput = form.querySelector('input[name="start_date"]');
      const endInput = form.querySelector('input[name="end_date"]');
      if (!startInput || !endInput) return;

      const submit = () => {
        if (startInput.value && endInput.value && endInput.value < startInput.value) {
          endInput.value = startInput.value;
        }
        form.requestSubmit();
      };

      startInput.addEventListener("change", submit);
      endInput.addEventListener("change", submit);
    };

    document.addEventListener("turbo:load", init);
    document.addEventListener("DOMContentLoaded", init);
  })();
</script>
