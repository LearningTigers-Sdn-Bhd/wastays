<div class="w-full space-y-3.5">
  <div>
    <%= render PanelsUI::PageHeader.new(title: "Outstanding Balance Report") do |header| %>
      <% header.with_caption do %>
        <p class="text-sm font-medium text-muted-foreground">
          <%= current_hotel.name %> ·
          <% if @report.start_date == @report.end_date %>
            <%= @report.start_date.strftime("%A, %d %b %Y") %>
          <% else %>
            <%= @report.start_date.strftime("%d %b %Y") %> - <%= @report.end_date.strftime("%d %b %Y") %>
          <% end %>
        </p>
      <% end %>
      <% header.with_actions do %>
        <%= render "preset_report_actions",
          form_url: outstanding_balance_hotel_reports_path(current_hotel), form_id: "outstanding-balance-range-form",
          date_preset: @date_preset, start_date: @report.start_date, end_date: @report.end_date,
          show_export: feature_enabled_for_hotel?("excel_pdf_export"), export_menu_id: "outstanding-balance-export",
          export_items: [
            ["Export PDF", outstanding_balance_hotel_reports_path(current_hotel, start_date: @report.start_date, end_date: @report.end_date, date_preset: @date_preset, format: :pdf)],
            ["Export Excel", outstanding_balance_hotel_reports_path(current_hotel, start_date: @report.start_date, end_date: @report.end_date, date_preset: @date_preset, format: :xlsx)],
            ["Export CSV", outstanding_balance_hotel_reports_path(current_hotel, start_date: @report.start_date, end_date: @report.end_date, date_preset: @date_preset, format: :csv)]
          ] %>
      <% end %>
    <% end %>
  </div>

  <div class="grid grid-cols-1 overflow-hidden rounded-2xl border border-border bg-card shadow-sm md:grid-cols-2">
    <div class="p-6 md:border-r md:border-border">
      <p class="mb-2 text-[11px] font-semibold uppercase tracking-wider text-muted-foreground">Outstanding Bookings</p>
      <h2 class="text-3xl font-bold tabular-nums tracking-tight text-foreground"><%= @report.totals[:booking_count] %></h2>
    </div>
    <div class="bg-muted/30 p-6">
      <p class="mb-2 text-[11px] font-semibold uppercase tracking-wider text-muted-foreground">Outstanding Amount</p>
      <h2 class="text-3xl font-bold tabular-nums tracking-tight text-foreground">MYR <%= number_with_precision(@report.totals[:outstanding_amount], precision: 2) %></h2>
    </div>
  </div>

  <div class="overflow-hidden rounded-2xl border border-border bg-card shadow-sm">
    <div class="overflow-x-auto">
      <% grouped_rows = @date_preset == "this_year" ? @report.rows.group_by { |row| row[:check_in].to_date.beginning_of_month } : { nil => @report.rows } %>
      <% grouped_rows.each do |month, rows| %>
        <% if month.present? %>
          <div class="border-b border-border bg-muted px-6 py-3 text-sm font-bold text-foreground"><%= month.strftime("%B %Y") %></div>
        <% end %>
      <table class="min-w-full">
        <thead class="bg-muted">
          <tr>
            <th class="px-6 py-4 text-left text-[11px] font-semibold uppercase tracking-[0.1em] text-muted-foreground">Guest / Ref</th>
            <th class="px-6 py-4 text-left text-[11px] font-semibold uppercase tracking-[0.1em] text-muted-foreground">Stay</th>
            <th class="px-6 py-4 text-left text-[11px] font-semibold uppercase tracking-[0.1em] text-muted-foreground">Rooms</th>
            <th class="px-6 py-4 text-left text-[11px] font-semibold uppercase tracking-[0.1em] text-muted-foreground">Payment Status</th>
            <th class="px-6 py-4 text-left text-[11px] font-semibold uppercase tracking-[0.1em] text-muted-foreground">Outstanding Amount</th>
            <th class="px-6 py-4 text-left text-[11px] font-semibold uppercase tracking-[0.1em] text-muted-foreground">Notes</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-border bg-card">
          <% if rows.any? %>
            <% rows.each do |row| %>
              <tr>
                <td class="px-6 py-4 text-sm text-foreground"><p class="font-semibold"><%= row[:guest_name] %></p><p class="text-xs text-muted-foreground"><%= row[:confirmation_token] %></p></td>
                <td class="px-6 py-4 text-sm text-foreground"><%= row[:stay_dates] %></td>
                <td class="px-6 py-4 text-sm text-foreground"><p><%= row[:room_details] %></p><p class="text-xs text-muted-foreground">Room: <%= row[:room_numbers] %></p></td>
                <td class="px-6 py-4 text-sm text-foreground"><%= row[:payment_status] %></td>
                <td class="px-6 py-4 text-sm font-semibold text-foreground">MYR <%= number_with_precision(row[:outstanding_amount], precision: 2) %></td>
                <td class="px-6 py-4 text-sm text-foreground"><%= row[:latest_note].presence || "-" %></td>
              </tr>
            <% end %>
          <% else %>
            <tr><td colspan="6" class="px-6 py-20 text-center text-sm font-medium text-muted-foreground">No outstanding bookings for this selected period.</td></tr>
          <% end %>
        </tbody>
      </table>
      <% end %>
    </div>
  </div>
</div>
