<div class="w-full space-y-3.5">
  <div>
    <%= render PanelsUI::PageHeader.new(title: "Tourism Tax Report") do |header| %>
      <% header.with_caption do %>
        <p class="text-sm font-medium text-muted-foreground">
          <%= current_hotel.name %> ·
          <% if @report.start_date == @report.end_date %>
            <%= @report.start_date.strftime("%A, %d %b %Y") %>
          <% else %>
            <%= @report.start_date.strftime("%d %b %Y") %> - <%= @report.end_date.strftime("%d %b %Y") %>
          <% end %>
        </p>
      <% end %>
      <% header.with_actions do %>
        <%= render "preset_report_actions",
          form_url: tourism_tax_hotel_reports_path(current_hotel), date_preset: @date_preset,
          start_date: @report.start_date, end_date: @report.end_date,
          show_export: feature_enabled_for_hotel?("excel_pdf_export"), export_menu_id: "tourism-tax-export",
          export_items: [
            ["Export PDF", tourism_tax_hotel_reports_path(current_hotel, start_date: @report.start_date, end_date: @report.end_date, date_preset: @date_preset, format: :pdf)],
            ["Export Excel", tourism_tax_hotel_reports_path(current_hotel, start_date: @report.start_date, end_date: @report.end_date, date_preset: @date_preset, format: :xls)],
            ["Export CSV", tourism_tax_hotel_reports_path(current_hotel, start_date: @report.start_date, end_date: @report.end_date, date_preset: @date_preset, format: :csv)]
          ] %>
      <% end %>
    <% end %>
  </div>

  <div class="grid grid-cols-1 gap-4 md:grid-cols-3">
    <div class="rounded-2xl border border-border bg-card p-6 shadow-sm">
      <p class="mb-2 text-[11px] font-semibold uppercase tracking-wider text-muted-foreground">Guests</p>
      <h2 class="text-2xl font-bold tracking-tight text-foreground"><%= @report.totals[:guest_count] %></h2>
    </div>
    <div class="rounded-2xl border border-border bg-card p-6 shadow-sm">
      <p class="mb-2 text-[11px] font-semibold uppercase tracking-wider text-muted-foreground">Total Tax Due</p>
      <h2 class="text-2xl font-bold tracking-tight text-foreground">MYR <%= number_with_precision(@report.totals[:total_due], precision: 2) %></h2>
    </div>
    <div class="rounded-2xl border border-border bg-card p-6 shadow-sm">
      <p class="mb-2 text-[11px] font-semibold uppercase tracking-wider text-muted-foreground">Total Tax Collected</p>
      <h2 class="text-2xl font-bold tracking-tight text-foreground">MYR <%= number_with_precision(@report.totals[:total_collected], precision: 2) %></h2>
    </div>
  </div>

  <div class="overflow-hidden rounded-2xl border border-border bg-card shadow-sm">
    <div class="overflow-x-auto">
      <table class="min-w-full">
        <thead class="bg-muted">
          <tr>
            <th class="px-6 py-4 text-left text-[11px] font-semibold uppercase tracking-[0.1em] text-muted-foreground">Guest Name</th>
            <th class="px-6 py-4 text-left text-[11px] font-semibold uppercase tracking-[0.1em] text-muted-foreground">Nationality</th>
            <th class="px-6 py-4 text-left text-[11px] font-semibold uppercase tracking-[0.1em] text-muted-foreground">Booking Ref</th>
            <th class="px-6 py-4 text-left text-[11px] font-semibold uppercase tracking-[0.1em] text-muted-foreground">Check In</th>
            <th class="px-6 py-4 text-left text-[11px] font-semibold uppercase tracking-[0.1em] text-muted-foreground">Check Out</th>
            <th class="px-6 py-4 text-right text-[11px] font-semibold uppercase tracking-[0.1em] text-muted-foreground">Nights</th>
            <th class="px-6 py-4 text-left text-[11px] font-semibold uppercase tracking-[0.1em] text-muted-foreground">Room Numbers</th>
            <th class="px-6 py-4 text-right text-[11px] font-semibold uppercase tracking-[0.1em] text-muted-foreground">Tax Due</th>
            <th class="px-6 py-4 text-right text-[11px] font-semibold uppercase tracking-[0.1em] text-muted-foreground">Tax Collected</th>
            <th class="px-6 py-4 text-left text-[11px] font-semibold uppercase tracking-[0.1em] text-muted-foreground">Collection Status</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-border bg-card">
          <% if @report.rows.any? %>
            <% @report.rows.each do |row| %>
              <tr class="hover:bg-muted/50">
                <td class="px-6 py-4 text-sm font-semibold text-foreground"><%= row[:guest_name] %></td>
                <td class="px-6 py-4 text-sm text-foreground"><%= row[:guest_country] %></td>
                <td class="px-6 py-4 text-sm font-mono text-muted-foreground"><%= row[:booking_reference] %></td>
                <td class="px-6 py-4 text-sm text-foreground"><%= row[:check_in].strftime("%d %b %Y") %></td>
                <td class="px-6 py-4 text-sm text-foreground"><%= row[:check_out].strftime("%d %b %Y") %></td>
                <td class="px-6 py-4 text-right text-sm font-semibold text-foreground"><%= row[:nights] %></td>
                <td class="px-6 py-4 text-sm text-foreground"><%= row[:room_numbers] %></td>
                <td class="px-6 py-4 text-right text-sm font-semibold text-foreground">MYR <%= number_with_precision(row[:tax_due], precision: 2) %></td>
                <td class="px-6 py-4 text-right text-sm font-semibold text-foreground">MYR <%= number_with_precision(row[:tax_collected], precision: 2) %></td>
                <td class="px-6 py-4 text-sm text-foreground"><%= row[:collection_status] %></td>
              </tr>
            <% end %>
          <% else %>
            <tr>
              <td colspan="10" class="px-6 py-16 text-center text-sm font-medium text-muted-foreground">
                No tourism tax bookings found for this selected period.
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
</div>
