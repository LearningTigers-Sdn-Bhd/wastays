<div class="w-full space-y-8">
  <div class="">
 <div class="flex flex-col gap-4 md:flex-row md:items-end md:justify-between">
      <div>
        <h1 class="text-2xl font-bold tracking-tight text-foreground sm:text-3xl">SST Financial Report</h1>
        <p class="mt-1 text-sm font-medium text-muted-foreground">
          <%= current_hotel.name %> ·
          <% if @report.start_date == @report.end_date %>
            <%= @report.start_date.strftime("%A, %d %b %Y") %>
          <% else %>
            <%= @report.start_date.strftime("%d %b %Y") %> - <%= @report.end_date.strftime("%d %b %Y") %>
          <% end %>
        </p>
      </div>

      <%= form_with url: sst_hotel_reports_path(current_hotel), method: :get, local: true, class: "flex flex-col gap-3 md:flex-row md:items-end", id: "sst-report-range-form", data: { controller: "date-preset" } do |f| %>
        <div>
          <label class="mb-2 block text-[11px] font-bold uppercase tracking-wider text-muted-foreground">Time Period</label>
          <%= select_tag :date_preset, options_for_select(date_preset_options, @date_preset), class: "rounded-xl border border-border bg-card px-4 py-2.5 text-sm font-bold text-foreground shadow-sm transition focus:border-border-interactive focus:outline-none", data: { action: "change->date-preset#toggleCustom" } %>
        </div>
        <div id="custom-date-range" class="<%= @date_preset == 'custom' ? 'flex' : 'hidden' %> gap-3">
          <div>
            <label class="mb-2 block text-[11px] font-bold uppercase tracking-wider text-muted-foreground">Start Date</label>
            <%= f.date_field :start_date, value: @report.start_date, class: "rounded-xl border border-border bg-card px-4 py-2.5 text-sm font-bold text-foreground" %>
          </div>
          <div>
            <label class="mb-2 block text-[11px] font-bold uppercase tracking-wider text-muted-foreground">End Date</label>
            <%= f.date_field :end_date, value: @report.end_date, class: "rounded-xl border border-border bg-card px-4 py-2.5 text-sm font-bold text-foreground" %>
          </div>
        </div>
        <% if feature_enabled_for_hotel?("excel_pdf_export") %>
        <details class="relative min-w-[170px]">
          <summary class="list-none inline-flex w-full cursor-pointer items-center justify-center rounded-xl border border-border bg-card px-4 py-2.5 text-sm font-bold text-foreground shadow-sm transition hover:border-border-interactive hover:bg-muted">
            <svg class="size-4 me-2" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
            Export
          </summary>
          <div class="absolute right-0 z-20 mt-2 w-44 overflow-hidden rounded-xl border border-border bg-card shadow-xl">
            <%= link_to "Export PDF", sst_hotel_reports_path(current_hotel, start_date: @report.start_date, end_date: @report.end_date, format: :pdf), class: "block px-4 py-2.5 text-sm font-semibold text-foreground transition hover:bg-muted" %>
            <%= link_to "Export Excel", sst_hotel_reports_path(current_hotel, start_date: @report.start_date, end_date: @report.end_date, format: :xls), class: "block border-t border-border px-4 py-2.5 text-sm font-semibold text-foreground transition hover:bg-muted" %>
            <%= link_to "Export CSV", sst_hotel_reports_path(current_hotel, start_date: @report.start_date, end_date: @report.end_date, format: :csv), class: "block border-t border-border px-4 py-2.5 text-sm font-semibold text-foreground transition hover:bg-muted" %>
          </div>
        </details>
        <% end %>
      <% end %>
    </div>
  </div>

  <div class="grid grid-cols-2 overflow-hidden rounded-2xl border border-border bg-card shadow-sm md:grid-cols-4">
    <div class="p-6 md:border-r md:border-border">
      <p class="mb-2 text-[11px] font-semibold uppercase tracking-wider text-muted-foreground">Bookings</p>
      <h2 class="text-3xl font-bold tabular-nums tracking-tight text-foreground"><%= @report.totals[:booking_count] %></h2>
    </div>
    <div class="p-6 md:border-r md:border-border">
      <p class="mb-2 text-[11px] font-semibold uppercase tracking-wider text-muted-foreground">Taxable Amount</p>
      <h2 class="text-2xl font-bold tabular-nums tracking-tight text-foreground">MYR <%= number_with_precision(@report.totals[:taxable_amount], precision: 2) %></h2>
    </div>
    <div class="bg-muted/30 p-6 md:border-r md:border-border">
      <p class="mb-2 text-[11px] font-semibold uppercase tracking-wider text-muted-foreground">SST Collected (8%)</p>
      <h2 class="text-2xl font-bold tabular-nums tracking-tight text-foreground">MYR <%= number_with_precision(@report.totals[:sst_amount], precision: 2) %></h2>
    </div>
    <div class="bg-muted/30 p-6">
      <p class="mb-2 text-[11px] font-semibold uppercase tracking-wider text-muted-foreground">Grand Total</p>
      <h2 class="text-2xl font-bold tabular-nums tracking-tight text-foreground">MYR <%= number_with_precision(@report.totals[:total_amount], precision: 2) %></h2>
    </div>
  </div>

  <div class="overflow-hidden rounded-2xl border border-border bg-card shadow-sm">
    <div class="overflow-x-auto">
      <% grouped_rows = @date_preset == "this_year" ? @report.rows.group_by { |row| row[:report_month] } : { nil => @report.rows } %>
      <% grouped_rows.each do |month, rows| %>
        <% if month.present? %>
          <div class="border-b border-border bg-muted px-6 py-3 text-sm font-bold text-foreground"><%= month.strftime("%B %Y") %></div>
        <% end %>
      <table class="min-w-full">
        <thead class="bg-muted">
          <tr>
            <th class="px-6 py-4 text-left text-[11px] font-semibold uppercase tracking-[0.1em] text-muted-foreground">Invoice / Ref</th>
            <th class="px-6 py-4 text-left text-[11px] font-semibold uppercase tracking-[0.1em] text-muted-foreground">Guest</th>
            <th class="px-6 py-4 text-left text-[11px] font-semibold uppercase tracking-[0.1em] text-muted-foreground">Stay</th>
            <th class="px-6 py-4 text-right text-[11px] font-semibold uppercase tracking-[0.1em] text-muted-foreground">Taxable Amount</th>
            <th class="px-6 py-4 text-right text-[11px] font-semibold uppercase tracking-[0.1em] text-muted-foreground">SST 8%</th>
            <th class="px-6 py-4 text-right text-[11px] font-semibold uppercase tracking-[0.1em] text-muted-foreground">Total</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-border bg-card">
          <% if rows.any? %>
            <% rows.each do |row| %>
              <tr class="hover:bg-muted/50">
                <td class="px-6 py-4 text-sm font-semibold text-foreground"><%= row[:invoice_number] %></td>
                <td class="px-6 py-4 text-sm text-foreground"><%= row[:guest_name] %></td>
                <td class="px-6 py-4 text-sm text-foreground"><%= row[:stay_dates] %></td>
                <td class="px-6 py-4 text-right text-sm text-foreground">MYR <%= number_with_precision(row[:taxable_amount], precision: 2) %></td>
                <td class="px-6 py-4 text-right text-sm text-foreground">MYR <%= number_with_precision(row[:sst_amount], precision: 2) %></td>
                <td class="px-6 py-4 text-right text-sm font-semibold text-foreground">MYR <%= number_with_precision(row[:total_amount], precision: 2) %></td>
              </tr>
            <% end %>
            <% if month.nil? %>
              <tr class="bg-muted font-semibold">
                <td class="px-6 py-4 text-sm text-foreground" colspan="3">Total (<%= @report.totals[:booking_count] %> bookings)</td>
                <td class="px-6 py-4 text-right text-sm text-foreground">MYR <%= number_with_precision(@report.totals[:taxable_amount], precision: 2) %></td>
                <td class="px-6 py-4 text-right text-sm text-foreground">MYR <%= number_with_precision(@report.totals[:sst_amount], precision: 2) %></td>
                <td class="px-6 py-4 text-right text-sm text-foreground">MYR <%= number_with_precision(@report.totals[:total_amount], precision: 2) %></td>
              </tr>
            <% end %>
          <% else %>
            <tr><td colspan="6" class="px-6 py-20 text-center text-sm font-medium text-muted-foreground">No SST transactions found for this period.</td></tr>
          <% end %>
        </tbody>
      </table>
      <% end %>
    </div>
  </div>
</div>
