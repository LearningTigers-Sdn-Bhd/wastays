<% room_row = presenter.room_row(room) %>
<div class="grid border-b border-slate-100 <%= 'bg-slate-50/40 opacity-75' if room_row.active_dnd? %>" style="grid-template-columns: <%= presenter.grid_template_columns %>; min-height: <%= presenter.row_min_height(room) %>px;">
  <div class="sticky left-0 z-20 border-r border-slate-200 bg-white shadow-[4px_0_12px_rgba(0,0,0,0.03)] <%= presenter.card_padding %> flex flex-col justify-center">
    <div class="flex items-center justify-between gap-1.5">
      <div class="flex items-center gap-1.5">
        <p class="font-medium leading-none text-slate-800 <%= presenter.room_number_class %>"><%= room[:room_number] %></p>
        
        <%# Housekeeping Badge %>
        <% if room[:housekeeping_requests].any? %>
          <%= link_to hotel_room_status_housekeeping_requests_path(current_hotel, room[:room_number]), 
                      data: { turbo_frame: "offcanvas_drawer", offcanvas_variant: "compact-right" },
                      class: "cursor-pointer flex items-center justify-center transition-transform active:scale-90 text-slate-800 focus:outline-none" do %>
            <%= cached_icon "clipboard-text", library: "phosphor", variant: "light", class: "size-4" %>
          <% end %>
        <% end %>

        <% if room_row.active_dnd? %>
          <div data-controller="floating" data-floating-trigger-value="hover" data-floating-placement-value="top" class="inline-flex">
            <span data-floating-target="reference" class="text-orange-500 cursor-help">
              <%= cached_icon "hand-palm", library: "phosphor", variant: "fill", class: "size-4 text-orange-500" %>
            </span>
            <div data-floating-target="floating" class="hidden z-[100] px-2 py-1 bg-slate-900 rounded-lg shadow-xl pointer-events-none text-white whitespace-nowrap">
              <span class="text-[8px] font-bold uppercase tracking-wider">Do Not Disturb</span>
            </div>
          </div>
        <% end %>

        <% if room_row.priority? %>
          <div data-controller="floating" data-floating-trigger-value="hover" data-floating-placement-value="top" class="inline-flex">
            <span data-floating-target="reference" class="text-rose-500 cursor-help">
              <%= cached_icon "flag", library: "phosphor", variant: "fill", class: "size-4 text-rose-500" %>
            </span>
            <div data-floating-target="floating" class="hidden z-[100] px-2 py-1.5 bg-slate-900 rounded-lg shadow-xl pointer-events-none text-white text-left max-w-[200px] whitespace-normal leading-tight">
              <p class="text-[8px] font-bold uppercase tracking-wider">Priority Room</p>
              <% if room_row.notes.present? %>
                <p class="mt-0.5 text-[9px] font-medium text-slate-300"><%= room_row.notes %></p>
              <% end %>
            </div>
          </div>
        <% end %>
      </div>
      
      <div class="flex items-center gap-1">
        <%# Smoking/Pets Icons %>
        <div class="flex items-center gap-1 mr-0.5">
          <div data-controller="floating" data-floating-trigger-value="hover" data-floating-placement-value="top" class="inline-flex">
            <div data-floating-target="reference" class="<%= room_row.smoking_color %> cursor-help">
              <%= room_row.smoking_icon %>
            </div>
            <div data-floating-target="floating" class="hidden z-[100] px-2 py-1 bg-white border border-slate-200 rounded-full shadow-xl pointer-events-none">
              <span class="text-[8px] font-bold uppercase tracking-wider text-slate-700 whitespace-nowrap"><%= room_row.smoking_label %></span>
            </div>
          </div>

          <div data-controller="floating" data-floating-trigger-value="hover" data-floating-placement-value="top" class="inline-flex">
            <div data-floating-target="reference" class="<%= room_row.pets_color %> cursor-help">
              <%= room_row.pets_icon %>
            </div>
            <div data-floating-target="floating" class="hidden z-[100] px-2 py-1 bg-white border border-slate-200 rounded-full shadow-xl pointer-events-none">
              <span class="text-[8px] font-bold uppercase tracking-wider text-slate-700 whitespace-nowrap"><%= room_row.pets_label %></span>
            </div>
          </div>
        </div>

        <%# Status Icon %>
        <% badge_meta = presenter.status_badge_meta(room_row.status, room_row.failure_note) %>
        <div data-controller="floating" data-floating-trigger-value="hover" data-floating-placement-value="top-start" class="inline-flex">
          <span data-floating-target="reference" class="<%= badge_meta[:container_class] %>">
            <div class="scale-90"><%= presenter.status_icon(room_row.status) %></div>
          </span>
          
          <div data-floating-target="floating" class="<%= badge_meta[:tooltip_wrapper_class] %>">
            <div class="flex items-center gap-2 <%= 'mb-2' if room_row.status == "inspection_failed" && room_row.failure_note.present? %>">
              <div class="<%= badge_meta[:icon_bg_class] %>">
                <div class="scale-90"><%= presenter.status_icon(room_row.status) %></div>
              </div>
              <span class="text-[10px] font-bold uppercase tracking-wider text-slate-700"><%= badge_meta[:label] %></span>
            </div>

            <% if room_row.status == "inspection_failed" && room_row.failure_note.present? %>
              <div class="mt-2 border-t border-slate-50 pt-2">
                <p class="text-[11px] font-medium text-rose-600 leading-relaxed italic"><%= room_row.failure_note %></p>
              </div>
            <% end %>
          </div>
        </div>
      </div>
    </div>

    <% if room_row.can_manage? && room_row.room_status_id.present? && room_row.has_actions? %>
      <div class="mt-0.5">
        <%= render "hotel_portal/room_status_board/room_actions", room_row: room_row, presenter: presenter %>
      </div>
    <% end %>
  </div>

  <% presenter.board_dates.each_with_index do |date, index| %>
    <% cell_meta = presenter.cell_meta(room, date) %>
    <div
      class="relative border-l <%= 'border-r' if index == presenter.board_dates.size - 1 %> border-slate-100 <%= presenter.summary_padding %> <%= cell_meta[:bg_class] %> <%= cell_meta[:is_interactable] ? 'cursor-pointer hover:bg-slate-50/50' : 'cursor-default' %> transition-colors"
      <% if cell_meta[:is_interactable] %>
        data-action="dblclick->room-block-modal#open"
        data-room-block-modal-date-param="<%= date.to_s %>"
        data-room-block-modal-room-number-param="<%= room[:room_number] %>"
        data-room-block-modal-room-type-id-param="<%= room_row.room_type.id %>"
        data-room-block-modal-room-type-name-param="<%= room_row.room_type.name %>"
      <% end %>
    >
      <%# Render Real Bookings %>
      <% presenter.blocks_for(room, date).each_with_index do |block, block_index| %>
        <% block_meta = presenter.block_meta(block) %>
        <div
          data-controller="floating"
          data-floating-trigger-value="hover"
          data-floating-placement-value="bottom"
          class="absolute z-10 overflow-hidden rounded-xl border <%= presenter.comfortable_mode? ? 'px-3 py-1.5' : 'px-1.5 py-1' %> shadow-sm <%= block_meta[:style_class] %> <%= block_meta[:clip_corner_class] %>"
          style="top: <%= presenter.block_top + (block_index * presenter.block_step) %>px; left: <%= block_meta[:left_offset] %>px; width: <%= block_meta[:width_calc] %>; <%= 'min-width: 88px;' if presenter.comfortable_mode? %>"
          data-floating-target="reference"
        >
          <p class="truncate <%= presenter.comfortable_mode? ? 'text-sm' : 'text-[11px]' %> font-bold"><%= block[:guest_name] %></p>
          <p class="truncate <%= presenter.comfortable_mode? ? 'text-xs' : 'text-[9px]' %> font-semibold uppercase tracking-wide"><%= block[:status].to_s.humanize.titleize %></p>

          <div data-floating-target="floating" class="hidden z-[100] w-64 p-3 bg-white border border-slate-200 rounded-xl shadow-xl pointer-events-none">
            <div class="flex items-center gap-2 mb-2">
              <div class="size-2 rounded-full <%= block_meta[:style_class].split(' ').first %>"></div>
              <span class="text-[10px] font-bold uppercase tracking-wider text-slate-500"><%= block[:status].to_s.humanize %></span>
            </div>
            <p class="text-sm font-bold text-slate-900"><%= block[:guest_name] %></p>
            <div class="mt-2 space-y-1">
              <div class="flex items-center gap-2 text-[11px] text-slate-600">
                <svg class="size-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" /></svg>
                <span><%= block[:check_in].strftime("%b %-d") %> — <%= block[:check_out].strftime("%b %-d, %Y") %></span>
              </div>
            </div>
          </div>
        </div>
      <% end %>

      <%# Render Maintenance Blocks %>
      <% presenter.maintenance_blocks_for(room, date).each_with_index do |block, block_index| %>
        <% 
          booking_count_at_this_start = presenter.booking_count_at(room, date)
          block_meta = presenter.maintenance_block_meta(block)
        %>
        <div
          data-controller="floating"
          data-floating-trigger-value="click"
          data-floating-placement-value="bottom"
          data-action="click->floating#toggle:stop"
          class="absolute z-10 overflow-hidden rounded-xl border border-slate-300 bg-slate-100 text-slate-600 <%= presenter.comfortable_mode? ? 'px-3 py-1.5' : 'px-1.5 py-1' %> shadow-sm <%= block_meta[:clip_corner_class] %>"
          style="top: <%= presenter.block_top + ((block_index + booking_count_at_this_start) * presenter.block_step) %>px; left: <%= block_meta[:left_offset] %>px; width: <%= block_meta[:width_calc] %>; <%= 'min-width: 88px;' if presenter.comfortable_mode? %>"
          data-floating-target="reference"
          title="<%= block[:reason] %>"
        >
          <div class="flex items-center gap-1.5 overflow-hidden">
            <svg class="size-3 shrink-0 opacity-60" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M11.423 3.007a.75.75 0 0 1 .577 0l8.5 3.333a.75.75 0 0 1 0 1.411l-8.5 3.333a.75.75 0 0 1-.577 0l-8.5-3.333a.75.75 0 0 1 0-1.411l8.5-3.333Z" /><path d="M4.318 10.387 11.423 13.173a.75.75 0 0 0 .577 0l7.105-2.786a.75.75 0 0 1 .536 1.398l-7.382 2.895a2.25 2.25 0 0 1-1.722 0l-7.382-2.895a.75.75 0 0 1 .536-1.398Z" /><path d="M4.318 14.887 11.423 17.673a.75.75 0 0 0 .577 0l7.105-2.786a.75.75 0 0 1 .536 1.398l-7.382 2.895a2.25 2.25 0 0 1-1.722 0l-7.382-2.895a.75.75 0 0 1 .536-1.398Z" /></svg>
            <p class="truncate <%= presenter.comfortable_mode? ? 'text-[11px]' : 'text-[9px]' %> font-black uppercase tracking-wider"><%= block[:block_type].humanize %></p>
          </div>

          <div data-floating-target="floating" class="hidden z-[100] w-64 p-3 bg-white border border-slate-200 rounded-xl shadow-xl">
            <div class="flex items-center gap-2 mb-2">
              <div class="size-2 rounded-full bg-slate-400"></div>
              <span class="text-[10px] font-bold uppercase tracking-wider text-slate-500">Room Block</span>
            </div>
            <p class="text-sm font-bold text-slate-900"><%= block[:block_type].humanize.titleize %></p>
            <p class="mt-1 text-xs text-slate-600 leading-relaxed italic">"<%= block[:reason] %>"</p>
            <div class="mt-3 space-y-1">
              <div class="flex items-center gap-2 text-[11px] text-slate-600">
                <svg class="size-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" /></svg>
                <span><%= block[:start_date].strftime("%b %-d") %> — <%= block[:end_date].strftime("%b %-d, %Y") %></span>
              </div>
            </div>

            <% if room_row.can_manage? %>
              <div class="mt-4 border-t border-slate-50 pt-3 flex gap-2">
                <button type="button"
                    data-action="click->room-block-modal#edit click->floating#hide"
                    data-room-block-modal-id-param="<%= block[:id] %>"
                    data-room-block-modal-room-number-param="<%= room[:room_number] %>"
                    data-room-block-modal-room-type-id-param="<%= room_row.room_type.id %>"
                    data-room-block-modal-room-type-name-param="<%= room_row.room_type.name %>"
                    data-room-block-modal-start-date-param="<%= block[:start_date].to_s %>"
                    data-room-block-modal-end-date-param="<%= block[:end_date].to_s %>"
                    data-room-block-modal-block-type-param="<%= block[:block_type] %>"
                    data-room-block-modal-reason-param="<%= block[:reason] %>"
                    data-room-block-modal-update-url-param="<%= hotel_room_block_path(current_hotel, block[:id], start_date: presenter.start_date, days: presenter.board_days, layout: presenter.board_layout) %>"
                    class="flex-1 rounded-xl border border-slate-200 bg-white px-3 py-2 text-[10px] font-bold uppercase tracking-wider text-slate-700 hover:bg-slate-50 transition-colors">
                  Edit Room Block
                </button>
                <%= button_to finish_hotel_room_block_path(current_hotel, block[:id], start_date: presenter.start_date, days: presenter.board_days, layout: presenter.board_layout), 
                    method: :post,
                    data: { 
                      turbo_confirm: "Mark this maintenance block as finished?",
                      floating_close: true
                    },
                    class: "flex-1 rounded-xl bg-emerald-50 px-3 py-2 text-[10px] font-bold uppercase tracking-wider text-emerald-600 hover:bg-emerald-100 transition-colors pointer-events-auto" do %>
                  Finish
                <% end %>
                <%= button_to hotel_room_block_path(current_hotel, block[:id], start_date: presenter.start_date, days: presenter.board_days, layout: presenter.board_layout), 
                    method: :delete,
                    data: { 
                      turbo_confirm: "Are you sure you want to remove this maintenance block?",
                      floating_close: true
                    },
                    class: "flex-1 rounded-xl bg-rose-50 px-3 py-2 text-[10px] font-bold uppercase tracking-wider text-rose-600 hover:bg-rose-100 transition-colors pointer-events-auto" do %>
                  Remove
                <% end %>
              </div>
            <% end %>
          </div>
        </div>
      <% end %>
    </div>
  <% end %>
</div>
