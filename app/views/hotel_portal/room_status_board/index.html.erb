<% content_for :body_controllers, 'room-block-modal' %>
<% content_for :body_attributes, '' %>

<div class="w-full <%= @presenter.page_spacing %>">
  <div class="<%= @presenter.container_padding %>">
    <div class="space-y-3.5">
      <%= render PanelsUI::PageHeader.new(title: "Room Status", description: "Live room status and occupancy timeline") do |header| %>
        <% header.with_caption do %>
          <div class="flex flex-wrap items-center gap-2">
            <span><%= current_hotel.name %></span>
            <span class="rounded-full border border-border bg-card px-3 py-1.5 text-xs font-semibold uppercase tracking-[0.08em] text-foreground shadow-sm">
              <%= @presenter.formatted_date_range %>
            </span>
          </div>
        <% end %>
      <% end %>
    </div>

    <div class="mt-4 space-y-2">
      <%# Navigation Toolbar %>
      <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 rounded-xl border border-border bg-card p-2 shadow-sm">
        <div class="flex flex-wrap items-center gap-3">
          <%= form_with url: hotel_room_status_board_path(current_hotel), method: :get, local: true, class: "flex items-center gap-2", data: { controller: "auto-submit", action: "change->auto-submit#submit" } do %>
            <%= hidden_field_tag :days, @presenter.board_days %>
            <%= hidden_field_tag :layout, @presenter.board_layout %>
            <%= date_field_tag :start_date, @presenter.start_date.to_s, class: "rounded-lg border border-border-interactive bg-card px-2 py-1 text-sm font-medium text-foreground shadow-sm focus:border-border-interactive focus:outline-none" %>
          <% end %>

          <div class="h-6 w-px bg-muted"></div>

          <%= form_with url: hotel_room_status_board_path(current_hotel), method: :get, local: true, class: "flex items-center gap-2", data: { controller: "auto-submit", action: "change->auto-submit#submit" } do %>
            <%= hidden_field_tag :start_date, @presenter.start_date.to_s %>
            <%= hidden_field_tag :layout, @presenter.board_layout %>
            <div class="flex items-center gap-2">
              <span class="text-[10px] font-bold uppercase tracking-wider text-muted-foreground">Days</span>
              <%= select_tag :days, options_for_select([7, 14, 21], @presenter.board_days), class: "rounded-lg border border-border-interactive bg-card px-2 py-1 text-sm font-medium text-foreground shadow-sm focus:border-border-interactive focus:outline-none" %>
            </div>
          <% end %>

          <div class="h-6 w-px bg-muted"></div>

          <div class="flex items-center rounded-lg border border-border bg-muted p-0.5">
            <%= link_to hotel_room_status_board_path(current_hotel, @board_query_params.merge(start_date: @presenter.prev_start_date)), class: "px-2.5 py-1 text-xs font-bold text-muted-foreground hover:text-foreground", title: "Previous #{@presenter.nav_step_days} days" do %>
              &larr; Prev
            <% end %>
            <%= link_to hotel_room_status_board_path(current_hotel, @board_query_params.merge(start_date: Date.current.to_s)), class: "rounded bg-card px-2.5 py-1 text-xs font-black text-foreground shadow-sm transition hover:bg-muted" do %>
              Today
            <% end %>
            <%= link_to hotel_room_status_board_path(current_hotel, @board_query_params.merge(start_date: @presenter.next_start_date)), class: "px-2.5 py-1 text-xs font-bold text-muted-foreground hover:text-foreground", title: "Next #{@presenter.nav_step_days} days" do %>
              Next &rarr;
            <% end %>
          </div>
        </div>

        <div class="px-2">
          <%= link_to hotel_room_status_board_path(current_hotel, @board_query_params.merge(start_date: @presenter.start_date.to_s, layout: @presenter.comfortable_mode? ? "compact" : "comfortable")), class: "flex items-center gap-2 text-xs font-bold uppercase tracking-wider text-muted-foreground hover:text-foreground transition-colors" do %>
            <div class="relative inline-flex h-4 w-7 items-center rounded-full <%= @presenter.compact_toggle_bg_class %> transition-colors">
              <span class="inline-block h-3 w-3 transform rounded-full bg-card transition-transform <%= @presenter.compact_toggle_dot_class %>"></span>
            </div>
            Compact Mode
          <% end %>
        </div>
      </div>

      <%# Status Legend %>
      <div class="rounded-xl border border-border bg-card p-2 shadow-sm overflow-x-auto whitespace-nowrap scrollbar-hide">
        <div class="flex flex-col gap-2">
          <div class="flex items-center gap-3">
            <span class="text-[9px] font-bold uppercase tracking-[0.12em] text-muted-foreground min-w-[80px]">Inventory Status</span>
            <div class="flex items-center gap-1.5">
              <% @presenter.filterable_statuses.each do |status| %>
                <% count = @presenter.status_count_badge(status) %>
                <span class="inline-flex items-center gap-1.5 rounded-full border px-2 py-0.5 text-[9px] font-bold uppercase tracking-wide <%= @presenter.status_style(status) %> transition-all hover:shadow-sm">
                  <%= @presenter.status_icon(status) %>
                  <%= status.humanize.titleize %>
                  <% if count %>
                    <span class="opacity-60 font-black">(<%= count %>)</span>
                  <% end %>
                </span>
              <% end %>
            </div>
          </div>

          <div class="h-px bg-muted w-full"></div>

          <div class="flex items-center gap-3">
            <span class="text-[9px] font-bold uppercase tracking-[0.12em] text-muted-foreground min-w-[80px]">Daily Occupancy</span>
            <div class="flex items-center gap-1.5">
              <% @presenter.occupancy_legend_items.each do |item| %>
                <span class="inline-flex items-center gap-1.5 rounded-full border <%= item[:border_class] %> <%= item[:bg_class] %> px-2 py-0.5 text-[9px] font-bold uppercase tracking-wide <%= item[:text_class] %>"><%= item[:label] %></span>
              <% end %>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <%= render "hotel_portal/room_status_board/board_grid", presenter: @presenter %>
</div>
