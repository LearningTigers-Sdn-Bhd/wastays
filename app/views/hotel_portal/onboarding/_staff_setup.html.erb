<section aria-labelledby="staff-drafts-heading" class="space-y-4">
  <div>
    <h2 id="staff-drafts-heading" class="text-base font-semibold">Draft staff</h2>
    <p class="mt-1 text-sm text-muted-foreground">Nothing is sent now. Invitations are created only after onboarding is successfully submitted.</p>
  </div>

  <% if presenter.read_only? %>
    <% if @staff_entries.any? %>
      <div class="divide-y divide-border border-y border-border">
        <% @staff_entries.each do |entry| %>
          <div class="grid gap-1 py-3 text-sm sm:grid-cols-3">
            <span class="font-medium"><%= entry["name"].presence || "Name not provided" %></span>
            <span><%= entry["email"] %></span>
            <span class="text-muted-foreground"><%= entry["role_name"] %></span>
          </div>
        <% end %>
      </div>
    <% else %>
      <p class="text-sm text-muted-foreground">No additional staff for now.</p>
    <% end %>
  <% else %>
    <% form_id = "onboarding-staff-drafts-form" %>
    <%= form_with url: hotel_onboarding_section_path(current_hotel, section_key: "staff_setup"), method: :patch, id: form_id, data: { controller: "onboarding-staff-drafts" } do %>
      <div class="space-y-3" data-onboarding-staff-drafts-target="list">
        <% @staff_entries.each_with_index do |entry, index| %>
          <%= render "staff_draft_row", entry: entry, index: index, staff_roles: @staff_roles %>
        <% end %>
      </div>
      <template data-onboarding-staff-drafts-target="template">
        <%= render "staff_draft_row", entry: {}, index: "NEW_RECORD", staff_roles: @staff_roles %>
      </template>
      <div class="mt-3">
        <%= render PanelsUI::Button.new(as: :button, variant: :secondary, size: :sm, data: { action: "onboarding-staff-drafts#add" }) do %>
          <%= app_icon "plus", class: "size-4", aria: { hidden: "true" } %><span>Add staff member</span>
        <% end %>
      </div>
    <% end %>
  <% end %>
</section>
