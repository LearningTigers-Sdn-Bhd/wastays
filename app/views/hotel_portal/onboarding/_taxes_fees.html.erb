<section aria-labelledby="onboarding-taxes-heading" class="space-y-5 border-t border-border pt-5">
  <div>
    <h2 id="onboarding-taxes-heading" class="text-base font-semibold">Statutory taxes</h2>
    <p class="mt-1 text-sm text-muted-foreground">These apply to every room night once enabled. You assign them to room revenue on the next step.</p>
  </div>

  <% if presenter.read_only? %>
    <dl class="grid gap-3 sm:grid-cols-2">
      <div class="rounded-md border border-border p-3">
        <dt class="text-sm font-medium">Service Tax (SST)</dt>
        <dd class="text-sm text-muted-foreground"><%= current_hotel.sst_enabled? ? "Charged at 8%" : "Not charged" %></dd>
      </div>
      <div class="rounded-md border border-border p-3">
        <dt class="text-sm font-medium">Tourism Tax (TTx)</dt>
        <dd class="text-sm text-muted-foreground">
          <%= current_hotel.tourism_tax_enabled? ? "#{current_hotel.default_currency.presence || 'MYR'} #{number_with_precision(current_hotel.tourism_tax_amount, precision: 2)} per night" : "Not charged" %>
        </dd>
      </div>
    </dl>

    <div>
      <h2 class="text-base font-semibold">Property taxes and fees</h2>
      <% if @tax_entries.any? %>
        <div class="mt-3 divide-y divide-border border-y border-border">
          <% @tax_entries.each do |entry| %>
            <div class="grid gap-1 py-3 text-sm sm:grid-cols-4">
              <span class="font-medium"><%= entry["name"] %></span>
              <span class="text-muted-foreground"><%= entry["charge_type"] == "tax" ? "Tax" : "Fee" %></span>
              <span><%= entry["rate_type"] == "percentage" ? "#{entry['amount']}%" : "#{current_hotel.default_currency.presence || 'MYR'} #{entry['amount']}" %></span>
              <span class="text-muted-foreground"><%= entry["enabled"] == "false" ? "Not charged" : "Charged" %></span>
            </div>
          <% end %>
        </div>
      <% else %>
        <p class="mt-2 text-sm text-muted-foreground">No property taxes or fees were added.</p>
      <% end %>
    </div>
  <% else %>
    <% form_id = "onboarding-taxes-fees-form" %>
    <%= form_with url: hotel_onboarding_section_path(current_hotel, section_key: "taxes_fees"), method: :patch, id: form_id, data: { controller: "onboarding-hotel-taxes" } do %>
      <%= fields_for :hotel, current_hotel do |hotel_form| %>
        <div class="space-y-4">
          <%= render PanelsUI::Switch.new(
                form: hotel_form,
                attribute: :sst_enabled,
                label: "Service Tax (SST)",
                description: "Charged at the statutory 8% on room revenue. The rate is set by law and cannot be changed here.",
                variant: :card,
                checked: current_hotel.sst_enabled?) %>

          <%= render PanelsUI::Switch.new(
                form: hotel_form,
                attribute: :tourism_tax_enabled,
                label: "Tourism Tax (TTx)",
                description: "A fixed amount per room per night, charged to foreign guests.",
                variant: :card,
                checked: current_hotel.tourism_tax_enabled?) %>

          <div class="max-w-xs">
            <%= render PanelsUI::FormField.new(
                  form: hotel_form,
                  attribute: :tourism_tax_amount,
                  label: "Tourism tax per night",
                  hint: "Required when tourism tax is charged.") do |field| %>
              <% field.with_input(type: :number, step: "0.01", min: "0", inputmode: "decimal") %>
            <% end %>
          </div>
        </div>
      <% end %>

      <div class="mt-6 space-y-1">
        <h2 class="text-base font-semibold">Property taxes and fees</h2>
        <p class="text-sm text-muted-foreground">Add any mandatory charge your property applies on top of the statutory taxes. Optional extras guests choose to buy come later.</p>
      </div>

      <% if @tax_entries.empty? %>
        <p class="mt-3 rounded-md border border-dashed border-border px-3 py-4 text-sm text-muted-foreground" data-onboarding-hotel-taxes-target="empty">
          No property taxes or fees yet. Most properties charge none beyond the statutory taxes above.
        </p>
      <% end %>

      <div class="mt-3 space-y-3" data-onboarding-hotel-taxes-target="list">
        <% @tax_entries.each_with_index do |entry, index| %>
          <%= render "hotel_tax_row", entry: entry, index: index %>
        <% end %>
      </div>
      <template data-onboarding-hotel-taxes-target="template">
        <%= render "hotel_tax_row", entry: {}, index: "NEW_RECORD" %>
      </template>

      <div class="mt-3">
        <%= render PanelsUI::Button.new(as: :button, variant: :secondary, size: :sm, data: { action: "onboarding-hotel-taxes#add" }) do %>
          <%= app_icon "plus", class: "size-4", aria: { hidden: "true" } %><span>Add tax or fee</span>
        <% end %>
      </div>

      <div class="mt-6 border-t border-border pt-4">
        <%= render PanelsUI::Checkbox.new(
              name: "confirm_taxes",
              id: "confirm-taxes",
              value: "1",
              checked: presenter.current_entry.record.state == "complete",
              label: "I confirm these are the taxes and fees this property charges",
              description: "You can change them later in Settings, but room revenue will need reviewing again if you do.") %>
      </div>
    <% end %>

    <%= render "form_actions", presenter: presenter, form_id: form_id %>
  <% end %>
</section>
