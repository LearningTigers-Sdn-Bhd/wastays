<%# The shell heads the step. The taxes law requires and the property's own are
    peer groups within it, so neither heading labels the page as a whole. They
    take the full width in one reading order; only the related fields within each
    statutory tax form a row on larger screens. %>
<% if presenter.read_only? %>
  <div class="space-y-6">
    <section class="space-y-3">
      <div>
        <h2 class="text-base font-semibold">Taxes required by law</h2>
        <p class="mt-1 text-sm text-muted-foreground">Turn on the ones this property charges. They apply to every room night. You add them to room revenue on the next step.</p>
      </div>

      <dl class="grid gap-3 sm:grid-cols-2 lg:grid-cols-1">
        <div class="rounded-md border border-border p-3">
          <dt class="text-sm font-medium">Service Tax (SST)</dt>
          <dd class="text-sm text-muted-foreground"><%= current_hotel.sst_enabled? ? "Charged at 8%" : "Not charged" %></dd>
          <dd class="mt-0.5 text-xs text-muted-foreground">
            <%= current_hotel.sst_registration_number.presence ? "Tax number #{current_hotel.sst_registration_number}" : "No tax number" %>
          </dd>
        </div>
        <div class="rounded-md border border-border p-3">
          <dt class="text-sm font-medium">Tourism Tax (TTx)</dt>
          <dd class="text-sm text-muted-foreground">
            <%= current_hotel.tourism_tax_enabled? ? "#{current_hotel.default_currency.presence || 'MYR'} #{number_with_precision(current_hotel.tourism_tax_amount, precision: 2)} per night" : "Not charged" %>
          </dd>
          <dd class="mt-0.5 text-xs text-muted-foreground">
            <%= current_hotel.tourism_tax_registration_number.presence ? "Tax number #{current_hotel.tourism_tax_registration_number}" : "No tax number" %>
          </dd>
        </div>
      </dl>
    </section>

    <section aria-labelledby="onboarding-property-taxes-heading" class="space-y-3">
      <h2 id="onboarding-property-taxes-heading" class="text-base font-semibold">Property taxes and fees</h2>
      <% if @tax_entries.any? %>
        <%= render PanelsUI::Table.new(caption: "Property taxes and fees", header_style: :sentence,
                                       wrapper_class: "rounded-md border border-border bg-card") do |table| %>
          <% table.with_header do %>
            <tr>
              <th scope="col">Name</th>
              <th scope="col">Tax number</th>
              <th scope="col">Type</th>
              <th scope="col">Amount</th>
            </tr>
          <% end %>
          <% table.with_body do %>
            <% @tax_entries.each do |entry| %>
              <tr>
                <td class="font-medium"><%= entry["name"] %></td>
                <td class="font-mono text-muted-foreground"><%= entry["registration_number"].presence || "—" %></td>
                <td class="text-muted-foreground"><%= entry["charge_type"] == "tax" ? "Tax" : "Fee" %></td>
                <td class="tabular-nums"><%= entry["rate_type"] == "percentage" ? "#{entry['amount']}%" : "#{current_hotel.default_currency.presence || 'MYR'} #{entry['amount']}" %></td>
              </tr>
            <% end %>
          <% end %>
        <% end %>
      <% else %>
        <p class="text-sm text-muted-foreground">No property taxes or fees were added.</p>
      <% end %>
    </section>
  </div>
<% else %>
  <% currency = current_hotel.default_currency.presence || "MYR" %>
  <%= form_with url: hotel_onboarding_section_path(current_hotel, section_key: "taxes_fees"), method: :patch, id: "onboarding-taxes-fees-form" do %>
    <div class="space-y-6">
      <section class="space-y-4">
        <div>
          <h2 class="text-base font-semibold">Taxes required by law</h2>
          <p class="mt-1 text-sm text-muted-foreground">Turn on the ones this property charges. They apply to every room night. You add them to room revenue on the next step.</p>
        </div>

        <%= fields_for :hotel, current_hotel do |hotel_form| %>
          <div class="space-y-4">
            <div id="onboarding-sst-fields" class="flex flex-col items-start gap-4 lg:flex-row lg:flex-wrap lg:justify-start">
              <%# Plain switches, not cards. The heading already groups the
                  statutory taxes, so another boundary would duplicate it. %>
              <div class="flex w-full items-start justify-start lg:w-auto lg:max-w-sm">
                <%= render PanelsUI::Switch.new(
                      form: hotel_form,
                      attribute: :sst_enabled,
                      label: "Service Tax (SST)",
                      description: "8% on room revenue. The law sets this rate, so you cannot change it here.",
                      checked: current_hotel.sst_enabled?) %>
              </div>

              <%# Always shown rather than revealed by the switch: the hint
                  carries the condition without moving the rest of the form. %>
              <%= render PanelsUI::FormField.new(
                    form: hotel_form,
                    attribute: :sst_registration_number,
                    label: "SST number",
                    hint: "Needed if you charge SST.",
                    class: "lg:w-64") do |field| %>
                <% field.with_input(autocomplete: "off", spellcheck: false, class: "font-mono uppercase") %>
              <% end %>
            </div>

            <div id="onboarding-tourism-tax-fields" class="flex flex-col items-start gap-4 lg:flex-row lg:flex-wrap lg:justify-start">
              <div class="flex w-full items-start justify-start lg:w-auto lg:max-w-sm">
                <%= render PanelsUI::Switch.new(
                      form: hotel_form,
                      attribute: :tourism_tax_enabled,
                      label: "Tourism Tax (TTx)",
                      description: "A set amount per room, per night, charged to foreign guests only.",
                      checked: current_hotel.tourism_tax_enabled?) %>
              </div>

              <%= render PanelsUI::FormField.new(
                    form: hotel_form,
                    attribute: :tourism_tax_registration_number,
                    label: "Tourism tax number",
                    hint: "Needed if you charge tourism tax.",
                    class: "lg:w-64") do |field| %>
                <% field.with_input(autocomplete: "off", spellcheck: false, class: "font-mono uppercase") %>
              <% end %>

              <%# The unit rides the field rather than its label: the currency
                  leads the figure and the period trails it. %>
              <%= render PanelsUI::FormField.new(
                    form: hotel_form,
                    attribute: :tourism_tax_amount,
                    label: "Tourism tax amount",
                    hint: "Needed if you charge tourism tax.",
                    class: "lg:w-72") do |field| %>
                <% field.with_input(type: :number, step: "0.01", min: "0", inputmode: "decimal") %>
                <% field.with_addon(align: :inline_start) { currency } %>
                <% field.with_addon(align: :inline_end) { "per night" } %>
              <% end %>
            </div>
          </div>
        <% end %>
      </section>

      <section aria-labelledby="onboarding-property-taxes-heading" class="space-y-3">
        <div class="space-y-1">
          <h2 id="onboarding-property-taxes-heading" class="text-base font-semibold">Property taxes and fees</h2>
          <p class="text-sm text-muted-foreground">Add anything else guests must pay on top of the taxes above. Extras guests choose to buy come later.</p>
        </div>

        <%= render HotelPortal::Setup::RecordTable.new(
              caption: "Property taxes and fees",
              add_label: "Add tax or fee",
              empty: "No property taxes or fees yet",
              empty_description: "Most properties charge nothing beyond the taxes above.",
              empty_icon: "receipt-text") do |table| %>
          <% table.with_column(label: "Name", required: true) %>
          <% table.with_column(label: "Tax number") %>
          <% table.with_column(label: "Type") %>
          <% table.with_column(label: "Amount", required: true) %>
          <% table.with_column(label: "Foreign guests only") %>

          <% @tax_entries.each_with_index do |entry, index| %>
            <% table.with_row(remove_label: "Remove #{entry['name'].presence || 'this tax or fee'}") do %>
              <%= render "hotel_tax_row", entry: entry, index: index %>
            <% end %>
          <% end %>

          <% table.with_blank_row(remove_label: "Remove this tax or fee") do %>
            <%= render "hotel_tax_row", entry: {}, index: "NEW_RECORD" %>
          <% end %>
        <% end %>
      </section>
    </div>

    <div class="mt-6">
      <%= render PanelsUI::Checkbox.new(
            name: "confirm_taxes",
            id: "confirm-taxes",
            value: "1",
            checked: presenter.current_entry.record.state == "complete",
            label: "I confirm these are the taxes and fees this property charges",
            description: "You can change them later in Settings. If you do, you will need to check room revenue again.") %>
    </div>
  <% end %>
<% end %>
