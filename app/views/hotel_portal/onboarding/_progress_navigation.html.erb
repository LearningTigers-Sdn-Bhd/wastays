<div class="space-y-3 border-b border-border pb-5">
  <nav aria-label="Onboarding progress" class="hidden md:block">
    <ol class="grid grid-cols-6 gap-2">
      <% presenter.phases.each_with_index do |phase, index| %>
        <% destination = phase.entries.first %>
        <li class="min-w-0">
          <% content = capture do %>
            <span class="flex items-center gap-2">
              <span class="flex size-6 shrink-0 items-center justify-center rounded-full border border-border text-xs font-medium" aria-hidden="true"><%= index + 1 %></span>
              <span class="truncate"><%= phase.label %></span>
            </span>
            <span class="mt-1 block pl-8 text-xs text-muted-foreground"><%= onboarding_state_label(phase.state) %></span>
          <% end %>
          <% if destination.available %>
            <%= link_to onboarding_section_path_for(destination),
                        class: "block rounded-md border px-3 py-2 text-sm font-medium transition-colors focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring #{phase.current ? 'border-primary bg-primary text-primary-foreground' : 'border-border bg-card text-card-foreground hover:bg-muted'}",
                        aria: (phase.current ? { current: "step" } : {}) do %>
              <%= content %>
            <% end %>
          <% else %>
            <div class="rounded-md border border-border bg-muted px-3 py-2 text-sm text-muted-foreground" aria-disabled="true" title="Complete the earlier phases first">
              <%= content %>
            </div>
          <% end %>
        </li>
      <% end %>
    </ol>
  </nav>

  <details class="rounded-md border border-border bg-card md:hidden">
    <summary class="flex min-h-11 cursor-pointer list-none items-center justify-between gap-3 px-3 py-2 text-sm font-medium focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring">
      <span><%= presenter.phase_label %> · Phase <%= presenter.phase_position %> of <%= presenter.phases.length %></span>
      <%= app_icon "chevron-down", class: "size-4 text-muted-foreground", aria: { hidden: "true" } %>
    </summary>
    <ol class="space-y-1 border-t border-border p-2">
      <% presenter.phases.each_with_index do |phase, index| %>
        <% destination = phase.entries.first %>
        <li>
          <% if destination.available %>
            <%= link_to onboarding_section_path_for(destination), class: "flex min-h-10 items-center justify-between gap-2 rounded-md px-2 py-1.5 text-sm hover:bg-muted focus-visible:outline-2 focus-visible:outline-ring", aria: (phase.current ? { current: "step" } : {}) do %>
              <span><%= index + 1 %>. <%= phase.label %></span>
              <span class="text-xs text-muted-foreground"><%= onboarding_state_label(phase.state) %></span>
            <% end %>
          <% else %>
            <span class="flex min-h-10 items-center justify-between gap-2 rounded-md px-2 py-1.5 text-sm text-muted-foreground" aria-disabled="true">
              <span><%= index + 1 %>. <%= phase.label %></span>
              <span class="text-xs">Locked</span>
            </span>
          <% end %>
        </li>
      <% end %>
    </ol>
  </details>

  <% if presenter.active_phase_entries.many? %>
    <nav aria-label="<%= presenter.phase_label %> steps">
      <ol class="flex flex-wrap gap-2">
        <% presenter.active_phase_entries.each_with_index do |entry, index| %>
          <li>
            <% label = "#{index + 1}. #{presenter.section_title(entry)}" %>
            <% if entry.available %>
              <%= link_to label, onboarding_section_path_for(entry),
                          class: "inline-flex min-h-8 items-center rounded-md border px-3 py-1.5 text-sm font-medium focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring #{entry == presenter.current_entry ? 'border-primary bg-primary text-primary-foreground' : 'border-border bg-card hover:bg-muted'}",
                          aria: (entry == presenter.current_entry ? { current: "step" } : {}) %>
            <% else %>
              <span class="inline-flex min-h-8 items-center rounded-md border border-border bg-muted px-3 py-1.5 text-sm text-muted-foreground" aria-disabled="true"><%= label %> · Locked</span>
            <% end %>
          </li>
        <% end %>
      </ol>
    </nav>
  <% end %>
</div>
