<%# The record table owns the row and its remove control; this partial supplies
    only the field cells.

    The password is the one field that never renders its stored value. Rails'
    password_field omits the value by default, so what an owner sees is an empty
    box whose placeholder says whether one is already on file. %>
<% object = HotelOtaCredential.new(
     channel_name: entry["channel_name"],
     property_code: entry["property_code"],
     username: entry["username"],
     market_manager_name: entry["market_manager_name"],
     market_manager_phone: entry["market_manager_phone"],
     market_manager_email: entry["market_manager_email"]
   ) %>
<% password_saved = entry["password_saved"] == "true" %>
<% password_typed = entry["password_typed"] == "true" %>
<%= fields_for "ota_credential_entries[#{index}]", object do |row_form| %>
  <td>
    <%= row_form.hidden_field :id, value: entry["id"] %>
    <%= hidden_field_tag "ota_credential_entries[#{index}][_destroy]", "false", data: { record_table_destroy: true } %>
    <%= render PanelsUI::FormField.new(form: row_form, attribute: :channel_name, label: "Channel", size: :sm, required: true) do |field| %>
      <% field.with_input(placeholder: "Booking.com") %>
    <% end %>
  </td>

  <td>
    <%= render PanelsUI::FormField.new(form: row_form, attribute: :property_code, label: "Property ID", size: :sm) do |field| %>
      <% field.with_input(placeholder: "623847") %>
    <% end %>
  </td>

  <td>
    <%= render PanelsUI::FormField.new(form: row_form, attribute: :username, label: "Username", size: :sm) do |field| %>
      <% field.with_input(autocomplete: "off") %>
    <% end %>
  </td>

  <td>
    <%# autocomplete="new-password" keeps the operator's own browser from
        offering their WAStays password for an OTA extranet field. %>
    <%= render PanelsUI::FormField.new(form: row_form, attribute: :password, label: "Password", size: :sm) do |field| %>
      <% field.with_input(
           type: :password,
           autocomplete: "new-password",
           placeholder: if password_typed
                          "Re-enter to save"
                        elsif password_saved
                          "Saved — leave blank to keep"
                        end) %>
    <% end %>
  </td>

  <td>
    <%= render PanelsUI::FormField.new(form: row_form, attribute: :market_manager_name, label: "Market manager", size: :sm) do |field| %>
      <% field.with_input(placeholder: "Optional") %>
    <% end %>
  </td>

  <td>
    <%= render PanelsUI::FormField.new(form: row_form, attribute: :market_manager_phone, label: "Market manager phone", size: :sm) do |field| %>
      <% field.with_input(type: :tel, autocomplete: "off", placeholder: "Optional") %>
    <% end %>
  </td>

  <td>
    <%= render PanelsUI::FormField.new(form: row_form, attribute: :market_manager_email, label: "Market manager email", size: :sm) do |field| %>
      <% field.with_input(type: :email, autocomplete: "off", placeholder: "Optional") %>
    <% end %>
  </td>
<% end %>
