<% if presenter.read_only? %>
  <section aria-labelledby="property-summary-heading" class="space-y-4">
    <h2 id="property-summary-heading" class="text-base font-semibold">Property summary</h2>
    <dl class="grid gap-4 text-sm sm:grid-cols-2 lg:grid-cols-3">
      <% {
        "Legal account" => current_hotel.account.name,
        "Property name" => current_hotel.name,
        "Address" => [current_hotel.address, current_hotel.city, current_hotel.country].compact_blank.join(", "),
        "Timezone" => current_hotel.time_zone,
        "Default currency" => current_hotel.default_currency,
        "Contact" => [current_hotel.contact_email, current_hotel.contact_phone].compact_blank.join(" · "),
        "Stay times" => [current_hotel.property_policy&.check_in_time, current_hotel.property_policy&.check_out_time].compact_blank.join(" – "),
        "Photos" => pluralize(current_hotel.photos.count, "photo")
      }.each do |label, value| %>
        <div class="space-y-1">
          <dt class="text-xs text-muted-foreground"><%= label %></dt>
          <dd class="font-medium text-foreground"><%= value.presence || "Not provided" %></dd>
        </div>
      <% end %>
    </dl>
  </section>
<% else %>
  <% amenity_choices = Hotel::CATEGORIZED_HOTEL_AMENITIES.to_h { |category| [category[:category], category[:items].map { |amenity| [amenity[:name], amenity[:id]] }] } %>
  <% form_id = "onboarding-property-profile-form" %>
  <%= form_with model: current_hotel,
                url: hotel_onboarding_section_path(current_hotel, section_key: "property_profile"),
                method: :patch,
                id: form_id,
                class: "space-y-8" do |form| %>
    <section aria-labelledby="property-identity-heading" class="space-y-4">
      <div>
        <h2 id="property-identity-heading" class="text-base font-semibold">Identity and guest details</h2>
        <p class="mt-1 text-sm text-muted-foreground">The legal account was created by WAStays. Complete the property details guests and integrations will use.</p>
      </div>
      <div class="grid gap-4 sm:grid-cols-2">
        <div class="space-y-1">
          <p class="text-sm font-medium">Legal account</p>
          <p class="text-sm text-muted-foreground"><%= current_hotel.account.name %></p>
        </div>
        <%= render PanelsUI::FormField.new(form: form, attribute: :name, label: "Property name", required: true) do |field| %>
          <% field.with_input %>
        <% end %>
        <%= render PanelsUI::FormField.new(form: form, attribute: :star_rating, label: "Star rating") do |field| %>
          <% field.with_select_menu(@profile_presenter.star_rating_options, prompt: "Select rating", selected: current_hotel.star_rating) %>
        <% end %>
        <%= render PanelsUI::FormField.new(form: form, attribute: :description, label: "Property description", hint: "Describe the property’s character and key guest experience.", class: "sm:col-span-2") do |field| %>
          <% field.with_text_area(rows: 4) %>
        <% end %>
        <%= render PanelsUI::FormField.new(form: form, attribute: :amenities, label: "Property amenities", class: "sm:col-span-2") do |field| %>
          <% field.with_multi_select(amenity_choices, selected: current_hotel.amenities, prompt: "Search amenities", empty_text: "No amenities found") %>
        <% end %>
      </div>
    </section>

    <section aria-labelledby="property-location-heading" class="space-y-4">
      <h2 id="property-location-heading" class="text-base font-semibold">Location and operating defaults</h2>
      <div class="grid gap-4 sm:grid-cols-2">
        <%= render PanelsUI::FormField.new(form: form, attribute: :address, label: "Address", required: true, class: "sm:col-span-2") do |field| %>
          <% field.with_text_area(rows: 3) %>
        <% end %>
        <%= render PanelsUI::FormField.new(form: form, attribute: :city, label: "City", required: true) do |field| %>
          <% field.with_input %>
        <% end %>
        <%= render PanelsUI::FormField.new(form: form, attribute: :country, label: "Country", required: true) do |field| %>
          <% field.with_input %>
        <% end %>
        <%= render PanelsUI::FormField.new(form: form, attribute: :time_zone, label: "Timezone", required: true) do |field| %>
          <% field.with_select_menu(ActiveSupport::TimeZone.all.map { |zone| [zone.to_s, zone.name] }, prompt: "Select timezone", selected: current_hotel.time_zone) %>
        <% end %>
        <%= render PanelsUI::FormField.new(form: form, attribute: :default_currency, label: "Default currency", required: true) do |field| %>
          <% field.with_select_menu(CurrencyCatalog.options, selected: current_hotel.default_currency) %>
        <% end %>
        <%= render PanelsUI::FormField.new(form: form, attribute: :google_map_link, label: "Google Maps URL", class: "sm:col-span-2") do |field| %>
          <% field.with_input(type: :url, placeholder: "https://www.google.com/maps/place/…") %>
        <% end %>
      </div>
    </section>

    <section aria-labelledby="property-contact-heading" class="space-y-4">
      <h2 id="property-contact-heading" class="text-base font-semibold">Property contact</h2>
      <div class="grid gap-4 sm:grid-cols-2">
        <%= render PanelsUI::FormField.new(form: form, attribute: :contact_email, label: "Contact email", required: true) do |field| %>
          <% field.with_input(type: :email) %>
        <% end %>
        <%= render PanelsUI::FormField.new(form: form, attribute: :contact_phone, label: "Contact phone", required: true) do |field| %>
          <% field.with_input(type: :tel) %>
        <% end %>
        <%= render PanelsUI::FormField.new(form: form, attribute: :whatsapp_number, label: "WhatsApp number", hint: "Optional; include the international dialling code.") do |field| %>
          <% field.with_input(type: :tel) %>
        <% end %>
      </div>
    </section>

    <section aria-labelledby="property-policy-heading" class="space-y-4">
      <div>
        <h2 id="property-policy-heading" class="text-base font-semibold">Stay times</h2>
        <p class="mt-1 text-sm text-muted-foreground">Cancellation and posting rules are configured later with room revenue.</p>
      </div>
      <%= fields_for :property_policy, (current_hotel.property_policy || current_hotel.build_property_policy) do |policy_form| %>
        <div class="grid gap-4 sm:grid-cols-2">
          <%= render PanelsUI::FormField.new(form: policy_form, attribute: :check_in_time, label: "Standard check-in time", required: true) do |field| %>
            <% field.with_time_picker %>
          <% end %>
          <%= render PanelsUI::FormField.new(form: policy_form, attribute: :check_out_time, label: "Standard check-out time", required: true) do |field| %>
            <% field.with_time_picker %>
          <% end %>
        </div>
      <% end %>
    </section>
  <% end %>

  <section class="space-y-4" aria-labelledby="property-photos-heading"
           data-controller="hotel-photo-queue"
           data-hotel-photo-queue-upload-url-value="<%= hotel_profile_photo_queue_path(current_hotel) %>"
           data-hotel-photo-queue-clear-url-value="<%= hotel_clear_profile_photo_queue_path(current_hotel) %>"
           data-hotel-photo-queue-commit-url-value="<%= hotel_commit_profile_photo_queue_path(current_hotel) %>"
           data-hotel-photo-queue-remove-url-template-value="<%= hotel_profile_photo_queue_item_path(current_hotel, "__SIGNED_ID__") %>"
           data-hotel-photo-queue-existing-count-value="<%= current_hotel.photos.count %>"
           data-hotel-photo-queue-max-count-value="<%= Hotel::MAX_PHOTOS %>"
           data-action="change->hotel-photo-queue#queueSelectedFiles">
    <div class="flex flex-wrap items-start justify-between gap-3">
      <div>
        <h2 id="property-photos-heading" class="text-base font-semibold">Property photos</h2>
        <p class="mt-1 text-sm text-muted-foreground">Upload guest-facing photos and choose one featured photo before continuing.</p>
      </div>
      <%= render PanelsUI::Button.new(as: :button, command: "show-modal", commandfor: "hotel-photo-upload-sheet", size: :sm) do %>
        <%= app_icon "upload", class: "size-4", aria: { hidden: "true" } %><span>Upload photos</span>
      <% end %>
    </div>
    <%= render "hotel_portal/profiles/published_photos", hotel: current_hotel, return_to: "onboarding" %>
    <%= render "hotel_portal/profiles/photo_upload_sheet", hotel: current_hotel, queued_photo_items: @profile_presenter.queued_photo_items %>
  </section>

<% end %>
