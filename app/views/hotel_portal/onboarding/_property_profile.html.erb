<% if presenter.read_only? %>
  <section aria-labelledby="property-summary-heading" class="space-y-4">
    <h2 id="property-summary-heading" class="text-base font-semibold">Property summary</h2>
    <dl class="grid gap-4 text-sm sm:grid-cols-2 lg:grid-cols-3">
      <% {
        "Legal account" => current_hotel.account.name,
        "Property name" => current_hotel.name,
        "TIN" => current_hotel.tin,
        "SSM No." => current_hotel.ssm_number,
        "Local government" => current_hotel.local_government_name,
        "License No." => current_hotel.local_government_license_number,
        "Address" => [current_hotel.address, current_hotel.city, current_hotel.country].compact_blank.join(", "),
        "Timezone" => current_hotel.time_zone,
        "Default currency" => current_hotel.default_currency,
        "Contact" => [current_hotel.contact_email, current_hotel.contact_phone, current_hotel.fixed_line_number].compact_blank.join(" · "),
        "Stay times" => [current_hotel.property_policy&.check_in_time, current_hotel.property_policy&.check_out_time].compact_blank.join(" – "),
        "Business day" => [current_hotel.business_starts_at, current_hotel.business_ends_at].compact.map { |time| time.strftime("%H:%M") }.join(" – ")
      }.each do |label, value| %>
        <div class="space-y-1">
          <dt class="text-xs text-muted-foreground"><%= label %></dt>
          <dd class="font-medium text-foreground"><%= value.presence || "Not provided" %></dd>
        </div>
      <% end %>
    </dl>
  </section>
<% else %>
  <% amenity_choices = Hotel::CATEGORIZED_HOTEL_AMENITIES.to_h { |category| [category[:category], category[:items].map { |amenity| [amenity[:name], amenity[:id]] }] } %>
  <% form_id = "onboarding-property-profile-form" %>
  <%= form_with model: current_hotel,
                url: hotel_onboarding_section_path(current_hotel, section_key: "property_profile"),
                method: :patch,
                id: form_id,
                # Each section owns one cell of the desktop grid, so the step reads as
                # four side-by-side groups rather than one long column.
                class: "grid grid-cols-1 items-start gap-x-8 gap-y-10 lg:grid-cols-2" do |form| %>
    <%# The shell already owns the Property profile heading and introduction, so
        this first grid cell opens directly into the fields. %>
    <section aria-label="Identity and guest details" class="space-y-4">
      <div class="grid gap-4 sm:grid-cols-2">
        <%= render PanelsUI::FormField.new(form: form, attribute: :name, label: "Property name", required: true, class: "sm:col-span-2") do |field| %>
          <% field.with_input %>
        <% end %>
        <%# The account is fixed for the life of the hotel, so it is shown in the
            same control shape as the editable fields but never submitted — hence
            the blank name. %>
        <%= render PanelsUI::FormField.new(form: form, attribute: :account_name, label: "Legal account", readonly: true, hint: "Set when the account was created.") do |field| %>
          <% field.with_input(value: current_hotel.account.name, name: "") %>
        <% end %>
        <%= render PanelsUI::FormField.new(form: form, attribute: :star_rating, label: "Star rating") do |field| %>
          <% field.with_select_menu(@profile_presenter.star_rating_options, prompt: "Select rating", selected: current_hotel.star_rating) %>
        <% end %>
        <%= render PanelsUI::FormField.new(form: form, attribute: :description, label: "Property description", hint: "Describe the property’s character and key guest experience.", class: "sm:col-span-2") do |field| %>
          <% field.with_text_area(rows: 4, placeholder: "Describe the property’s atmosphere, highlights, and guest experience.") %>
        <% end %>
        <%= render PanelsUI::FormField.new(form: form, attribute: :amenities, label: "Property amenities", class: "sm:col-span-2") do |field| %>
          <% field.with_multi_select(amenity_choices, selected: current_hotel.amenities, prompt: "Search amenities", empty_text: "No amenities found") %>
        <% end %>
        <%# The company's own numbers, so they belong with its identity rather than
            on the taxes step. Both optional — a property is perfectly usable before
            its registrations come through, and neither gates finishing setup. %>
        <%= render PanelsUI::FormField.new(form: form, attribute: :tin, label: "TIN", hint: "Tax Identification Number issued by LHDN. You can add this later.") do |field| %>
          <% field.with_input(autocomplete: "off", spellcheck: false, placeholder: "e.g., C1234567890", class: "font-mono uppercase") %>
        <% end %>
        <%= render PanelsUI::FormField.new(form: form, attribute: :ssm_number, label: "SSM No.", hint: "Company registration number.") do |field| %>
          <% field.with_input(autocomplete: "off", spellcheck: false, placeholder: "e.g., 202301012345 (1234567-A)", class: "font-mono uppercase") %>
        <% end %>
        <%# The council that licenses the property to trade. Free text: every local
            authority abbreviates itself differently and properties quote the
            acronym their licence carries. %>
        <%= render PanelsUI::FormField.new(form: form, attribute: :local_government_name, label: "Local government name", hint: "The local authority that issued the premises licence.") do |field| %>
          <% field.with_input(autocomplete: "off", placeholder: "e.g., DBKK, MDP, MPSJ, DBKL") %>
        <% end %>
        <%= render PanelsUI::FormField.new(form: form, attribute: :local_government_license_number, label: "License number", hint: "The licence number issued by that local authority.") do |field| %>
          <% field.with_input(autocomplete: "off", spellcheck: false, placeholder: "e.g., PL/2026/001234", class: "font-mono uppercase") %>
        <% end %>
      </div>
    </section>

    <section aria-labelledby="property-location-heading" class="space-y-4">
      <h2 id="property-location-heading" class="text-base font-semibold">Location and operating defaults</h2>
      <div class="grid items-start gap-4 sm:grid-cols-2">
        <%= render PanelsUI::FormField.new(form: form, attribute: :address, label: "Address", required: true, class: "sm:col-span-2") do |field| %>
          <% field.with_text_area(rows: 3, placeholder: "e.g., 12 Jalan Sultan Ismail\n50250 Kuala Lumpur") %>
        <% end %>
        <%= render PanelsUI::FormField.new(form: form, attribute: :city, label: "City", required: true) do |field| %>
          <% field.with_input(placeholder: "e.g., Kuala Lumpur") %>
        <% end %>
        <%= render PanelsUI::FormField.new(form: form, attribute: :country, label: "Country", required: true) do |field| %>
          <% field.with_combobox(country_options.map { |country| [country, country] },
                                 prompt: "Search and select a country",
                                 selected: current_hotel.country,
                                 max_options: 50,
                                 empty_text: "No countries found") %>
        <% end %>
        <%= render PanelsUI::FormField.new(form: form, attribute: :time_zone, label: "Timezone", required: true, hint: "Used for local check-in times, reports, and automated guest messages.") do |field| %>
          <% field.with_combobox(ActiveSupport::TimeZone.all.map { |zone| [zone.to_s, zone.name] },
                                 prompt: "Search and select a timezone",
                                 selected: current_hotel.time_zone,
                                 max_options: 50,
                                 empty_text: "No timezones found") %>
        <% end %>
        <%= render PanelsUI::FormField.new(form: form, attribute: :default_currency, label: "Default currency", required: true) do |field| %>
          <% field.with_combobox(CurrencyCatalog.options,
                                 prompt: "Search and select a currency",
                                 selected: current_hotel.default_currency,
                                 empty_text: "No currencies found") %>
        <% end %>
        <%= render PanelsUI::FormField.new(form: form, attribute: :google_map_link, label: "Google Maps URL", class: "sm:col-span-2") do |field| %>
          <% field.with_input(type: :url, placeholder: "https://www.google.com/maps/place/…") %>
        <% end %>
      </div>
    </section>

    <section aria-labelledby="property-contact-heading" class="space-y-4">
      <h2 id="property-contact-heading" class="text-base font-semibold">Property contact</h2>
      <div class="grid gap-4 sm:grid-cols-2">
        <%= render PanelsUI::FormField.new(form: form, attribute: :contact_email, label: "Contact email", required: true) do |field| %>
          <% field.with_input(type: :email, placeholder: "e.g., frontdesk@yourhotel.com") %>
        <% end %>
        <%= render PanelsUI::FormField.new(form: form, attribute: :contact_phone, label: "Contact phone", required: true) do |field| %>
          <% field.with_input(type: :tel, placeholder: "e.g., 012-827 3581") %>
        <% end %>
        <%= render PanelsUI::FormField.new(form: form, attribute: :fixed_line_number, label: "Fixed line number", hint: "Optional; the landline answered at the front desk.") do |field| %>
          <% field.with_input(type: :tel, placeholder: "e.g., 088-234 567") %>
        <% end %>
        <%= render PanelsUI::FormField.new(form: form, attribute: :whatsapp_number, label: "WhatsApp number", hint: "Optional; include the international dialling code.") do |field| %>
          <% field.with_input(type: :tel, placeholder: "e.g., +60 12-827 3581") %>
        <% end %>
      </div>
    </section>

    <section aria-labelledby="property-policy-heading" class="space-y-4">
      <div>
        <h2 id="property-policy-heading" class="text-base font-semibold">Stay and business day times</h2>
        <p class="mt-1 text-sm text-muted-foreground">Cancellation and posting rules are configured later with room revenue.</p>
      </div>
      <div class="grid gap-4 sm:grid-cols-2">
        <%# Almost every property runs 15:00 / 11:00, so the pickers open there and
            the owner only touches them when their property differs. %>
        <%= fields_for :property_policy, (current_hotel.property_policy || current_hotel.build_property_policy) do |policy_form| %>
          <%= render PanelsUI::FormField.new(form: policy_form, attribute: :check_in_time, label: "Standard check-in time", required: true) do |field| %>
            <% field.with_time_picker(value: policy_form.object.check_in_time.presence || "15:00", minute_step: 15) %>
          <% end %>
          <%= render PanelsUI::FormField.new(form: policy_form, attribute: :check_out_time, label: "Standard check-out time", required: true) do |field| %>
            <% field.with_time_picker(value: policy_form.object.check_out_time.presence || "11:00", minute_step: 15) %>
          <% end %>
        <% end %>
        <%# The business day window drives the night audit and every business-date
            report, so it is set here rather than left at the seeded default. %>
        <%= render PanelsUI::FormField.new(form: form, attribute: :business_starts_at, label: "Business day starts at", required: true, hint: "Opens the operating day used by the night audit and business-date reports.") do |field| %>
          <% field.with_time_picker(value: current_hotel.business_starts_at&.strftime("%H:%M"), minute_step: 15) %>
        <% end %>
        <%= render PanelsUI::FormField.new(form: form, attribute: :business_ends_at, label: "Business day ends at", required: true, hint: "May fall after midnight; the day then closes on the following calendar date.") do |field| %>
          <% field.with_time_picker(value: current_hotel.business_ends_at&.strftime("%H:%M"), minute_step: 15) %>
        <% end %>
      </div>
    </section>
  <% end %>
<% end %>
