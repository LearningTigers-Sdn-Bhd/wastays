<%# The record table owns the row and its remove control; this partial supplies
    only the field cells. Name and code live on the transaction code, so the
    object is built as the pair the save path writes.

    Three fields, not eight: a property being set up is naming the offers it
    makes, not keeping the books. The accounting code is derived from the name,
    and the rest — the description, whether staff may amend the amount, whether
    the offer is active — either has a sound default or is what removing the row
    already means. All of it stays editable under Settings afterwards.

    Pricing and its amount share one cell, as do the scope and the charges it
    can narrow to: in both pairs the second control only means anything under
    one value of the first, so it appears with that value rather than sitting
    dead beside it. That keeps the table at three columns.

    Labels are plain and are not hidden here. At table widths the record table
    hides them itself, because the column header does the naming; below 48rem
    the header row is gone, each row becomes a stacked editor, and these labels
    come back to carry it. %>
<% object = HotelDiscount.new(transaction_code: TransactionCode.new) %>
<% object.assign_attributes(
     name: entry["name"],
     pricing_type: entry["pricing_type"].presence || "manual",
     rate_value: entry["rate_value"],
     application_scope: entry["application_scope"].presence || "all_eligible_charges"
   ) %>
<% currency = current_hotel.default_currency.presence || "MYR" %>
<% scope = entry["application_scope"].presence || "all_eligible_charges" %>
<%= fields_for "discount_entries[#{index}]", object do |row_form| %>
  <td>
    <%= row_form.hidden_field :id, value: entry["id"] %>
    <%= hidden_field_tag "discount_entries[#{index}][transaction_code_id]", entry["transaction_code_id"] %>
    <%# Carried, not shown. A code the property already has has to stay with its
        row so the duplicate check weighs a new row against it. %>
    <%= hidden_field_tag "discount_entries[#{index}][code]", entry["code"] %>
    <%= hidden_field_tag "discount_entries[#{index}][_destroy]", "false", data: { record_table_destroy: true } %>
    <%= render PanelsUI::FormField.new(form: row_form, attribute: :name, label: "Name",
                                       size: :sm, required: true) do |field| %>
      <% field.with_input(placeholder: "Early bird") %>
    <% end %>
  </td>

  <td>
    <%# One column while the row is a stacked editor, two once it is a table row. %>
    <div class="grid grid-cols-1 gap-2 md:grid-cols-2" data-controller="record-row"
         data-action="change->record-row#update">
      <div data-record-row-target="typeField">
        <%= render PanelsUI::FormField.new(form: row_form, attribute: :pricing_type, label: "Pricing",
                                           size: :sm) do |field| %>
          <% field.with_select_menu(
               [ { label: "Staff enters the amount", value: "manual" },
                 { label: "Fixed amount", value: "fixed" },
                 { label: "Percentage", value: "percentage" } ],
               selected: entry["pricing_type"].presence || "manual") %>
        <% end %>
      </div>

      <%# The currency mark leads a fixed amount and the percent sign trails a
          rate, so the field reads as the figure it holds either way. Both are
          rendered and one is hidden: an addon is passive text, and swapping
          which side it sits on means swapping which one shows. %>
      <div data-record-row-target="rateField">
        <%= render PanelsUI::FormField.new(form: row_form, attribute: :rate_value, label: "Rate",
                                           size: :sm) do |field| %>
          <% field.with_input(type: :number, step: "0.01", min: "0", inputmode: "decimal") %>
          <% field.with_addon(align: :inline_start, data: { record_row_target: "currencyAddon" }) { currency } %>
          <% field.with_addon(align: :inline_end, data: { record_row_target: "percentAddon" }) { "%" } %>
        <% end %>
      </div>
    </div>
  </td>

  <td>
    <%# Side by side, not stacked: the picker narrows the scope beside it rather
        than following from it, and a hidden picker takes no width, so the scope
        fills the cell on its own until it is asked to share. %>
    <div class="flex flex-col gap-2 md:flex-row md:items-start"
         data-controller="record-row" data-action="change->record-row#update">
      <div class="min-w-0 flex-1" data-record-row-target="scope">
        <%= render PanelsUI::FormField.new(form: row_form, attribute: :application_scope,
                                           label: "Applies to", size: :sm) do |field| %>
          <% field.with_select_menu(
               [ { label: "Room charges", value: "room_charges" },
                 { label: "All eligible charges", value: "all_eligible_charges" },
                 { label: "Only the charges I choose", value: "selected_charges" } ],
               selected: scope) %>
        <% end %>
      </div>

      <div class="min-w-0 flex-1" data-record-row-target="codesField">
        <%= render PanelsUI::FormField.new(form: row_form, attribute: :applicable_transaction_code_ids,
                                           label: "Charges", size: :sm) do |field| %>
          <% field.with_multi_select(
               charge_code_choices,
               selected: Array(entry["applicable_transaction_code_ids"]).map(&:to_s),
               prompt: "Choose charges",
               max_visible_items: 2) %>
        <% end %>
      </div>
    </div>
  </td>
<% end %>
