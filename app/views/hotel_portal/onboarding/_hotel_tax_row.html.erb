<% object = HotelTax.new(entry.slice("name", "charge_type", "rate_type", "amount")) %>
<%= fields_for "tax_entries[#{index}]", object do |tax_form| %>
  <div class="grid gap-3 border-t border-border pt-4 sm:grid-cols-[1.4fr_0.9fr_0.9fr_0.8fr_auto] sm:items-end" data-onboarding-hotel-taxes-target="row">
    <%= tax_form.hidden_field :id, value: entry["id"] %>

    <%= render PanelsUI::FormField.new(form: tax_form, attribute: :name, label: "Name", required: true) do |field| %>
      <% field.with_input(placeholder: "Heritage levy") %>
    <% end %>

    <%= render PanelsUI::FormField.new(form: tax_form, attribute: :charge_type, label: "Type") do |field| %>
      <% field.with_select_menu(
           [ { label: "Tax", value: "tax" }, { label: "Fee", value: "charge" } ],
           selected: (entry["charge_type"] == "tax" ? "tax" : "charge")) %>
    <% end %>

    <%= render PanelsUI::FormField.new(form: tax_form, attribute: :rate_type, label: "Rate type") do |field| %>
      <% field.with_select_menu(
           [ { label: "Fixed amount", value: "flat" }, { label: "Percentage", value: "percentage" } ],
           selected: (entry["rate_type"].presence || "flat")) %>
    <% end %>

    <%= render PanelsUI::FormField.new(form: tax_form, attribute: :amount, label: "Amount", required: true) do |field| %>
      <% field.with_input(type: :number, step: "0.01", min: "0", inputmode: "decimal") %>
    <% end %>

    <%= render PanelsUI::Button.new(
          as: :button,
          variant: :ghost,
          size: :icon_sm,
          icon_only: true,
          aria_label: "Remove #{entry['name'].presence || 'this tax or fee'}",
          data: { action: "onboarding-hotel-taxes#remove" }) do %>
      <%= app_icon "trash-2", class: "size-4", aria: { hidden: "true" } %>
    <% end %>

    <div class="flex flex-wrap items-center gap-4 sm:col-span-5">
      <%= render PanelsUI::Switch.new(
            form: tax_form,
            attribute: :enabled,
            label: "Charge this now",
            checked: entry.fetch("enabled", "true") != "false") %>
      <%= render PanelsUI::Switch.new(
            form: tax_form,
            attribute: :foreign_guests_only,
            label: "Foreign guests only",
            checked: entry["foreign_guests_only"] == "true") %>
    </div>
  </div>
<% end %>
