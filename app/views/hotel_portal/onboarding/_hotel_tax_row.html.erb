<%# The record table owns the row and its remove control; this partial supplies
    only the field cells. %>
<% object = HotelTax.new(entry.slice("name", "charge_type", "rate_type", "amount")) %>
<%= fields_for "tax_entries[#{index}]", object do |tax_form| %>
  <td>
    <%= tax_form.hidden_field :id, value: entry["id"] %>
    <%= render PanelsUI::FormField.new(form: tax_form, attribute: :name, label: "Name", size: :sm, required: true) do |field| %>
      <% field.with_input(placeholder: "Heritage levy") %>
    <% end %>
  </td>

  <td>
    <%= render PanelsUI::FormField.new(form: tax_form, attribute: :charge_type, label: "Type", size: :sm) do |field| %>
      <% field.with_select_menu(
           [ { label: "Tax", value: "tax" }, { label: "Fee", value: "charge" } ],
           selected: (entry["charge_type"] == "tax" ? "tax" : "charge")) %>
    <% end %>
  </td>

  <td>
    <%= render PanelsUI::FormField.new(form: tax_form, attribute: :rate_type, label: "Rate type", size: :sm) do |field| %>
      <% field.with_select_menu(
           [ { label: "Fixed amount", value: "flat" }, { label: "Percentage", value: "percentage" } ],
           selected: (entry["rate_type"].presence || "flat")) %>
    <% end %>
  </td>

  <td>
    <%= render PanelsUI::FormField.new(form: tax_form, attribute: :amount, label: "Amount", size: :sm, required: true) do |field| %>
      <% field.with_input(type: :number, step: "0.01", min: "0", inputmode: "decimal") %>
    <% end %>
  </td>

  <td>
    <%= render PanelsUI::Switch.new(
          form: tax_form,
          attribute: :enabled,
          label: "Charge this now",
          size: :sm,
          checked: entry.fetch("enabled", "true") != "false") %>
  </td>

  <td>
    <%= render PanelsUI::Switch.new(
          form: tax_form,
          attribute: :foreign_guests_only,
          label: "Foreign guests only",
          size: :sm,
          checked: entry["foreign_guests_only"] == "true") %>
  </td>
<% end %>
