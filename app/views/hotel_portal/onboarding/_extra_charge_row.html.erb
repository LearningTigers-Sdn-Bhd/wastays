<%# The record table owns the row and its remove control; this partial supplies
    only the field cells. Name, code and category live on the transaction code,
    so the object is built as the pair the save path writes.

    Every label is hidden: the column header names the field, so a visible label
    in the cell only repeats it. The label stays in the DOM as the control's
    accessible name, and names the charge as well as the field so a row read out
    of the header's context still says which charge it belongs to. Spreadsheet
    tables never reflow into stacked editors, so nothing brings the labels back. %>
<% object = HotelExtraCharge.new(transaction_code: TransactionCode.new) %>
<% object.assign_attributes(
     name: entry["name"],
     code: entry["code"],
     category: entry["category"].presence || "other",
     pricing_type: entry["pricing_type"].presence || "manual",
     rate_value: entry["rate_value"],
     charging_unit: entry["charging_unit"].presence || "per_item",
     percentage_basis: entry["percentage_basis"]
   ) %>
<% charge_name = entry["name"].presence || "this extra charge" %>
<%= fields_for "extra_charge_entries[#{index}]", object do |row_form| %>
  <td>
    <%= row_form.hidden_field :id, value: entry["id"] %>
    <%= hidden_field_tag "extra_charge_entries[#{index}][transaction_code_id]", entry["transaction_code_id"] %>
    <%= hidden_field_tag "extra_charge_entries[#{index}][category]", entry["category"].presence || "other" %>
    <%= hidden_field_tag "extra_charge_entries[#{index}][_destroy]", "false", data: { record_table_destroy: true } %>
    <%= render PanelsUI::FormField.new(form: row_form, attribute: :name, label: "Name", label_hidden: true,
                                       size: :sm, required: true) do |field| %>
      <% field.with_input(placeholder: "Airport transfer") %>
    <% end %>
  </td>

  <td>
    <%= render PanelsUI::FormField.new(form: row_form, attribute: :code, label: "Code for #{charge_name}",
                                       label_hidden: true, size: :sm, required: true) do |field| %>
      <% field.with_input(placeholder: "TRANSFER", maxlength: 10, class: "uppercase") %>
    <% end %>
  </td>

  <td>
    <%= render PanelsUI::FormField.new(form: row_form, attribute: :pricing_type, label: "Pricing for #{charge_name}",
                                       label_hidden: true, size: :sm) do |field| %>
      <% field.with_select_menu(
           [ { label: "Staff enters the amount", value: "manual" },
             { label: "Fixed amount", value: "fixed" },
             { label: "Percentage", value: "percentage" } ],
           selected: entry["pricing_type"].presence || "manual") %>
    <% end %>
  </td>

  <td>
    <%# Blank for a manual charge: the amount is decided when it is posted. %>
    <%= render PanelsUI::FormField.new(form: row_form, attribute: :rate_value, label: "Amount for #{charge_name}",
                                       label_hidden: true, size: :sm) do |field| %>
      <% field.with_input(type: :number, step: "0.01", min: "0", inputmode: "decimal") %>
    <% end %>
  </td>

  <td>
    <%= render PanelsUI::FormField.new(form: row_form, attribute: :percentage_basis,
                                       label: "Percentage of, for #{charge_name}", label_hidden: true, size: :sm) do |field| %>
      <% field.with_select_menu(
           [ { label: "Room charges", value: "room_charges" },
             { label: "All non-tax charges", value: "non_tax_charges" } ],
           prompt: "Not applicable",
           selected: entry["percentage_basis"]) %>
    <% end %>
  </td>

  <td>
    <%= render PanelsUI::FormField.new(form: row_form, attribute: :charging_unit, label: "Charged for #{charge_name}",
                                       label_hidden: true, size: :sm) do |field| %>
      <% field.with_select_menu(
           HotelExtraCharge::CHARGING_UNITS.map { |unit| { label: unit.humanize, value: unit } },
           selected: entry["charging_unit"].presence || "per_item") %>
    <% end %>
  </td>

  <td>
    <%= render PanelsUI::FormField.new(form: row_form, attribute: :tax_rule_keys, label: "Taxes on #{charge_name}",
                                       label_hidden: true, size: :sm) do |field| %>
      <% field.with_multi_select(
           tax_rule_choices,
           selected: Array(entry["tax_rule_keys"]),
           prompt: "No taxes",
           max_visible_items: 2) %>
    <% end %>
  </td>

  <td>
    <%= render PanelsUI::Switch.new(
          form: row_form,
          attribute: :allow_amount_override,
          label: "Staff can change the amount of #{charge_name}",
          label_hidden: true,
          size: :sm,
          checked: entry.fetch("allow_amount_override", "true") != "false") %>
  </td>

  <td>
    <%= render PanelsUI::Switch.new(
          form: row_form,
          attribute: :active,
          label: "Offer #{charge_name}",
          label_hidden: true,
          size: :sm,
          checked: entry.fetch("active", "true") != "false") %>
  </td>
<% end %>
