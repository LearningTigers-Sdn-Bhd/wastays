<% active_channel_subtab = @active_subtab.in?(%w[derived_settings availability_rules]) ? @active_subtab : "derived_settings" %>
<%= render PanelsUI::Tabs.new(id: "channel-subtabs", active: active_channel_subtab, variant: :pill, url: { param: "subtab" }, list_class: "mb-6", aria_label: "Channels and OTAs sections") do |tabs| %>
  <% tabs.with_tab(name: "derived_settings", label: "Derived Pricing & Allocations", icon: "percent", panel_id: "channels-derived-panel") %>
  <% tabs.with_tab(name: "availability_rules", label: "Availability Rules", icon: "calendar-cog", panel_id: "channels-rules-panel") %>

  <% tabs.with_panel(name: "derived_settings", id: "channels-derived-panel") do %>
    <%= render "channels_derived_pricing" %>
  <% end %>

  <% tabs.with_panel(name: "availability_rules", id: "channels-rules-panel") do %>
    <%= render "channels_availability_rules" %>
  <% end %>
<% end %>
