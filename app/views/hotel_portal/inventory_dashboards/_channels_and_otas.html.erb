<% active_channel_subtab = @active_subtab.in?(%w[derived_settings availability_rules]) ? @active_subtab : "derived_settings" %>
<% unsupported_plans = @channex_plan_capabilities.select { |_plan, capability| capability.unsupported? } %>
<% flattened_plans = @channex_plan_capabilities.select { |_plan, capability| capability.flattened? } %>

<% if unsupported_plans.any? %>
  <div class="mb-4">
    <%= render PanelsUI::Alert.new(tone: :warning, title: "Some rates are not sent to OTAs") do |alert| %>
      <% alert.with_description do %>
        <%= unsupported_plans.map { |plan, capability| "#{plan.name}: #{capability.reason}" }.join(" · ") %>
      <% end %>
    <% end %>
  </div>
<% end %>

<% if flattened_plans.any? %>
  <div class="mb-4">
    <%= render PanelsUI::Alert.new(tone: :info, title: "Child prices are flattened for OTAs") do |alert| %>
      <% alert.with_description do %>
        <%= flattened_plans.keys.map(&:name).to_sentence %> use one child fee and one infant fee on connected channels. Direct bookings continue to use age-specific prices.
      <% end %>
    <% end %>
  </div>
<% end %>
<%= render PanelsUI::Tabs.new(id: "channel-subtabs", active: active_channel_subtab, variant: :pill, url: { param: "subtab" }, aria_label: "Channels and OTAs sections") do |tabs| %>
  <% tabs.with_tab(name: "derived_settings", label: "Derived Pricing & Allocations", icon: "percent", panel_id: "channels-derived-panel") %>
  <% tabs.with_tab(name: "availability_rules", label: "Availability Rules", icon: "calendar-cog", panel_id: "channels-rules-panel") %>

  <% tabs.with_panel(name: "derived_settings", id: "channels-derived-panel") do %>
    <%= render "channels_derived_pricing" %>
  <% end %>

  <% tabs.with_panel(name: "availability_rules", id: "channels-rules-panel") do %>
    <%= render "channels_availability_rules" %>
  <% end %>
<% end %>
