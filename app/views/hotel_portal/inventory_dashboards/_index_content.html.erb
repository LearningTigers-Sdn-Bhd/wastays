<%# 
  # This partial should be rendered inside a turbo-frame with id "inventory_calendar_frame"
  active_tab ||= params[:tab].presence || "calendar"
  active_subtab ||= params[:subtab].presence || "pricing"
%>

<% if request.headers["Turbo-Frame"].present? %>
  <%= render "shared/feedback/flash_toasts", flash: flash %>
<% end %>

<!-- Top-Level Tabs -->
<nav class="<%= dashboard_tab_container_classes %>">
  <div class="flex min-w-max items-center gap-2" role="tablist">
    <button type="button"
            data-tabs-target="tab"
            data-tab-name="calendar"
            data-action="click->tabs#switch"
            data-active="<%= active_tab == 'calendar' %>"
            class="<%= dashboard_tab_classes %>"
            role="tab">
      Rates & Availability
    </button>
    <button type="button"
            data-tabs-target="tab"
            data-tab-name="advanced"
            data-action="click->tabs#switch"
            data-active="<%= active_tab == 'advanced' %>"
            class="<%= dashboard_tab_classes %>"
            role="tab">
      Advanced Pricing
    </button>
  </div>
</nav>

<!-- Main Content Panels -->
<div class="mt-6">
  <!-- Panel: Rates & Availability -->
  <div data-tabs-target="panel" data-tab-panel="calendar" class="<%= active_tab == 'calendar' ? 'space-y-6' : 'hidden' %>">
    <% if @missing_rates.any? %>
      <div class="rounded-2xl border border-rose-200 bg-rose-50 p-4 shadow-sm">
        <div class="flex items-center gap-3 text-rose-800">
          <svg class="size-5 shrink-0" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m-9.303 3.376c-.866 1.5.217 3.374 1.948 3.374h14.71c1.73 0 2.813-1.874 1.948-3.374L13.949 3.378c-.866-1.5-3.032-1.5-3.898 0L2.697 16.126ZM12 15.75h.007v.008H12v-.008Z" />
          </svg>
          <div class="text-sm">
            <span class="font-bold">Exchange Rates Missing:</span>
            Conversion rates for <span class="font-bold"><%= @missing_rates.to_sentence %></span> are not set relative to <%= @hotel_base_currency %>. 
            <% if current_user.has_permission?("manage_hotel_profile") %>
              Please <%= link_to "configure them", admin_exchange_rates_path, class: "underline font-black decoration-rose-400 hover:text-rose-600", data: { turbo: false } %>.
            <% end %>
          </div>
        </div>
      </div>
    <% end %>

    <section class="rounded-xl border border-slate-200 bg-white shadow-sm overflow-hidden">
      <div class="flex flex-col gap-4 border-b border-slate-200 p-3 sm:p-4 xl:flex-row xl:items-center xl:justify-between">
        <div class="flex flex-col sm:flex-row sm:items-center gap-3">
          <h1 class="text-xs sm:text-sm font-black uppercase tracking-widest text-slate-900">Rates & Availability</h1>
          <div class="h-4 w-px bg-slate-200 hidden sm:block"></div>
          <div class="flex items-center gap-1">
            <%= link_to hotel_inventory_index_path(current_hotel, { start_date: @start_date - 14.days, view_currencies: @view_currencies, room_type_id: @calendar.selected_room_type_id }.compact),
                        class: "inline-flex size-9 sm:size-8 items-center justify-center rounded-lg border border-slate-200 bg-white text-slate-600 shadow-sm hover:bg-slate-50 hover:text-slate-900",
                        title: "Previous 14 days" do %>
              <svg class="size-4" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg>
            <% end %>

            <input type="date"
                   value="<%= @start_date %>"
                   class="h-9 sm:h-8 rounded-lg border border-slate-200 bg-white px-2 py-0 text-xs font-bold text-slate-700 shadow-sm focus:border-slate-400 focus:outline-none focus:ring-0"
                   data-inventory-calendar-target="navStartDate"
                   data-action="change->inventory-calendar#navigate">

            <%= link_to hotel_inventory_index_path(current_hotel, { start_date: @start_date + 14.days, view_currencies: @view_currencies, room_type_id: @calendar.selected_room_type_id }.compact),
                        class: "inline-flex size-9 sm:size-8 items-center justify-center rounded-lg border border-slate-200 bg-white text-slate-600 shadow-sm hover:bg-slate-50 hover:text-slate-900",
                        title: "Next 14 days" do %>
              <svg class="size-4" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg>
            <% end %>
          </div>
        </div>

        <div class="flex flex-wrap items-center gap-2 sm:gap-3">
          <!-- Room Filter -->
          <select id="room_type_id_nav" name="room_type_id" class="h-10 sm:h-9 flex-1 sm:flex-none rounded-lg border border-slate-200 bg-white px-3 py-0 text-xs font-bold text-slate-700 shadow-sm focus:border-slate-400 focus:outline-none focus:ring-0"
                  data-inventory-calendar-target="navRoomType"
                  data-action="change->inventory-calendar#navigate">
            <option value="">All room types</option>
            <%= options_from_collection_for_select(@calendar.room_type_options, :id, :name, @calendar.selected_room_type_id) %>
          </select>

          <!-- View Currencies -->
          <div class="inline-flex h-10 sm:h-9 items-center rounded-lg border border-slate-200 bg-slate-50 p-1 shadow-sm gap-1 overflow-x-auto no-scrollbar">
            <% @view_currencies.each do |currency| %>
              <div class="group relative flex h-full items-center">
                <%= link_to currency,
                            hotel_inventory_index_path(current_hotel, { start_date: @start_date, view_currencies: @view_currencies, display_currency: currency, room_type_id: @calendar.selected_room_type_id }.compact),
                            class: "flex h-full items-center rounded-md px-3 text-[10px] font-black tracking-wider transition #{@display_currency == currency ? 'bg-white text-slate-950 shadow-sm' : 'text-slate-500 hover:text-slate-900'}" %>
                <% if @view_currencies.size > 1 && currency != @hotel_base_currency %>
                  <%= link_to hotel_inventory_index_path(current_hotel, { start_date: @start_date, view_currencies: (@view_currencies - [currency]), room_type_id: @calendar.selected_room_type_id }.compact),
                              title: "Remove from view",
                              class: "absolute -top-1 -right-1 hidden group-hover:flex size-4 items-center justify-center rounded-full bg-slate-900 text-white text-[8px] font-bold shadow-sm" do %>
                    ✕
                  <% end %>
                <% end %>
              </div>
            <% end %>
            
            <div class="relative h-full" data-controller="dropdown">
              <button type="button" 
                      data-action="click->dropdown#toggle"
                      class="flex h-full w-7 items-center justify-center rounded-md text-slate-400 hover:bg-white hover:text-slate-900 transition-all border border-transparent hover:border-slate-200">
                <svg class="size-3.5" fill="none" viewBox="0 0 24 24" stroke-width="3" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v16m7.5-7.5h-16" />
                </svg>
              </button>
              <div data-dropdown-target="menu" class="absolute right-0 top-full z-[100] mt-2 hidden w-48 overflow-hidden rounded-xl border border-slate-200 bg-white shadow-xl ring-1 ring-black/5">
                <div class="max-h-60 overflow-y-auto p-1 custom-scrollbar">
                  <div class="px-3 py-2 text-[10px] font-black uppercase tracking-widest text-slate-400 border-b border-slate-50 mb-1">Add Currency</div>
                  <% (CurrencyCatalog::COMMON_CODES - @view_currencies).each do |c| %>
                    <%= link_to c, 
                                hotel_inventory_index_path(current_hotel, { start_date: @start_date, view_currencies: (@view_currencies + [c]), room_type_id: @calendar.selected_room_type_id }.compact),
                                class: "block rounded-lg px-3 py-2 text-left text-xs font-bold text-slate-700 hover:bg-slate-50 hover:text-slate-950 transition-colors" %>
                  <% end %>
                </div>
              </div>
            </div>
          </div>

          <div class="h-4 w-px bg-slate-200 hidden xl:block"></div>

          <div class="flex items-center gap-2 w-full sm:w-auto">
            <button type="button" 
                    data-action="inventory-calendar#openBulk" 
                    class="h-10 sm:h-9 flex-1 sm:flex-none inline-flex items-center justify-center rounded-lg border border-slate-200 bg-white px-4 text-xs font-bold text-slate-700 shadow-sm hover:bg-slate-50 transition-all active:scale-95">
              Bulk Edit
            </button>

            <button type="button" 
                    data-inventory-calendar-target="syncButton"
                    data-action="inventory-calendar#openReview"
                    disabled
                    class="h-10 sm:h-9 flex-1 sm:flex-none inline-flex items-center justify-center gap-2 rounded-lg bg-slate-200 px-5 text-xs font-black uppercase tracking-widest text-slate-500 shadow-sm transition-all enabled:bg-indigo-600 enabled:text-white enabled:hover:bg-indigo-700 disabled:cursor-not-allowed">
              <svg class="size-3.5" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12a9 9 0 0 0-9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"/><path d="M3 3v5h5"/><path d="M3 12a9 9 0 0 0 9 9 9.75 9.75 0 0 0 6.74-2.74L21 16"/><path d="M16 16h5v5"/></svg>
              <span>Sync</span>
              <span data-inventory-calendar-target="syncCounter" class="hidden rounded-full bg-white/20 px-1.5 py-0.5 text-[9px] font-black tabular-nums">0</span>
            </button>
          </div>
        </div>
      </div>

      <div class="overflow-x-auto custom-scrollbar">
        <table class="min-w-full table-fixed border-separate border-spacing-0" data-testid="inventory-calendar-grid">
          <thead>
            <tr class="bg-slate-50">
              <th class="sticky left-0 z-30 w-[140px] sm:w-[260px] border-b border-r border-slate-200 bg-slate-50 px-2 sm:px-4 py-1.5 text-left shadow-[4px_0_8px_-2px_rgba(15,23,42,0.1)]">
                <span class="text-[9px] sm:text-[10px] font-bold uppercase tracking-[0.12em] text-slate-500">Room / Plan</span>
              </th>
              <% @calendar.dates.each do |date| %>
                <th class="min-w-[80px] sm:min-w-[108px] border-b border-r border-slate-200 px-1 sm:px-2 py-1.5 text-center last:border-r-0 transition-colors <%= date == Date.current ? 'bg-blue-50' : '' %>"
                    data-inventory-highlight-target="columnHeader"
                    data-column-id="<%= date %>">
                  <span class="block text-[8px] sm:text-[9px] font-bold uppercase tracking-[0.1em] <%= date == Date.current ? 'text-blue-700' : 'text-slate-500' %>"><%= date.strftime("%a") %></span>
                  <span class="mt-0.5 block text-[10px] sm:text-xs font-bold <%= date == Date.current ? 'text-blue-900' : 'text-slate-900' %>"><%= date.strftime("%d %b") %></span>
                </th>
              <% end %>
            </tr>
          </thead>

          <tbody class="bg-white">
            <% if @calendar.rows.any? %>
              <% @calendar.rows.each do |row| %>
                <tr class="<%= inventory_parent_row?(row) ? 'bg-slate-50/40' : 'bg-white hover:bg-slate-50/70 transition-colors' %>"
                    data-inventory-row-target="row"
                    data-parent-room-type-id="<%= inventory_parent_room_type_id_for(row) %>">
                  <td class="sticky left-0 z-20 border-b border-r border-slate-200 bg-white px-2 sm:px-3 py-0.5 shadow-[4px_0_8px_-2px_rgba(15,23,42,0.1)]"
                      data-inventory-highlight-target="rowHeader">
                    <div class="space-y-0.5">
                      <div>
                        <% if inventory_parent_row?(row) %>
                          <div class="flex items-center justify-between gap-1 sm:gap-2">
                            <div class="flex items-center gap-1 sm:gap-1.5">
                              <button type="button" 
                                      data-action="inventory-row#toggle" 
                                      data-room-type-id="<%= row.room_type_id %>"
                                      data-collapsed="false"
                                      class="text-slate-400 hover:text-slate-600 transition-transform">
                                <svg class="size-3 sm:size-3.5" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6"/></svg>
                              </button>
                              <p class="truncate text-[9px] sm:text-[11px] font-black uppercase tracking-wider text-slate-950 transition-colors" data-inventory-highlight-target="rowLabel"><%= row.label %></p>
                            </div>
                          </div>
                          <p class="mt-0.5 ms-4 sm:ms-5 text-[8px] sm:text-[10px] font-semibold text-slate-500"><%= pluralize(row.room_type.quantity, "unit") %></p>
                        <% else %>
                          <p class="ms-4 sm:ms-5 truncate text-[8px] sm:text-[10px] font-bold text-slate-600 uppercase tracking-tight transition-colors" data-inventory-highlight-target="rowLabel"><span class="me-1 sm:me-1.5 text-slate-300">↳</span><%= row.sublabel %></p>
                        <% end %>
                      </div>
                    </div>
                  </td>

                  <% @calendar.dates.each do |date| %>
                    <% cell = inventory_calendar_cell(@calendar, row, date) %>
                    <td class="border-b border-r border-slate-100 p-0 last:border-r-0">
                      <% if row.inventory_row? %>
                        <button type="button"
                                class="min-h-[48px] sm:min-h-[54px] w-full px-1 sm:px-2 py-2 text-center transition <%= cell[:closed] ? 'bg-rose-100' : 'bg-emerald-200 hover:bg-emerald-300' %>"
                                data-testid="availability-cell-<%= row.room_type_id %>-<%= date %>"
                                data-action="mouseenter->inventory-highlight#highlight mouseleave->inventory-highlight#clear click->inventory-calendar#openCell"
                                data-mode="availability"
                                data-room-type-id="<%= row.room_type_id %>"
                                data-date="<%= date %>"
                                data-quantity="<%= cell[:quantity] %>"
                                data-status="<%= cell[:status] %>">
                          <div class="flex flex-col items-center justify-center">
                            <% if cell[:closed] %>
                              <span class="block truncate text-[8px] sm:text-[9px] font-bold uppercase tracking-[0.1em] text-rose-800"><%= cell[:status_label] %></span>
                            <% else %>
                              <span class="block truncate text-[8px] sm:text-[9px] font-bold uppercase tracking-[0.1em] <%= cell[:sold_count] > 0 ? 'text-emerald-800' : 'text-slate-400' %>"><%= cell[:sold_count] %> Sold</span>
                            <% end %>
                            <span class="mt-0.5 block text-xs sm:text-sm font-black text-slate-950"><%= cell[:quantity] %></span>
                          </div>
                        </button>
                      <% elsif row.walk_in_row? %>
                        <button type="button"
                             class="min-h-[48px] sm:min-h-[54px] w-full bg-emerald-50/30 px-1 sm:px-2 py-2 text-center transition hover:bg-emerald-100/50"
                             data-testid="walk-in-cell-<%= row.room_type_id %>-<%= date %>"
                             data-action="mouseenter->inventory-highlight#highlight mouseleave->inventory-highlight#clear click->inventory-calendar#openCell"
                             data-column-id="<%= date %>"
                             data-mode="rates"
                             data-rate-plan-id="tier_walk_in_<%= row.room_type_id %>"
                             data-room-type-id="<%= row.room_type_id %>"
                             data-date="<%= date %>"
                             data-price="<%= cell[:price] %>">
                          <div class="flex flex-col items-center justify-center min-h-[28px] sm:min-h-[32px]">
                            <% if cell[:conversion_missing] %>
                              <span class="text-[8px] sm:text-[9px] font-black text-rose-500 uppercase leading-none">No FX Rate</span>
                            <% else %>
                              <span class="block truncate text-xs sm:text-sm font-black tabular-nums <%= cell[:is_modified] ? 'text-blue-700' : 'text-slate-950' %>">
                                <%= cell[:formatted_price] %>
                              </span>
                            <% end %>
                          </div>
                        </button>
                      <% elsif row.corporate_row? %>
                        <button type="button"
                             class="min-h-[48px] sm:min-h-[54px] w-full bg-blue-50/30 px-1 sm:px-2 py-2 text-center transition hover:bg-blue-100/50"
                             data-testid="corporate-cell-<%= row.room_type_id %>-<%= date %>"
                             data-action="mouseenter->inventory-highlight#highlight mouseleave->inventory-highlight#clear click->inventory-calendar#openCell"
                             data-column-id="<%= date %>"
                             data-mode="rates"
                             data-rate-plan-id="tier_corporate_<%= row.room_type_id %>"
                             data-room-type-id="<%= row.room_type_id %>"
                             data-date="<%= date %>"
                             data-price="<%= cell[:price] %>">
                          <div class="flex flex-col items-center justify-center min-h-[28px] sm:min-h-[32px]">
                            <% if cell[:conversion_missing] %>
                              <span class="text-[8px] sm:text-[9px] font-black text-rose-500 uppercase leading-none">No FX Rate</span>
                            <% else %>
                              <span class="block truncate text-xs sm:text-sm font-black tabular-nums <%= cell[:is_modified] ? 'text-blue-700' : 'text-slate-950' %>">
                                <%= cell[:formatted_price] %>
                              </span>
                            <% end %>
                          </div>
                        </button>
                      <% elsif row.ota_row? %>
                        <button type="button"
                             class="min-h-[48px] sm:min-h-[54px] w-full bg-purple-50/30 px-1 sm:px-2 py-2 text-center transition hover:bg-purple-100/50"
                             data-testid="ota-cell-<%= row.room_type_id %>-<%= date %>"
                             data-action="mouseenter->inventory-highlight#highlight mouseleave->inventory-highlight#clear click->inventory-calendar#openCell"
                             data-column-id="<%= date %>"
                             data-mode="rates"
                             data-rate-plan-id="tier_ota_<%= row.room_type_id %>"
                             data-room-type-id="<%= row.room_type_id %>"
                             data-date="<%= date %>"
                             data-price="<%= cell[:price] %>">
                          <div class="flex flex-col items-center justify-center min-h-[28px] sm:min-h-[32px]">
                            <% if cell[:conversion_missing] %>
                              <span class="text-[8px] sm:text-[9px] font-black text-rose-500 uppercase leading-none">No FX Rate</span>
                            <% else %>
                              <span class="block truncate text-xs sm:text-sm font-black tabular-nums <%= cell[:is_modified] ? 'text-blue-700' : 'text-slate-950' %>">
                                <%= cell[:formatted_price] %>
                              </span>
                            <% end %>
                          </div>
                        </button>
                      <% else %>
                        <button type="button"
                                class="min-h-[48px] sm:min-h-[54px] w-full bg-white px-1 sm:px-2 py-2 text-center transition hover:bg-slate-100"
                                data-testid="rate-cell-<%= row.room_type_id %>-<%= row.rate_plan_id %>-<%= date %>"
                                data-action="mouseenter->inventory-highlight#highlight mouseleave->inventory-highlight#clear click->inventory-calendar#openCell"
                                data-mode="rates"
                                data-room-type-id="<%= row.room_type_id %>"
                                data-rate-plan-id="<%= row.rate_plan_id %>"
                                data-date="<%= date %>"
                                data-price="<%= cell[:price] %>"
                                data-currency="<%= cell[:currency] %>"
                                data-min-stay="<%= cell[:min_stay] %>"
                                data-max-stay="<%= cell[:max_stay] %>"
                                data-closed-to-arrival="<%= cell[:closed_to_arrival] %>"
                                data-closed-to-departure="<%= cell[:closed_to_departure] %>"
                                data-stop-sell="<%= cell[:stop_sell] %>">
                          <div class="flex flex-col items-center justify-center min-h-[28px] sm:min-h-[32px]">
                            <% if cell[:conversion_missing] %>
                              <span class="text-[8px] sm:text-[9px] font-black text-rose-500 uppercase leading-none">No FX Rate</span>
                            <% else %>
                              <span class="block truncate text-xs sm:text-sm font-black tabular-nums <%= cell[:is_modified] ? 'text-indigo-600' : 'text-slate-950' %>">
                                <%= cell[:formatted_price] %>
                              </span>
                            <% end %>
                          </div>
                          <% if cell[:restriction_compact].present? %>
                            <span class="mt-1 block truncate text-center text-[7px] sm:text-[8px] font-bold uppercase tracking-[0.02em] text-amber-700 bg-amber-50 rounded px-0.5 sm:px-1"><%= cell[:restriction_compact] %></span>
                          <% end %>
                        </button>
                      <% end %>
                    </td>
                  <% end %>
                </tr>
              <% end %>
            <% else %>
              <tr>
                <td colspan="<%= @calendar.dates.count + 1 %>" class="px-6 py-16 text-center text-sm font-semibold text-slate-500">
                  <%= @calendar.empty_message %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </section>
  </div>

  <!-- Panel: Advanced Pricing -->
  <div data-tabs-target="panel" data-tab-panel="advanced" class="<%= active_tab == 'advanced' ? '' : 'hidden' %>">
    <div data-controller="subtabs"
         data-subtabs-default-tab-value="pricing"
         data-subtabs-parameter-name-value="subtab">

      <nav class="<%= dashboard_tab_container_classes %> mb-6">
        <div class="flex min-w-max items-center gap-2" role="tablist">
          <button type="button"
                  data-subtabs-target="tab"
                  data-tab-name="pricing"
                  data-action="click->subtabs#switch"
                  data-active="<%= active_subtab == 'pricing' %>"
                  class="<%= dashboard_tab_classes %>"
                  role="tab">
            Pricing Rules
          </button>
          <button type="button"
                  data-subtabs-target="tab"
                  data-tab-name="overrides"
                  data-action="click->subtabs#switch"
                  data-active="<%= active_subtab == 'overrides' %>"
                  class="<%= dashboard_tab_classes %>"
                  role="tab">
            Availability Overrides
          </button>
        </div>
      </nav>

      <div data-subtabs-target="panel" data-tab-panel="pricing" class="<%= active_subtab == 'pricing' ? '' : 'hidden' %>">
        <%= render "pricing_rules" %>
      </div>

      <div data-subtabs-target="panel" data-tab-panel="overrides" class="<%= active_subtab == 'overrides' ? '' : 'hidden' %>">
        <%= render "availability_override" %>
      </div>
    </div>
  </div>
</div>
