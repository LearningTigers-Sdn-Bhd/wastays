<%= turbo_frame_tag "occupancy_details_frame" do %>
  <div class="flex h-full max-h-[85vh] flex-col bg-white">
    <!-- Header -->
    <div class="flex-none flex items-end justify-between border-b border-slate-100 px-5 py-2">
      <div>
        <p class="text-xs font-semibold text-slate-500">Occupancy Rate: <b><%= "#{@date.day.ordinalize} #{@date.strftime('%B %Y (%a)')}" %></b></p>
      </div>
      <button type="button" onclick="document.getElementById('occupancy-details-dialog').close()" class="rounded-lg p-1 text-slate-400 hover:bg-slate-200 hover:text-slate-700" aria-label="Close dialog">
        <%= cached_icon "x", class: "size-5", stroke_width: 2.5 %>
      </button>
    </div>

    <!-- Body / List -->
    <div class="flex-1 overflow-y-auto px-5 py-4 space-y-2">
      <% if @grouped_booking_rooms.any? %>
        <% if @grouped_booking_rooms.size > 1 %>
          <%= render PanelsUI::Tabs.new(id: "occupancy-room-types", active: @grouped_booking_rooms.first.first.id.to_s, variant: :pill, aria_label: "Room types") do |tabs| %>
            <% @grouped_booking_rooms.each do |room_type, booking_rooms| %>
              <% tabs.with_tab(name: room_type.id.to_s, label: "#{room_type.name} (#{booking_rooms.size})", panel_id: "occupancy-room-type-#{room_type.id}") %>
            <% end %>
            <% @grouped_booking_rooms.each do |room_type, booking_rooms| %>
              <% tabs.with_panel(name: room_type.id.to_s, id: "occupancy-room-type-#{room_type.id}") do %>
                <%= render "hotel_portal/inventory_dashboards/occupancy_room_type_table", room_type: room_type, booking_rooms: booking_rooms, show_heading: false %>
              <% end %>
            <% end %>
          <% end %>
        <% else %>
          <% @grouped_booking_rooms.each do |room_type, booking_rooms| %>
            <%= render "hotel_portal/inventory_dashboards/occupancy_room_type_table", room_type: room_type, booking_rooms: booking_rooms %>
          <% end %>
        <% end %>
      <% else %>
        <div class="flex flex-col items-center justify-center py-16 text-center">
          <div class="mx-auto mb-4 flex size-12 items-center justify-center rounded-full bg-slate-100 text-slate-400">
            <svg class="size-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" />
            </svg>
          </div>
          <h3 class="text-sm font-bold text-slate-900">No active bookings</h3>
          <p class="mt-1 text-xs text-slate-500 font-semibold">There are no guest arrivals or stays recorded for this date.</p>
        </div>
      <% end %>
    </div>

    <!-- Footer / Close -->
    <div class="flex-none flex justify-end border-t border-slate-100 bg-slate-50/50 px-5 py-3">
      <button type="button" onclick="document.getElementById('occupancy-details-dialog').close()" class="rounded-lg border border-slate-200 bg-white px-4 py-2 text-sm font-bold text-slate-700 hover:bg-slate-50">Close</button>
    </div>
  </div>
<% end %>
