<%= turbo_frame_tag "occupancy_details_frame" do %>
  <div class="flex h-full max-h-[85vh] flex-col bg-white">
    <!-- Header -->
    <div class="flex-none flex items-start justify-between border-b border-slate-100 px-5 py-4">
      <div>
        <h2 class="text-lg font-bold tracking-tight text-slate-950">Guests & Bookings</h2>
        <p class="text-xs font-semibold text-slate-500">Occupancy details for <%= @date.strftime("%A, %b %-d, %Y") %></p>
      </div>
      <button type="button" onclick="document.getElementById('occupancy-details-dialog').close()" class="rounded-lg p-2 text-slate-400 hover:bg-slate-200 hover:text-slate-700" aria-label="Close dialog">
        <svg class="size-5" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg>
      </button>
    </div>

    <!-- Body / List -->
    <div class="flex-1 overflow-y-auto px-5 py-4 space-y-6">
      <% if @grouped_booking_rooms.any? %>
        <% @grouped_booking_rooms.each do |room_type, booking_rooms| %>
          <div>
            <h3 class="mb-2.5 text-xs font-bold text-slate-400 uppercase tracking-wider flex items-center gap-2 select-none">
              <span class="inline-flex size-1.5 rounded-full bg-indigo-500"></span>
              <%= room_type.name %>
              <span class="rounded-full bg-slate-100 px-2 py-0.5 text-[10px] font-bold text-slate-500 tabular-nums"><%= booking_rooms.size %></span>
            </h3>
            <div class="overflow-hidden rounded-xl border border-slate-200 bg-white">
              <table class="w-full border-collapse text-left text-sm text-slate-500">
                <thead class="bg-slate-50 text-[11px] font-bold uppercase tracking-wider text-slate-500 border-b border-slate-200 select-none">
                  <tr>
                    <th scope="col" class="px-4 py-2.5 w-24">Room</th>
                    <th scope="col" class="px-4 py-2.5">Guest Name</th>
                    <th scope="col" class="px-4 py-2.5">Stay Duration</th>
                    <th scope="col" class="px-4 py-2.5 text-right">Status</th>
                  </tr>
                </thead>
                <tbody class="divide-y divide-slate-100 bg-white">
                  <% booking_rooms.each do |br| %>
                    <% booking = br.booking %>
                    <tr class="hover:bg-slate-50/50 transition-colors">
                      <td class="whitespace-nowrap px-4 py-3.5 font-bold text-slate-900 tabular-nums">
                        <%= br.room_number.presence || "—" %>
                      </td>
                      <td class="px-4 py-3.5">
                        <%= link_to booking.guest_name, hotel_booking_path(current_hotel, booking), target: "_blank", data: { turbo: false }, class: "font-bold text-indigo-600 hover:text-indigo-800 hover:underline" %>
                      </td>
                      <td class="whitespace-nowrap px-4 py-3.5 font-medium text-slate-600 tabular-nums">
                        <div class="leading-none text-slate-800 font-bold"><%= booking.check_in.strftime("%b %-d") %> – <%= booking.check_out.strftime("%b %-d") %></div>
                        <div class="text-[10px] text-slate-400 font-semibold mt-1.5 leading-none"><%= pluralize(booking.duration_in_nights, "night") %></div>
                      </td>
                      <td class="whitespace-nowrap px-4 py-3.5 text-right">
                        <%
                          status_color = case booking.status.to_s
                          when "checked_in" then "bg-emerald-50 text-emerald-700 border-emerald-200/60"
                          when "confirmed" then "bg-indigo-50 text-indigo-700 border-indigo-200/60"
                          when "checked_out", "completed" then "bg-slate-50 text-slate-600 border-slate-200/60"
                          else "bg-amber-50 text-amber-700 border-amber-200/60"
                          end
                        %>
                        <span class="inline-flex items-center rounded-md border px-2 py-0.5 text-xs font-semibold <%= status_color %>">
                          <%= booking.status.titleize %>
                        </span>
                      </td>
                    </tr>
                  <% end %>
                </tbody>
              </table>
            </div>
          </div>
        <% end %>
      <% else %>
        <div class="flex flex-col items-center justify-center py-16 text-center">
          <div class="mx-auto mb-4 flex size-12 items-center justify-center rounded-full bg-slate-100 text-slate-400">
            <svg class="size-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" />
            </svg>
          </div>
          <h3 class="text-sm font-bold text-slate-900">No active bookings</h3>
          <p class="mt-1 text-xs text-slate-500 font-semibold">There are no guest arrivals or stays recorded for this date.</p>
        </div>
      <% end %>
    </div>

    <!-- Footer / Close -->
    <div class="flex-none flex justify-end border-t border-slate-100 bg-slate-50/50 px-5 py-3">
      <button type="button" onclick="document.getElementById('occupancy-details-dialog').close()" class="rounded-lg border border-slate-200 bg-white px-4 py-2 text-sm font-bold text-slate-700 hover:bg-slate-50">Close</button>
    </div>
  </div>
<% end %>
