<% content_for :breadcrumbs do %>
  <div class="flex items-center gap-x-2">
    <span class="text-sm font-medium text-slate-600"><%= current_hotel.name %></span>
    <span class="text-sm text-slate-400">/</span>
    <span class="text-sm font-semibold text-slate-900">Rates & Inventory</span>
  </div>
<% end %>

<div class="max-w-[1600px] mx-auto pb-20 space-y-8">
  <!-- Page Header -->
  <div class="px-4 md:px-0 mt-5">
    <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-6">
      <div>
        <h1 class="text-2xl font-bold tracking-tight text-slate-950 sm:text-3xl">Rates & Inventory Overview</h1>
        <p class="mt-1 text-sm font-medium text-slate-600">Monitor and manage daily rates and availability across all room types.</p>
      </div>

      <div class="flex items-center bg-white p-1 rounded-xl border border-slate-200 shadow-sm">
        <%= link_to hotel_inventory_index_path(current_hotel, start_date: @start_date - 14.days), class: "p-2 hover:bg-slate-50 hover:shadow-sm rounded-lg transition-all text-slate-500 hover:text-slate-900" do %>
          <svg class="size-4" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg>
        <% end %>
        <div class="px-5 text-center">
          <span class="block text-[10px] font-bold uppercase tracking-widest text-slate-400 mb-0.5">Date Range</span>
          <span class="block text-xs font-black text-slate-900 uppercase tracking-tight">
            <%= @start_date.strftime("%b %d") %> — <%= @end_date.strftime("%b %d, %Y") %>
          </span>
        </div>
        <%= link_to hotel_inventory_index_path(current_hotel, start_date: @start_date + 14.days), class: "p-2 hover:bg-slate-50 hover:shadow-sm rounded-lg transition-all text-slate-500 hover:text-slate-900" do %>
          <svg class="size-4" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg>
        <% end %>
      </div>
    </div>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-12 gap-8">
    <!-- Matrix Table -->
    <div class="lg:col-span-8">
      <div class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">
        <div class="overflow-x-auto custom-scrollbar">
          <table class="w-full text-left border-collapse">
            <thead class="bg-slate-100">
              <tr>
                <th class="sticky left-0 z-10 px-8 py-5 bg-slate-100 border-b border-r border-slate-200 min-w-[260px] shadow-[4px_0_8px_-2px_rgba(0,0,0,0.05)]">
                  <span class="text-[11px] font-bold text-slate-600 uppercase tracking-widest">Room Type / Date</span>
                </th>
                <% (@start_date..@end_date).each do |date| %>
                  <% is_today = date == Date.today %>
                  <th class="px-4 py-4 text-center border-b border-r border-slate-200 last:border-r-0 min-w-[100px] <%= is_today ? 'bg-blue-50/50' : '' %>">
                    <span class="block text-[10px] font-bold uppercase tracking-wider <%= is_today ? 'text-blue-600' : 'text-slate-500' %>"><%= date.strftime("%a") %></span>
                    <span class="block text-sm font-black <%= is_today ? 'text-blue-700' : 'text-slate-900' %>"><%= date.strftime("%d %b") %></span>
                  </th>
                <% end %>
              </tr>
            </thead>
            <tbody class="divide-y divide-slate-200 bg-white">
              <% @room_types.each do |rt| %>
                <tr class="group">
                  <td class="sticky left-0 z-10 px-8 py-6 bg-white border-r border-slate-200 group-hover:bg-slate-50 transition-colors shadow-[4px_0_8px_-2px_rgba(0,0,0,0.05)]">
                    <div class="flex flex-col">
                      <span class="text-sm font-bold text-slate-900 group-hover:text-blue-600 transition-colors"><%= rt.name %></span>
                      <div class="flex items-center gap-x-2 mt-2">
                        <%= link_to hotel_room_type_rates_path(current_hotel, rt), class: "text-[10px] font-bold uppercase tracking-wider text-slate-400 hover:text-slate-900 transition-colors" do %>
                          Rates
                        <% end %>
                        <span class="text-slate-200">•</span>
                        <%= link_to hotel_room_type_inventories_path(current_hotel, rt), class: "text-[10px] font-bold uppercase tracking-wider text-slate-400 hover:text-slate-900 transition-colors" do %>
                          Inventory
                        <% end %>
                      </div>
                    </div>
                  </td>
                  
                  <% (@start_date..@end_date).each do |date| %>
                    <% 
                      inv = @inventory_matrix[rt.id][date]
                      rate = @rates_matrix[rt.id][date]
                      
                      quantity = inv&.quantity || rt.quantity
                      status = inv&.status || 'open'
                      price = rate&.price || rt.base_price
                      
                      is_closed = (status == 'closed' || quantity <= 0)
                      is_today = date == Date.today
                    %>
                    <td class="px-2 py-6 text-center border-r border-slate-200 last:border-r-0 hover:bg-slate-50 transition-colors <%= is_today ? 'bg-blue-50/20' : '' %>">
                      <div class="flex flex-col items-center">
                        <span class="text-xs font-black <%= is_closed ? 'text-red-600' : 'text-slate-900' %>">
                          <%= quantity %> <span class="text-[9px] font-bold uppercase text-slate-400 ml-0.5 tracking-tighter">Left</span>
                        </span>
                        <span class="mt-2 text-xs font-black text-blue-600">
                          RM<%= number_with_precision(price, precision: 0) %>
                        </span>
                        
                        <% if is_closed %>
                          <div class="mt-2.5 size-1.5 rounded-full bg-red-500 shadow-[0_0_8px_rgba(239,68,68,0.4)]"></div>
                        <% end %>
                      </div>
                    </td>
                  <% end %>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      </div>
      
      <!-- Legend -->
      <div class="flex flex-wrap items-center gap-x-8 gap-y-3 mt-6 px-4">
        <div class="flex items-center gap-x-2">
          <div class="size-3 rounded bg-white border border-slate-200 shadow-sm"></div>
          <span class="text-[10px] font-bold text-slate-500 uppercase tracking-wider">Available</span>
        </div>
        <div class="flex items-center gap-x-2">
          <div class="size-2 rounded-full bg-red-500"></div>
          <span class="text-[10px] font-bold text-slate-500 uppercase tracking-wider">Closed / Sold Out</span>
        </div>
        <div class="flex items-center gap-x-2">
          <span class="text-[10px] font-black text-blue-600">RM</span>
          <span class="text-[10px] font-bold text-slate-500 uppercase tracking-wider">Daily Rate</span>
        </div>
      </div>
    </div>

    <!-- Bulk Update Side Card -->
    <div class="lg:col-span-4 space-y-8">
      <div class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">
        <div class="border-b border-slate-200 bg-slate-50/70 px-6 py-5 sm:px-8">
          <h3 class="text-sm font-bold text-slate-900 uppercase tracking-wider">Global Bulk Update</h3>
        </div>
        <div class="p-6 sm:p-8">
          <%= form_with scope: :bulk_update, url: hotel_inventory_dashboards_path(current_hotel), local: true, class: "space-y-6" do |f| %>
            <div>
              <label class="block text-[11px] font-bold uppercase tracking-wider text-slate-500 mb-2">Target Room Categories</label>
              <div class="space-y-1.5 max-h-48 overflow-y-auto p-4 border border-slate-200 rounded-xl bg-slate-50/30 custom-scrollbar">
                <% @room_types.each do |rt| %>
                  <label class="flex items-center gap-x-3 cursor-pointer group">
                    <div class="relative flex items-center">
                      <%= f.check_box :room_type_ids, { multiple: true, checked: true, class: "size-4 rounded border-slate-300 text-slate-900 focus:ring-0 focus:ring-offset-0" }, rt.id, nil %>
                    </div>
                    <span class="text-xs font-bold text-slate-700 group-hover:text-slate-900 transition-colors"><%= rt.name %></span>
                  </label>
                <% end %>
              </div>
              <p class="text-[10px] text-slate-400 mt-2 italic leading-relaxed">Select rooms to apply these global changes.</p>
            </div>

            <div class="grid grid-cols-2 gap-4">
              <div>
                <label for="start_date" class="block text-[11px] font-bold uppercase tracking-wider text-slate-500 mb-2">Start Date</label>
                <%= f.date_field :start_date, value: @start_date, id: "start_date", class: "w-full rounded-xl border border-slate-200 bg-white px-3 py-2.5 text-sm font-medium text-slate-700 focus:border-slate-300 focus:outline-none focus:ring-0 shadow-sm" %>
              </div>
              <div>
                <label for="end_date" class="block text-[11px] font-bold uppercase tracking-wider text-slate-500 mb-2">End Date</label>
                <%= f.date_field :end_date, value: @end_date, id: "end_date", class: "w-full rounded-xl border border-slate-200 bg-white px-3 py-2.5 text-sm font-medium text-slate-700 focus:border-slate-300 focus:outline-none focus:ring-0 shadow-sm" %>
              </div>
            </div>

            <div class="pt-2">
              <label for="price" class="block text-[11px] font-bold uppercase tracking-wider text-slate-500 mb-2">New Daily Rate</label>
              <div class="relative">
                <div class="absolute inset-y-0 start-0 flex items-center ps-4 pointer-events-none">
                  <span class="text-sm font-bold text-slate-400">RM</span>
                </div>
                <%= f.number_field :price, step: 0.01, id: "price", placeholder: "Optional", class: "w-full rounded-xl border border-slate-200 bg-white ps-11 pe-4 py-2.5 text-sm font-bold text-slate-900 focus:border-slate-300 focus:outline-none focus:ring-0 shadow-sm" %>
              </div>
            </div>

            <div class="grid grid-cols-2 gap-4">
              <div>
                <label for="quantity" class="block text-[11px] font-bold uppercase tracking-wider text-slate-500 mb-2">Units Allot</label>
                <%= f.number_field :quantity, id: "quantity", min: 0, placeholder: "Optional", class: "w-full rounded-xl border border-slate-200 bg-white px-4 py-2.5 text-sm font-bold text-slate-900 focus:border-slate-300 focus:outline-none focus:ring-0 shadow-sm" %>
              </div>
              <div>
                <label for="status" class="block text-[11px] font-bold uppercase tracking-wider text-slate-500 mb-2">Room Status</label>
                <%= f.select :status, [['No change', ''], ['Open', 'open'], ['Closed', 'closed']], {}, id: "status", class: "w-full rounded-xl border border-slate-200 bg-white px-4 py-2.5 text-sm font-bold text-slate-700 focus:border-slate-300 focus:outline-none focus:ring-0 shadow-sm" %>
              </div>
            </div>

            <div class="pt-4">
              <%= f.submit "Apply Global Updates", class: "w-full inline-flex items-center justify-center rounded-xl bg-slate-900 px-6 py-3.5 text-sm font-bold text-white shadow-lg transition hover:bg-slate-700" %>
            </div>
          <% end %>
        </div>
      </div>
      
      <div class="p-5 rounded-2xl bg-blue-50 border border-blue-100 flex gap-4">
        <div class="flex-none size-9 rounded-lg bg-blue-600/10 flex items-center justify-center text-blue-600">
           <svg class="size-5" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M12 16v-4"/><path d="M12 8h.01"/></svg>
        </div>
        <div class="min-w-0">
          <h4 class="text-[11px] font-bold text-blue-900 uppercase tracking-wider mb-1">Operational Tip</h4>
          <p class="text-xs text-blue-800/70 leading-relaxed">Global updates are perfect for setting seasonal rates or blocking rooms for large groups across all categories at once.</p>
        </div>
      </div>
    </div>
  </div>
</div>
