<% content_for :breadcrumbs do %>
  <div class="flex items-center gap-x-2">
    <span class="text-sm font-medium text-slate-600"><%= current_hotel.name %></span>
    <span class="text-sm text-slate-400">/</span>
    <span class="text-sm font-semibold text-slate-900">Rates & Inventory</span>
  </div>
<% end %>

<div class="max-w-[1600px] mx-auto pb-20 space-y-8">
  <!-- Page Header -->
  <div class="px-4 md:px-0 mt-5">
    <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-6">
      <div>
        <h1 class="text-2xl font-bold tracking-tight text-slate-950 sm:text-3xl">Rates & Inventory Overview</h1>
        <p class="mt-1 text-sm font-medium text-slate-600">Monitor and manage daily rates and availability across all room types.</p>
      </div>

      <div class="flex items-center bg-white p-1 rounded-xl border border-slate-200 shadow-sm">
        <%= link_to hotel_inventory_index_path(current_hotel, start_date: @start_date - 14.days), class: "p-2 hover:bg-slate-50 hover:shadow-sm rounded-lg transition-all text-slate-500 hover:text-slate-900" do %>
          <svg class="size-4" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg>
        <% end %>
        <div class="px-5 text-center">
          <span class="block text-[10px] font-bold uppercase tracking-widest text-slate-400 mb-0.5">Date Range</span>
          <span class="block text-xs font-black text-slate-900 uppercase tracking-tight">
            <%= @start_date.strftime("%b %d") %> — <%= @end_date.strftime("%b %d, %Y") %>
          </span>
        </div>
        <%= link_to hotel_inventory_index_path(current_hotel, start_date: @start_date + 14.days), class: "p-2 hover:bg-slate-50 hover:shadow-sm rounded-lg transition-all text-slate-500 hover:text-slate-900" do %>
          <svg class="size-4" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg>
        <% end %>
      </div>
    </div>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-12 gap-8">
    <!-- Room Readiness Table -->
    <div class="lg:col-span-8">
      <div class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">
        <div class="overflow-x-auto custom-scrollbar">
          <table class="w-full text-left border-collapse">
            <thead class="bg-slate-100">
              <tr>
                <th class="sticky left-0 z-10 px-8 py-5 bg-slate-100 border-b border-r border-slate-200 min-w-[260px] shadow-[4px_0_8px_-2px_rgba(0,0,0,0.05)]">
                  <span class="text-[11px] font-bold text-slate-600 uppercase tracking-widest">Room Type / Date</span>
                </th>
                <% (@start_date..@end_date).each do |date| %>
                  <% is_today = date == Date.today %>
                  <th class="px-4 py-4 text-center border-b border-r border-slate-200 last:border-r-0 min-w-[100px] <%= is_today ? 'bg-blue-50/50' : '' %>">
                    <span class="block text-[10px] font-bold uppercase tracking-wider <%= is_today ? 'text-blue-600' : 'text-slate-500' %>"><%= date.strftime("%a") %></span>
                    <span class="block text-sm font-black <%= is_today ? 'text-blue-700' : 'text-slate-900' %>"><%= date.strftime("%d %b") %></span>
                  </th>
                <% end %>
              </tr>
            </thead>
            <tbody class="divide-y divide-slate-200 bg-white">
              <% @room_types.each do |rt| %>
                <tr class="group">
                  <td class="sticky left-0 z-10 px-8 py-6 bg-white border-r border-slate-200 group-hover:bg-slate-50 transition-colors shadow-[4px_0_8px_-2px_rgba(0,0,0,0.05)]">
                    <div class="flex flex-col">
                      <span class="text-sm font-bold text-slate-900 group-hover:text-blue-600 transition-colors"><%= rt.name %></span>
                      <div class="flex items-center gap-x-2 mt-2">
                        <%= link_to hotel_room_type_rates_path(current_hotel, rt), class: "text-[10px] font-bold uppercase tracking-wider text-slate-400 hover:text-slate-900 transition-colors" do %>
                          Rates
                        <% end %>
                        <span class="text-slate-200">•</span>
                        <%= link_to hotel_room_type_inventories_path(current_hotel, rt), class: "text-[10px] font-bold uppercase tracking-wider text-slate-400 hover:text-slate-900 transition-colors" do %>
                          Inventory
                        <% end %>
                      </div>
                    </div>
                  </td>
                  
                  <% (@start_date..@end_date).each do |date| %>
                    <% 
                      inv = @inventory_matrix[rt.id][date]
                      rate = @rates_matrix[rt.id][date]
                      
                      quantity = inv&.quantity || rt.quantity
                      status = inv&.status || 'open'
                      price = rate&.price || rt.base_price
                      
                      is_closed = (status == 'closed' || quantity <= 0)
                      is_today = date == Date.today
                    %>
                    <td class="px-2 py-6 text-center border-r border-slate-200 last:border-r-0 hover:bg-slate-50 transition-colors <%= is_today ? 'bg-blue-50/20' : '' %>">
                      <div class="flex flex-col items-center">
                        <span class="text-xs font-black <%= is_closed ? 'text-red-600' : 'text-slate-900' %>">
                          <%= quantity %> <span class="text-[9px] font-bold uppercase text-slate-400 ml-0.5 tracking-tighter">Left</span>
                        </span>
                        <span class="mt-2 text-xs font-black text-blue-600">
                          RM<%= number_with_precision(price, precision: 0) %>
                        </span>
                        
                        <% if is_closed %>
                          <div class="mt-2.5 size-1.5 rounded-full bg-red-500 shadow-[0_0_8px_rgba(239,68,68,0.4)]"></div>
                        <% end %>
                      </div>
                    </td>
                  <% end %>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      </div>
      
      <!-- Legend -->
      <div class="flex flex-wrap items-center gap-x-8 gap-y-3 mt-6 px-4">
        <div class="flex items-center gap-x-2">
          <div class="size-3 rounded bg-white border border-slate-200 shadow-sm"></div>
          <span class="text-[10px] font-bold text-slate-500 uppercase tracking-wider">Available</span>
        </div>
        <div class="flex items-center gap-x-2">
          <div class="size-2 rounded-full bg-red-500"></div>
          <span class="text-[10px] font-bold text-slate-500 uppercase tracking-wider">Closed / Sold Out</span>
        </div>
        <div class="flex items-center gap-x-2">
          <span class="text-[10px] font-black text-blue-600">RM</span>
          <span class="text-[10px] font-bold text-slate-500 uppercase tracking-wider">Daily Rate</span>
        </div>
      </div>
    </div>

    <!-- Pricing + Availability Side Cards -->
    <div class="lg:col-span-4 space-y-8">
      <div class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">
        <div class="border-b border-slate-200 bg-slate-50/70 px-6 py-5 sm:px-8">
          <h3 class="text-sm font-bold text-slate-900 uppercase tracking-wider">Pricing Rules</h3>
          <p class="mt-1 text-[11px] font-medium text-slate-500">
            <% if @last_pricing_applied_at.present? %>
              Last applied <%= time_ago_in_words(@last_pricing_applied_at) %> ago
            <% else %>
              Not applied yet
            <% end %>
          </p>
        </div>
        <div class="p-6 sm:p-8">
          <%= form_with scope: :pricing_rule, url: apply_pricing_rules_hotel_inventory_dashboards_path(current_hotel), local: true, class: "space-y-6" do |f| %>
            <div>
              <label class="block text-[11px] font-bold uppercase tracking-wider text-slate-500 mb-2">Target Room Categories</label>
              <div class="space-y-1.5 max-h-48 overflow-y-auto p-4 border border-slate-200 rounded-xl bg-slate-50/30 custom-scrollbar">
                <% @room_types.each do |rt| %>
                  <label class="flex items-center gap-x-3 cursor-pointer group">
                    <div class="relative flex items-center">
                      <%= f.check_box :room_type_ids, { multiple: true, checked: @pricing_form.selected_room_type_ids.include?(rt.id), class: "size-4 rounded border-slate-300 text-slate-900 focus:ring-0 focus:ring-offset-0" }, rt.id, nil %>
                    </div>
                    <span class="text-xs font-bold text-slate-700 group-hover:text-slate-900 transition-colors"><%= rt.name %></span>
                  </label>
                <% end %>
              </div>
              <p class="text-[10px] text-slate-400 mt-2 italic leading-relaxed">Select rooms to apply these global changes.</p>
            </div>

            <div class="space-y-4" data-controller="pricing-tier-tabs">
              <div class="rounded-xl border border-slate-200 bg-slate-50/40 p-3">
                <div class="grid grid-cols-4 gap-1">
                  <button type="button" data-action="pricing-tier-tabs#switch" data-pricing-tier-tabs-target="tab" data-tier="gp" class="rounded-lg border border-slate-900 bg-slate-900 md:px-2 px-3 py-2 text-[10px] font-black uppercase tracking-wider text-white" aria-selected="true">General</button>
                  <button type="button" data-action="pricing-tier-tabs#switch" data-pricing-tier-tabs-target="tab" data-tier="wk" class="rounded-lg border border-slate-200 bg-white md:px-0 px-3 py-2 text-[10px] font-black uppercase tracking-wider text-slate-600" aria-selected="false">Weekends</button>
                  <button type="button" data-action="pricing-tier-tabs#switch" data-pricing-tier-tabs-target="tab" data-tier="sc" class="rounded-lg border border-slate-200 bg-white md:px-2 px-3 py-2 text-[10px] font-black uppercase tracking-wider text-slate-600" aria-selected="false">School Holiday</button>
                  <button type="button" data-action="pricing-tier-tabs#switch" data-pricing-tier-tabs-target="tab" data-tier="ph" class="rounded-lg border border-slate-200 bg-white md:px-2 px-3 py-2 text-[10px] font-black uppercase tracking-wider text-slate-600" aria-selected="false">Public Holiday</button>
                </div>
              </div>

              <div data-pricing-tier-tabs-target="panel" data-tier="gp" class="rounded-xl border border-slate-200 bg-slate-50/40 p-4">
                <div class="mb-3 flex items-center justify-between">
                  <h4 class="text-xs font-black uppercase tracking-wider text-slate-900">General Pricing</h4>
                  <div class="flex items-center gap-2">
                    <% if @pricing_form.general_rule.present? %>
                      <%= link_to destroy_pricing_tier_rule_hotel_inventory_dashboards_path(current_hotel, rule_type: "general", start_date: @start_date),
                        data: { turbo_method: :delete, turbo_confirm: "Remove General pricing?" },
                        class: "inline-flex items-center justify-center gap-1.5 rounded-lg bg-red-600 px-3 py-1.5 text-[10px] font-bold uppercase tracking-wider text-white hover:bg-red-700" do %>
                        <svg class="size-3.5" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.3" stroke-linecap="round" stroke-linejoin="round"><path d="M3 6h18"/><path d="M8 6V4h8v2"/><path d="M19 6l-1 14H6L5 6"/><path d="M10 11v6"/><path d="M14 11v6"/></svg>
                        Remove
                      <% end %>
                    <% end %>
                  </div>
                </div>
                <div class="grid grid-cols-2 gap-3 mb-3">
                  <div>
                    <label for="gp_start_date" class="block text-[11px] font-bold uppercase tracking-wider text-slate-500 mb-2">Start</label>
                    <%= f.date_field :gp_start_date, value: @pricing_form.pricing_data[:gp_start_date], id: "gp_start_date", class: "w-full rounded-xl border border-slate-200 bg-white px-3 py-2.5 text-sm font-medium text-slate-700 focus:border-slate-300 focus:outline-none focus:ring-0 shadow-sm" %>
                  </div>
                  <div>
                    <label for="gp_end_date" class="block text-[11px] font-bold uppercase tracking-wider text-slate-500 mb-2">End (Optional)</label>
                    <%= f.date_field :gp_end_date, value: @pricing_form.pricing_data[:gp_end_date], id: "gp_end_date", class: "w-full rounded-xl border border-slate-200 bg-white px-3 py-2.5 text-sm font-medium text-slate-700 focus:border-slate-300 focus:outline-none focus:ring-0 shadow-sm" %>
                  </div>
                </div>
                <label for="gp_price" class="block text-[11px] font-bold uppercase tracking-wider text-slate-500 mb-2">Price</label>
                <div class="relative">
                  <div class="absolute inset-y-0 start-0 flex items-center ps-4 pointer-events-none">
                    <span class="text-sm font-bold text-slate-400">RM</span>
                  </div>
                  <%= f.number_field :gp_price, value: @pricing_form.pricing_data[:gp_price], step: 0.01, id: "gp_price", placeholder: "Optional", class: "w-full rounded-xl border border-slate-200 bg-white ps-11 pe-4 py-2.5 text-sm font-bold text-slate-900 focus:border-slate-300 focus:outline-none focus:ring-0 shadow-sm" %>
                </div>
              </div>

              <div data-pricing-tier-tabs-target="panel" data-tier="wk" class="hidden rounded-xl border border-slate-200 bg-slate-50/40 p-4">
                <div class="mb-3 flex items-center justify-between">
                  <h4 class="text-xs font-black uppercase tracking-wider text-slate-900">Weekends Pricing</h4>
                  <div class="flex items-center gap-2">
                    <% if @pricing_form.weekends_rule.present? %>
                      <%= link_to destroy_pricing_tier_rule_hotel_inventory_dashboards_path(current_hotel, rule_type: "weekends", start_date: @start_date),
                        data: { turbo_method: :delete, turbo_confirm: "Remove Weekends pricing?" },
                        class: "inline-flex items-center justify-center gap-1.5 rounded-lg bg-red-600 px-3 py-1.5 text-[10px] font-bold uppercase tracking-wider text-white hover:bg-red-700" do %>
                        <svg class="size-3.5" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.3" stroke-linecap="round" stroke-linejoin="round"><path d="M3 6h18"/><path d="M8 6V4h8v2"/><path d="M19 6l-1 14H6L5 6"/><path d="M10 11v6"/><path d="M14 11v6"/></svg>
                        Remove
                      <% end %>
                    <% end %>
                  </div>
                </div>
                <div class="grid grid-cols-2 gap-3 mb-3">
                  <div>
                    <label for="wk_start_date" class="block text-[11px] font-bold uppercase tracking-wider text-slate-500 mb-2">Start</label>
                    <%= f.date_field :wk_start_date, value: @pricing_form.pricing_data[:wk_start_date], id: "wk_start_date", class: "w-full rounded-xl border border-slate-200 bg-white px-3 py-2.5 text-sm font-medium text-slate-700 focus:border-slate-300 focus:outline-none focus:ring-0 shadow-sm" %>
                  </div>
                  <div>
                    <label for="wk_end_date" class="block text-[11px] font-bold uppercase tracking-wider text-slate-500 mb-2">End (Optional)</label>
                    <%= f.date_field :wk_end_date, value: @pricing_form.pricing_data[:wk_end_date], id: "wk_end_date", class: "w-full rounded-xl border border-slate-200 bg-white px-3 py-2.5 text-sm font-medium text-slate-700 focus:border-slate-300 focus:outline-none focus:ring-0 shadow-sm" %>
                  </div>
                </div>
                <label for="wk_price" class="block text-[11px] font-bold uppercase tracking-wider text-slate-500 mb-2">Price</label>
                <div class="relative">
                  <div class="absolute inset-y-0 start-0 flex items-center ps-4 pointer-events-none">
                    <span class="text-sm font-bold text-slate-400">RM</span>
                  </div>
                  <%= f.number_field :wk_price, value: @pricing_form.pricing_data[:wk_price], step: 0.01, id: "wk_price", placeholder: "Optional", class: "w-full rounded-xl border border-slate-200 bg-white ps-11 pe-4 py-2.5 text-sm font-bold text-slate-900 focus:border-slate-300 focus:outline-none focus:ring-0 shadow-sm" %>
                </div>
                <p class="mt-2 text-[10px] text-slate-500">Select which weekdays this weekend rule should target.</p>
                <div class="mt-3 grid grid-cols-4 gap-2">
                  <% HotelPortal::InventoryDashboardsController::WEEKDAY_OPTIONS.each do |label, value| %>
                    <% input_id = "weekend_day_#{value}" %>
                    <label for="<%= input_id %>" class="inline-flex items-center justify-center rounded-lg border border-slate-200 bg-white px-2 py-1.5 text-[10px] font-bold uppercase tracking-wider text-slate-600">
                      <%= check_box_tag "pricing_rule[weekend_days][]", value, @pricing_form.weekend_days.include?(value), id: input_id, class: "me-1.5 size-3.5 rounded border-slate-300 text-slate-900 focus:ring-0 focus:ring-offset-0" %>
                      <%= label %>
                    </label>
                  <% end %>
                </div>
              </div>

              <div data-pricing-tier-tabs-target="panel" data-tier="sc" class="hidden rounded-xl border border-slate-200 bg-slate-50/40 p-4">
                <div class="mb-3 flex items-center justify-between">
                  <h4 class="text-xs font-black uppercase tracking-wider text-slate-900">School Holiday Pricing</h4>
                  <div class="flex items-center gap-2">
                    <% if @pricing_form.school_rule.present? %>
                      <%= link_to destroy_pricing_tier_rule_hotel_inventory_dashboards_path(current_hotel, rule_type: "school_holiday", start_date: @start_date),
                        data: { turbo_method: :delete, turbo_confirm: "Remove School Holiday pricing?" },
                        class: "inline-flex items-center justify-center gap-1.5 rounded-lg bg-red-600 px-3 py-1.5 text-[10px] font-bold uppercase tracking-wider text-white hover:bg-red-700" do %>
                        <svg class="size-3.5" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.3" stroke-linecap="round" stroke-linejoin="round"><path d="M3 6h18"/><path d="M8 6V4h8v2"/><path d="M19 6l-1 14H6L5 6"/><path d="M10 11v6"/><path d="M14 11v6"/></svg>
                        Remove
                      <% end %>
                    <% end %>
                  </div>
                </div>
                <div class="grid grid-cols-2 gap-3">
                  <div>
                    <label for="sc_start_date" class="block text-[11px] font-bold uppercase tracking-wider text-slate-500 mb-2">Start</label>
                    <%= f.date_field :sc_start_date, value: @pricing_form.pricing_data[:sc_start_date], id: "sc_start_date", class: "w-full rounded-xl border border-slate-200 bg-white px-3 py-2.5 text-sm font-medium text-slate-700 focus:border-slate-300 focus:outline-none focus:ring-0 shadow-sm" %>
                  </div>
                  <div>
                    <label for="sc_end_date" class="block text-[11px] font-bold uppercase tracking-wider text-slate-500 mb-2">End (Optional)</label>
                    <%= f.date_field :sc_end_date, value: @pricing_form.pricing_data[:sc_end_date], id: "sc_end_date", class: "w-full rounded-xl border border-slate-200 bg-white px-3 py-2.5 text-sm font-medium text-slate-700 focus:border-slate-300 focus:outline-none focus:ring-0 shadow-sm" %>
                  </div>
                </div>
                <label for="sc_price" class="mt-3 block text-[11px] font-bold uppercase tracking-wider text-slate-500 mb-2">Price</label>
                <div class="relative">
                  <div class="absolute inset-y-0 start-0 flex items-center ps-4 pointer-events-none">
                    <span class="text-sm font-bold text-slate-400">RM</span>
                  </div>
                  <%= f.number_field :sc_price, value: @pricing_form.pricing_data[:sc_price], step: 0.01, id: "sc_price", placeholder: "Optional", class: "w-full rounded-xl border border-slate-200 bg-white ps-11 pe-4 py-2.5 text-sm font-bold text-slate-900 focus:border-slate-300 focus:outline-none focus:ring-0 shadow-sm" %>
                </div>
              </div>

              <div data-pricing-tier-tabs-target="panel" data-tier="ph" class="hidden rounded-xl border border-slate-200 bg-slate-50/40 p-4" data-controller="public-holiday-rules">
                <div class="mb-3 flex items-center justify-between">
                  <h4 class="text-xs font-black uppercase tracking-wider text-slate-900">Public Holiday Pricing</h4>
                </div>
                <p class="mb-3 text-[10px] text-slate-500">Set named holidays with price. Use only Date for one-day holiday, End Date is optional.</p>

                <div data-public-holiday-rules-target="container" class="space-y-3">
                  <% @pricing_form.public_holiday_rows.each_with_index do |holiday, index| %>
                    <div data-public-holiday-row class="rounded-lg border border-slate-200 bg-white p-3">
                      <div class="mb-2 flex items-center justify-between">
                        <% if holiday.persisted? %>
                          <span class="inline-flex items-center rounded-md bg-emerald-50 px-2 py-0.5 text-[10px] font-bold uppercase tracking-wider text-emerald-700">Saved</span>
                        <% else %>
                          <span class="inline-flex items-center rounded-md bg-slate-100 px-2 py-0.5 text-[10px] font-bold uppercase tracking-wider text-slate-600">New Holiday</span>
                        <% end %>
                        <% if holiday.persisted? %>
                          <%= link_to destroy_public_holiday_rule_hotel_inventory_dashboards_path(current_hotel, id: holiday.id, start_date: @start_date),
                            data: { turbo_method: :delete, turbo_confirm: "Remove #{holiday.name}?" },
                            class: "inline-flex items-center justify-center gap-1.5 rounded-lg bg-red-600 px-3 py-1.5 text-[10px] font-bold uppercase tracking-wider text-white hover:bg-red-700" do %>
                            <svg class="size-3.5" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.3" stroke-linecap="round" stroke-linejoin="round"><path d="M3 6h18"/><path d="M8 6V4h8v2"/><path d="M19 6l-1 14H6L5 6"/><path d="M10 11v6"/><path d="M14 11v6"/></svg>
                            Remove
                          <% end %>
                        <% else %>
                          <button type="button" data-action="public-holiday-rules#remove" class="inline-flex items-center justify-center gap-1.5 rounded-lg bg-red-600 px-3 py-1.5 text-[10px] font-bold uppercase tracking-wider text-white hover:bg-red-700">
                            <svg class="size-3.5" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.3" stroke-linecap="round" stroke-linejoin="round"><path d="M3 6h18"/><path d="M8 6V4h8v2"/><path d="M19 6l-1 14H6L5 6"/><path d="M10 11v6"/><path d="M14 11v6"/></svg>
                            Remove
                          </button>
                        <% end %>
                      </div>
                      <div class="grid grid-cols-2 gap-3">
                        <div class="col-span-2">
                          <label class="block text-[11px] font-bold uppercase tracking-wider text-slate-500 mb-2">Holiday Name</label>
                          <input type="text" name="pricing_rule[public_holidays][][name]" value="<%= holiday&.name %>" placeholder="e.g. Kaamatan" class="w-full rounded-xl border border-slate-200 bg-white px-3 py-2.5 text-sm font-medium text-slate-700 focus:border-slate-300 focus:outline-none focus:ring-0 shadow-sm">
                        </div>
                        <div>
                          <label class="block text-[11px] font-bold uppercase tracking-wider text-slate-500 mb-2">Date</label>
                          <input type="date" name="pricing_rule[public_holidays][][start_date]" value="<%= holiday&.start_date %>" class="w-full rounded-xl border border-slate-200 bg-white px-3 py-2.5 text-sm font-medium text-slate-700 focus:border-slate-300 focus:outline-none focus:ring-0 shadow-sm">
                        </div>
                        <div>
                          <label class="block text-[11px] font-bold uppercase tracking-wider text-slate-500 mb-2">End Date (Optional)</label>
                          <input type="date" name="pricing_rule[public_holidays][][end_date]" value="<%= holiday&.end_date %>" class="w-full rounded-xl border border-slate-200 bg-white px-3 py-2.5 text-sm font-medium text-slate-700 focus:border-slate-300 focus:outline-none focus:ring-0 shadow-sm">
                        </div>
                      </div>
                      <% if @pricing_form.errors.dig(:public_holidays, index).present? %>
                        <p class="mt-2 text-[11px] font-medium text-red-600"><%= @pricing_form.errors.dig(:public_holidays, index) %></p>
                      <% end %>
                      <div class="mt-3">
                        <label class="block text-[11px] font-bold uppercase tracking-wider text-slate-500 mb-2">Price</label>
                        <div class="relative">
                          <div class="absolute inset-y-0 start-0 flex items-center ps-4 pointer-events-none">
                            <span class="text-sm font-bold text-slate-400">RM</span>
                          </div>
                          <input type="number" step="0.01" name="pricing_rule[public_holidays][][price]" value="<%= holiday&.price %>" placeholder="Optional" class="w-full rounded-xl border border-slate-200 bg-white ps-11 pe-4 py-2.5 text-sm font-bold text-slate-900 focus:border-slate-300 focus:outline-none focus:ring-0 shadow-sm">
                        </div>
                      </div>
                  </div>
                  <% end %>
                </div>
                <% if @pricing_form.errors[:base].present? %>
                  <div class="mt-3 rounded-lg border border-red-200 bg-red-50 px-3 py-2 text-[11px] font-medium text-red-700">
                    <%= @pricing_form.errors[:base].join(" ") %>
                  </div>
                <% end %>

                <button type="button" data-action="public-holiday-rules#add" class="mt-3 w-full rounded-xl border border-slate-200 bg-white px-4 py-2.5 text-xs font-bold uppercase tracking-wider text-slate-700 hover:bg-slate-50">
                  + Add Public Holiday
                </button>

                <template data-public-holiday-rules-target="template">
                  <div data-public-holiday-row class="rounded-lg border border-slate-200 bg-white p-3">
                    <div class="mb-2 flex items-center justify-end">
                      <button type="button" data-action="public-holiday-rules#remove" class="inline-flex items-center justify-center gap-1.5 rounded-lg bg-red-600 px-3 py-1.5 text-[10px] font-bold uppercase tracking-wider text-white hover:bg-red-700">
                        <svg class="size-3.5" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.3" stroke-linecap="round" stroke-linejoin="round"><path d="M3 6h18"/><path d="M8 6V4h8v2"/><path d="M19 6l-1 14H6L5 6"/><path d="M10 11v6"/><path d="M14 11v6"/></svg>
                        Remove
                      </button>
                    </div>
                    <div class="grid grid-cols-2 gap-3">
                      <div class="col-span-2">
                        <label class="block text-[11px] font-bold uppercase tracking-wider text-slate-500 mb-2">Holiday Name</label>
                        <input type="text" name="pricing_rule[public_holidays][][name]" placeholder="e.g. Kaamatan" class="w-full rounded-xl border border-slate-200 bg-white px-3 py-2.5 text-sm font-medium text-slate-700 focus:border-slate-300 focus:outline-none focus:ring-0 shadow-sm">
                      </div>
                      <div>
                        <label class="block text-[11px] font-bold uppercase tracking-wider text-slate-500 mb-2">Date</label>
                        <input type="date" name="pricing_rule[public_holidays][][start_date]" class="w-full rounded-xl border border-slate-200 bg-white px-3 py-2.5 text-sm font-medium text-slate-700 focus:border-slate-300 focus:outline-none focus:ring-0 shadow-sm">
                      </div>
                      <div>
                        <label class="block text-[11px] font-bold uppercase tracking-wider text-slate-500 mb-2">End Date (Optional)</label>
                        <input type="date" name="pricing_rule[public_holidays][][end_date]" class="w-full rounded-xl border border-slate-200 bg-white px-3 py-2.5 text-sm font-medium text-slate-700 focus:border-slate-300 focus:outline-none focus:ring-0 shadow-sm">
                      </div>
                    </div>
                    <div class="mt-3">
                      <label class="block text-[11px] font-bold uppercase tracking-wider text-slate-500 mb-2">Price</label>
                      <div class="relative">
                        <div class="absolute inset-y-0 start-0 flex items-center ps-4 pointer-events-none">
                          <span class="text-sm font-bold text-slate-400">RM</span>
                        </div>
                        <input type="number" step="0.01" name="pricing_rule[public_holidays][][price]" placeholder="Optional" class="w-full rounded-xl border border-slate-200 bg-white ps-11 pe-4 py-2.5 text-sm font-bold text-slate-900 focus:border-slate-300 focus:outline-none focus:ring-0 shadow-sm">
                      </div>
                    </div>
                  </div>
                </template>
              </div>
            </div>

            <div class="pt-2">
              <%= f.submit "Apply Pricing Rules", class: "w-full inline-flex items-center justify-center rounded-xl bg-slate-900 px-6 py-3.5 text-sm font-bold text-white shadow-lg transition hover:bg-slate-700" %>
            </div>
          <% end %>
        </div>
      </div>

      <div class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">
        <div class="border-b border-slate-200 bg-slate-50/70 px-6 py-5 sm:px-8">
          <h3 class="text-sm font-bold text-slate-900 uppercase tracking-wider">Availability Override</h3>
        </div>
        <div class="p-6 sm:p-8" data-controller="inventory-filter">
          <%= form_with scope: :availability_override, url: apply_availability_override_hotel_inventory_dashboards_path(current_hotel), local: true, class: "space-y-6" do |f| %>
            <div>
              <label class="block text-[11px] font-bold uppercase tracking-wider text-slate-500 mb-2">Target Room Categories</label>
              <div class="space-y-1.5 max-h-48 overflow-y-auto p-4 border border-slate-200 rounded-xl bg-slate-50/30 custom-scrollbar">
                <% @room_types.each do |rt| %>
                  <label class="flex items-center gap-x-3 cursor-pointer group">
                    <div class="relative flex items-center">
                      <%= f.check_box :room_type_ids, {
                          multiple: true,
                          checked: true,
                          class: "size-4 rounded border-slate-300 text-slate-900 focus:ring-0 focus:ring-offset-0",
                          data: { inventory_filter_target: "category", action: "change->inventory-filter#filter" }
                        }, rt.id, nil %>
                    </div>
                    <span class="text-xs font-bold text-slate-700 group-hover:text-slate-900 transition-colors"><%= rt.name %></span>
                  </label>
                <% end %>
              </div>
            </div>

            <div class="grid grid-cols-2 gap-4">
              <div>
                <label for="availability_start_date" class="block text-[11px] font-bold uppercase tracking-wider text-slate-500 mb-2">Start Date</label>
                <%= f.date_field :start_date, value: @start_date, id: "availability_start_date", class: "w-full rounded-xl border border-slate-200 bg-white px-3 py-2.5 text-sm font-medium text-slate-700 focus:border-slate-300 focus:outline-none focus:ring-0 shadow-sm" %>
              </div>
              <div>
                <label for="availability_end_date" class="block text-[11px] font-bold uppercase tracking-wider text-slate-500 mb-2">End Date</label>
                <%= f.date_field :end_date, value: @end_date, id: "availability_end_date", class: "w-full rounded-xl border border-slate-200 bg-white px-3 py-2.5 text-sm font-medium text-slate-700 focus:border-slate-300 focus:outline-none focus:ring-0 shadow-sm" %>
              </div>
            </div>

            <div>
              <label class="block text-[11px] font-bold uppercase tracking-wider text-slate-500 mb-2">Daily Room Assignments</label>
              <div class="space-y-1.5 max-h-48 overflow-y-auto p-4 border border-slate-200 rounded-xl bg-slate-50/30 custom-scrollbar">
                <% @room_types.each do |rt| %>
                  <%
                    # Default to all rooms checked so the owner only unchecks rooms that should be blocked.
                    open_rooms = rt.room_numbers
                  %>
                  <% rt.room_numbers.sort.each do |num| %>
                    <label class="flex items-center gap-x-3 cursor-pointer group" data-inventory-filter-target="roomRow" data-room-type-id="<%= rt.id %>">
                      <div class="relative flex items-center">
                        <%= f.check_box :room_numbers, {
                            multiple: true,
                            checked: open_rooms.include?(num.to_s),
                            class: "size-4 rounded border-slate-300 text-slate-900 focus:ring-0 focus:ring-offset-0"
                          }, num, nil %>
                      </div>
                      <span class="text-xs font-bold text-slate-700 group-hover:text-slate-900 transition-colors">Room <%= num %> <span class="text-[10px] font-medium text-slate-400 ml-1">(<%= rt.name %>)</span></span>
                    </label>
                  <% end %>
                <% end %>
              </div>
              <p class="mt-2 text-[11px] text-slate-500 italic">All rooms are checked by default. Uncheck the rooms that should not be bookable for the selected dates.</p>
            </div>

            <div class="grid grid-cols-1 gap-4">
              <div>
                <label for="availability_status" class="block text-[11px] font-bold uppercase tracking-wider text-slate-500 mb-2">Room Status</label>
                <%= f.select :status, [ [ "No change", "" ], [ "Open", "open" ], [ "Closed", "closed" ] ], {}, id: "availability_status", class: "w-full rounded-xl border border-slate-200 bg-white px-4 py-2.5 text-sm font-bold text-slate-700 focus:border-slate-300 focus:outline-none focus:ring-0 shadow-sm" %>
              </div>
            </div>

            <div class="pt-2">
              <%= f.submit "Apply Availability", class: "w-full inline-flex items-center justify-center rounded-xl bg-slate-900 px-6 py-3.5 text-sm font-bold text-white shadow-lg transition hover:bg-slate-700" %>
            </div>
          <% end %>
        </div>
      </div>

      <div class="p-5 rounded-2xl bg-blue-50 border border-blue-100 flex gap-4">
        <div class="flex-none size-9 rounded-lg bg-blue-600/10 flex items-center justify-center text-blue-600">
          <svg class="size-5" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M12 16v-4"/><path d="M12 8h.01"/></svg>
        </div>
        <div class="min-w-0">
          <h4 class="text-[11px] font-bold text-blue-900 uppercase tracking-wider mb-1">Operational Tip</h4>
          <p class="text-xs text-blue-800/70 leading-relaxed">Pricing rules only affect RM value. Availability override controls open/closed state and units for selected dates.</p>
        </div>
      </div>
    </div>
  </div>
</div>
