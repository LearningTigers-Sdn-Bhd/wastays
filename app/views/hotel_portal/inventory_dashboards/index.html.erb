<div id="top" class="w-full space-y-6"
     data-controller="inventory-calendar inventory-row inventory-highlight"
     data-inventory-calendar-hotel-id-value="<%= current_hotel.id %>"
     data-inventory-calendar-batch-url-value="<%= batch_save_ari_hotel_inventory_dashboards_path(current_hotel) %>"
     data-inventory-calendar-occupancy-details-url-value="<%= occupancy_details_hotel_inventory_dashboards_path(current_hotel) %>"
     data-inventory-calendar-default-mode-value="<%= @view_mode %>"
     data-inventory-calendar-default-start-value="<%= @start_date %>"
     data-inventory-calendar-default-end-value="<%= @end_date %>"
     data-inventory-calendar-default-currency-value="<%= @display_currency %>"
     data-inventory-calendar-charging-model-value="<%= current_hotel.sell_mode %>"
     data-inventory-calendar-base-currency-value="<%= @hotel_base_currency %>">

  <% if current_hotel.status == 'inventory_incomplete' %>
    <div class=" mb-6">
      <%= link_to hotel_dashboard_path(current_hotel), class: "inline-flex items-center gap-x-1.5 py-1.5 px-3 text-xs font-bold text-brand-primary border border-brand-primary/20 bg-brand-primary/5 rounded-lg hover:bg-brand-primary/10 transition-colors" do %>
        <svg class="size-3.5" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg>
        Back to Onboarding
      <% end %>
    </div>
  <% end %>

  <turbo-frame id="inventory_calendar_frame" data-turbo-action="advance">
    <%= render "index_content", active_tab: @active_tab, active_subtab: @active_subtab %>
  </turbo-frame>

  <%# The cell editor is fetched into this frame; it lives inside the
      inventory-calendar controller's element so the form's targets resolve. %>
  <%= turbo_frame_tag "inventory_selection_sheet" %>

  <!-- Review Dialog -->
  <dialog data-inventory-calendar-target="reviewDialog" class="fixed inset-0 m-auto max-h-[80vh] w-[min(94vw,36rem)] overflow-hidden rounded-xl border border-border p-0 shadow-2xl backdrop:bg-slate-900/60">
    <div class="flex h-full max-h-[80vh] flex-col bg-card">
      <div class="flex-none flex items-start justify-between border-b border-border px-5 py-4">
        <div>
          <h2 class="text-lg font-bold tracking-tight text-foreground">Review Changes</h2>
          <p class="text-xs font-semibold text-muted-foreground">
            <%= current_hotel.preferred_channel_manager.present? ? "Confirm the staged updates before syncing with the Channel Manager." : "Confirm the staged updates before saving." %>
          </p>
        </div>
        <button type="button" data-action="inventory-calendar#closeReview" class="rounded-lg p-2 text-muted-foreground hover:bg-muted hover:text-foreground">
          <svg class="size-5" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg>
        </button>
      </div>

      <div class="flex-1 overflow-y-auto px-5 py-4">
        <div data-inventory-calendar-target="reviewList" class="space-y-3"></div>
      </div>

      <div class="flex-none flex flex-col-reverse gap-2 border-t border-border bg-muted/50 px-5 py-4 sm:flex-row sm:justify-end">
        <button type="button" data-action="inventory-calendar#clearStaged" class="inline-flex justify-center rounded-lg border border-border bg-card px-4 py-2.5 text-sm font-bold text-red-600 hover:bg-red-50">Clear All</button>
        <button type="button" data-action="inventory-calendar#closeReview" class="inline-flex justify-center rounded-lg border border-border bg-card px-4 py-2.5 text-sm font-bold text-foreground hover:bg-muted">Continue Editing</button>
        <button type="button"
                data-inventory-calendar-target="finalSyncButton"
                data-action="inventory-calendar#submitStaged"
                data-sync-text="<%= current_hotel.preferred_channel_manager.present? ? "Confirm & Sync" : "Confirm & Save" %>"
                class="inline-flex justify-center rounded-lg bg-indigo-600 px-6 py-2.5 text-sm font-bold text-primary-foreground hover:bg-indigo-700 shadow-sm">
          <%= current_hotel.preferred_channel_manager.present? ? "Confirm & Sync" : "Confirm & Save" %>
        </button>
      </div>
    </div>
  </dialog>

  <!-- Success Dialog -->
  <dialog data-inventory-calendar-target="successDialog" class="fixed inset-0 m-auto w-[min(94vw,26rem)] overflow-hidden rounded-xl border border-border p-0 shadow-2xl backdrop:bg-slate-900/60">
    <div class="bg-card p-6 sm:p-8 text-center">
      <div class="mx-auto mb-4 flex size-12 items-center justify-center rounded-full bg-emerald-100 text-emerald-600">
        <svg class="size-6" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>
      </div>
      <h3 class="text-lg font-bold tracking-tight text-foreground">Sync Successful</h3>
      <p class="mt-2 text-sm font-medium text-muted-foreground leading-relaxed">Your changes have been applied successfully.</p>
      <div class="mt-8">
        <button type="button" data-action="inventory-calendar#closeSuccess" class="inline-flex h-11 w-full items-center justify-center rounded-lg bg-primary px-4 py-2.5 text-sm font-bold text-primary-foreground hover:bg-primary-hover transition-all">Dismiss</button>
      </div>
    </div>
  </dialog>

  <!-- Occupancy Details Dialog -->
  <dialog id="occupancy-details-dialog" class="fixed inset-0 m-auto max-h-[85vh] w-[min(94vw,40rem)] overflow-hidden rounded-2xl border border-slate-200 p-0 shadow-2xl backdrop:bg-slate-900/60 transition-all">
    <turbo-frame id="occupancy_details_frame" loading="lazy">
      <div class="flex h-48 items-center justify-center bg-white">
        <div class="text-slate-400 font-semibold">Loading details...</div>
      </div>
    </turbo-frame>
  </dialog>

  <!-- Focus Mode Floating Exit Button -->
  <button type="button"
          data-action="click->inventory-calendar#toggleFullscreen"
          data-inventory-calendar-target="fullscreenRestoreBtn"
          class="fixed bottom-6 right-6 z-[70] hidden flex h-12 w-12 items-center justify-center rounded-full bg-indigo-600 text-white shadow-xl hover:bg-indigo-700 transition-all active:scale-95 cursor-pointer border border-indigo-500/30"
          title="Exit Focus Mode (Show menus)">
    <%= cached_icon "minimize-2", class: "size-5", stroke_width: 2.5 %>
  </button>

  <style>
    body.hotel-portal-focus-mode header,
    body.hotel-portal-focus-mode aside,
    body.hotel-portal-focus-mode [id^="sidebar"],
    body.hotel-portal-focus-mode .flex-none.bg-layer {
      display: none !important;
    }
    body.hotel-portal-focus-mode main {
      padding: 0 !important;
      margin: 0 !important;
    }
    body.hotel-portal-focus-mode main > div {
      padding: 12px !important;
    }
  </style>
</div>
