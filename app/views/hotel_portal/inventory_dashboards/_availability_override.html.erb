<div class="rounded-2xl border border-border bg-card shadow-sm overflow-hidden">
  <div class="px-6 py-5 border-b border-border bg-muted/50">
    <div class="flex items-center justify-between gap-4">
      <div>
        <h3 class="text-sm font-black tracking-tight text-foreground">Availability Override</h3>
        <p class="mt-0.5 text-xs font-medium text-muted-foreground">Room-number-specific overrides and status fixes.</p>
      </div>
      <%= render "shared/components/badge", label: "Fallback Tool", color_key: "amber" %>
    </div>
  </div>
  <div class="px-6 py-6" data-controller="inventory-filter">
    <%= form_with scope: :availability_override, url: apply_availability_override_hotel_inventory_dashboards_path(current_hotel), local: true, class: "space-y-4 text-xs" do |f| %>
      <div>
        <label class="mb-2 block text-[11px] font-black uppercase tracking-[0.18em] text-muted-foreground">Target Room Categories</label>
        <div class="grid gap-2 rounded-2xl border border-border bg-muted p-4 md:grid-cols-2 xl:grid-cols-3">
          <% @room_types.each do |rt| %>
            <%= render PanelsUI::Checkbox.new(
                  form: f, attribute: :room_type_ids, id: "availability_override_room_type_ids_#{rt.id}",
                  label: rt.name, value: rt.id, unchecked_value: nil, multiple: true, checked: true,
                  variant: :card, size: :sm,
                  data: { inventory_filter_target: "category", action: "change->inventory-filter#filter" }) %>
          <% end %>
        </div>
      </div>

      <div class="grid gap-4 md:grid-cols-2" data-controller="date-range-advance">
        <div>
          <label class="mb-2 block text-[11px] font-black uppercase tracking-[0.18em] text-muted-foreground">Start Date</label>
          <%= f.date_field :start_date, value: @start_date, class: "w-full rounded-2xl border border-border bg-card px-3 py-2.5 text-sm font-semibold text-foreground shadow-sm focus:border-border-interactive focus:outline-none focus:ring-0", data: { date_range_advance_target: "start", action: "change->date-range-advance#advance" } %>
        </div>
        <div>
          <label class="mb-2 block text-[11px] font-black uppercase tracking-[0.18em] text-muted-foreground">End Date</label>
          <%= f.date_field :end_date, value: @end_date, class: "w-full rounded-2xl border border-border bg-card px-3 py-2.5 text-sm font-semibold text-foreground shadow-sm focus:border-border-interactive focus:outline-none focus:ring-0", data: { date_range_advance_target: "end" } %>
        </div>
      </div>

      <div>
        <label class="mb-2 block text-[11px] font-black uppercase tracking-[0.18em] text-muted-foreground">Daily Room Assignments</label>
        <div class="grid gap-2 max-h-64 overflow-y-auto rounded-2xl border border-border bg-muted p-4 md:grid-cols-2 xl:grid-cols-3">
          <% @room_types.each do |rt| %>
            <% @room_directory.numbers_for(rt.id).sort.each do |num| %>
              <div data-inventory-filter-target="roomRow" data-room-type-id="<%= rt.id %>">
                <%= render PanelsUI::Checkbox.new(
                      form: f, attribute: :room_numbers, id: "availability_override_room_numbers_#{rt.id}_#{num}",
                      label: safe_join([ num, tag.span("(#{rt.name})", class: "text-xs font-medium text-muted-foreground") ], " "),
                      value: num, unchecked_value: nil, multiple: true, checked: true, variant: :card, size: :sm) %>
              </div>
            <% end %>
          <% end %>
        </div>
      </div>

      <div>
        <label class="mb-2 block text-[11px] font-black uppercase tracking-[0.18em] text-muted-foreground">Room Status</label>
        <%= f.select :status, [["No change", ""], ["Open", "open"], ["Closed", "closed"]], {}, class: "w-full rounded-2xl border border-border bg-card px-3 py-2.5 text-sm font-semibold text-foreground shadow-sm focus:border-border-interactive focus:outline-none focus:ring-0" %>
      </div>

      <div class="pt-4">
        <%= f.submit "Apply Availability Override",
                     class: "w-full sm:w-auto inline-flex items-center justify-center rounded-2xl bg-primary px-8 py-3.5 text-sm font-black text-primary-foreground shadow-sm transition hover:bg-primary-hover active:scale-[0.98]" %>
      </div>
    <% end %>
  </div>
</div>
