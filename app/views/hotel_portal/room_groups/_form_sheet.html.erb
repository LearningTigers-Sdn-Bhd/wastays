<% frame_id = turbo_frame_request_id.presence || "settings_action_sheet" %>
<% persisted = room_group.persisted? %>
<% form_id = persisted ? "edit-room-group-#{room_group.id}-form" : "new-room-group-form" %>

<%= turbo_frame_tag frame_id do %>
  <div data-controller="panels-ui--sheet-frame">
    <%= render PanelsUI::Sheet.new(
          id: persisted ? "edit-room-group-sheet" : "new-room-group-sheet",
          side: :right,
          size: :xl,
          title: title,
          description: "Name the property area and select its physical rooms.") do |sheet| %>
      <% sheet.with_body do %>
        <%= form_with model: [ @hotel, room_group ],
                      id: form_id,
                      class: "space-y-6 py-2",
                      data: { controller: "room-group-rooms" } do |form| %>
          <% if room_group.errors.any? %>
            <%= render PanelsUI::Alert.new(tone: :destructive, title: "Room group could not be saved", role: :alert) do |alert| %>
              <% alert.with_description { room_group.errors.full_messages.to_sentence } %>
            <% end %>
          <% end %>

          <%= render PanelsUI::FormField.new(form: form, attribute: :name, label: "Group name", required: true) do |field| %>
            <% field.with_input(placeholder: "For example, Main Tower", autocomplete: "off") %>
          <% end %>

          <section aria-labelledby="room-group-rooms-heading" class="space-y-4">
            <div class="flex flex-col gap-1 sm:flex-row sm:items-start sm:justify-between">
              <div>
                <h3 id="room-group-rooms-heading" class="text-base font-semibold text-foreground">Physical rooms</h3>
                <p class="mt-1 text-sm text-muted-foreground">Only unassigned rooms and rooms in this group appear here. Clear a selection to leave the room unassigned.</p>
              </div>
              <p class="shrink-0 text-sm font-medium text-foreground" aria-live="polite" data-room-group-rooms-target="count"><%= pluralize(@selected_room_ids.size, "room") %> selected</p>
            </div>

            <% if @rooms.any? %>
              <%= hidden_field_tag "room_group[room_ids][]", "" %>

              <%= fields_for "room_group_filters", OpenStruct.new(query: "", room_type_id: "") do |filter_form| %>
                <div class="grid gap-3 sm:grid-cols-[minmax(0,1fr)_minmax(14rem,.55fr)]">
                  <%= render PanelsUI::FormField.new(
                        form: filter_form,
                        attribute: :query,
                        label: "Search rooms",
                        label_hidden: true) do |field| %>
                    <% field.with_input(
                         type: :search,
                         placeholder: "Search room number or category",
                         autocomplete: "off",
                         data: {
                           room_group_rooms_target: "search",
                           action: "input->room-group-rooms#filter"
                         }) %>
                  <% end %>

                  <%= render PanelsUI::FormField.new(
                        form: filter_form,
                        attribute: :room_type_id,
                        label: "Filter by room category",
                        label_hidden: true) do |field| %>
                    <% field.with_select_menu(
                         @room_types.map { |room_type| { label: room_type.name, value: room_type.id } },
                         include_blank: "All room categories",
                         selected: "",
                         data: {
                           room_group_rooms_target: "roomType",
                           action: "change->room-group-rooms#filter"
                         }) %>
                  <% end %>
                </div>
              <% end %>

              <div class="max-h-96 space-y-2 overflow-y-auto rounded-md border border-border bg-muted/20 p-2" data-testid="room-group-room-list">
                <% @rooms.each do |room| %>
                  <% current_group = room.room_group %>
                  <% status = if current_group == room_group
                       "In this group"
                     else
                       "Unassigned"
                     end %>
                  <div data-room-group-rooms-target="row"
                       data-room-group-rooms-search-value="<%= "#{room.number} #{room.room_type.name}".downcase %>"
                       data-room-group-rooms-room-type-value="<%= room.room_type_id %>">
                    <%= render PanelsUI::Checkbox.new(
                          name: "room_group[room_ids][]",
                          id: "room-group-room-#{room.id}",
                          value: room.id,
                          checked: @selected_room_ids.include?(room.id.to_s),
                          include_hidden: false,
                          label: room.number,
                          description: "#{room.room_type.name} · #{status}",
                          variant: :card,
                          data: {
                            room_group_rooms_target: "checkbox",
                            action: "change->room-group-rooms#updateCount"
                          }) %>
                  </div>
                <% end %>

                <div class="hidden px-4 py-8 text-center" data-room-group-rooms-target="empty">
                  <p class="text-sm font-medium text-foreground">No rooms match these filters.</p>
                  <p class="mt-1 text-sm text-muted-foreground">Change the search or room category.</p>
                </div>
              </div>
            <% else %>
              <div class="rounded-md border border-dashed border-border px-4 py-8 text-center">
                <p class="text-sm font-medium text-foreground">No physical rooms are available.</p>
                <p class="mt-1 text-sm text-muted-foreground">Add room numbers in Room Inventory before you assign rooms to this group.</p>
              </div>
            <% end %>
          </section>
        <% end %>
      <% end %>

      <% sheet.with_footer do %>
        <%= render PanelsUI::Button.new(as: :button, type: :button, variant: :secondary, size: :sm,
              data: { action: "click->panels-ui--sheet#close" }) do %>
          Cancel
        <% end %>
        <%= render PanelsUI::Button.new(as: :button, type: :submit, form: form_id, size: :sm,
              data: { turbo_submits_with: persisted ? "Saving…" : "Creating…" }) do %>
          <%= submit_label %>
        <% end %>
      <% end %>
    <% end %>
  </div>
<% end %>
