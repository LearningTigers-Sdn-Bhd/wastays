<%= turbo_frame_tag "offcanvas_drawer" do %>
  <div class="flex h-full flex-col bg-white overflow-hidden">
    <!-- Header -->
    <div class="flex items-center gap-x-4 border-b border-slate-100 px-6 py-5">
      <%= link_to hotel_room_groups_path(@hotel), class: "rounded-xl border border-slate-200 bg-white p-2.5 text-slate-500 shadow-sm transition hover:bg-slate-50" do %>
        <%= cached_icon "chevron-left", class: "size-4.5" %>
      <% end %>
      <div>
        <h3 class="text-lg font-bold text-slate-900">Edit Room Group</h3>
        <p class="mt-1 text-xs text-slate-500">Update the name of your room group / wing.</p>
      </div>
    </div>

    <!-- Content -->
    <div class="flex-1 overflow-y-auto p-6 space-y-6 custom-scrollbar">
      <%= form_with model: [@hotel, @room_group], local: true, class: "space-y-6" do |f| %>
        <% if @room_group.errors.any? %>
          <div class="p-3 text-xs text-red-600 bg-red-50 rounded-xl border border-red-100 font-medium">
            <%= @room_group.errors.full_messages.to_sentence %>
          </div>
        <% end %>

        <div class="space-y-2">
          <%= f.label :name, "Group Name", class: "block text-sm font-semibold text-slate-800" %>
          <%= f.text_field :name, 
                           class: "py-3.5 px-5 block w-full border border-slate-200 rounded-2xl text-sm focus:border-blue-500 focus:ring-blue-500 transition-all shadow-sm bg-white",
                           required: true %>
        </div>

        <div class="flex gap-x-3 pt-4">
          <%= f.submit "Update Group", class: "flex-1 inline-flex items-center justify-center rounded-2xl bg-slate-900 px-5 py-3.5 text-sm font-bold text-white shadow-sm transition hover:bg-slate-700 cursor-pointer" %>
          <%= link_to "Cancel", hotel_room_groups_path(@hotel), class: "flex-1 inline-flex items-center justify-center rounded-2xl border border-slate-200 bg-white px-5 py-3.5 text-sm font-bold text-slate-700 shadow-sm transition hover:bg-slate-50" %>
        </div>
      <% end %>
    </div>
  </div>
<% end %>
