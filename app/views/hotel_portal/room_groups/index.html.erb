<div class="w-full space-y-6">
  <%= render "hotel_portal/settings/property_page_header" %>
  <%= render "hotel_portal/settings/group_tabs" %>

  <section aria-labelledby="room-groups-heading" class="space-y-4">
    <div class="flex flex-col gap-3 sm:flex-row sm:items-start sm:justify-between">
      <div>
        <h2 id="room-groups-heading" class="text-base font-semibold text-foreground">Room Groups</h2>
        <p class="mt-1 text-sm text-muted-foreground">Manage the property areas used to organize room categories.</p>
      </div>
      <%= render PanelsUI::Button.new(
            href: new_hotel_room_group_path(@hotel),
            size: :sm,
            class: "shrink-0",
            data: { turbo_frame: "settings_action_sheet" }) do %>
        <%= app_icon "plus", class: "size-4", aria: { hidden: true } %>
        Create Room Group
      <% end %>
    </div>

    <%= render PanelsUI::Table.new(
          caption: "Room groups",
          header_style: :sentence,
          striped: true,
          hoverable: true,
          bordered: true,
          wrapper_class: "rounded-md border border-border bg-card",
          class: "min-w-[680px]",
          data: { testid: "room-groups-table" }) do |table| %>
      <% table.with_header do %>
        <tr>
          <th scope="col">Room group</th>
          <th scope="col">Room categories</th>
          <th scope="col">Assigned</th>
          <th scope="col" class="text-right">Actions</th>
        </tr>
      <% end %>

      <% table.with_body do %>
        <% @room_groups.each do |group| %>
          <tr id="room-group-row-<%= group.id %>">
            <th scope="row" class="font-medium text-foreground"><%= group.name %></th>
            <td class="text-muted-foreground">
              <%= group.room_types.any? ? group.room_types.sort_by(&:name).map(&:name).to_sentence : "No room categories assigned" %>
            </td>
            <td class="text-muted-foreground"><%= pluralize(group.room_types.size, "category") %></td>
            <td class="text-right">
              <div class="inline-flex items-center gap-1">
                <%= render PanelsUI::Button.new(
                      href: edit_hotel_room_group_path(@hotel, group),
                      variant: :secondary,
                      size: :xs,
                      data: { turbo_frame: "settings_action_sheet" }) do %>
                  Edit
                <% end %>
                <%= render PanelsUI::Button.new(
                      href: hotel_room_group_path(@hotel, group),
                      variant: :ghost,
                      size: :icon_xs,
                      aria_label: "Delete #{group.name}",
                      class: "text-destructive",
                      data: {
                        turbo_method: :delete,
                        turbo_confirm: "Delete this room group? Assigned room categories will become unassigned.",
                        turbo_confirm_title: "Delete room group",
                        turbo_confirm_tone: "destructive"
                      }) do %>
                  <%= app_icon "trash-2", class: "size-4", aria: { hidden: true } %>
                <% end %>
              </div>
            </td>
          </tr>
        <% end %>
        <% if @room_groups.empty? %>
          <tr>
            <td colspan="4" class="py-10 text-center text-sm text-muted-foreground">No room groups have been created.</td>
          </tr>
        <% end %>
      <% end %>
    <% end %>
  </section>
</div>
