<% role_choices = available_roles.map { |role| { label: role.name, value: role.id } } %>

<%= render layout: "hotel_portal/settings/action_sheet",
           locals: {
             id: "invite-staff-sheet",
             title: "Invite Staff Member",
             description: "Send a secure invitation link so a staff member can accept access to this property.",
             form_id: "invite-staff-form",
             submit_label: "Send Invitation"
           } do %>
  <%= form_with model: @invitation,
                url: hotel_users_path(current_hotel),
                method: :post,
                scope: :staff_invitation,
                id: "invite-staff-form",
                class: "space-y-5" do |f| %>
    <% if @invitation.errors.any? %>
      <%= render PanelsUI::Alert.new(
            tone: :destructive,
            title: "This invitation could not be sent",
            role: :alert) do |alert| %>
        <% alert.with_description do %>
          <ul class="list-disc space-y-1 ps-5">
            <% @invitation.errors.full_messages.each do |message| %>
              <li><%= message %></li>
            <% end %>
          </ul>
        <% end %>
      <% end %>
    <% end %>

    <%= render PanelsUI::FormField.new(
          form: f,
          attribute: :email,
          label: "Email Address",
          hint: "They will receive an email invitation and create their account when accepting it.",
          required: true) do |field| %>
      <% field.with_input(type: :email, placeholder: "staff@example.com", autocomplete: "off", required: true) %>
    <% end %>

    <%= render PanelsUI::FormField.new(
          form: f,
          attribute: :role_id,
          label: "Assigned Role",
          hint: "This role controls what they can see and do at this specific property.",
          required: true) do |field| %>
      <% field.with_select_menu(
           role_choices,
           selected: @invitation.role_id,
           prompt: "Select a role",
           required: true) %>
    <% end %>
  <% end %>
<% end %>
