<div class="w-full space-y-3.5">
  <%= render PanelsUI::PageHeader.new(
        title: "Staff Management",
        description: "Manage access levels and roles for your hotel team.") do |header| %>
    <% header.with_actions do %>
      <%= render PanelsUI::Button.new(
            href: new_hotel_user_path(current_hotel),
            size: :sm,
            class: "w-full sm:w-auto",
            data: { turbo_frame: "settings_action_sheet" }) do %>
        <%= app_icon "user-plus", class: "size-4", aria: { hidden: "true" } %>
        <span>Invite Staff</span>
      <% end %>
    <% end %>
  <% end %>

  <%= render "hotel_portal/settings/group_tabs" %>

  <% if @presenter.invitations? %>
    <section aria-labelledby="pending-invitations-heading" class="space-y-3">
      <div>
        <h2 id="pending-invitations-heading" class="text-base font-semibold text-foreground">Pending Invitations</h2>
        <p class="mt-1 text-sm text-muted-foreground">Invited staff who have not accepted yet.</p>
      </div>

      <%= render PanelsUI::Table.new(
            caption: "Pending staff invitations",
            header_style: :sentence,
            hoverable: true,
            wrapper_class: "rounded-lg border border-border bg-card",
            data: { testid: "pending-invitations" }) do |table| %>
        <% table.with_header do %>
          <tr>
            <th scope="col">Status</th>
            <th scope="col">Email</th>
            <th scope="col">Role</th>
            <th scope="col">Invited By</th>
            <th scope="col">Expires</th>
            <th scope="col" class="text-right"><span class="sr-only">Actions</span></th>
          </tr>
        <% end %>

        <% table.with_body do %>
          <% @presenter.invitation_rows.each do |row| %>
            <tr id="staff-invitation-row-<%= row.id %>">
              <td class="align-middle">
                <%= render PanelsUI::Badge.new(label: "Pending", variant: :warning, size: :sm) %>
              </td>
              <th scope="row" class="align-middle font-medium text-foreground"><%= row.email %></th>
              <td class="align-middle text-muted-foreground"><%= row.role_name %></td>
              <td class="align-middle text-muted-foreground"><%= row.invited_by %></td>
              <td class="align-middle whitespace-nowrap text-muted-foreground">
                <%= l(row.expires_at, format: :short) %>
              </td>
              <td class="text-right align-middle">
                <%= render "hotel_portal/users/invitation_actions", row: row %>
              </td>
            </tr>
          <% end %>
        <% end %>
      <% end %>
    </section>
  <% end %>

  <section aria-labelledby="current-staff-heading" class="space-y-3">
    <div>
      <h2 id="current-staff-heading" class="text-base font-semibold text-foreground">Current Staff</h2>
      <p class="mt-1 text-sm text-muted-foreground">Users who have been granted access to this property.</p>
    </div>

    <%= render PanelsUI::Table.new(
          caption: "Staff with access to this property",
          header_style: :sentence,
          hoverable: true,
          wrapper_class: "rounded-lg border border-border bg-card",
          data: { testid: "staff-directory" }) do |table| %>
      <% table.with_header do %>
        <tr>
          <th scope="col">Status</th>
          <th scope="col">Staff</th>
          <th scope="col">Role</th>
          <th scope="col" class="text-right"><span class="sr-only">Actions</span></th>
        </tr>
      <% end %>

      <% table.with_body do %>
        <% if @presenter.staff? %>
          <% @presenter.staff_rows.each do |row| %>
            <tr id="staff-row-<%= row.id %>">
              <td class="align-middle">
                <%= render "hotel_portal/users/status_toggle", row: row %>
              </td>
              <th scope="row" class="align-middle">
                <div class="min-w-0">
                  <div class="flex flex-wrap items-center gap-2">
                    <span class="font-medium text-foreground"><%= row.name %></span>
                    <% if row.own_row %>
                      <%= render PanelsUI::Badge.new(label: "You", variant: :outline, size: :sm) %>
                    <% end %>
                  </div>
                  <p class="mt-0.5 text-xs font-normal text-muted-foreground"><%= row.email %></p>
                </div>
              </th>
              <td class="align-middle text-muted-foreground"><%= row.role_name %></td>
              <td class="text-right align-middle">
                <%= render "hotel_portal/users/staff_actions", row: row %>
              </td>
            </tr>
          <% end %>
        <% else %>
          <tr>
            <td colspan="4" class="h-40 text-center">
              <p class="font-medium text-foreground">No staff have access yet.</p>
              <p class="mt-1 text-muted-foreground">Invite a team member to give them access to this property.</p>
              <div class="mt-4">
                <%= render PanelsUI::Button.new(
                      label: "Invite Staff",
                      href: new_hotel_user_path(current_hotel),
                      size: :sm,
                      data: { turbo_frame: "settings_action_sheet" }) %>
              </div>
            </td>
          </tr>
        <% end %>
      <% end %>
    <% end %>
  </section>
</div>
