<div class="max-w-[1600px] mx-auto pb-20 space-y-8">
  <div class="px-4 md:px-0">
    <div class="mt-5 flex flex-col md:flex-row md:items-end md:justify-between gap-4">
      <div>
        <h1 class="text-2xl font-bold tracking-tight text-slate-950 sm:text-3xl">Staff Management</h1>
        <p class="mt-1 text-sm font-medium text-slate-600">Manage access levels and roles for your hotel team.</p>
      </div>
      <div>
        <%= link_to new_hotel_user_path(current_hotel), class: "inline-flex items-center rounded-xl bg-slate-900 px-4 py-2.5 text-sm font-bold text-white shadow-sm transition hover:bg-slate-700" do %>
          <svg class="mr-2 size-4" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><line x1="19" y1="8" x2="19" y2="14"/><line x1="22" y1="11" x2="16" y2="11"/></svg>
          Invite Staff
        <% end %>
      </div>
    </div>
  </div>

  <div class="px-4 md:px-0">
    <%= render "hotel_portal/settings/group_tabs" %>
  </div>

  <% if @pending_invitations.any? %>
    <div class="px-4 md:px-0">
      <section class="overflow-hidden rounded-2xl border border-amber-200 bg-amber-50/60 shadow-sm">
        <div class="border-b border-amber-200 px-6 py-5">
          <h2 class="text-lg font-bold tracking-tight text-slate-950">Pending Invitations</h2>
          <p class="mt-1 text-sm font-medium text-slate-600">Invited staff who have not accepted yet.</p>
        </div>

        <div class="overflow-x-auto">
          <table class="w-full text-left">
            <thead class="bg-white/60 border-b border-amber-200">
              <tr>
                <th class="px-6 py-4 text-xs font-bold uppercase tracking-widest text-slate-500">Email</th>
                <th class="px-6 py-4 text-xs font-bold uppercase tracking-widest text-slate-500">Role</th>
                <th class="px-6 py-4 text-xs font-bold uppercase tracking-widest text-slate-500">Invited By</th>
                <th class="px-6 py-4 text-xs font-bold uppercase tracking-widest text-slate-500">Expires</th>
                <th class="px-6 py-4 text-xs font-bold uppercase tracking-widest text-slate-500 text-right">Actions</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-amber-100">
              <% @pending_invitations.each do |invitation| %>
                <tr class="transition hover:bg-white/50">
                  <td class="px-6 py-4 text-sm font-bold text-slate-950"><%= invitation.email %></td>
                  <td class="px-6 py-4">
                    <%= form_with model: invitation, url: hotel_staff_invitation_path(current_hotel, invitation), method: :patch, local: true, class: "flex items-center gap-2" do |f| %>
                      <%= f.select :role_id, options_from_collection_for_select(@available_roles, :id, :name, invitation.role_id), {}, onchange: "this.form.submit()", class: "rounded-lg border border-amber-200 bg-white px-3 py-1.5 text-xs font-semibold text-slate-700 transition focus:border-slate-900 focus:ring-0" %>
                    <% end %>
                  </td>
                  <td class="px-6 py-4 text-sm font-medium text-slate-700"><%= invitation.invited_by_user.name %></td>
                  <td class="px-6 py-4 text-sm font-medium text-slate-700"><%= l(invitation.expires_at, format: :short) %></td>
                  <td class="px-6 py-4 text-right">
                    <div class="flex items-center justify-end gap-2">
                      <%= button_to resend_hotel_staff_invitation_path(current_hotel, invitation), method: :post, class: "inline-flex items-center justify-center rounded-lg p-2 text-amber-600 transition hover:bg-amber-100", title: "Resend Invitation" do %>
                        <svg class="size-4" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m22 2-7 20-4-9-9-4Z"/><path d="M22 2 11 13"/></svg>
                      <% end %>
                      <%= button_to hotel_staff_invitation_path(current_hotel, invitation), method: :delete, data: { turbo_confirm: "Revoke this invitation?" }, class: "inline-flex items-center justify-center rounded-lg p-2 text-slate-400 transition hover:bg-red-50 hover:text-red-600", title: "Revoke Invitation" do %>
                        <svg class="size-4" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 6h18"/><path d="M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6"/><path d="M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2"/></svg>
                      <% end %>
                    </div>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      </section>
    </div>
      <% end %>

  <div class="px-4 md:px-0">
    <!-- Staff Table -->
    <section class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">
      <div class="border-b border-slate-200 px-6 py-5">
        <h2 class="text-lg font-bold tracking-tight text-slate-950">Current Staff</h2>
        <p class="mt-1 text-sm font-medium text-slate-600">Users who have active access to this property.</p>
      </div>

      <div class="overflow-x-auto">
        <table class="w-full text-left">
            <thead class="bg-slate-50 border-b border-slate-200">
              <tr>
                <th class="px-6 py-4 text-xs font-bold uppercase tracking-widest text-slate-500">Name & Email</th>
                <th class="px-6 py-4 text-xs font-bold uppercase tracking-widest text-slate-500">Role</th>
                <th class="px-6 py-4 text-xs font-bold uppercase tracking-widest text-slate-500 text-right">Actions</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-slate-100">
              <% @hotel_accesses.each do |access| %>
                <tr class="group transition hover:bg-slate-50/50 <%= 'opacity-60 bg-slate-50' unless access.active? %>">
                  <td class="px-6 py-4">
                    <div class="flex items-center gap-3">
                      <div class="flex flex-col">
                        <div class="flex items-center gap-2">
                          <span class="text-sm font-bold text-slate-950"><%= access.user.name %></span>
                          <% unless access.active? %>
                            <span class="inline-flex items-center rounded-md bg-slate-100 px-1.5 py-0.5 text-[10px] font-bold uppercase tracking-wider text-slate-600 border border-slate-200">Deactivated</span>
                          <% end %>
                        </div>
                        <span class="text-xs font-medium text-slate-500"><%= access.user.email %></span>
                      </div>
                    </div>
                  </td>
                  <td class="px-6 py-4">
                    <%= form_with model: access, url: hotel_user_path(current_hotel, access), method: :patch, local: true, class: "flex items-center gap-2" do |f| %>
                      <%= f.select :role_id, options_from_collection_for_select(@available_roles, :id, :name, access.role_id), {}, onchange: "this.form.submit()", disabled: !access.active?, class: "rounded-lg border border-slate-200 bg-white px-3 py-1.5 text-xs font-semibold text-slate-700 transition focus:border-slate-900 focus:ring-0 disabled:bg-slate-50 disabled:text-slate-400" %>
                    <% end %>
                  </td>
                  <td class="px-6 py-4 text-right">
                    <div class="flex items-center justify-end gap-2">
                      <% if access.user_id == current_user.id %>
                        <span class="text-xs font-bold text-slate-400 bg-slate-100 px-2 py-1 rounded">You</span>
                      <% elsif access.active? %>
                        <%= button_to hotel_user_path(current_hotel, access), 
                            method: :delete, 
                            data: { 
                              turbo_confirm: "Revoke Access?", 
                              turbo_confirm_text: "Are you sure you want to revoke access for #{access.user.name}? They will no longer be able to access the hotel portal.",
                              turbo_confirm_color: "red"
                            }, 
                            class: "inline-flex items-center justify-center rounded-lg p-2 text-slate-400 transition hover:bg-red-50 hover:text-red-600",
                            title: "Revoke Access" do %>
                          <svg class="size-4" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18.36 6.64a9 9 0 1 1-12.73 0"/><line x1="12" y1="2" x2="12" y2="12"/></svg>
                        <% end %>
                      <% else %>
                        <%= button_to reactivate_hotel_user_path(current_hotel, access), 
                            method: :patch, 
                            class: "inline-flex items-center justify-center rounded-lg p-2 text-slate-400 transition hover:bg-emerald-50 hover:text-emerald-600",
                            title: "Reactivate Access" do %>
                          <svg class="size-4" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>
                        <% end %>
                      <% end %>
                    </div>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      </section>
    </div>
  </div>
