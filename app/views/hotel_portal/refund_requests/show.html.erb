<% content_for :title, "Refund Request | WAStays" %>
<div class="max-w-[1600px] mx-auto pb-20 space-y-8">
  <div class="px-4 md:px-0">
    <div class="mt-5 flex items-start justify-between gap-4">
      <div>
        <%= link_to hotel_refund_requests_path(current_hotel), class: "mb-3 inline-flex items-center gap-x-1.5 text-sm font-medium text-slate-500 hover:text-slate-700" do %>
          <svg class="size-4" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="m15 18-6-6 6-6"/></svg>
          Back to Refund Requests
        <% end %>
        <h1 class="text-2xl font-bold tracking-tight text-slate-950 sm:text-3xl">Refund Request</h1>
        <p class="mt-1 text-sm font-medium text-slate-600">Booking <%= @refund_request.booking.confirmation_token %></p>
      </div>
      <span class="inline-flex items-center rounded-full px-3 py-1.5 text-sm font-bold uppercase tracking-wider
        <%= case @refund_request.status
            when "pending" then "bg-yellow-100 text-yellow-700"
            when "approved" then "bg-blue-100 text-blue-700"
            when "completed" then "bg-green-100 text-green-700"
            when "rejected" then "bg-red-100 text-red-700"
            end %>">
        <%= @refund_request.status.humanize %>
      </span>
    </div>
  </div>

  <div class="grid grid-cols-1 gap-6 xl:grid-cols-3">
    <div class="space-y-6 xl:col-span-2">
      <div class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">
        <div class="border-b border-slate-200 px-6 py-4">
          <h2 class="font-semibold text-slate-900">Booking Details</h2>
        </div>
        <div class="grid grid-cols-1 gap-4 p-6 text-sm md:grid-cols-2">
          <div>
            <p class="text-slate-500">Guest Name</p>
            <p class="font-medium text-slate-900"><%= @refund_request.booking.guest_name %></p>
          </div>
          <div>
            <p class="text-slate-500">Guest Email</p>
            <p class="font-medium text-slate-900"><%= @refund_request.booking.guest_email %></p>
          </div>
          <div>
            <p class="text-slate-500">Check-in</p>
            <p class="font-medium text-slate-900"><%= @refund_request.booking.check_in.strftime("%d %b %Y") %></p>
          </div>
          <div>
            <p class="text-slate-500">Total Paid</p>
            <p class="font-semibold text-slate-900"><%= number_to_currency(@refund_request.booking.total_amount, unit: @refund_request.booking.currency + " ") %></p>
          </div>
        </div>
      </div>

      <div class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">
        <div class="border-b border-slate-200 px-6 py-4">
          <h2 class="font-semibold text-slate-900">Refund Details</h2>
        </div>
        <div class="space-y-4 p-6">
          <div class="grid grid-cols-1 gap-4 text-sm md:grid-cols-2">
            <div>
              <p class="text-slate-500">Refund Amount</p>
              <p class="text-2xl font-bold text-slate-900"><%= number_to_currency(@refund_request.refund_amount, unit: @refund_request.booking.currency + " ") %></p>
            </div>
            <div>
              <p class="text-slate-500">Submitted</p>
              <p class="font-medium text-slate-900"><%= @refund_request.created_at.strftime("%d %b %Y at %H:%M") %></p>
            </div>
          </div>
          <div>
            <p class="text-sm text-slate-500">Guest Reason</p>
            <p class="mt-1 rounded-xl bg-slate-50 p-3 text-sm text-slate-900"><%= @refund_request.reason.presence || "-" %></p>
          </div>
        </div>
      </div>

      <div class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">
        <div class="border-b border-slate-200 px-6 py-4">
          <h2 class="font-semibold text-slate-900">Bank Account Details</h2>
        </div>
        <div class="grid grid-cols-1 gap-4 p-6 text-sm md:grid-cols-2">
          <div>
            <p class="text-slate-500">Bank Name</p>
            <p class="font-medium text-slate-900"><%= @refund_request.bank_name %></p>
          </div>
          <div>
            <p class="text-slate-500">Account Holder</p>
            <p class="font-medium text-slate-900"><%= @refund_request.account_holder_name %></p>
          </div>
          <div>
            <p class="text-slate-500">Account Number</p>
            <p class="font-medium font-mono text-slate-900"><%= @refund_request.account_number %></p>
          </div>
          <div>
            <p class="text-slate-500">Account Type</p>
            <p class="font-medium text-slate-900 capitalize"><%= @refund_request.account_type %></p>
          </div>
        </div>
      </div>

    </div>

    <div class="space-y-6">
      <% if @refund_request.pending? %>
        <div class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">
          <div class="border-b border-slate-200 px-6 py-4">
            <h2 class="font-semibold text-slate-900">Review Request</h2>
          </div>
          <div class="space-y-4 p-6">
            <%= form_with url: approve_hotel_refund_request_path(current_hotel, @refund_request), method: :patch, local: true, class: "space-y-3" do |f| %>
              <%= f.text_area :hotel_note, rows: 2, placeholder: "Optional note to guest for approval details or rejection reason...",
                  class: "w-full rounded-xl border border-slate-200 px-3 py-2.5 text-sm focus:border-emerald-500 focus:outline-none focus:ring-2 focus:ring-emerald-500/20" %>
              <div class="grid grid-cols-1 gap-3">
                <%= f.submit "Approve Refund", class: "inline-flex w-full items-center justify-center rounded-xl bg-emerald-600 px-5 py-2.5 text-sm font-bold text-white hover:bg-emerald-700 cursor-pointer" %>
                <%= f.submit "Reject Request",
                    formaction: reject_hotel_refund_request_path(current_hotel, @refund_request),
                    class: "inline-flex w-full items-center justify-center rounded-xl bg-red-600 px-5 py-2.5 text-sm font-bold text-white hover:bg-red-700 cursor-pointer" %>
              </div>
            <% end %>
          </div>
        </div>
      <% elsif @refund_request.approved? %>
        <div class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">
          <div class="border-b border-slate-200 px-6 py-4">
            <h2 class="font-semibold text-slate-900">Mark as Complete</h2>
          </div>
          <div class="space-y-4 p-6">
            <p class="text-sm text-slate-600">Once you have transferred the refund amount to the guest's bank account, mark it as completed. The guest will receive a confirmation email.</p>
            <% if @refund_request.hotel_note.present? %>
              <div>
                <p class="mb-1 text-sm font-medium text-slate-700">Note Sent to Guest</p>
                <p class="rounded-xl bg-slate-50 p-3 text-sm text-slate-700"><%= @refund_request.hotel_note %></p>
              </div>
            <% end %>
            <%= button_to "Mark Refund as Completed", complete_hotel_refund_request_path(current_hotel, @refund_request), method: :patch,
                data: { turbo_confirm: "Confirm that you have transferred #{number_to_currency(@refund_request.refund_amount, unit: @refund_request.booking.currency + ' ')} to the guest's bank account?",
                        turbo_confirm_title: "Complete Refund",
                        turbo_confirm_color: "green" },
                class: "inline-flex w-full items-center justify-center rounded-xl bg-blue-600 px-5 py-2.5 text-sm font-bold text-white hover:bg-blue-700" %>
          </div>
        </div>
      <% else %>
        <div class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">
          <div class="border-b border-slate-200 px-6 py-4">
            <h2 class="font-semibold text-slate-900">Request Status</h2>
          </div>
          <div class="space-y-3 p-6">
            <% if @refund_request.rejected? %>
              <p class="text-sm font-semibold text-red-700">This refund request has been rejected.</p>
              <p class="text-sm text-slate-600">The guest can review your note and may submit a new request later if needed.</p>
            <% elsif @refund_request.completed? %>
              <p class="text-sm font-semibold text-emerald-700">This refund request has been completed.</p>
              <p class="text-sm text-slate-600">Payment was marked as transferred and a confirmation email has been sent to the guest.</p>
            <% else %>
              <p class="text-sm text-slate-600">This request has been reviewed.</p>
            <% end %>
            <% if @refund_request.hotel_note.present? %>
              <div>
                <p class="mb-1 text-sm font-medium text-slate-700">Note Sent to Guest</p>
                <p class="rounded-xl bg-slate-50 p-3 text-sm text-slate-700"><%= @refund_request.hotel_note %></p>
              </div>
            <% end %>
            <%= link_to "Back to Refund Requests", hotel_refund_requests_path(current_hotel), class: "inline-flex items-center rounded-xl border border-slate-200 px-4 py-2 text-sm font-semibold text-slate-700 hover:bg-slate-50" %>
          </div>
        </div>
      <% end %>
    </div>
  </div>
</div>
