<%= turbo_frame_tag "offcanvas_drawer" do %>
  <div class="p-6 space-y-6">
    <div class="flex items-center justify-between">
      <h3 class="text-xl font-bold text-slate-900">Initiate Refund Request</h3>
      <button type="button" data-action="click->offcanvas#close" class="text-slate-400 hover:text-slate-600">
        <svg class="size-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
      </button>
    </div>

    <%= form_with(model: [@booking.hotel, @booking, @refund_request], 
                  url: hotel_booking_refund_requests_path(@booking.hotel, @booking),
                  class: "space-y-6",
                  data: { turbo: false }) do |f| %>
      
      <% if @refund_request.errors.any? %>
        <div class="p-4 bg-red-50 border border-red-200 rounded-xl text-red-700 text-sm">
          <%= @refund_request.errors.full_messages.to_sentence %>
        </div>
      <% end %>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <div class="md:col-span-2">
          <%= f.label :refund_amount, "Refund Amount (#{@booking.currency})", class: "block text-xs font-bold text-slate-500 uppercase tracking-wider mb-2" %>
          <%= f.number_field :refund_amount, step: 0.01, class: "w-full rounded-xl border-slate-200 focus:ring-amber-500 focus:border-amber-500 font-semibold" %>
          <p class="mt-1 text-xs text-slate-400">Policy suggests <%= number_to_currency(@eligibility.suggested_amount, unit: @booking.currency + " ") %></p>
        </div>

        <div class="md:col-span-2">
          <%= f.label :reason, "Reason for Refund", class: "block text-xs font-bold text-slate-500 uppercase tracking-wider mb-2" %>
          <%= f.text_area :reason, rows: 2, class: "w-full rounded-xl border-slate-200 focus:ring-amber-500 focus:border-amber-500", placeholder: "e.g. Guest cancelled due to medical emergency" %>
        </div>

        <div>
          <%= f.label :bank_name, class: "block text-xs font-bold text-slate-500 uppercase tracking-wider mb-2" %>
          <%= f.text_field :bank_name, class: "w-full rounded-xl border-slate-200 focus:ring-amber-500 focus:border-amber-500" %>
        </div>

        <div>
          <%= f.label :account_type, class: "block text-xs font-bold text-slate-500 uppercase tracking-wider mb-2" %>
          <%= f.select :account_type, RefundRequest::ACCOUNT_TYPES.map { |t| [t.humanize, t] }, {}, class: "w-full rounded-xl border-slate-200 focus:ring-amber-500 focus:border-amber-500" %>
        </div>

        <div class="md:col-span-2">
          <%= f.label :account_holder_name, class: "block text-xs font-bold text-slate-500 uppercase tracking-wider mb-2" %>
          <%= f.text_field :account_holder_name, class: "w-full rounded-xl border-slate-200 focus:ring-amber-500 focus:border-amber-500" %>
        </div>

        <div class="md:col-span-2">
          <%= f.label :account_number, class: "block text-xs font-bold text-slate-500 uppercase tracking-wider mb-2" %>
          <%= f.text_field :account_number, class: "w-full rounded-xl border-slate-200 focus:ring-amber-500 focus:border-amber-500" %>
        </div>
      </div>

      <div class="pt-4 border-t border-slate-100 flex gap-3">
        <%= f.submit "Submit to Superadmin", class: "flex-1 bg-amber-600 hover:bg-amber-700 text-white font-bold py-3 px-4 rounded-xl transition-colors cursor-pointer" %>
        <button type="button" data-action="click->offcanvas#close" class="flex-1 bg-slate-100 hover:bg-slate-200 text-slate-700 font-bold py-3 px-4 rounded-xl transition-colors">
          Cancel
        </button>
      </div>
    <% end %>
  </div>
<% end %>
