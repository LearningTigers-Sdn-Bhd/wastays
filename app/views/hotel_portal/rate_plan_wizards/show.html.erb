<% frame_id = turbo_frame_request_id.presence || "settings_action_sheet" %>
<% position = @wizard.step_index(@step).to_i + 1 %>
<% total = @wizard.step_keys.size %>

<%= turbo_frame_tag frame_id do %>
  <div data-controller="panels-ui--sheet-frame">
    <%# Locked (dismissible: false): the draft spans several steps, so a stray
        Esc or backdrop click would throw away more than one screen of work.
        Discard in the footer is the way out, and it says what it does. %>
    <%= render PanelsUI::Sheet.new(
          id: "rate-plan-wizard-sheet",
          side: :bottom,
          size: :full,
          dismissible: false,
          title: "New rate plan",
          description: "Step #{position} of #{total} · #{wizard_step_label(@wizard, @step)}") do |sheet| %>
      <% sheet.with_body do %>
        <div class="mx-auto w-full max-w-5xl space-y-6 py-2">
          <%= render "steps", wizard: @wizard, step: @step %>

          <% case @step %>
          <% when HotelPortal::RatePlanWizard::STEP_DETAILS %>
            <%= render "step_details", wizard: @wizard %>
          <% when HotelPortal::RatePlanWizard::STEP_REVIEW %>
            <%= render "step_review", wizard: @wizard %>
          <% else %>
            <%= render "step_room", wizard: @wizard, step: @step, room_type: @room_type, pricing: @pricing %>
          <% end %>
        </div>
      <% end %>

      <% sheet.with_footer do %>
        <%= render PanelsUI::Button.new(
              href: hotel_rate_plan_wizard_path(current_hotel),
              variant: :destructive, size: :sm, class: "mr-auto",
              data: {
                turbo_method: :delete,
                turbo_confirm: "Discard this rate plan? Nothing has been saved yet.",
                turbo_confirm_title: "Discard rate plan",
                turbo_confirm_color: "red"
              }) do %>
          Discard
        <% end %>

        <% if @wizard.previous_step(@step) %>
          <%= render PanelsUI::Button.new(
                href: hotel_rate_plan_wizard_step_path(current_hotel, @wizard.previous_step(@step)),
                variant: :secondary, size: :sm) do %>
            Back
          <% end %>
        <% end %>

        <% if @step == HotelPortal::RatePlanWizard::STEP_REVIEW %>
          <%= render PanelsUI::Button.new(
                href: hotel_complete_rate_plan_wizard_path(current_hotel),
                size: :sm,
                data: { turbo_method: :post }) do %>
            Create rate plan
          <% end %>
        <% else %>
          <% if @room_type && @wizard.selected_room_types.size > 1 %>
            <%= render PanelsUI::Button.new(
                  as: :button, type: :submit, form: wizard_form_id(@step, @room_type),
                  name: "apply_to_all", value: "1", variant: :secondary, size: :sm) do %>
              Apply to all rooms
            <% end %>
          <% end %>

          <%= render PanelsUI::Button.new(
                as: :button, type: :submit, form: wizard_form_id(@step, @room_type), size: :sm,
                data: { turbo_submits_with: "Saving…" }) do %>
            Next
          <% end %>
        <% end %>
      <% end %>
    <% end %>
  </div>
<% end %>
