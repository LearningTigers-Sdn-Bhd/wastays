<% currency = wizard.rate_plan.currency %>
<% per_person = pricing.per_person? %>
<% modes = wizard_rate_mode_options(pricing) %>
<% sources = wizard.answered_room_types(excluding: room_type) %>

<%= form_with model: pricing,
              scope: :room_pricing,
              url: hotel_rate_plan_wizard_step_path(current_hotel, step),
              method: :patch,
              id: "rate-plan-wizard-room-#{room_type.id}",
              class: "space-y-6",
              data: {
                controller: "rate-plan-room-pricing",
                rate_plan_room_pricing_anchor_value: room_type.base_price.to_f,
                rate_plan_room_pricing_max_adults_value: pricing.max_adults,
                rate_plan_room_pricing_currency_value: currency,
                action: "input->rate-plan-room-pricing#refresh change->rate-plan-room-pricing#refresh"
              } do |f| %>
  <% if pricing.errors.any? %>
    <%= render PanelsUI::Alert.new(tone: :destructive, title: "This step could not be saved", role: :alert) do |alert| %>
      <% alert.with_description { pricing.errors.full_messages.to_sentence } %>
    <% end %>
  <% end %>

  <div class="flex flex-wrap items-start justify-between gap-3">
    <div>
      <h2 class="text-base font-semibold text-foreground"><%= room_type.name %></h2>
      <p class="mt-1 text-sm text-muted-foreground">
        <%= pluralize(pricing.max_adults, "adult") %> max · standard rate <%= wizard_money(room_type.base_price, currency) %>
      </p>
    </div>

    <% if sources.any? %>
      <div class="flex flex-wrap items-center gap-2">
        <span class="text-sm text-muted-foreground">Copy from</span>
        <% sources.each do |source| %>
          <%= render PanelsUI::Button.new(
                href: hotel_rate_plan_wizard_step_path(current_hotel, step, copy_from: source.id),
                variant: :secondary, size: :xs) do %>
            <%= source.name %>
          <% end %>
        <% end %>
      </div>
    <% end %>
  </div>

  <fieldset class="space-y-3">
    <legend class="text-sm font-medium text-foreground">Rate mode</legend>
    <div class="grid gap-2 <%= modes.size > 2 ? 'sm:grid-cols-3' : 'sm:grid-cols-2' %>">
      <% modes.each do |value, mode| %>
        <label class="flex cursor-pointer items-start gap-2.5 rounded-md border border-border p-3 hover:border-border-interactive has-[:checked]:border-border-interactive has-[:checked]:bg-muted/50">
          <%= f.radio_button :rate_mode, value,
                class: "mt-0.5 size-4 border-border-interactive text-foreground focus:ring-0",
                data: { rate_plan_room_pricing_target: "mode", action: "change->rate-plan-room-pricing#refresh" } %>
          <span>
            <span class="block text-sm font-medium text-foreground"><%= mode[:label] %></span>
            <span class="block text-xs text-muted-foreground"><%= mode[:hint] %></span>
          </span>
        </label>
      <% end %>
    </div>
  </fieldset>

  <%# Manual — the figures are typed, so there is nothing to compute. %>
  <div data-rate-plan-room-pricing-target="manualPanel" class="space-y-4">
    <% if per_person %>
      <fieldset class="grid gap-3 sm:grid-cols-2">
        <legend class="mb-1 text-sm font-medium text-foreground">Price per number of adults</legend>
        <% pricing.adult_counts.each do |adults| %>
          <div>
            <label for="room_pricing_prices_<%= adults %>" class="mb-1 block text-sm font-medium text-foreground">
              <%= pluralize(adults, "adult") %>
            </label>
            <div class="flex rounded-md border border-border bg-background focus-within:border-border-interactive">
              <span class="px-3 py-2 text-sm text-muted-foreground"><%= currency %></span>
              <%= number_field_tag "room_pricing[prices][#{adults}]", pricing.price_for(adults),
                    id: "room_pricing_prices_#{adults}",
                    min: 0, step: 0.01, inputmode: "decimal",
                    class: "min-w-0 flex-1 border-0 bg-transparent px-3 py-2 text-sm text-foreground focus:outline-none focus:ring-0" %>
            </div>
          </div>
        <% end %>
      </fieldset>
    <% else %>
      <div class="max-w-sm">
        <%= render PanelsUI::FormField.new(form: f, attribute: :default_rate, label: "Nightly room price", hint: "Applies to any date without an override.") do |field| %>
          <% field.with_input(type: :number, min: 0, step: 0.01, inputmode: "decimal") %>
          <% field.with_addon(align: :inline_start) { currency } %>
        <% end %>
      </div>
    <% end %>
  </div>

  <%# Derived — anchored on the category's standard rate. %>
  <div data-rate-plan-room-pricing-target="derivedPanel" class="grid items-start gap-4 sm:grid-cols-2">
    <%= render PanelsUI::FormField.new(form: f, attribute: :derive_mode, label: "Relationship to standard rate") do |field| %>
      <% field.with_select_menu(wizard_derive_choices, selected: pricing.derive_mode) %>
    <% end %>

    <%= render PanelsUI::FormField.new(form: f, attribute: :derive_value, label: "Adjustment", hint: "Negative to discount, positive to add.") do |field| %>
      <% field.with_input(type: :number, step: 0.01, inputmode: "decimal") %>
    <% end %>
  </div>

  <%# Auto and the ladder exist only where there is an adult count to step
      through. A per-room plan prices the room once, and rendering the Auto
      panel there would put a second default_rate field in the same form. %>
  <% if per_person %>
  <div data-rate-plan-room-pricing-target="autoPanel" class="max-w-sm">
    <%= render PanelsUI::FormField.new(form: f, attribute: :default_rate, label: "Rate at primary occupancy") do |field| %>
      <% field.with_input(type: :number, min: 0, step: 0.01, inputmode: "decimal") %>
      <% field.with_addon(align: :inline_start) { currency } %>
    <% end %>
  </div>

  <%# The ladder both computed modes share. %>
  <div data-rate-plan-room-pricing-target="ladderPanel" class="space-y-4 rounded-md border border-border p-4">
    <div class="grid items-start gap-4 sm:grid-cols-3">
      <%= render PanelsUI::FormField.new(form: f, attribute: :primary_occupancy, label: "Primary occupancy", hint: "The adult count the rate above refers to.") do |field| %>
        <% field.with_input(type: :number, min: 1, max: pricing.max_adults, step: 1, inputmode: "numeric") %>
      <% end %>

      <%= render PanelsUI::FormField.new(form: f, attribute: :increase_by, label: "Increase by", hint: "Per adult above primary.") do |field| %>
        <% field.with_input(type: :number, min: 0, step: 0.01, inputmode: "decimal") %>
      <% end %>

      <%= render PanelsUI::FormField.new(form: f, attribute: :decrease_by, label: "Decrease by", hint: "Per adult below primary.") do |field| %>
        <% field.with_input(type: :number, min: 0, step: 0.01, inputmode: "decimal") %>
      <% end %>
    </div>

    <div class="grid items-start gap-4 sm:grid-cols-2">
      <%= render PanelsUI::FormField.new(form: f, attribute: :increase_unit, label: "Increase unit", size: :sm) do |field| %>
        <% field.with_select_menu(wizard_step_unit_choices(currency), selected: pricing.increase_unit) %>
      <% end %>

      <%= render PanelsUI::FormField.new(form: f, attribute: :decrease_unit, label: "Decrease unit", size: :sm) do |field| %>
        <% field.with_select_menu(wizard_step_unit_choices(currency), selected: pricing.decrease_unit) %>
      <% end %>
    </div>

    <p class="text-sm text-muted-foreground" data-rate-plan-room-pricing-target="preview" aria-live="polite"></p>
  </div>
  <% end %>
<% end %>
