<% rate_plan = wizard.rate_plan %>
<% currency = rate_plan.currency %>
<% per_person = current_hotel.sells_per_person? %>

<div class="space-y-6">
  <section aria-labelledby="wizard-review-heading" class="space-y-4">
    <div>
      <h2 id="wizard-review-heading" class="text-base font-semibold text-foreground"><%= rate_plan.name %></h2>
      <p class="mt-1 text-sm text-muted-foreground">
        <%= per_person ? "Per person" : "Per room" %> · <%= currency %>
        <%= "· #{rate_plan.description}" if rate_plan.description.present? %>
      </p>
    </div>

    <div class="divide-y divide-border rounded-md border border-border">
      <% wizard.selected_room_types.each do |room_type| %>
        <% pricing = wizard.room_pricing(room_type) %>
        <div class="flex flex-wrap items-start justify-between gap-3 p-3">
          <div class="min-w-0">
            <p class="text-sm font-medium text-foreground"><%= room_type.name %></p>
            <p class="mt-0.5 text-xs text-muted-foreground">
              <%= pricing.rate_mode.capitalize %> · <%= wizard_matrix_summary(pricing, currency) %>
            </p>
          </div>
          <div class="flex shrink-0 items-center gap-3">
            <span class="inline-flex items-center gap-1 text-xs text-success">
              <%= app_icon "check", class: "size-3.5", aria: { hidden: "true" } %>
              <%= per_person ? "all #{pluralize(pricing.max_adults, 'adult count')} priced" : "priced" %>
            </span>
            <%= link_to "Change",
                  hotel_rate_plan_wizard_step_path(current_hotel, HotelPortal::RatePlanWizard.room_step(room_type.id)),
                  class: "text-xs text-foreground underline" %>
          </div>
        </div>
      <% end %>
    </div>
  </section>

  <section aria-labelledby="wizard-review-guests-heading" class="space-y-2 border-t border-border pt-5">
    <h3 id="wizard-review-guests-heading" class="text-sm font-medium text-foreground">Guest pricing</h3>
    <% if per_person %>
      <p class="text-sm text-muted-foreground">
        Default child price <%= number_with_precision(rate_plan.child_price_multiplier, precision: 2) %> of adult
      </p>
      <% if rate_plan.rate_plan_age_bands.any? %>
        <ul class="space-y-1 text-sm text-muted-foreground">
          <% rate_plan.rate_plan_age_bands.each do |band| %>
            <li>
              <%= band.label.presence || "Age group" %> · <%= band.min_age %>–<%= band.max_age %> yrs ·
              <%= band.pricing_mode == "amount" ? wizard_money(band.price_value, currency) : "#{number_with_precision(band.price_value, precision: 0)}% of adult" %>
            </li>
          <% end %>
        </ul>
      <% end %>
    <% else %>
      <p class="text-sm text-muted-foreground">
        Base occupancy <%= rate_plan.base_occupancy %> ·
        extra pax charge <%= wizard_money(rate_plan.extra_pax_charge, currency) %> per night
      </p>
    <% end %>
  </section>

  <%= render PanelsUI::Alert.new(tone: :info, title: "These are starting prices", role: :status) do |alert| %>
    <% alert.with_description do %>
      Date-specific prices, availability and stay restrictions are set under Rates &amp; Availability.
      <% if per_person && current_hotel.preferred_channel_manager.present? %>
        Per-person prices are not distributed to channels yet — availability keeps syncing, prices stay in Wastays.
      <% end %>
    <% end %>
  <% end %>
</div>
