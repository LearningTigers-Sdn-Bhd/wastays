<div class="max-w-[1600px] mx-auto pb-10 space-y-3.5">
  <%= render PanelsUI::PageHeader.new(title: "Agent Accounts", description: "Manage corporate and travel agent accounts and their booking codes.") do |header| %>
    <% header.with_actions do %>
      <%= render PanelsUI::Button.new(label: "Add Agent Account", as: :a, href: new_hotel_portal_agent_account_path, variant: :primary, size: :md, class: "w-full lg:w-auto") %>
    <% end %>
  <% end %>

  <div class="mt-8 flex flex-col">
  <div class="-my-2 -mx-4 overflow-x-auto sm:-mx-6 lg:-mx-8">
    <div class="inline-block min-w-full py-2 align-middle md:px-6 lg:px-8">
      <div class="overflow-hidden shadow ring-1 ring-black ring-opacity-5 md:rounded-lg">
        <table class="min-w-full divide-y divide-gray-300">
          <thead class="bg-gray-50">
            <tr>
              <th scope="col" class="py-3.5 pl-4 pr-3 text-left text-sm font-semibold text-gray-900 sm:pl-6">Name</th>
              <th scope="col" class="px-3 py-3.5 text-left text-sm font-semibold text-gray-900">Type</th>
              <th scope="col" class="px-3 py-3.5 text-left text-sm font-semibold text-gray-900">Agent Code</th>
              <th scope="col" class="px-3 py-3.5 text-left text-sm font-semibold text-gray-900">Contact</th>
              <th scope="col" class="relative py-3.5 pl-3 pr-4 sm:pr-6">
                <span class="sr-only">Actions</span>
              </th>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-200 bg-white">
            <% @agent_accounts.each do |account| %>
              <tr>
                <td class="whitespace-nowrap py-4 pl-4 pr-3 text-sm font-medium text-gray-900 sm:pl-6"><%= account.name %></td>
                <td class="whitespace-nowrap px-3 py-4 text-sm text-gray-500"><%= account.account_type.titleize %></td>
                <td class="whitespace-nowrap px-3 py-4 text-sm text-gray-500">
                  <span class="inline-flex items-center rounded-md bg-gray-100 px-2.5 py-0.5 text-sm font-medium text-gray-800">
                    <%= account.agent_code %>
                  </span>
                </td>
                <td class="whitespace-nowrap px-3 py-4 text-sm text-gray-500">
                  <div class="flex flex-col">
                    <span><%= account.contact_email %></span>
                    <span class="text-xs text-gray-400"><%= account.contact_phone %></span>
                  </div>
                </td>
                <td class="relative whitespace-nowrap py-4 pl-3 pr-4 text-right text-sm font-medium sm:pr-6">
                  <%= link_to "Edit", edit_hotel_portal_agent_account_path(account), class: "text-blue-600 hover:text-blue-900" %>
                </td>
              </tr>
            <% end %>

            <% if @agent_accounts.empty? %>
              <tr>
                <td colspan="5" class="py-10 text-center text-sm text-gray-500">
                  No agent accounts found. Create one to get started.
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>
