<div class="mx-auto max-w-3xl space-y-6 pb-20">
  <div class="flex items-start justify-between gap-4">
    <div>
      <p class="text-xs font-bold uppercase tracking-[0.2em] text-slate-400">Payment Submission</p>
      <h1 class="mt-1 text-3xl font-bold tracking-tight text-slate-950"><%= @submission.hotel_corporate_account.corporate_account.name %></h1>
      <p class="mt-1 text-sm text-slate-600">Submitted by <%= @submission.submitted_by.name %> on <%= l(@submission.created_at, format: :short) %></p>
    </div>
    <%= link_to "Back to Payment Record", hotel_ar_payments_path(current_hotel), class: "rounded-xl border border-slate-200 bg-white px-4 py-2 text-sm font-bold text-slate-700 shadow-sm" %>
  </div>

  <section class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">
    <div class="border-b border-slate-200 px-6 py-5"><h2 class="text-lg font-bold text-slate-950">Details</h2></div>
    <dl class="grid grid-cols-2 gap-4 p-6 text-sm">
      <% if @submission.ar_payment_submission_allocations.any? %>
        <div class="col-span-2">
          <dt class="text-slate-500">Invoice(s)</dt>
          <dd class="mt-1 flex flex-wrap gap-2">
            <% @submission.ar_payment_submission_allocations.each do |allocation| %>
              <%= link_to allocation.ar_invoice.formatted_invoice_number, hotel_ar_invoice_path(current_hotel, allocation.ar_invoice), class: "rounded-lg border border-slate-200 bg-slate-50 px-2.5 py-1 text-xs font-bold text-slate-800 underline" %>
            <% end %>
          </dd>
        </div>
      <% end %>
      <% if @submission.booking.present? %>
        <div>
          <dt class="text-slate-500">Booking</dt>
          <dd class="font-bold text-slate-950">
            <%= link_to @submission.booking.formatted_reservation_number, hotel_booking_path(current_hotel, @submission.booking), class: "underline" %>
            <% if @submission.booking.closed? %>
              <span class="ml-1.5 inline-flex items-center gap-1 rounded-md border border-amber-200 bg-amber-50 px-1.5 py-0.5 text-[10px] font-bold uppercase tracking-wider text-amber-700">
                <%= @submission.booking.status.humanize %>
              </span>
            <% end %>
          </dd>
        </div>
      <% end %>
      <div><dt class="text-slate-500">Reference</dt><dd class="font-bold text-slate-950"><%= @submission.reference_number %></dd></div>
      <div><dt class="text-slate-500">Amount</dt><dd class="font-bold text-slate-950"><%= @submission.currency %> <%= number_with_precision(@submission.amount, precision: 2, delimiter: ",") %></dd></div>
      <div><dt class="text-slate-500">Date paid</dt><dd class="font-bold text-slate-950"><%= l(@submission.received_at, format: :short) %></dd></div>
      <div><dt class="text-slate-500">Method</dt><dd class="font-bold text-slate-950"><%= @submission.payment_method.humanize %></dd></div>
      <% if @submission.notes.present? %>
        <div class="col-span-2"><dt class="text-slate-500">Notes</dt><dd class="font-semibold text-slate-800"><%= @submission.notes %></dd></div>
      <% end %>
      <div class="col-span-2">
        <dt class="text-slate-500">Slip</dt>
        <dd class="mt-3">
          <%= render "hotel_portal/ar_payment_submissions/slip", submission: @submission %>
        </dd>
      </div>
    </dl>
  </section>

  <% if @submission.pending? && @submission.booking&.closed? %>
    <div class="rounded-xl border border-amber-200 bg-amber-50 px-4 py-3 text-sm font-semibold text-amber-900">
      The booking this was sent against is now <%= @submission.booking.status %>. Recording this payment will
      still post it to that booking's folio -- worth confirming with the agent before approving.
    </div>
  <% end %>

  <% if @submission.pending? %>
    <div class="flex gap-2">
      <button type="button" command="show-modal" commandfor="reject-submission-dialog"
              class="rounded-xl border border-red-300 bg-white px-5 py-3 text-sm font-bold text-red-700 hover:bg-red-100">Reject Submission</button>
      <%= link_to "Record This Payment",
        new_hotel_ar_payment_path(current_hotel,
          hotel_corporate_account_id: @submission.hotel_corporate_account_id,
          ar_payment_submission_id: @submission.id),
        class: "flex-1 rounded-xl bg-slate-900 px-5 py-3 text-center text-sm font-bold text-white shadow-sm hover:bg-slate-700" %>
    </div>

    <%= form_with url: reject_hotel_ar_payment_submission_path(current_hotel, @submission), method: :patch, local: true do |f| %>
      <%= render PanelsUI::Dialog.new(id: "reject-submission-dialog", title: "Reject this submission",
            description: "The agent will see your comments on their submission.", size: :md) do |dialog| %>
        <% dialog.with_body do %>
          <%= render PanelsUI::FormField.new(form: f, attribute: :rejection_reason, label: "Comments", required: true) do |field| %>
            <% field.with_text_area(rows: 4, placeholder: "Explain why this submission is being rejected.") %>
          <% end %>
        <% end %>
        <% dialog.with_footer do %>
          <%= render PanelsUI::Button.new(as: :button, type: :button, variant: :secondary, size: :sm, data: { action: "ui--dialog#close" }) do %>Cancel<% end %>
          <%= render PanelsUI::Button.new(as: :button, type: :submit, variant: :destructive, size: :sm) do %>Reject Submission<% end %>
        <% end %>
      <% end %>
    <% end %>
  <% elsif @submission.approved? %>
    <div class="rounded-xl border border-emerald-200 bg-emerald-50 px-4 py-3 text-sm font-semibold text-emerald-800">
      Approved — recorded as <%= link_to "payment ##{@submission.ar_payment.reference_number}", hotel_ar_payment_path(current_hotel, @submission.ar_payment), class: "underline" %>.
    </div>
  <% elsif @submission.rejected? %>
    <div class="rounded-xl border border-red-200 bg-red-50 px-4 py-3">
      <p class="text-xs font-bold uppercase tracking-wider text-red-700">
        Rejected by <%= @submission.reviewed_by&.name %> &middot; <%= l(@submission.reviewed_at, format: :short) %>
      </p>
      <p class="mt-1.5 text-sm font-semibold text-red-800"><%= @submission.rejection_reason %></p>
    </div>
  <% end %>
</div>
