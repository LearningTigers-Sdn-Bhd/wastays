<% content_for :breadcrumbs do %>
  <div class="flex items-center gap-x-2">
    <span class="text-sm font-medium text-slate-600"><%= current_hotel.name %></span>
    <span class="text-sm text-slate-400">/</span>
    <span class="text-sm font-semibold text-slate-900">Operation Logs</span>
  </div>
<% end %>

<div class="max-w-[1600px] mx-auto pb-20 space-y-8">
  <div class="px-4 md:px-0">
    <div class="mt-5 flex flex-col md:flex-row md:items-end md:justify-between gap-4">
      <div>
        <h1 class="text-2xl font-bold tracking-tight text-slate-950 sm:text-3xl">Operation Audit Logs</h1>
        <p class="mt-1 text-sm font-medium text-slate-600">Trace every change made to your hotel's rates and inventory.</p>
      </div>

      <div class="inline-flex gap-x-2">
        <%= link_to hotel_audit_logs_path(current_hotel, format: :csv, room_type_id: params[:room_type_id], action_type: params[:action_type], start_date: params[:start_date], end_date: params[:end_date]), class: "inline-flex items-center rounded-xl bg-white border border-slate-200 px-4 py-2.5 text-sm font-bold text-slate-700 shadow-sm transition hover:border-slate-900 hover:bg-slate-50", data: { turbo: false } do %>
          <svg class="size-4 me-2" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
          Export CSV
        <% end %>
      </div>
    </div>
  </div>

  <div class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">
    <!-- Filters -->
    <div class="border-b border-slate-200 bg-slate-50/70 px-6 py-6 sm:px-8">
      <%= form_with url: hotel_audit_logs_path(current_hotel), method: :get, class: "flex flex-col gap-4 xl:flex-row xl:items-end xl:justify-between" do |f| %>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4 flex-1">
          <div>
            <label class="block text-[11px] font-bold text-slate-500 uppercase tracking-wider mb-2">Room Type</label>
            <%= f.select :room_type_id, current_hotel.room_types.map { |rt| [rt.name, rt.id] }, { include_blank: "All Room Types", selected: params[:room_type_id] }, class: "w-full rounded-xl border border-slate-200 bg-white px-4 py-2.5 text-sm font-medium text-slate-700 focus:border-slate-300 focus:outline-none focus:ring-0 shadow-sm" %>
          </div>
          <div>
            <label class="block text-[11px] font-bold text-slate-500 uppercase tracking-wider mb-2">Action Type</label>
            <%= f.select :action_type, [['Bulk Rate Update', 'bulk_rate_update'], ['Bulk Inventory Update', 'bulk_inventory_update']], { include_blank: "All Actions", selected: params[:action_type] }, class: "w-full rounded-xl border border-slate-200 bg-white px-4 py-2.5 text-sm font-medium text-slate-700 focus:border-slate-300 focus:outline-none focus:ring-0 shadow-sm" %>
          </div>
          <div>
            <label class="block text-[11px] font-bold text-slate-500 uppercase tracking-wider mb-2">Start Date</label>
            <%= f.date_field :start_date, value: params[:start_date], class: "w-full rounded-xl border border-slate-200 bg-white px-4 py-2.5 text-sm font-medium text-slate-700 focus:border-slate-300 focus:outline-none focus:ring-0 shadow-sm" %>
          </div>
          <div>
            <label class="block text-[11px] font-bold text-slate-500 uppercase tracking-wider mb-2">End Date</label>
            <%= f.date_field :end_date, value: params[:end_date], class: "w-full rounded-xl border border-slate-200 bg-white px-4 py-2.5 text-sm font-medium text-slate-700 focus:border-slate-300 focus:outline-none focus:ring-0 shadow-sm" %>
          </div>
        </div>
        <div class="flex items-center gap-2 lg:mb-0.5">
          <%= link_to "Reset", hotel_audit_logs_path(current_hotel), class: "inline-flex items-center rounded-xl border border-slate-200 bg-white px-5 py-2.5 text-sm font-bold text-slate-700 shadow-sm transition hover:bg-slate-50" %>
          <%= f.submit "Apply Filters", class: "inline-flex items-center rounded-xl bg-slate-900 px-6 py-2.5 text-sm font-bold text-white shadow-sm transition hover:bg-slate-700 whitespace-nowrap" %>
        </div>
      <% end %>
    </div>

    <!-- Table -->
    <div class="overflow-x-auto">
      <table class="min-w-full table-fixed">
        <colgroup>
          <col class="w-[18%]">
          <col class="w-[15%]">
          <col class="w-[15%]">
          <col class="w-[20%]">
          <col class="w-[32%]">
        </colgroup>
        <thead class="bg-slate-100">
          <tr>
            <th scope="col" class="px-6 py-4 text-left text-[11px] font-semibold uppercase tracking-[0.1em] text-slate-600 sm:px-8">Time</th>
            <th scope="col" class="px-6 py-4 text-left text-[11px] font-semibold uppercase tracking-[0.1em] text-slate-600">User</th>
            <th scope="col" class="px-6 py-4 text-left text-[11px] font-semibold uppercase tracking-[0.1em] text-slate-600">Action</th>
            <th scope="col" class="px-6 py-4 text-left text-[11px] font-semibold uppercase tracking-[0.1em] text-slate-600">Details</th>
            <th scope="col" class="px-6 py-4 text-left text-[11px] font-semibold uppercase tracking-[0.1em] text-slate-600 sm:px-8">Value Change</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-200 bg-white">
          <% if @logs.any? %>
            <% @logs.each_with_index do |log, index| %>
              <tr class="align-top transition-colors hover:bg-slate-100/80 <%= index.even? ? 'bg-white' : 'bg-slate-50/55' %>">
                <td class="px-6 py-4 sm:px-8">
                  <span class="text-sm font-medium text-slate-900"><%= log.created_at.strftime("%d %b %Y") %></span>
                  <span class="block text-[10px] font-bold text-slate-500"><%= log.created_at.strftime("%I:%M %p") %></span>
                </td>
                <td class="px-6 py-4">
                  <span class="text-sm font-semibold text-slate-900"><%= log.user.name %></span>
                </td>
                <td class="px-6 py-4 whitespace-nowrap">
                  <% 
                    action_class = case log.action_type
                    when 'bulk_rate_update' then 'border-purple-200 bg-purple-50 text-purple-700'
                    when 'bulk_inventory_update' then 'border-blue-200 bg-blue-50 text-blue-700'
                    else 'border-slate-200 bg-slate-50 text-slate-700'
                    end
                  %>
                  <span class="inline-flex items-center rounded-full border px-2.5 py-1 text-[10px] font-bold uppercase tracking-wider <%= action_class %>">
                    <%= log.action_type.titleize %>
                  </span>
                </td>
                <td class="px-6 py-4">
                  <span class="text-sm text-slate-700 font-medium"><%= log.display_details %></span>
                </td>
                <td class="px-6 py-4 sm:px-8">
                  <span class="text-sm font-mono text-slate-600 leading-relaxed"><%= log.display_value_change %></span>
                </td>
              </tr>
            <% end %>
          <% else %>
            <tr>
              <td colspan="5" class="px-6 py-20 text-center sm:px-8">
                <p class="text-sm font-medium text-slate-500 italic">No audit logs found matching your criteria.</p>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>

    <% if @logs.total_pages > 1 %>
      <div class="px-6 py-4 border-t border-slate-200 bg-slate-50/50 sm:px-8">
        <%= paginate @logs %>
      </div>
    <% end %>
  </div>
</div>
