<div class="w-full space-y-3.5">
  <%= render PanelsUI::PageHeader.new(title: "Operation Audit Logs", description: "Trace every change made to your hotel's rates and inventory.") do |header| %>
    <% header.with_actions do %>
      <%= render PanelsUI::DropdownMenu.new(id: "audit-logs-export-menu", placement: :bottom_end, class: "w-44") do |menu| %>
        <% menu.with_trigger(variant: :neutral, size: :md, class: "w-full sm:w-auto") do %>
          <%= cached_icon "download", class: "size-4" %>
          Export
        <% end %>
        <% menu.with_item(href: hotel_audit_logs_path(current_hotel, format: :pdf, room_type_id: params[:room_type_id], action_type: params[:action_type], start_date: params[:start_date], end_date: params[:end_date]), variant: :default, data: { turbo: false }) { "Export PDF" } %>
        <% menu.with_item(href: hotel_audit_logs_path(current_hotel, format: :xlsx, room_type_id: params[:room_type_id], action_type: params[:action_type], start_date: params[:start_date], end_date: params[:end_date]), variant: :default, data: { turbo: false }) { "Export Excel" } %>
        <% menu.with_item(href: hotel_audit_logs_path(current_hotel, format: :csv, room_type_id: params[:room_type_id], action_type: params[:action_type], start_date: params[:start_date], end_date: params[:end_date]), variant: :default, data: { turbo: false }) { "Export CSV" } %>
      <% end %>
    <% end %>
  <% end %>

  <div class="overflow-hidden rounded-2xl border border-border bg-card shadow-sm">
    <!-- Filters -->
    <div class="border-b border-border bg-muted/70 px-6 py-6 sm:px-8">
      <%= form_with url: hotel_audit_logs_path(current_hotel), method: :get, class: "flex flex-col gap-4 xl:flex-row xl:items-end xl:justify-between" do |f| %>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4 flex-1">
          <div>
            <label class="block text-[11px] font-bold text-muted-foreground uppercase tracking-wider mb-2">Room Type</label>
            <%= f.select :room_type_id, current_hotel.room_types.map { |rt| [rt.name, rt.id] }, { include_blank: "All Room Types", selected: params[:room_type_id] }, class: "w-full rounded-xl border border-border bg-card px-4 py-2.5 text-sm font-medium text-foreground focus:border-border-interactive focus:outline-none focus:ring-0 shadow-sm" %>
          </div>
          <div>
            <label class="block text-[11px] font-bold text-muted-foreground uppercase tracking-wider mb-2">Action Type</label>
            <%= f.select :action_type, [['Bulk Rate Update', 'bulk_rate_update'], ['Bulk Inventory Update', 'bulk_inventory_update']], { include_blank: "All Actions", selected: params[:action_type] }, class: "w-full rounded-xl border border-border bg-card px-4 py-2.5 text-sm font-medium text-foreground focus:border-border-interactive focus:outline-none focus:ring-0 shadow-sm" %>
          </div>
          <div>
            <label class="block text-[11px] font-bold text-muted-foreground uppercase tracking-wider mb-2">Start Date</label>
            <%= f.date_field :start_date, value: params[:start_date], class: "w-full rounded-xl border border-border bg-card px-4 py-2.5 text-sm font-medium text-foreground focus:border-border-interactive focus:outline-none focus:ring-0 shadow-sm" %>
          </div>
          <div>
            <label class="block text-[11px] font-bold text-muted-foreground uppercase tracking-wider mb-2">End Date</label>
            <%= f.date_field :end_date, value: params[:end_date], class: "w-full rounded-xl border border-border bg-card px-4 py-2.5 text-sm font-medium text-foreground focus:border-border-interactive focus:outline-none focus:ring-0 shadow-sm" %>
          </div>
        </div>
        <div class="flex items-center gap-2 lg:mb-0.5">
          <%= link_to "Reset", hotel_audit_logs_path(current_hotel), class: "inline-flex items-center rounded-xl border border-border bg-card px-5 py-2.5 text-sm font-bold text-foreground shadow-sm transition hover:bg-muted" %>
          <%= f.submit "Apply Filters", class: "inline-flex items-center rounded-xl bg-primary px-6 py-2.5 text-sm font-bold text-primary-foreground shadow-sm transition hover:bg-primary-hover whitespace-nowrap" %>
        </div>
      <% end %>
    </div>

    <!-- Table -->
    <div class="overflow-x-auto">
      <table class="min-w-full table-fixed">
        <colgroup>
          <col class="w-[18%]">
          <col class="w-[15%]">
          <col class="w-[15%]">
          <col class="w-[20%]">
          <col class="w-[32%]">
        </colgroup>
        <thead class="bg-muted">
          <tr>
            <th scope="col" class="px-6 py-4 text-left text-[11px] font-semibold uppercase tracking-[0.1em] text-muted-foreground sm:px-8">Time</th>
            <th scope="col" class="px-6 py-4 text-left text-[11px] font-semibold uppercase tracking-[0.1em] text-muted-foreground">User</th>
            <th scope="col" class="px-6 py-4 text-left text-[11px] font-semibold uppercase tracking-[0.1em] text-muted-foreground">Action</th>
            <th scope="col" class="px-6 py-4 text-left text-[11px] font-semibold uppercase tracking-[0.1em] text-muted-foreground">Details</th>
            <th scope="col" class="px-6 py-4 text-left text-[11px] font-semibold uppercase tracking-[0.1em] text-muted-foreground sm:px-8">Value Change</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-border bg-card">
          <% if @logs.any? %>
            <% @logs.each_with_index do |log, index| %>
              <tr class="align-top transition-colors hover:bg-muted/80 <%= index.even? ? 'bg-card' : 'bg-muted/55' %>">
                <td class="px-6 py-4 sm:px-8">
                  <span class="text-sm font-medium text-foreground"><%= log.created_at.strftime("%d %b %Y") %></span>
                  <span class="block text-[10px] font-bold text-muted-foreground"><%= log.created_at.strftime("%I:%M %p") %></span>
                </td>
                <td class="px-6 py-4">
                  <span class="text-sm font-semibold text-foreground"><%= log.user.name %></span>
                </td>
                <td class="px-6 py-4 whitespace-nowrap">
                  <%
                    action_class = case log.action_type
                    when 'bulk_rate_update' then 'border-purple-200 bg-purple-50 text-purple-700'
                    when 'bulk_inventory_update' then 'border-blue-200 bg-blue-50 text-blue-700'
                    else 'border-border bg-muted text-foreground'
                    end
                  %>
                  <span class="inline-flex items-center rounded-full border px-2.5 py-1 text-[10px] font-bold uppercase tracking-wider <%= action_class %>">
                    <%= log.action_type.titleize %>
                  </span>
                </td>
                <td class="px-6 py-4">
                  <span class="text-sm text-foreground font-medium"><%= log.display_details %></span>
                </td>
                <td class="px-6 py-4 sm:px-8">
                  <span class="text-sm font-mono text-muted-foreground leading-relaxed"><%= log.display_value_change %></span>
                </td>
              </tr>
            <% end %>
          <% else %>
            <tr>
              <td colspan="5" class="px-6 py-20 text-center sm:px-8">
                <p class="text-sm font-medium text-muted-foreground italic">No audit logs found matching your criteria.</p>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>

    <div class="px-6 py-4 border-t border-border bg-muted/50 flex justify-center sm:px-8">
      <%= paginate @logs %>
    </div>
  </div>
</div>
