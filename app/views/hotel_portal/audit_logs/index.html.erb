<div class="w-full space-y-4" data-slot="report-page" data-report="operation-logs">
  <%= render PanelsUI::PageHeader.new(title: "Operation audit logs", description: "Trace every change made to your hotel's rates and inventory.") do |header| %>
    <% header.with_caption do %>
      <p class="text-sm font-medium text-muted-foreground"><%= current_hotel.name %> · <%= @period_label %></p>
    <% end %>
    <% header.with_actions do %>
      <%= render PanelsUI::DropdownMenu.new(id: "audit-logs-export-menu", placement: :bottom_end) do |menu| %>
        <% menu.with_trigger(variant: :secondary) do %>
          <%= cached_icon "download", class: "me-2 size-4" %>
          Export
          <%= cached_icon "chevron-down", class: "ms-2 size-4", aria: { hidden: "true" } %>
        <% end %>
        <% menu.with_item(href: hotel_audit_logs_path(current_hotel, format: :pdf, room_type_id: params[:room_type_id], action_type: params[:action_type], start_date: @start_date, end_date: @end_date), data: { turbo: false }) { "Export PDF" } %>
        <% menu.with_item(href: hotel_audit_logs_path(current_hotel, format: :xlsx, room_type_id: params[:room_type_id], action_type: params[:action_type], start_date: @start_date, end_date: @end_date), data: { turbo: false }) { "Export Excel" } %>
        <% menu.with_item(href: hotel_audit_logs_path(current_hotel, format: :csv, room_type_id: params[:room_type_id], action_type: params[:action_type], start_date: @start_date, end_date: @end_date), data: { turbo: false }) { "Export CSV" } %>
      <% end %>
    <% end %>
  <% end %>

  <section class="rounded-lg border border-border bg-card p-3" aria-label="Operation log filters">
    <%= form_with url: hotel_audit_logs_path(current_hotel), method: :get, class: "flex flex-col gap-3 xl:flex-row xl:items-end" do |f| %>
      <div class="grid flex-1 grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-4">
        <%= render PanelsUI::FormField.new(form: f, attribute: :room_type_id, label: "Room type", size: :sm) do |field| %>
          <% field.with_select_menu(
               [{ label: "All room types", value: "" }] + current_hotel.room_types.map { |room_type| { label: room_type.name, value: room_type.id } },
               selected: params[:room_type_id]) %>
        <% end %>
        <%= render PanelsUI::FormField.new(form: f, attribute: :action_type, label: "Action type", size: :sm) do |field| %>
          <% field.with_select_menu(
               [
                 { label: "All actions", value: "" },
                 { label: "Bulk rate update", value: "bulk_rate_update" },
                 { label: "Bulk inventory update", value: "bulk_inventory_update" }
               ],
               selected: params[:action_type]) %>
        <% end %>
        <%= render PanelsUI::FormField.new(form: f, attribute: :start_date, label: "Start date", size: :sm) do |field| %>
          <% field.with_date_picker(value: @start_date&.iso8601, linked_to: :end_date, placeholder: "Start date") %>
        <% end %>
        <%= render PanelsUI::FormField.new(form: f, attribute: :end_date, label: "End date", size: :sm) do |field| %>
          <% field.with_date_picker(value: @end_date&.iso8601, min: @start_date&.iso8601, placeholder: "End date") %>
        <% end %>
      </div>
      <div class="flex items-center gap-2">
        <%= render PanelsUI::Button.new(href: hotel_audit_logs_path(current_hotel), variant: :secondary, size: :sm) do %>
          Reset
        <% end %>
        <%= render PanelsUI::Button.new(as: :button, type: :submit, size: :sm) do %>
          Apply filters
        <% end %>
      </div>
    <% end %>
  </section>

  <section class="space-y-3" aria-labelledby="operation-log-records-heading">
    <h2 id="operation-log-records-heading" class="text-base font-semibold text-foreground">Operation log records</h2>

    <%= render PanelsUI::Table.new(
          caption: "Operation audit logs",
          density: :compact,
          header_style: :sentence,
          hoverable: true,
          class: "min-w-[52rem] table-fixed",
          wrapper_class: "rounded-lg border border-border bg-card"
        ) do |table| %>
      <% table.with_header do %>
        <tr>
          <th scope="col" class="w-[18%]">Time</th>
          <th scope="col" class="w-[15%]">User</th>
          <th scope="col" class="w-[17%]">Action</th>
          <th scope="col" class="w-[20%]">Details</th>
          <th scope="col" class="w-[30%]">Value change</th>
        </tr>
      <% end %>
      <% table.with_body do %>
        <% if @logs.any? %>
          <% @logs.each do |log| %>
            <% action_variant = case log.action_type
                                when "bulk_rate_update" then :accent
                                when "bulk_inventory_update" then :info
                                else :neutral
                                end %>
            <tr class="align-top">
              <td class="whitespace-nowrap">
                <span class="font-medium text-foreground"><%= log.created_at.strftime("%d %b %Y") %></span>
                <span class="block text-xs text-muted-foreground"><%= log.created_at.strftime("%I:%M %p") %></span>
              </td>
              <td class="font-semibold text-foreground"><%= log.user.name %></td>
              <td class="whitespace-nowrap">
                <%= render PanelsUI::Badge.new(label: log.action_type.titleize, variant: action_variant, size: :sm) %>
              </td>
              <td class="text-foreground"><%= log.display_details %></td>
              <td class="font-mono text-xs leading-5 text-muted-foreground"><%= log.display_value_change %></td>
            </tr>
          <% end %>
        <% else %>
          <%= render "hotel_portal/reports/table_empty_state", colspan: 5, message: "No audit logs found matching your criteria." %>
        <% end %>
      <% end %>
    <% end %>

    <%= render "hotel_portal/reports/table_pagination", collection: @logs %>
  </section>
</div>
