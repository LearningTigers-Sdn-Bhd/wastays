<div class="space-y-6 pb-12">
  <!-- Page Header -->
  <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-y-4">
    <div>
      <nav class="flex mb-2" aria-label="Breadcrumb">
        <ol class="flex items-center whitespace-nowrap min-w-0">
          <li class="flex items-center text-sm text-neutral-text-secondary">
            Hotel Admin
            <svg class="flex-shrink-0 mx-2 overflow-visible h-4 w-4 text-gray-400" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg>
          </li>
          <li class="flex items-center text-sm text-neutral-text-secondary">
            <%= link_to "Room Types", hotel_room_types_path, class: "hover:text-brand-primary" %>
            <svg class="flex-shrink-0 mx-2 overflow-visible h-4 w-4 text-gray-400" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg>
          </li>
          <li class="text-sm font-semibold text-brand-primary truncate" aria-current="page">
            Rates
          </li>
        </ol>
      </nav>
      <h1 class="text-2xl font-bold text-neutral-text-primary">Manage Rates: <%= @room_type.name %></h1>
      <p class="text-sm text-neutral-text-secondary">Set seasonal or event-based pricing for this room category.</p>
    </div>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-12 gap-6">
    <!-- Rate Calendar Card -->
    <div class="lg:col-span-8">
      <div class="card overflow-hidden">
        <div class="p-4 md:p-5 border-b border-neutral-border flex flex-col sm:flex-row justify-between items-center gap-4">
          <h3 class="text-sm font-bold text-neutral-text-primary uppercase tracking-widest">Rate Calendar</h3>
          
          <div class="flex items-center bg-neutral-bg p-1 rounded-lg border border-neutral-border">
            <%= link_to hotel_room_type_rates_path(@room_type, start_date: @start_date - 14.days), class: "p-1.5 hover:bg-white hover:shadow-sm rounded-md transition-all text-neutral-text-secondary hover:text-brand-primary" do %>
              <svg class="w-4 h-4" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg>
            <% end %>
            <span class="px-4 text-xs font-black text-neutral-text-primary uppercase tracking-tighter">
              <%= @start_date.strftime("%b %d") %> - <%= @end_date.strftime("%b %d") %>
            </span>
            <%= link_to hotel_room_type_rates_path(@room_type, start_date: @start_date + 14.days), class: "p-1.5 hover:bg-white hover:shadow-sm rounded-md transition-all text-neutral-text-secondary hover:text-brand-primary" do %>
              <svg class="w-4 h-4" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg>
            <% end %>
          </div>
        </div>

        <div class="overflow-x-auto">
          <table class="min-w-full divide-x divide-neutral-border">
            <thead>
              <tr class="bg-neutral-bg/50">
                <% (@start_date..@end_date).each do |date| %>
                  <th class="px-4 py-3 text-center border-e border-neutral-border last:border-e-0">
                    <span class="block text-[10px] font-black uppercase tracking-widest <%= date == Date.today ? 'text-brand-primary' : 'text-neutral-text-secondary' %>"><%= date.strftime("%a") %></span>
                    <span class="block text-sm font-bold <%= date == Date.today ? 'text-brand-primary' : 'text-neutral-text-primary' %>"><%= date.strftime("%d %b") %></span>
                  </th>
                <% end %>
              </tr>
            </thead>
            <tbody class="divide-y divide-neutral-border">
              <tr>
                <% (@start_date..@end_date).each do |date| %>
                  <td class="px-4 py-8 text-center border-e border-neutral-border last:border-e-0 hover:bg-neutral-bg transition-colors">
                    <% rate = @rates[date] %>
                    <div class="inline-flex flex-col items-center">
                      <span class="text-[10px] font-black text-neutral-text-secondary uppercase tracking-widest mb-1">RM</span>
                      <span class="text-xl font-black text-neutral-text-primary">
                        <%= number_with_precision(rate&.price || @room_type.base_price, precision: 0) %>
                      </span>
                      
                      <% unless rate %>
                        <div class="mt-2">
                          <span class="text-[9px] font-black text-neutral-text-secondary uppercase tracking-widest px-1.5 py-0.5 rounded bg-neutral-border/30">Base</span>
                        </div>
                      <% else %>
                        <div class="mt-2">
                          <span class="badge badge-success text-[9px] uppercase">Custom</span>
                        </div>
                      <% end %>
                    </div>
                  </td>
                <% end %>
              </tr>
            </tbody>
          </table>
        </div>
      </div>
    </div>

    <!-- Bulk Update Side Card -->
    <div class="lg:col-span-4">
      <div class="card shadow-lg border-brand-secondary/10">
        <div class="p-4 md:p-5 border-b border-neutral-border bg-brand-secondary/5">
          <h3 class="text-sm font-black text-neutral-text-primary uppercase tracking-widest">Bulk Rate Update</h3>
        </div>
        <div class="p-6">
          <%= form_with scope: :rate, url: hotel_room_type_rates_path(@room_type), local: true, class: "space-y-5" do |f| %>
            <div class="grid grid-cols-2 gap-4">
              <div>
                <label for="start_date" class="block text-[10px] font-black uppercase tracking-widest text-neutral-text-secondary mb-1.5">Start Date</label>
                <%= f.date_field :start_date, value: @start_date, id: "start_date", class: "form-input py-2 text-xs" %>
              </div>
              <div>
                <label for="end_date" class="block text-[10px] font-black uppercase tracking-widest text-neutral-text-secondary mb-1.5">End Date</label>
                <%= f.date_field :end_date, value: @end_date, id: "end_date", class: "form-input py-2 text-xs" %>
              </div>
            </div>

            <div>
              <label for="price" class="block text-[10px] font-black uppercase tracking-widest text-neutral-text-secondary mb-1.5">New Rate (RM)</label>
              <div class="relative">
                <div class="absolute inset-y-0 start-0 flex items-center ps-3 pointer-events-none">
                  <span class="text-xs font-bold text-neutral-text-secondary">RM</span>
                </div>
                <%= f.number_field :price, step: 0.01, value: @room_type.base_price, id: "price", class: "form-input py-2 ps-10 text-sm font-bold", required: true %>
              </div>
              <p class="text-[10px] text-neutral-text-secondary mt-1.5 italic">This will override the base price for the selected range.</p>
            </div>

            <%= f.hidden_field :currency, value: 'MYR' %>

            <div class="pt-2">
              <%= f.submit "Apply New Rates", class: "btn btn-primary w-full py-3 text-xs font-black uppercase tracking-widest shadow-lg shadow-brand-primary/20" %>
            </div>
          <% end %>
        </div>
      </div>
      
      <div class="mt-6 p-4 rounded-xl bg-neutral-surface border border-neutral-border">
        <h4 class="text-[10px] font-black text-neutral-text-primary uppercase tracking-widest mb-2">Seasonal Pricing</h4>
        <p class="text-xs text-neutral-text-secondary leading-relaxed">Consider increasing rates during public holidays and peak travel seasons in Malaysia.</p>
      </div>
    </div>
  </div>
</div>
