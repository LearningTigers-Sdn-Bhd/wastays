<% content_for :breadcrumbs do %>
  <div class="flex items-center gap-x-2">
    <span class="text-sm font-medium text-slate-600"><%= current_hotel.name %></span>
    <span class="text-sm text-slate-400">/</span>
    <%= link_to "Room Categories", hotel_room_types_path(current_hotel), class: "text-sm font-medium text-slate-600 hover:text-slate-900" %>
    <span class="text-sm text-slate-400">/</span>
    <span class="text-sm font-semibold text-slate-900">Rates</span>
  </div>
<% end %>

<div class="max-w-[1600px] mx-auto pb-20 space-y-8">
  <div class="px-4 md:px-0">
    <div class="mt-5 flex flex-col md:flex-row md:items-end md:justify-between gap-4">
      <div>
        <h1 class="text-2xl font-bold tracking-tight text-slate-950 sm:text-3xl">Manage Rates</h1>
        <p class="mt-1 text-sm font-medium text-slate-600">Pricing for <span class="font-bold text-slate-900"><%= @room_type.name %></span></p>
      </div>

      <div class="flex items-center gap-2">
        <div class="flex items-center gap-2">
          <%= form_with url: hotel_room_type_rates_path(current_hotel, @room_type), method: :get, local: true, class: "flex items-center gap-2" do |f| %>
            <%= f.hidden_field :rate_plan_id, value: @rate_plan.id %>
            <%= f.date_field :start_date, value: @start_date, 
                             class: "rounded-xl border border-slate-200 bg-white px-3 py-2 text-sm font-semibold text-slate-700 shadow-sm focus:border-slate-300 focus:outline-none focus:ring-0",
                             onchange: "this.form.submit()" %>
          <% end %>

          <%= form_with url: nil, method: :get, local: true, class: "min-w-[150px]", data: { turbo: false } do |f| %>
            <%= f.hidden_field :start_date, value: @start_date %>
            <%= f.select :room_type_id,
                        options_from_collection_for_select(@room_types, :id, :name, @room_type.id),
                        {},
                        {
                          class: "w-full rounded-xl border border-slate-200 bg-white px-3 py-2 text-sm font-semibold text-slate-700 shadow-sm focus:border-slate-300 focus:outline-none focus:ring-0",
                          onchange: "window.location.href = window.location.pathname.replace(/room_types\\/\\d+/, 'room_types/' + this.value) + window.location.search",
                          aria: { label: "Select room type" }
                        } %>
          <% end %>

          <%= form_with url: hotel_room_type_rates_path(current_hotel, @room_type), method: :get, local: true, class: "min-w-[150px]" do |f| %>
            <%= f.hidden_field :start_date, value: @start_date %>
            <%= f.select :rate_plan_id,
                        options_from_collection_for_select(@rate_plans, :id, :name, @rate_plan.id),
                        {},
                        {
                          class: "w-full rounded-xl border border-slate-200 bg-white px-3 py-2 text-sm font-semibold text-slate-700 shadow-sm focus:border-slate-300 focus:outline-none focus:ring-0",
                          onchange: "this.form.submit()",
                          aria: { label: "Select rate plan" }
                        } %>
          <% end %>
        </div>

        <div class="inline-flex bg-slate-100 rounded-xl p-1 shadow-sm border border-slate-200">
          <%= link_to hotel_room_type_rates_path(current_hotel, @room_type, start_date: @start_date - 14.days, rate_plan_id: @rate_plan.id), 
              class: "p-1.5 hover:bg-white hover:shadow-sm rounded-lg transition text-slate-500 hover:text-slate-900" do %>
            <svg class="size-4" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg>
          <% end %>
          <span class="px-4 flex items-center text-xs font-bold text-slate-700 uppercase tracking-wider">
            <%= @start_date.strftime("%b %d") %> - <%= @end_date.strftime("%b %d") %>
          </span>
          <%= link_to hotel_room_type_rates_path(current_hotel, @room_type, start_date: @start_date + 14.days, rate_plan_id: @rate_plan.id), 
              class: "p-1.5 hover:bg-white hover:shadow-sm rounded-lg transition text-slate-500 hover:text-slate-900" do %>
            <svg class="size-4" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg>
          <% end %>
        </div>
      </div>
    </div>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-12 gap-6">
    <!-- Rate Calendar Card -->
    <div class="lg:col-span-9">
      <div class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">
        <div class="border-b border-slate-200 px-6 py-4 sm:px-8">
          <h2 class="text-lg font-bold tracking-tight text-slate-950 sm:text-xl">Rate Calendar</h2>
          <p class="mt-0.5 text-sm font-medium text-slate-600">Daily pricing overview for this room type.</p>
        </div>

        <div class="overflow-x-auto">
          <table class="min-w-full divide-x divide-slate-200">
            <thead>
              <tr class="bg-slate-50">
                <% (@start_date..@end_date).each do |date| %>
                  <th class="px-4 py-3 text-center border-e border-slate-200 last:border-e-0">
                    <span class="block text-[10px] font-bold uppercase tracking-[0.1em] <%= date == Date.today ? 'text-slate-900' : 'text-slate-500' %>"><%= date.strftime("%a") %></span>
                    <span class="block text-sm font-bold <%= date == Date.today ? 'text-slate-900' : 'text-slate-700' %>"><%= date.strftime("%d %b") %></span>
                  </th>
                <% end %>
              </tr>
            </thead>
            <tbody class="divide-y divide-slate-200">
              <tr>
                <% (@start_date..@end_date).each do |date| %>
                  <% rate = @rates[date] %>
                  <td class="px-4 py-8 text-center border-e border-slate-200 last:border-e-0 transition-colors hover:bg-slate-50 cursor-pointer group/cell"
                      onclick="document.getElementById('rate-modal-<%= date %>').showModal()">
                    <div class="flex flex-col items-center">
                      <span class="text-[10px] font-bold text-slate-400 uppercase tracking-widest mb-1">RM</span>
                      <span class="text-xl font-bold text-slate-900 group-hover/cell:text-indigo-600 transition-colors">
                        <%= number_with_precision(rate&.price || @room_type.base_price, precision: 0) %>
                      </span>
                      
                      <div class="mt-2">
                        <% unless rate %>
                          <span class="inline-flex items-center rounded-md bg-slate-100 px-2 py-0.5 text-[10px] font-bold text-slate-500 uppercase tracking-wider">Base</span>
                        <% else %>
                          <span class="inline-flex items-center rounded-md bg-emerald-50 px-2 py-0.5 text-[10px] font-bold text-emerald-700 uppercase tracking-wider">Custom</span>
                        <% end %>
                      </div>
                    </div>

                    <!-- Single Day Update Modal -->
                    <dialog id="rate-modal-<%= date %>" class="fixed inset-0 m-auto rounded-3xl p-0 w-[min(92vw,24rem)] shadow-2xl backdrop:bg-slate-900/60 transition-all border-none overflow-hidden" onclick="if(event.target===this){this.close()}">
                      <div class="bg-white">
                        <div class="bg-slate-50 border-b border-slate-100 px-6 py-4 flex items-center justify-between">
                          <div>
                            <h3 class="text-sm font-bold text-slate-900 uppercase tracking-wider">Update Rate</h3>
                            <p class="text-[10px] font-medium text-slate-500"><%= date.strftime("%A, %B %d, %Y") %></p>
                          </div>
                          <button type="button" class="size-8 flex items-center justify-center rounded-full hover:bg-slate-200 text-slate-400 transition" onclick="this.closest('dialog').close()">
                            <svg class="size-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M6 18L18 6M6 6l12 12"/></svg>
                          </button>
                        </div>

                        <div class="p-6">
                          <%= form_with scope: :rate, url: hotel_room_type_rates_path(current_hotel, @room_type, rate_plan_id: @rate_plan.id), local: true, class: "space-y-5" do |f| %>
                            <%= f.hidden_field :start_date, value: date %>
                            <%= f.hidden_field :end_date, value: date %>
                            <%= f.hidden_field :currency, value: 'MYR' %>

                            <div>
                              <label class="block text-[10px] font-bold text-slate-400 uppercase tracking-wider mb-2">New Rate for this day</label>
                              <div class="relative">
                                <div class="absolute inset-y-0 start-0 flex items-center ps-4 pointer-events-none">
                                  <span class="text-sm font-bold text-slate-400">RM</span>
                                </div>
                                <%= f.number_field :price, step: 0.01, value: (rate&.price || @room_type.base_price), class: "w-full rounded-2xl border border-slate-200 bg-white ps-11 pe-4 py-3 text-lg font-black text-slate-900 focus:border-indigo-300 focus:ring-4 focus:ring-indigo-50 focus:outline-none shadow-sm transition-all", required: true, autofocus: true %>
                              </div>
                            </div>

                            <div class="flex flex-col gap-2 pt-2">
                              <%= f.submit "Update Rate", class: "w-full inline-flex items-center justify-center rounded-2xl bg-slate-900 px-4 py-3.5 text-sm font-bold text-white shadow-lg shadow-slate-200 transition hover:bg-slate-800 active:scale-[0.98]" %>
                              <button type="button" class="w-full py-2.5 text-xs font-bold text-slate-500 hover:text-slate-700 transition" onclick="this.closest('dialog').close()">Cancel</button>
                            </div>
                          <% end %>
                        </div>
                      </div>
                    </dialog>
                  </td>
                <% end %>
              </tr>
            </tbody>
          </table>
        </div>
      </div>
    </div>

    <!-- Bulk Update Side Card -->
    <div class="lg:col-span-3">
      <div class="rounded-2xl border border-slate-200 bg-white shadow-md">
        <div class="border-b border-slate-200 bg-slate-50/70 px-5 py-4">
          <h2 class="text-base font-bold tracking-tight text-slate-950">Bulk Update</h2>
          <p class="text-[11px] font-medium text-slate-500">Update rates for a date range.</p>
        </div>
        
        <div class="p-5">
          <%= form_with scope: :rate, url: hotel_room_type_rates_path(current_hotel, @room_type, rate_plan_id: @rate_plan.id), local: true, class: "space-y-4" do |f| %>
            <div class="space-y-3">
              <div>
                <label class="block text-[10px] font-bold text-slate-400 uppercase tracking-wider mb-1.5">Start Date</label>
                <%= f.date_field :start_date, value: @start_date, class: "w-full rounded-xl border border-slate-200 bg-white px-3 py-2 text-sm font-medium text-slate-700 focus:border-slate-300 focus:outline-none focus:ring-0 shadow-sm" %>
              </div>
              <div>
                <label class="block text-[10px] font-bold text-slate-400 uppercase tracking-wider mb-1.5">End Date</label>
                <%= f.date_field :end_date, value: @end_date, class: "w-full rounded-xl border border-slate-200 bg-white px-3 py-2 text-sm font-medium text-slate-700 focus:border-slate-300 focus:outline-none focus:ring-0 shadow-sm" %>
              </div>
            </div>

            <div>
              <label class="block text-[10px] font-bold text-slate-400 uppercase tracking-wider mb-1.5">New Rate (RM)</label>
              <div class="relative">
                <div class="absolute inset-y-0 start-0 flex items-center ps-3 pointer-events-none">
                  <span class="text-xs font-bold text-slate-400">RM</span>
                </div>
                <%= f.number_field :price, step: 0.01, value: @room_type.base_price, class: "w-full rounded-xl border border-slate-200 bg-white ps-10 pe-3 py-2 text-sm font-bold text-slate-900 focus:border-slate-300 focus:outline-none focus:ring-0 shadow-sm", required: true %>
              </div>
            </div>

            <%= f.hidden_field :currency, value: 'MYR' %>

            <div class="pt-1">
              <%= f.submit "Apply Rates", class: "w-full inline-flex items-center justify-center rounded-xl bg-slate-900 px-4 py-2.5 text-sm font-bold text-white shadow-sm transition hover:bg-slate-700" %>
            </div>
          <% end %>
        </div>
      </div>
      
      <div class="mt-4 p-4 rounded-2xl bg-slate-50 border border-slate-200">
        <div class="flex gap-2.5">
          <svg class="size-4 text-slate-400 shrink-0 mt-0.5" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M12 16v-4"/><path d="M12 8h.01"/></svg>
          <div class="min-w-0">
            <h4 class="text-[10px] font-bold text-slate-900 uppercase tracking-wider mb-0.5">Strategy</h4>
            <p class="text-[10px] text-slate-500 leading-relaxed italic">Increase rates during holidays to maximize RevPAR.</p>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
