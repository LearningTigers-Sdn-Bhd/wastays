<%= turbo_frame_tag "offcanvas_drawer", data: { offcanvas_variant: "compact-right" } do %>
  <div class="flex h-full flex-col bg-white">
    <%= render "hotel_portal/bookings/board/partials/content_header",
      title: @room_block.new_record? ? "Block Room" : "Edit Room Block",
      subtitle: "Block #{@room_type.name} Room #{@room_block.room_number} for maintenance",
      icon: cached_icon("wrench", library: "phosphor", variant: "light", class: "size-5") %>

    <%= form_with model: @room_block, 
        url: @room_block.new_record? ? hotel_room_blocks_path(current_hotel) : hotel_room_block_path(current_hotel, @room_block),
        method: @room_block.new_record? ? :post : :patch,
        class: "flex flex-1 flex-col p-8" do |f| %>

      <%= f.hidden_field :room_type_id %>
      <%= f.hidden_field :room_number %>
      <%= hidden_field_tag :start_date, params[:start_date] %>
      <%= hidden_field_tag :days, params[:days] %>
      <%= hidden_field_tag :layout, params[:layout] %>

      <div class="space-y-6">
        <div class="grid grid-cols-2 gap-4">
          <div>
            <label class="block text-[11px] font-bold uppercase tracking-wider text-slate-500 mb-2">Start Date</label>
            <%= f.date_field :start_date, 
                class: "w-full rounded-xl border border-slate-200 bg-white px-4 py-3 text-sm font-medium text-slate-700 focus:border-slate-300 focus:outline-none focus:ring-0 shadow-sm transition-all" %>
          </div>
          <div>
            <label class="block text-[11px] font-bold uppercase tracking-wider text-slate-500 mb-2">End Date</label>
            <%= f.date_field :end_date, 
                class: "w-full rounded-xl border border-slate-200 bg-white px-4 py-3 text-sm font-medium text-slate-700 focus:border-slate-300 focus:outline-none focus:ring-0 shadow-sm transition-all" %>
          </div>
        </div>

        <div>
          <label class="block text-[11px] font-bold uppercase tracking-wider text-slate-500 mb-2">Block Type</label>
          <%= f.text_field :block_type, 
              placeholder: "e.g. Maintenance, Deep Cleaning, Admin Hold",
              class: "w-full rounded-xl border border-slate-200 bg-white px-4 py-3 text-sm font-medium text-slate-700 focus:border-slate-300 focus:outline-none focus:ring-0 shadow-sm transition-all" %>
        </div>

        <div>
          <label class="block text-[11px] font-bold uppercase tracking-wider text-slate-500 mb-2">Reason</label>
          <%= f.text_area :reason, 
              rows: 4, 
              placeholder: "Describe the issue (e.g., Leaky faucet, AC repair, Deep cleaning)",
              class: "w-full rounded-xl border border-slate-200 bg-white px-4 py-3 text-sm font-medium text-slate-700 focus:border-slate-300 focus:outline-none focus:ring-0 shadow-sm transition-all" %>
        </div>
      </div>

      <div class="mt-auto flex items-center justify-between gap-3 pt-6">
        <button type="button" data-action="click->offcanvas#close" class="rounded-xl border border-slate-200 bg-white px-6 py-3 text-sm font-bold text-slate-700 hover:bg-slate-50 transition-all active:scale-95">Cancel</button>
        <%= f.submit @room_block.new_record? ? "Block Room" : "Update Block", 
            class: "rounded-xl bg-slate-900 px-6 py-3 text-sm font-bold text-white shadow-lg shadow-slate-900/10 hover:bg-slate-800 transition-all active:scale-95" %>
      </div>
    <% end %>
  </div>
<% end %>
