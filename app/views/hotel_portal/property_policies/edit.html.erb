<div class="w-full">
  <div class="mb-5">
    <%= link_to hotel_dashboard_path, class: "inline-flex items-center gap-x-1.5 text-sm text-muted-foreground hover:text-blue-600" do %>
      <svg class="flex-shrink-0 size-4" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg>
      Back to Dashboard
    <% end %>
  </div>

  <div class="bg-card border border-border rounded-xl shadow-sm p-4 sm:p-7">
    <div class="mb-8">
      <h2 class="text-2xl font-bold text-foreground">Hotel Policies</h2>
      <p class="text-sm text-muted-foreground">Define your standard check-in and check-out times.</p>
    </div>

    <%= form_with model: @property_policy, url: hotel_property_policy_path, method: :patch, local: true do |f| %>
      <div class="grid gap-y-6">
        <div class="grid grid-cols-2 gap-4">
          <div>
            <%= f.label :check_in_time, "Standard Check-in Time", class: "block text-sm mb-2 font-medium" %>
            <%= f.time_field :check_in_time, class: "py-3 px-4 block w-full border border-border rounded-lg text-sm focus:border-blue-500 focus:ring-blue-500", required: true %>
          </div>
          <div>
            <%= f.label :check_out_time, "Standard Check-out Time", class: "block text-sm mb-2 font-medium" %>
            <%= f.time_field :check_out_time, class: "py-3 px-4 block w-full border border-border rounded-lg text-sm focus:border-blue-500 focus:ring-blue-500", required: true %>
          </div>
        </div>

        <div class="bg-muted border border-border rounded-lg p-4">
          <h4 class="text-sm font-semibold text-foreground mb-1">Cancellation Policy</h4>
          <p class="text-xs text-muted-foreground">
            Cancellation charges, refund terms and any notes for guests are set under
            Commercial → Room Revenue → Reservation policies, where the fee schedule is
            what the system actually charges.
          </p>
        </div>

        <div class="mt-5">
          <%= f.submit "Save Policies", class: "w-full py-3 px-4 inline-flex justify-center items-center gap-x-2 text-sm font-semibold rounded-lg border border-transparent bg-blue-600 text-primary-foreground hover:bg-blue-700 disabled:opacity-50 disabled:pointer-events-none" %>
        </div>
      </div>
    <% end %>
  </div>
</div>
