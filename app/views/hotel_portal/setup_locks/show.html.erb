<div class="w-full">
  <div class="rounded-2xl border border-border bg-card p-8 text-center shadow-sm sm:p-10">
    <div class="mx-auto mb-6 flex h-14 w-14 items-center justify-center rounded-full bg-muted text-muted-foreground">
      <%= app_icon "settings-2", class: "size-7", aria: { hidden: true } %>
    </div>

    <h1 class="text-3xl font-bold text-foreground"><%= current_hotel.name %> is still being set up</h1>
    <p class="mt-3 text-sm text-muted-foreground">
      <% if current_hotel.status == "pending_review" %>
        The setup has been submitted and WAStays is reviewing it. The rest of the hotel system opens once the property is approved.
      <% else %>
        The property owner is working through onboarding. The rest of the hotel system opens once WAStays has reviewed and approved the setup.
      <% end %>
    </p>
    <p class="mt-2 text-sm text-muted-foreground">
      You do not need to do anything. We will let you know when your account is ready.
    </p>

    <div class="mt-8">
      <%= render PanelsUI::Button.new(href: edit_hotel_user_profile_path(current_hotel), variant: :outline) do %>
        Manage your profile
      <% end %>
    </div>
  </div>
</div>
