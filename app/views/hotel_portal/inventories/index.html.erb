<% content_for :breadcrumbs do %>
  <div class="flex items-center gap-x-2">
    <span class="text-sm font-medium text-slate-600"><%= current_hotel.name %></span>
    <span class="text-sm text-slate-400">/</span>
    <%= link_to "Room Categories", hotel_room_types_path(current_hotel), class: "text-sm font-medium text-slate-600 hover:text-slate-900" %>
    <span class="text-sm text-slate-400">/</span>
    <span class="text-sm font-semibold text-slate-900">Inventory</span>
  </div>
<% end %>

<div class="max-w-[1600px] mx-auto pb-20 space-y-8">
  <div class="px-4 md:px-0">
    <div class="mt-5 flex flex-col md:flex-row md:items-end md:justify-between gap-4">
      <div>
        <h1 class="text-2xl font-bold tracking-tight text-slate-950 sm:text-3xl">Manage Inventory</h1>
        <p class="mt-1 text-sm font-medium text-slate-600">Allotment for <span class="font-bold text-slate-900"><%= @room_type.name %></span></p>
      </div>

      <div class="flex items-center gap-2">
        <div class="inline-flex bg-slate-100 rounded-xl p-1 shadow-sm border border-slate-200">
          <%= link_to hotel_room_type_inventories_path(current_hotel, @room_type, start_date: @start_date - 14.days), 
              class: "p-1.5 hover:bg-white hover:shadow-sm rounded-lg transition text-slate-500 hover:text-slate-900" do %>
            <svg class="size-4" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg>
          <% end %>
          <span class="px-4 flex items-center text-xs font-bold text-slate-700 uppercase tracking-wider">
            <%= @start_date.strftime("%b %d") %> - <%= @end_date.strftime("%b %d") %>
          </span>
          <%= link_to hotel_room_type_inventories_path(current_hotel, @room_type, start_date: @start_date + 14.days), 
              class: "p-1.5 hover:bg-white hover:shadow-sm rounded-lg transition text-slate-500 hover:text-slate-900" do %>
            <svg class="size-4" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg>
          <% end %>
        </div>
      </div>
    </div>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-12 gap-8">
    <!-- Inventory Calendar Card -->
    <div class="lg:col-span-8">
      <div class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">
        <div class="border-b border-slate-200 px-6 py-5 sm:px-8">
          <h2 class="text-lg font-bold tracking-tight text-slate-950 sm:text-xl">Inventory Calendar</h2>
          <p class="mt-1 text-sm font-medium text-slate-600">Daily room availability for this room type.</p>
        </div>

        <div class="overflow-x-auto">
          <table class="min-w-full divide-x divide-slate-200">
            <thead>
              <tr class="bg-slate-50">
                <% (@start_date..@end_date).each do |date| %>
                  <th class="px-4 py-4 text-center border-e border-slate-200 last:border-e-0">
                    <span class="block text-[10px] font-bold uppercase tracking-[0.1em] <%= date == Date.today ? 'text-slate-900' : 'text-slate-500' %>"><%= date.strftime("%a") %></span>
                    <span class="block text-sm font-bold <%= date == Date.today ? 'text-slate-900' : 'text-slate-700' %>"><%= date.strftime("%d %b") %></span>
                  </th>
                <% end %>
              </tr>
            </thead>
            <tbody class="divide-y divide-slate-200">
              <tr>
                <% (@start_date..@end_date).each do |date| %>
                  <% inventory = @inventories[date] %>
                  <% quantity = inventory&.quantity || @room_type.quantity %>
                  <% status = inventory&.status || 'open' %>
                  
                  <td class="px-4 py-10 text-center border-e border-slate-200 last:border-e-0 transition-colors hover:bg-slate-50">
                    <div class="flex flex-col items-center">
                      <span class="text-2xl font-bold <%= (status == 'closed' || quantity == 0) ? 'text-red-600' : 'text-slate-900' %>">
                        <%= quantity %>
                      </span>
                      
                      <div class="mt-3">
                        <% if status == 'open' && quantity > 0 %>
                          <span class="inline-flex items-center rounded-md bg-emerald-50 px-2 py-0.5 text-[10px] font-bold text-emerald-700 uppercase tracking-wider">Open</span>
                        <% else %>
                          <span class="inline-flex items-center rounded-md bg-red-50 px-2 py-0.5 text-[10px] font-bold text-red-700 uppercase tracking-wider"><%= status == 'closed' ? 'Closed' : 'Sold Out' %></span>
                        <% end %>
                      </div>
                      
                      <% unless inventory %>
                        <div class="mt-2">
                          <span class="text-[9px] font-bold text-slate-400 uppercase tracking-widest px-1.5 py-0.5 rounded bg-slate-100">Default</span>
                        </div>
                      <% end %>
                    </div>
                  </td>
                <% end %>
              </tr>
            </tbody>
          </table>
        </div>
      </div>
      
      <div class="mt-4 flex items-center gap-x-6 px-2">
        <div class="flex items-center gap-x-2">
          <div class="size-2 rounded-full bg-emerald-500"></div>
          <span class="text-[10px] font-bold text-slate-500 uppercase tracking-wider">Available</span>
        </div>
        <div class="flex items-center gap-x-2">
          <div class="size-2 rounded-full bg-red-500"></div>
          <span class="text-[10px] font-bold text-slate-500 uppercase tracking-wider">Closed / No Inventory</span>
        </div>
      </div>
    </div>

    <!-- Bulk Update Side Card -->
    <div class="lg:col-span-4">
      <div class="rounded-2xl border border-slate-200 bg-white shadow-lg">
        <div class="border-b border-slate-200 bg-slate-50/70 px-6 py-5 sm:px-8">
          <h2 class="text-lg font-bold tracking-tight text-slate-950">Bulk Update</h2>
          <p class="mt-1 text-sm font-medium text-slate-600">Update allotments for a date range.</p>
        </div>
        
        <div class="p-6 sm:p-8">
          <%= form_with scope: :inventory, url: hotel_room_type_inventories_path(current_hotel, @room_type), local: true, class: "space-y-6" do |f| %>
            <div class="grid grid-cols-2 gap-4">
              <div>
                <label class="block text-[11px] font-bold text-slate-500 uppercase tracking-wider mb-2">Start Date</label>
                <%= f.date_field :start_date, value: @start_date, class: "w-full rounded-xl border border-slate-200 bg-white px-4 py-2.5 text-sm font-medium text-slate-700 focus:border-slate-300 focus:outline-none focus:ring-0 shadow-sm" %>
              </div>
              <div>
                <label class="block text-[11px] font-bold text-slate-500 uppercase tracking-wider mb-2">End Date</label>
                <%= f.date_field :end_date, value: @end_date, class: "w-full rounded-xl border border-slate-200 bg-white px-4 py-2.5 text-sm font-medium text-slate-700 focus:border-slate-300 focus:outline-none focus:ring-0 shadow-sm" %>
              </div>
            </div>

            <div>
              <label class="block text-[11px] font-bold text-slate-500 uppercase tracking-wider mb-2">Units to Allot</label>
              <%= f.number_field :quantity, value: @room_type.quantity, min: 0, class: "w-full rounded-xl border border-slate-200 bg-white px-4 py-2.5 text-sm font-bold text-slate-900 focus:border-slate-300 focus:outline-none focus:ring-0 shadow-sm" %>
              <p class="mt-2 text-[11px] text-slate-500 italic">Total available for these dates.</p>
            </div>

            <div>
              <label class="block text-[11px] font-bold text-slate-500 uppercase tracking-wider mb-2">Availability Status</label>
              <%= f.select :status, [['Open for Bookings', 'open'], ['Closed / Blocked', 'closed']], {}, class: "w-full rounded-xl border border-slate-200 bg-white px-4 py-2.5 text-sm font-medium text-slate-700 focus:border-slate-300 focus:outline-none focus:ring-0 shadow-sm" %>
            </div>

            <div class="pt-2">
              <%= f.submit "Update Inventory", class: "w-full inline-flex items-center justify-center rounded-xl bg-slate-900 px-4 py-3.5 text-sm font-bold text-white shadow-md transition hover:bg-slate-700" %>
            </div>
          <% end %>
        </div>
      </div>
      
      <div class="mt-6 p-5 rounded-2xl bg-slate-50 border border-slate-200">
        <div class="flex gap-3">
          <svg class="size-5 text-slate-400 shrink-0" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M12 16v-4"/><path d="M12 8h.01"/></svg>
          <div class="min-w-0">
            <h4 class="text-[11px] font-bold text-slate-900 uppercase tracking-wider mb-1">Inventory Control</h4>
            <p class="text-xs text-slate-600 leading-relaxed">Inventory updates are instant. Closing inventory will immediately block bookings for the selected range.</p>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
