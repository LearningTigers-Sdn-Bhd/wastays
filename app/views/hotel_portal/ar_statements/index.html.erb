<div class="w-full space-y-3.5">
  <%= form_with url: hotel_ar_statements_path(current_hotel),
                method: :get,
                class: "",
                data: { controller: "auto-submit", turbo_frame: "ar_statements_results", turbo_action: "advance" } do |form| %>
    <div class="relative">
      <div class="pointer-events-none absolute inset-y-0 left-0 flex items-center pl-3">
        <%= cached_icon "search", stroke_width: 2, class: "size-4 text-muted-foreground" %>
      </div>
      <%= form.text_field :query,
        value: @presenter.query,
        placeholder: "Search corporate account or contact email...",
        class: "block w-full rounded-lg border border-border bg-card py-2.5 pl-10 pr-3 text-sm shadow-sm transition placeholder:text-muted-foreground focus:border-border-interactive focus:outline-none focus:ring-1 focus:ring-ring/10",
        data: { action: "input->auto-submit#submit" } %>
    </div>
  <% end %>

  <%= turbo_frame_tag "ar_statements_results" do %>
    <div class="hidden overflow-x-auto rounded-xl border border-border bg-card shadow-sm lg:block">
      <table class="min-w-[1100px] w-full">
        <thead class="border-b border-border bg-muted/70">
          <tr>
            <th class="px-6 py-3 text-left text-[10px] font-bold uppercase tracking-widest text-muted-foreground">Corporate Account</th>
            <th class="px-6 py-3 text-left text-[10px] font-bold uppercase tracking-widest text-muted-foreground">Contact</th>
            <th class="px-6 py-3 text-left text-[10px] font-bold uppercase tracking-widest text-muted-foreground">Terms</th>
            <th class="px-6 py-3 text-left text-[10px] font-bold uppercase tracking-widest text-muted-foreground">Last AR Activity</th>
            <th class="px-6 py-3 text-right text-[10px] font-bold uppercase tracking-widest text-muted-foreground">Account Balance</th>
            <th class="px-6 py-3 text-right text-[10px] font-bold uppercase tracking-widest text-muted-foreground">Unapplied Credit</th>
            <th class="px-6 py-3 text-right text-[10px] font-bold uppercase tracking-widest text-muted-foreground">Action</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-border">
          <% if @presenter.rows.any? %>
            <% @presenter.rows.each do |row| %>
              <tr class="transition hover:bg-muted/70" data-testid="ar-statement-row-<%= row.relationship.id %>">
                <td class="px-6 py-4 text-sm font-bold text-foreground"><%= row.corporate_account_name %></td>
                <td class="px-6 py-4 text-sm text-muted-foreground"><%= row.contact_email %></td>
                <td class="px-6 py-4 text-sm font-semibold text-foreground"><%= row.payment_terms %></td>
                <td class="px-6 py-4 text-sm text-muted-foreground"><%= row.last_activity %></td>
                <td class="px-6 py-4 text-right text-sm font-bold tabular-nums text-foreground">
                  <% row.balance_labels.each do |amount| %><div><%= amount %></div><% end %>
                </td>
                <td class="px-6 py-4 text-right text-sm font-semibold tabular-nums text-emerald-700">
                  <% row.unapplied_labels.each do |amount| %><div><%= amount %></div><% end %>
                </td>
                <td class="px-6 py-4 text-right">
                  <%= link_to "View", hotel_ar_statement_path(current_hotel, row.relationship), class: "inline-flex items-center rounded-lg bg-primary px-3 py-2 text-xs font-bold text-primary-foreground transition hover:bg-primary-hover", data: { turbo_frame: "_top" } %>
                </td>
              </tr>
            <% end %>
          <% else %>
            <tr>
              <td colspan="7" class="px-6 py-16 text-center">
                <p class="text-sm font-semibold text-foreground">No corporate accounts found</p>
                <p class="mt-1 text-xs text-muted-foreground">Try another account name or contact email.</p>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>

    <div class="space-y-3  lg:hidden">
      <% if @presenter.rows.any? %>
        <% @presenter.rows.each do |row| %>
          <article class="rounded-xl border border-border bg-card p-4 shadow-sm" data-testid="ar-statement-card-<%= row.relationship.id %>">
            <div class="flex items-start justify-between gap-3">
              <div class="min-w-0">
                <p class="truncate text-sm font-black text-foreground"><%= row.corporate_account_name %></p>
                <p class="mt-1 truncate text-xs text-muted-foreground"><%= row.contact_email %></p>
              </div>
              <%= link_to "View", hotel_ar_statement_path(current_hotel, row.relationship), class: "shrink-0 rounded-lg bg-primary px-3 py-2 text-xs font-bold text-primary-foreground", data: { turbo_frame: "_top" } %>
            </div>
            <div class="mt-4 grid grid-cols-2 gap-4 border-t border-border pt-4">
              <div>
                <p class="text-[10px] font-bold uppercase tracking-widest text-muted-foreground">Balance</p>
                <% row.balance_labels.each do |amount| %><p class="mt-1 text-xs font-bold tabular-nums text-foreground"><%= amount %></p><% end %>
              </div>
              <div class="text-right">
                <p class="text-[10px] font-bold uppercase tracking-widest text-muted-foreground">Unapplied</p>
                <% row.unapplied_labels.each do |amount| %><p class="mt-1 text-xs font-bold tabular-nums text-emerald-700"><%= amount %></p><% end %>
              </div>
            </div>
            <div class="mt-4 flex items-center justify-between text-xs text-muted-foreground">
              <span><%= row.payment_terms %></span>
              <span><%= row.last_activity %></span>
            </div>
          </article>
        <% end %>
      <% else %>
        <div class="rounded-xl border border-dashed border-border bg-card p-8 text-center">
          <p class="text-sm font-semibold text-foreground">No corporate accounts found</p>
          <p class="mt-1 text-xs text-muted-foreground">Try another account name or contact email.</p>
        </div>
      <% end %>
    </div>

    <% if @presenter.pagination.total_pages > 1 %>
      <div class="mt-6 flex justify-center">
        <%= paginate @presenter.pagination, params: @presenter.pagination_params %>
      </div>
    <% end %>
  <% end %>
</div>
