<%# app/views/hotel_portal/shared/offcanvas/_content_header.html.erb %>
<div class="px-6 py-4 bg-card border-b border-border shrink-0">
  <div class="max-w-[1000px] mx-auto flex items-center justify-between">
    <div class="flex items-center gap-4">
      <div class="size-11 rounded-xl bg-muted border border-border flex items-center justify-center text-foreground shadow-sm">
        <%= icon.html_safe %>
      </div>
      <div>
        <div class="flex items-center gap-2">
          <h3 class="text-lg font-black tracking-tight text-foreground uppercase"><%= title %></h3>
          <% if local_assigns[:status_badge] %>
            <%= status_badge %>
          <% end %>
        </div>
        <p class="text-[10px] font-bold text-muted-foreground uppercase tracking-widest"><%= subtitle %></p>
      </div>
    </div>
    <div class="flex items-center gap-3">
      <% if local_assigns[:actions] %>
        <%= actions %>
      <% end %>

      <button type="button" data-action="click->offcanvas#close" class="p-2 rounded-xl text-muted-foreground hover:bg-muted hover:text-muted-foreground transition-all">
        <%= cached_icon "x", stroke_width: 2.5, class: "size-5" %>
      </button>
    </div>
  </div>
</div>
