<div class="w-full">
  <div class="mx-auto max-w-2xl space-y-10">
    <%= render PanelsUI::PageHeader.new(
          title: "My Profile",
          description: "Update your account information and password.") %>

    <div class="bg-card border border-border rounded-xl shadow-sm overflow-hidden p-6">
      <%= form_with model: @user, url: hotel_user_profile_path, local: true, class: "space-y-6" do |f| %>
        <% if @user.errors.any? %>
          <div class="p-4 rounded-lg bg-red-50 text-red-600 border border-red-200">
            <h2 class="text-sm font-bold mb-2"><%= pluralize(@user.errors.count, "error") %> prohibited this profile from being saved:</h2>
            <ul class="list-disc list-inside text-xs">
              <% @user.errors.full_messages.each do |message| %>
                <li><%= message %></li>
              <% end %>
            </ul>
          </div>
        <% end %>

        <div>
          <label class="block text-sm font-medium mb-2 text-foreground">Name</label>
          <%= f.text_field :name, class: "py-3 px-4 block w-full border-border rounded-lg text-sm focus:border-blue-500 focus:ring-blue-500 border" %>
        </div>

        <div>
          <label class="block text-sm font-medium mb-2 text-foreground">Email Address</label>
          <%= f.email_field :email, class: "py-3 px-4 block w-full border-border rounded-lg text-sm focus:border-blue-500 focus:ring-blue-500 border" %>
        </div>

        <div>
          <label class="block text-sm font-medium mb-2 text-foreground">Timezone</label>
          <%= f.time_zone_select :time_zone, ActiveSupport::TimeZone.all, { default: User::DEFAULT_TIME_ZONE }, { class: "py-3 px-4 block w-full border-border rounded-lg text-sm focus:border-blue-500 focus:ring-blue-500 border" } %>
          <p class="mt-1 text-xs text-muted-foreground">Default timezone is UTC+8 (<%= User::DEFAULT_TIME_ZONE %>).</p>
        </div>

        <div class="pt-6 border-t border-border">
          <h3 class="text-sm font-bold text-foreground uppercase tracking-wider mb-4">Change Password</h3>
          <p class="text-xs text-muted-foreground mb-4">Leave blank if you don't want to change your password.</p>

          <div class="grid sm:grid-cols-2 gap-4">
            <div>
              <label class="block text-sm font-medium mb-2 text-foreground">New Password</label>
              <%= f.password_field :password, class: "py-3 px-4 block w-full border-border rounded-lg text-sm focus:border-blue-500 focus:ring-blue-500 border" %>
            </div>
            <div>
              <label class="block text-sm font-medium mb-2 text-foreground">Confirm Password</label>
              <%= f.password_field :password_confirmation, class: "py-3 px-4 block w-full border-border rounded-lg text-sm focus:border-blue-500 focus:ring-blue-500 border" %>
            </div>
          </div>
        </div>

        <div class="flex justify-end pt-4 border-t border-border">
          <%= f.submit "Save Changes", class: "py-2 px-4 inline-flex items-center gap-x-2 text-sm font-semibold rounded-lg border border-transparent bg-blue-600 text-primary-foreground hover:bg-blue-700 transition" %>
        </div>
      <% end %>
    </div>
  </div>
</div>
