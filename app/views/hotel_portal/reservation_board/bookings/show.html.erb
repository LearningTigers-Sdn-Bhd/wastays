<%= turbo_frame_tag "reservation_board_modal_content" do %>
  <div class="bg-white">
    <!-- Modal Header -->
    <div class="px-6 py-4 border-b border-slate-100 flex items-center justify-between sticky top-0 bg-white z-10">
      <div class="flex items-center gap-3">
        <div class="size-10 rounded-xl bg-slate-50 flex items-center justify-center text-slate-900">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
        </div>
        <div>
          <h3 class="text-base font-bold text-slate-900">Booking <%= @booking.confirmation_token %></h3>
          <p class="text-[10px] font-bold text-slate-500 uppercase tracking-widest"><%= @booking.status.tr('_', ' ') %></p>
        </div>
      </div>
      <button onclick="this.closest('dialog').close()" class="p-2 rounded-lg hover:bg-slate-50 text-slate-400 transition-colors">
        <svg class="size-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" /></svg>
      </button>
    </div>

    <div class="p-6 space-y-8 max-h-[70vh] overflow-y-auto">
      <!-- Quick Actions -->
      <div class="flex flex-wrap gap-2">
        <% if @booking.status == 'confirmed' %>
          <%= button_to check_in_hotel_booking_path(current_hotel, @booking), method: :post, 
              class: "flex-1 inline-flex items-center justify-center rounded-xl bg-slate-900 px-4 py-2.5 text-xs font-bold text-white shadow-sm transition hover:bg-slate-700",
              data: { turbo_confirm: "Confirm Check-In for #{@booking.guest_name}?" } do %>
            Confirm Check-In
          <% end %>
          <%= button_to cancel_hotel_booking_path(current_hotel, @booking), method: :post, 
              class: "inline-flex items-center rounded-xl border border-red-200 bg-red-50 px-4 py-2.5 text-xs font-bold text-red-600 transition hover:bg-red-100",
              data: { turbo_confirm: "Are you sure you want to cancel this booking?" } do %>
            Cancel
          <% end %>
        <% elsif @booking.status == 'checked_in' %>
          <%= button_to check_out_hotel_booking_path(current_hotel, @booking), method: :post, 
              class: "flex-1 inline-flex items-center justify-center rounded-xl bg-emerald-600 px-4 py-2.5 text-xs font-bold text-white shadow-sm transition hover:bg-emerald-700",
              data: { turbo_confirm: "Confirm Check-Out for #{@booking.guest_name}?" } do %>
            Confirm Check-Out
          <% end %>
        <% end %>
      </div>

      <!-- Guest Details -->
      <div class="space-y-4">
        <h4 class="text-[11px] font-black uppercase tracking-[0.15em] text-slate-400">Guest Information</h4>
        <div class="grid grid-cols-2 gap-4">
          <div class="col-span-2 p-4 rounded-xl bg-slate-50 border border-slate-100">
            <p class="text-[10px] font-bold text-slate-400 uppercase mb-1">Full Name</p>
            <p class="text-sm font-bold text-slate-900"><%= @booking.guest_name %></p>
          </div>
          <div class="p-4 rounded-xl bg-slate-50 border border-slate-100">
            <p class="text-[10px] font-bold text-slate-400 uppercase mb-1">Email</p>
            <p class="text-xs font-semibold text-slate-700 truncate"><%= @booking.guest_email %></p>
          </div>
          <div class="p-4 rounded-xl bg-slate-50 border border-slate-100">
            <p class="text-[10px] font-bold text-slate-400 uppercase mb-1">Phone</p>
            <p class="text-xs font-semibold text-slate-700"><%= @booking.guest_phone %></p>
          </div>
        </div>
      </div>

      <!-- Stay Details -->
      <div class="space-y-4">
        <h4 class="text-[11px] font-black uppercase tracking-[0.15em] text-slate-400">Stay & Room</h4>
        <div class="p-4 rounded-xl border border-slate-200 space-y-4">
          <div class="grid grid-cols-2 gap-4">
            <div>
              <p class="text-[10px] font-bold text-slate-400 uppercase mb-1">Check-In</p>
              <p class="text-sm font-bold text-slate-900"><%= @booking.check_in.strftime("%b %d, %Y") %></p>
            </div>
            <div>
              <p class="text-[10px] font-bold text-slate-400 uppercase mb-1">Check-Out</p>
              <p class="text-sm font-bold text-slate-900"><%= @booking.check_out.strftime("%b %d, %Y") %></p>
            </div>
          </div>
          <div class="pt-4 border-t border-slate-100 flex items-center justify-between">
            <div>
              <p class="text-[10px] font-bold text-slate-400 uppercase mb-1">Room Category</p>
              <p class="text-xs font-bold text-slate-900"><%= @booking.booking_rooms.first&.room_type&.name %></p>
            </div>
            <div class="text-right">
              <p class="text-[10px] font-bold text-slate-400 uppercase mb-1">Room No.</p>
              <p class="text-xs font-black text-emerald-600">ROOM <%= @booking.booking_rooms.first&.room_number %></p>
            </div>
          </div>
        </div>
      </div>

      <!-- Financials -->
      <div class="space-y-4">
        <h4 class="text-[11px] font-black uppercase tracking-[0.15em] text-slate-400">Payment Summary</h4>
        <div class="p-4 rounded-xl bg-slate-900 text-white flex items-center justify-between">
          <div>
            <p class="text-[10px] font-bold text-slate-400 uppercase tracking-widest">Total Paid</p>
            <p class="text-lg font-black mt-1">MYR <%= number_with_precision(@booking.total_amount, precision: 2) %></p>
          </div>
          <span class="inline-flex items-center rounded-full bg-white/10 px-2.5 py-1 text-[10px] font-bold uppercase tracking-wider text-white">
            <%= @booking.payment_status.tr('_', ' ') %>
          </span>
        </div>
      </div>

      <!-- Notes if any -->
      <% if @booking.booking_notes.any? %>
        <div class="space-y-4">
          <h4 class="text-[11px] font-black uppercase tracking-[0.15em] text-slate-400">Internal Notes</h4>
          <div class="space-y-2">
            <% @booking.booking_notes.each do |note| %>
              <div class="p-3 rounded-lg bg-slate-50 border border-slate-100">
                <p class="text-xs text-slate-600 italic">"<%= note.body %>"</p>
                <p class="text-[9px] font-bold text-slate-400 mt-2">— <%= note.user&.name || "System" %></p>
              </div>
            <% end %>
          </div>
        </div>
      <% end %>
    </div>

    <!-- Modal Footer -->
    <div class="px-6 py-4 bg-slate-50 border-t border-slate-100 flex items-center justify-between">
      <%= link_to hotel_booking_path(current_hotel, @booking), class: "text-xs font-bold text-slate-500 hover:text-slate-900 transition-colors flex items-center gap-2", data: { turbo: false } do %>
        <svg class="size-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M13.5 6H5.25A2.25 2.25 0 003 8.25v10.5A2.25 2.25 0 005.25 21h10.5A2.25 2.25 0 0018 18.75V10.5m-10.5 6L21 3m0 0h-5.25M21 3v5.25" /></svg>
        Full Booking Page
      <% end %>
      <button onclick="this.closest('dialog').close()" class="px-4 py-2 bg-white border border-slate-200 rounded-xl text-sm font-bold text-slate-700 hover:bg-slate-50 transition-colors shadow-sm">Close</button>
    </div>
  </div>
<% end %>

