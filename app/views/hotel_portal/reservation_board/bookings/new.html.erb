<%= turbo_frame_tag "reservation_board_modal_content" do %>
  <div class="bg-white">
    <!-- Modal Header -->
    <div class="px-6 py-4 border-b border-slate-100 flex items-center justify-between sticky top-0 bg-white z-10">
      <div class="flex items-center gap-3">
        <div class="size-10 rounded-xl bg-slate-50 flex items-center justify-center text-slate-900">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 5v14M5 12h14"/></svg>
        </div>
        <div>
          <h3 class="text-base font-bold text-slate-900">New Booking</h3>
          <p class="text-[10px] font-bold text-slate-500 uppercase tracking-widest">Manual Reservation</p>
        </div>
      </div>
      <button onclick="this.closest('dialog').close()" class="p-2 rounded-lg hover:bg-slate-50 text-slate-400 transition-colors">
        <svg class="size-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" /></svg>
      </button>
    </div>

    <%= form_with model: @booking, url: hotel_reservation_board_bookings_path(current_hotel), local: true, 
        class: "flex flex-col", 
        data: { 
          controller: "booking-calc room-lock", 
          room_lock_url_value: hotel_room_locks_path(current_hotel),
          booking_calc_availability_url_value: availability_hotel_bookings_path(current_hotel),
          booking_calc_price_url_value: stay_price_hotel_bookings_path(current_hotel)
        } do |f| %>
      
      <div class="p-6 space-y-8 max-h-[70vh] overflow-y-auto">
        <% if @booking.errors.any? %>
          <div class="p-4 rounded-xl bg-red-50 border border-red-100 mb-6">
            <h4 class="text-xs font-bold text-red-800 mb-1">Please fix the following:</h4>
            <ul class="text-[11px] text-red-700 list-disc list-inside">
              <% @booking.errors.full_messages.each do |msg| %>
                <li><%= msg %></li>
              <% end %>
            </ul>
          </div>
        <% end %>

        <!-- Guest Information -->
        <div class="space-y-4">
          <h4 class="text-[11px] font-black uppercase tracking-[0.15em] text-slate-400">Guest Information</h4>
          <div class="space-y-4">
            <div>
              <%= f.label :guest_name, "Full Name", class: "block text-[10px] font-bold text-slate-500 uppercase tracking-wider mb-1.5" %>
              <%= f.text_field :guest_name, required: true, placeholder: "John Doe", class: "w-full rounded-xl border border-slate-200 bg-white px-4 py-2 text-sm font-medium text-slate-700 focus:border-slate-300 focus:outline-none focus:ring-0 shadow-sm" %>
            </div>
            <div class="grid grid-cols-2 gap-4">
              <div>
                <%= f.label :guest_email, "Email", class: "block text-[10px] font-bold text-slate-500 uppercase tracking-wider mb-1.5" %>
                <%= f.email_field :guest_email, required: true, placeholder: "john@example.com", class: "w-full rounded-xl border border-slate-200 bg-white px-4 py-2 text-sm font-medium text-slate-700 focus:border-slate-300 focus:outline-none focus:ring-0 shadow-sm" %>
              </div>
              <div>
                <%= f.label :guest_phone, "Phone", class: "block text-[10px] font-bold text-slate-500 uppercase tracking-wider mb-1.5" %>
                <%= f.telephone_field :guest_phone, required: true, placeholder: "+60 12-345 6789", class: "w-full rounded-xl border border-slate-200 bg-white px-4 py-2 text-sm font-medium text-slate-700 focus:border-slate-300 focus:outline-none focus:ring-0 shadow-sm" %>
              </div>
            </div>
          </div>
        </div>

        <!-- Stay Details -->
        <div class="space-y-4">
          <h4 class="text-[11px] font-black uppercase tracking-[0.15em] text-slate-400">Stay Details</h4>
          <div class="p-4 rounded-xl border border-slate-100 bg-slate-50/50 space-y-4">
            <div class="grid grid-cols-2 gap-4">
              <div>
                <%= f.label :check_in, "Check-in", class: "block text-[10px] font-bold text-slate-500 uppercase tracking-wider mb-1.5" %>
                <%= f.date_field :check_in, required: true, class: "w-full rounded-xl border border-slate-200 bg-white px-4 py-2 text-sm font-medium text-slate-700 focus:border-slate-300 focus:outline-none focus:ring-0 shadow-sm", data: { booking_calc_target: "checkIn", action: "change->booking-calc#calculate" } %>
              </div>
              <div>
                <%= f.label :check_out, "Check-out", class: "block text-[10px] font-bold text-slate-500 uppercase tracking-wider mb-1.5" %>
                <%= f.date_field :check_out, required: true, class: "w-full rounded-xl border border-slate-200 bg-white px-4 py-2 text-sm font-medium text-slate-700 focus:border-slate-300 focus:outline-none focus:ring-0 shadow-sm", data: { booking_calc_target: "checkOut", action: "change->booking-calc#calculate" } %>
              </div>
            </div>

            <div class="grid grid-cols-2 gap-4">
              <div>
                <%= f.label :adults, class: "block text-[10px] font-bold text-slate-500 uppercase tracking-wider mb-1.5" %>
                <%= f.number_field :adults, required: true, min: 1, class: "w-full rounded-xl border border-slate-200 bg-white px-4 py-2 text-sm font-medium text-slate-700 focus:border-slate-300 focus:outline-none focus:ring-0 shadow-sm" %>
              </div>
              <div>
                <%= f.label :children, class: "block text-[10px] font-bold text-slate-500 uppercase tracking-wider mb-1.5" %>
                <%= f.number_field :children, required: true, min: 0, class: "w-full rounded-xl border border-slate-200 bg-white px-4 py-2 text-sm font-medium text-slate-700 focus:border-slate-300 focus:outline-none focus:ring-0 shadow-sm" %>
              </div>
            </div>

            <div class="pt-4 border-t border-slate-200/60 space-y-4">
              <div>
                <label class="block text-[10px] font-bold text-slate-500 uppercase tracking-wider mb-1.5">Category</label>
                <%= f.collection_select :room_type_id, @room_types, :id, :name, { selected: @room_type_id, prompt: "Select category" }, 
                    { class: "w-full rounded-xl border border-slate-200 bg-white px-4 py-2 text-sm font-medium text-slate-700 focus:border-slate-300 focus:outline-none focus:ring-0 shadow-sm", 
                      data: { 
                        booking_calc_target: "roomType", 
                        action: "change->booking-calc#updateRoomNumbers change->booking-calc#calculate", 
                        prices: @room_types.map { |rt| [rt.id, rt.base_price] }.to_h.to_json,
                        room_numbers: @room_types.map { |rt| [rt.id, rt.room_numbers] }.to_h.to_json
                      } 
                    } %>
              </div>
              <div class="<%= @room_number.present? ? '' : 'hidden' %>" data-booking-calc-target="roomNumberContainer">
                <label for="booking_room_number" class="block text-[10px] font-bold text-slate-500 uppercase tracking-wider mb-1.5">Room Number</label>
                <%= f.select :room_number, (@room_number.present? ? [[@room_number, @room_number]] : []), { selected: @room_number, prompt: "Select room" }, 
                    { id: "booking_room_number",
                      required: true,
                      class: "w-full rounded-xl border border-slate-200 bg-white px-4 py-2 text-sm font-medium text-slate-700 focus:border-slate-300 focus:outline-none focus:ring-0 shadow-sm", 
                      data: { 
                        booking_calc_target: "roomNumberSelect",
                        action: "change->room-lock#lock"
                      } 
                    } %>
              </div>
            </div>
          </div>
        </div>

        <!-- Pricing Summary -->
        <div class="space-y-4 pb-4">
          <h4 class="text-[11px] font-black uppercase tracking-[0.15em] text-slate-400">Payment Summary</h4>
          <div class="flex items-center justify-between p-4 bg-slate-900 rounded-xl text-white">
            <div>
              <p class="text-[9px] font-bold text-slate-400 uppercase tracking-widest">Calculated Total</p>
              <p class="text-xl font-black mt-0.5">MYR <span data-booking-calc-target="displayTotal">0.00</span></p>
            </div>
            <div class="w-1/2">
               <%= f.number_field :total_amount, step: 0.01, placeholder: "0.00", class: "w-full rounded-lg bg-white/10 border-white/20 py-1.5 px-3 text-sm font-bold text-white focus:border-white/40 focus:outline-none focus:ring-0 text-right", data: { booking_calc_target: "totalInput" } %>
            </div>
          </div>
        </div>
      </div>

      <!-- Modal Footer -->
      <div class="px-6 py-4 bg-slate-50 border-t border-slate-100 flex items-center justify-end gap-3">
        <button type="button" onclick="this.closest('dialog').close()" class="px-4 py-2 text-sm font-bold text-slate-600 hover:bg-white rounded-xl transition-colors">Cancel</button>
        <%= f.submit "Create Booking", class: "px-6 py-2 bg-slate-900 text-white rounded-xl text-sm font-bold hover:bg-slate-700 transition-colors shadow-sm" %>
      </div>
    <% end %>
  </div>
<% end %>
