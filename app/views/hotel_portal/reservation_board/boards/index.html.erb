<% content_for :breadcrumbs do %>
  <div class="flex items-center gap-x-2">
    <span class="text-sm font-medium text-slate-600"><%= current_hotel.name %></span>
    <span class="text-sm text-slate-400">/</span>
    <span class="text-sm font-semibold text-slate-900">Reservation Board</span>
  </div>
<% end %>

<% comfortable_mode = @board_layout == "comfortable" %>
<% board_dates = @reservation_board[:dates] %>
<% board_groups = @reservation_board[:room_groups] %>
<% visible_start_date = board_dates.first %>
<% visible_end_exclusive = board_dates.last + 1.day %>
<% board_range_end = @start_date + (@board_days - 1).days %>
<% nav_step_days = @board_days %>
<% grid_room_width = comfortable_mode ? 240 : 180 %>
<% grid_day_width = comfortable_mode ? 84 : 64 %>
<% grid_template_columns = "#{grid_room_width}px repeat(#{board_dates.size}, minmax(#{grid_day_width}px, 1fr))" %>
<% page_spacing = comfortable_mode ? "space-y-6" : "space-y-4" %>
<% container_padding = comfortable_mode ? "px-4 md:px-0" : "px-3 md:px-0" %>
<% card_padding = comfortable_mode ? "px-4 py-1.5" : "px-3 py-1" %>
<% title_class = comfortable_mode ? "text-xl sm:text-2xl" : "text-lg sm:text-xl" %>
<% subtitle_class = comfortable_mode ? "text-sm" : "text-[11px]" %>
<% summary_padding = comfortable_mode ? "px-4 py-3" : "px-3 py-2" %>
<% summary_gap = comfortable_mode ? "gap-3" : "gap-2" %>
<% chip_text_class = comfortable_mode ? "text-[11px]" : "text-[9px]" %>
<% room_number_class = comfortable_mode ? "text-xl" : "text-base" %>
<% rate_text_class = comfortable_mode ? "text-[13px]" : "text-[11px]" %>
<% currency_text_class = comfortable_mode ? "text-[11px]" : "text-[9px]" %>
<% booking_name_class = comfortable_mode ? "text-sm" : "text-xs" %>
<% booking_amount_class = comfortable_mode ? "text-[10px]" : "text-[9px]" %>
<% booking_badge_class = comfortable_mode ? "text-[8px]" : "text-[7.5px]" %>
<% booking_status_class = comfortable_mode ? "text-[9px]" : "text-[8px]" %>
<% booking_meta_class = comfortable_mode ? "mt-0 space-y-0" : "mt-0 flex items-center gap-1.5" %>
<% row_min_base = comfortable_mode ? 80 : 64 %>
<% block_step = comfortable_mode ? 48 : 40 %>
<% block_top = comfortable_mode ? 6 : 4 %>
<% block_left_pad = comfortable_mode ? 6 : 4 %>

<% booking_styles = {
  "pending" => "border-amber-200 bg-amber-50 text-amber-700",
  "confirmed" => "border-blue-200 bg-blue-50 text-blue-700",
  "checked_in" => "border-violet-200 bg-violet-50 text-violet-700",
  "completed" => "border-emerald-200 bg-emerald-50 text-emerald-700",
  "cancelled" => "border-slate-300 bg-slate-100 text-slate-600",
  "not_ready" => "border-red-200 bg-red-50 text-red-700"
} %>

<% status_icons = {
  "all" => '<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="size-3.5"><rect width="7" height="7" x="3" y="3" rx="1"/><rect width="7" height="7" x="14" y="3" rx="1"/><rect width="7" height="7" x="14" y="14" rx="1"/><rect width="7" height="7" x="3" y="14" rx="1"/></svg>',
  "pending" => '<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="size-3.5"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>',
  "confirmed" => '<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="size-3.5"><path d="M20 6 9 17l-5-5"/></svg>',
  "checked_in" => '<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="size-3.5"><path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4"/><polyline points="10 17 15 12 10 7"/><line x1="15" y1="12" x2="3" y2="12"/></svg>',
  "completed" => '<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="size-3.5"><circle cx="12" cy="12" r="10"/><path d="m9 12 2 2 4-4"/></svg>',
  "cancelled" => '<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="size-3.5"><circle cx="12" cy="12" r="10"/><line x1="15" y1="9" x2="9" y2="15"/><line x1="9" y1="9" x2="15" y2="15"/></svg>',
  "not_ready" => '<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="size-3.5"><path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3Z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>'
} %>

<div class="max-w-[1600px] mx-auto pb-20">
  <%= turbo_frame_tag "reservation_board" do %>
    <div class="<%= page_spacing %>">
      <div class="<%= container_padding %> mt-5">
      <div class="flex flex-col gap-4 xl:flex-row xl:items-end xl:justify-between">
        <div class="space-y-3">
          <div>
            <h1 class="font-bold tracking-tight text-slate-950 <%= title_class %>">Reservation Board</h1>
            <p class="mt-1 font-medium text-slate-600 <%= subtitle_class %>"><%= current_hotel.name %> · Centralized reservation management and planning</p>
          </div>

          <div class="flex flex-wrap items-center gap-2 text-xs font-semibold uppercase tracking-[0.08em] text-slate-500">
            <span class="rounded-full border border-slate-200 bg-white px-3 py-1.5 text-slate-700 shadow-sm">
              Showing <%= @start_date.strftime("%b %-d, %Y") %> → <%= board_range_end.strftime("%b %-d, %Y") %> (<%= @board_days %> days)
            </span>
          </div>
        </div>
      </div>

      <div class="mt-4 space-y-2">
        <%= render "hotel_portal/reservation_board/partials/toolbar",
                   board_days: @board_days,
                   board_layout: @board_layout,
                   start_date: @start_date,
                   current_hotel: current_hotel,
                   comfortable_mode: comfortable_mode,
                   board_query_params: @board_query_params,
                   nav_step_days: nav_step_days,
                   rate_plan_names: @rate_plan_names,
                   selected_rate_plan_name: @selected_rate_plan_name %>

        <%= render "hotel_portal/reservation_board/partials/legend",
                   booking_styles: booking_styles,
                   status_icons: status_icons,
                   reservation_board: @reservation_board %>
      </div>
    </div>

    <div class="overflow-auto max-h-[calc(100vh-18rem)] rounded-2xl border border-slate-200 bg-white bg-[repeating-linear-gradient(-45deg,transparent,transparent_10px,#f8fafc_10px,#f8fafc_20px)] shadow-sm">
      <% if board_groups.blank? %>
        <div class="px-8 py-20 text-center bg-white">
          <p class="text-sm font-medium text-slate-500">No rooms found for this property.</p>
        </div>
      <% else %>
        <div class="overflow-x-auto">
          <div class="min-w-[1200px] w-fit" data-controller="reservation-timeline">
            <%= render "hotel_portal/reservation_board/partials/timeline_header",
                       grid_template_columns: grid_template_columns,
                       card_padding: card_padding,
                       board_dates: board_dates,
                       summary_padding: summary_padding %>

            <% board_groups.each do |group| %>
              <details open class="group border-b border-slate-200">
                <summary class="list-none cursor-pointer bg-slate-100 [&::-webkit-details-marker]:hidden">
                  <div class="grid" style="grid-template-columns: <%= grid_template_columns %>;">
                    <div class="sticky left-0 z-20 bg-slate-100 text-[10px] font-bold uppercase tracking-[0.08em] text-slate-600">
                      <div class="flex items-center justify-between gap-2 opacity-0 <%= summary_padding %> pointer-events-none">
                        <span class="truncate whitespace-nowrap font-black text-slate-800"><%= group[:room_type].name %></span>
                        <svg class="size-4 shrink-0 text-slate-500 transition-transform duration-150 group-open:rotate-90" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                          <path d="m9 6 6 6-6 6"/>
                        </svg>
                      </div>
                      <div class="absolute inset-y-0 left-0 w-max min-w-full flex items-center justify-between gap-4 <%= summary_padding %> pointer-events-auto">
                        <span class="whitespace-nowrap font-black text-slate-800"><%= group[:room_type].name %></span>
                        <svg class="size-4 shrink-0 text-slate-500 transition-transform duration-150 group-open:rotate-90" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                          <path d="m9 6 6 6-6 6"/>
                        </svg>
                      </div>
                    </div>
                    <div style="grid-column: 2 / -1;" class="bg-slate-100 border-r border-slate-200"></div>
                  </div>
                </summary>

                <% group[:rooms].each do |room| %>
                  <%= render "hotel_portal/reservation_board/partials/room_row",
                             room: room,
                             grid_template_columns: grid_template_columns,
                             row_min_base: row_min_base,
                             block_step: block_step,
                             card_padding: card_padding,
                             room_number_class: room_number_class,
                             board_dates: board_dates,
                             summary_padding: summary_padding,
                             reservation_board: @reservation_board,
                             visible_start_date: visible_start_date,
                             block_left_pad: block_left_pad,
                             block_top: block_top,
                             booking_styles: booking_styles,
                             visible_end_exclusive: visible_end_exclusive,
                             booking_name_class: booking_name_class,
                             booking_amount_class: booking_amount_class,
                             booking_badge_class: booking_badge_class,
                             booking_status_class: booking_status_class,
                             booking_meta_class: booking_meta_class,
                             current_hotel: current_hotel,
                             rate_text_class: rate_text_class,
                             currency_text_class: currency_text_class %>
                <% end %>
              </details>
            <% end %>
          </div>
        </div>
      <% end %>
    </div>
  </div>
<% end %>

  <%= render "hotel_portal/reservation_board/partials/action_modal", current_hotel: current_hotel %>
  <%= render "hotel_portal/reservation_board/partials/booking_context_menu" %>
</div>

