<%# app/views/hotel_portal/reservation_board/partials/_booking_block.html.erb %>
<%
  clipped_left = block[:check_in] < visible_start_date
  clipped_right = block[:check_out] > visible_end_exclusive
  left_offset = clipped_left ? 0 : block_left_pad
  right_trim = clipped_right ? 0 : block_left_pad
  width_calc = "calc(#{block[:span]} * 100% - #{left_offset + right_trim}px)"
  top_offset = block_top + (block_index * block_step)
  block_height = 40
%>

<div
  data-controller="booking-actions floating"
  data-floating-trigger-value="hover"
  data-floating-placement-value="top"
  data-booking-actions-id-value="<%= block[:id] %>"
  data-booking-actions-status-value="<%= block[:status] %>"
  data-booking-actions-check-in-value="<%= block[:check_in] %>"
  data-booking-actions-check-out-value="<%= block[:check_out] %>"
  data-booking-actions-guest-name-value="<%= block[:guest_name] %>"
  data-booking-actions-date-range-value="<%= block[:check_in].strftime("%b %-d") %> — <%= block[:check_out].strftime("%b %-d, %Y") %>"
  data-booking-actions-source-value="<%= block[:source] %>"
  data-booking-actions-payment-status-value="<%= block[:payment_status] %>"
  data-booking-actions-notes-value="<%= block[:notes] %>"
  data-action="click->booking-actions#openBookingSheet"
  class="absolute z-10 overflow-hidden rounded-sm border cursor-pointer <%= booking_block_status_classes(block, booking_styles) %> <%= booking_block_clip_corner_class(block, visible_start_date, visible_end_exclusive) %> transition-shadow hover:shadow-md"
  style="top: <%= top_offset %>px; left: <%= left_offset %>px; width: <%= width_calc %>; min-width: 40px; height: <%= block_height %>px;"
  data-floating-target="reference"
>
  <%# Drag Handle (Left) %>
  <% unless clipped_left %>
    <div class="absolute inset-y-0 left-0 w-4 cursor-grab bg-black/5 hover:bg-black/10 transition-colors flex items-center justify-center"
         data-action="mousedown->reservation-timeline#onDragHandleMouseDown"
         data-reservation-timeline-target="dragHandle">
      <div class="flex flex-col gap-0.5">
        <div class="size-0.5 rounded-full bg-black/40"></div>
        <div class="size-0.5 rounded-full bg-black/40"></div>
        <div class="size-0.5 rounded-full bg-black/40"></div>
      </div>
    </div>
  <% end %>

  <%# Status Icon (Centered) %>
  <div class="flex items-center justify-center h-full <%= 'ml-4' unless clipped_left %> <%= 'mr-4' unless clipped_right %>">
    <span class="<%= booking_icon_class(block[:status]) %>">
      <%= lucide_icon booking_status_icon(block[:status]), stroke_width: 3, class: "size-4" %>
    </span>
  </div>

  <%# Resize Handle (Right) %>
  <% unless clipped_right %>
    <div class="absolute inset-y-0 right-0 w-4 cursor-ew-resize bg-black/5 hover:bg-black/10 transition-colors"
         data-action="mousedown->reservation-timeline#onResizeStart"
         data-reservation-timeline-target="resizeHandle"></div>
  <% end %>

  <%# Hover Tooltip %>
  <div data-floating-target="floating" class="hidden z-[100] w-56 p-3 bg-slate-900 rounded-xl shadow-xl pointer-events-none text-left">
    <p class="text-sm font-bold text-white truncate"><%= block[:guest_name] %></p>
    <p class="text-[10px] text-slate-400 mt-1"><%= block[:check_in].strftime("%b %-d") %> → <%= block[:check_out].strftime("%b %-d, %Y") %></p>
    <div class="flex items-center gap-2 mt-1.5">
      <span class="text-[9px] font-bold text-slate-500 uppercase"><%= block[:source].presence || "Direct" %></span>
      <span class="text-[9px] font-bold uppercase <%= block[:payment_status] == "captured" ? "text-emerald-400" : "text-amber-400" %>"><%= block[:payment_status].humanize %></span>
    </div>
  </div>
</div>
