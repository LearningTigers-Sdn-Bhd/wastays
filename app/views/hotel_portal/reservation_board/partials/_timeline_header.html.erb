<%# app/views/hotel_portal/reservation_board/partials/_timeline_header.html.erb %>
<div class="sticky top-0 z-30 grid border-b border-slate-200 bg-white/95 backdrop-blur-sm" style="grid-template-columns: <%= grid_template_columns %>;">
  <div class="sticky left-0 z-40 border-r border-slate-200 bg-white/95 shadow-[4px_0_12px_rgba(0,0,0,0.03)] <%= card_padding %> flex items-center">
    <span class="text-[10px] font-black uppercase tracking-[0.15em] text-slate-400">Room Details</span>
  </div>
  <% board_dates.each do |date| %>
    <div class="flex flex-col items-center justify-center border-l border-slate-100 <%= summary_padding %> <%= date == Date.current ? 'bg-slate-50' : '' %>">
      <span class="text-[10px] font-black uppercase tracking-[0.15em] <%= date == Date.current ? 'text-violet-600' : 'text-slate-400' %>"><%= date.strftime("%a") %></span>
      <span class="text-sm font-black <%= date == Date.current ? 'text-violet-700' : 'text-slate-900' %>"><%= date.day %></span>
    </div>
  <% end %>
</div>
