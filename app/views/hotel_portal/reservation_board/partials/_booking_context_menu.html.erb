<%# app/views/hotel_portal/reservation_board/partials/_booking_context_menu.html.erb %>
<template id="booking-actions-menu-template">
  <div class="z-[100] w-64 overflow-hidden rounded-xl border border-slate-200 bg-white shadow-2xl animate-in fade-in zoom-in duration-100">
    <%# Header / Summary %>
    <div class="bg-slate-50 px-4 py-3 border-b border-slate-100">
      <p data-booking-actions-target="statusDisplay" class="text-[9px] font-black uppercase tracking-[0.15em] text-slate-400 mb-1"></p>
      <p data-booking-actions-target="guestNameDisplay" class="text-sm font-bold text-slate-900 truncate"></p>
      
      <div class="flex items-center gap-1.5 mt-1 text-[11px] text-slate-500 font-medium">
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="size-3"><path d="M8 2v4"/><path d="M16 2v4"/><rect width="18" height="18" x="3" y="4" rx="2"/><path d="M3 10h18"/></svg>
        <span data-booking-actions-target="dateRangeDisplay"></span>
      </div>

      <div class="flex items-center gap-1.5 mt-2.5">
        <span data-booking-actions-target="sourceBadge" class="rounded-md px-1.5 py-0.5 text-[8px] font-bold uppercase tracking-widest"></span>
        <span data-booking-actions-target="paymentBadge" class="rounded-md px-1.5 py-0.5 text-[8px] font-bold uppercase tracking-widest"></span>
      </div>
    </div>
    
    <%# Actions Group %>
    <div class="p-1.5 space-y-0.5">
      <%# Check In / Edit Check-In %>
      <button data-booking-actions-target="checkInBtn"
              data-action="click->booking-actions#openCheckIn"
              class="hidden w-full flex items-center gap-2.5 rounded-lg px-3 py-2 text-[13px] font-bold text-slate-700 hover:bg-violet-50 hover:text-violet-700 transition-colors">
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="size-4"><path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4"/><polyline points="10 17 15 12 10 7"/><line x1="15" y1="12" x2="3" y2="12"/></svg>
        Check In
      </button>

      <%# Check Out %>
      <button data-booking-actions-target="checkOutBtn"
              data-action="click->booking-actions#openCheckOut"
              class="hidden w-full flex items-center gap-2.5 rounded-lg px-3 py-2 text-[13px] font-bold text-slate-700 hover:bg-emerald-50 hover:text-emerald-700 transition-colors">
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="size-4"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
        Check Out
      </button>

      <%# Guest Notes %>
      <button data-booking-actions-target="openNotesBtn"
              data-action="click->booking-actions#openNotes"
              class="hidden w-full flex items-center gap-2.5 rounded-lg px-3 py-2 text-[13px] font-bold text-slate-700 hover:bg-amber-50 hover:text-amber-700 transition-colors">
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="size-4 text-amber-500"><path d="M16 3H5a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V8Z"/><path d="M15 3v5h6"/><path d="M7 11h8"/><path d="M7 15h10"/></svg>
        Open Notes
      </button>

      <%# Full Details %>
      <button data-booking-actions-target="detailsBtn"
              data-action="click->booking-actions#showDetails"
              class="w-full flex items-center gap-2.5 rounded-lg px-3 py-2 text-[13px] font-bold text-slate-700 hover:bg-slate-50 hover:text-slate-900 transition-colors">
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="size-4"><circle cx="12" cy="12" r="10"/><line x1="12" y1="16" x2="12" y2="12"/><line x1="12" y1="8" x2="12.01" y2="8"/></svg>
        View Details
      </button>

      <div class="h-px bg-slate-100 my-1.5"></div>

      <%# Quick Extensions %>
      <div class="px-3 py-1">
        <p class="text-[10px] font-black uppercase tracking-[0.12em] text-slate-400">Extend Stay</p>
      </div>
      <div class="px-1.5 pb-1 flex gap-1.5">
        <button data-action="booking-actions#extend1Day" 
                class="flex-1 rounded-lg bg-slate-50 border border-slate-200 py-2 text-[11px] font-black text-slate-700 hover:bg-slate-100 transition-colors">+ 1 Day</button>
        <button data-action="booking-actions#extend2Days" 
                class="flex-1 rounded-lg bg-slate-50 border border-slate-200 py-2 text-[11px] font-black text-slate-700 hover:bg-slate-100 transition-colors">+ 2 Days</button>
      </div>
    </div>
  </div>
</template>
