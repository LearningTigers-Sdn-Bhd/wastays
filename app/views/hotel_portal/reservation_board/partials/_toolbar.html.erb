<%# app/views/hotel_portal/reservation_board/partials/_toolbar.html.erb %>
<% common_params = board_query_params.merge(filters: params[:filters]&.to_unsafe_h) %>

<div class="flex flex-col md:flex-row md:items-center justify-between gap-4 rounded-xl border border-slate-200 bg-white p-2 shadow-sm">
  <div class="flex flex-wrap items-center gap-3">
    <%= form_with url: hotel_reservation_board_index_path(current_hotel), method: :get, data: { turbo_frame: "reservation_board", controller: "auto-submit", action: "change->auto-submit#submit" }, class: "flex items-center gap-3" do %>
      <%= hidden_field_tag :days, board_days %>
      <%= hidden_field_tag :layout, board_layout %>
      
      <div class="flex items-center gap-2">
        <span class="text-[10px] font-bold uppercase tracking-wider text-slate-500">Start</span>
        <%= date_field_tag :start_date, start_date.to_s, class: "rounded-lg border border-slate-300 bg-white px-2 py-1 text-sm font-medium text-slate-900 shadow-sm focus:border-slate-400 focus:outline-none" %>
      </div>

      <div class="h-6 w-px bg-slate-200"></div>

      <div class="flex items-center gap-2">
        <span class="text-[10px] font-bold uppercase tracking-wider text-slate-500">Days</span>
        <%= select_tag :days, options_for_select([7, 14, 21, 30], board_days), class: "rounded-lg border border-slate-300 bg-white px-2 py-1 text-sm font-medium text-slate-900 shadow-sm focus:border-slate-400 focus:outline-none" %>
      </div>

      <div class="h-6 w-px bg-slate-200"></div>

      <div class="flex items-center gap-2">
        <span class="text-[10px] font-bold uppercase tracking-wider text-slate-500">Rates</span>
        <%= select_tag "filters[rate_plan_name]", options_for_select(rate_plan_names, selected_rate_plan_name), class: "rounded-lg border border-slate-300 bg-white px-2 py-1 text-sm font-medium text-slate-900 shadow-sm focus:border-slate-400 focus:outline-none" %>
      </div>
    <% end %>

    <div class="h-6 w-px bg-slate-200"></div>

    <div class="flex items-center rounded-lg border border-slate-200 bg-slate-50 p-0.5">
      <%= link_to hotel_reservation_board_index_path(current_hotel, common_params.merge(start_date: (start_date - nav_step_days.days).to_s)), class: "px-2.5 py-1 text-xs font-bold text-slate-600 hover:text-slate-900", data: { turbo_frame: "reservation_board" } do %>
        &larr; Prev
      <% end %>
      <%= link_to hotel_reservation_board_index_path(current_hotel, common_params.merge(start_date: Date.current.to_s)), class: "rounded bg-white px-2.5 py-1 text-xs font-black text-slate-900 shadow-sm transition hover:bg-slate-50", data: { turbo_frame: "reservation_board" } do %>
        Today
      <% end %>
      <%= link_to hotel_reservation_board_index_path(current_hotel, common_params.merge(start_date: (start_date + nav_step_days.days).to_s)), class: "px-2.5 py-1 text-xs font-bold text-slate-600 hover:text-slate-900", data: { turbo_frame: "reservation_board" } do %>
        Next &rarr;
      <% end %>
    </div>
  </div>

  <div class="px-2">
    <%= link_to hotel_reservation_board_index_path(current_hotel, common_params.merge(start_date: start_date.to_s, layout: comfortable_mode ? "compact" : "comfortable")), class: "flex items-center gap-2 text-xs font-bold uppercase tracking-wider text-slate-600 hover:text-slate-900 transition-colors", data: { turbo_frame: "reservation_board" } do %>
      <div class="relative inline-flex h-4 w-7 items-center rounded-full <%= comfortable_mode ? 'bg-slate-200' : 'bg-slate-900' %> transition-colors">
        <span class="inline-block h-3 w-3 transform rounded-full bg-white transition-transform <%= comfortable_mode ? 'translate-x-1' : 'translate-x-3' %>"></span>
      </div>
      <%= comfortable_mode ? "Compact Mode" : "Comfortable Mode" %>
    <% end %>
  </div>
</div>
