<%# app/views/hotel_portal/reservation_board/partials/_content_footer.html.erb %>
<div class="px-6 py-4 bg-white border-t border-slate-200 shrink-0 shadow-[0_-4px_12px_rgba(0,0,0,0.03)]">
  <div class="max-w-[1000px] mx-auto flex items-center justify-between">
    <% if show_full_page_link %>
      <%= link_to full_page_path, class: "text-xs font-bold text-slate-500 hover:text-slate-900 transition-colors flex items-center gap-2", data: { turbo: false } do %>
        <svg class="size-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 6H5.25A2.25 2.25 0 003 8.25v10.5A2.25 2.25 0 005.25 21h10.5A2.25 2.25 0 0018 18.75V10.5m-10.5 6L21 3m0 0h-5.25M21 3v5.25" />
        </svg>
        <%= full_page_label %>
      <% end %>
    <% else %>
      <div></div>
    <% end %>
    
    <div class="flex items-center gap-3">
      <button type="button" data-action="reservation-board-modal#close" class="px-5 py-2.5 bg-white border border-slate-200 rounded-xl text-sm font-bold text-slate-700 hover:bg-slate-50 transition-all shadow-sm">
        Cancel
      </button>
      <%= submit_button %>
    </div>
  </div>
</div>
