<%# app/views/hotel_portal/reservation_board/partials/_modal_shell.html.erb %>
<% 
  full_screen = local_assigns[:full_screen] || false 
  
  # Base transition classes
  transition_classes = "hs-overlay-open:opacity-100 hs-overlay-open:duration-500 opacity-0 ease-out transition-all"

  # Responsive container and inner content styling
  container_classes, inner_classes = if full_screen
    ["w-full h-full flex flex-col", "flex-1 rounded-none border-none shadow-none"]
  else
    ["w-full min-h-full flex items-center justify-center p-4 sm:p-6", "max-w-lg w-full rounded-3xl border-none shadow-[0_20px_50px_rgba(0,0,0,0.15)]"]
  end
%>

<div id="<%= id %>" 
     class="hs-overlay hidden w-full h-full fixed top-0 start-0 z-[100] overflow-x-hidden overflow-y-auto"
     role="dialog"
     tabindex="-1"
     data-reservation-board-modal-target="dialog"
     <%= local_assigns[:extra_data] %>>
  
  <div class="<%= transition_classes %> <%= container_classes %>">
    <div class="flex flex-col bg-white overflow-hidden pointer-events-auto <%= inner_classes %>">
      <% if local_assigns[:frame_id] %>
        <turbo-frame id="<%= frame_id %>" class="flex-1 flex flex-col min-h-[200px]">
          <%= render "hotel_portal/reservation_board/partials/modal_loader" %>
        </turbo-frame>
      <% else %>
        <div class="flex-1 flex flex-col">
          <%= yield %>
        </div>
      <% end %>
    </div>
  </div>
</div>
