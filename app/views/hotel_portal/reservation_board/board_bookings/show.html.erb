<%= turbo_frame_tag "reservation_board_booking_sheet_content" do %>
  <div class="flex flex-col h-full bg-slate-50">
    
    <%# Modal Header %>
    <% status_badge = capture do %>
      <span class="inline-flex items-center rounded-full border px-2 py-0.5 text-[10px] font-bold tracking-wider <%= booking_status_class(@booking.status).gsub('bg-', 'border-').gsub('text-', 'text-') %> bg-opacity-10 uppercase">
        <%= @booking.status %>
      </span>
    <% end %>

    <% actions = capture do %>
      <% if @booking.status == 'confirmed' %>
        <button type="button" 
                class="inline-flex items-center justify-center rounded-xl bg-slate-900 px-6 py-2.5 text-sm font-bold text-white shadow-sm transition hover:bg-slate-700"
                data-controller="booking-actions"
                data-booking-actions-id-value="<%= @booking.id %>"
                data-action="click->booking-actions#openCheckIn">
          Check In Guest
        </button>
      <% elsif @booking.status == 'checked_in' %>
        <button type="button" 
                class="inline-flex items-center justify-center rounded-xl bg-emerald-600 px-6 py-2.5 text-sm font-bold text-white shadow-sm transition hover:bg-emerald-700"
                data-controller="booking-actions"
                data-booking-actions-id-value="<%= @booking.id %>"
                data-action="click->booking-actions#openCheckOut">
          Check Out Guest
        </button>
      <% end %>
    <% end %>

    <% actions_dropdown = capture do %>
      <div class="hs-dropdown relative inline-flex" data-controller="booking-actions" 
           data-booking-actions-id-value="<%= @booking.id %>"
           data-booking-actions-notes-value="<%= @presenter.notes_json %>">
        <button id="booking-sheet-actions-dropdown" type="button" class="hs-dropdown-toggle p-2 rounded-xl text-slate-400 hover:bg-slate-100 hover:text-slate-600 transition-all">
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="size-6"><circle cx="12" cy="12" r="1"/><circle cx="12" cy="5" r="1"/><circle cx="12" cy="19" r="1"/></svg>
        </button>

        <div class="hs-dropdown-menu transition-[opacity,margin] duration hs-dropdown-open:opacity-100 opacity-0 hidden z-10 min-w-48 bg-white shadow-2xl rounded-2xl p-2 mt-2 border border-slate-100" aria-labelledby="booking-sheet-actions-dropdown">
          <button type="button" 
                  data-action="click->booking-actions#openNotes"
                  class="flex w-full items-center gap-x-3 py-2.5 px-3 rounded-xl text-sm font-bold text-slate-700 hover:bg-slate-50 transition-colors text-left">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="size-4 text-amber-500"><path d="M16 3H5a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V8Z"/><path d="M15 3v5h6"/><path d="M7 11h8"/><path d="M7 15h10"/></svg>
            Guest Notes
          </button>
        </div>
      </div>
    <% end %>

    <%= render "hotel_portal/reservation_board/partials/content_header",
               title: "Booking #{@booking.confirmation_token}",
               subtitle: "Created on #{@booking.created_at.strftime('%d %b %Y')}",
               icon: '<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="size-5"><path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>',
               status_badge: status_badge,
               actions: actions_dropdown %>

    <%# Check-in/Check-out Modals removed from here as they are now dedicated top-level partials %>

    <%# Modal Content (Scrollable) %>
    <div class="flex-1 overflow-y-auto bg-slate-50">
      <div class="max-w-[1400px] mx-auto p-6 md:p-8">
        <div class="grid lg:grid-cols-12 gap-8">
          <!-- Main Column -->
          <div class="lg:col-span-9 space-y-8">
            <div data-controller="booking-tabs" class="space-y-6">
              <!-- Tabs Navigation -->
              <nav class="flex border border-slate-200 rounded-2xl overflow-hidden bg-white shadow-sm" aria-label="Tabs" role="tablist">
                <button type="button"
                        data-booking-tabs-target="tab"
                        data-tab-name="booking-details"
                        data-action="click->booking-tabs#switch"
                        class="flex-1 py-4 px-4 text-slate-500 hover:text-slate-900 text-xs font-black uppercase tracking-widest text-center transition-all border-b-4 border-transparent
                               data-[active=true]:border-b-slate-900 data-[active=true]:text-slate-950 data-[active=true]:bg-slate-50"
                        role="tab">
                  Booking Details
                </button>
                <button type="button"
                        data-booking-tabs-target="tab"
                        data-tab-name="requests"
                        data-action="click->booking-tabs#switch"
                        class="flex-1 py-4 px-4 text-slate-500 hover:text-slate-900 text-xs font-black uppercase tracking-widest text-center transition-all border-b-4 border-transparent
                               data-[active=true]:border-b-slate-900 data-[active=true]:text-slate-950 data-[active=true]:bg-slate-50 flex items-center justify-center gap-2"
                        role="tab">
                  Requests
                  <% if @presenter.pending_requests_count > 0 %>
                    <span class="inline-flex items-center justify-center size-5 rounded-full bg-amber-100 text-[10px] font-black text-amber-800">
                      <%= @presenter.pending_requests_count %>
                    </span>
                  <% end %>
                </button>
                <button type="button"
                        data-booking-tabs-target="tab"
                        data-tab-name="history"
                        data-action="click->booking-tabs#switch"
                        class="flex-1 py-4 px-4 text-slate-500 hover:text-slate-900 text-xs font-black uppercase tracking-widest text-center transition-all border-b-4 border-transparent
                               data-[active=true]:border-b-slate-900 data-[active=true]:text-slate-950 data-[active=true]:bg-slate-50"
                        role="tab">
                  History
                </button>
              </nav>

              <!-- Booking Details Panel -->
              <div data-booking-tabs-target="panel" data-tab-panel="booking-details" class="space-y-8 animate-in fade-in duration-300">
                <!-- Guest Information -->
                <div class="overflow-hidden rounded-3xl border border-slate-200 bg-white shadow-sm">
                  <div class="border-b border-slate-100 bg-slate-50/50 px-8 py-5 flex items-center justify-between">
                    <div>
                      <h2 class="text-base font-black tracking-tight text-slate-900 uppercase tracking-[0.1em]">Guest Information</h2>
                      <p class="mt-1 text-xs font-bold text-slate-400 uppercase">Contact details and identity</p>
                    </div>
                  </div>
                  <div class="p-8">
                    <%= form_with model: @booking, url: hotel_reservation_board_board_booking_path(current_hotel, @booking), method: :patch, class: "grid sm:grid-cols-2 gap-6" do |f| %>
                      <div class="sm:col-span-2 space-y-2">
                        <label class="block text-[10px] font-black text-slate-400 uppercase tracking-widest">Full Guest Name</label>
                        <%= f.text_field :guest_name, class: "w-full rounded-2xl border-2 border-slate-50 bg-slate-50/50 px-4 py-3 text-sm font-bold text-slate-700 focus:border-slate-100 focus:bg-white focus:outline-none focus:ring-0 transition-all shadow-sm" %>
                      </div>
                      <div class="space-y-2">
                        <label class="block text-[10px] font-black text-slate-400 uppercase tracking-widest">Email Address</label>
                        <%= f.email_field :guest_email, class: "w-full rounded-2xl border-2 border-slate-50 bg-slate-50/50 px-4 py-3 text-sm font-bold text-slate-700 focus:border-slate-100 focus:bg-white focus:outline-none focus:ring-0 transition-all shadow-sm" %>
                      </div>
                      <div class="space-y-2">
                        <label class="block text-[10px] font-black text-slate-400 uppercase tracking-widest">Phone Number</label>
                        <%= f.telephone_field :guest_phone, class: "w-full rounded-2xl border-2 border-slate-50 bg-slate-50/50 px-4 py-3 text-sm font-bold text-slate-700 focus:border-slate-100 focus:bg-white focus:outline-none focus:ring-0 transition-all shadow-sm" %>
                      </div>
                      <div class="sm:col-span-2 pt-4 flex justify-end">
                        <%= f.submit "Save Changes", class: "inline-flex items-center rounded-2xl bg-slate-900 px-8 py-3 text-xs font-black text-white uppercase tracking-widest shadow-lg transition hover:bg-slate-700 active:scale-95" %>
                      </div>
                    <% end %>
                  </div>
                </div>

                <!-- Pre Check-In -->
                <% if @presenter.pre_checkin.present? && @booking.pre_checkin_display_status == "completed" %>
                  <% pre_checkin_metadata = @presenter.pre_checkin&.metadata || {} %>
                  <div class="overflow-hidden rounded-3xl border border-slate-200 bg-white shadow-sm">
                    <div class="border-b border-slate-100 bg-slate-50/50 px-8 py-5 flex items-center justify-between gap-3">
                      <div>
                        <h2 class="text-base font-black tracking-tight text-slate-900 uppercase tracking-[0.1em]">Pre Check-In Details</h2>
                        <p class="mt-1 text-xs font-bold text-slate-400 uppercase">Guest arrival info</p>
                      </div>
                      <span class="inline-flex items-center rounded-full border border-emerald-200 bg-emerald-50 px-3 py-1 text-[10px] font-black text-emerald-700 uppercase tracking-widest">Completed</span>
                    </div>
                    <div class="p-8">
                      <div class="grid sm:grid-cols-2 gap-8">
                        <div>
                          <dt class="text-[10px] font-black text-slate-400 uppercase tracking-widest mb-2">Estimated Arrival</dt>
                          <dd class="text-sm font-bold text-slate-900"><%= pre_checkin_metadata["estimated_arrival_time"].presence || @booking.estimated_arrival_time.presence || "Not provided" %></dd>
                        </div>
                        <div>
                          <dt class="text-[10px] font-black text-slate-400 uppercase tracking-widest mb-2">ID / Passport Number</dt>
                          <dd class="text-sm font-bold text-slate-900"><%= pre_checkin_metadata["guest_government_id"].presence || "Not provided" %></dd>
                        </div>
                      </div>
                    </div>
                  </div>
                <% end %>

                <!-- Stay & Room Details -->
                <div class="grid lg:grid-cols-2 gap-8">
                  <div class="overflow-hidden rounded-3xl border border-slate-200 bg-white shadow-sm">
                    <div class="border-b border-slate-100 bg-slate-50/50 px-8 py-5 flex items-center justify-between">
                      <h2 class="text-base font-black tracking-tight text-slate-900 uppercase tracking-[0.1em]">Stay & Room</h2>
                      <button type="button" 
                              class="inline-flex items-center gap-x-1.5 text-[10px] font-black text-blue-600 hover:text-blue-700 transition uppercase tracking-widest"
                              data-controller="booking-actions"
                              data-booking-actions-id-value="<%= @booking.id %>"
                              data-action="click->booking-actions#openEditStay">
                        <svg class="size-3.5" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M17 3a2.85 2.83 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5Z"/><path d="m15 5 4 4"/></svg>
                        Edit
                      </button>
                    </div>
                    <div class="p-8 space-y-8">
                      <div class="grid grid-cols-2 gap-6">
                        <div>
                          <dt class="text-[10px] font-black text-slate-400 uppercase tracking-widest mb-1">Check-in</dt>
                          <dd class="text-sm font-bold text-slate-900"><%= @booking.check_in.strftime("%d %b %Y") %></dd>
                        </div>
                        <div>
                          <dt class="text-[10px] font-black text-slate-400 uppercase tracking-widest mb-1">Check-out</dt>
                          <dd class="text-sm font-bold text-slate-900"><%= @booking.check_out.strftime("%d %b %Y") %></dd>
                        </div>
                      </div>

                      <div class="space-y-4">
                        <h3 class="text-[10px] font-black text-slate-400 uppercase tracking-widest">Reserved Units</h3>
                        <% @presenter.booking_rooms.each do |room| %>
                          <div class="flex justify-between items-center p-5 rounded-2xl border-2 border-slate-50 bg-slate-50/30">
                            <div>
                              <p class="text-sm font-black text-slate-900 uppercase tracking-tight"><%= room.room_type_snapshot['name'] %></p>
                              <p class="text-[10px] font-bold text-slate-400 uppercase mt-1"><%= pluralize(room.quantity, 'room') %></p>
                            </div>
                            <div class="text-right">
                              <% room_number = room.room_number.presence || (@booking.hotel_snapshot.is_a?(Hash) ? @booking.hotel_snapshot['room_number'].presence || @booking.hotel_snapshot.dig('assignment', 'room_number').presence : nil) %>
                              <% if room_number.present? %>
                                <p class="text-[10px] font-black uppercase tracking-[0.2em] text-emerald-600 mb-1">Room <%= room_number %></p>
                              <% end %>
                              <p class="text-xs font-black text-slate-900">MYR <%= number_with_precision(room.subtotal, precision: 2) %></p>
                            </div>
                          </div>
                        <% end %>
                      </div>
                    </div>
                  </div>

                  <!-- Internal Notes -->
                  <div id="booking_notes_panel">
                    <%= render "hotel_portal/bookings/internal_notes", booking: @booking %>
                  </div>
                </div>
              </div>

              <!-- Requests Panel -->
              <div data-booking-tabs-target="panel" data-tab-panel="requests" class="space-y-8 hidden animate-in fade-in duration-300">
                <div class="grid lg:grid-cols-2 gap-8">
                  <!-- Housekeeping -->
                  <div class="overflow-hidden rounded-3xl border border-slate-200 bg-white shadow-sm h-fit">
                    <div class="border-b border-slate-100 bg-slate-50/50 px-8 py-5 flex items-center justify-between gap-3">
                      <div>
                        <h2 class="text-base font-black tracking-tight text-slate-900 uppercase tracking-[0.1em]">Housekeeping</h2>
                        <p class="mt-1 text-xs font-bold text-slate-400 uppercase">Room service requests</p>
                      </div>
                      <span class="inline-flex items-center rounded-full border border-slate-200 bg-white px-3 py-1 text-[10px] font-black text-slate-700 uppercase tracking-widest">
                        <%= @presenter.housekeeping_requests.to_a.count %>
                      </span>
                    </div>
                    <div class="p-6 space-y-4">
                      <% if @presenter.housekeeping_requests.any? %>
                        <% @presenter.housekeeping_requests.each do |request| %>
                          <div class="rounded-2xl border-2 border-slate-50 bg-slate-50/30 p-5 space-y-4">
                            <div class="flex items-start justify-between gap-4">
                              <div class="flex-1 min-w-0 space-y-3">
                                <div>
                                  <dt class="text-[9px] font-black text-slate-400 uppercase tracking-[0.2em]">Requested</dt>
                                  <dd class="text-xs font-bold text-slate-900 uppercase"><%= display_housekeeping_datetime(request.display_requested_at) %></dd>
                                </div>
                                <div>
                                  <dt class="text-[9px] font-black text-slate-400 uppercase tracking-[0.2em]">Details</dt>
                                  <dd class="text-sm text-slate-600 font-medium leading-relaxed italic">"<%= request.request_details %>"</dd>
                                </div>
                              </div>
                              <span class="inline-flex items-center rounded-full border px-2.5 py-1 text-[9px] font-black uppercase tracking-widest <%= housekeeping_status_class(request.status).gsub('bg-', 'border-').gsub('text-', 'text-') %> bg-opacity-10">
                                <%= request.status %>
                              </span>
                            </div>
                            <% unless request.completed? || request.cancelled? %>
                              <div class="flex justify-end pt-2">
                                 <%= button_to "Complete", complete_housekeeping_request_hotel_booking_path(current_hotel, @booking, housekeeping_request_id: request.id), method: :post, class: "inline-flex items-center rounded-xl bg-slate-900 px-4 py-2 text-[10px] font-black text-white uppercase tracking-widest shadow-md transition hover:bg-slate-700 active:scale-95" %>
                              </div>
                            <% end %>
                          </div>
                        <% end %>
                      <% else %>
                        <div class="py-12 text-center border-2 border-dashed border-slate-100 rounded-2xl">
                          <p class="text-xs font-black text-slate-400 uppercase tracking-widest">No housekeeping requests</p>
                        </div>
                      <% end %>
                    </div>
                  </div>

                  <!-- Complaints -->
                  <div class="overflow-hidden rounded-3xl border border-slate-200 bg-white shadow-sm h-fit">
                    <div class="border-b border-slate-100 bg-slate-50/50 px-8 py-5 flex items-center justify-between gap-3">
                      <div>
                        <h2 class="text-base font-black tracking-tight text-slate-900 uppercase tracking-[0.1em]">Complaints</h2>
                        <p class="mt-1 text-xs font-bold text-slate-400 uppercase">Guest-reported issues</p>
                      </div>
                      <span class="inline-flex items-center rounded-full border border-slate-200 bg-white px-3 py-1 text-[10px] font-black text-slate-700 uppercase tracking-widest">
                        <%= @presenter.complaint_requests.to_a.count %>
                      </span>
                    </div>
                    <div class="p-6 space-y-4">
                      <% if @presenter.complaint_requests.any? %>
                        <% @presenter.complaint_requests.each do |request| %>
                          <div class="rounded-2xl border-2 border-slate-50 bg-slate-50/30 p-5 space-y-4">
                            <div class="flex items-start justify-between gap-4">
                              <div class="flex-1 min-w-0 space-y-3">
                                <div>
                                  <dt class="text-[9px] font-black text-slate-400 uppercase tracking-[0.2em]">Reported</dt>
                                  <dd class="text-xs font-bold text-slate-900 uppercase"><%= display_housekeeping_datetime(request.display_requested_at) %></dd>
                                </div>
                                <div>
                                  <dt class="text-[9px] font-black text-slate-400 uppercase tracking-[0.2em]">Details</dt>
                                  <dd class="text-sm text-slate-600 font-medium leading-relaxed italic">"<%= request.complaint_details %>"</dd>
                                </div>
                              </div>
                              <span class="inline-flex items-center rounded-full border px-2.5 py-1 text-[9px] font-black uppercase tracking-widest <%= complaint_status_class(request.status).gsub('bg-', 'border-').gsub('text-', 'text-') %> bg-opacity-10">
                                <%= request.status %>
                              </span>
                            </div>
                            <% unless request.resolved? || request.cancelled? %>
                              <div class="flex justify-end pt-2">
                                 <%= button_to "Resolve", resolve_complaint_request_hotel_booking_path(current_hotel, @booking, complaint_request_id: request.id), method: :post, class: "inline-flex items-center rounded-xl bg-slate-900 px-4 py-2 text-[10px] font-black text-white uppercase tracking-widest shadow-md transition hover:bg-slate-700 active:scale-95" %>
                              </div>
                            <% end %>
                          </div>
                        <% end %>
                      <% else %>
                        <div class="py-12 text-center border-2 border-dashed border-slate-100 rounded-2xl">
                          <p class="text-xs font-black text-slate-400 uppercase tracking-widest">No complaint requests</p>
                        </div>
                      <% end %>
                    </div>
                  </div>
                </div>
              </div>

              <div data-booking-tabs-target="panel" data-tab-panel="history" class="space-y-8 hidden animate-in fade-in duration-300">
                <%= render "hotel_portal/bookings/audit_history", audit_logs: @audit_logs %>
              </div>
            </div>
          </div>

          <!-- Sidebar Column -->
          <div class="lg:col-span-3 space-y-8">
            <!-- Summary Card -->
            <div class="overflow-hidden rounded-3xl border border-slate-200 bg-white shadow-sm">
              <div class="border-b border-slate-100 bg-slate-50/50 px-8 py-4">
                <h3 class="text-[10px] font-black text-slate-400 uppercase tracking-[0.2em]">Financial Summary</h3>
              </div>
              <div class="p-8 space-y-6">
                <div class="flex justify-between items-center">
                  <span class="text-[10px] font-black text-slate-400 uppercase tracking-widest">Payment</span>
                  <span class="inline-flex items-center rounded-full border px-2.5 py-1 text-[9px] font-black tracking-widest <%= hotel_payment_status_class(@booking.payment_status).gsub('bg-', 'border-').gsub('text-', 'text-') %> bg-opacity-10 uppercase">
                    <%= hotel_payment_display_status(@booking.payment_status) %>
                  </span>
                </div>
                <div class="flex justify-between items-center">
                  <span class="text-[10px] font-black text-slate-400 uppercase tracking-widest">Arrival</span>
                  <% pc_status = pre_checkin_display_status(@booking) %>
                  <span class="inline-flex items-center rounded-full border px-2.5 py-1 text-[9px] font-black tracking-widest <%= pre_checkin_status_class(pc_status).gsub('bg-', 'border-').gsub('text-', 'text-') %> bg-opacity-10 uppercase">
                    <%= pc_status.to_s.tr("_", " ") %>
                  </span>
                </div>
                <div class="pt-6 border-t border-slate-100">
                  <span class="text-[9px] font-black text-slate-400 uppercase tracking-[0.3em]">Total Paid</span>
                  <p class="text-2xl font-black text-slate-900 mt-1">MYR <%= number_with_precision(@booking.total_amount, precision: 2) %></p>
                </div>
              </div>
            </div>

            <!-- Quick Actions -->
            <div class="overflow-hidden rounded-3xl border border-slate-200 bg-white shadow-sm">
              <div class="border-b border-slate-100 bg-slate-50/50 px-8 py-4">
                <h3 class="text-[10px] font-black text-slate-400 uppercase tracking-[0.2em]">Communications</h3>
              </div>
              <div class="p-4 space-y-2">
                <button type="button" class="w-full flex items-center justify-between px-4 py-3 rounded-2xl text-[10px] font-black text-slate-600 uppercase tracking-widest hover:bg-slate-50 transition-colors group">
                  Resend Confirmation
                  <svg class="size-4 text-slate-300 group-hover:text-slate-900 transition-colors" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg>
                </button>
                <button type="button" class="w-full flex items-center justify-between px-4 py-3 rounded-2xl text-[10px] font-black text-slate-600 uppercase tracking-widest hover:bg-slate-50 transition-colors group">
                  Resend Pre-Check-in
                  <svg class="size-4 text-slate-300 group-hover:text-slate-900 transition-colors" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg>
                </button>
              </div>
            </div>

            <!-- Documents -->
            <div class="overflow-hidden rounded-3xl border border-slate-200 bg-white shadow-sm">
              <div class="border-b border-slate-100 bg-slate-50/50 px-8 py-4">
                <h3 class="text-[10px] font-black text-slate-400 uppercase tracking-[0.2em]">Documentation</h3>
              </div>
              <div class="p-4">
                <%= link_to invoice_booking_path(@booking.confirmation_token), target: "_blank", class: "w-full flex items-center justify-between px-4 py-3 rounded-2xl text-[10px] font-black text-slate-600 uppercase tracking-widest hover:bg-slate-50 transition-colors group", data: { turbo: false } do %>
                  Download Invoice
                  <svg class="size-4 text-slate-300 group-hover:text-slate-900 transition-colors" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3v12"/><path d="m7 10 5 5 5-5"/><path d="M5 21h14"/></svg>
                <% end %>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <%# Modal Footer %>
    <%= render "hotel_portal/reservation_board/partials/content_footer",
               show_full_page_link: true,
               full_page_path: hotel_booking_path(current_hotel, @booking),
               full_page_label: "Full Booking Page",
               submit_button: actions %>
  </div>
<% end %>
