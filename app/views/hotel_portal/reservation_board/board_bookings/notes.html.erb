<%# app/views/hotel_portal/reservation_board/bookings/notes.html.erb %>

<%= turbo_frame_tag "offcanvas_drawer" do %>
  <div class="flex flex-col h-full bg-white">
    <%# Modal Header %>
    <%= render "hotel_portal/reservation_board/partials/content_header",
               title: "Guest Notes",
               subtitle: "Internal staff notes for #{@booking.guest_name}",
               icon: lucide_icon("sticky-note", stroke_width: 2.5, class: "size-5 text-amber-500") %>

    <%# Modal Content %>
    <div class="flex-1 overflow-y-auto p-8 space-y-4">
      <% if @notes.any? %>
        <% @notes.each do |note| %>
          <div class="p-4 bg-slate-50 rounded-2xl border border-slate-100 space-y-2">
            <div class="flex justify-between items-start">
              <span class="text-xs font-black text-slate-900 uppercase tracking-tight"><%= note.user.name %></span>
              <span class="text-[10px] text-slate-400 font-bold uppercase"><%= note.created_at.strftime("%b %d, %Y %H:%M") %></span>
            </div>
            <p class="text-sm text-slate-700 whitespace-pre-wrap leading-relaxed italic">"<%= note.body %>"</p>
          </div>
        <% end %>
      <% else %>
        <div class="py-16 text-center border-2 border-dashed border-slate-100 rounded-3xl">
          <p class="text-xs font-black text-slate-400 uppercase tracking-widest">No guest notes recorded</p>
        </div>
      <% end %>
    </div>

    <%# Modal Footer %>
    <div class="px-8 py-6 border-t border-slate-100 flex justify-end bg-slate-50/50">
      <button type="button" 
              data-action="click->offcanvas#close" 
              class="px-8 py-3 bg-slate-900 text-white rounded-2xl text-xs font-black uppercase tracking-widest shadow-lg transition hover:bg-slate-700 active:scale-95">
        Close
      </button>
    </div>
  </div>
<% end %>
