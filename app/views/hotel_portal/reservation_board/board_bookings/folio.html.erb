<% content_for :breadcrumbs do %>
  <div class="flex items-center gap-x-2">
    <span class="text-sm font-medium text-slate-600"><%= current_hotel.name %></span>
    <span class="text-sm text-slate-400">/</span>
    <%= link_to "Reservation Board", hotel_reservation_board_index_path(current_hotel), class: "text-sm font-medium text-slate-600 hover:text-slate-900" %>
    <span class="text-sm text-slate-400">/</span>
    <%= link_to @booking.confirmation_token, hotel_reservation_board_board_booking_path(current_hotel, @booking), class: "text-sm font-medium text-slate-600 hover:text-slate-900" %>
    <span class="text-sm text-slate-400">/</span>
    <span class="text-sm font-semibold text-slate-900">Folio Management</span>
  </div>
<% end %>

<div class="max-w-[1600px] mx-auto pb-20 space-y-8 px-4 md:px-0 mt-5">
  <div class="flex flex-col md:flex-row md:items-start md:justify-between gap-6">
    <div>
      <div class="flex items-center gap-3 mb-2">
        <h1 class="text-2xl font-bold tracking-tight text-slate-950 sm:text-3xl">Folio <%= @booking.confirmation_token %></h1>
        <span class="inline-flex items-center rounded-full border px-2.5 py-1 text-[10px] font-bold tracking-wider <%= @presenter.status_label_class %> bg-opacity-10 uppercase">
          <%= @presenter.status %>
        </span>
      </div>
      <div class="flex flex-wrap gap-x-4 gap-y-1 text-sm font-medium text-slate-600">
        <span class="flex items-center gap-1">
          <%= lucide_icon "user", class: "size-3.5" %>
          <%= @booking.guest_name %>
        </span>
        <span class="flex items-center gap-1">
          <%= lucide_icon "calendar", class: "size-3.5" %>
          <%= @booking.check_in.strftime("%d %b") %> — <%= @booking.check_out.strftime("%d %b %Y") %>
        </span>
      </div>
    </div>

    <div class="flex items-center gap-3">
      <%= link_to hotel_reservation_board_board_booking_path(current_hotel, @booking), class: "rounded-xl border border-slate-200 bg-white px-4 py-2.5 text-sm font-bold text-slate-700 shadow-sm transition hover:bg-slate-50 flex items-center gap-2" do %>
        <%= lucide_icon "arrow-left", stroke_width: 2.5, class: "size-4" %>
        Back to Booking
      <% end %>
    </div>
  </div>

  <%= render "hotel_portal/bookings/folio/folio_balance_summary", booking: @booking %>
  <%= render "hotel_portal/bookings/folio/folio_actions", booking: @booking, hotel: current_hotel, redirect_to_folio: true %>
  <%= render "hotel_portal/bookings/folio/folio_transaction_table", booking: @booking %>
</div>

<%= render "hotel_portal/bookings/show/modals/action_modals", booking: @booking, presenter: @presenter %>
