<section id="reservation-policies" class="lg:w-[85%]" aria-labelledby="reservation-policies-heading">
  <div>
    <h2 id="reservation-policies-heading" class="text-base font-semibold text-foreground">Reservation Policies</h2>
    <p class="mt-2 text-sm text-muted-foreground">Room Revenue owns the charge, and the booking engine bills from it. Write the note that explains the charge to guests here.</p>
  </div>

  <% if @reservation_policies.missing_count.positive? %>
    <div class="mt-4">
      <%= render PanelsUI::Alert.new(
            tone: :warning,
            title: "#{pluralize(@reservation_policies.missing_count, 'policy')} not set yet") do |alert| %>
        <% alert.with_description do %>
          A policy with no rule leaves staff and guests to guess. Set it in Room Revenue.
        <% end %>
      <% end %>
    </div>
  <% end %>

  <div class="mt-5 hidden md:block">
    <%= render PanelsUI::Table.new(
          caption: "Reservation policies set for this hotel",
          density: :compact,
          header_style: :sentence,
          wrapper_class: "rounded-md border border-border bg-card") do |table| %>
      <% table.with_header do %>
        <tr>
          <th scope="col">Policy</th>
          <th scope="col">What the hotel charges</th>
          <th scope="col">Note for guests</th>
          <th scope="col" class="text-right"><span class="sr-only">Actions</span></th>
        </tr>
      <% end %>

      <% table.with_body do %>
        <% @reservation_policies.rows.each do |row| %>
          <tr>
            <td class="font-medium text-foreground"><%= row.label %></td>
            <td>
              <% if row.set? %>
                <span class="block text-foreground"><%= row.charge %></span>
                <% if row.schedule.present? %>
                  <span class="mt-0.5 block text-xs text-muted-foreground"><%= row.schedule %></span>
                <% end %>
              <% else %>
                <%= blank_value("Not set") %>
              <% end %>
            </td>
            <td class="max-w-xs">
              <% if row.note.present? %>
                <span class="block whitespace-pre-line text-muted-foreground"><%= row.note %></span>
              <% elsif row.editable? %>
                <%= blank_value("No note yet") %>
              <% else %>
                <span class="text-muted-foreground">&mdash;</span>
              <% end %>
            </td>
            <td class="text-right">
              <% if row.editable? %>
                <%= render PanelsUI::Button.new(
                      label: row.note.present? ? "Edit note" : "Add note",
                      as: :a,
                      href: edit_hotel_policy_reservation_note_path(@hotel, row.id),
                      variant: :secondary,
                      size: :sm,
                      data: { turbo_frame: "settings_action_sheet" }) %>
              <% end %>
            </td>
          </tr>
        <% end %>
      <% end %>
    <% end %>
  </div>

  <div class="mt-5 divide-y divide-border rounded-md border border-border bg-card md:hidden">
    <% @reservation_policies.rows.each do |row| %>
      <div class="space-y-2 px-4 py-3">
        <p class="text-sm font-medium text-foreground"><%= row.label %></p>
        <p class="text-sm text-muted-foreground">
          <% if row.set? %>
            <%= row.charge %>
            <% if row.schedule.present? %>
              <span class="mt-0.5 block text-xs"><%= row.schedule %></span>
            <% end %>
          <% else %>
            <%= blank_value("Not set") %>
          <% end %>
        </p>
        <% if row.note.present? %>
          <p class="whitespace-pre-line text-sm text-muted-foreground"><%= row.note %></p>
        <% end %>
        <% if row.editable? %>
          <%= render PanelsUI::Button.new(
                label: row.note.present? ? "Edit note" : "Add note",
                as: :a,
                href: edit_hotel_policy_reservation_note_path(@hotel, row.id),
                variant: :secondary,
                size: :sm,
                data: { turbo_frame: "settings_action_sheet" }) %>
        <% end %>
      </div>
    <% end %>
  </div>

  <footer class="mt-5 flex justify-end">
    <%= render PanelsUI::Button.new(label: "Room Revenue", as: :a, href: hotel_room_revenue_path(@hotel), variant: :secondary, size: :md) %>
  </footer>
</section>
