<%# One read column on Getting Around. `rows` is a list of label and value
    pairs; a pair with no value shows the blank marker, so an operator can see
    what is still missing without opening the sheet. %>
<section id="<%= section %>" class="lg:w-[85%]" aria-labelledby="<%= section %>-heading">
  <div class="flex items-start justify-between gap-3">
    <div>
      <h2 id="<%= section %>-heading" class="text-base font-semibold text-foreground"><%= title %></h2>
      <p class="mt-2 text-sm text-muted-foreground"><%= description %></p>
    </div>
    <%= render PanelsUI::Badge.new(
          label: filled ? "Ready" : "Not set",
          variant: filled ? :success : :secondary,
          size: :sm) %>
  </div>

  <dl class="mt-5 space-y-3">
    <% rows.each do |label, value| %>
      <div class="flex items-start justify-between gap-4">
        <dt class="text-sm text-muted-foreground"><%= label %></dt>
        <dd class="text-right text-sm text-foreground">
          <%= value.present? ? value : blank_value("Not set") %>
        </dd>
      </div>
    <% end %>
  </dl>

  <div class="mt-5">
    <h3 class="text-sm font-medium text-foreground"><%= notes_label %></h3>
    <p class="mt-1 whitespace-pre-line text-sm text-muted-foreground">
      <%= notes.present? ? notes : blank_value("Not set") %>
    </p>
  </div>

  <footer class="mt-5 flex justify-end">
    <%= render PanelsUI::Button.new(
          label: "Edit",
          as: :a,
          href: hotel_edit_guest_transport_detail_path(hotel, section),
          variant: :secondary,
          size: :sm,
          data: { turbo_frame: "settings_action_sheet" }) %>
  </footer>
</section>
