<% section_actions = capture do %>
  <%= render PanelsUI::Button.new(label: "Back", href: kb_index_path, variant: :secondary, size: :sm) %>
<% end %>
<%= render "hotel_portal/guest_content/shared/section_header",
      title: "Edit #{kb_label}",
      description: "Keep this information clear and up to date.",
      actions: section_actions %>

<div class="rounded-md border border-border bg-card p-5 shadow-sm sm:p-6">
  <%= render "hotel_portal/guest_content/documents/form", document: @document %>
</div>
