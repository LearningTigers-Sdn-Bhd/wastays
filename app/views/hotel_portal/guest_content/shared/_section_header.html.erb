<%#
  One section heading for every Guest Content page: the title and its
  description on the left, the section's actions on the right.
  Locals: title, description (optional), actions (optional, captured markup),
  testid (optional).
%>
<div class="flex flex-col gap-2 sm:flex-row sm:items-start sm:justify-between" data-testid="<%= local_assigns[:testid] %>">
  <div>
    <h2 class="text-base font-semibold text-foreground"><%= title %></h2>
    <% if local_assigns[:description].present? %>
      <p class="mt-1 text-sm text-muted-foreground"><%= description %></p>
    <% end %>
  </div>
  <% if local_assigns[:actions].present? %>
    <div class="flex flex-wrap items-center gap-2"><%= actions %></div>
  <% end %>
</div>
