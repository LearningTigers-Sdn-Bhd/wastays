<%# Every section on this page saves on its own, so the form plumbing, the
    heading and the Save row are the same four times over and live here.
    `section` names the block, doubles as its element id, and tells the
    controller which section came back with an error.

    The whole block stops short of its column on desktop, so the heading, the
    inputs and the Save row all end on the same edge. %>
<%= form_with model: guest_contact,
              url: hotel_guest_contact_path(hotel),
              method: :patch,
              local: true,
              data: {
                controller: "form-dirty",
                action: "input->form-dirty#refresh change->form-dirty#refresh reset->form-dirty#restore"
              },
              class: "md:w-4/5" do |form| %>
  <%= hidden_field_tag :section, section %>

  <section id="<%= section %>" class="scroll-mt-6" aria-labelledby="<%= section %>-heading">
    <div>
      <h2 id="<%= section %>-heading" class="text-base font-semibold text-foreground"><%= title %></h2>
      <p class="mt-2 text-sm text-muted-foreground"><%= description %></p>
    </div>

    <% if guest_contact.errors.any? && params[:section] == section %>
      <div class="mt-4">
        <%= render PanelsUI::Alert.new(
              tone: :destructive,
              title: pluralize(guest_contact.errors.count, "error") + " prevented these details from being saved",
              role: :alert) do |alert| %>
          <% alert.with_description do %>
            <ul class="list-disc space-y-1 ps-5">
              <% guest_contact.errors.full_messages.each do |message| %>
                <li><%= message %></li>
              <% end %>
            </ul>
          <% end %>
        <% end %>
      </div>
    <% end %>

    <div class="mt-5 space-y-4">
      <%= yield form %>
    </div>

    <footer class="mt-5 flex justify-end gap-3">
      <%# Cancel only exists while there is something to discard, so it starts
          hidden and the controller reveals it alongside enabling Save. A native
          reset restores the section's fields; the PanelsUI selects and the time
          pickers resync themselves off the reset event. %>
      <%= render PanelsUI::Button.new(
            as: :button,
            type: :reset,
            variant: :secondary,
            size: :md,
            hidden: true,
            data: { form_dirty_target: "cancel" }) do %>
        Cancel
      <% end %>

      <%# Rendered disabled, because there is nothing to save yet. Enabling it
          here and letting the controller switch it off on connect flashed a
          live Save on every load, once per section. %>
      <%= render PanelsUI::Button.new(
            as: :button,
            type: :submit,
            size: :md,
            disabled: true,
            data: { form_dirty_target: "submit" }) do %>
        Save
      <% end %>
    </footer>
  </section>
<% end %>
