<%
  form_url = @network.persisted? ? hotel_wifi_network_path(@hotel, @network) : hotel_wifi_networks_path(@hotel)
  form_method = @network.persisted? ? :patch : :post
%>
<%= form_with model: @network, url: form_url, method: form_method, local: true, class: "space-y-6" do |form| %>
  <% if @network.errors.any? %>
    <%= render PanelsUI::Alert.new(tone: :destructive, title: "Wi-Fi network could not be saved") do |alert| %>
      <% alert.with_description do %>
        <ul class="list-disc space-y-1 ps-5">
          <% @network.errors.full_messages.each do |message| %><li><%= message %></li><% end %>
        </ul>
      <% end %>
    <% end %>
  <% end %>

  <section class="grid gap-4 sm:grid-cols-2" aria-labelledby="network-details-heading">
    <h2 id="network-details-heading" class="text-base font-semibold sm:col-span-2">Network details</h2>
    <%= render PanelsUI::FormField.new(form: form, attribute: :label, label: "Display name", required: true) do |field| %>
      <% field.with_input(placeholder: "For example, Guest Wi-Fi") %>
    <% end %>
    <%= render PanelsUI::FormField.new(form: form, attribute: :ssid, label: "Network name", required: true) do |field| %>
      <% field.with_input(placeholder: "For example, MiloHotel-Guest") %>
    <% end %>
    <%= render PanelsUI::FormField.new(form: form, attribute: :security_type, label: "Security") do |field| %>
      <% field.with_select_menu([["Password protected", "protected"], ["Open network", "open"]], selected: @network.security_type) %>
    <% end %>
    <%= render PanelsUI::FormField.new(
          form: form,
          attribute: :password,
          label: "Password",
          hint: @network.persisted? && @network.password.present? ? "A password is saved. Leave this field blank to keep it." : "Required for a protected network.") do |field| %>
      <% field.with_input(type: :password, value: nil, autocomplete: "new-password") %>
    <% end %>
    <%= render PanelsUI::FormField.new(form: form, attribute: :access_scope, label: "Guest access") do |field| %>
      <% field.with_select_menu(
           [["Checked-in guests", "checked_in_guests"], ["Confirmed guests", "confirmed_guests"], ["Staff only", "staff_only"]],
           selected: @network.access_scope) %>
    <% end %>
    <%= render PanelsUI::FormField.new(form: form, attribute: :position, label: "Display order") do |field| %>
      <% field.with_input(type: :number, min: 0, step: 1) %>
    <% end %>
    <%= render PanelsUI::FormField.new(form: form, attribute: :connection_instructions, label: "Connection instructions", class: "sm:col-span-2") do |field| %>
      <% field.with_text_area(rows: 4, placeholder: "Explain how an eligible guest connects.") %>
    <% end %>
    <div class="space-y-3 sm:col-span-2">
      <%= render PanelsUI::Checkbox.new(form: form, attribute: :active, label: "Active network", description: "Keep this network available for hotel operations.") %>
      <%= render PanelsUI::Checkbox.new(form: form, attribute: :primary_network, label: "Primary guest network", description: "Use this network as the main guest Wi-Fi network.") %>
    </div>
  </section>

  <div class="flex justify-end gap-2">
    <%= render PanelsUI::Button.new(label: "Cancel", href: hotel_wifi_networks_path(@hotel), variant: :secondary) %>
    <%= render PanelsUI::Button.new(as: :button, type: :submit, label: @network.persisted? ? "Save changes" : "Add network") %>
  </div>
<% end %>
