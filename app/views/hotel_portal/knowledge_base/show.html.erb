<% content_for :head do %>
  <%= turbo_refreshes_with method: :morph, scroll: :preserve %>
<% end %>

<%= turbo_stream_from @document %>

<div class="w-full space-y-8">
  <div>
    <%= render PanelsUI::PageHeader.new(title: @document.title) do |header| %>
      <% header.with_caption do %>
        <div class="flex flex-wrap items-center gap-2">
          <span class="inline-flex items-center rounded-full bg-muted px-2.5 py-0.5 text-xs font-semibold text-foreground capitalize"><%= @document.category %></span>
          <span class="inline-flex items-center rounded-full bg-muted px-2.5 py-0.5 text-xs font-semibold text-foreground capitalize"><%= @document.source_type %></span>
          <span class="inline-flex items-center rounded-full bg-muted px-2.5 py-0.5 text-xs font-semibold text-foreground uppercase"><%= @document.language %></span>
          <span class="inline-flex items-center rounded-full bg-muted px-2.5 py-0.5 text-xs font-semibold text-foreground">v<%= @document.version %></span>
          <span class="inline-flex items-center rounded-full px-2.5 py-0.5 text-xs font-semibold capitalize
            <%= @document.embedding_status == "indexed" ? "bg-emerald-50 text-emerald-700" :
               @document.embedding_status == "failed" ? "bg-red-50 text-red-700" :
               @document.embedding_status == "indexing" ? "bg-blue-50 text-blue-700" :
               "bg-amber-50 text-amber-700" %>"><%= @document.embedding_status %></span>
          <% if current_hotel.ai_concierge_enabled? && @document.embedding_status == "indexing" %>
            <div class="inline-flex items-center justify-center gap-2 rounded-xl border border-blue-200 bg-blue-50 px-4 py-2.5 text-sm font-semibold text-blue-700" role="status">
              <svg class="size-4 animate-spin" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                <circle class="opacity-25" cx="12" cy="12" r="9" stroke="currentColor" stroke-width="3"></circle>
                <path class="opacity-75" fill="currentColor" d="M12 3a9 9 0 0 1 9 9h-3a6 6 0 0 0-6-6V3Z"></path>
              </svg>
              Generating embeddings
            </div>
          <% end %>
        </div>
      <% end %>
      <% header.with_actions do %>
        <div class="flex flex-wrap items-center gap-3">
          <%= render PanelsUI::Button.new(as: :a, href: kb_edit_path(@document), variant: :secondary, size: :md, class: "w-full lg:w-auto") do %>
            <svg class="size-4" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 3a2.85 2.83 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5Z"/><path d="m15 5 4 4"/></svg>
            Edit
          <% end %>
          <% if current_hotel.ai_concierge_enabled? && %w[pending failed].include?(@document.embedding_status) %>
            <%= form_with url: kb_reindex_path(@document), method: :post, class: "w-full lg:w-auto" do %>
              <%= render PanelsUI::Button.new(as: :button, type: "submit", variant: :secondary, size: :md, class: "w-full lg:w-auto") do %>
                <svg class="size-4" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12a9 9 0 1 1-9-9c2.52 0 4.93 1 6.74 2.74L21 8"/><path d="M21 3v5h-5"/></svg>
                <%= @document.embedding_status == "failed" ? "Retry Embeddings" : "Generate Embeddings" %>
              <% end %>
            <% end %>
          <% end %>
        </div>
      <% end %>
    <% end %>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 ">
    <div class="lg:col-span-2 space-y-6">
      <% if @document.category == "faq" && @document.metadata&.dig("qa_pairs").present? %>
        <div class="overflow-hidden rounded-2xl border border-border bg-card shadow-sm">
          <div class="border-b border-border px-6 py-4">
            <h2 class="text-sm font-bold text-foreground">Questions & Answers</h2>
          </div>
          <div class="divide-y divide-border">
            <% qa_list = @document.metadata["qa_pairs"] %>
            <% qa_list = qa_list.values if qa_list.is_a?(Hash) %>
            <% Array(qa_list).each_with_index do |pair, idx| %>
              <% next unless pair.is_a?(Hash) %>
              <div class="px-6 py-4">
                <div class="mb-3">
                  <span class="inline-flex items-center justify-center size-5 rounded-full bg-blue-100 text-[10px] font-bold text-blue-700">Q<%= idx + 1 %></span>
                  <p class="mt-2 text-sm font-semibold text-foreground"><%= pair["question"] %></p>
                </div>
                <div>
                  <span class="inline-flex items-center justify-center size-5 rounded-full bg-emerald-100 text-[10px] font-bold text-emerald-700">A</span>
                  <p class="mt-2 text-sm text-foreground whitespace-pre-wrap"><%= pair["answer"] %></p>
                </div>
              </div>
            <% end %>
          </div>
        </div>
      <% elsif @document.content.present? %>
        <div class="overflow-hidden rounded-2xl border border-border bg-card shadow-sm">
          <div class="border-b border-border px-6 py-4">
            <h2 class="text-sm font-bold text-foreground">Content</h2>
          </div>
          <div class="px-6 py-4">
            <pre class="whitespace-pre-wrap text-sm text-foreground font-mono"><%= @document.content %></pre>
          </div>
        </div>
      <% end %>

      <% if @document.file.attached? %>
        <div class="overflow-hidden rounded-2xl border border-border bg-card shadow-sm">
          <div class="border-b border-border px-6 py-4">
            <h2 class="text-sm font-bold text-foreground">Attached File</h2>
          </div>
          <div class="px-6 py-4">
            <%= link_to url_for(@document.file), target: "_blank", class: "inline-flex items-center gap-2 text-sm text-blue-600 hover:underline" do %>
              <svg class="size-4" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><path d="M16 13H8"/><path d="M16 17H8"/><path d="M10 9H8"/></svg>
              <%= @document.file.filename %>
            <% end %>
          </div>
        </div>
      <% end %>

      <div class="overflow-hidden rounded-2xl border border-border bg-card shadow-sm">
        <div class="border-b border-border px-6 py-4">
          <h2 class="text-sm font-bold text-foreground">Chunks (<%= @chunks.count %>)</h2>
        </div>
        <% if @chunks.any? %>
          <div class="divide-y divide-border">
            <% @chunks.each do |chunk| %>
              <div class="px-6 py-4">
                <div class="flex items-center justify-between mb-2">
                  <span class="text-xs font-semibold text-muted-foreground">Chunk #<%= chunk.chunk_index %></span>
                  <span class="text-xs text-muted-foreground"><%= chunk.token_count %> tokens</span>
                </div>
                <pre class="whitespace-pre-wrap text-sm text-foreground font-mono"><%= chunk.content %></pre>
              </div>
            <% end %>
          </div>
        <% else %>
          <div class="px-6 py-8 text-center">
            <p class="text-sm text-muted-foreground">No chunks created yet. Chunks are generated when embeddings are processed.</p>
          </div>
        <% end %>
      </div>
    </div>

    <div class="space-y-6">
      <div class="overflow-hidden rounded-2xl border border-border bg-card shadow-sm">
        <div class="border-b border-border px-6 py-4">
          <h2 class="text-sm font-bold text-foreground">Details</h2>
        </div>
        <dl class="divide-y divide-border">
          <div class="px-6 py-3 flex items-center justify-between">
            <dt class="text-sm text-muted-foreground">Category</dt>
            <dd class="text-sm font-semibold text-foreground capitalize"><%= @document.category %></dd>
          </div>
          <div class="px-6 py-3 flex items-center justify-between">
            <dt class="text-sm text-muted-foreground">Source</dt>
            <dd class="text-sm font-semibold text-foreground capitalize"><%= @document.source_type %></dd>
          </div>
          <div class="px-6 py-3 flex items-center justify-between">
            <dt class="text-sm text-muted-foreground">Language</dt>
            <dd class="text-sm font-semibold text-foreground uppercase"><%= @document.language %></dd>
          </div>
          <div class="px-6 py-3 flex items-center justify-between">
            <dt class="text-sm text-muted-foreground">Version</dt>
            <dd class="text-sm font-semibold text-foreground"><%= @document.version %></dd>
          </div>
          <div class="px-6 py-3 flex items-center justify-between">
            <dt class="text-sm text-muted-foreground">Effective Date</dt>
            <dd class="text-sm font-semibold text-foreground"><%= @document.effective_date&.to_fs(:long) || "Forever" %></dd>
          </div>
          <div class="px-6 py-3 flex items-center justify-between">
            <dt class="text-sm text-muted-foreground">Embedding Status</dt>
            <dd><span class="inline-flex items-center rounded-full px-2.5 py-0.5 text-xs font-semibold capitalize
              <%= @document.embedding_status == "indexed" ? "bg-emerald-50 text-emerald-700" :
                 @document.embedding_status == "failed" ? "bg-red-50 text-red-700" :
                 @document.embedding_status == "indexing" ? "bg-blue-50 text-blue-700" :
                 "bg-amber-50 text-amber-700" %>"><%= @document.embedding_status %></span></dd>
          </div>
          <% if @document.embedding_status == "failed" && @document.metadata&.dig("last_error").present? %>
            <div class="px-6 py-3">
              <dt class="text-sm text-muted-foreground mb-1">Error</dt>
              <dd class="text-xs text-red-600 bg-red-50 rounded-lg px-3 py-2 break-words"><%= @document.metadata["last_error"] %></dd>
            </div>
          <% end %>
          <div class="px-6 py-3 flex items-center justify-between">
            <dt class="text-sm text-muted-foreground">Tags</dt>
            <dd class="text-sm font-semibold text-foreground">
              <% if @document.tags.any? %>
                <div class="flex flex-wrap gap-1 justify-end">
                  <% @document.tags.each do |tag| %>
                    <span class="inline-flex items-center rounded-full bg-muted px-2 py-0.5 text-xs font-medium text-muted-foreground"><%= tag %></span>
                  <% end %>
                </div>
              <% else %>
                <span class="text-muted-foreground">—</span>
              <% end %>
            </dd>
          </div>
          <div class="px-6 py-3 flex items-center justify-between">
            <dt class="text-sm text-muted-foreground">Created</dt>
            <dd class="text-sm text-foreground"><%= @document.created_at.to_fs(:short) %></dd>
          </div>
          <div class="px-6 py-3 flex items-center justify-between">
            <dt class="text-sm text-muted-foreground">Updated</dt>
            <dd class="text-sm text-foreground"><%= @document.updated_at.to_fs(:short) %></dd>
          </div>
        </dl>
      </div>
    </div>
  </div>
</div>
