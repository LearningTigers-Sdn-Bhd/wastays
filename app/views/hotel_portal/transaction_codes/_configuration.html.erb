<section class="rounded-xl border border-slate-200 bg-white shadow-sm" data-testid="transaction-code-configuration-card">
  <div class="border-b border-slate-200 px-5 py-4">
    <h2 class="text-base font-bold text-slate-950">Room Revenue Settings</h2>
    <p class="mt-1 text-sm font-medium text-slate-500">Control how ROOM transaction code tax rule changes apply to booking and folio forecasts.</p>
  </div>

  <%= form_with model: configuration,
                url: hotel_transaction_code_configuration_path(current_hotel),
                method: :patch,
                local: true,
                class: "space-y-5 p-5" do |f| %>
    <% if configuration.errors.any? %>
      <div class="rounded-lg border border-red-200 bg-red-50 px-4 py-3 text-sm font-medium text-red-700">
        <%= configuration.errors.full_messages.to_sentence %>
      </div>
    <% end %>

    <div>
      <p class="text-sm font-bold text-slate-900">Apply changes to</p>
      <div class="mt-3 grid gap-3 md:grid-cols-2">
        <%= f.label :room_revenue_tax_rule_application_new_bookings_only,
                    class: "block cursor-pointer rounded-xl border border-slate-200 p-4 transition has-[:checked]:border-blue-500 has-[:checked]:bg-blue-50 has-[:checked]:ring-1 has-[:checked]:ring-blue-500" do %>
          <div class="flex items-start gap-3">
            <%= f.radio_button :room_revenue_tax_rule_application,
                               "new_bookings_only",
                               id: "hotel_transaction_configuration_room_revenue_tax_rule_application_new_bookings_only",
                               class: "mt-1 size-4 border-slate-300 text-blue-600 focus:ring-blue-500" %>
            <div>
              <p class="text-sm font-bold text-slate-950">New bookings only</p>
              <p class="mt-1 text-sm font-medium text-slate-500">New booking tax snapshots use ROOM transaction code tax rules. Existing open folio forecasts stay unchanged.</p>
            </div>
          </div>
        <% end %>

        <%= f.label :room_revenue_tax_rule_application_open_folio_forecasts,
                    class: "block cursor-pointer rounded-xl border border-slate-200 p-4 transition has-[:checked]:border-amber-500 has-[:checked]:bg-amber-50 has-[:checked]:ring-1 has-[:checked]:ring-amber-500" do %>
          <div class="flex items-start gap-3">
            <%= f.radio_button :room_revenue_tax_rule_application,
                               "open_folio_forecasts",
                               id: "hotel_transaction_configuration_room_revenue_tax_rule_application_open_folio_forecasts",
                               class: "mt-1 size-4 border-slate-300 text-amber-600 focus:ring-amber-500" %>
            <div>
              <p class="text-sm font-bold text-slate-950">New bookings + upcoming transactions on open folios</p>
              <p class="mt-1 text-sm font-medium text-slate-500">Also recalculates unposted forecasted charges on open folios immediately.</p>
              <p class="mt-2 text-xs font-semibold text-amber-700">May affect guest booking contract totals because unposted forecast snapshots can change.</p>
            </div>
          </div>
        <% end %>
      </div>
    </div>

    <div class="flex justify-end">
      <%= f.submit "Save Configuration", class: "inline-flex items-center rounded-lg bg-slate-900 px-4 py-2 text-sm font-bold text-white transition hover:bg-slate-700" %>
    </div>
  <% end %>
</section>
