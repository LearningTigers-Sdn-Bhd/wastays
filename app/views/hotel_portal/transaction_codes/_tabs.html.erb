<div class="rounded-xl border border-slate-200 bg-white p-1.5 shadow-sm" data-testid="transaction-codes-tabs">
  <nav class="flex items-center gap-1 overflow-x-auto" aria-label="Transaction code sections" role="tablist">
    <% presenter.tabs.each do |tab| %>
      <button type="button"
              data-tabs-target="tab"
              data-tab-name="<%= tab[:name] %>"
              data-tab-label="<%= tab[:label] %>"
              data-action="click->tabs#switch"
              data-active="<%= presenter.active_tab == tab[:name] %>"
              class="group inline-flex h-9 items-center gap-2 whitespace-nowrap rounded-lg px-4 text-sm font-medium text-slate-600 transition-all duration-150 hover:bg-slate-50 hover:text-slate-900 data-[active=true]:bg-blue-600 data-[active=true]:font-semibold data-[active=true]:text-white"
              aria-controls="<%= tab[:name] %>-panel"
              role="tab">
        <%= cached_icon tab[:icon], class: "size-4", aria: { hidden: true } %>
        <span><%= tab[:label] %></span>
      </button>
    <% end %>
  </nav>
</div>
