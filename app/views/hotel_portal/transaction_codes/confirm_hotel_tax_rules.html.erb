<%= turbo_frame_tag "offcanvas_drawer", data: { offcanvas_variant: "fullscreen-bottom" } do %>
  <div class="fixed inset-0 z-[120] flex items-center justify-center bg-primary/60 p-4 backdrop-blur-sm"
       role="alertdialog"
       aria-modal="true"
       aria-labelledby="hotel-tax-rules-confirmation-title"
       aria-describedby="hotel-tax-rules-confirmation-description">
    <div class="relative z-[130] w-full max-w-2xl overflow-hidden rounded-2xl bg-card shadow-2xl">
      <header class="border-b border-amber-200 bg-amber-50 px-6 py-5">
        <p class="text-xs font-bold uppercase tracking-[0.18em] text-amber-700">Hotel-wide configuration</p>
        <h2 id="hotel-tax-rules-confirmation-title" class="mt-1 text-xl font-black text-foreground">Change hotel default?</h2>
        <p id="hotel-tax-rules-confirmation-description" class="mt-2 text-sm font-medium text-foreground">
          This changes tax and charge inclusions for <strong><%= @transaction_code.code %> · <%= @transaction_code.name %></strong> across this hotel.
        </p>
      </header>

      <%= form_with model: @transaction_code,
                    url: hotel_transaction_code_path(current_hotel, @transaction_code),
                    method: :patch,
                    data: { turbo_frame: "offcanvas_drawer" } do |f| %>
        <% @reviewed_attributes.each do |key, value| %>
          <% next if key.to_s.in?(%w[tax_rule_keys hotel_tax_ids]) %>
          <%= hidden_field_tag "transaction_code[#{key}]", value %>
        <% end %>
        <%= hidden_field_tag "transaction_code[tax_rule_keys][]", "" %>
        <% @tax_rule_change.after_keys.each do |key| %>
          <%= hidden_field_tag "transaction_code[tax_rule_keys][]", key %>
        <% end %>
        <%= hidden_field_tag :confirm_hotel_tax_rules, "1" %>
        <%= hidden_field_tag :freshness_token, @tax_rule_change.freshness_token %>

        <div class="space-y-5 px-6 py-5">
          <div class="grid gap-4 sm:grid-cols-2">
            <section class="rounded-xl border border-emerald-200 bg-emerald-50 p-4">
              <h3 class="text-xs font-bold uppercase tracking-wider text-emerald-800">Added</h3>
              <p class="mt-2 text-sm font-semibold text-emerald-950"><%= @tax_rule_change.added_labels.presence&.to_sentence || "None" %></p>
            </section>
            <section class="rounded-xl border border-rose-200 bg-rose-50 p-4">
              <h3 class="text-xs font-bold uppercase tracking-wider text-rose-800">Removed</h3>
              <p class="mt-2 text-sm font-semibold text-rose-950"><%= @tax_rule_change.removed_labels.presence&.to_sentence || "None" %></p>
            </section>
          </div>

          <section class="rounded-xl border border-border p-4">
            <h3 class="text-sm font-bold text-foreground">Impact</h3>
            <% if @tax_rule_change.forecast_policy == "open_folio_forecasts" %>
              <p class="mt-2 text-sm text-foreground"><strong><%= @tax_rule_change.forecast_count %> upcoming transactions</strong> totalling <strong><%= number_to_currency(@tax_rule_change.forecast_amount, unit: "#{current_hotel.default_currency} ") %></strong> on eligible open folios will be recalculated.</p>
            <% elsif @tax_rule_change.forecast_policy == "new_bookings_only" %>
              <p class="mt-2 text-sm text-foreground">New bookings will use these ROOM defaults. Existing open-folio forecasts remain unchanged.</p>
            <% else %>
              <p class="mt-2 text-sm text-foreground">Future manual postings of this code will use these defaults. Existing forecasts remain unchanged.</p>
            <% end %>
            <p class="mt-3 rounded-lg bg-muted px-3 py-2 text-sm font-semibold text-foreground">Posted transactions will not change.</p>
          </section>

          <div>
            <%= label_tag :reason, "Reason", class: "mb-1.5 block text-sm font-bold text-foreground" %>
            <%= text_field_tag :reason, nil, required: true, autofocus: true, class: "w-full rounded-xl border-border-interactive text-sm", placeholder: "Why is this hotel-wide default changing?" %>
          </div>
        </div>

        <footer class="flex justify-end gap-3 border-t border-border bg-muted px-6 py-4">
          <%= link_to "Go back", hotel_edit_transaction_code_path(current_hotel, @transaction_code, transaction_code: @reviewed_attributes), data: { turbo_frame: "offcanvas_drawer" }, class: "rounded-lg border border-border-interactive bg-card px-4 py-2 text-sm font-bold text-foreground" %>
          <%= f.submit "Apply hotel-wide", class: "rounded-lg bg-amber-600 px-4 py-2 text-sm font-bold text-primary-foreground hover:bg-amber-700", data: { turbo_submits_with: "Applying..." } %>
        </footer>
      <% end %>
    </div>
  </div>
<% end %>
