<% transaction_codes = local_assigns.fetch(:transaction_codes) %>

<section class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm" data-testid="<%= local_assigns.fetch(:test_id) %>">
  <div class="border-b border-slate-200 px-5 py-4">
    <h2 class="text-base font-bold tracking-tight text-slate-950"><%= local_assigns.fetch(:title) %></h2>
    <p class="mt-1 text-sm font-medium text-slate-600"><%= local_assigns.fetch(:description) %></p>
  </div>

  <% if transaction_codes.any? %>
    <div class="overflow-x-auto">
    <table class="min-w-full divide-y divide-slate-200 text-left text-sm">
      <thead class="bg-slate-50 text-xs font-semibold uppercase tracking-wide text-slate-500">
        <tr>
          <th scope="col" class="px-5 py-3">Code</th>
          <th scope="col" class="px-5 py-3">Name</th>
          <th scope="col" class="px-5 py-3">Kind</th>
          <th scope="col" class="px-5 py-3">Category</th>
          <th scope="col" class="px-5 py-3">GL Account Code</th>
          <th scope="col" class="px-5 py-3">Taxable</th>
          <th scope="col" class="px-5 py-3">Status</th>
          <th scope="col" class="px-5 py-3">Required</th>
          <th scope="col" class="px-5 py-3 text-right">Actions</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-slate-100 bg-white text-slate-700">
        <% transaction_codes.each do |transaction_code| %>
          <tr class="hover:bg-slate-50">
            <td class="whitespace-nowrap px-5 py-4 font-mono text-sm font-semibold text-slate-950"><%= transaction_code.code %></td>
            <td class="whitespace-nowrap px-5 py-4 font-semibold text-slate-900"><%= transaction_code.name %></td>
            <td class="whitespace-nowrap px-5 py-4"><%= transaction_code.kind.titleize %></td>
            <td class="whitespace-nowrap px-5 py-4"><%= transaction_code.category.titleize %></td>
            <td class="whitespace-nowrap px-5 py-4 font-mono text-slate-700"><%= transaction_code.gl_account_code.presence || "-" %></td>
            <td class="whitespace-nowrap px-5 py-4">
              <% taxable_class = transaction_code.is_taxable? ? "bg-emerald-50 text-emerald-700 ring-emerald-200" : "bg-slate-100 text-slate-600 ring-slate-200" %>
              <span class="inline-flex items-center rounded-full px-2.5 py-1 text-xs font-semibold ring-1 ring-inset <%= taxable_class %>"><%= transaction_code.is_taxable? ? "Yes" : "No" %></span>
            </td>
            <td class="whitespace-nowrap px-5 py-4">
              <% status_class = transaction_code.active? ? "bg-emerald-50 text-emerald-700 ring-emerald-200" : "bg-slate-100 text-slate-600 ring-slate-200" %>
              <span class="inline-flex items-center rounded-full px-2.5 py-1 text-xs font-semibold ring-1 ring-inset <%= status_class %>"><%= transaction_code.active? ? "Active" : "Inactive" %></span>
            </td>
            <td class="whitespace-nowrap px-5 py-4">
              <span class="inline-flex items-center rounded-full bg-blue-50 px-2.5 py-1 text-xs font-semibold text-blue-700 ring-1 ring-inset ring-blue-200"><%= transaction_code.system_required? ? "Yes" : "No" %></span>
            </td>
            <td class="whitespace-nowrap px-5 py-4 text-right">
              <%= link_to "Edit",
                          hotel_edit_transaction_code_path(current_hotel, transaction_code),
                          data: { turbo_frame: "offcanvas_drawer", offcanvas_variant: "fullscreen-bottom" },
                          class: "inline-flex items-center rounded-md border border-slate-200 bg-white px-3 py-1.5 text-xs font-bold text-slate-700 transition hover:bg-slate-50" %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
    </div>
  <% else %>
    <div class="px-5 py-10 text-center">
      <p class="text-sm font-medium text-slate-600"><%= local_assigns.fetch(:empty_message) %></p>
    </div>
  <% end %>
</section>
