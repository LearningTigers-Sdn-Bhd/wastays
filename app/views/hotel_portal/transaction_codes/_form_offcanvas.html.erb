<%= turbo_frame_tag "offcanvas_drawer", data: { offcanvas_variant: "fullscreen-bottom" } do %>
  <% persisted = transaction_code.persisted? %>
  <% selected_taxes = transaction_code.taxes.to_a %>
  <% preview_amount = 50.to_d %>
  <% preview_taxes = selected_taxes.select(&:enabled?) %>
  <% preview_tax_lines = transaction_code.is_taxable? ? preview_taxes.map { |tax| [tax, tax.compute(rooms_subtotal: preview_amount).to_d] } : [] %>
  <% preview_total = preview_amount + preview_tax_lines.sum { |_tax, amount| amount } %>

  <div class="flex h-full min-h-0 flex-col bg-slate-100">
    <header class="z-10 shrink-0 border-b border-slate-200 bg-white">
      <div class="mx-auto flex max-w-[1100px] items-start justify-between gap-4 px-4 py-4 sm:px-6">
        <div class="min-w-0">
          <p class="text-[10px] font-bold uppercase tracking-[0.2em] text-slate-400">Transaction Codes</p>
          <h2 class="mt-0.5 text-lg font-bold tracking-tight text-slate-950"><%= title %></h2>
          <p class="mt-1 text-xs font-medium text-slate-500">Configure posting presets and optional tax rules for folio transactions.</p>
        </div>
        <button type="button" class="rounded-md p-1.5 text-slate-400 transition hover:bg-slate-100 hover:text-slate-700" data-action="click->offcanvas#close" aria-label="Close transaction code form">
          <%= cached_icon "x", stroke_width: 2.5, class: "size-5" %>
        </button>
      </div>
    </header>

    <%= form_with model: transaction_code,
                  url: persisted ? hotel_transaction_code_path(current_hotel, transaction_code) : hotel_transaction_codes_path(current_hotel),
                  method: persisted ? :patch : :post,
                  class: "flex min-h-0 flex-1 flex-col",
                  data: { turbo_frame: "_top" } do |f| %>
      <div class="min-h-0 flex-1 overflow-y-auto">
        <div class="mx-auto max-w-[1100px] space-y-5 p-4 sm:p-6">
          <% if transaction_code.errors.any? %>
            <div class="rounded-xl border border-red-200 bg-red-50 px-4 py-3 text-sm font-semibold text-red-800" data-controller="auto-scroll-top">
              <%= transaction_code.errors.full_messages.to_sentence %>
            </div>
          <% end %>

          <section class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
            <div class="border-b border-slate-100 pb-3">
              <h3 class="text-sm font-bold text-slate-950">Basic</h3>
              <p class="mt-1 text-xs font-medium text-slate-500">These fields control how the code appears and which folio category it posts into.</p>
            </div>

            <div class="mt-5 grid gap-5 md:grid-cols-2">
              <div>
                <%= f.label :code, "Code", class: "mb-1.5 block text-sm font-semibold text-slate-900" %>
                <%= f.text_field :code, class: "w-full rounded-xl border border-slate-200 px-4 py-3 text-sm font-semibold uppercase text-slate-700 focus:border-slate-400 focus:outline-none focus:ring-0" %>
              </div>

              <div>
                <%= f.label :name, "Name", class: "mb-1.5 block text-sm font-semibold text-slate-900" %>
                <%= f.text_field :name, class: "w-full rounded-xl border border-slate-200 px-4 py-3 text-sm text-slate-700 focus:border-slate-400 focus:outline-none focus:ring-0" %>
              </div>

              <div>
                <%= f.label :kind, "Kind", class: "mb-1.5 block text-sm font-semibold text-slate-900" %>
                <%= f.select :kind, TransactionCode::KINDS.map { |kind| [kind.titleize, kind] }, {}, class: "w-full rounded-xl border border-slate-200 px-4 py-3 text-sm text-slate-700 focus:border-slate-400 focus:outline-none focus:ring-0" %>
              </div>

              <div>
                <%= f.label :category, "Category", class: "mb-1.5 block text-sm font-semibold text-slate-900" %>
                <%= f.select :category, TransactionCode::CATEGORIES.map { |category| [category.titleize, category] }, {}, class: "w-full rounded-xl border border-slate-200 px-4 py-3 text-sm text-slate-700 focus:border-slate-400 focus:outline-none focus:ring-0" %>
              </div>

              <div>
                <%= f.label :gl_account_code, "GL Account Code", class: "mb-1.5 block text-sm font-semibold text-slate-900" %>
                <%= f.text_field :gl_account_code, class: "w-full rounded-xl border border-slate-200 px-4 py-3 text-sm font-mono text-slate-700 focus:border-slate-400 focus:outline-none focus:ring-0" %>
              </div>

              <div>
                <span class="mb-2 block text-sm font-semibold text-slate-900">Status</span>
                <%= render "hotel_portal/taxes_fees/status_toggle", form: f, field: :active, checked: transaction_code.active?, label: "Active" %>
              </div>
            </div>
          </section>

          <section class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
            <div class="border-b border-slate-100 pb-3">
              <h3 class="text-sm font-bold text-slate-950">Tax Rules</h3>
              <p class="mt-1 text-xs font-medium text-slate-500">Linked inactive taxes are saved here but skipped when a charge is posted.</p>
            </div>

            <div class="mt-5 space-y-4">
              <%= render "hotel_portal/taxes_fees/status_toggle", form: f, field: :is_taxable, checked: transaction_code.is_taxable?, label: "Taxable" %>

              <div>
                <p class="mb-2 text-sm font-semibold text-slate-900">Taxes to generate</p>
                <% if taxes.any? %>
                  <div class="grid gap-2 md:grid-cols-2">
                    <%= f.collection_check_boxes :hotel_tax_ids, taxes, :id, :name do |box| %>
                      <% tax = box.object %>
                      <label class="flex min-h-12 items-center justify-between gap-4 rounded-xl border border-slate-200 bg-white px-4 py-3 <%= tax.enabled? ? "" : "opacity-70" %>">
                        <span>
                          <span class="block text-sm font-semibold text-slate-800"><%= tax.name %></span>
                          <span class="mt-0.5 block text-xs font-medium text-slate-500">
                            <%= tax.rate_type == "percentage" ? "#{number_with_precision(tax.amount, precision: 2)}%" : "#{current_hotel.default_currency.presence || "MYR"} #{number_with_precision(tax.amount, precision: 2)}" %>
                            <% unless tax.enabled? %> · Inactive<% end %>
                          </span>
                        </span>
                        <%= box.check_box class: "size-4 rounded border-slate-300 text-slate-900 focus:ring-slate-900" %>
                      </label>
                    <% end %>
                  </div>
                <% else %>
                  <div class="rounded-xl border border-dashed border-slate-200 px-4 py-6 text-center text-sm font-medium text-slate-500">No taxes or fees configured yet.</div>
                <% end %>
              </div>
            </div>
          </section>

          <section class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
            <div class="border-b border-slate-100 pb-3">
              <h3 class="text-sm font-bold text-slate-950">Preview</h3>
              <p class="mt-1 text-xs font-medium text-slate-500">If staff posts <%= transaction_code.code.presence || "this code" %> RM 50.00:</p>
            </div>

            <div class="mt-4 space-y-2 text-sm">
              <div class="flex items-center justify-between gap-4">
                <span class="font-semibold text-slate-800"><%= transaction_code.name.presence || "Charge" %></span>
                <span class="font-mono text-slate-900">RM <%= number_with_precision(preview_amount, precision: 2) %></span>
              </div>
              <% preview_tax_lines.each do |tax, amount| %>
                <div class="flex items-center justify-between gap-4 text-slate-600">
                  <span><%= tax.name %></span>
                  <span class="font-mono">RM <%= number_with_precision(amount, precision: 2) %></span>
                </div>
              <% end %>
              <div class="flex items-center justify-between gap-4 border-t border-slate-100 pt-2 font-bold text-slate-950">
                <span>Total</span>
                <span class="font-mono">RM <%= number_with_precision(preview_total, precision: 2) %></span>
              </div>
            </div>
          </section>
        </div>
      </div>

      <footer class="z-10 shrink-0 border-t border-slate-200 bg-white px-4 py-3 shadow-[0_-4px_12px_rgba(15,23,42,0.06)] sm:px-6">
        <div class="mx-auto flex max-w-[1100px] items-center justify-end gap-2">
          <button type="button" class="rounded-md px-4 py-2 text-sm font-semibold text-slate-600 transition hover:bg-slate-100" data-action="click->offcanvas#close">Cancel</button>
          <%= f.submit submit_label, class: "cursor-pointer rounded-md bg-slate-900 px-5 py-2 text-sm font-bold text-white transition hover:bg-slate-700", data: { turbo_submits_with: "Saving..." } %>
        </div>
      </footer>
    <% end %>
  </div>
<% end %>
