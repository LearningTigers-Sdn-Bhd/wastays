<%= turbo_frame_tag "offcanvas_drawer", data: { offcanvas_variant: "fullscreen-bottom" } do %>
  <% persisted = transaction_code.persisted? %>
  <% preview_amount = 50.to_d %>
  <% currency = current_hotel.default_currency.presence || "MYR" %>
  <% selected_tax_rule_keys = transaction_code.tax_rule_keys %>
  <% tax_transaction_code = transaction_code.kind == "tax" || transaction_code.category == "tax" %>
  <% locked_kind_category = persisted && (transaction_code.system_required? || tax_transaction_code || current_hotel.hotel_taxes.exists?(transaction_code_id: transaction_code.id)) %>
  <% kind_options = TransactionCode::KINDS.reject { |kind| kind == "tax" }.map { |kind| [kind.titleize, kind] } %>
  <% category_options = TransactionCode::CATEGORIES.reject { |category| category.in?(%w[tax security_deposit]) }.map { |category| [category.titleize, category] } %>

  <div class="flex h-full min-h-0 flex-col bg-slate-100">
    <header class="z-10 shrink-0 border-b border-slate-200 bg-white">
      <div class="mx-auto flex max-w-[1100px] items-start justify-between gap-4 px-4 py-4 sm:px-6">
        <div class="min-w-0">
          <p class="text-[10px] font-bold uppercase tracking-[0.2em] text-slate-400">Transaction Codes</p>
          <h2 class="mt-0.5 text-lg font-bold tracking-tight text-slate-950"><%= title %></h2>
          <p class="mt-1 text-xs font-medium text-slate-500">Configure posting presets and optional tax rules for folio transactions.</p>
        </div>
        <button type="button" class="rounded-md p-1.5 text-slate-400 transition hover:bg-slate-100 hover:text-slate-700" data-action="click->offcanvas#close" aria-label="Close transaction code form">
          <%= cached_icon "x", stroke_width: 2.5, class: "size-5" %>
        </button>
      </div>
    </header>

    <%= form_with model: transaction_code,
                  url: persisted ? hotel_preview_transaction_code_hotel_tax_rules_path(current_hotel, transaction_code) : hotel_transaction_codes_path(current_hotel),
                  method: persisted ? :patch : :post,
                  class: "flex min-h-0 flex-1 flex-col",
                  data: {
                    turbo_frame: persisted ? "offcanvas_drawer" : "_top",
                    controller: "transaction-code-form",
                    transaction_code_form_amount_value: preview_amount.to_s("F"),
                    transaction_code_form_currency_value: currency
                  } do |f| %>
      <div class="min-h-0 flex-1 overflow-y-auto">
        <div class="mx-auto max-w-[1100px] space-y-5 p-4 sm:p-6">
          <% if transaction_code.errors.any? %>
            <div class="rounded-xl border border-red-200 bg-red-50 px-4 py-3 text-sm font-semibold text-red-800" data-controller="auto-scroll-top">
              <%= transaction_code.errors.full_messages.to_sentence %>
            </div>
          <% end %>

          <section class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
            <div class="border-b border-slate-100 pb-3">
              <h3 class="text-sm font-bold text-slate-950">Basic</h3>
              <p class="mt-1 text-xs font-medium text-slate-500">These fields control how the code appears and which folio category it posts into.</p>
            </div>

            <div class="mt-5 grid gap-5 md:grid-cols-2">
              <div>
                <%= f.label :code, "Code", class: "mb-1.5 block text-sm font-semibold text-slate-900" %>
                <%= f.text_field :code, class: "w-full rounded-xl border border-slate-200 px-4 py-3 text-sm font-semibold uppercase text-slate-700 focus:border-slate-400 focus:outline-none focus:ring-0" %>
              </div>

              <div>
                <%= f.label :name, "Name", class: "mb-1.5 block text-sm font-semibold text-slate-900" %>
                <%= f.text_field :name,
                    data: { transaction_code_form_target: "name", action: "input->transaction-code-form#update" },
                    class: "w-full rounded-xl border border-slate-200 px-4 py-3 text-sm text-slate-700 focus:border-slate-400 focus:outline-none focus:ring-0" %>
              </div>

              <div>
                <%= f.label :kind, "Kind", class: "mb-1.5 block text-sm font-semibold text-slate-900" %>
                <% if locked_kind_category %>
                  <div class="w-full rounded-xl border border-slate-200 bg-slate-50 px-4 py-3 text-sm font-semibold text-slate-700"><%= transaction_code.kind.to_s.titleize %></div>
                  <%= f.hidden_field :kind, data: { transaction_code_form_target: "kind" } %>
                <% else %>
                  <%= f.select :kind,
                      kind_options,
                      {},
                      data: { transaction_code_form_target: "kind", action: "change->transaction-code-form#update" },
                      class: "w-full rounded-xl border border-slate-200 px-4 py-3 text-sm text-slate-700 focus:border-slate-400 focus:outline-none focus:ring-0" %>
                <% end %>
              </div>

              <div>
                <%= f.label :category, "Category", class: "mb-1.5 block text-sm font-semibold text-slate-900" %>
                <% if locked_kind_category %>
                  <div class="w-full rounded-xl border border-slate-200 bg-slate-50 px-4 py-3 text-sm font-semibold text-slate-700"><%= transaction_code.category.to_s.titleize %></div>
                  <%= f.hidden_field :category, data: { transaction_code_form_target: "category" } %>
                <% else %>
                  <%= f.select :category,
                      category_options,
                      {},
                      data: { transaction_code_form_target: "category", action: "change->transaction-code-form#update" },
                      class: "w-full rounded-xl border border-slate-200 px-4 py-3 text-sm text-slate-700 focus:border-slate-400 focus:outline-none focus:ring-0" %>
                <% end %>
              </div>

              <div>
                <%= f.label :gl_account_code, "GL Account Code", class: "mb-1.5 block text-sm font-semibold text-slate-900" %>
                <%= f.text_field :gl_account_code, class: "w-full rounded-xl border border-slate-200 px-4 py-3 text-sm font-mono text-slate-700 focus:border-slate-400 focus:outline-none focus:ring-0" %>
              </div>

              <div>
                <span class="mb-2 block text-sm font-semibold text-slate-900">Status</span>
                <%= render "hotel_portal/taxes_fees/status_toggle", form: f, field: :active, checked: transaction_code.active?, label: "Active" %>
              </div>
            </div>
          </section>

          <section class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm" data-transaction-code-form-target="taxRules">
            <div class="border-b border-slate-100 pb-3">
              <h3 class="text-sm font-bold text-slate-950">Tax Rules</h3>
              <p class="mt-1 text-xs font-medium text-slate-500">Linked inactive taxes are saved here but skipped when a charge is posted.</p>
            </div>

            <div class="mt-5 space-y-4">
              <label class="flex min-h-12 items-center justify-between gap-4 rounded-xl border border-slate-200 bg-white px-4 py-3">
                <span>
                  <span class="block text-sm font-medium text-slate-600">Taxable</span>
                  <span class="mt-0.5 block text-xs font-medium text-slate-400">Apply selected active taxes when this charge is posted.</span>
                </span>
                <span class="relative inline-flex items-center">
                  <%= f.check_box :is_taxable,
                      {
                        checked: transaction_code.is_taxable?,
                        class: "sr-only peer",
                        data: { transaction_code_form_target: "taxable", action: "change->transaction-code-form#update" }
                      },
                      "1",
                      "0" %>
                  <span class="peer h-6 w-11 rounded-full bg-red-200 transition after:absolute after:left-[2px] after:top-[2px] after:h-5 after:w-5 after:rounded-full after:bg-white after:transition-all after:content-[''] peer-checked:bg-emerald-600 peer-checked:after:translate-x-full"></span>
                </span>
              </label>

              <div data-transaction-code-form-target="taxList">
                <p class="mb-2 text-sm font-semibold text-slate-900">Taxes to generate</p>
                <% if tax_rules.any? %>
                  <%= hidden_field_tag "transaction_code[tax_rule_keys][]", "" %>
                  <div class="space-y-4">
                    <% tax_rules.group_by { |tax_rule| tax_rule[:group] }.each do |group, grouped_tax_rules| %>
                      <div>
                        <p class="mb-2 text-[10px] font-bold uppercase tracking-wider text-slate-400"><%= group %></p>
                        <div class="grid gap-2 md:grid-cols-2">
                          <% grouped_tax_rules.each do |tax_rule| %>
                            <label class="flex min-h-12 items-center justify-between gap-4 rounded-xl border border-slate-200 bg-white px-4 py-3 <%= tax_rule[:enabled] ? "" : "opacity-70" %>">
                              <span>
                                <span class="block text-sm font-semibold text-slate-800"><%= tax_rule[:name] %></span>
                                <span class="mt-0.5 block text-xs font-medium text-slate-500">
                                  <%= tax_rule[:rate_type] == "percentage" ? "#{number_with_precision(tax_rule[:amount], precision: 2)}%" : "#{currency} #{number_with_precision(tax_rule[:amount], precision: 2)}" %>
                                  <% unless tax_rule[:enabled] %> · Inactive<% end %>
                                </span>
                              </span>
                              <%= check_box_tag "transaction_code[tax_rule_keys][]",
                                    tax_rule[:key],
                                    selected_tax_rule_keys.include?(tax_rule[:key]),
                                    class: "size-4 rounded border-slate-300 text-slate-900 focus:ring-slate-900",
                                    data: {
                                      transaction_code_form_target: "taxCheckbox",
                                      action: "change->transaction-code-form#update",
                                      name: tax_rule[:name],
                                      amount: tax_rule[:amount].to_d.to_s("F"),
                                      rate_type: tax_rule[:rate_type],
                                      enabled: tax_rule[:enabled].to_s
                                    } %>
                            </label>
                          <% end %>
                        </div>
                      </div>
                    <% end %>
                  </div>
                <% else %>
                  <div class="rounded-xl border border-dashed border-slate-200 px-4 py-6 text-center text-sm font-medium text-slate-500">No taxes or fees configured yet.</div>
                <% end %>
              </div>
            </div>
          </section>
        </div>
      </div>

      <footer class="z-10 shrink-0 border-t border-slate-200 bg-white px-4 py-3 shadow-[0_-4px_12px_rgba(15,23,42,0.06)] sm:px-6">
        <div class="mx-auto max-w-[1100px] space-y-3">
          <section class="overflow-hidden rounded-xl border border-slate-200 bg-white" aria-label="Transaction code posting preview">
            <div class="flex items-center justify-between gap-3 border-b border-slate-200 bg-slate-50 px-3 py-2">
              <div>
                <h3 class="text-[10px] font-bold uppercase tracking-wider text-slate-700">Preview</h3>
                <p class="mt-0.5 text-[10px] font-medium text-slate-500">If staff posts this code at <%= currency %> <%= number_with_precision(preview_amount, precision: 2) %></p>
              </div>
              <span class="text-[10px] font-semibold uppercase tracking-wider text-slate-500">Sample transaction</span>
            </div>
            <div class="divide-y divide-slate-100">
              <div class="grid grid-cols-[1fr_auto] items-center gap-4 px-3 py-2 text-xs">
                <div class="min-w-0">
                  <p class="truncate font-semibold text-slate-900" data-transaction-code-form-target="previewName"><%= transaction_code.name.presence || "Charge" %></p>
                  <p class="mt-0.5 text-[9px] font-bold uppercase tracking-wider text-slate-500" data-transaction-code-form-target="previewCategory"><%= transaction_code.kind.to_s.titleize %> · <%= transaction_code.category.to_s.titleize %></p>
                </div>
                <p class="font-mono font-bold tabular-nums text-slate-900">+<%= currency %> <%= number_with_precision(preview_amount, precision: 2) %></p>
              </div>
              <div data-transaction-code-form-target="previewTaxLines"></div>
              <div class="grid grid-cols-[1fr_auto] items-center gap-4 bg-slate-50 px-3 py-2 text-xs font-bold text-slate-950">
                <span>Total</span>
                <span class="font-mono tabular-nums"><%= currency %> <span data-transaction-code-form-target="previewTotal"><%= number_with_precision(preview_amount, precision: 2) %></span></span>
              </div>
            </div>
          </section>

          <div class="flex items-center justify-end gap-2">
            <button type="button" class="rounded-md px-4 py-2 text-sm font-semibold text-slate-600 transition hover:bg-slate-100" data-action="click->offcanvas#close">Cancel</button>
            <%= f.submit submit_label, class: "cursor-pointer rounded-md bg-slate-900 px-5 py-2 text-sm font-bold text-white transition hover:bg-slate-700", data: { turbo_submits_with: "Saving..." } %>
          </div>
        </div>
      </footer>
    <% end %>
  </div>
<% end %>
