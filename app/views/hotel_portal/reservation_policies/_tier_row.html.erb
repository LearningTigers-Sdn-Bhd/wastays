<div class="rounded-md border border-border bg-card p-3" data-reservation-policy-form-target="row">
  <%= tier_form.hidden_field :id %>
  <%= tier_form.hidden_field :_destroy, value: "0", data: { role: "destroy" } %>

  <div class="grid gap-3 sm:grid-cols-[7rem_1fr_7rem_auto] sm:items-end">
    <%= render PanelsUI::FormField.new(form: tier_form, attribute: :days_before_arrival, label: "Days out", size: :sm) do |field| %>
      <% field.with_input(type: :number, min: 0, step: 1, inputmode: "numeric") %>
    <% end %>

    <%= render PanelsUI::FormField.new(form: tier_form, attribute: :pricing_type, label: "Hotel keeps", size: :sm) do |field| %>
      <% field.with_select_menu(tier_pricing_choices, selected: tier_form.object.pricing_type || "percentage",
           data: { reservation_policy_form_target: "tierPricingType" }) %>
    <% end %>

    <%= render PanelsUI::FormField.new(form: tier_form, attribute: :rate_value, label: "Value", size: :sm) do |field| %>
      <% field.with_input(type: :number, min: 0, step: 0.01, inputmode: "decimal",
           data: { reservation_policy_form_target: "tierRateValue" }) %>
    <% end %>

    <%= render PanelsUI::Button.new(as: :button, type: :button, variant: :ghost, size: :xs,
          data: { action: "click->reservation-policy-form#removeTier" }) do %>
      <%= app_icon "trash-2", class: "size-3.5", aria: { hidden: true } %>
      <span class="sr-only">Remove this band</span>
      Remove
    <% end %>
  </div>

  <div class="mt-3" data-reservation-policy-form-target="tierBasisField" hidden>
    <%= render PanelsUI::FormField.new(form: tier_form, attribute: :percentage_basis, label: "Percentage of", size: :sm) do |field| %>
      <% field.with_select_menu(basis_choices, selected: tier_form.object.percentage_basis || "total_stay") %>
    <% end %>
  </div>
</div>
