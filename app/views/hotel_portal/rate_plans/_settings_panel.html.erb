<%# locals: (f:, rate_plan:, new_plan:, selected_room_type:) %>
<% if current_hotel.sells_per_person? %>
  <section aria-labelledby="rate-plan-channel-fees-heading" class="space-y-4">
    <div>
      <h3 id="rate-plan-channel-fees-heading" class="text-base font-semibold text-foreground">Child fees for OTAs</h3>
      <p class="mt-1 text-sm text-muted-foreground">
        OTAs can't use age groups, so they get one flat child fee and one infant fee instead. Direct bookings still use the age-group prices on the Pricing tab.
      </p>
    </div>
    <div class="grid max-w-2xl gap-4 sm:grid-cols-2">
      <%= render PanelsUI::FormField.new(form: f, attribute: :channex_children_fee, label: "Flat child fee",
            hint: "Enter 0 if children stay free on OTAs.") do |field| %>
        <% field.with_input(type: :number, min: 0, step: 0.01, inputmode: "decimal") %>
        <% field.with_addon(align: :inline_start) { rate_plan.currency } %>
      <% end %>
      <%= render PanelsUI::FormField.new(form: f, attribute: :channex_infant_fee, label: "Flat infant fee",
            hint: "Enter 0 if infants stay free on OTAs.") do |field| %>
        <% field.with_input(type: :number, min: 0, step: 0.01, inputmode: "decimal") %>
        <% field.with_addon(align: :inline_start) { rate_plan.currency } %>
      <% end %>
    </div>
  </section>
<% end %>

<% unless new_plan %>
  <% return_to = edit_hotel_rate_plan_path(current_hotel, rate_plan, room_type_id: selected_room_type&.id, tab: "settings") %>
  <% if rate_plan.archivable? || rate_plan.deletable? %>
    <section aria-labelledby="rate-plan-actions-heading" class="space-y-4">
      <div>
        <h3 id="rate-plan-actions-heading" class="text-base font-semibold text-foreground">Plan status</h3>
        <p class="mt-1 text-sm text-muted-foreground">
          Archiving stops new bookings on this plan; existing bookings keep it. Only a plan that has never been booked can be deleted.
        </p>
      </div>
      <div class="flex flex-wrap items-center gap-2">
        <% if rate_plan.archived? %>
          <%= render PanelsUI::Button.new(
                href: unarchive_hotel_rate_plan_path(current_hotel, rate_plan, room_type_id: selected_room_type&.id, return_to: return_to),
                variant: :secondary, size: :sm,
                data: { turbo_method: :patch }) do %>
            Restore plan
          <% end %>
        <% elsif rate_plan.archivable? %>
          <%= render PanelsUI::Button.new(
                href: archive_hotel_rate_plan_path(current_hotel, rate_plan, room_type_id: selected_room_type&.id, return_to: return_to),
                variant: :secondary, size: :sm,
                data: { turbo_method: :patch,
                        turbo_confirm: "Archive '#{rate_plan.name}'? It won't be offered for new bookings." }) do %>
            Archive plan
          <% end %>
        <% end %>
        <% if rate_plan.deletable? %>
          <%= render PanelsUI::Button.new(
                href: hotel_rate_plan_path(current_hotel, rate_plan, room_type_id: selected_room_type&.id),
                variant: :ghost, size: :sm, class: "text-destructive",
                data: { turbo_method: :delete,
                        turbo_confirm: "Delete '#{rate_plan.name}'? This permanently removes the rate plan.",
                        turbo_confirm_title: "Delete rate plan", turbo_confirm_color: "red" }) do %>
            Delete plan
          <% end %>
        <% end %>
      </div>
    </section>
  <% end %>
<% end %>
