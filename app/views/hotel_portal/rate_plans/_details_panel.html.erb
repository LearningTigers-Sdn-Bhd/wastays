<%# locals: (f:, rate_plan:, new_plan:) %>
<section aria-labelledby="rate-plan-details-heading" class="space-y-4">
  <div class="flex items-center gap-1.5">
    <h3 id="rate-plan-details-heading" class="text-base font-semibold text-foreground">Plan details</h3>
    <% if new_plan %>
      <p class="text-sm text-muted-foreground">Pick an existing plan to add it to another room category, or type a new name.</p>
    <% else %>
      <%= section_info_tip("These apply to every room category on this plan.") %>
    <% end %>
  </div>

  <% day_use_locked = rate_plan.persisted? && rate_plan.booking_rooms.exists? %>
  <div class="grid max-w-3xl items-start gap-4" data-controller="rate-plan-type">
    <div class="space-y-1.5">
      <span id="rate-plan-type-label" class="panel-form-field__label">Plan type</span>
      <%= render PanelsUI::ToggleGroup.new(
            id: "rate-plan-type",
            type: :single,
            value: rate_plan.day_use? ? "day_use" : "room",
            variant: :outline,
            spacing: 0,
            required: true,
            disabled: day_use_locked,
            name: "plan_type",
            aria_label: "Plan type",
            data: { action: "ui--toggle-group:change->rate-plan-type#select" }) do |group| %>
        <% group.with_item(value: "room") { "Room" } %>
        <% group.with_item(value: "day_use") { "Day use" } %>
      <% end %>
      <p class="text-xs text-muted-foreground">
        <%= day_use_locked ? "Locked: bookings already use this plan." : "Room is the normal overnight plan. Day use sells a fixed block of hours on one day." %>
      </p>
    </div>
    <% if new_plan %>
      <%= hidden_field_tag "rate_plan[rate_plan_id]", params.dig(:rate_plan, :rate_plan_id), data: { rate_plan_editor_target: "selectedRatePlanId" } %>
      <%= render PanelsUI::FormField.new(form: f, attribute: :name, label: "Rate plan name", required: true,
            hint: "Search existing plans or type a new name.") do |field| %>
        <% field.with_autocomplete(
             endpoint: autocomplete_hotel_rate_plan_attachments_path(current_hotel),
             placeholder: "Non-refundable",
             data: { action: "input->rate-plan-editor#clearRatePlanSelection ui:autocomplete-select->rate-plan-editor#selectRatePlan" }) %>
      <% end %>
    <% else %>
      <%= render PanelsUI::FormField.new(form: f, attribute: :name, label: "Rate plan name", required: true,
            hint: (rate_plan.standard_rate? ? "This is the room category's base rate. Rename it freely; other plans keep pricing from it." : nil)) do |field| %>
        <% field.with_input(autocomplete: "off") %>
      <% end %>
    <% end %>
    <%= render PanelsUI::FormField.new(form: f, attribute: :description, label: "Description",
          hint: "Shown to guests and agents when they choose a plan.") do |field| %>
      <% field.with_text_area(rows: 3, placeholder: "Pay in full at booking. No changes or refunds.") %>
    <% end %>
    <div data-rate-plan-type-target="hoursField" <%= "hidden" unless rate_plan.day_use? %>>
      <%= render PanelsUI::FormField.new(form: f, attribute: :day_use_hours, label: "Hours in the block",
            hint: "The room price you set is the fixed price for the whole block. Sold at the front desk only.") do |field| %>
        <% field.with_input(type: :number, min: 1, max: 24, step: 1, inputmode: "numeric", placeholder: "6",
             disabled: day_use_locked, data: { rate_plan_type_target: "hours" }) %>
        <% field.with_addon(align: :inline_end) { "hours" } %>
      <% end %>
    </div>
  </div>
</section>

<% unless current_hotel.sells_per_person? %>
  <section aria-labelledby="rate-plan-occupancy-heading" class="space-y-4">
    <div>
      <h3 id="rate-plan-occupancy-heading" class="text-base font-semibold text-foreground">Guests in the room price</h3>
      <p class="mt-1 text-sm text-muted-foreground">How many guests the nightly room price covers, and what each extra guest pays.</p>
    </div>
    <div class="grid max-w-3xl items-start gap-4 sm:grid-cols-2">
      <%= render PanelsUI::FormField.new(form: f, attribute: :base_occupancy, label: "Guests included", hint: "Number of guests covered by the room price.") do |field| %>
        <% field.with_input(type: :number, min: 1, step: 1, inputmode: "numeric") %>
      <% end %>
      <%= render PanelsUI::FormField.new(form: f, attribute: :extra_pax_charge, label: "Extra guest charge", hint: "Per night, for each guest above that number.") do |field| %>
        <% field.with_input(type: :number, min: 0, step: 0.01, inputmode: "decimal") %>
        <% field.with_addon(align: :inline_start) { rate_plan.currency } %>
      <% end %>
    </div>
  </section>
<% end %>
