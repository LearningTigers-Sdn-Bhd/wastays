<% has_bands = rate_plan.rate_plan_age_bands.any? %>

<section aria-labelledby="rate-plan-child-pricing-heading"
         class="space-y-4"
         data-controller="rate-plan-age-bands age-band-price-preview"
         data-age-band-price-preview-currency-value="<%= rate_plan.currency %>"
         data-action="input->age-band-price-preview#update change->age-band-price-preview#update">
  <div class="flex items-start justify-between gap-3">
    <div>
      <h3 id="rate-plan-child-pricing-heading" class="text-base font-semibold text-foreground">Child pricing</h3>
      <p class="mt-1 text-sm text-muted-foreground">Set a default child price and add age-specific prices when needed.</p>
    </div>
    <%= render PanelsUI::Button.new(as: :button, type: :button, variant: :secondary, size: :xs,
          class: "shrink-0",
          data: { action: "click->rate-plan-age-bands#add", rate_plan_age_bands_target: "addButton" }) do %>
      Add age group
    <% end %>
  </div>

  <div class="max-w-sm">
    <%= render PanelsUI::FormField.new(form: f, attribute: :child_price_multiplier,
          label: "Default child price",
          hint: "Used for every child whose age is not covered below. Enter 1.0 for the full adult price or 0.5 for half.") do |field| %>
      <% field.with_input(type: :number, min: 0, step: 0.01, inputmode: "decimal") %>
    <% end %>
  </div>

  <div class="space-y-3 rounded-md border border-border p-4">
    <div>
      <h4 class="text-sm font-medium text-foreground">Channel child pricing</h4>
      <p class="mt-1 text-xs text-muted-foreground">
        Channex cannot carry separate age bands. Set one child fee and one infant fee for OTAs; direct bookings continue to use the age-specific prices.
      </p>
    </div>

    <div class="grid gap-3 sm:grid-cols-2">
      <%= render PanelsUI::FormField.new(form: f, attribute: :channex_children_fee,
            label: "Flat child fee",
            hint: "Enter 0 when children stay free on connected channels.") do |field| %>
        <% field.with_input(type: :number, min: 0, step: 0.01, inputmode: "decimal") %>
      <% end %>

      <%= render PanelsUI::FormField.new(form: f, attribute: :channex_infant_fee,
            label: "Flat infant fee",
            hint: "Enter 0 when infants stay free on connected channels.") do |field| %>
        <% field.with_input(type: :number, min: 0, step: 0.01, inputmode: "decimal") %>
      <% end %>
    </div>
  </div>

  <div data-rate-plan-age-bands-target="rows" class="space-y-3">
    <% rate_plan.rate_plan_age_bands.each_with_index do |band, index| %>
      <%= f.fields_for :rate_plan_age_bands, band, child_index: index do |band_form| %>
        <%= render "hotel_portal/rate_plans/age_band_row", band_form: band_form, band: band, currency: rate_plan.currency %>
      <% end %>
    <% end %>
  </div>

  <p class="rounded-md border border-dashed border-border p-4 text-center text-sm text-muted-foreground <%= 'hidden' if has_bands %>"
     data-rate-plan-age-bands-target="emptyState">
    No age-specific pricing added.
  </p>

  <template data-rate-plan-age-bands-target="template">
    <%= f.fields_for :rate_plan_age_bands, RatePlanAgeBand.new, child_index: "NEW_RECORD" do |band_form| %>
      <%= render "hotel_portal/rate_plans/age_band_row", band_form: band_form, band: nil, currency: rate_plan.currency %>
    <% end %>
  </template>
</section>
