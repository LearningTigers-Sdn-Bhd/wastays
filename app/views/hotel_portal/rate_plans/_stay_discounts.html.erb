<%# Long-stay discounts. Direct channels only: OTAs keep the plan's flat rate. %>
<% per_person = current_hotel.sells_per_person? %>
<section aria-labelledby="rate-plan-stay-discounts-heading" class="space-y-4" data-controller="nested-rows">
  <div class="flex items-start justify-between gap-3">
    <div>
      <h3 id="rate-plan-stay-discounts-heading" class="text-base font-semibold text-foreground">Long-stay discounts</h3>
      <p class="mt-1 text-sm text-muted-foreground">
        Reward longer stays, e.g. “stay 3+ nights, 15% off”. The longest rule a stay qualifies for applies.
        Booking site, travel agent portal and front desk only; OTAs keep the normal rate.
      </p>
    </div>
    <%= render PanelsUI::Button.new(as: :button, type: :button, variant: :secondary, size: :xs, class: "shrink-0",
          data: { action: "click->nested-rows#add" }) do %>
      Add discount
    <% end %>
  </div>

  <div data-nested-rows-target="rows" class="space-y-3">
    <% rate_plan.rate_plan_stay_discounts.each_with_index do |discount, index| %>
      <%= f.fields_for :rate_plan_stay_discounts, discount, child_index: index do |discount_form| %>
        <%= render "hotel_portal/rate_plans/stay_discount_row", discount_form:, discount:, currency: rate_plan.currency, per_person: %>
      <% end %>
    <% end %>
  </div>

  <p class="rounded-md border border-dashed border-border p-4 text-center text-sm text-muted-foreground <%= 'hidden' if rate_plan.rate_plan_stay_discounts.any? %>"
     data-nested-rows-target="emptyState">
    No long-stay discounts. Every night is charged at the normal rate.
  </p>

  <template data-nested-rows-target="template">
    <%= f.fields_for :rate_plan_stay_discounts, RatePlanStayDiscount.new(discount_type: "percent", from_night: 1), child_index: "NEW_RECORD" do |discount_form| %>
      <%= render "hotel_portal/rate_plans/stay_discount_row", discount_form:, discount: nil, currency: rate_plan.currency, per_person: %>
    <% end %>
  </template>
</section>
