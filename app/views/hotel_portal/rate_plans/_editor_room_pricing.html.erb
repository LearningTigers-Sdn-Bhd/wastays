<% form_id = "rate-plan-room-pricing-#{room_type.id}" %>
<div class="space-y-6">
  <div class="flex flex-wrap items-start justify-between gap-3">
    <div>
      <h4 class="text-base font-semibold text-foreground"><%= room_type.name %></h4>
      <p class="mt-1 text-sm text-muted-foreground">
        Up to <%= pluralize(room_type.max_adults, "adult") %> and <%= pluralize(room_type.max_children, "child") %> · Standard Rate <%= wizard_money(room_type.base_price, rate_plan.currency) %>
      </p>
    </div>
    <% unless assignment %>
      <%= render PanelsUI::Badge.new(label: "Not added yet", variant: :outline, size: :sm) %>
    <% end %>
  </div>

  <% if rate_plan.standard_rate? && !current_hotel.sells_per_person? %>
    <%= render PanelsUI::Alert.new(tone: :info, title: "Standard Rate follows the room category", role: :status) do |alert| %>
      <% alert.with_description { "Change the default nightly amount on the room category, and use Rates & Availability for date-specific prices." } %>
    <% end %>
    <div class="flex flex-wrap gap-2">
      <%= render PanelsUI::Button.new(href: edit_hotel_room_type_path(current_hotel, room_type), variant: :secondary, size: :sm,
            data: { turbo_frame: "settings_action_sheet", rate_plan_editor_guard: "true" }) do %>
        Edit room category
      <% end %>
      <%= render PanelsUI::Button.new(href: hotel_inventory_index_path(current_hotel), variant: :ghost, size: :sm,
            data: { turbo_frame: "_top", rate_plan_editor_guard: "true" }) do %>
        Open Rates &amp; Availability
      <% end %>
    </div>
  <% else %>
    <%= form_with model: pricing,
          scope: :room_pricing,
          url: hotel_rate_plan_room_pricing_path(current_hotel, rate_plan, room_type),
          method: :put,
          id: form_id,
          class: "space-y-6",
          data: {
            rate_plan_editor_target: "form",
            editor_section: "rooms",
            controller: "rate-plan-room-pricing",
            rate_plan_room_pricing_anchor_value: room_type.base_price.to_f,
            rate_plan_room_pricing_max_adults_value: pricing.max_adults,
            rate_plan_room_pricing_currency_value: rate_plan.currency,
            rate_plan_room_pricing_per_person_value: pricing.per_person?,
            action: "input->rate-plan-room-pricing#refresh change->rate-plan-room-pricing#refresh"
          } do |f| %>
      <% if pricing.errors.any? || rate_plan.errors.any? %>
        <div tabindex="-1" data-rate-plan-editor-error-summary>
          <%= render PanelsUI::Alert.new(tone: :destructive, title: "Room pricing could not be saved", role: :alert) do |alert| %>
            <% alert.with_description { (pricing.errors.full_messages + rate_plan.errors.full_messages).uniq.to_sentence } %>
          <% end %>
        </div>
      <% end %>

      <%= render "hotel_portal/rate_plans/room_pricing_fields",
            f: f, pricing: pricing, room_type: room_type, currency: rate_plan.currency,
            form_prefix: "editor_room_#{room_type.id}" %>
    <% end %>

    <% if assignment && !rate_plan.standard_rate? %>
      <% removal_blocked_reason = if @assignments.one?
           "A rate plan must keep at least one room category."
         elsif @booking_referenced_room_type_ids.include?(room_type.id)
           "Existing bookings use this room category with this rate plan."
         end %>
      <section aria-labelledby="remove-room-<%= room_type.id %>-heading" class="space-y-3 border-t border-border pt-5">
        <div>
          <h5 id="remove-room-<%= room_type.id %>-heading" class="text-sm font-medium text-foreground">Remove room category</h5>
          <p class="mt-1 text-sm text-muted-foreground">This deletes this plan’s starting prices for <%= room_type.name %>.</p>
        </div>
        <% if removal_blocked_reason %>
          <p class="text-sm text-muted-foreground"><%= removal_blocked_reason %></p>
        <% else %>
          <%= render PanelsUI::Button.new(
                href: hotel_rate_plan_room_pricing_path(current_hotel, rate_plan, room_type),
                variant: :ghost, size: :sm, class: "text-destructive",
                data: {
                  turbo_method: :delete,
                  turbo_frame: "settings_action_sheet",
                  rate_plan_editor_guard: "true",
                  turbo_confirm: "Remove '#{room_type.name}' from '#{rate_plan.name}'? Its configured starting prices will be deleted.",
                  turbo_confirm_title: "Remove room category",
                  turbo_confirm_color: "red"
                }) do %>
            Remove <%= room_type.name %>
          <% end %>
        <% end %>
      </section>
    <% end %>
  <% end %>
</div>
