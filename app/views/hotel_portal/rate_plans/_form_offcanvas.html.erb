<%= turbo_frame_tag "offcanvas_drawer", data: { offcanvas_variant: "right" } do %>
  <% persisted = rate_plan.persisted? %>
  <% locked_name = persisted && (rate_plan.special_tier? || rate_plan.standard_rate?) %>
  <div class="flex h-full min-h-0 flex-col bg-slate-100">
    <header class="z-10 shrink-0 border-b border-slate-200 bg-white">
      <div class="flex items-start justify-between gap-4 px-4 py-4 sm:px-6">
        <div class="min-w-0">
          <p class="text-[10px] font-bold uppercase tracking-[0.2em] text-slate-400">Rate Settings</p>
          <h2 class="mt-0.5 text-lg font-bold tracking-tight text-slate-950"><%= title %></h2>
          <% if persisted %>
            <p class="mt-1 text-xs font-medium text-slate-500"><%= rate_plan.name %></p>
          <% end %>
        </div>
        <button type="button" class="rounded-md p-1.5 text-slate-400 transition hover:bg-slate-100 hover:text-slate-700" data-action="click->offcanvas#close" aria-label="Close rate plan form">
          <%= cached_icon "x", stroke_width: 2.5, class: "size-5" %>
        </button>
      </div>
    </header>

    <%= form_with model: [ current_hotel, rate_plan ],
                  method: persisted ? :patch : :post,
                  class: "flex min-h-0 flex-1 flex-col",
                  data: { turbo_frame: "_top" } do |f| %>
      <div class="min-h-0 flex-1 overflow-y-auto">
        <div class="space-y-5 p-4 sm:p-6">
          <% if rate_plan.errors.any? %>
            <div class="rounded-xl border border-red-200 bg-red-50 px-4 py-3 text-sm font-semibold text-red-800" data-controller="auto-scroll-top">
              <%= rate_plan.errors.full_messages.to_sentence %>
            </div>
          <% end %>

          <% unless locked_name %>
            <div>
              <%= f.label :name, "Rate Plan Name", class: "mb-1.5 block text-sm font-semibold text-slate-900" %>
              <%= f.text_field :name, placeholder: "e.g. Non-Refundable Rate, Bed & Breakfast", required: true, class: "w-full rounded-xl border border-slate-200 bg-white px-4 py-3 text-sm text-slate-700 focus:border-slate-400 focus:outline-none focus:ring-0" %>
            </div>
          <% end %>

          <section class="rounded-xl border border-slate-200 bg-white p-4 space-y-4">
            <h3 class="text-sm font-bold text-slate-900">Pricing</h3>

            <div class="grid gap-4 sm:grid-cols-2">
              <div>
                <%= f.label :sell_mode, "Sell Mode", class: "mb-1.5 block text-sm font-medium text-slate-900" %>
                <% sell_mode_options = if current_hotel.pax_pricing_only?
                     [["Per Person (Pax rates + single supplement)", "per_person"]]
                   else
                     [["Per Room (Extra guest charges)", "per_room"]]
                   end %>
                <%= f.select :sell_mode, sell_mode_options, {}, class: "w-full rounded-xl border border-slate-200 bg-white px-4 py-2.5 text-sm text-slate-700 focus:border-slate-400 focus:outline-none focus:ring-0" %>
              </div>

              <div>
                <%= f.label :base_occupancy, "Base Occupancy (Per Room)", class: "mb-1.5 block text-sm font-medium text-slate-900" %>
                <%= f.number_field :base_occupancy, min: 1, class: "w-full rounded-xl border border-slate-200 bg-white px-4 py-2.5 text-sm text-slate-700 focus:border-slate-400 focus:outline-none focus:ring-0" %>
              </div>

              <div>
                <%= f.label :extra_pax_charge, "Extra Guest Charge", class: "mb-1.5 block text-sm font-medium text-slate-900" %>
                <%= f.number_field :extra_pax_charge, step: 0.01, min: 0, class: "w-full rounded-xl border border-slate-200 bg-white px-4 py-2.5 text-sm text-slate-700 focus:border-slate-400 focus:outline-none focus:ring-0" %>
              </div>

              <div>
                <%= f.label :single_supplement, "Single Supplement", class: "mb-1.5 block text-sm font-medium text-slate-900" %>
                <%= f.number_field :single_supplement, step: 0.01, min: 0, class: "w-full rounded-xl border border-slate-200 bg-white px-4 py-2.5 text-sm text-slate-700 focus:border-slate-400 focus:outline-none focus:ring-0" %>
              </div>

              <div>
                <%= f.label :child_price_multiplier, "Child Price Multiplier", class: "mb-1.5 block text-sm font-medium text-slate-900" %>
                <%= f.number_field :child_price_multiplier, step: 0.01, min: 0, class: "w-full rounded-xl border border-slate-200 bg-white px-4 py-2.5 text-sm text-slate-700 focus:border-slate-400 focus:outline-none focus:ring-0" %>
              </div>
            </div>
          </section>

          <% if rate_plan.sell_mode == "per_person" %>
            <% preview_room_types = current_hotel.room_types.order(:id) %>
            <% default_preview_room_type = rate_plan.room_types.first || preview_room_types.first %>
            <section class="rounded-xl border border-slate-200 bg-white p-4 space-y-3"
                     data-controller="rate-plan-age-bands age-band-price-preview"
                     data-age-band-price-preview-currency-value="<%= rate_plan.currency %>"
                     data-action="input->age-band-price-preview#update change->age-band-price-preview#update">
              <% has_bands = rate_plan.rate_plan_age_bands.any? %>
              <div class="flex items-center justify-between">
                <div>
                  <h3 class="text-sm font-bold text-slate-900">Age Bands</h3>
                  <p class="mt-0.5 text-xs text-slate-500">Override the flat Child Price Multiplier above for specific age ranges. Ages outside any band fall back to it.</p>
                </div>
                <button type="button" data-action="click->rate-plan-age-bands#add" data-rate-plan-age-bands-target="addButton" class="shrink-0 text-xs font-bold text-slate-900 hover:text-slate-700 transition <%= "hidden" unless has_bands %>">+ Add Band</button>
              </div>

              <% if preview_room_types.any? %>
                <div class="flex items-center gap-2">
                  <label class="shrink-0 text-[11px] font-semibold text-slate-600">Preview using</label>
                  <select data-age-band-price-preview-target="roomTypeSelect" class="w-full rounded-lg border border-slate-200 bg-white px-2.5 py-1.5 text-xs text-slate-700 focus:border-slate-300 focus:outline-none focus:ring-0">
                    <% preview_room_types.each do |rt| %>
                      <option value="<%= rt.id %>" data-base-price="<%= rt.base_price %>" <%= "selected" if rt == default_preview_room_type %>>
                        <%= rt.name %> (Standard Rate: <%= rate_plan.currency %> <%= number_with_precision(rt.base_price, precision: 2) %>)
                      </option>
                    <% end %>
                  </select>
                </div>
              <% end %>

              <div data-rate-plan-age-bands-target="rows" class="space-y-3">
                <% rate_plan.rate_plan_age_bands.each_with_index do |band, index| %>
                  <%= render "hotel_portal/settings/rate_plan_age_band_row", band: band, name_prefix: "rate_plan[rate_plan_age_bands_attributes][#{index}]" %>
                <% end %>
              </div>

              <button type="button"
                      data-action="click->rate-plan-age-bands#add"
                      data-rate-plan-age-bands-target="emptyState"
                      class="w-full rounded-lg border-2 border-dashed border-slate-300 py-6 text-center text-sm font-semibold text-slate-500 transition hover:border-slate-400 hover:bg-slate-50 hover:text-slate-700 <%= "hidden" if has_bands %>">
                + Add your first age band
              </button>

              <template data-rate-plan-age-bands-target="template">
                <%= render "hotel_portal/settings/rate_plan_age_band_row", band: nil, name_prefix: "rate_plan[rate_plan_age_bands_attributes][NEW_RECORD]" %>
              </template>
            </section>
          <% end %>

          <section class="rounded-xl border border-slate-200 bg-white p-4 space-y-3">
            <div>
              <h3 class="text-sm font-bold text-slate-900">Room Categories & Pricing</h3>
              <p class="mt-0.5 text-xs text-slate-500">"Manual" prices are entered per date in the Rates Calendar, same as Standard Rate. "% of Standard Rate" and "Amount off/on Standard Rate" compute automatically from that room's Standard Rate for each date &mdash; no calendar entry needed unless you want to override a specific date.</p>
            </div>

            <% rtrp_by_room_type_id = rate_plan.room_type_rate_plans.index_by(&:room_type_id) %>
            <div class="space-y-2">
              <% current_hotel.room_types.order(:id).each do |room_type| %>
                <% rtrp = rtrp_by_room_type_id[room_type.id] %>
                <div class="rounded-lg border border-slate-200 p-3 space-y-2"
                     data-controller="room-type-pricing-row"
                     data-room-type-pricing-row-anchor-price-value="<%= room_type.base_price %>"
                     data-room-type-pricing-row-currency-value="<%= rate_plan.currency %>"
                     data-action="input->room-type-pricing-row#update">
                  <div class="flex flex-wrap items-center gap-3">
                    <label class="inline-flex items-center gap-x-2 text-sm text-slate-700 cursor-pointer">
                      <%= hidden_field_tag "rate_plan[room_type_pricing][#{room_type.id}][enabled]", "0" %>
                      <%= check_box_tag "rate_plan[room_type_pricing][#{room_type.id}][enabled]", "1", rate_plan.room_types.include?(room_type), id: "rate_plan_room_type_pricing_#{room_type.id}_enabled", class: "rounded border-slate-300 text-slate-900 focus:ring-slate-900 size-4" %>
                      <span class="font-medium"><%= room_type.name %></span>
                      <span class="text-xs text-slate-400">(Standard Rate: <%= rate_plan.currency %> <%= number_with_precision(room_type.base_price, precision: 2) %>)</span>
                    </label>

                    <div class="ml-auto flex items-center gap-2">
                      <%= select_tag "rate_plan[room_type_pricing][#{room_type.id}][pricing_mode]",
                          options_for_select(
                            [ [ "Manual", "fixed" ], [ "% of Standard Rate", "multiplier" ], [ "Amount off/on Standard Rate", "offset" ] ],
                            rtrp&.pricing_mode || "fixed"
                          ),
                          class: "rounded-lg border border-slate-200 bg-white px-2.5 py-1.5 text-xs font-medium text-slate-700 focus:border-slate-400 focus:outline-none focus:ring-0",
                          data: { room_type_pricing_row_target: "mode", action: "change->room-type-pricing-row#toggle" } %>

                      <%= number_field_tag "rate_plan[room_type_pricing][#{room_type.id}][pricing_value]", rtrp&.pricing_value, step: 0.01,
                          placeholder: "e.g. -10",
                          class: "w-24 rounded-lg border border-slate-200 bg-white px-2.5 py-1.5 text-xs font-semibold text-slate-800 focus:border-slate-400 focus:outline-none focus:ring-0 #{'hidden' unless rtrp&.derives_price?}",
                          data: { room_type_pricing_row_target: "value" } %>
                    </div>
                  </div>
                  <p class="text-right text-[11px] text-slate-500" data-room-type-pricing-row-target="preview"></p>
                </div>
              <% end %>
            </div>
          </section>

        </div>
      </div>

      <footer class="z-10 shrink-0 border-t border-slate-200 bg-white px-4 py-3 shadow-[0_-4px_12px_rgba(15,23,42,0.06)] sm:px-6">
        <div class="flex items-center justify-between gap-2">
          <% if persisted && rate_plan.archived? %>
            <%= link_to unarchive_hotel_rate_plan_path(current_hotel, rate_plan),
                data: {
                  turbo_method: :patch,
                  turbo_frame: "_top",
                  action: "click->offcanvas#close"
                },
                class: "rounded-md px-4 py-2 text-sm font-bold text-slate-700 transition hover:bg-slate-100" do %>
              Unarchive Rate Plan
            <% end %>
          <% elsif persisted && (rate_plan.archivable? || rate_plan.deletable?) %>
            <div class="flex items-center gap-2">
              <% if rate_plan.archivable? %>
                <%= link_to archive_hotel_rate_plan_path(current_hotel, rate_plan),
                    data: {
                      turbo_method: :patch,
                      turbo_confirm: "Archive '#{rate_plan.name}'? It will no longer be offered for new bookings, but existing bookings and history are kept. You can unarchive it anytime.",
                      turbo_confirm_title: "Archive Rate Plan",
                      turbo_frame: "_top",
                      action: "click->offcanvas#close"
                    },
                    class: "rounded-md px-4 py-2 text-sm font-bold text-amber-700 transition hover:bg-amber-50" do %>
                  Archive Rate Plan
                <% end %>
              <% end %>
              <% if rate_plan.deletable? %>
                <%= link_to hotel_rate_plan_path(current_hotel, rate_plan),
                    data: {
                      turbo_method: :delete,
                      turbo_confirm: "Are you sure you want to delete '#{rate_plan.name}'? This will permanently remove the rate plan.",
                      turbo_confirm_title: "Delete Rate Plan",
                      turbo_confirm_color: "red",
                      turbo_frame: "_top",
                      action: "click->offcanvas#close"
                    },
                    class: "rounded-md px-4 py-2 text-sm font-bold text-red-600 transition hover:bg-red-50" do %>
                  Delete Rate Plan
                <% end %>
              <% end %>
            </div>
          <% else %>
            <span></span>
          <% end %>

          <div class="flex items-center gap-2">
            <button type="button" class="rounded-md px-4 py-2 text-sm font-semibold text-slate-600 transition hover:bg-slate-100" data-action="click->offcanvas#close">Cancel</button>
            <%= f.submit submit_label, class: "cursor-pointer rounded-md bg-slate-900 px-5 py-2 text-sm font-bold text-white transition hover:bg-slate-700", data: { turbo_submits_with: "Saving..." } %>
          </div>
        </div>
      </footer>
    <% end %>
  </div>
<% end %>
