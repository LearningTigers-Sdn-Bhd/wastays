<%= turbo_frame_tag "offcanvas_drawer", data: { offcanvas_variant: "right" } do %>
  <% persisted = rate_plan.persisted? %>
  <% locked_name = persisted && (rate_plan.special_tier? || rate_plan.standard_rate?) %>
  <div class="flex h-full min-h-0 flex-col bg-slate-100">
    <header class="z-10 shrink-0 border-b border-slate-200 bg-white">
      <div class="flex items-start justify-between gap-4 px-4 py-4 sm:px-6">
        <div class="min-w-0">
          <p class="text-[10px] font-bold uppercase tracking-[0.2em] text-slate-400">Rate Settings</p>
          <h2 class="mt-0.5 text-lg font-bold tracking-tight text-slate-950"><%= title %></h2>
          <% if persisted %>
            <p class="mt-1 text-xs font-medium text-slate-500"><%= rate_plan.name %></p>
          <% end %>
        </div>
        <button type="button" class="rounded-md p-1.5 text-slate-400 transition hover:bg-slate-100 hover:text-slate-700" data-action="click->offcanvas#close" aria-label="Close rate plan form">
          <%= cached_icon "x", stroke_width: 2.5, class: "size-5" %>
        </button>
      </div>
    </header>

    <%= form_with model: [ current_hotel, rate_plan ],
                  method: persisted ? :patch : :post,
                  class: "flex min-h-0 flex-1 flex-col",
                  data: { controller: "rate-simulator", currency: rate_plan.currency.presence || current_hotel.default_currency || "MYR", turbo_frame: "_top" } do |f| %>
      <div class="min-h-0 flex-1 overflow-y-auto">
        <div class="space-y-5 p-4 sm:p-6">
          <% if rate_plan.errors.any? %>
            <div class="rounded-xl border border-red-200 bg-red-50 px-4 py-3 text-sm font-semibold text-red-800" data-controller="auto-scroll-top">
              <%= rate_plan.errors.full_messages.to_sentence %>
            </div>
          <% end %>

          <% unless locked_name %>
            <div>
              <%= f.label :name, "Rate Plan Name", class: "mb-1.5 block text-sm font-semibold text-slate-900" %>
              <%= f.text_field :name, placeholder: "e.g. Non-Refundable Rate, Bed & Breakfast", required: true, class: "w-full rounded-xl border border-slate-200 bg-white px-4 py-3 text-sm text-slate-700 focus:border-slate-400 focus:outline-none focus:ring-0" %>
            </div>
          <% end %>

          <section class="rounded-xl border border-slate-200 bg-white p-4 space-y-4">
            <h3 class="text-sm font-bold text-slate-900">Pricing</h3>

            <div class="grid gap-4 sm:grid-cols-2">
              <div>
                <%= f.label :sell_mode, "Sell Mode", class: "mb-1.5 block text-sm font-medium text-slate-900" %>
                <% sell_mode_options = if current_hotel.pax_pricing_only?
                     [["Per Person (Pax rates + single supplement)", "per_person"]]
                   else
                     [["Per Room (Extra guest charges)", "per_room"]]
                   end %>
                <%= f.select :sell_mode, sell_mode_options, {}, class: "w-full rounded-xl border border-slate-200 bg-white px-4 py-2.5 text-sm text-slate-700 focus:border-slate-400 focus:outline-none focus:ring-0", data: { rate_simulator_target: "sellModeInput" } %>
              </div>

              <div>
                <%= f.label :base_occupancy, "Base Occupancy (Per Room)", class: "mb-1.5 block text-sm font-medium text-slate-900" %>
                <%= f.number_field :base_occupancy, min: 1, class: "w-full rounded-xl border border-slate-200 bg-white px-4 py-2.5 text-sm text-slate-700 focus:border-slate-400 focus:outline-none focus:ring-0", data: { rate_simulator_target: "baseOccupancyInput" } %>
              </div>

              <div>
                <%= f.label :extra_pax_charge, "Extra Guest Charge", class: "mb-1.5 block text-sm font-medium text-slate-900" %>
                <%= f.number_field :extra_pax_charge, step: 0.01, min: 0, class: "w-full rounded-xl border border-slate-200 bg-white px-4 py-2.5 text-sm text-slate-700 focus:border-slate-400 focus:outline-none focus:ring-0", data: { rate_simulator_target: "extraPaxChargeInput" } %>
              </div>

              <div>
                <%= f.label :single_supplement, "Single Supplement", class: "mb-1.5 block text-sm font-medium text-slate-900" %>
                <%= f.number_field :single_supplement, step: 0.01, min: 0, class: "w-full rounded-xl border border-slate-200 bg-white px-4 py-2.5 text-sm text-slate-700 focus:border-slate-400 focus:outline-none focus:ring-0", data: { rate_simulator_target: "singleSupplementInput" } %>
              </div>

              <div>
                <%= f.label :child_price_multiplier, "Child Price Multiplier", class: "mb-1.5 block text-sm font-medium text-slate-900" %>
                <%= f.number_field :child_price_multiplier, step: 0.01, min: 0, class: "w-full rounded-xl border border-slate-200 bg-white px-4 py-2.5 text-sm text-slate-700 focus:border-slate-400 focus:outline-none focus:ring-0", data: { rate_simulator_target: "childMultiplierInput" } %>
              </div>

              <div>
                <%= f.label :infant_price_multiplier, "Infant Price Multiplier", class: "mb-1.5 block text-sm font-medium text-slate-900" %>
                <%= f.number_field :infant_price_multiplier, step: 0.01, min: 0, class: "w-full rounded-xl border border-slate-200 bg-white px-4 py-2.5 text-sm text-slate-700 focus:border-slate-400 focus:outline-none focus:ring-0", data: { rate_simulator_target: "infantMultiplierInput" } %>
              </div>
            </div>
          </section>

          <% if rate_plan.sell_mode == "per_person" %>
            <section class="rounded-xl border border-slate-200 bg-white p-4 space-y-3" data-controller="rate-plan-age-bands">
              <div class="flex items-center justify-between">
                <div>
                  <h3 class="text-sm font-bold text-slate-900">Age Bands</h3>
                  <p class="mt-0.5 text-xs text-slate-500">Override the flat Child Price Multiplier above for specific age ranges. Ages outside any band fall back to it.</p>
                </div>
                <button type="button" data-action="click->rate-plan-age-bands#add" class="shrink-0 text-xs font-bold text-slate-900 hover:text-slate-700 transition">+ Add Band</button>
              </div>

              <div data-rate-plan-age-bands-target="rows" class="space-y-3">
                <% rate_plan.rate_plan_age_bands.each_with_index do |band, index| %>
                  <%= render "hotel_portal/settings/rate_plan_age_band_row", band: band, name_prefix: "rate_plan[rate_plan_age_bands_attributes][#{index}]" %>
                <% end %>
              </div>

              <template data-rate-plan-age-bands-target="template">
                <%= render "hotel_portal/settings/rate_plan_age_band_row", band: nil, name_prefix: "rate_plan[rate_plan_age_bands_attributes][NEW_RECORD]" %>
              </template>
            </section>
          <% end %>

          <section class="rounded-xl border border-slate-200 bg-white p-4 space-y-3">
            <h3 class="text-sm font-bold text-slate-900">Room Categories</h3>
            <div class="flex flex-wrap gap-x-6 gap-y-2">
              <% current_hotel.room_types.order(:id).each do |room_type| %>
                <label class="inline-flex items-center gap-x-2 text-sm text-slate-700 cursor-pointer">
                  <%= check_box_tag "rate_plan[room_type_ids][]", room_type.id, rate_plan.room_types.include?(room_type), id: "rate_plan_room_type_ids_#{room_type.id}", class: "rounded border-slate-300 text-slate-900 focus:ring-slate-900 size-4" %>
                  <span><%= room_type.name %></span>
                </label>
              <% end %>
              <%= hidden_field_tag "rate_plan[room_type_ids][]", "" %>
            </div>
          </section>

          <section class="rounded-xl border border-indigo-100 bg-indigo-50/20 p-4 space-y-3 shadow-sm">
            <div class="flex items-center justify-between">
              <div class="flex items-center gap-1.5 text-xs font-bold uppercase tracking-wider text-indigo-700">
                <%= cached_icon "calculator", class: "size-4", aria: { hidden: true } %>
                <span>Rate Simulator / Calculator</span>
              </div>
              <button type="button"
                      data-action="click->rate-simulator#toggle"
                      data-rate-simulator-target="toggleBtn"
                      class="text-[10px] font-black uppercase tracking-wider text-indigo-600 hover:text-indigo-800 transition-colors focus:outline-none">
                Show Simulator
              </button>
            </div>

            <div data-rate-simulator-target="panel" class="hidden space-y-4 pt-2 border-t border-indigo-100/50">
              <div class="grid gap-3 sm:grid-cols-4">
                <div>
                  <label class="block text-[10px] font-bold uppercase tracking-wider text-slate-500 mb-1">Base Price to Simulate</label>
                  <input type="number"
                         data-rate-simulator-target="basePriceInput"
                         value="100.00"
                         step="0.01"
                         min="1"
                         class="w-full rounded-lg border border-slate-200 px-3 py-1.5 text-xs font-semibold text-slate-800 focus:border-slate-300 focus:outline-none focus:ring-0">
                </div>
                <div>
                  <label class="block text-[10px] font-bold uppercase tracking-wider text-slate-500 mb-1">Adults</label>
                  <div class="flex items-center justify-between rounded-lg border border-slate-200 bg-white p-1">
                    <button type="button" data-action="click->rate-simulator#decrementAdults" class="size-6 rounded-md hover:bg-slate-50 font-bold text-sm select-none flex items-center justify-center">−</button>
                    <span data-rate-simulator-target="adultsCount" class="text-xs font-bold text-slate-800">2</span>
                    <button type="button" data-action="click->rate-simulator#incrementAdults" class="size-6 rounded-md hover:bg-slate-50 font-bold text-sm select-none flex items-center justify-center">+</button>
                  </div>
                </div>
                <div>
                  <label class="block text-[10px] font-bold uppercase tracking-wider text-slate-500 mb-1">Children</label>
                  <div class="flex items-center justify-between rounded-lg border border-slate-200 bg-white p-1">
                    <button type="button" data-action="click->rate-simulator#decrementChildren" class="size-6 rounded-md hover:bg-slate-50 font-bold text-sm select-none flex items-center justify-center">−</button>
                    <span data-rate-simulator-target="childrenCount" class="text-xs font-bold text-slate-800">0</span>
                    <button type="button" data-action="click->rate-simulator#incrementChildren" class="size-6 rounded-md hover:bg-slate-50 font-bold text-sm select-none flex items-center justify-center">+</button>
                  </div>
                </div>
                <div>
                  <label class="block text-[10px] font-bold uppercase tracking-wider text-slate-500 mb-1">Infants</label>
                  <div class="flex items-center justify-between rounded-lg border border-slate-200 bg-white p-1">
                    <button type="button" data-action="click->rate-simulator#decrementInfants" class="size-6 rounded-md hover:bg-slate-50 font-bold text-sm select-none flex items-center justify-center">−</button>
                    <span data-rate-simulator-target="infantsCount" class="text-xs font-bold text-slate-800">0</span>
                    <button type="button" data-action="click->rate-simulator#incrementInfants" class="size-6 rounded-md hover:bg-slate-50 font-bold text-sm select-none flex items-center justify-center">+</button>
                  </div>
                </div>
              </div>

              <div class="rounded-lg bg-white border border-indigo-100/80 p-3 space-y-2">
                <div class="flex items-center justify-between text-xs text-slate-600 font-semibold">
                  <span data-rate-simulator-target="roomModeLabel">Per-Room Mode Cost:</span>
                  <span class="font-bold text-slate-800" data-rate-simulator-target="roomModeResult">-</span>
                </div>
                <% if current_hotel.allow_pax_pricing? %>
                  <div class="flex items-center justify-between text-xs text-slate-600 font-semibold">
                    <span data-rate-simulator-target="paxModeLabel">Per-Pax Mode Cost:</span>
                    <span class="font-bold text-indigo-700" data-rate-simulator-target="paxModeResult">-</span>
                  </div>
                <% end %>
              </div>
            </div>
          </section>
        </div>
      </div>

      <footer class="z-10 shrink-0 border-t border-slate-200 bg-white px-4 py-3 shadow-[0_-4px_12px_rgba(15,23,42,0.06)] sm:px-6">
        <div class="flex items-center justify-between gap-2">
          <% if persisted && rate_plan.deletable? %>
            <%= link_to hotel_rate_plan_path(current_hotel, rate_plan),
                data: {
                  turbo_method: :delete,
                  turbo_confirm: "Are you sure you want to delete '#{rate_plan.name}'? This will permanently remove the rate plan.",
                  turbo_confirm_title: "Delete Rate Plan",
                  turbo_confirm_color: "red",
                  turbo_frame: "_top",
                  action: "click->offcanvas#close"
                },
                class: "rounded-md px-4 py-2 text-sm font-bold text-red-600 transition hover:bg-red-50" do %>
              Delete Rate Plan
            <% end %>
          <% else %>
            <span></span>
          <% end %>

          <div class="flex items-center gap-2">
            <button type="button" class="rounded-md px-4 py-2 text-sm font-semibold text-slate-600 transition hover:bg-slate-100" data-action="click->offcanvas#close">Cancel</button>
            <%= f.submit submit_label, class: "cursor-pointer rounded-md bg-slate-900 px-5 py-2 text-sm font-bold text-white transition hover:bg-slate-700", data: { turbo_submits_with: "Saving..." } %>
          </div>
        </div>
      </footer>
    <% end %>
  </div>
<% end %>
