<% content_for :title, "Requests | WAStays" %>

<% content_for :breadcrumbs do %>
  <div class="flex items-center gap-x-2">
    <span class="text-sm font-medium text-slate-600"><%= current_hotel.name %></span>
    <span class="text-sm text-slate-400">/</span>
    <span class="text-sm font-semibold text-slate-900">Requests</span>
  </div>
<% end %>

<div class="max-w-[1600px] mx-auto pb-20 space-y-8">
  <div class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between px-4 md:px-0 mt-5">
    <div>
      <h1 class="text-2xl font-bold tracking-tight text-slate-950 sm:text-3xl">Requests</h1>
      <p class="mt-1 text-sm font-medium text-slate-600">Track housekeeping requests, complaint requests, and completed items in one board.</p>
    </div>

    <div class="flex flex-wrap items-center gap-2">
      <div class="flex flex-wrap gap-2 text-[10px] font-bold uppercase tracking-wider">
        <span class="inline-flex items-center gap-x-2 rounded-full bg-blue-50 px-3 py-1.5 text-blue-700 border border-blue-100">
          Housekeeping <%= @board_counts[:housekeeping] %>
        </span>
        <span class="inline-flex items-center gap-x-2 rounded-full bg-rose-50 px-3 py-1.5 text-rose-700 border border-rose-100">
          Complaint <%= @board_counts[:complaint] %>
        </span>
        <span class="inline-flex items-center gap-x-2 rounded-full bg-green-50 px-3 py-1.5 text-green-700 border border-green-100">
          Completed <%= @board_counts[:completed] %>
        </span>
      </div>

      <%= link_to hotel_request_archive_path(current_hotel), class: "inline-flex items-center gap-x-2 rounded-xl border border-slate-200 bg-white px-4 py-2 text-sm font-bold text-slate-700 shadow-sm transition hover:bg-slate-50" do %>
        Archive
      <% end %>
    </div>
  </div>

  <div class="rounded-2xl border border-slate-200 bg-white p-4 shadow-sm">
    <%= form_with url: hotel_requests_path(current_hotel), method: :get, local: true, data: { controller: "auto-submit", turbo_frame: "requests_board_results" }, class: "grid gap-4 lg:grid-cols-[minmax(0,1fr)_240px_auto]" do |f| %>
      <div>
        <label class="mb-2 block text-[11px] font-bold uppercase tracking-wider text-slate-500">Search</label>
        <%= text_field_tag :q, params[:q], autocomplete: "off", class: "w-full rounded-xl border border-slate-200 px-4 py-2.5 text-sm font-medium text-slate-700 focus:border-slate-300 focus:outline-none focus:ring-0 shadow-sm", placeholder: "Guest, booking, or request details...", data: { action: "input->auto-submit#submit" } %>
      </div>
      <div>
        <label class="mb-2 block text-[11px] font-bold uppercase tracking-wider text-slate-500">Date</label>
        <%= f.date_field :date, value: params[:date], class: "w-full rounded-xl border border-slate-200 bg-white px-4 py-2.5 text-sm font-medium text-slate-700 focus:border-slate-300 focus:outline-none focus:ring-0 shadow-sm" %>
      </div>
      <div class="flex items-end gap-2">
        <%= f.submit "Apply Filters", class: "inline-flex items-center rounded-xl bg-slate-900 px-6 py-2.5 text-sm font-bold text-white shadow-sm transition hover:bg-slate-700" %>
        <%= link_to "Clear", hotel_requests_path(current_hotel), class: "inline-flex items-center rounded-xl border border-slate-200 bg-white px-6 py-2.5 text-sm font-bold text-slate-700 shadow-sm transition hover:bg-slate-50", data: { turbo_frame: "_top" } %>
      </div>
    <% end %>
  </div>

  <%= turbo_frame_tag "requests_board_results" do %>
  <div class="grid gap-6 xl:grid-cols-3 xl:h-[calc(100vh-14rem)] xl:items-stretch" data-controller="requests-board" data-requests-board-hotel-id-value="<%= current_hotel.id %>" data-requests-board-target="board">
    <% [
      [:housekeeping, "Housekeeping Requests", "border-t-blue-500"],
      [:complaint, "Complaint Requests", "border-t-rose-500"],
      [:completed, "Completed Stays", "border-t-green-500"],
    ].each do |bucket_key, label, accent_class| %>
      <section
        data-requests-board-target="column"
        data-board-column="<%= bucket_key %>"
        data-action="dragover->requests-board#dragOver dragleave->requests-board#dragLeave drop->requests-board#drop"
        class="flex min-h-0 flex-col overflow-hidden rounded-2xl border border-slate-200 bg-slate-50/40 shadow-sm border-t-4 <%= accent_class %>"
      >
        <div class="flex items-center justify-between gap-3 border-b border-slate-200 px-5 py-4 bg-white">
          <div>
            <h2 class="text-sm font-bold uppercase tracking-wider text-slate-900"><%= label %></h2>
            <p class="text-[11px] font-medium text-slate-500"><%= pluralize(@board_counts[bucket_key], "active request") %></p>
          </div>
          <div class="flex items-center gap-2">
            <span class="inline-flex size-7 items-center justify-center rounded-full bg-slate-100 text-xs font-black text-slate-700">
              <%= @board_counts[bucket_key] %>
            </span>
            <button
              type="button"
              draggable="true"
              aria-label="Drag column"
              data-action="dragstart->requests-board#columnDragStart dragend->requests-board#columnDragEnd"
              class="inline-flex size-8 items-center justify-center rounded-lg text-slate-300 transition hover:text-slate-900 hover:bg-slate-50 cursor-grab"
            >
              <svg class="size-4" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="9" cy="5" r="1"/><circle cx="9" cy="12" r="1"/><circle cx="9" cy="19" r="1"/><circle cx="15" cy="5" r="1"/><circle cx="15" cy="12" r="1"/><circle cx="15" cy="19" r="1"/></svg>
            </button>
          </div>
        </div>

        <div class="flex-1 min-h-0 space-y-4 overflow-y-auto p-4 custom-scrollbar">
          <% if @board_columns[bucket_key].any? %>
            <% @board_columns[bucket_key].each do |card| %>
              <% status_class = card[:kind] == "housekeeping" ? housekeeping_status_class(card[:status]) : complaint_status_class(card[:status]) %>
              <% kind_badge_class = card[:kind] == "housekeeping" ? "border-blue-200 bg-blue-50 text-blue-700" : "border-rose-200 bg-rose-50 text-rose-700" %>
              <article
                draggable="true"
                data-requests-board-target="card"
                data-request-kind="<%= card[:kind] %>"
                data-request-id="<%= card[:request_id] %>"
                data-update-url="<%= card[:update_url] %>"
                data-current-status="<%= card[:status] %>"
                data-action="dragstart->requests-board#dragStart dragend->requests-board#dragEnd"
                class="group cursor-grab rounded-xl border border-slate-200 bg-white p-5 shadow-sm transition hover:border-slate-400 hover:shadow-md active:cursor-grabbing"
              >
                <div class="flex items-start justify-between gap-3">
                  <span class="inline-flex items-center rounded-full border px-2 py-0.5 text-[9px] font-bold uppercase tracking-wider <%= kind_badge_class %>">
                    <%= card[:kind] %>
                  </span>
                  <span class="inline-flex items-center rounded-full px-2 py-0.5 text-[9px] font-bold uppercase tracking-wider <%= status_class.gsub('bg-', 'border-').gsub('text-', 'text-') %> bg-opacity-10">
                    <%= card[:status] %>
                  </span>
                </div>

                <div class="mt-4">
                  <button
                    type="button"
                    class="block text-left group"
                    onclick="document.getElementById('request-board-modal-<%= card[:kind] %>-<%= card[:request_id] %>').showModal()"
                  >
                    <p class="text-sm font-bold text-slate-900 leading-snug group-hover:text-blue-600 transition-colors"><%= card[:title].to_s.truncate(80) %></p>
                  </button>
                  
                  <div class="mt-4 flex flex-col gap-1.5">
                    <div class="flex items-center gap-2 text-xs font-medium text-slate-500">
                      <svg class="size-3.5" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
                      <%= card[:guest_name] %>
                    </div>
                    <div class="flex items-center gap-2 text-xs font-mono text-slate-400">
                      <svg class="size-3.5" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2.5 17a24.12 24.12 0 0 1 0-10 2 2 0 0 1 1.4-1.4 49.56 49.56 0 0 1 16.2 0A2 2 0 0 1 21.5 7a24.12 24.12 0 0 1 0 10 2 2 0 0 1-1.4 1.4 49.55 49.56 0 0 1-16.2 0A2 2 0 0 1 2.5 17Z"/><path d="M12 10v4"/><path d="M12 10l-1.5 1.5"/><path d="M12 10l1.5 1.5"/><path d="M12 14l-1.5-1.5"/><path d="M12 14l1.5-1.5"/></svg>
                      <%= card[:booking_token] %>
                    </div>
                  </div>
                </div>

                <div class="mt-5 pt-4 border-t border-slate-50 flex items-center justify-between">
                  <span class="text-[10px] font-bold text-slate-400 uppercase"><%= display_housekeeping_datetime(card[:requested_at]) %></span>
                  <div class="flex items-center gap-2">
                    <%= button_to card[:archive_url], method: :patch, class: "size-8 flex items-center justify-center rounded-lg border border-slate-200 bg-white text-slate-400 hover:text-slate-900 transition-colors shadow-sm", title: "Archive Request" do %>
                      <svg class="size-4" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
                    <% end %>
                  </div>
                </div>
              </article>

              <dialog id="request-board-modal-<%= card[:kind] %>-<%= card[:request_id] %>" class="fixed inset-0 m-auto w-[min(94vw,48rem)] rounded-3xl p-0 shadow-2xl backdrop:bg-slate-900/60" onclick="if(event.target===this){this.close()}">
                <div class="bg-white overflow-hidden flex flex-col" onclick="event.stopPropagation()">
                  <div class="flex items-center justify-between border-b border-slate-100 px-8 py-6">
                    <div>
                      <p class="text-[10px] font-black uppercase tracking-widest text-slate-400">Request Details</p>
                      <h3 class="text-xl font-bold text-slate-950 mt-1"><%= card[:booking_token] %></h3>
                    </div>
                    <button type="button" class="size-10 flex items-center justify-center rounded-full bg-slate-100 text-slate-500 hover:bg-slate-200 hover:text-slate-900 transition" onclick="this.closest('dialog').close()">
                      <svg class="size-5" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg>
                    </button>
                  </div>
                  
                  <div class="grid gap-px bg-slate-100 border-b border-slate-100 md:grid-cols-2">
                    <div class="bg-white p-8 space-y-6">
                      <div>
                        <label class="text-[10px] font-bold uppercase tracking-wider text-slate-400">Guest Name</label>
                        <p class="mt-1 text-base font-bold text-slate-900"><%= card[:guest_name] %></p>
                      </div>
                      <div>
                        <label class="text-[10px] font-bold uppercase tracking-wider text-slate-400">Request Type</label>
                        <p class="mt-1 text-sm font-semibold text-slate-700"><%= card[:kind].titleize %></p>
                      </div>
                      <div>
                        <label class="text-[10px] font-bold uppercase tracking-wider text-slate-400">Timeline</label>
                        <div class="mt-2 space-y-2">
                          <div class="flex items-center gap-3 text-sm">
                            <span class="size-2 rounded-full bg-slate-300"></span>
                            <span class="text-slate-500 font-medium">Requested:</span>
                            <span class="text-slate-900 font-bold"><%= display_housekeeping_datetime(card[:requested_at]) %></span>
                          </div>
                          <% if card[:completed_at].present? %>
                            <div class="flex items-center gap-3 text-sm">
                              <span class="size-2 rounded-full bg-emerald-500"></span>
                              <span class="text-slate-500 font-medium">Completed:</span>
                              <span class="text-slate-900 font-bold"><%= display_housekeeping_datetime(card[:completed_at]) %></span>
                            </div>
                          <% end %>
                        </div>
                      </div>
                    </div>

                    <div class="bg-white p-8 space-y-6">
                      <div>
                        <label class="text-[10px] font-bold uppercase tracking-wider text-slate-400">Request Content</label>
                        <p class="mt-2 text-sm leading-relaxed font-medium text-slate-700 bg-slate-50 p-4 rounded-xl border border-slate-100"><%= card[:title] %></p>
                      </div>
                      <div>
                        <label class="text-[10px] font-bold uppercase tracking-wider text-slate-400 mb-3 block">Internal Notes</label>
                        <% if card[:internal_notes].any? %>
                          <div class="space-y-3">
                            <% card[:internal_notes].each do |note| %>
                              <div class="rounded-xl border border-slate-100 bg-slate-50/50 p-4">
                                <p class="text-sm text-slate-800 whitespace-pre-wrap"><%= note["body"] %></p>
                              </div>
                            <% end %>
                          </div>
                        <% else %>
                          <p class="text-sm font-medium text-slate-400 italic">No staff notes recorded.</p>
                        <% end %>
                      </div>
                    </div>
                  </div>
                  
                  <div class="p-6 bg-slate-50 flex justify-end gap-3">
                    <button type="button" class="px-6 py-2.5 text-sm font-bold text-slate-700 hover:bg-white rounded-xl transition shadow-sm" onclick="this.closest('dialog').close()">Close Details</button>
                    <%= link_to "View Full Booking", hotel_booking_path(current_hotel, card[:booking_token]), class: "px-6 py-2.5 text-sm font-bold bg-slate-900 text-white rounded-xl hover:bg-slate-700 transition shadow-md", data: { turbo: false } %>
                  </div>
                </div>
              </dialog>
            <% end %>
          <% else %>
            <div class="rounded-2xl border border-dashed border-slate-200 bg-white/50 p-12 text-center">
              <p class="text-sm font-medium text-slate-400">Empty column</p>
            </div>
          <% end %>
        </div>

        <% page_params = request.query_parameters.except(:housekeeping_page, :complaint_page, :completed_page) %>
        <div class="border-t border-slate-200 bg-white px-4 py-4 flex justify-center">
          <% if bucket_key == :housekeeping %>
            <%= paginate @board_columns[:housekeeping], param_name: :housekeeping_page, params: page_params %>
          <% elsif bucket_key == :complaint %>
            <%= paginate @board_columns[:complaint], param_name: :complaint_page, params: page_params %>
          <% else %>
            <%= paginate @board_columns[:completed], param_name: :completed_page, params: page_params %>
          <% end %>
        </div>
      </section>
    <% end %>
  </div>
  <% end %>
</div>
