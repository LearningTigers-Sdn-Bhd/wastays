<% content_for :title, "Requests | WAStays" %>

<div class="space-y-6" data-controller="requests-board" data-requests-board-hotel-id-value="<%= current_hotel.id %>">
  <div class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
    <div>
      <h1 class="text-3xl font-bold text-gray-800">Requests</h1>
      <p class="mt-1 text-sm text-gray-500">Track housekeeping requests, complaint requests, and completed items in one board.</p>
    </div>

    <div class="flex flex-wrap items-center gap-2">
      <div class="flex flex-wrap gap-2 text-xs font-semibold">
        <span class="inline-flex items-center gap-x-2 rounded-full bg-blue-50 px-3 py-1.5 text-blue-700 border border-blue-100">
          Housekeeping <%= @board_counts[:housekeeping] %>
        </span>
        <span class="inline-flex items-center gap-x-2 rounded-full bg-rose-50 px-3 py-1.5 text-rose-700 border border-rose-100">
          Complaint <%= @board_counts[:complaint] %>
        </span>
        <span class="inline-flex items-center gap-x-2 rounded-full bg-green-50 px-3 py-1.5 text-green-700 border border-green-100">
          Completed <%= @board_counts[:completed] %>
        </span>
      </div>

      <%= link_to hotel_request_archive_path(current_hotel), class: "inline-flex items-center gap-x-2 rounded-full border border-gray-200 bg-white px-4 py-2 text-sm font-semibold text-gray-700 shadow-sm hover:bg-gray-50" do %>
        Archive
      <% end %>
    </div>
  </div>

  <div class="rounded-2xl border border-gray-200 bg-white p-4 shadow-sm">
    <%= form_with url: hotel_requests_path(current_hotel), method: :get, local: true, class: "grid gap-4 lg:grid-cols-[minmax(0,1fr)_240px_auto]" do |f| %>
      <div>
        <label class="mb-2 block text-xs font-bold uppercase tracking-wider text-gray-500">Search</label>
        <%= text_field_tag :q, params[:q], class: "w-full rounded-lg border border-gray-200 px-3 py-2 text-sm focus:border-blue-500 focus:ring-blue-500", placeholder: "Guest, booking, request, status..." %>
      </div>
      <div>
        <label class="mb-2 block text-xs font-bold uppercase tracking-wider text-gray-500">Date</label>
        <%= select_tag :date_range, options_for_select([["All", "all"], ["Today", "today"], ["Last 3 Days", "3_days"], ["Last 7 Days", "7_days"]], params[:date_range].presence || "all"), class: "w-full rounded-lg border border-gray-200 px-3 py-2 text-sm focus:border-blue-500 focus:ring-blue-500" %>
      </div>
      <div class="flex items-end gap-2">
        <%= f.submit "Apply Filters", class: "inline-flex items-center gap-x-2 rounded-lg border border-transparent bg-blue-600 px-4 py-2 text-sm font-semibold text-white hover:bg-blue-700" %>
        <%= link_to "Clear", hotel_requests_path(current_hotel), class: "inline-flex items-center gap-x-2 rounded-lg border border-gray-200 bg-white px-4 py-2 text-sm font-semibold text-gray-700 shadow-sm hover:bg-gray-50" %>
      </div>
    <% end %>
  </div>

  <div class="grid gap-4 xl:grid-cols-3" data-requests-board-target="board">
    <% [
      [:housekeeping, "Housekeeping Requests", "border-t-blue-500"],
      [:complaint, "Complaint Requests", "border-t-rose-500"],
      [:completed, "Completed", "border-t-green-500"],
    ].each do |bucket_key, label, accent_class| %>
      <section
        data-requests-board-target="column"
        data-board-column="<%= bucket_key %>"
        data-action="dragover->requests-board#dragOver dragleave->requests-board#dragLeave drop->requests-board#drop"
        class="rounded-2xl border border-gray-200 bg-gray-50/50 shadow-sm overflow-hidden border-t-4 <%= accent_class %>"
      >
        <div class="flex items-center justify-between gap-3 border-b border-gray-200/70 px-4 py-3 bg-white">
          <div>
            <h2 class="text-sm font-bold uppercase tracking-wider text-gray-700"><%= label %></h2>
            <p class="text-[11px] text-gray-500"><%= pluralize(@board_columns[bucket_key].size, "request") %></p>
          </div>
          <div class="flex items-center gap-2">
            <span class="inline-flex min-w-7 items-center justify-center rounded-full bg-gray-100 px-2 py-1 text-xs font-bold text-gray-700 shadow-sm">
              <%= @board_columns[bucket_key].size %>
            </span>
            <button
              type="button"
              draggable="true"
              aria-label="Drag column"
              data-action="dragstart->requests-board#columnDragStart dragend->requests-board#columnDragEnd"
              class="inline-flex h-8 w-8 items-center justify-center rounded-full border border-gray-200 bg-white text-gray-400 shadow-sm transition hover:text-gray-700 hover:shadow-md active:cursor-grabbing cursor-grab"
            >
              <span class="text-lg leading-none">⋮⋮</span>
            </button>
          </div>
        </div>

        <div class="space-y-3 p-4 min-h-[18rem]">
          <% if @board_columns[bucket_key].any? %>
            <% @board_columns[bucket_key].each do |card| %>
              <% status_class = card[:kind] == "housekeeping" ? housekeeping_status_class(card[:status]) : complaint_status_class(card[:status]) %>
              <% kind_badge_class = card[:kind] == "housekeeping" ? "bg-blue-50 text-blue-600 border-blue-100" : "bg-rose-50 text-rose-600 border-rose-100" %>
              <article
                draggable="true"
                data-requests-board-target="card"
                data-request-kind="<%= card[:kind] %>"
                data-request-id="<%= card[:request_id] %>"
                data-update-url="<%= card[:update_url] %>"
                data-current-status="<%= card[:status] %>"
                data-action="dragstart->requests-board#dragStart dragend->requests-board#dragEnd"
                class="cursor-grab rounded-xl border border-gray-200 bg-white p-4 shadow-sm transition hover:-translate-y-0.5 hover:shadow-md active:cursor-grabbing"
              >
                <div class="flex items-start justify-between gap-3">
                  <span class="inline-flex items-center rounded-full border px-2 py-1 text-[10px] font-bold uppercase tracking-wider <%= kind_badge_class %>">
                    <%= card[:kind].titleize %>
                  </span>
                  <span class="inline-flex items-center rounded-full px-2 py-1 text-[10px] font-bold uppercase tracking-wider <%= status_class %>">
                    <%= card[:status].titleize %>
                  </span>
                </div>

                <%= link_to card[:booking_url], class: "mt-3 block" do %>
                  <p class="text-sm font-semibold text-gray-800 leading-snug"><%= card[:title].to_s.truncate(80) %></p>
                  <p class="mt-2 text-xs text-gray-500">Guest: <%= card[:guest_name] %></p>
                  <p class="text-xs text-gray-500">Booking: <%= card[:booking_token] %></p>
                  <p class="mt-2 text-xs font-medium text-gray-600">Requested at: <%= display_housekeeping_datetime(card[:requested_at]) %></p>
                  <% if card[:completed_at].present? %>
                    <p class="text-xs font-medium text-gray-600">Completed at: <%= display_housekeeping_datetime(card[:completed_at]) %></p>
                  <% end %>
                <% end %>

                <% unless card[:status].in?(%w[completed resolved cancelled]) %>
                  <details class="group mt-4">
                    <summary class="flex justify-end list-none cursor-pointer">
                      <span class="inline-flex items-center gap-x-2 rounded-lg border border-gray-200 bg-white px-3 py-1.5 text-xs font-semibold text-red-600 shadow-sm hover:bg-gray-50">
                        Cancel
                      </span>
                    </summary>
                    <div class="mt-3 rounded-xl border border-red-100 bg-red-50/60 p-4">
                      <p class="text-xs font-semibold uppercase tracking-wider text-red-600">Cancel Request</p>
                      <p class="mt-1 text-xs text-red-600/80">Please add a note explaining why this request is cancelled.</p>
                      <%= form_with url: hotel_cancel_request_path(current_hotel, kind: card[:kind], request_id: card[:request_id]), method: :post, local: true, class: "mt-3 space-y-3" do |f| %>
                        <%= hidden_field_tag :redirect_to, hotel_requests_path(current_hotel) %>
                        <%= text_area_tag :internal_note, nil, rows: 3, class: "py-3 px-4 block w-full border-gray-200 rounded-lg text-sm focus:border-red-500 focus:ring-red-500 border", placeholder: "Reason for cancellation..." %>
                        <div class="flex justify-end gap-2">
                          <button type="button" class="inline-flex items-center gap-x-2 rounded-lg border border-gray-200 bg-white px-3 py-1.5 text-xs font-semibold text-gray-700 shadow-sm hover:bg-gray-50" onclick="this.closest('details').removeAttribute('open')">Close</button>
                          <%= f.submit "Cancel Request", class: "inline-flex items-center gap-x-2 rounded-lg border border-red-200 bg-white px-3 py-1.5 text-xs font-semibold text-red-600 shadow-sm hover:bg-red-50" %>
                        </div>
                      <% end %>
                    </div>
                  </details>
                <% end %>

                <div class="mt-4 flex justify-end">
                  <%= button_to "Archive", card[:archive_url], method: :patch, class: "inline-flex items-center gap-x-2 rounded-lg border border-gray-200 bg-white px-3 py-1.5 text-xs font-semibold text-gray-700 shadow-sm hover:bg-gray-50" %>
                </div>
              </article>
            <% end %>
          <% else %>
            <div class="rounded-xl border border-dashed border-gray-200 bg-white p-4 text-sm text-gray-500">
              No requests in this column.
            </div>
          <% end %>
        </div>
      </section>
    <% end %>
  </div>
</div>
