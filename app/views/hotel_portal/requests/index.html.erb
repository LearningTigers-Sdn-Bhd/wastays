<% content_for :title, "Requests | WAStays" %>
<% content_for :page_overscroll_class, "overscroll-none" %>

<div class="w-full space-y-3">
  <section
    class="overflow-hidden rounded-lg border border-border bg-card shadow-sm"
    aria-label="Filter requests"
    data-slot="requests-toolbar"
  >
    <%= form_with url: hotel_requests_path(current_hotel), method: :get,
          data: { controller: "auto-submit" },
          class: "divide-y divide-border" do |f| %>
      <div class="flex flex-wrap items-end gap-2.5 px-4 py-3" data-slot="requests-toolbar-controls">
        <%= render PanelsUI::FormField.new(form: f, attribute: :q, label: "Search", size: :sm, class: "min-w-64 flex-1") do |field| %>
          <% field.with_addon(align: :inline_start, variant: :bare) do %>
            <%= cached_icon "search", class: "size-4" %>
          <% end %>
          <% field.with_input(
               value: params[:q],
               autocomplete: "off",
               placeholder: "Search guest, booking or request details...",
               data: { action: "input->auto-submit#submit" }) %>
        <% end %>

        <%= render "hotel_portal/requests/date_window",
              form: f,
              date_window: @presenter.date_window,
              previous_path: @presenter.previous_window_path,
              next_path: @presenter.next_window_path,
              today_path: @presenter.today_window_path %>

        <%= render PanelsUI::Button.new(as: :a, href: hotel_requests_path(current_hotel), variant: :secondary, size: :sm, class: "shrink-0", data: { turbo_frame: "_top" }) do %>
          Reset
        <% end %>
      </div>

      <%# Which lanes to show, switched on and off independently. The count sits
          in the control that switches the lane, which is why the header's pills
          are gone: they said the same thing twice, and only one of them could be
          clicked. %>
      <div class="px-4 py-2.5" data-slot="requests-toolbar-lanes">
        <%= render PanelsUI::ToggleGroup.new(
              type: :multiple,
              name: "lanes[]",
              value: @presenter.lane_toggle_values,
              variant: :outline,
              size: :sm,
              spacing: 1,
              aria_label: "Lanes to show",
              data: {
                controller: "requests-lane-filter",
                action: "panels-ui--toggle-group:change->requests-lane-filter#change"
              }) do |group| %>
          <% group.with_item(value: "all") do %>
            All
            <%= render PanelsUI::Badge.new(
                  label: @presenter.all_lanes_count_label,
                  variant: :neutral,
                  size: :sm,
                  shape: :rounded,
                  id: "requests_lane_count_all"
                ) %>
          <% end %>
          <% @presenter.lane_options.each do |column| %>
            <% group.with_item(value: column.key.to_s) do %>
              <%= column.label %>
              <%= render PanelsUI::Badge.new(
                    label: @presenter.lane_count_label(column),
                    variant: :neutral,
                    size: :sm,
                    shape: :rounded,
                    id: "requests_lane_count_#{column.key}"
                  ) %>
            <% end %>
          <% end %>
        <% end %>
      </div>
    <% end %>
  </section>

  <p class="text-xs text-muted-foreground" data-slot="requests-toolbar-context">
    Finished and archived work from <%= @presenter.window_label %>. Open lanes show everything outstanding.
  </p>

  <%= turbo_frame_tag "requests_board_results" do %>
  <%# Five columns are wider than the page, so from xl up the board scrolls
      sideways inside its own viewport rather than making the page do it, and each
      column scrolls down inside that.

      Below xl the columns stack full width and the board viewport scrolls them. %>
  <%= render PanelsUI::ScrollArea.new(
        orientation: :horizontal,
        class: "h-[72dvh] pb-4"
      ) do %>
  <div class="flex flex-col gap-4 xl:h-full xl:flex-row xl:items-stretch" data-controller="requests-board" data-requests-board-hotel-id-value="<%= current_hotel.id %>" data-requests-board-target="board">
    <% @presenter.columns.each do |column| %>
      <% bucket_key = column.key %>
      <section
        data-requests-board-target="column"
        data-board-column="<%= bucket_key %>"
        data-accepted-request-kinds="<%= column.accepted_kinds.join(" ") %>"
        data-move-url="<%= @presenter.move_path(column) %>"
        <%# A lane takes a dropped card only where it accepts one, but it takes a
            dropped lane wherever it can be reordered -- so Checkout and Archived
            can be moved along the board without becoming somewhere a card can be
            put. %>
        <% if column.droppable? || column.reorderable? %>
          data-action="dragover->requests-board#dragOver dragleave->requests-board#dragLeave drop->requests-board#drop"
        <% end %>
        <%# From xl a fixed width, and shrink-0 so the row does not squeeze the
            columns to fit: the sideways scroll is what makes room for them.
            min-w-0 stays on the header text below, where a long title would
            otherwise widen the card. %>
        class="flex w-full flex-col overflow-hidden rounded-lg border border-border bg-card xl:h-full xl:w-[21rem] xl:shrink-0"
      >
        <div class="flex items-center justify-between gap-3 border-b border-border px-4 py-3 <%= @presenter.lane_header_class(column) %>">
          <div class="flex min-w-0 items-center gap-3">
            <span
              class="h-8 w-1 shrink-0 rounded-full <%= @presenter.lane_marker_class(column) %>"
              data-slot="requests-lane-marker"
              aria-hidden="true"
            ></span>
            <div class="min-w-0">
              <h2 class="text-base font-semibold text-foreground"><%= column.label %></h2>
              <p class="text-xs text-muted-foreground" id="requests_count_label_<%= bucket_key %>"><%= pluralize(@presenter.board_counts[bucket_key], column.request_label) %></p>
            </div>
          </div>
          <div class="flex shrink-0 items-center gap-2">
            <%= render PanelsUI::Badge.new(
                  label: "",
                  variant: :neutral,
                  size: :sm,
                  shape: :rounded,
                  hidden: true,
                  data: { requests_board_drop_hint: true }
                ) %>
            <% if column.reorderable? %>
              <button
                type="button"
                draggable="true"
                aria-label="Reorder <%= column.label %>. Use left and right arrow keys to move."
                data-action="dragstart->requests-board#columnDragStart dragend->requests-board#columnDragEnd keydown->requests-board#columnKeydown"
                class="shrink-0 p-1.5 rounded-lg text-muted-foreground hover:text-foreground hover:bg-muted cursor-grab"
              >
                <%= cached_icon "grip-vertical", stroke_width: 3, class: "size-4" %>
              </button>
            <% end %>
          </div>
        </div>

        <div class="flex min-h-0 flex-1 flex-col gap-3 overflow-y-auto bg-muted/30 p-3 custom-scrollbar">
          <%# Rendered whether or not there is anything in it: a card moved here
              arrives as a prepend into this frame, which has to be on the page
              before it can be a target. The empty state sits alongside it. %>
          <%= render "hotel_portal/requests/column_page",
                page: @presenter.page_for(bucket_key),
                column: column,
                presenter: @presenter,
                frame_id: @presenter.column_frame_id(bucket_key, nil) %>
          <% unless @presenter.board_columns[bucket_key].any? %>
            <div class="flex h-36 flex-col items-center justify-center rounded-md border border-dashed border-border" id="requests_empty_<%= bucket_key %>">
              <p class="text-xs text-muted-foreground">No <%= column.request_label.pluralize %></p>
            </div>
          <% end %>
        </div>
      </section>
    <% end %>
  </div>
  <% end %>
  <% end %>
</div>
