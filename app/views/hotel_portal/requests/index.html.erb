<% content_for :title, "Requests | WAStays" %>

<div class="w-full space-y-3.5">
  <%= render PanelsUI::PageHeader.new(title: "Requests Board") do |header| %>
    <% header.with_caption do %>
      <div class="flex flex-wrap gap-2 text-[10px] font-black uppercase tracking-wider">
        <span class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-blue-50 text-blue-700 border border-blue-100">
          Housekeeping <%= @presenter.board_counts[:housekeeping] %>
        </span>
        <span class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-rose-50 text-rose-700 border border-rose-100">
          Complaints <%= @presenter.board_counts[:complaint] %>
        </span>
        <span class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-green-50 text-green-700 border border-green-100">
          Completed <%= @presenter.board_counts[:completed] %>
        </span>
        <span class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-amber-50 text-amber-700 border border-amber-100">
          Checkouts <%= @presenter.board_counts[:checkout] %>
        </span>
        <span class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-muted text-muted-foreground border border-border">
          Archived <%= @presenter.board_counts[:archived] %>
        </span>
      </div>
    <% end %>
    <% header.with_actions do %>
      <%= render PanelsUI::Button.new(as: :a, href: hotel_request_archive_path(current_hotel), variant: :secondary, size: :md, class: "w-full lg:w-auto") do %>
        <%= cached_icon "cube", library: "phosphor", variant: "regular", class: "size-4" %>
        Full archive
      <% end %>
    <% end %>
  <% end %>

  <div class="rounded-2xl border border-border bg-card p-4 shadow-sm">
    <%= form_with url: hotel_requests_path(current_hotel), method: :get, data: { controller: "auto-submit", turbo_frame: "requests_board_results" }, class: "flex flex-wrap items-end gap-3" do |f| %>
      <div class="relative min-w-64 flex-1">
        <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none text-muted-foreground">
          <%= cached_icon "search", class: "size-4" %>
        </div>
        <%= text_field_tag :q, params[:q], autocomplete: "off", class: "w-full rounded-xl border border-border pl-10 pr-4 py-2.5 text-sm font-medium text-foreground focus:border-border-interactive focus:outline-none focus:ring-0 shadow-sm", placeholder: "Search guest, booking or request details...", data: { action: "input->auto-submit#submit" } %>
      </div>

      <%= render "hotel_portal/requests/date_window",
            form: f,
            date_window: @presenter.date_window,
            previous_path: @presenter.previous_window_path,
            next_path: @presenter.next_window_path,
            today_path: @presenter.today_window_path %>

      <div class="flex items-center gap-2">
        <%= link_to "Reset", hotel_requests_path(current_hotel), class: "rounded-xl border border-border bg-card px-6 py-2.5 text-sm font-bold text-foreground shadow-sm transition hover:bg-muted", data: { turbo_frame: "_top" } %>
      </div>
    <% end %>
    <p class="mt-3 text-[11px] font-bold uppercase tracking-wider text-muted-foreground">
      Showing <%= @presenter.window_label %>
    </p>
  </div>

  <%# Where a refused move says so. Outside the results frame, so replacing the
      board does not take the message with it. %>
  <div id="requests_board_flash" class="empty:hidden space-y-2" aria-live="polite"></div>

  <%= turbo_frame_tag "requests_board_results" do %>
  <%# Five columns are wider than the page, so from xl up the board scrolls
      sideways inside its own viewport rather than making the page do it, and each
      column scrolls down inside that.

      Below xl the columns stack full width and the page scrolls them, which is
      what a phone wants -- and it is also what keeps the lazy placeholders
      working there: given no height, a column never scrolls inside itself, so the
      frame asking for the next page only ever comes into view on page scroll. The
      scroll area is inert at that size: no height means an auto-height viewport
      with nothing to overflow. %>
  <%= render PanelsUI::ScrollArea.new(orientation: :horizontal, class: "xl:h-[calc(100vh-12rem)]") do %>
  <div class="flex flex-col gap-4 xl:h-full xl:flex-row xl:items-stretch" data-controller="requests-board" data-requests-board-hotel-id-value="<%= current_hotel.id %>" data-requests-board-target="board">
    <% @presenter.columns.each do |column| %>
      <% bucket_key = column.key %>
      <section
        data-requests-board-target="column"
        data-board-column="<%= bucket_key %>"
        <% if column.droppable? %>
          data-move-url="<%= @presenter.move_path(column) %>"
          data-action="dragover->requests-board#dragOver dragleave->requests-board#dragLeave drop->requests-board#drop"
        <% end %>
        <%# From xl a fixed width, and shrink-0 so the row does not squeeze the
            columns to fit: the sideways scroll is what makes room for them.
            min-w-0 stays on the header text below, where a long title would
            otherwise widen the card. %>
        class="flex w-full flex-col overflow-hidden rounded-2xl border border-border bg-muted/40 border-t-4 xl:h-full xl:w-[21rem] xl:shrink-0 <%= column.accent_class %>"
      >
        <div class="flex items-center justify-between gap-3 border-b border-border px-5 py-4 bg-card">
          <div class="min-w-0">
            <h2 class="text-sm font-bold uppercase tracking-wider text-foreground"><%= column.label %></h2>
            <p class="text-[11px] font-medium text-muted-foreground" id="requests_count_label_<%= bucket_key %>"><%= pluralize(@presenter.board_counts[bucket_key], column.request_label) %></p>
            <%# Outstanding work the range leaves out, so narrowing it never hides work silently. %>
            <% if @presenter.older_open?(bucket_key) %>
              <% older_label = "#{pluralize(@presenter.older_open_count(bucket_key), 'older request')} outside this range" %>
              <% if @presenter.widenable? %>
                <%= link_to older_label, @presenter.widen_path,
                      class: "mt-0.5 inline-block text-[11px] font-bold text-amber-700 underline decoration-dotted underline-offset-2 hover:text-amber-900",
                      title: "Widen to the past #{HotelPortal::Requests::DateWindow::ALLOWED_DAYS.max} days",
                      data: { turbo_frame: "_top" } %>
              <% else %>
                <p class="mt-0.5 text-[11px] font-bold text-amber-700"><%= older_label %></p>
              <% end %>
            <% end %>
          </div>
          <div class="flex shrink-0 items-center gap-2">
            <span class="inline-flex size-7 items-center justify-center rounded-full <%= column.count_badge_class %> text-xs font-black" id="requests_count_<%= bucket_key %>">
              <%= @presenter.board_counts[bucket_key] %>
            </span>
          </div>
          <% if column.reorderable? %>
            <button
              type="button"
              draggable="true"
              aria-label="Reorder <%= column.label %>. Use left and right arrow keys to move."
              data-action="dragstart->requests-board#columnDragStart dragend->requests-board#columnDragEnd keydown->requests-board#columnKeydown"
              class="shrink-0 p-1.5 rounded-lg text-muted-foreground hover:text-foreground hover:bg-muted cursor-grab"
            >
              <%= cached_icon "grip-vertical", stroke_width: 3, class: "size-4" %>
            </button>
          <% end %>
        </div>

        <div class="flex min-h-0 flex-1 flex-col gap-3 overflow-y-auto p-3 custom-scrollbar">
          <%# Rendered whether or not there is anything in it: a card moved here
              arrives as a prepend into this frame, which has to be on the page
              before it can be a target. The empty state sits alongside it. %>
          <%= render "hotel_portal/requests/column_page",
                page: @presenter.page_for(bucket_key),
                column: column,
                presenter: @presenter,
                frame_id: @presenter.column_frame_id(bucket_key, nil) %>
          <% unless @presenter.board_columns[bucket_key].any? %>
            <div class="flex flex-col items-center justify-center h-40 rounded-2xl border-2 border-dashed border-border bg-card/50" id="requests_empty_<%= bucket_key %>">
              <p class="text-[10px] font-black uppercase tracking-widest text-muted-foreground">No <%= column.request_label.pluralize %></p>
            </div>
          <% end %>
        </div>
      </section>
    <% end %>
  </div>
  <% end %>
  <% end %>
</div>
