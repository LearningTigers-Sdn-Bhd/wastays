<% content_for :title, "Request Archive | WAStays" %>

<div class="space-y-3.5">
  <div>
      <%= link_to hotel_requests_path(current_hotel), data: { turbo_frame: "_top" }, class: "inline-flex items-center gap-x-1.5 text-sm font-medium text-muted-foreground hover:text-blue-600 focus:outline-none focus:text-blue-600" do %>
        <%= cached_icon "chevron-left", class: "flex-shrink-0 w-4 h-4" %>
        Back to requests
      <% end %>
      <%= render PanelsUI::PageHeader.new(title: "Request Archive", description: "Search and filter archived housekeeping and complaint requests.") %>
  </div>

  <div class="rounded-2xl border border-border bg-card p-4 shadow-sm">
    <%= form_with url: hotel_request_archive_path(current_hotel), method: :get, data: { controller: "auto-submit", turbo_frame: "request_archive_results" }, class: "flex flex-wrap items-end gap-3" do |f| %>
      <div class="min-w-56 flex-1">
        <label class="block text-xs font-bold uppercase tracking-wider text-muted-foreground mb-2">Search</label>
        <%= text_field_tag :q, params[:q], autocomplete: "off", class: "w-full rounded-lg border border-border px-3 py-2 text-sm focus:border-border-interactive focus:outline-none focus:ring-0", placeholder: "Guest, booking, request...", data: { action: "input->auto-submit#submit" } %>
      </div>

      <%= render PanelsUI::FormField.new(form: f, attribute: :kind, label: "Type", size: :sm, class: "w-44 shrink-0") do |field| %>
        <% field.with_select_menu(
             [ { label: "All", value: "all" }, { label: "Housekeeping", value: "housekeeping" }, { label: "Complaint", value: "complaint" }, { label: "Checkout", value: "checkout" } ],
             selected: params[:kind].presence || "all",
             data: { action: "change->auto-submit#submitNow" }) %>
      <% end %>

      <%= render PanelsUI::FormField.new(form: f, attribute: :status, label: "Status", size: :sm, class: "w-44 shrink-0") do |field| %>
        <% field.with_select_menu(
             [ { label: "All", value: "all" }, { label: "Pending", value: "pending" }, { label: "Completed", value: "completed" }, { label: "Cancelled", value: "cancelled" } ],
             selected: params[:status].presence || "all",
             data: { action: "change->auto-submit#submitNow" }) %>
      <% end %>

      <%= render "hotel_portal/requests/date_window",
            form: f,
            date_window: @presenter.date_window,
            previous_path: @presenter.previous_window_path,
            next_path: @presenter.next_window_path,
            today_path: @presenter.today_window_path %>

      <%= link_to "Clear", hotel_request_archive_path(current_hotel), class: "inline-flex items-center gap-x-2 rounded-lg border border-border bg-card px-4 py-2 text-sm font-semibold text-foreground shadow-sm hover:bg-muted", data: { turbo_frame: "_top" } %>
    <% end %>
    <p class="mt-3 text-[11px] font-bold uppercase tracking-wider text-muted-foreground">
      Archived <%= @presenter.window_label %>
    </p>
  </div>

  <%= turbo_frame_tag "request_archive_results" do %>
    <div class="overflow-hidden rounded-2xl border border-border bg-card shadow-sm">
      <div class="border-b border-border bg-muted px-6 py-4">
        <h2 class="text-lg font-semibold text-foreground">Every Request</h2>
      </div>

      <% if @presenter.rows? %>
        <div class="overflow-x-auto">
          <table class="min-w-full divide-y divide-border">
            <thead class="bg-card">
              <tr>
                <th class="px-6 py-3 text-left text-xs font-bold uppercase tracking-wider text-muted-foreground">Type</th>
                <th class="px-6 py-3 text-left text-xs font-bold uppercase tracking-wider text-muted-foreground">Request</th>
                <th class="px-6 py-3 text-left text-xs font-bold uppercase tracking-wider text-muted-foreground">Guest</th>
                <th class="px-6 py-3 text-left text-xs font-bold uppercase tracking-wider text-muted-foreground">Status</th>
                <th class="px-6 py-3 text-left text-xs font-bold uppercase tracking-wider text-muted-foreground">Requested At</th>
                <th class="px-6 py-3 text-left text-xs font-bold uppercase tracking-wider text-muted-foreground">Completed At</th>
                <th class="px-6 py-3 text-right text-xs font-bold uppercase tracking-wider text-muted-foreground">Action</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-border bg-card">
              <% @presenter.rows.each do |row| %>
                <tr>
                  <td class="px-6 py-4 whitespace-nowrap">
                    <span class="inline-flex items-center rounded-full border px-2 py-1 text-[10px] font-bold uppercase tracking-wider <%= @presenter.kind_badge_class(row) %>">
                      <%= row.kind.titleize %>
                    </span>
                  </td>
                  <td class="px-6 py-4">
                    <div class="space-y-1">
                      <%= link_to @presenter.detail_path(row),
                            class: "block text-left text-sm font-semibold text-foreground hover:text-blue-600",
                            data: { turbo_frame: "requests_action_sheet" } do %>
                        <%= row.title %>
                      <% end %>
                      <p class="text-xs text-muted-foreground">Booking: <%= row.booking_token %></p>
                    </div>
                  </td>
                  <td class="px-6 py-4 whitespace-nowrap text-sm text-foreground"><%= row.guest_name %></td>
                  <td class="px-6 py-4 whitespace-nowrap">
                    <span class="inline-flex items-center rounded-full px-2 py-1 text-[10px] font-bold uppercase tracking-wider <%= @presenter.status_badge_class(row) %>">
                      <%= row.status.titleize %>
                    </span>
                  </td>
                  <td class="px-6 py-4 text-sm text-muted-foreground">
                    <%= @presenter.formatted_requested_at(row) %>
                  </td>
                  <td class="px-6 py-4 text-sm text-muted-foreground">
                    <%= @presenter.formatted_completed_at(row) %>
                  </td>
                  <td class="px-6 py-4 whitespace-nowrap text-right">
                    <div class="flex items-center justify-end gap-2">
                      <% if @presenter.show_open_link?(row) %>
                        <%= link_to "Open", row.booking_url, data: { turbo_frame: "_top" }, class: "inline-flex items-center rounded-lg border border-border bg-card px-3 py-1.5 text-xs font-semibold text-foreground shadow-sm hover:bg-muted" %>
                      <% end %>
                      <%= button_to "Restore", row.archive_url, method: :patch, class: "inline-flex items-center rounded-lg border border-border bg-card px-3 py-1.5 text-xs font-semibold text-foreground shadow-sm hover:bg-muted" %>
                    </div>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      <% else %>
        <div class="p-8 text-sm text-muted-foreground">No requests match your filters.</div>
      <% end %>

      <%# Not numbered pages: the archive is live -- staff archive and restore
          things while somebody reads it -- and OFFSET counts rows that have since
          moved, so it skips and repeats them. The cursor names the last row read
          instead, which means the archive travels one way and back to the start. %>
      <div class="flex items-center justify-between gap-3 border-t border-border bg-muted/50 px-6 py-5">
        <p class="text-xs text-muted-foreground">
          <%= pluralize(@presenter.total_count, "archived request") %> in this range
        </p>
        <div class="flex items-center gap-2">
          <% if @presenter.paged? %>
            <%= render PanelsUI::Button.new(as: :a, href: @presenter.newest_page_path, variant: :ghost, size: :sm) do %>
              <%= cached_icon "chevron-left", class: "size-4" %>
              Newest
            <% end %>
          <% end %>
          <% if @presenter.more? %>
            <%= render PanelsUI::Button.new(as: :a, href: @presenter.next_page_path, variant: :secondary, size: :sm) do %>
              Older
              <%= cached_icon "chevron-right", class: "size-4" %>
            <% end %>
          <% end %>
        </div>
      </div>
    </div>
  <% end %>
</div>
