<%#
  One request's detail, shared by the board and the archive.

  Replaces two dialogs that described the same request with different field
  names ("Guest Details" against "Guest", "Request Body" against "Requests"),
  and rendered one copy of themselves per row on the page.

  Locals: presenter - HotelPortal::Requests::DetailPresenter
%>
<div class="min-h-0 flex-1 space-y-6 overflow-y-auto p-4">
  <section>
    <h3 class="text-xs font-bold uppercase tracking-wider text-muted-foreground">Request</h3>
    <p class="mt-2 whitespace-pre-wrap rounded-xl border border-border bg-muted/40 p-4 text-sm font-medium leading-relaxed text-foreground">
      <%= presenter.title %>
    </p>
  </section>

  <section>
    <h3 class="text-xs font-bold uppercase tracking-wider text-muted-foreground">Details</h3>
    <dl class="mt-2 divide-y divide-border rounded-xl border border-border">
      <div class="flex items-baseline justify-between gap-4 px-4 py-2.5">
        <dt class="text-xs font-semibold text-muted-foreground">Guest</dt>
        <dd class="text-sm font-semibold text-foreground"><%= presenter.guest_name.presence || "—" %></dd>
      </div>
      <div class="flex items-baseline justify-between gap-4 px-4 py-2.5">
        <dt class="text-xs font-semibold text-muted-foreground">Status</dt>
        <dd>
          <%= render PanelsUI::Badge.new(label: presenter.status.to_s.titleize, variant: :neutral, size: :sm) %>
        </dd>
      </div>
      <% if presenter.room_number.present? %>
        <div class="flex items-baseline justify-between gap-4 px-4 py-2.5">
          <dt class="text-xs font-semibold text-muted-foreground">Room</dt>
          <dd class="text-sm font-semibold text-foreground"><%= presenter.room_number %></dd>
        </div>
      <% end %>
      <div class="flex items-baseline justify-between gap-4 px-4 py-2.5">
        <dt class="text-xs font-semibold text-muted-foreground">Raised by</dt>
        <dd class="text-sm text-foreground"><%= presenter.source_label %></dd>
      </div>
      <% if presenter.assigned_to_name.present? %>
        <div class="flex items-baseline justify-between gap-4 px-4 py-2.5">
          <dt class="text-xs font-semibold text-muted-foreground">Assigned to</dt>
          <dd class="text-sm font-semibold text-foreground"><%= presenter.assigned_to_name %></dd>
        </div>
      <% end %>
      <div class="flex items-baseline justify-between gap-4 px-4 py-2.5">
        <dt class="text-xs font-semibold text-muted-foreground">Requested</dt>
        <dd class="text-sm text-foreground"><%= display_housekeeping_datetime(presenter.requested_at) %></dd>
      </div>
      <% if presenter.completed_at.present? %>
        <div class="flex items-baseline justify-between gap-4 px-4 py-2.5">
          <dt class="text-xs font-semibold text-muted-foreground">Finished</dt>
          <dd class="text-sm text-foreground"><%= display_housekeeping_datetime(presenter.completed_at) %></dd>
        </div>
      <% end %>
      <% if presenter.archived? %>
        <div class="flex items-baseline justify-between gap-4 px-4 py-2.5">
          <dt class="text-xs font-semibold text-muted-foreground">Archived</dt>
          <dd class="text-sm text-foreground"><%= display_housekeeping_datetime(presenter.archived_at) %></dd>
        </div>
      <% end %>
    </dl>
  </section>

  <section>
    <h3 class="text-xs font-bold uppercase tracking-wider text-muted-foreground">Internal notes</h3>
    <% if presenter.internal_notes? %>
      <div class="mt-2 space-y-2">
        <% presenter.internal_notes.each do |note| %>
          <div class="rounded-xl border border-border bg-card p-3">
            <p class="whitespace-pre-wrap text-sm text-foreground"><%= note["body"] %></p>
            <% if note["created_by_name"].present? %>
              <p class="mt-1 text-[11px] font-medium text-muted-foreground"><%= note["created_by_name"] %></p>
            <% end %>
          </div>
        <% end %>
      </div>
    <% else %>
      <p class="mt-2 text-sm text-muted-foreground">No notes recorded.</p>
    <% end %>
  </section>
</div>
