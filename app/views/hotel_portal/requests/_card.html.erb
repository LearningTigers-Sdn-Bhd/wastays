<%#
  One card on the board, shared by the first page and every page scrolled after
  it, and by the archive.

  Locals: card, column, presenter
%>
<% draggable = presenter.card_draggable?(card, column) %>
<article
  id="<%= card.dom_id %>"
  draggable="<%= draggable %>"
  data-requests-board-target="card"
  data-request-kind="<%= card.kind %>"
  data-request-id="<%= card.request_id %>"
  data-card-column="<%= column.key %>"
  data-current-status="<%= card.status %>"
  <% if draggable %>
    tabindex="0"
    role="button"
    aria-label="<%= "#{card.kind} request for #{card.guest_name}. Press Enter to pick up and move." %>"
    data-action="dragstart->requests-board#dragStart dragend->requests-board#dragEnd keydown->requests-board#cardKeydown"
  <% end %>
  class="group rounded-xl border border-border bg-card p-4 shadow-sm transition hover:border-border-interactive hover:shadow-md focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-border-interactive aria-grabbed:opacity-60 <%= "cursor-grab active:cursor-grabbing" if draggable %>"
>
  <div class="mb-3 flex items-center justify-between">
    <div class="flex min-w-0 items-center gap-2">
      <span class="shrink-0 rounded border px-2 py-0.5 text-[9px] font-black uppercase <%= presenter.kind_badge_class(card) %>">
        <%= card.kind %>
      </span>
      <span class="truncate font-mono text-[10px] font-bold tracking-tight text-muted-foreground"><%= presenter.card_token_label(card) %></span>
    </div>
    <span class="shrink-0 rounded border border-border bg-muted px-2 py-0.5 text-[9px] font-black uppercase text-muted-foreground">
      <%= card.status %>
    </span>
  </div>

  <%= link_to presenter.detail_path(card), class: "block w-full text-left", data: { turbo_frame: "requests_action_sheet" } do %>
    <p class="line-clamp-2 text-sm font-bold leading-snug text-foreground transition-colors group-hover:text-blue-600"><%= card.title %></p>
  <% end %>

  <div class="mt-4 flex items-center justify-between gap-2 border-t border-border pt-3">
    <div class="flex min-w-0 flex-col">
      <span class="max-w-[140px] truncate text-xs font-bold text-foreground"><%= card.guest_name %></span>
      <span class="text-[10px] font-medium uppercase tracking-tight text-muted-foreground"><%= presenter.formatted_requested_at(card) %></span>
    </div>
    <% if (action = presenter.card_action(card, column)) %>
      <div class="flex shrink-0 items-center gap-2">
        <%= button_to action[:url], params: action[:params], method: :patch, class: action[:css], title: action[:title] do %>
          <%= cached_icon action[:icon], **(action[:icon_opts] || {}), class: "size-3.5" %>
          <%= action[:label] %>
        <% end %>
      </div>
    <% end %>
  </div>
</article>
