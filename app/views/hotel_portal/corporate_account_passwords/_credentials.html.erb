<div data-controller="ui--sheet-frame">
  <%= render PanelsUI::Sheet.new(id: "external-account-credentials", side: :right, size: :lg,
    title: "Temporary sign-in details", description: "Share these details with the account holder.") do |sheet| %>
    <% sheet.with_body do %>
      <div class="space-y-5">
        <% [ [ "Login email", @credential_user.email ], [ "Temporary password", @credential_user.temporary_password ] ].each do |label, value| %>
          <div class="space-y-2" data-controller="clipboard" data-clipboard-success-text-value="Copied">
            <p class="text-sm font-medium text-foreground"><%= label %></p>
            <div class="flex items-center gap-2">
              <code class="min-w-0 flex-1 break-all rounded-md bg-muted px-3 py-2 text-sm" data-clipboard-target="source"><%= value %></code>
              <%= render PanelsUI::Button.new(as: :button, type: :button, variant: :secondary,
                aria_label: "Copy #{label.downcase}", data: { clipboard_target: "button", action: "clipboard#copy" }) do %>Copy<% end %>
            </div>
            <span class="sr-only" aria-live="polite" data-clipboard-target="status"></span>
          </div>
        <% end %>
        <p class="text-xs text-muted-foreground">The account holder can change this password on their Corporate Profile page. Once changed, hotel staff cannot view or reset it.</p>
      </div>
    <% end %>
    <% sheet.with_footer do %>
      <%= render PanelsUI::Button.new(as: :a, href: @return_to, variant: :primary, data: { turbo_frame: "_top" }) do %>Done<% end %>
    <% end %>
  <% end %>
</div>
