<div data-controller="ui--sheet-frame">
  <%= render PanelsUI::Sheet.new(id: "external-account-credentials", side: :right, size: :lg,
    title: "Temporary sign-in details", description: "Share these details with the account holder.") do |sheet| %>
    <% sheet.with_body do %>
      <% message = [
        "How to access your WAStays account",
        "",
        "1. Open #{login_url}",
        "",
        "2. Sign in with these details:",
        "   Login email: #{@credential_user.email}",
        "   Temporary password: #{@credential_user.temporary_password}",
        "",
        "3. Open Profile and use Change password to choose your own password. Enter the temporary password as your current password.",
        "",
        "After you change your password, hotel staff can no longer view or reset it."
      ].join("\n") %>
      <div class="space-y-3" data-controller="clipboard" data-clipboard-success-text-value="Copied">
        <%= fields_for :sign_in_details do |form| %>
          <%= render PanelsUI::FormField.new(form: form, attribute: :message, label: "Message to send", readonly: true,
            hint: "Copy this message and send it to the account holder.") do |field| %>
            <% field.with_text_area(value: message, rows: 13,
              data: { clipboard_target: "source" }) %>
          <% end %>
        <% end %>
        <%= render PanelsUI::Button.new(as: :button, type: :button, variant: :secondary,
          data: { clipboard_target: "button", action: "clipboard#copy" }) do %>Copy message<% end %>
        <span class="sr-only" aria-live="polite" data-clipboard-target="status"></span>
      </div>
    <% end %>
    <% sheet.with_footer do %>
      <%= render PanelsUI::Button.new(as: :a, href: @return_to, variant: :primary, data: { turbo_frame: "_top" }) do %>Done<% end %>
    <% end %>
  <% end %>
</div>
