<%= turbo_frame_tag "concierge_qr_dialog" do %>
  <div data-controller="concierge-qr">
    <%= render PanelsUI::Dialog.new(
          id: "concierge-qr-code-dialog",
          size: :almost_full,
          title: "Concierge QR Code",
          description: "Print and display this QR code at your front desk. Guests scan it to check in, check out, book, request, or contact you.") do |dialog| %>
      <% dialog.with_body do %>
        <div id="concierge-qr-print-area" class="mx-auto flex min-h-full max-w-2xl flex-col items-center justify-center space-y-6 px-4 py-8 text-center sm:px-8">
          <div class="space-y-2">
            <p class="text-xs font-semibold uppercase tracking-wider text-muted-foreground">Front desk concierge</p>
            <h2 class="text-2xl font-bold text-foreground"><%= current_hotel.name %></h2>
            <p class="text-sm text-muted-foreground">Scan to check in, check out, book, or request assistance.</p>
          </div>

          <div class="size-56 rounded-lg border border-border bg-card p-3 sm:size-64" aria-label="Concierge QR code">
            <%= @qr_svg %>
          </div>

          <div class="w-full max-w-xl rounded-lg border border-border bg-muted px-4 py-3">
            <p class="text-xs font-semibold uppercase tracking-wider text-muted-foreground">Concierge URL</p>
            <p class="mt-1 break-all font-mono text-sm font-medium text-foreground" data-concierge-qr-target="url"><%= @concierge_url %></p>
          </div>
        </div>
      <% end %>

      <% dialog.with_footer do %>
        <div class="flex w-full flex-wrap items-center gap-2 sm:justify-end">
          <%= render PanelsUI::Button.new(
                as: :button,
                type: :button,
                variant: :primary,
                size: :sm,
                data: { action: "concierge-qr#print" }) do %>
            <%= app_icon "printer", class: "size-4", aria: { hidden: "true" } %>
            <span>Print</span>
          <% end %>

          <%= render PanelsUI::Button.new(
                href: hotel_concierge_qr_path(current_hotel, format: :svg),
                variant: :secondary,
                size: :sm,
                download: true,
                data: { turbo: false }) do %>
            <%= app_icon "download", class: "size-4", aria: { hidden: "true" } %>
            <span>Download SVG</span>
          <% end %>

          <%= render PanelsUI::Button.new(
                href: hotel_concierge_qr_path(current_hotel, format: :png),
                variant: :secondary,
                size: :sm,
                download: true,
                data: { turbo: false }) do %>
            <%= app_icon "download", class: "size-4", aria: { hidden: "true" } %>
            <span>Download PNG</span>
          <% end %>

          <%= render PanelsUI::Button.new(
                as: :button,
                type: :button,
                variant: :secondary,
                size: :sm,
                data: {
                  action: "concierge-qr#copy",
                  concierge_qr_target: "copyButton"
                }) do %>
            <%= app_icon "copy", class: "size-4", aria: { hidden: "true" } %>
            <span>Copy URL</span>
          <% end %>
        </div>
      <% end %>
    <% end %>
  </div>
<% end %>

<style>
  @media print {
    body * { visibility: hidden; }
    #concierge-qr-print-area, #concierge-qr-print-area * { visibility: visible; }
    #concierge-qr-print-area { position: absolute; inset: 0; width: 100%; max-width: none; }
    @page { margin: 8mm; }
  }
</style>
