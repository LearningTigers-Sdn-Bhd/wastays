<% content_for :breadcrumbs do %>
  <div class="flex items-center gap-x-2">
    <span class="text-sm font-medium text-slate-600"><%= current_hotel.name %></span>
    <span class="text-sm text-slate-400">/</span>
    <span class="text-sm font-semibold text-slate-900">Notification Logs</span>
  </div>
<% end %>

<div class="max-w-[1600px] mx-auto pb-20 space-y-8">
  <div class="px-4 md:px-0">
    <div class="mt-5">
      <h1 class="text-2xl font-bold tracking-tight text-slate-950 sm:text-3xl">Notification Logs</h1>
      <p class="mt-1 text-sm font-medium text-slate-600">Review check-in notification attempts across channels.</p>
    </div>
  </div>

  <div class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">
    <div class="border-b border-slate-200 bg-slate-50/70 px-6 py-6 sm:px-8">
      <%= form_with url: hotel_notification_logs_path(current_hotel), method: :get, class: "flex flex-col gap-4 xl:flex-row xl:items-end xl:justify-between", data: { controller: "auto-submit", turbo_frame: "notification_logs_results" } do |f| %>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4 flex-1">
          <div>
            <label class="block text-[11px] font-bold text-slate-500 uppercase tracking-wider mb-2">Search</label>
            <%= f.text_field :query, value: params[:query], placeholder: "Booking ref, guest, phone, error...", autocomplete: "off", class: "w-full rounded-xl border border-slate-200 bg-white px-4 py-2.5 text-sm font-medium text-slate-700 placeholder:text-slate-400 focus:border-slate-300 focus:outline-none focus:ring-0 shadow-sm", data: { action: "input->auto-submit#submit" } %>
          </div>
          <div>
            <label class="block text-[11px] font-bold text-slate-500 uppercase tracking-wider mb-2">Notification Type</label>
            <%= f.select :notification_type, [["Check-In Confirmation", "check_in_confirmation"]], { include_blank: "All Types", selected: params[:notification_type] }, class: "w-full rounded-xl border border-slate-200 bg-white px-4 py-2.5 text-sm font-medium text-slate-700 focus:border-slate-300 focus:outline-none focus:ring-0 shadow-sm", data: { action: "change->auto-submit#submitNow" } %>
          </div>
          <div>
            <label class="block text-[11px] font-bold text-slate-500 uppercase tracking-wider mb-2">Channel</label>
            <%= f.select :channel, [["WhatsApp", "whatsapp"], ["Email", "email"]], { include_blank: "All Channels", selected: params[:channel] }, class: "w-full rounded-xl border border-slate-200 bg-white px-4 py-2.5 text-sm font-medium text-slate-700 focus:border-slate-300 focus:outline-none focus:ring-0 shadow-sm", data: { action: "change->auto-submit#submitNow" } %>
          </div>
          <div>
            <label class="block text-[11px] font-bold text-slate-500 uppercase tracking-wider mb-2">Status</label>
            <%= f.select :status, [["Pending", "pending"], ["Sent", "sent"], ["Failed", "failed"]], { include_blank: "All Statuses", selected: params[:status] }, class: "w-full rounded-xl border border-slate-200 bg-white px-4 py-2.5 text-sm font-medium text-slate-700 focus:border-slate-300 focus:outline-none focus:ring-0 shadow-sm", data: { action: "change->auto-submit#submitNow" } %>
          </div>
        </div>
        <div class="flex items-center gap-2 lg:mb-0.5">
          <%= link_to "Reset", hotel_notification_logs_path(current_hotel), class: "inline-flex items-center rounded-xl border border-slate-200 bg-white px-5 py-2.5 text-sm font-bold text-slate-700 shadow-sm transition hover:bg-slate-50" %>
        </div>
      <% end %>
    </div>

    <%= turbo_frame_tag "notification_logs_results" do %>
      <div class="overflow-x-auto">
        <table class="min-w-full table-fixed">
          <colgroup>
            <col class="w-[18%]">
            <col class="w-[15%]">
            <col class="w-[12%]">
            <col class="w-[12%]">
            <col class="w-[20%]">
            <col class="w-[23%]">
          </colgroup>
          <thead class="bg-slate-100">
            <tr>
              <th class="px-6 py-4 text-left text-[11px] font-semibold uppercase tracking-[0.1em] text-slate-600 sm:px-8">Time</th>
              <th class="px-6 py-4 text-left text-[11px] font-semibold uppercase tracking-[0.1em] text-slate-600">Booking</th>
              <th class="px-6 py-4 text-left text-[11px] font-semibold uppercase tracking-[0.1em] text-slate-600">Type</th>
              <th class="px-6 py-4 text-left text-[11px] font-semibold uppercase tracking-[0.1em] text-slate-600">Channel</th>
              <th class="px-6 py-4 text-left text-[11px] font-semibold uppercase tracking-[0.1em] text-slate-600">Status</th>
              <th class="px-6 py-4 text-left text-[11px] font-semibold uppercase tracking-[0.1em] text-slate-600 sm:px-8">Error</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-200 bg-white">
            <% if @logs.any? %>
              <% @logs.each_with_index do |log, index| %>
                <tr class="align-top transition-colors hover:bg-slate-100/80 <%= index.even? ? 'bg-white' : 'bg-slate-50/55' %>">
                  <td class="px-6 py-4 sm:px-8">
                    <span class="text-sm font-medium text-slate-900"><%= log.created_at.strftime("%d %b %Y") %></span>
                    <span class="block text-[10px] font-bold text-slate-500"><%= log.created_at.strftime("%I:%M %p") %></span>
                  </td>
                  <td class="px-6 py-4">
                    <span class="text-sm font-semibold text-slate-900"><%= log.booking.confirmation_token %></span>
                    <span class="block text-xs text-slate-500"><%= log.payload["guest_name"] || log.booking.guest_name %></span>
                  </td>
                  <td class="px-6 py-4">
                    <span class="text-sm text-slate-700 font-medium"><%= log.notification_type.to_s.humanize %></span>
                  </td>
                  <td class="px-6 py-4">
                    <span class="text-sm text-slate-700 font-medium"><%= log.channel.to_s.humanize %></span>
                  </td>
                  <td class="px-6 py-4">
                    <% status_class = case log.status
                                      when "sent" then "border-emerald-200 bg-emerald-50 text-emerald-700"
                                      when "failed" then "border-red-200 bg-red-50 text-red-700"
                                      else "border-amber-200 bg-amber-50 text-amber-700"
                                      end %>
                    <span class="inline-flex items-center rounded-full border px-2.5 py-1 text-[10px] font-bold uppercase tracking-wider <%= status_class %>"><%= log.status %></span>
                  </td>
                  <td class="px-6 py-4 sm:px-8">
                    <span class="text-sm text-slate-600"><%= log.error_message.presence || "-" %></span>
                  </td>
                </tr>
              <% end %>
            <% else %>
              <tr>
                <td colspan="6" class="px-6 py-20 text-center sm:px-8">
                  <p class="text-sm font-medium text-slate-500 italic">No notification logs found matching your criteria.</p>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>

      <div class="px-6 py-4 border-t border-slate-200 bg-slate-50/50 flex justify-center sm:px-8">
        <%= paginate @logs %>
      </div>
    <% end %>
  </div>
</div>
