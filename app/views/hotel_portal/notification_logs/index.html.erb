<div class="w-full space-y-4" data-slot="report-page" data-report="notification-logs">
  <%= turbo_frame_tag "notification_logs_results", class: "block space-y-4" do %>
  <%= render PanelsUI::PageHeader.new(title: "Notification logs", description: "Review notification attempts and resend when needed.") do |header| %>
    <% header.with_caption do %>
      <p class="text-sm font-medium text-muted-foreground"><%= current_hotel.name %> · All notification records</p>
    <% end %>
    <% header.with_actions do %>
      <% export_filters = { query: params[:query], notification_type: params[:notification_type], channel: params[:channel], status: params[:status] } %>
      <%= render PanelsUI::DropdownMenu.new(id: "notification-logs-export-menu", placement: :bottom_end) do |menu| %>
        <% menu.with_trigger(variant: :secondary) do %>
          <%= cached_icon "download", class: "me-2 size-4" %>
          Export
          <%= cached_icon "chevron-down", class: "ms-2 size-4", aria: { hidden: "true" } %>
        <% end %>
        <% menu.with_item(href: hotel_notification_logs_path(current_hotel, **export_filters, format: :pdf), data: { turbo: false }) { "Export PDF" } %>
        <% menu.with_item(href: hotel_notification_logs_path(current_hotel, **export_filters, format: :xlsx), data: { turbo: false }) { "Export Excel" } %>
        <% menu.with_item(href: hotel_notification_logs_path(current_hotel, **export_filters, format: :csv), data: { turbo: false }) { "Export CSV" } %>
      <% end %>
    <% end %>
  <% end %>

  <%= render HotelPortal::Reports::MetricStrip.new(
        aria_label: "Notification delivery summary",
        metrics: [
          { label: "Total records", value: @notification_summary[:total].to_s, detail: "Current filters" },
          { label: "Failed", value: @notification_summary[:failed].to_s, detail: "Current filters · needs attention", detail_variant: :destructive },
          { label: "Pending", value: @notification_summary[:pending].to_s, detail: "Current filters · awaiting delivery", detail_variant: :warning },
          { label: "Sent", value: @notification_summary[:sent].to_s, detail: "Current filters · delivered", detail_variant: :success }
        ]
      ) %>

  <section class="rounded-lg border border-border bg-card p-3" aria-label="Notification log filters">
    <%= form_with url: hotel_notification_logs_path(current_hotel), method: :get,
          id: "notification-logs-filter-form",
          class: "flex flex-col gap-3 xl:flex-row xl:items-end",
          data: { controller: "auto-submit", turbo_frame: "notification_logs_results", turbo_permanent: true } do |f| %>
      <div class="grid flex-1 grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-4">
        <%= render PanelsUI::FormField.new(form: f, attribute: :query, label: "Search", size: :sm) do |field| %>
          <% field.with_input(
               type: :search,
               value: params[:query],
               placeholder: "Booking ref, guest, phone, error…",
               autocomplete: "off",
               data: { action: "input->auto-submit#submit" }) %>
        <% end %>
        <%= render PanelsUI::FormField.new(form: f, attribute: :notification_type, label: "Notification type", size: :sm) do |field| %>
          <% field.with_select_menu(
               [
                 { label: "All types", value: "" },
                 { label: "Pre-arrival notification", value: "pre_arrival_notification" },
                 { label: "Check-in confirmation", value: "check_in_confirmation" },
                 { label: "Post-stay review request", value: "post_stay_review_request" },
                 { label: "Check-out receipt message", value: "check_out_receipt_message" },
                 { label: "In-stay guest messaging", value: "in_stay_guest_messaging" }
               ],
               selected: params[:notification_type],
               data: { action: "change->auto-submit#submitNow" }) %>
        <% end %>
        <%= render PanelsUI::FormField.new(form: f, attribute: :channel, label: "Channel", size: :sm) do |field| %>
          <% field.with_select_menu(
               [
                 { label: "All channels", value: "" },
                 { label: "WhatsApp", value: "whatsapp" },
                 { label: "Email", value: "email" }
               ],
               selected: params[:channel],
               data: { action: "change->auto-submit#submitNow" }) %>
        <% end %>
        <%= render PanelsUI::FormField.new(form: f, attribute: :status, label: "Status", size: :sm) do |field| %>
          <% field.with_select_menu(
               [
                 { label: "All statuses", value: "" },
                 { label: "Pending", value: "pending" },
                 { label: "Sent", value: "sent" },
                 { label: "Failed", value: "failed" },
                 { label: "Skipped", value: "skipped" }
               ],
               selected: params[:status],
               data: { action: "change->auto-submit#submitNow" }) %>
        <% end %>
      </div>
      <%= render PanelsUI::Button.new(
            href: hotel_notification_logs_path(current_hotel),
            variant: :secondary,
            size: :sm,
            data: { turbo_frame: "_top", turbo: false }
          ) do %>
        Reset
      <% end %>
    <% end %>
  </section>

    <section class="space-y-3" aria-labelledby="notification-log-records-heading">
      <h2 id="notification-log-records-heading" class="text-base font-semibold text-foreground">Notification log records</h2>

      <%= render PanelsUI::Table.new(
            caption: "Notification logs",
            density: :compact,
            header_style: :sentence,
            hoverable: true,
            class: "min-w-[64rem] table-fixed",
            wrapper_class: "rounded-lg border border-border bg-card"
          ) do |table| %>
        <% table.with_header do %>
          <tr>
            <th scope="col" class="w-[16%]">Time</th>
            <th scope="col" class="w-[15%]">Booking</th>
            <th scope="col" class="w-[16%]">Type</th>
            <th scope="col" class="w-[10%]">Channel</th>
            <th scope="col" class="w-[11%]">Status</th>
            <th scope="col" class="w-[22%]">Error</th>
            <th scope="col" class="w-[10%]">Actions</th>
          </tr>
        <% end %>
        <% table.with_body do %>
          <% if @logs.any? %>
            <% @logs.each do |log| %>
              <% status_variant = case log.status
                                  when "sent" then :success
                                  when "failed" then :destructive
                                  when "skipped" then :neutral
                                  else :warning
                                  end %>
              <tr class="align-top">
                <td class="whitespace-nowrap">
                  <span class="font-medium text-foreground"><%= log.created_at.strftime("%d %b %Y") %></span>
                  <span class="block text-xs text-muted-foreground"><%= log.created_at.strftime("%I:%M %p") %></span>
                </td>
                <td>
                  <span class="font-semibold text-foreground"><%= log.booking.confirmation_token %></span>
                  <span class="block text-xs text-muted-foreground"><%= log.payload["guest_name"] || log.booking.guest_name %></span>
                </td>
                <td>
                  <span class="font-medium text-foreground"><%= log.notification_type.to_s.humanize %></span>
                  <% if log.notification_type == "pre_arrival_notification" && log.payload.to_h["stage"].present? %>
                    <span class="block text-xs font-semibold text-muted-foreground"><%= log.payload.to_h["stage"] %></span>
                  <% end %>
                  <% if log.notification_type == "in_stay_guest_messaging" && log.payload.to_h["rule_key"].present? %>
                    <span class="block text-xs font-semibold text-muted-foreground"><%= log.payload.to_h["rule_key"] %></span>
                  <% end %>
                </td>
                <td class="font-medium text-foreground"><%= log.channel.to_s.humanize %></td>
                <td>
                  <%= render PanelsUI::Badge.new(label: log.status.humanize, variant: status_variant, size: :sm) %>
                </td>
                <td class="text-muted-foreground"><%= log.error_message.presence || "—" %></td>
                <td>
                  <% if current_user.has_permission?("manage_bookings", hotel: current_hotel) && log.status.in?(%w[sent failed skipped]) %>
                    <%= render PanelsUI::Button.new(
                          as: :button,
                          type: :button,
                          variant: :secondary,
                          size: :xs,
                          command: "show-modal",
                          commandfor: "resend-modal-#{log.id}"
                        ) do %>
                      Resend
                    <% end %>

                    <%= form_with url: resend_hotel_notification_log_path(current_hotel, log), method: :post do |rf| %>
                      <%= render PanelsUI::Dialog.new(
                            id: "resend-modal-#{log.id}",
                            title: "Resend notification",
                            description: "Booking #{log.booking.confirmation_token} · #{log.channel.humanize}",
                            size: :sm
                          ) do |dialog| %>
                        <% dialog.with_body do %>
                          <div class="space-y-3">
                            <p class="text-sm text-muted-foreground">This creates a new resend log entry for audit tracking.</p>
                            <%= render PanelsUI::FormField.new(
                                  form: rf,
                                  attribute: "resend_#{log.id}_resend_reason",
                                  label: "Reason",
                                  hint: "Explain why this notification needs to be resent.",
                                  required: true
                                ) do |field| %>
                              <% field.with_text_area(
                                   rows: 3,
                                   name: "resend_reason",
                                   placeholder: "Why are you resending this notification?"
                                 ) %>
                            <% end %>
                          </div>
                        <% end %>
                        <% dialog.with_footer do %>
                          <%= render PanelsUI::Button.new(
                                as: :button,
                                type: :button,
                                variant: :secondary,
                                size: :sm,
                                data: { action: "panels-ui--dialog#close" }
                              ) do %>
                            Cancel
                          <% end %>
                          <%= render PanelsUI::Button.new(as: :button, type: :submit, size: :sm) do %>
                            Confirm resend
                          <% end %>
                        <% end %>
                      <% end %>
                    <% end %>
                  <% else %>
                    <span class="text-xs text-muted-foreground">—</span>
                  <% end %>
                </td>
              </tr>
            <% end %>
          <% else %>
            <%= render "hotel_portal/reports/table_empty_state", colspan: 7, message: "No notification logs found matching your criteria." %>
          <% end %>
        <% end %>
      <% end %>

      <%= render "hotel_portal/reports/table_pagination", collection: @logs %>
    </section>
  <% end %>
</div>
