<%
  photos = hotel.ordered_photo_attachments
  return_to = local_assigns[:return_to]
  # Onboarding shows the same grid while the property is still filling it in.
  # Ordering belongs to the album page, and one photo has no order to change.
  reorderable = local_assigns.fetch(:reorderable, true) && photos.many?
%>

<div id="hotel-published-photos" class="min-h-40">
  <% if photos.any? %>
    <%# Dragging stages the order in the hidden field below. Save writes it and
        Cancel puts the tiles back, so the album matches every other block on
        property settings: nothing changes until somebody says so.

        The grid deliberately sits outside the form. Each photo's Remove action
        is a button_to, and a form inside a form ends the outer one early —
        which left Save and Cancel orphaned from the controller driving them. %>
    <%= tag.div(data: { controller: ("photo-reorder" if reorderable) }.compact) do %>
      <% if reorderable %>
        <p class="mb-3 text-xs text-muted-foreground">
          Drag a photo to reorder the album. The featured photo always stays first.
        </p>
      <% end %>

      <%= render "hotel_portal/profiles/photo_grid",
                 hotel: hotel,
                 photos: photos,
                 return_to: return_to,
                 reorderable: reorderable %>

      <% if reorderable %>
        <%= form_with url: hotel_reorder_profile_photos_path(hotel), method: :patch do %>
          <%= hidden_field_tag :return_to, return_to %>
          <%# Carries every tile, the featured one included, so the field and the
              grid always read the same. The model drops the featured id. %>
          <%= hidden_field_tag :ordered_ids,
                               photos.map(&:id).join(","),
                               data: { photo_reorder_target: "input" } %>

          <footer class="mt-5 flex justify-end gap-3">
            <%# Cancel only exists while there is something to discard, and Save
                starts disabled, the same way each property settings section does.
                The reorder controller drives both, because the room category
                sheet keeps them outside their form and form-dirty cannot reach
                across that. %>
            <%= render PanelsUI::Button.new(
                  as: :button,
                  type: :button,
                  variant: :secondary,
                  size: :sm,
                  hidden: true,
                  data: { photo_reorder_target: "cancel", action: "photo-reorder#reset" }) do %>
              Cancel
            <% end %>
            <%= render PanelsUI::Button.new(
                  as: :button,
                  type: :submit,
                  size: :sm,
                  disabled: true,
                  data: { photo_reorder_target: "submit" }) do %>
              Save Order
            <% end %>
          </footer>
        <% end %>
      <% end %>
    <% end %>
  <% else %>
    <%# The state carries the upload action itself, so nobody looking at an empty
        album has to go find the button. Both places that render this partial
        also render the upload sheet it opens. %>
    <%= render PanelsUI::EmptyState.new(
          title: "No photos yet",
          description: "Photos are how guests decide. Add the ones that show the property best — the first becomes the featured photo, and you can change that later.",
          icon: "image") do |state| %>
      <% state.with_action do %>
        <%= render PanelsUI::Button.new(as: :button, variant: :neutral, size: :sm,
              command: "show-modal", commandfor: "hotel-photo-upload-sheet") do %>
          <%= app_icon "upload", class: "size-4", aria: { hidden: "true" } %>
          <span>Upload photos</span>
        <% end %>
      <% end %>
    <% end %>
  <% end %>
</div>
