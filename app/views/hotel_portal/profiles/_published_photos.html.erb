<div id="hotel-published-photos" class="min-h-40">
  <% if hotel.photos.attached? %>
    <%= render PanelsUI::AttachmentGroup.new(
          layout: :grid,
          size: :lg,
          aria: { label: "Published hotel photos" }) do %>
      <% hotel.photos.attachments.includes(:blob).each do |photo| %>
        <% featured = hotel.featured_photo_attachment_id.to_i == photo.id %>
        <%= render PanelsUI::Attachment.new(
              title: photo.filename.to_s,
              description: featured ? "Featured photo" : "Published photo",
              state: :uploaded,
              orientation: :vertical,
              role: "listitem") do |attachment| %>
          <% attachment.with_media(variant: :image) do %>
            <%= image_tag photo, alt: "Hotel photo #{photo.filename}" %>
          <% end %>
          <% attachment.with_actions do %>
            <% if featured %>
              <%= render PanelsUI::Badge.new(label: "Featured", variant: :primary, size: :sm) %>
            <% end %>
            <%= render PanelsUI::DropdownMenu.new(
                  id: "hotel-photo-#{photo.id}-actions",
                  placement: :bottom_end,
                  class: "w-44") do |menu| %>
              <% menu.with_trigger(
                   variant: :ghost,
                   size: :icon_sm,
                   aria_label: "Actions for #{photo.filename}") do %>
                <%= app_icon "ellipsis-vertical", class: "size-4", aria: { hidden: "true" } %>
              <% end %>
              <% unless featured %>
                <% menu.with_item(
                     href: hotel_profile_photo_feature_path(hotel, photo.id, return_to: local_assigns[:return_to]),
                     method: :patch) do %>
                  <%= app_icon "star", class: "size-4", aria: { hidden: "true" } %>
                  <span>Set as featured</span>
                <% end %>
              <% end %>
              <% menu.with_item(
                   href: hotel_profile_photo_path(hotel, photo.id, return_to: local_assigns[:return_to]),
                   method: :delete,
                   variant: :danger,
                   data: {
                     turbo_confirm: "Remove this hotel photo?",
                     turbo_confirm_tone: "destructive"
                   }) do %>
                <%= app_icon "trash-2", class: "size-4", aria: { hidden: "true" } %>
                <span>Remove photo</span>
              <% end %>
            <% end %>
          <% end %>
        <% end %>
      <% end %>
    <% end %>
  <% else %>
    <%# The state carries the upload action itself, so nobody looking at an empty
        album has to go find the button. Both places that render this partial
        also render the upload sheet it opens. %>
    <%= render PanelsUI::EmptyState.new(
          title: "No photos yet",
          description: "Photos are how guests decide. Add the ones that show the property best — the first becomes the featured photo, and you can change that later.",
          icon: "image") do |state| %>
      <% state.with_action do %>
        <%= render PanelsUI::Button.new(as: :button, variant: :neutral, size: :sm,
              command: "show-modal", commandfor: "hotel-photo-upload-sheet") do %>
          <%= app_icon "upload", class: "size-4", aria: { hidden: "true" } %>
          <span>Upload photos</span>
        <% end %>
      <% end %>
    <% end %>
  <% end %>
</div>
