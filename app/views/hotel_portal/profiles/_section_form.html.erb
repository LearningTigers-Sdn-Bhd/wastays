<%# Each editable block on the property settings page saves on its own, so the
    form plumbing and the Save button are the same four times over and live
    here. `section` names the block for the post-save anchor and doubles as the
    section's element id. %>
<%= form_with model: hotel,
              url: hotel_profile_path,
              method: :patch,
              local: true,
              data: {
                turbo: false,
                controller: "form-dirty",
                action: "input->form-dirty#refresh change->form-dirty#refresh reset->form-dirty#restore"
              },
              class: local_assigns[:class] do |form| %>
  <%= hidden_field_tag :section, section %>

  <section id="<%= section %>" aria-labelledby="<%= section %>-heading">
    <%= yield form %>

    <div class="mt-5 flex justify-end gap-3">
      <%# Cancel only exists while there is something to discard, so it starts
          hidden and the controller reveals it alongside enabling Save. A native
          reset restores the section's fields; the PanelsUI selects and the Tom
          Select-backed combobox all resync themselves off the reset event. %>
      <%= render PanelsUI::Button.new(
            as: :button,
            type: :reset,
            variant: :secondary,
            size: :md,
            hidden: true,
            data: { form_dirty_target: "cancel" }) do %>
        Cancel
      <% end %>

      <%# Enabled in the markup and switched off by the controller on connect,
          so a page whose JS never runs keeps a Save that works. %>
      <%= render PanelsUI::Button.new(
            as: :button,
            type: :submit,
            size: :md,
            data: { form_dirty_target: "submit" }) do %>
        Save
      <% end %>
    </div>
  </section>
<% end %>
