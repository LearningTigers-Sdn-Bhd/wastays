<div class="max-w-2xl mx-auto py-10 px-4 sm:px-6 lg:px-8">
  <div class="mb-5">
    <%= link_to hotel_dashboard_path, class: "inline-flex items-center gap-x-1.5 text-sm text-gray-600 hover:text-blue-600" do %>
      <svg class="flex-shrink-0 size-4" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg>
      Back to Onboarding
    <% end %>
  </div>

  <div class="bg-white border border-gray-200 rounded-xl shadow-sm p-4 sm:p-7">
    <div class="mb-8">
      <h2 class="text-2xl font-bold text-gray-800">Hotel Profile</h2>
      <p class="text-sm text-gray-600">Update your hotel's general information.</p>
    </div>

    <%= form_with model: @hotel, url: hotel_profile_path, method: :patch, local: true do |f| %>
      <div class="grid gap-y-4">
        <div>
          <%= f.label :name, "Hotel Name", class: "block text-sm mb-2 font-medium" %>
          <%= f.text_field :name, class: "py-3 px-4 block w-full border border-gray-200 rounded-lg text-sm focus:border-blue-500 focus:ring-blue-500", required: true %>
        </div>

        <div>
          <%= f.label :address, class: "block text-sm mb-2 font-medium" %>
          <%= f.text_area :address, rows: 3, class: "py-3 px-4 block w-full border border-gray-200 rounded-lg text-sm focus:border-blue-500 focus:ring-blue-500" %>
        </div>

        <div class="grid grid-cols-2 gap-4">
          <div>
            <%= f.label :city, class: "block text-sm mb-2 font-medium" %>
            <%= f.text_field :city, class: "py-3 px-4 block w-full border border-gray-200 rounded-lg text-sm focus:border-blue-500 focus:ring-blue-500", required: true %>
          </div>
          <div>
            <%= f.label :country, class: "block text-sm mb-2 font-medium" %>
            <%= f.text_field :country, class: "py-3 px-4 block w-full border border-gray-200 rounded-lg text-sm focus:border-blue-500 focus:ring-blue-500", required: true %>
          </div>
        </div>

        <div>
          <%= f.label :star_rating, "Star Rating", class: "block text-sm mb-2 font-medium" %>
          <%= f.select :star_rating, (1..5).map { |n| ["#{n} Star", n] }, { include_blank: "Select Rating" }, class: "py-3 px-4 block w-full border border-gray-200 rounded-lg text-sm focus:border-blue-500 focus:ring-blue-500" %>
        </div>

        <div class="mt-5">
          <%= f.submit "Save Profile", class: "w-full py-3 px-4 inline-flex justify-center items-center gap-x-2 text-sm font-semibold rounded-lg border border-transparent bg-blue-600 text-white hover:bg-blue-700 disabled:opacity-50 disabled:pointer-events-none" %>
        </div>
      </div>
    <% end %>
  </div>
</div>
