<% content_for :breadcrumbs do %>
  <div class="flex items-center gap-x-2">
    <span class="text-sm font-medium text-slate-600"><%= current_hotel.name %></span>
    <span class="text-sm text-slate-400">/</span>
    <span class="text-sm font-semibold text-slate-900">Hotel Details</span>
  </div>
<% end %>

<div class="max-w-[1600px] mx-auto pb-20 space-y-8">
  <div class="px-4 md:px-0">
    <div class="mt-5 flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
      <div>
        <h1 class="text-2xl font-bold tracking-tight text-slate-950 sm:text-3xl">Hotel Details</h1>
        <p class="mt-1 text-sm font-medium text-slate-600">Manage your profile, media, and setup fee details in one place.</p>
      </div>

      <%= link_to "See Hotel",
                  hotel_path(@hotel),
                  target: "_blank",
                  rel: "noopener",
                  class: "inline-flex h-11 items-center justify-center rounded-xl border border-slate-200 bg-white px-5 text-sm font-semibold text-slate-700 shadow-sm transition hover:border-slate-300 hover:bg-slate-50" %>
    </div>
  </div>

  <div class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">
    <%= form_with model: @hotel, url: hotel_profile_path, method: :patch, local: true, html: { multipart: true } do |f| %>
      <div class="border-b border-slate-200 px-6 py-5 sm:px-8">
        <h2 class="text-lg font-semibold text-slate-950">Profile Information</h2>
        <p class="mt-1 text-sm text-slate-600">Keep your property details accurate for guests and channel distribution.</p>
      </div>

      <div class="space-y-8 px-6 py-6 sm:px-8">
        <section>
          <h3 class="mb-4 text-[11px] font-semibold uppercase tracking-[0.08em] text-slate-500">Basic Info</h3>
          <div class="grid gap-5 md:grid-cols-2">
            <div class="md:col-span-2">
              <%= f.label :name, "Hotel Name", class: "mb-2 block text-sm font-medium text-slate-900" %>
              <%= f.text_field :name, class: "w-full rounded-xl border border-slate-200 px-4 py-3 text-sm text-slate-900 focus:border-slate-400 focus:ring-slate-300", required: true %>
            </div>

            <div class="md:col-span-2">
              <%= f.label :address, class: "mb-2 block text-sm font-medium text-slate-900" %>
              <%= f.text_area :address, rows: 3, class: "w-full rounded-xl border border-slate-200 px-4 py-3 text-sm text-slate-900 focus:border-slate-400 focus:ring-slate-300" %>
            </div>
          </div>
        </section>

        <section>
          <h3 class="mb-4 text-[11px] font-semibold uppercase tracking-[0.08em] text-slate-500">Location</h3>
          <div class="grid gap-5 md:grid-cols-2">
            <div>
              <%= f.label :city, class: "mb-2 block text-sm font-medium text-slate-900" %>
              <%= f.text_field :city, class: "w-full rounded-xl border border-slate-200 px-4 py-3 text-sm text-slate-900 focus:border-slate-400 focus:ring-slate-300", required: true %>
            </div>

            <div>
              <%= f.label :country, class: "mb-2 block text-sm font-medium text-slate-900" %>
              <%= f.text_field :country, class: "w-full rounded-xl border border-slate-200 px-4 py-3 text-sm text-slate-900 focus:border-slate-400 focus:ring-slate-300", required: true %>
            </div>
          </div>
        </section>

        <section data-controller="photo-limit" data-photo-limit-existing-count-value="<%= @hotel.photos.count %>" data-photo-limit-max-count-value="20">
          <h3 class="mb-4 text-[11px] font-semibold uppercase tracking-[0.08em] text-slate-500">Media</h3>
          <div class="rounded-2xl border border-slate-200 bg-slate-50/40 p-4 sm:p-5">
            <%= f.label :photos, "Hotel Photos", class: "mb-2 block text-sm font-medium text-slate-900" %>
            <%= f.file_field :photos,
                             multiple: true,
                             accept: "image/*",
                             class: "w-full rounded-xl border border-slate-200 bg-white px-4 py-3 text-sm text-slate-700 focus:border-slate-400 focus:ring-slate-300",
                             data: { photo_limit_target: "input", action: "change->photo-limit#update" } %>
            <div class="mt-3 flex items-center justify-between gap-3">
              <p class="text-xs text-slate-500">Upload high-quality photos. Max 20 files.</p>
              <p class="text-xs font-semibold text-slate-700" data-photo-limit-target="counter"><%= "#{@hotel.photos.count}/20 photos" %></p>
            </div>
            <p class="mt-2 hidden rounded-lg border border-amber-200 bg-amber-50 px-3 py-2 text-xs text-amber-700" data-photo-limit-target="warning"></p>
          </div>
        </section>

        <section>
          <h3 class="mb-4 text-[11px] font-semibold uppercase tracking-[0.08em] text-slate-500">Billing Reference</h3>
          <div class="rounded-2xl border border-slate-200 bg-white p-4 sm:p-5">
            <p class="text-xs font-medium text-slate-600">Effective setup fee for this property:</p>
            <p class="mt-1 text-2xl font-bold tracking-tight text-slate-950">
              <%= number_to_currency(@setup_fee_amount, unit: "#{@setup_fee_currency} ", precision: 2) %>
            </p>
          </div>
        </section>
      </div>

      <div class="flex items-center justify-end border-t border-slate-200 bg-slate-50/60 px-6 py-4 sm:px-8">
        <%= f.submit "Save Profile",
                     class: "inline-flex items-center justify-center rounded-xl bg-slate-900 px-6 py-2.5 text-sm font-semibold text-white transition hover:bg-slate-800" %>
      </div>
    <% end %>
  </div>

  <% if @hotel.photos.attached? %>
    <div class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">
      <%= form_with url: hotel_profile_photos_path(@hotel), method: :delete, local: true do %>
        <div class="flex flex-col gap-4 border-b border-slate-200 px-6 py-5 sm:flex-row sm:items-center sm:justify-between sm:px-8">
          <div>
            <h2 class="text-lg font-semibold text-slate-950">Current Photos</h2>
            <p class="mt-1 text-sm text-slate-600">Select one or more photos to remove in bulk.</p>
          </div>
          <%= submit_tag "Remove Selected Photos",
                         class: "inline-flex items-center justify-center rounded-xl border border-slate-200 bg-white px-4 py-2 text-sm font-semibold text-slate-700 transition hover:bg-slate-100",
                         data: { turbo_confirm: "Remove the selected photos?" } %>
        </div>

        <div class="p-6 sm:p-8">
          <div class="grid grid-cols-2 gap-3 sm:grid-cols-3 lg:grid-cols-4">
            <% @hotel.photos.attachments.each do |photo| %>
              <% featured_photo = @hotel.featured_photo_attachment %>
              <label class="group relative overflow-hidden rounded-xl border border-slate-200 bg-slate-50 cursor-pointer">
                <%= image_tag photo, class: "h-32 w-full object-cover" %>
                <div class="absolute inset-0 bg-black/0 transition group-hover:bg-black/10"></div>
                <div class="absolute left-2 top-2">
                  <%= check_box_tag "photo_ids[]", photo.id, false, class: "h-4 w-4 rounded border-slate-300 text-slate-900 focus:ring-slate-400" %>
                </div>
                <div class="absolute inset-x-0 bottom-0 flex items-end justify-between px-2 pb-2">
                  <% if featured_photo&.id == photo.id %>
                    <span class="inline-flex items-center rounded-full bg-white/90 px-2 py-1 text-[10px] font-semibold text-slate-900 shadow-sm">Featured</span>
                  <% else %>
                    <%= link_to "Set Featured",
                                hotel_profile_photo_feature_path(@hotel, photo.id),
                                data: { turbo_method: :patch },
                                class: "inline-flex items-center rounded-full bg-white/90 px-2 py-1 text-[10px] font-semibold text-slate-700 shadow-sm opacity-0 transition-opacity hover:text-slate-900 group-hover:opacity-100" %>
                  <% end %>
                </div>
              </label>
            <% end %>
          </div>
        </div>
      <% end %>
    </div>
  <% end %>
</div>
