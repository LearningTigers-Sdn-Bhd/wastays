<%
  profile_presenter = @presenter
  amenity_choices = Hotel::CATEGORIZED_HOTEL_AMENITIES.to_h do |category|
    [category[:category], category[:items].map { |amenity| [amenity[:name], amenity[:id]] }]
  end
%>

<div class="w-full space-y-6">
  <%= render "hotel_portal/settings/property_page_header" %>
  <%= render "hotel_portal/settings/group_tabs" %>

  <%# Two independent columns rather than a four-cell grid: the sections have very
      different heights, so row-aligned cells left a tall gap under the short ones.
      Hotel Information holds the left column on its own; everything else stacks
      down the right. %>
  <div id="hotel-profile-section" class="grid grid-cols-1 items-start gap-x-8 gap-y-10 lg:grid-cols-2">
    <div class="space-y-10">
      <%= render layout: "section_form", locals: {
            hotel: @hotel,
            section: "hotel-information",
            title: "Hotel Information",
            description: "Manage the property’s public identity and amenities.",
            action: render(PanelsUI::Button.new(
              label: "See Hotel",
              href: hotel_path(@hotel),
              variant: :secondary,
              size: :sm,
              target: "_blank",
              rel: "noopener"))
          } do |form| %>
        <div class="space-y-4">
          <%# The icon dropzone is a fixed-size square, so the naming fields sit
              beside it instead of leaving the rest of its row empty. %>
          <div class="flex flex-col gap-4 sm:flex-row sm:items-start">
            <%# w-48 matches the dropzone's own 12rem width: without an explicit
                width the hint line sets the column's intrinsic size and crowds
                out the fields beside it. %>
            <%= render "hotel_icon_field", form: form, hotel: @hotel, class: "sm:w-48 sm:shrink-0" %>

            <div class="flex-1 space-y-4">
              <%= render PanelsUI::FormField.new(
                    form: form,
                    attribute: :name,
                    label: "Hotel Name",
                    required: true) do |field| %>
                <% field.with_input %>
              <% end %>

              <div class="grid gap-4 sm:grid-cols-2">
                <%= render PanelsUI::FormField.new(
                      form: form,
                      attribute: :unique_id,
                      label: "Hotel Code",
                      hint: "Quote this code when contacting WAStays support. It never changes.",
                      readonly: true) do |field| %>
                  <% field.with_input(value: @hotel.unique_id) %>
                <% end %>

                <%= render PanelsUI::FormField.new(
                      form: form,
                      attribute: :star_rating,
                      label: "Star Rating") do |field| %>
                  <% field.with_select_menu(
                       profile_presenter.star_rating_options,
                       prompt: "Select rating",
                       selected: @hotel.star_rating) %>
                <% end %>
              </div>
            </div>
          </div>

          <%= render PanelsUI::FormField.new(
                form: form,
                attribute: :description,
                label: "Description",
                hint: "Summarize what makes this property distinctive for guests.") do |field| %>
            <% field.with_text_area(
                 rows: 4,
                 placeholder: "Describe the property’s atmosphere, highlights, and guest experience.") %>
          <% end %>

          <%= render PanelsUI::FormField.new(
                form: form,
                attribute: :amenities,
                label: "Property Amenities",
                hint: "Search and select the amenities available at this property.") do |field| %>
            <% field.with_multi_select(
                 amenity_choices,
                 selected: @hotel.amenities,
                 prompt: "Search amenities",
                 empty_text: "No amenities found",
                 all_selected_text: "All amenities selected") %>
          <% end %>
        </div>
      <% end %>

      <%# Read-only: what WAStays charges this property, not something the
          property sets. It has no Save of its own because there is nothing here
          to change. %>
      <section id="billing-reference" class="lg:w-4/5" aria-labelledby="billing-reference-heading">
        <%= render "section_header",
                   section: "billing-reference",
                   title: "Billing Reference",
                   description: "What WAStays bills this property. Contact support if this looks wrong." %>

        <div class="mt-5">
          <%= render PanelsUI::MetricCard.new(
                label: "Billing Reference",
                value: number_to_currency(
                  profile_presenter.setup_fee_amount,
                  unit: "#{profile_presenter.setup_fee_currency} ",
                  precision: 2),
                detail: "Effective setup fee for this property",
                icon: "receipt",
                density: :loose,
                data: { testid: "billing-reference" }) %>
        </div>
      </section>
    </div>

    <div class="space-y-10">
      <%= render layout: "section_form", locals: {
            hotel: @hotel,
            section: "hotel-location",
            title: "Hotel Location",
            description: "Keep the address and map destination accurate for guests and channel distribution."
          } do |form| %>
        <div class="grid gap-4 sm:grid-cols-2">
          <%= render PanelsUI::FormField.new(
                form: form,
                attribute: :address,
                label: "Address",
                class: "sm:col-span-2") do |field| %>
            <% field.with_text_area(rows: 4, placeholder: "e.g., 12 Jalan Sultan Ismail\n50250 Kuala Lumpur") %>
          <% end %>

          <%= render PanelsUI::FormField.new(
                form: form,
                attribute: :city,
                label: "City",
                required: true) do |field| %>
            <% field.with_input(placeholder: "e.g., Kuala Lumpur") %>
          <% end %>

          <%= render PanelsUI::FormField.new(
                form: form,
                attribute: :country,
                label: "Country",
                required: true) do |field| %>
            <% field.with_combobox(
                 country_options.map { |country| [ country, country ] },
                 prompt: "Search and select a country",
                 selected: @hotel.country,
                 max_options: 50,
                 empty_text: "No countries found") %>
          <% end %>

          <%= render PanelsUI::FormField.new(
                form: form,
                attribute: :google_map_link,
                label: "Google Maps URL",
                hint: "Paste the property’s public Google Maps place link.",
                class: "sm:col-span-2") do |field| %>
            <% field.with_input(type: :url, placeholder: "https://www.google.com/maps/place/…") %>
          <% end %>
        </div>
      <% end %>

      <%# Collected during onboarding but never editable afterwards until now, so
          the same four numbers are kept together here. %>
      <%= render layout: "section_form", locals: {
            hotel: @hotel,
            section: "property-contact",
            title: "Property Contact",
            description: "How guests and WAStays reach the property."
          } do |form| %>
        <div class="grid gap-4 sm:grid-cols-2">
          <%= render PanelsUI::FormField.new(
                form: form,
                attribute: :contact_email,
                label: "Contact Email") do |field| %>
            <% field.with_input(type: :email, placeholder: "e.g., frontdesk@yourhotel.com") %>
          <% end %>

          <%= render PanelsUI::FormField.new(
                form: form,
                attribute: :contact_phone,
                label: "Contact Phone") do |field| %>
            <% field.with_input(type: :tel, placeholder: "e.g., 012-827 3581") %>
          <% end %>

          <%= render PanelsUI::FormField.new(
                form: form,
                attribute: :fixed_line_number,
                label: "Fixed Line Number",
                hint: "The landline answered at the front desk.") do |field| %>
            <% field.with_input(type: :tel, placeholder: "e.g., 03-2144 1234") %>
          <% end %>

          <%= render PanelsUI::FormField.new(
                form: form,
                attribute: :whatsapp_number,
                label: "WhatsApp Number",
                hint: "Include the international dialling code.") do |field| %>
            <% field.with_input(type: :tel, placeholder: "e.g., +60 12-827 3581") %>
          <% end %>
        </div>
      <% end %>

      <%# The numbers that identify the business itself, kept apart from the taxes
          page: those settings say what the property charges, these say who it is.
          The registration number for an individual tax lives with that tax. %>
      <%= render layout: "section_form", locals: {
            hotel: @hotel,
            section: "business-registration",
            title: "Business Registration",
            description: "The company numbers that appear on the property’s invoices and receipts."
          } do |form| %>
        <div class="grid gap-4 sm:grid-cols-2">
          <%= render PanelsUI::FormField.new(
                form: form,
                attribute: :tin,
                label: "TIN",
                hint: "Tax Identification Number issued by LHDN.") do |field| %>
            <% field.with_input(autocomplete: "off", spellcheck: false, placeholder: "e.g., C1234567890", class: "font-mono uppercase") %>
          <% end %>

          <%= render PanelsUI::FormField.new(
                form: form,
                attribute: :ssm_number,
                label: "SSM No.",
                hint: "Company registration number.") do |field| %>
            <% field.with_input(autocomplete: "off", spellcheck: false, placeholder: "e.g., 202301012345 (1234567-A)", class: "font-mono uppercase") %>
          <% end %>

          <%# The council that licenses the property to trade. Free text: every
              local authority abbreviates itself differently and properties quote
              the acronym their licence carries. %>
          <%= render PanelsUI::FormField.new(
                form: form,
                attribute: :local_government_name,
                label: "Local government name",
                hint: "The local authority that issued the premises licence.") do |field| %>
            <% field.with_input(autocomplete: "off", placeholder: "e.g., DBKK, MDP, MPSJ, DBKL") %>
          <% end %>

          <%= render PanelsUI::FormField.new(
                form: form,
                attribute: :local_government_license_number,
                label: "License number",
                hint: "The licence number issued by that local authority.") do |field| %>
            <% field.with_input(autocomplete: "off", spellcheck: false, placeholder: "e.g., PL/2026/001234", class: "font-mono uppercase") %>
          <% end %>
        </div>
      <% end %>
    </div>
  </div>
</div>
