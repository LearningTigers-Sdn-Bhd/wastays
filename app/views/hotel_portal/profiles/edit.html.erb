<div class="max-w-[85rem] px-4 py-10 sm:px-6 lg:px-8 lg:py-14 mx-auto">
  <div class="mb-6 flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
    <div>
      <h1 class="text-2xl font-bold text-neutral-text-primary">Hotel Details</h1>
      <p class="mt-1 text-sm text-neutral-text-secondary">View and update your hotel information.</p>
    </div>

    <button type="button" class="inline-flex h-10 items-center justify-center rounded-xl border border-neutral-border bg-white px-5 text-sm font-semibold text-neutral-text-secondary shadow-sm hover:bg-neutral-bg focus:outline-none focus:bg-neutral-bg">
      See Hotel
    </button>
  </div>

  <div class="space-y-6">
    <div class="card overflow-hidden">

      <div class="p-5 sm:p-6">
        <%= form_with model: @hotel, url: hotel_profile_path, method: :patch, local: true, html: { multipart: true }, class: "space-y-6" do |f| %>
          <div class="grid gap-4 md:grid-cols-2">
            <div class="md:col-span-2">
              <%= f.label :name, "Hotel Name", class: "block text-sm font-medium mb-2 text-neutral-text-primary" %>
              <%= f.text_field :name, class: "w-full rounded-lg border border-neutral-border px-4 py-3 text-sm focus:border-neutral-text-secondary focus:ring-neutral-border", required: true %>
            </div>

            <div class="md:col-span-2">
              <%= f.label :address, class: "block text-sm font-medium mb-2 text-neutral-text-primary" %>
              <%= f.text_area :address, rows: 3, class: "w-full rounded-lg border border-neutral-border px-4 py-3 text-sm focus:border-neutral-text-secondary focus:ring-neutral-border" %>
            </div>

            <div>
              <%= f.label :city, class: "block text-sm font-medium mb-2 text-neutral-text-primary" %>
              <%= f.text_field :city, class: "w-full rounded-lg border border-neutral-border px-4 py-3 text-sm focus:border-neutral-text-secondary focus:ring-neutral-border", required: true %>
            </div>

            <div>
              <%= f.label :country, class: "block text-sm font-medium mb-2 text-neutral-text-primary" %>
              <%= f.text_field :country, class: "w-full rounded-lg border border-neutral-border px-4 py-3 text-sm focus:border-neutral-text-secondary focus:ring-neutral-border", required: true %>
            </div>

            <div class="md:col-span-2" data-controller="photo-limit" data-photo-limit-existing-count-value="<%= @hotel.photos.count %>" data-photo-limit-max-count-value="20">
              <%= f.label :photos, "Hotel Photos", class: "block text-sm font-medium mb-2 text-neutral-text-primary" %>
              <%= f.file_field :photos, multiple: true, accept: "image/*", class: "w-full rounded-lg border border-neutral-border px-4 py-3 text-sm focus:border-neutral-text-secondary focus:ring-neutral-border bg-white", data: { photo_limit_target: "input", action: "change->photo-limit#update" } %>
              <div class="mt-2 flex items-center gap-3">
                <p class="ml-auto text-right text-xs font-semibold text-neutral-text-secondary" data-photo-limit-target="counter"><%= "#{@hotel.photos.count}/20 photos" %></p>
              </div>
              <p class="mt-2 hidden rounded-lg border border-amber-200 bg-amber-50 px-3 py-2 text-xs text-amber-700" data-photo-limit-target="warning"></p>
            </div>
          </div>

          <div class="flex justify-end pt-4 border-t border-neutral-border">
            <%= f.submit "Save Profile", class: "inline-flex items-center gap-x-2 rounded-lg bg-neutral-text-primary px-4 py-2 text-sm font-semibold text-white hover:bg-neutral-text-secondary" %>
          </div>
        <% end %>
      </div>
    </div>

    <% if @hotel.photos.attached? %>
      <div class="card overflow-hidden">
        <%= form_with url: hotel_profile_photos_path(@hotel), method: :delete, local: true do %>
          <div class="p-5 sm:p-6 border-b border-neutral-border flex items-center justify-between gap-4">
            <div>
              <h2 class="text-lg font-semibold text-neutral-text-primary">Current Photos</h2>
              <p class="mt-1 text-sm text-neutral-text-secondary">Select one or more photos to remove them in one go.</p>
            </div>
            <%= submit_tag "Remove Selected Photos", class: "inline-flex items-center gap-x-2 rounded-lg border border-neutral-border bg-white px-4 py-2 text-sm font-semibold text-neutral-text-primary hover:bg-neutral-bg", data: { turbo_confirm: "Remove the selected photos?" } %>
          </div>

              <div class="p-5 sm:p-6">
                <div class="grid gap-3 grid-cols-2 sm:grid-cols-3 lg:grid-cols-4">
                  <% @hotel.photos.attachments.each do |photo| %>
                    <% featured_photo = @hotel.featured_photo_attachment %>
                    <label class="group relative overflow-hidden rounded-lg border border-neutral-border bg-neutral-bg cursor-pointer">
                      <%= image_tag photo, class: "h-28 w-full object-cover" %>
                      <div class="absolute inset-0 bg-black/0 group-hover:bg-black/10 transition"></div>
                      <div class="absolute left-2 top-2">
                        <%= check_box_tag "photo_ids[]", photo.id, false, class: "h-4 w-4 rounded border-neutral-border text-neutral-text-primary focus:ring-neutral-text-secondary" %>
                      </div>
                      <div class="absolute inset-x-0 bottom-0 flex justify-between items-end px-2 pb-2">
                        <% if featured_photo&.id == photo.id %>
                          <span class="inline-flex items-center rounded-full bg-white/90 px-2 py-1 text-[10px] font-semibold text-neutral-text-primary shadow-sm">Featured</span>
                        <% else %>
                          <%= link_to hotel_profile_photo_feature_path(@hotel, photo.id), data: { turbo_method: :patch }, class: "inline-flex items-center rounded-full bg-white/90 px-2 py-1 text-[10px] font-semibold text-neutral-text-secondary shadow-sm hover:text-neutral-text-primary opacity-0 group-hover:opacity-100 transition-opacity" do %>
                            Set Featured
                          <% end %>
                        <% end %>
                      </div>
                    </label>
                  <% end %>
                </div>
              </div>
        <% end %>
      </div>
    <% end %>
  </div>
</div>
