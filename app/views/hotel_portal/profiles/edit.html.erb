<% content_for :breadcrumbs do %>
  <div class="flex items-center gap-x-2">
    <span class="text-sm font-medium text-slate-600"><%= current_hotel.name %></span>
    <span class="text-sm text-slate-400">/</span>
    <span class="text-sm font-semibold text-slate-900">Hotel Details</span>
  </div>
<% end %>

<div class="max-w-[1600px] mx-auto pb-20 space-y-8">
  <% if current_hotel.status == 'inventory_incomplete' %>
    <div class="px-4 md:px-0 mb-6">
      <%= link_to hotel_dashboard_path(current_hotel), class: "inline-flex items-center gap-x-1.5 py-1.5 px-3 text-xs font-bold text-brand-primary border border-brand-primary/20 bg-brand-primary/5 rounded-lg hover:bg-brand-primary/10 transition-colors" do %>
        <svg class="size-3.5" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg>
        Back to Onboarding
      <% end %>
    </div>
  <% end %>

  <div class="px-4 md:px-0">
    <div class="mt-5 flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
      <div>
        <h1 class="text-2xl font-bold tracking-tight text-slate-950 sm:text-3xl">Hotel Details</h1>
        <p class="mt-1 text-sm font-medium text-slate-600">Manage your profile, media, and setup fee details in one place.</p>
      </div>

      <%= link_to "See Hotel",
                  hotel_path(@hotel),
                  target: "_blank",
                  rel: "noopener",
                  class: "inline-flex h-11 items-center justify-center rounded-xl border border-slate-200 bg-white px-5 text-sm font-semibold text-slate-700 shadow-sm transition hover:border-slate-300 hover:bg-slate-50" %>
    </div>
  </div>

  <div id="hotel-profile-section" class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">
    <%= form_with model: @hotel, url: hotel_profile_path, method: :patch, local: true, html: { multipart: true } do |f| %>
      <div class="border-b border-slate-200 px-6 py-5 sm:px-8">
        <h2 class="text-lg font-semibold text-slate-950">Profile Information</h2>
        <p class="mt-1 text-sm text-slate-600">Keep your property details accurate for guests and channel distribution.</p>
      </div>

      <div class="space-y-8 px-6 py-6 sm:px-8">
        <section>
          <h3 class="mb-4 text-[11px] font-semibold uppercase tracking-[0.08em] text-slate-500">Basic Info</h3>
          <div class="grid gap-5 md:grid-cols-2">
            <div>
              <%= f.label :name, "Hotel Name", class: "mb-2 block text-sm font-medium text-slate-900" %>
              <%= f.text_field :name, class: "w-full rounded-xl border border-slate-200 px-4 py-3 text-sm text-slate-900 focus:border-slate-400 focus:ring-slate-300", required: true %>
            </div>

            <div>
              <label for="star_rating" class="mb-2 flex items-center gap-2 text-sm font-medium text-slate-900">
                <svg class="size-4 text-amber-500" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="currentColor" stroke="none"><path d="M11.48 3.499a.562.562 0 0 1 1.04 0l2.125 5.111a.563.563 0 0 0 .475.345l5.518.442c.499.04.701.663.321 1.012l-4.204 3.602a.563.563 0 0 0-.182.557l1.285 5.386a.562.562 0 0 1-.84.61L12.5 17.77a.563.563 0 0 0-.5 0l-4.517 2.794a.562.562 0 0 1-.84-.61l1.285-5.386a.562.562 0 0 0-.182-.557L3.542 10.41a.562.562 0 0 1 .321-1.012l5.518-.442a.563.563 0 0 0 .475-.345z"/></svg>
                Star Rating
              </label>
              <%= f.select :star_rating, (1..5).map { |rating| ["#{rating} #{'★' * rating}", rating] }, { include_blank: "Select Rating" }, class: "w-full rounded-xl border border-slate-200 bg-white px-4 py-3 text-sm font-medium text-slate-900 focus:border-slate-400 focus:outline-none focus:ring-slate-300 cursor-pointer" %>
            </div>

            <div class="md:col-span-2">
              <%= f.label :address, class: "mb-2 block text-sm font-medium text-slate-900" %>
              <%= f.text_area :address, rows: 3, class: "w-full rounded-xl border border-slate-200 px-4 py-3 text-sm text-slate-900 focus:border-slate-400 focus:ring-slate-300" %>
            </div>
          </div>
        </section>

        <section>
          <h3 class="mb-4 text-[11px] font-semibold uppercase tracking-[0.08em] text-slate-500">Location</h3>
          <div class="grid gap-5 md:grid-cols-2">
            <div>
              <%= f.label :city, class: "mb-2 block text-sm font-medium text-slate-900" %>
              <%= f.text_field :city, class: "w-full rounded-xl border border-slate-200 px-4 py-3 text-sm text-slate-900 focus:border-slate-400 focus:ring-slate-300", required: true %>
            </div>

            <div>
              <%= f.label :country, class: "mb-2 block text-sm font-medium text-slate-900" %>
              <%= f.text_field :country, class: "w-full rounded-xl border border-slate-200 px-4 py-3 text-sm text-slate-900 focus:border-slate-400 focus:ring-slate-300", required: true %>
            </div>
          </div>
        </section>

        <section data-controller="multi-select-dropdown"
                 data-multi-select-dropdown-selected-value="<%= (@hotel.amenities || []).to_json %>"
                 data-multi-select-dropdown-all-value="<%= Hotel::HOTEL_AMENITIES.to_json %>"
                 data-action="click@window->multi-select-dropdown#hideDropdown">
          <div class="flex items-center justify-between mb-4">
            <h3 class="text-[11px] font-semibold uppercase tracking-[0.08em] text-slate-500">Property Amenities</h3>
          </div>

          <div class="relative">
            <input type="hidden" name="hotel[amenities][]" value="">
            <div class="min-h-[52px] w-full rounded-xl border border-slate-200 bg-white p-2 flex flex-wrap items-center gap-2 focus-within:border-slate-400 focus-within:ring-2 focus-within:ring-slate-300 transition-all cursor-text"
                 data-action="click->multi-select-dropdown#focusInput">
              <div class="flex flex-wrap gap-2" data-multi-select-dropdown-target="pillsContainer">
                <!-- Pills will be rendered here by Stimulus -->
              </div>
              
              <input type="text" 
                     class="flex-grow min-w-[150px] border-none bg-transparent focus:ring-0 focus:outline-none text-sm text-slate-900 placeholder:text-slate-400" 
                     data-multi-select-dropdown-target="input"
                     data-action="input->multi-select-dropdown#filterOptions focus->multi-select-dropdown#openDropdown click->multi-select-dropdown#stopProp keydown->multi-select-dropdown#navigate"
                   >

              <div class="ml-auto pr-2">
                <svg class="w-4 h-4 text-slate-400 transition-transform duration-200" data-multi-select-dropdown-target="chevron" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6"/></svg>
              </div>
            </div>

            <!-- Dropdown Options with Categories -->
            <div class="absolute z-50 mt-2 w-full max-h-80 overflow-y-auto rounded-xl border border-slate-200 bg-white shadow-xl hidden custom-scrollbar" 
                 data-multi-select-dropdown-target="dropdown">
              <% Hotel::CATEGORIZED_HOTEL_AMENITIES.each do |cat| %>
                <div data-category-container data-category-name="<%= cat[:category] %>" class="border-b border-slate-100 last:border-0">
                  <button type="button" 
                          class="w-full flex items-center justify-between px-4 py-3 text-xs font-black uppercase tracking-widest text-slate-500 bg-slate-50/50 hover:bg-slate-50 transition-colors"
                          data-action="click->multi-select-dropdown#toggleCategory">
                    <span><%= cat[:category] %></span>
                    <svg class="size-3.5 text-slate-400 transition-transform duration-200" data-category-chevron xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6"/></svg>
                  </button>
                  
                  <div class="hidden bg-white" data-category-content>
                   <% cat[:items].each do |amenity| %>
                     <label class="w-full flex items-center px-6 py-3 text-sm text-slate-700 hover:bg-slate-50 transition-colors border-b border-slate-50 last:border-0 cursor-pointer"

                             data-multi-select-dropdown-target="option"
                             data-name="<%= amenity[:name] %>"
                             data-id="<%= amenity[:id] %>">
                        <input type="checkbox" 
                               class="rounded border-slate-300 text-slate-900 focus:ring-slate-400 mr-3"
                               data-id="<%= amenity[:id] %>"
                               data-action="change->multi-select-dropdown#toggle"
                               data-multi-select-dropdown-target="checkbox">
                        <span><%= amenity[:name] %></span>
                      </label>
                    <% end %>
                  </div>
                </div>
              <% end %>
            </div>
          </div>

          <!-- Template for Pills -->
          <template data-multi-select-dropdown-target="template">
            <div class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-slate-900 text-white text-xs font-semibold">
              <span data-name></span>
              <button type="button" 
                      class="hover:text-slate-300 transition-colors"
                      data-remove-id
                      data-action="click->multi-select-dropdown#remove">
                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg>
              </button>
              <input type="hidden" name="hotel[amenities][]" value="">
            </div>
          </template>
        </section>

        <section>
          <h3 class="mb-4 text-[11px] font-semibold uppercase tracking-[0.08em] text-slate-500">Media</h3>
          <div class="rounded-2xl border border-slate-200 bg-slate-50/40 p-4 sm:p-5">
            <p class="text-sm font-medium text-slate-900">Hotel Photos</p>
            <p class="mt-1 text-xs text-slate-500">Use the Photos section below to queue and confirm uploads in bulk (max 20).</p>
          </div>
        </section>

        <section>
          <h3 class="mb-4 text-[11px] font-semibold uppercase tracking-[0.08em] text-slate-500">Billing Reference</h3>
          <div class="rounded-2xl border border-slate-200 bg-white p-4 sm:p-5">
            <p class="text-xs font-medium text-slate-600">Effective setup fee for this property:</p>
            <p class="mt-1 text-2xl font-bold tracking-tight text-slate-950">
              <%= number_to_currency(@presenter.setup_fee_amount, unit: "#{@presenter.setup_fee_currency} ", precision: 2) %>
            </p>
          </div>
        </section>
      </div>

      <div class="flex items-center justify-end border-t border-slate-200 bg-slate-50/60 px-6 py-4 sm:px-8">
        <%= f.submit "Save Profile",
                     class: "inline-flex items-center justify-center rounded-xl bg-slate-900 px-6 py-2.5 text-sm font-semibold text-white transition hover:bg-slate-800" %>
      </div>
    <% end %>
  </div>

  <div class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm"
       data-controller="hotel-photo-queue"
       data-hotel-photo-queue-upload-url-value="<%= hotel_profile_photo_queue_path(@hotel) %>"
       data-hotel-photo-queue-clear-url-value="<%= hotel_clear_profile_photo_queue_path(@hotel) %>"
       data-hotel-photo-queue-commit-url-value="<%= hotel_commit_profile_photo_queue_path(@hotel) %>"
       data-hotel-photo-queue-remove-url-template-value="<%= hotel_profile_photo_queue_item_path(@hotel, "__SIGNED_ID__") %>"
       data-hotel-photo-queue-existing-count-value="<%= @hotel.photos.count %>"
       data-hotel-photo-queue-max-count-value="<%= Hotel::MAX_PHOTOS %>">
    <div class="border-b border-slate-200 px-6 py-5 sm:px-8">
      <h2 class="text-lg font-semibold text-slate-950">Photos</h2>
      <p class="mt-1 text-sm text-slate-600">Queue photos in bulk, then confirm to publish them.</p>
    </div>

    <div class="space-y-6 p-6 sm:p-8">
      <section class="rounded-2xl border border-slate-200 bg-slate-50/40 p-4 sm:p-5">
        <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
          <div>
            <p class="text-sm font-semibold text-slate-900">Upload Queue</p>
            <p class="mt-1 text-xs text-slate-500">Select photos multiple times. Files stay in queue until you confirm upload.</p>
          </div>
          <p class="text-xs font-semibold text-slate-700" data-hotel-photo-queue-target="counterText"></p>
        </div>

        <label class="mt-4 block">
          <span class="sr-only">Choose hotel photos</span>
          <input type="file"
                 multiple
                 accept="image/*"
                 class="w-full rounded-xl border border-slate-200 bg-white px-4 py-3 text-sm text-slate-700 focus:border-slate-400 focus:ring-slate-300"
                 data-hotel-photo-queue-target="input"
                 data-action="change->hotel-photo-queue#queueSelectedFiles">
        </label>

        <p class="mt-3 hidden rounded-lg border border-amber-200 bg-amber-50 px-3 py-2 text-xs text-amber-700"
           data-hotel-photo-queue-target="warning"></p>
        <p class="mt-2 hidden rounded-lg border border-rose-200 bg-rose-50 px-3 py-2 text-xs text-rose-700"
           data-hotel-photo-queue-target="error"></p>

        <div class="mt-4 space-y-2" data-hotel-photo-queue-target="queueList">
          <% @presenter.queued_photo_items.each do |item| %>
            <div class="flex items-center justify-between gap-3 rounded-xl border border-slate-200 bg-white p-3"
                 data-signed-id="<%= item[:signed_id] %>">
              <div class="flex min-w-0 items-center gap-3">
                <img src="<%= item[:preview_url] %>" alt="<%= item[:filename] %>" class="h-12 w-12 rounded-lg border border-slate-200 object-cover">
                <div class="min-w-0">
                  <p class="truncate text-sm font-medium text-slate-900"><%= item[:filename] %></p>
                  <p class="text-xs text-slate-500"><%= item[:byte_size] %></p>
                </div>
              </div>
              <button type="button"
                      class="rounded-lg border border-slate-200 px-3 py-1.5 text-xs font-semibold text-slate-700 transition hover:bg-slate-100"
                      data-action="hotel-photo-queue#removeQueuedPhoto">
                Remove
              </button>
            </div>
          <% end %>
        </div>

        <p class="<%= @presenter.queued_photo_items.any? ? 'hidden ' : '' %>mt-4 text-xs text-slate-500"
           data-hotel-photo-queue-target="emptyState">
          No photos queued yet.
        </p>


        <div class="mt-4 flex flex-wrap items-center gap-2">
          <button type="button"
                  class="inline-flex items-center justify-center rounded-xl bg-slate-900 px-4 py-2 text-sm font-semibold text-white transition hover:bg-slate-800 disabled:cursor-not-allowed disabled:opacity-50"
                  data-hotel-photo-queue-target="confirmButton"
                  data-action="hotel-photo-queue#commitQueue">
            Confirm Upload
          </button>
          <button type="button"
                  class="inline-flex items-center justify-center rounded-xl border border-slate-200 bg-white px-4 py-2 text-sm font-semibold text-slate-700 transition hover:bg-slate-100 disabled:cursor-not-allowed disabled:opacity-50"
                  data-hotel-photo-queue-target="discardButton"
                  data-action="hotel-photo-queue#discardQueue">
            Discard All
          </button>
        </div>
      </section>

      <section>
        <%= form_with url: hotel_profile_photos_path(@hotel), method: :delete, local: true do %>
          <div class="mb-4 flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
            <div>
              <h3 class="text-lg font-semibold text-slate-950">Current Photos</h3>
              <p class="mt-1 text-sm text-slate-600">Select one or more photos to remove in bulk.</p>
            </div>
            <%= submit_tag "Remove Selected Photos",
                           class: "inline-flex items-center justify-center rounded-xl border border-slate-200 bg-white px-4 py-2 text-sm font-semibold text-slate-700 transition hover:bg-slate-100",
                           data: { turbo_confirm: "Remove the selected photos?" } %>
          </div>

          <% if @hotel.photos.attached? %>
            <div class="grid grid-cols-2 gap-3 sm:grid-cols-3 lg:grid-cols-4">
              <% @hotel.photos.attachments.each do |photo| %>
                <% featured_photo = @hotel.featured_photo_attachment %>
                <label class="group relative overflow-hidden rounded-xl border border-slate-200 bg-slate-50 cursor-pointer">
                  <%= image_tag photo, class: "h-32 w-full object-cover" %>
                  <div class="absolute inset-0 bg-black/0 transition group-hover:bg-black/10"></div>
                  <div class="absolute left-2 top-2">
                    <%= check_box_tag "photo_ids[]", photo.id, false, class: "h-4 w-4 rounded border-slate-300 text-slate-900 focus:ring-slate-400" %>
                  </div>
                  <div class="absolute inset-x-0 bottom-0 flex items-end justify-between px-2 pb-2">
                    <% if featured_photo&.id == photo.id %>
                      <span class="inline-flex items-center rounded-full bg-white/90 px-2 py-1 text-[10px] font-semibold text-slate-900 shadow-sm">Featured</span>
                    <% else %>
                      <%= link_to "Set Featured",
                                  hotel_profile_photo_feature_path(@hotel, photo.id),
                                  data: { turbo_method: :patch },
                                  class: "inline-flex items-center rounded-full bg-white/90 px-2 py-1 text-[10px] font-semibold text-slate-700 shadow-sm opacity-0 transition-opacity hover:text-slate-900 group-hover:opacity-100" %>
                    <% end %>
                  </div>
                </label>
              <% end %>
            </div>
          <% else %>
            <p class="rounded-xl border border-dashed border-slate-200 bg-slate-50 px-4 py-6 text-sm text-slate-600">
              No current photos yet. Queue photos above and click Confirm Upload.
            </p>
          <% end %>
        <% end %>
      </section>
    </div>
  </div>
</div>
