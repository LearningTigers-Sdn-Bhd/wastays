<%= form_with model: @role, url: @role.persisted? ? hotel_role_path(current_hotel, @role) : hotel_roles_path(current_hotel), method: @role.persisted? ? :patch : :post, local: true, class: "space-y-6" do |f| %>
  <% if @role.errors.any? %>
    <div class="rounded-xl border border-red-200 bg-red-50 p-4">
      <h2 class="text-sm font-bold text-red-900">Role could not be saved</h2>
      <ul class="mt-2 list-disc space-y-1 pl-5 text-sm text-red-700">
        <% @role.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= f.label :name, "Role Name", class: "mb-2 block text-sm font-medium text-slate-900" %>
    <%= f.text_field :name, required: true, class: "w-full rounded-xl border border-slate-200 bg-white px-4 py-2.5 text-sm transition focus:border-slate-900 focus:ring-0", placeholder: "Night Manager" %>
    <p class="mt-2 text-xs text-slate-500">The role slug is generated from the name when the role is created. You can manage this role's permissions in the matrix after saving.</p>
  </div>

  <div class="flex items-center justify-end gap-3 border-t border-slate-100 pt-4">
    <%= link_to "Cancel", hotel_roles_path(current_hotel), class: "inline-flex items-center rounded-xl border border-slate-200 bg-white px-4 py-2.5 text-sm font-bold text-slate-700 shadow-sm transition hover:bg-slate-50" %>
    <%= f.submit @role.persisted? ? "Update Role" : "Create Role", class: "inline-flex items-center rounded-xl bg-slate-900 px-4 py-2.5 text-sm font-bold text-white shadow-sm transition hover:bg-slate-700" %>
  </div>
<% end %>
