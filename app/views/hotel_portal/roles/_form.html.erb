<%= form_with model: @role, url: @role.persisted? ? hotel_role_path(current_hotel, @role) : hotel_roles_path(current_hotel), method: @role.persisted? ? :patch : :post, local: true, class: "space-y-6" do |f| %>
  <% if @role.errors.any? %>
    <div class="rounded-xl border border-red-200 bg-red-50 p-4">
      <h2 class="text-sm font-bold text-red-900">Role could not be saved</h2>
      <ul class="mt-2 list-disc space-y-1 pl-5 text-sm text-red-700">
        <% @role.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= f.label :name, "Role Name", class: "mb-2 block text-sm font-medium text-slate-900" %>
    <%= f.text_field :name, required: true, class: "w-full rounded-xl border border-slate-200 bg-white px-4 py-2.5 text-sm transition focus:border-slate-900 focus:ring-0", placeholder: "Night Manager" %>
    <p class="mt-2 text-xs text-slate-500">The role slug is generated from the name when the role is created.</p>
  </div>

  <div>
    <div class="mb-3">
      <h2 class="text-sm font-bold text-slate-900">Permissions</h2>
      <p class="mt-1 text-xs text-slate-500">Select the capabilities this role should grant to assigned staff.</p>
    </div>

    <div class="grid grid-cols-1 gap-3 md:grid-cols-2 lg:grid-cols-3">
      <% @assignable_permissions.each do |permission| %>
        <label class="flex cursor-pointer items-start gap-3 rounded-xl border border-slate-100 bg-slate-50/30 p-3 transition hover:border-slate-300 hover:bg-white">
          <%= check_box_tag "role[permission_ids][]", permission.id, @role.permission_ids.include?(permission.id), class: "mt-0.5 rounded border-slate-300 text-slate-900 focus:ring-slate-900" %>
          <span>
            <span class="block text-sm font-bold leading-none text-slate-900"><%= permission.name %></span>
            <span class="mt-1 block text-[10px] font-medium uppercase tracking-wider text-slate-500"><%= permission.slug %></span>
          </span>
        </label>
      <% end %>
    </div>

    <% if @assignable_permissions.empty? %>
      <p class="mt-3 text-sm text-slate-500">You do not have permission to assign any role capabilities.</p>
    <% end %>

    <%= hidden_field_tag "role[permission_ids][]", "" %>
  </div>

  <div class="flex items-center justify-end gap-3 border-t border-slate-100 pt-4">
    <%= link_to "Cancel", hotel_roles_path(current_hotel), class: "inline-flex items-center rounded-xl border border-slate-200 bg-white px-4 py-2.5 text-sm font-bold text-slate-700 shadow-sm transition hover:bg-slate-50" %>
    <%= f.submit @role.persisted? ? "Update Role" : "Create Role", class: "inline-flex items-center rounded-xl bg-slate-900 px-4 py-2.5 text-sm font-bold text-white shadow-sm transition hover:bg-slate-700" %>
  </div>
<% end %>
