<%= render layout: "hotel_portal/settings/action_sheet",
           locals: {
             id: "edit-role-sheet",
             title: "Edit Role",
             description: "Rename #{@role.name}. Its permissions are managed in the matrix.",
             form_id: "edit-role-form",
             submit_label: "Save Changes"
           } do %>
  <%= form_with model: @role,
                url: hotel_role_path(current_hotel, @role),
                method: :patch,
                id: "edit-role-form",
                class: "space-y-5" do |f| %>
    <% if @role.errors.any? %>
      <%= render PanelsUI::Alert.new(
            tone: :destructive,
            title: "This role could not be saved",
            role: :alert) do |alert| %>
        <% alert.with_description do %>
          <ul class="list-disc space-y-1 ps-5">
            <% @role.errors.full_messages.each do |message| %>
              <li><%= message %></li>
            <% end %>
          </ul>
        <% end %>
      <% end %>
    <% end %>

    <%= render PanelsUI::FormField.new(
          form: f,
          attribute: :name,
          label: "Role Name",
          hint: "The slug was generated when the role was created and does not change.",
          required: true) do |field| %>
      <% field.with_input(placeholder: "Night Manager", autocomplete: "off", required: true) %>
    <% end %>
  <% end %>
<% end %>
