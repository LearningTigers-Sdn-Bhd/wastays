<% matrix_form_id = "permission-matrix-form" %>

<div class="w-full space-y-3.5" data-controller="matrix-mode matrix-search">
  <%= render "hotel_portal/settings/group_tabs" %>

  <div class="flex flex-col gap-4 lg:flex-row lg:items-start lg:justify-between">
    <div>
      <h1 class="text-base font-semibold tracking-tight text-foreground">Roles &amp; Permissions</h1>
      <p class="mt-1 text-sm text-muted-foreground">Each column is a role. Grant a permission by ticking it while editing.</p>
    </div>

    <div class="flex w-full flex-col gap-2 sm:flex-row sm:items-center lg:w-auto">
      <%# Filtering happens in the browser, so this names a control rather than a
          submitted value: `fields` gives the component a builder without a form. %>
      <%= fields :matrix_filter do |filter| %>
        <div class="w-full sm:w-64">
          <%= render PanelsUI::FormField.new(
                form: filter,
                attribute: :permission_search,
                label: "Search permissions",
                label_hidden: true,
                size: :sm) do |field| %>
            <% field.with_input(
                 type: :search,
                 placeholder: "Search permissions…",
                 autocomplete: "off",
                 data: { action: "input->matrix-search#search", matrix_search_target: "query" }) %>
            <% field.with_addon(align: :inline_start, variant: :bare) do %>
              <%= app_icon "search", class: "size-4 text-muted-foreground", aria: { hidden: "true" } %>
            <% end %>
          <% end %>
        </div>
      <% end %>

      <%# The matrix has one set of actions per mode and they occupy the same spot:
          reading offers Edit and New Role, editing offers only Cancel and Save. %>
      <div class="flex w-full flex-col gap-2 sm:w-auto sm:flex-row" data-matrix-mode-target="viewOnly">
        <%= render PanelsUI::Button.new(
              as: :button,
              variant: :secondary,
              size: :sm,
              class: "w-full sm:w-auto",
              data: { matrix_mode_target: "editTrigger", action: "matrix-mode#enableEdit" }) do %>
          <%= app_icon "square-pen", class: "size-4", aria: { hidden: "true" } %>
          <span>Edit Permissions</span>
        <% end %>

        <%= render PanelsUI::Button.new(
              href: new_hotel_role_path(current_hotel),
              size: :sm,
              class: "w-full sm:w-auto",
              data: { turbo_frame: "settings_action_sheet" }) do %>
          <%= app_icon "plus", class: "size-4", aria: { hidden: "true" } %>
          <span>New Role</span>
        <% end %>
      </div>

      <div class="hidden w-full flex-col gap-2 sm:w-auto sm:flex-row" data-matrix-mode-target="editOnly">
        <%= render PanelsUI::Button.new(
              as: :button,
              variant: :secondary,
              size: :sm,
              class: "w-full sm:w-auto",
              data: { matrix_mode_target: "cancelTrigger", action: "matrix-mode#disableEdit" }) do %>
          <span>Cancel</span>
        <% end %>

        <%= render PanelsUI::Button.new(
              as: :button,
              type: :submit,
              form: matrix_form_id,
              size: :sm,
              class: "w-full sm:w-auto",
              data: { turbo_submits_with: "Saving…" }) do %>
          <span>Save Permissions</span>
        <% end %>
      </div>
    </div>
  </div>

  <%# No heading of its own: the page title names the matrix, and the table
      carries its own caption for anyone reading it out of context. %>
  <div class="space-y-3">
    <p class="sr-only" role="status" aria-live="polite" aria-atomic="true"
       data-matrix-mode-target="status" data-matrix-search-target="status"></p>

    <%= form_with url: bulk_update_hotel_roles_path(current_hotel), method: :patch, id: matrix_form_id do %>
      <%# An empty column submits nothing at all, so each role carries a blank
          entry to distinguish "cleared" from "absent". %>
      <% @roles.each do |role| %>
        <%= hidden_field_tag "roles[#{role.id}][permission_ids][]", "", id: nil %>
      <% end %>

      <%= render PanelsUI::Table.new(
            caption: "Permissions granted to each role",
            density: :compact,
            header_style: :sentence,
            striped: true,
            hoverable: true,
            sticky_header: true,
            sticky_column: true,
            wrapper_class: "max-h-[75dvh] overflow-auto overscroll-none rounded-lg border border-border bg-card",
            data: { testid: "permission-matrix" }) do |table| %>
        <% table.with_header do %>
          <tr>
            <th scope="col" class="w-64 min-w-64">Permission</th>
            <% @roles.each do |role| %>
              <th scope="col" class="min-w-40 text-center">
                <div class="flex items-center justify-center gap-1">
                  <span><%= role.name %></span>
                  <%= render PanelsUI::DropdownMenu.new(
                        id: "role-#{role.id}-actions",
                        placement: :bottom_end,
                        class: "w-56") do |menu| %>
                    <% menu.with_trigger(
                         variant: :ghost,
                         size: :icon_sm,
                         aria_label: "Actions for #{role.name}") do %>
                      <%= app_icon "ellipsis-vertical", class: "size-4", aria: { hidden: "true" } %>
                    <% end %>

                    <% menu.with_item(
                         href: edit_hotel_role_path(current_hotel, role),
                         data: { turbo_frame: "settings_action_sheet" }) do %>
                      <%= app_icon "pencil", class: "size-4", aria: { hidden: "true" } %>
                      <span>Edit role</span>
                    <% end %>

                    <%# A role with staff assigned to it anywhere in the account is refused
                        server-side too, so the menu simply does not offer the action. %>
                    <% if role.user_hotel_accesses.empty? %>
                      <%# A link driving the delete, not `method:`: that renders button_to,
                          and its form would nest inside the matrix form wrapping this
                          table — which browsers discard, handing the click to the matrix. %>
                      <% menu.with_item(
                           href: hotel_role_path(current_hotel, role),
                           variant: :danger,
                           data: {
                             turbo_method: :delete,
                             turbo_confirm: "Delete the #{role.name} role?",
                             turbo_confirm_title: "Delete role?",
                             turbo_confirm_text: "The #{role.name} role and its permissions will be removed from this account. This cannot be undone.",
                             turbo_confirm_tone: "destructive",
                             turbo_frame: "_top"
                           }) do %>
                        <%= app_icon "trash-2", class: "size-4", aria: { hidden: "true" } %>
                        <span>Delete role</span>
                      <% end %>
                    <% end %>
                  <% end %>
                </div>
              </th>
            <% end %>
          </tr>
        <% end %>

        <% table.with_body do %>
          <% @assignable_permissions.each do |permission| %>
            <tr data-matrix-search-target="row" data-matrix-search-name="<%= permission.name %>">
              <th scope="row" class="font-medium text-foreground"><%= permission.name %></th>
              <% @roles.each do |role| %>
                <% granted = role.permission_ids.include?(permission.id) %>
                <td class="text-center">
                  <div class="flex justify-center" data-matrix-mode-target="viewOnly">
                    <% if granted %>
                      <%# Exceptional by request: a filled success disc with a white tick,
                          rather than the outlined token icon the rest of the portal uses. %>
                      <span class="inline-flex size-5 items-center justify-center rounded-full bg-success text-white">
                        <%= app_icon "check", class: "size-2.5", stroke_width: 3, aria: { hidden: "true" } %>
                      </span>
                      <span class="sr-only">Granted</span>
                    <% else %>
                      <%= app_icon "minus", class: "size-4 text-muted-foreground", aria: { hidden: "true" } %>
                      <span class="sr-only">Not granted</span>
                    <% end %>
                  </div>

                  <div class="hidden justify-center" data-matrix-mode-target="editOnly">
                    <%= render PanelsUI::Checkbox.new(
                          name: "roles[#{role.id}][permission_ids][]",
                          id: "role-#{role.id}-permission-#{permission.id}",
                          value: permission.id,
                          checked: granted,
                          label: "#{permission.name} for #{role.name}",
                          label_hidden: true) %>
                  </div>
                </td>
              <% end %>
            </tr>
          <% end %>

          <tr class="hidden" data-matrix-search-target="empty">
            <td colspan="<%= @roles.size + 1 %>" class="h-24 text-center">
              <p class="font-medium text-foreground">No permissions match that search.</p>
              <p class="mt-1 text-muted-foreground">Clear the search to see the whole matrix.</p>
            </td>
          </tr>
        <% end %>
      <% end %>
    <% end %>
  </div>
</div>
