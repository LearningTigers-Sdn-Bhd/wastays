<div class="max-w-[1600px] mx-auto pb-20 space-y-8">
  <div class="px-4 md:px-0">
    <div class="mt-5 flex flex-col gap-4 md:flex-row md:items-end md:justify-between">
      <div>
        <h1 class="text-2xl font-bold tracking-tight text-slate-950 sm:text-3xl">Roles & Permissions</h1>
        <p class="mt-1 text-sm font-medium text-slate-600">Create roles, assign permissions, and manage access levels for this account.</p>
      </div>
      <div>
        <%= link_to new_hotel_role_path(current_hotel), class: "inline-flex items-center rounded-xl bg-slate-900 px-4 py-2.5 text-sm font-bold text-white shadow-sm transition hover:bg-slate-700" do %>
          <svg class="mr-2 size-4" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 5v14"/><path d="M5 12h14"/></svg>
          New Role
        <% end %>
      </div>
    </div>
  </div>

  <div class="px-4 md:px-0 space-y-6">
    <% @roles.each do |role| %>
      <section class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">
        <div class="border-b border-slate-200 bg-slate-50/50 px-6 py-4 flex flex-col md:flex-row md:items-center md:justify-between gap-2">
          <div>
            <h2 class="text-lg font-bold tracking-tight text-slate-950"><%= role.name %></h2>
            <div class="mt-1 flex items-center gap-2">
              <span class="inline-flex items-center rounded-md bg-slate-200 px-1.5 py-0.5 text-[10px] font-bold text-slate-600 uppercase tracking-wider">
                <%= role.slug %>
              </span>
              <span class="text-xs font-semibold text-slate-500"><%= pluralize(role.user_hotel_accesses.size, "assigned staff member") %></span>
            </div>
          </div>
          <div class="flex items-center gap-2">
            <span class="inline-flex items-center rounded-full bg-slate-100 px-2.5 py-0.5 text-xs font-bold text-slate-700">
              <%= pluralize(role.permissions.size, "Permission") %>
            </span>
            <%= link_to "Edit", edit_hotel_role_path(current_hotel, role), class: "inline-flex items-center rounded-lg border border-slate-200 bg-white px-3 py-1.5 text-xs font-bold text-slate-700 shadow-sm transition hover:bg-slate-50" %>
            <% if role.user_hotel_accesses.empty? %>
              <%= button_to "Delete", hotel_role_path(current_hotel, role), method: :delete, data: { confirm: "Delete #{role.name}?" }, class: "inline-flex items-center rounded-lg border border-red-200 bg-white px-3 py-1.5 text-xs font-bold text-red-600 shadow-sm transition hover:bg-red-50" %>
            <% else %>
              <span class="inline-flex items-center rounded-lg border border-slate-200 bg-slate-50 px-3 py-1.5 text-xs font-bold text-slate-400" title="Remove assigned staff before deleting this role.">Delete</span>
            <% end %>
          </div>
        </div>

        <div class="p-6">
          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-3">
            <% role.permissions.sort_by(&:name).each do |permission| %>
              <div class="flex items-start gap-3 p-3 rounded-xl border border-slate-100 bg-slate-50/30">
                <div class="mt-0.5 text-slate-400">
                  <svg class="size-4" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>
                </div>
                <div>
                  <p class="text-sm font-bold text-slate-900 leading-none"><%= permission.name %></p>
                  <p class="mt-1 text-[10px] font-medium text-slate-500 uppercase tracking-wider"><%= permission.slug %></p>
                </div>
              </div>
            <% end %>
            <% if role.permissions.empty? %>
              <p class="text-sm text-slate-500 italic">No permissions assigned to this role.</p>
            <% end %>
          </div>
        </div>
      </section>
    <% end %>
  </div>
</div>
