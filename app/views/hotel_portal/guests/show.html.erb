<div class="space-y-6">
 <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
    <%= link_to hotel_guests_path(current_hotel), class: "inline-flex items-center gap-x-1.5 text-sm font-medium text-muted-foreground hover:text-blue-600 focus:outline-none focus:text-blue-600" do %>
      <%= cached_icon "chevron-left", class: "flex-shrink-0 w-4 h-4" %>
      Back to Guest Records
    <% end %>

    <%# Desktop Actions %>
    <div class="hidden md:flex items-center gap-x-3">
      <%= button_to toggle_vip_hotel_guest_path(current_hotel, @guest), method: :patch, class: "inline-flex items-center gap-x-2 rounded-xl border border-border bg-card px-5 py-2.5 text-sm font-semibold text-foreground shadow-sm transition hover:bg-muted w-fit" do %>
        <% if @guest.vip? %>
          <%= cached_icon "crown-simple", library: "phosphor", variant: "duotone", class: "size-4 text-amber-500 fill-amber-500 shrink-0" %>
          Remove VIP
        <% else %>
          <%= cached_icon "crown-simple", library: "phosphor", variant: "duotone", class: "size-4 text-muted-foreground shrink-0" %>
          Mark as VIP
        <% end %>
      <% end %>

      <% if @guest.blacklisted_at?(current_hotel) %>
        <%= button_to toggle_blacklist_hotel_guest_path(current_hotel, @guest), method: :patch, class: "inline-flex items-center gap-x-2 rounded-xl border border-border bg-card px-5 py-2.5 text-sm font-semibold text-foreground shadow-sm transition hover:bg-muted w-fit" do %>
          <div class="relative size-4 flex items-center justify-center shrink-0">
            <%= cached_icon "user", library: "phosphor", variant: "light", class: "size-4 translate-x-0.5 text-rose-600" %>
            <%= cached_icon "ban", class: "absolute inset-0 size-5 -translate-y-0.5 text-rose-600" %>
          </div>
          Remove Blacklist
        <% end %>
      <% else %>
        <button type="button" command="show-modal" commandfor="guest-blacklist-dialog" class="inline-flex items-center gap-x-2 rounded-xl border border-border bg-card px-5 py-2.5 text-sm font-semibold text-foreground shadow-sm transition hover:bg-muted w-fit">
          <div class="relative size-4 flex items-center justify-center shrink-0">
            <%= cached_icon "user", library: "phosphor", variant: "light", class: "size-4 translate-x-0.5 text-muted-foreground" %>
            <%= cached_icon "ban", class: "absolute inset-0 size-5 -translate-y-0.5 text-muted-foreground" %>
          </div>
          Blacklist Guest
        </button>
      <% end %>

      <%= link_to edit_hotel_guest_path(current_hotel, @guest), class: "inline-flex items-center gap-x-2 rounded-xl bg-primary px-5 py-2.5 text-sm font-bold text-primary-foreground shadow-sm transition hover:bg-primary-hover w-fit" do %>
        <%= cached_icon "pencil", class: "size-4" %>
        Edit Profile
      <% end %>
    </div>

    <%# Mobile Actions (Three-lines dropdown) %>
    <div class="md:hidden relative inline-block text-left self-end" data-controller="dropdown" data-dropdown-align="right">
      <button data-action="click->dropdown#toggle" type="button" class="inline-flex items-center justify-center size-10 rounded-xl border border-border bg-card text-foreground shadow-sm hover:bg-muted active:scale-95 transition-all" aria-label="Guest Actions">
        <%= cached_icon "menu", class: "size-5" %>
      </button>

      <div data-dropdown-target="menu" class="hidden absolute right-0 mt-2 w-48 origin-top-right rounded-2xl border border-border bg-card p-1.5 shadow-xl z-50 focus:outline-none" role="menu">
        <%= link_to edit_hotel_guest_path(current_hotel, @guest), class: "flex items-center gap-x-2 rounded-lg px-3 py-2.5 text-sm font-semibold text-foreground hover:bg-muted transition" do %>
          <%= cached_icon "pencil", class: "size-4 text-muted-foreground" %>
          Edit Profile
        <% end %>

        <%= button_to toggle_vip_hotel_guest_path(current_hotel, @guest), method: :patch, class: "flex w-full items-center gap-x-2 rounded-lg px-3 py-2.5 text-left text-sm font-semibold text-foreground hover:bg-muted transition" do %>
          <% if @guest.vip? %>
            <%= cached_icon "crown-simple", library: "phosphor", variant: "duotone", class: "size-4 text-amber-500 fill-amber-500 shrink-0" %>
            Remove VIP
          <% else %>
            <%= cached_icon "crown-simple", library: "phosphor", variant: "duotone", class: "size-4 text-muted-foreground shrink-0" %>
            Mark as VIP
          <% end %>
        <% end %>

        <% if @guest.blacklisted_at?(current_hotel) %>
          <%= button_to toggle_blacklist_hotel_guest_path(current_hotel, @guest), method: :patch, class: "flex w-full items-center gap-x-2 rounded-lg px-3 py-2.5 text-left text-sm font-semibold text-foreground hover:bg-muted transition" do %>
            <div class="relative size-4 flex items-center justify-center shrink-0">
              <%= cached_icon "user", library: "phosphor", variant: "light", class: "size-4 translate-x-0.5 text-rose-600" %>
              <%= cached_icon "ban", class: "absolute inset-0 size-5 -translate-y-0.5 text-rose-600" %>
            </div>
            Remove Blacklist
          <% end %>
        <% else %>
          <button type="button" command="show-modal" commandfor="guest-blacklist-dialog" class="flex w-full items-center gap-x-2 rounded-lg px-3 py-2.5 text-left text-sm font-semibold text-foreground hover:bg-muted transition">
            <div class="relative size-4 flex items-center justify-center shrink-0">
              <%= cached_icon "user", library: "phosphor", variant: "light", class: "size-4 translate-x-0.5 text-muted-foreground" %>
              <%= cached_icon "ban", class: "absolute inset-0 size-5 -translate-y-0.5 text-muted-foreground" %>
            </div>
            Blacklist Guest
          </button>
        <% end %>
      </div>
    </div>
  </div>

  <%= form_with url: toggle_blacklist_hotel_guest_path(current_hotel, @guest), method: :patch do |f| %>
    <%= render PanelsUI::Dialog.new(id: "guest-blacklist-dialog", title: "Blacklist guest", description: "#{@presenter.name} will be flagged as blacklisted for #{current_hotel.name}.", size: :md) do |dialog| %>
      <% dialog.with_body do %>
        <%= render PanelsUI::FormField.new(form: f, attribute: :blacklist_reason, label: "Reason", required: true) do |field| %>
          <% field.with_text_area(rows: 4, placeholder: "Explain why this guest is being blacklisted.") %>
        <% end %>
      <% end %>
      <% dialog.with_footer do %>
        <%= render PanelsUI::Button.new(as: :button, type: :button, variant: :secondary, size: :sm, data: { action: "panels-ui--dialog#close" }) do %>Cancel<% end %>
        <%= render PanelsUI::Button.new(as: :button, type: :submit, variant: :destructive, size: :sm) do %>Blacklist guest<% end %>
      <% end %>
    <% end %>
  <% end %>

  <div class="legacy-card <%= @guest.blacklisted_at?(current_hotel) ? 'border-rose-200 bg-rose-50/20' : '' %>">
    <div class="p-4 border-b border-border <%= @guest.blacklisted_at?(current_hotel) ? 'bg-rose-50/30 border-rose-200' : '' %>">
      <div>
        <div class="flex items-center gap-x-2">
          <h1 class="text-xl font-bold text-foreground"><%= @presenter.name %></h1>
          <% if @guest.vip? %>
            <%= render PanelsUI::Tooltip.new(text: "VIP guest", delay: 150) do %>
              <span class="inline-flex focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring" tabindex="0" aria-label="VIP guest">
                <%= cached_icon "crown-simple", library: "phosphor", variant: "duotone", class: "size-5 text-amber-500 fill-amber-500 shrink-0", aria: { hidden: "true" }, focusable: "false" %>
              </span>
            <% end %>
          <% end %>
          <% if @guest.blacklisted_at?(current_hotel) %>
            <div class="relative size-5 flex items-center justify-center shrink-0">
              <%= cached_icon "user", library: "phosphor", variant: "light", class: "size-5 translate-x-0.5 text-rose-600" %>
              <%= cached_icon "ban", class: "absolute inset-0 size-6 -translate-y-0.5 text-rose-600" %>
            </div>
          <% end %>
          <% if @guest.repeat? %>
            <%= render PanelsUI::Tooltip.new(text: "Repeat guest", delay: 150) do %>
              <span class="inline-flex focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring" tabindex="0" aria-label="Repeat guest">
                <%= cached_icon "repeat", library: "lucide", variant: "outline", class: "size-5 text-blue-500 shrink-0", aria: { hidden: "true" }, focusable: "false" %>
              </span>
            <% end %>
          <% end %>
        </div>
        <% if (detail = @guest.blacklist_detail(current_hotel)).present? %>
          <p class="mt-1 text-xs text-rose-700">
            Blacklisted by <span class="font-semibold"><%= detail["blacklisted_by_name"] %></span>
            <% if detail["reason"].present? %> &middot; <%= detail["reason"] %><% end %>
          </p>
        <% end %>
      </div>
    </div>
    <div class="p-4 space-y-3 grid gap-3 md:grid-cols-2">
      <div>
        <p class="text-[10px] uppercase tracking-widest text-muted-foreground">Email</p>
        <p class="text-sm font-semibold text-foreground"><%= @presenter.email %></p>
      </div>
      <div>
        <p class="text-[10px] uppercase tracking-widest text-muted-foreground">Phone</p>
        <p class="text-sm font-semibold text-foreground"><%= @presenter.phone %></p>
      </div>
      <div>
        <p class="text-[10px] uppercase tracking-widest text-muted-foreground">Gender</p>
        <p class="text-sm font-semibold text-foreground"><%= @presenter.gender %></p>
      </div>
      <div>
        <p class="text-[10px] uppercase tracking-widest text-muted-foreground">Passport Country</p>
        <p class="text-sm font-semibold text-foreground"><%= @presenter.country %></p>
      </div>
      <div>
        <p class="text-[10px] uppercase tracking-widest text-muted-foreground">Document Type</p>
        <p class="text-sm font-semibold text-foreground"><%= @presenter.document_type %></p>
      </div>
      <div>
        <p class="text-[10px] uppercase tracking-widest text-muted-foreground">ID / Passport</p>
        <p class="text-sm font-semibold text-foreground"><%= @presenter.government_id %></p>
      </div>
      <div>
        <p class="text-[10px] uppercase tracking-widest text-muted-foreground">Date of Birth</p>
        <p class="text-sm font-semibold text-foreground"><%= @presenter.date_of_birth_formatted %></p>
      </div>
      <div>
        <p class="text-[10px] uppercase tracking-widest text-muted-foreground">Last Stay</p>
        <p class="text-sm font-semibold text-foreground">
          <%= @presenter.last_stay_checkout_date(@all_bookings) %>
        </p>
      </div>
      <div>
        <p class="text-[10px] uppercase tracking-widest text-muted-foreground">Total Visits</p>
        <p class="text-sm font-semibold text-foreground"><%= @all_bookings.count %></p>
      </div>
      <div class="md:col-span-2">
        <p class="text-[10px] uppercase tracking-widest text-muted-foreground">Address</p>
        <p class="text-sm font-semibold text-foreground"><%= @presenter.home_address %></p>
      </div>
    </div>
  </div>

  <div class="grid md:grid-cols-2 gap-4">
    <div class="legacy-card">
      <div class="p-4 border-b border-border">
        <p class="text-xs uppercase font-black tracking-widest text-muted-foreground">Currency Totals</p>
      </div>
      <div class="p-4 space-y-3">
        <% if @currency_totals.any? %>
          <% @currency_totals.each do |currency, amount| %>
            <div class="flex items-center justify-between">
              <span class="text-sm font-medium text-muted-foreground"><%= currency %></span>
              <span class="text-sm font-semibold text-foreground"><%= @presenter.formatted_currency_amount(amount, currency) %></span>
            </div>
          <% end %>
        <% else %>
          <p class="text-xs text-muted-foreground">No bookings recorded yet.</p>
        <% end %>
      </div>
    </div>

    <div class="legacy-card">
      <div class="p-4 border-b border-border">
        <p class="text-xs uppercase font-black tracking-widest text-muted-foreground">Recent Notes</p>
      </div>
      <div class="p-4 text-xs text-muted-foreground">
        Use the booking timeline below to review stay history, documentation status, and payment summaries.
      </div>
    </div>
  </div>

  <div class="overflow-hidden rounded-2xl border border-border bg-card shadow-sm">
    <div class="flex items-center justify-between border-b border-border px-6 py-5">
      <div>
        <h2 class="text-lg font-bold tracking-tight text-foreground sm:text-xl">Booking History</h2>
        <p class="mt-1 text-sm font-medium text-muted-foreground">Timeline of this guest's stays at the property.</p>
      </div>
      <span class="text-sm font-medium text-muted-foreground">Stays <span class="font-semibold text-foreground"><%= @all_bookings.count %></span></span>
    </div>

    <% if @bookings.any? %>
      <div class="hidden md:block overflow-x-auto">
        <table class="min-w-full">
          <thead class="bg-muted">
            <tr>
              <th scope="col" class="px-6 py-4 text-left text-[11px] font-semibold uppercase tracking-[0.1em] text-muted-foreground">Confirmation</th>
              <th scope="col" class="px-6 py-4 text-left text-[11px] font-semibold uppercase tracking-[0.1em] text-muted-foreground">Stay</th>
              <th scope="col" class="px-6 py-4 text-left text-[11px] font-semibold uppercase tracking-[0.1em] text-muted-foreground">Status</th>
              <th scope="col" class="px-6 py-4 text-left text-[11px] font-semibold uppercase tracking-[0.1em] text-muted-foreground">Amount</th>
              <th scope="col" class="px-6 py-4 text-left text-[11px] font-semibold uppercase tracking-[0.1em] text-muted-foreground">Created At</th>
              <th scope="col" class="px-6 py-4 text-left text-[11px] font-semibold uppercase tracking-[0.1em] text-muted-foreground">Pre-Check-In</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-border bg-card">
            <% @bookings.each_with_index do |booking, index| %>
              <% booking_presenter = Guests::BookingPresenter.new(booking) %>
              <tr class="transition-colors hover:bg-muted/80 <%= index.even? ? 'bg-card' : 'bg-muted/55' %>">
                <td class="px-6 py-4 whitespace-nowrap text-sm font-semibold text-foreground"><%= booking_presenter.confirmation_token %></td>
                <td class="px-6 py-4 text-sm text-foreground">
                  <div class="flex flex-col gap-0.5">
                    <span><%= booking_presenter.check_in_formatted %> - <%= booking_presenter.check_out_formatted %></span>
                    <span class="text-xs text-muted-foreground">
                      <%= booking_presenter.nights_label %>
                    </span>
                  </div>
                </td>
                <td class="px-6 py-4 whitespace-nowrap">
                  <span class="inline-flex items-center rounded-full px-2.5 py-0.5 text-xs font-medium <%= booking_status_class(booking_presenter.status) %>">
                    <%= booking_presenter.status_humanized %>
                  </span>
                </td>
                <td class="px-6 py-4 text-sm font-medium text-foreground">
                  <div class="flex flex-col gap-0.5">
                    <span><%= booking_presenter.formatted_total_amount %></span>
                    <% if booking_presenter.tourism_tax? %>
                      <span class="text-xs text-muted-foreground"><%= booking_presenter.formatted_tourism_tax_amount %></span>
                    <% end %>
                  </div>
                </td>
                <td class="px-6 py-4 text-sm text-foreground">
                  <div class="flex flex-col gap-0.5">
                    <span><%= booking_presenter.created_at_time_formatted %></span>
                    <span class="text-xs text-muted-foreground"><%= booking_presenter.created_at_date_formatted %></span>
                  </div>
                </td>
                <td class="px-6 py-4 text-sm text-muted-foreground">
                  <%= booking_presenter.pre_checkin_status_label %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>

      <div class="space-y-4 p-4 md:hidden">
        <% @bookings.each do |booking| %>
          <% booking_presenter = Guests::BookingPresenter.new(booking) %>
          <div class="rounded-2xl border border-border bg-muted/60 p-4 shadow-sm">
            <div class="flex items-start justify-between gap-3">
              <div>
                <p class="text-xs font-semibold uppercase tracking-[0.08em] text-muted-foreground">Confirmation</p>
                <p class="mt-1 text-sm font-semibold text-foreground"><%= booking_presenter.confirmation_token %></p>
              </div>
              <div class="text-right">
                <p class="text-xs font-semibold uppercase tracking-[0.08em] text-muted-foreground">Status</p>
                <span class="inline-flex items-center rounded-full mt-1 px-2.5 py-0.5 text-xs font-medium <%= booking_status_class(booking_presenter.status) %>">
                  <%= booking_presenter.status_humanized %>
                </span>
              </div>
            </div>

            <dl class="mt-4 space-y-3 text-sm">
              <div>
                <dt class="text-xs font-semibold uppercase tracking-[0.08em] text-muted-foreground">Stay</dt>
                <dd class="mt-1 text-foreground"><%= booking_presenter.check_in_formatted %> - <%= booking_presenter.check_out_formatted %></dd>
              </div>
              <div class="flex items-start justify-between gap-3">
                <div>
                  <dt class="text-xs font-semibold uppercase tracking-[0.08em] text-muted-foreground">Amount</dt>
                  <dd class="mt-1 text-foreground"><%= booking_presenter.formatted_total_amount %></dd>
                </div>
                <div class="text-right">
                  <dt class="text-xs font-semibold uppercase tracking-[0.08em] text-muted-foreground">Pre-Check-In</dt>
                  <dd class="mt-1 text-foreground"><%= booking_presenter.pre_checkin_status_label %></dd>
                </div>
              </div>
              <div>
                <dt class="text-xs font-semibold uppercase tracking-[0.08em] text-muted-foreground">Created At</dt>
                <dd class="mt-1 text-foreground">
                  <div class="flex flex-col gap-0.5">
                    <span><%= booking_presenter.created_at_time_formatted %></span>
                    <span class="text-xs text-muted-foreground"><%= booking_presenter.created_at_date_formatted %></span>
                  </div>
                </dd>
              </div>
            </dl>
          </div>
        <% end %>
      </div>
    <% else %>
      <div class="px-6 py-12 text-center">
        <p class="text-sm font-medium text-muted-foreground">No bookings yet.</p>
      </div>
    <% end %>

    <div class="px-6 py-5 border-t border-border bg-muted/50 flex justify-center">
      <%= paginate @bookings %>
    </div>
  </div>
</div>
