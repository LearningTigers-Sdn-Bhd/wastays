<div class="space-y-6">
  <div class="mt-5 flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
    <%= link_to hotel_guests_path(current_hotel), class: "inline-flex items-center gap-x-1.5 text-sm font-medium text-gray-500 hover:text-blue-600 focus:outline-none focus:text-blue-600" do %>
      <%= cached_icon "chevron-left", class: "flex-shrink-0 w-4 h-4" %>
      Back to Guest Records
    <% end %>

    <%# Desktop Actions %>
    <div class="hidden md:flex items-center gap-x-3">
      <%= button_to toggle_vip_hotel_guest_path(current_hotel, @guest), method: :patch, class: "inline-flex items-center gap-x-2 rounded-xl border border-slate-200 bg-white px-5 py-2.5 text-sm font-semibold text-slate-700 shadow-sm transition hover:bg-slate-50 w-fit" do %>
        <% if @guest.vip? %>
          <%= cached_icon "crown-simple", library: "phosphor", variant: "duotone", class: "size-4 text-amber-500 fill-amber-500 shrink-0" %>
          Remove VIP
        <% else %>
          <%= cached_icon "crown-simple", library: "phosphor", variant: "duotone", class: "size-4 text-slate-400 shrink-0" %>
          Mark as VIP
        <% end %>
      <% end %>

      <%= button_to toggle_blacklist_hotel_guest_path(current_hotel, @guest), method: :patch, class: "inline-flex items-center gap-x-2 rounded-xl border border-slate-200 bg-white px-5 py-2.5 text-sm font-semibold text-slate-700 shadow-sm transition hover:bg-slate-50 w-fit" do %>
        <% if @guest.blacklisted? %>
          <div class="relative size-4 flex items-center justify-center shrink-0">
            <%= cached_icon "user", library: "phosphor", variant: "light", class: "size-4 translate-x-0.5 text-rose-600" %>
            <%= cached_icon "ban", class: "absolute inset-0 size-5 -translate-y-0.5 text-rose-600" %>
          </div>
          Remove Blacklist
        <% else %>
          <div class="relative size-4 flex items-center justify-center shrink-0">
            <%= cached_icon "user", library: "phosphor", variant: "light", class: "size-4 translate-x-0.5 text-slate-400" %>
            <%= cached_icon "ban", class: "absolute inset-0 size-5 -translate-y-0.5 text-slate-400" %>
          </div>
          Blacklist Guest
        <% end %>
      <% end %>

      <%= link_to edit_hotel_guest_path(current_hotel, @guest), class: "inline-flex items-center gap-x-2 rounded-xl bg-slate-900 px-5 py-2.5 text-sm font-bold text-white shadow-sm transition hover:bg-slate-700 w-fit" do %>
        <%= cached_icon "pencil", class: "size-4" %>
        Edit Profile
      <% end %>
    </div>

    <%# Mobile Actions (Three-lines dropdown) %>
    <div class="md:hidden relative inline-block text-left self-end" data-controller="dropdown" data-dropdown-align="right">
      <button data-action="click->dropdown#toggle click@window->dropdown#hide" type="button" class="inline-flex items-center justify-center size-10 rounded-xl border border-slate-200 bg-white text-slate-700 shadow-sm hover:bg-slate-50 active:scale-95 transition-all" aria-label="Guest Actions">
        <%= cached_icon "menu", class: "size-5" %>
      </button>

      <div data-dropdown-target="menu" class="hidden absolute right-0 mt-2 w-48 origin-top-right rounded-2xl border border-slate-200 bg-white p-1.5 shadow-xl z-50 focus:outline-none" role="menu">
        <%= link_to edit_hotel_guest_path(current_hotel, @guest), class: "flex items-center gap-x-2 rounded-lg px-3 py-2.5 text-sm font-semibold text-slate-700 hover:bg-slate-50 transition" do %>
          <%= cached_icon "pencil", class: "size-4 text-slate-400" %>
          Edit Profile
        <% end %>

        <%= button_to toggle_vip_hotel_guest_path(current_hotel, @guest), method: :patch, class: "flex w-full items-center gap-x-2 rounded-lg px-3 py-2.5 text-left text-sm font-semibold text-slate-700 hover:bg-slate-50 transition" do %>
          <% if @guest.vip? %>
            <%= cached_icon "crown-simple", library: "phosphor", variant: "duotone", class: "size-4 text-amber-500 fill-amber-500 shrink-0" %>
            Remove VIP
          <% else %>
            <%= cached_icon "crown-simple", library: "phosphor", variant: "duotone", class: "size-4 text-slate-400 shrink-0" %>
            Mark as VIP
          <% end %>
        <% end %>

        <%= button_to toggle_blacklist_hotel_guest_path(current_hotel, @guest), method: :patch, class: "flex w-full items-center gap-x-2 rounded-lg px-3 py-2.5 text-left text-sm font-semibold text-slate-700 hover:bg-slate-50 transition" do %>
          <% if @guest.blacklisted? %>
            <div class="relative size-4 flex items-center justify-center shrink-0">
              <%= cached_icon "user", library: "phosphor", variant: "light", class: "size-4 translate-x-0.5 text-rose-600" %>
              <%= cached_icon "ban", class: "absolute inset-0 size-5 -translate-y-0.5 text-rose-600" %>
            </div>
            Remove Blacklist
          <% else %>
            <div class="relative size-4 flex items-center justify-center shrink-0">
              <%= cached_icon "user", library: "phosphor", variant: "light", class: "size-4 translate-x-0.5 text-slate-400" %>
              <%= cached_icon "ban", class: "absolute inset-0 size-5 -translate-y-0.5 text-slate-400" %>
            </div>
            Blacklist Guest
          <% end %>
        <% end %>
      </div>
    </div>
  </div>

  <div class="card <%= @guest.blacklisted? ? 'border-rose-200 bg-rose-50/20' : '' %>">
    <div class="p-4 border-b border-neutral-border <%= @guest.blacklisted? ? 'bg-rose-50/30 border-rose-200' : '' %>">
      <div>
        <div class="flex items-center gap-x-2">
          <h1 class="text-xl font-bold text-neutral-text-primary"><%= @presenter.name %></h1>
          <% if @guest.vip? %>
            <%= cached_icon "crown-simple", library: "phosphor", variant: "duotone", class: "size-5 text-amber-500 fill-amber-500 shrink-0" %>
          <% end %>
          <% if @guest.blacklisted? %>
            <div class="relative size-5 flex items-center justify-center shrink-0">
              <%= cached_icon "user", library: "phosphor", variant: "light", class: "size-5 translate-x-0.5 text-rose-600" %>
              <%= cached_icon "ban", class: "absolute inset-0 size-6 -translate-y-0.5 text-rose-600" %>
            </div>
          <% end %>
          <% if @guest.repeat? %>
            <%= cached_icon "repeat", library: "lucide", variant: "outline", class: "size-5 text-blue-500 shrink-0" %>
          <% end %>
        </div>
        <p class="text-xs uppercase tracking-widest text-neutral-text-secondary">Guest Profile</p>
      </div>
    </div>
    <div class="p-4 space-y-3 grid gap-3 md:grid-cols-2">
      <div>
        <p class="text-[10px] uppercase tracking-widest text-neutral-text-secondary">Email</p>
        <p class="text-sm font-semibold text-neutral-text-primary"><%= @presenter.email %></p>
      </div>
      <div>
        <p class="text-[10px] uppercase tracking-widest text-neutral-text-secondary">Phone</p>
        <p class="text-sm font-semibold text-neutral-text-primary"><%= @presenter.phone %></p>
      </div>
      <div>
        <p class="text-[10px] uppercase tracking-widest text-neutral-text-secondary">Gender</p>
        <p class="text-sm font-semibold text-neutral-text-primary"><%= @presenter.gender %></p>
      </div>
      <div>
        <p class="text-[10px] uppercase tracking-widest text-neutral-text-secondary">Passport Country</p>
        <p class="text-sm font-semibold text-neutral-text-primary"><%= @presenter.country %></p>
      </div>
      <div>
        <p class="text-[10px] uppercase tracking-widest text-neutral-text-secondary">Document Type</p>
        <p class="text-sm font-semibold text-neutral-text-primary"><%= @presenter.document_type %></p>
      </div>
      <div>
        <p class="text-[10px] uppercase tracking-widest text-neutral-text-secondary">ID / Passport</p>
        <p class="text-sm font-semibold text-neutral-text-primary"><%= @presenter.government_id %></p>
      </div>
      <div>
        <p class="text-[10px] uppercase tracking-widest text-neutral-text-secondary">Date of Birth</p>
        <p class="text-sm font-semibold text-neutral-text-primary"><%= @presenter.date_of_birth_formatted %></p>
      </div>
      <div>
        <p class="text-[10px] uppercase tracking-widest text-neutral-text-secondary">Last Stay</p>
        <p class="text-sm font-semibold text-neutral-text-primary">
          <%= @presenter.last_stay_checkout_date(@all_bookings) %>
        </p>
      </div>
      <div>
        <p class="text-[10px] uppercase tracking-widest text-neutral-text-secondary">Total Visits</p>
        <p class="text-sm font-semibold text-neutral-text-primary"><%= @all_bookings.count %></p>
      </div>
    </div>
  </div>

  <div class="grid md:grid-cols-2 gap-4">
    <div class="card">
      <div class="p-4 border-b border-neutral-border">
        <p class="text-xs uppercase font-black tracking-widest text-neutral-text-secondary">Currency Totals</p>
      </div>
      <div class="p-4 space-y-3">
        <% if @currency_totals.any? %>
          <% @currency_totals.each do |currency, amount| %>
            <div class="flex items-center justify-between">
              <span class="text-sm font-medium text-neutral-text-secondary"><%= currency %></span>
              <span class="text-sm font-semibold text-neutral-text-primary"><%= @presenter.formatted_currency_amount(amount, currency) %></span>
            </div>
          <% end %>
        <% else %>
          <p class="text-xs text-neutral-text-secondary">No bookings recorded yet.</p>
        <% end %>
      </div>
    </div>

    <div class="card">
      <div class="p-4 border-b border-neutral-border">
        <p class="text-xs uppercase font-black tracking-widest text-neutral-text-secondary">Recent Notes</p>
      </div>
      <div class="p-4 text-xs text-neutral-text-secondary">
        Use the booking timeline below to review stay history, documentation status, and payment summaries.
      </div>
    </div>
  </div>

  <div class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">
    <div class="flex items-center justify-between border-b border-slate-200 px-6 py-5">
      <div>
        <h2 class="text-lg font-bold tracking-tight text-slate-950 sm:text-xl">Booking History</h2>
        <p class="mt-1 text-sm font-medium text-slate-600">Timeline of this guest's stays at the property.</p>
      </div>
      <span class="text-sm font-medium text-slate-500">Stays <span class="font-semibold text-slate-900"><%= @all_bookings.count %></span></span>
    </div>

    <% if @bookings.any? %>
      <div class="hidden md:block overflow-x-auto">
        <table class="min-w-full">
          <thead class="bg-slate-100">
            <tr>
              <th scope="col" class="px-6 py-4 text-left text-[11px] font-semibold uppercase tracking-[0.1em] text-slate-600">Confirmation</th>
              <th scope="col" class="px-6 py-4 text-left text-[11px] font-semibold uppercase tracking-[0.1em] text-slate-600">Stay</th>
              <th scope="col" class="px-6 py-4 text-left text-[11px] font-semibold uppercase tracking-[0.1em] text-slate-600">Status</th>
              <th scope="col" class="px-6 py-4 text-left text-[11px] font-semibold uppercase tracking-[0.1em] text-slate-600">Amount</th>
              <th scope="col" class="px-6 py-4 text-left text-[11px] font-semibold uppercase tracking-[0.1em] text-slate-600">Created At</th>
              <th scope="col" class="px-6 py-4 text-left text-[11px] font-semibold uppercase tracking-[0.1em] text-slate-600">Pre-Check-In</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-200 bg-white">
            <% @bookings.each_with_index do |booking, index| %>
              <% booking_presenter = Guests::BookingPresenter.new(booking) %>
              <tr class="transition-colors hover:bg-slate-100/80 <%= index.even? ? 'bg-white' : 'bg-slate-50/55' %>">
                <td class="px-6 py-4 whitespace-nowrap text-sm font-semibold text-slate-900"><%= booking_presenter.confirmation_token %></td>
                <td class="px-6 py-4 text-sm text-slate-700">
                  <div class="flex flex-col gap-0.5">
                    <span><%= booking_presenter.check_in_formatted %> - <%= booking_presenter.check_out_formatted %></span>
                    <span class="text-xs text-slate-500">
                      <%= booking_presenter.nights_label %>
                    </span>
                  </div>
                </td>
                <td class="px-6 py-4 whitespace-nowrap">
                  <span class="inline-flex items-center rounded-full px-2.5 py-0.5 text-xs font-medium <%= booking_status_class(booking_presenter.status) %>">
                    <%= booking_presenter.status_humanized %>
                  </span>
                </td>
                <td class="px-6 py-4 text-sm font-medium text-slate-900">
                  <div class="flex flex-col gap-0.5">
                    <span><%= booking_presenter.formatted_total_amount %></span>
                    <% if booking_presenter.tourism_tax? %>
                      <span class="text-xs text-slate-500"><%= booking_presenter.formatted_tourism_tax_amount %></span>
                    <% end %>
                  </div>
                </td>
                <td class="px-6 py-4 text-sm text-slate-700">
                  <div class="flex flex-col gap-0.5">
                    <span><%= booking_presenter.created_at_time_formatted %></span>
                    <span class="text-xs text-slate-500"><%= booking_presenter.created_at_date_formatted %></span>
                  </div>
                </td>
                <td class="px-6 py-4 text-sm text-slate-600">
                  <%= booking_presenter.pre_checkin_status_label %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>

      <div class="space-y-4 p-4 md:hidden">
        <% @bookings.each do |booking| %>
          <% booking_presenter = Guests::BookingPresenter.new(booking) %>
          <div class="rounded-2xl border border-slate-200 bg-slate-50/60 p-4 shadow-sm">
            <div class="flex items-start justify-between gap-3">
              <div>
                <p class="text-xs font-semibold uppercase tracking-[0.08em] text-slate-500">Confirmation</p>
                <p class="mt-1 text-sm font-semibold text-slate-900"><%= booking_presenter.confirmation_token %></p>
              </div>
              <div class="text-right">
                <p class="text-xs font-semibold uppercase tracking-[0.08em] text-slate-500">Status</p>
                <span class="inline-flex items-center rounded-full mt-1 px-2.5 py-0.5 text-xs font-medium <%= booking_status_class(booking_presenter.status) %>">
                  <%= booking_presenter.status_humanized %>
                </span>
              </div>
            </div>

            <dl class="mt-4 space-y-3 text-sm">
              <div>
                <dt class="text-xs font-semibold uppercase tracking-[0.08em] text-slate-500">Stay</dt>
                <dd class="mt-1 text-slate-700"><%= booking_presenter.check_in_formatted %> - <%= booking_presenter.check_out_formatted %></dd>
              </div>
              <div class="flex items-start justify-between gap-3">
                <div>
                  <dt class="text-xs font-semibold uppercase tracking-[0.08em] text-slate-500">Amount</dt>
                  <dd class="mt-1 text-slate-700"><%= booking_presenter.formatted_total_amount %></dd>
                </div>
                <div class="text-right">
                  <dt class="text-xs font-semibold uppercase tracking-[0.08em] text-slate-500">Pre-Check-In</dt>
                  <dd class="mt-1 text-slate-700"><%= booking_presenter.pre_checkin_status_label %></dd>
                </div>
              </div>
              <div>
                <dt class="text-xs font-semibold uppercase tracking-[0.08em] text-slate-500">Created At</dt>
                <dd class="mt-1 text-slate-700">
                  <div class="flex flex-col gap-0.5">
                    <span><%= booking_presenter.created_at_time_formatted %></span>
                    <span class="text-xs text-slate-500"><%= booking_presenter.created_at_date_formatted %></span>
                  </div>
                </dd>
              </div>
            </dl>
          </div>
        <% end %>
      </div>
    <% else %>
      <div class="px-6 py-12 text-center">
        <p class="text-sm font-medium text-slate-500">No bookings yet.</p>
      </div>
    <% end %>

    <div class="px-6 py-5 border-t border-slate-200 bg-slate-50/50 flex justify-center">
      <%= paginate @bookings %>
    </div>
  </div>
</div>
