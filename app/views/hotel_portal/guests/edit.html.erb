<div class="w-full">
 <div class="mb-5">
    <%= link_to hotel_guest_path(current_hotel, @guest), class: "inline-flex items-center gap-x-1.5 text-sm text-muted-foreground hover:text-blue-600" do %>
      <svg class="flex-shrink-0 size-4" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg>
      Back to Profile
    <% end %>
  </div>

  <div class="space-y-2 mb-8">
    <h1 class="text-2xl font-bold text-foreground">Edit Guest Profile</h1>
    <p class="text-sm text-muted-foreground">Update contact or identification details for this guest.</p>
  </div>

  <%= render "form", guest: @guest %>
</div>
