<% content_for :breadcrumbs do %>
  <div class="flex items-center gap-x-2">
    <span class="text-sm font-medium text-slate-600"><%= current_hotel.name %></span>
    <span class="text-sm text-slate-400">/</span>
    <%= link_to "Guest Records", hotel_guests_path(current_hotel), class: "text-sm font-medium text-slate-600 hover:text-slate-900" %>
    <span class="text-sm text-slate-400">/</span>
    <%= link_to @guest.name, hotel_guest_path(current_hotel, @guest), class: "text-sm font-medium text-slate-600 hover:text-slate-900" %>
    <span class="text-sm text-slate-400">/</span>
    <span class="text-sm font-semibold text-slate-900">Edit</span>
  </div>
<% end %>

<div class="max-w-4xl mx-auto pb-20">
  <div class="mt-5 mb-5">
    <%= link_to hotel_guest_path(current_hotel, @guest), class: "inline-flex items-center gap-x-1.5 text-sm text-gray-600 hover:text-blue-600" do %>
      <svg class="flex-shrink-0 size-4" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg>
      Back to Profile
    <% end %>
  </div>

  <div class="space-y-2 mb-8">
    <h1 class="text-2xl font-bold text-gray-800">Edit Guest Profile</h1>
    <p class="text-sm text-gray-600">Update contact or identification details for this guest.</p>
  </div>

  <%= render "form", guest: @guest %>
</div>
