<%# The strip is rendered inside the guest_record frame, so a link with no
    target navigates that frame: the body would swap while the URL and the page
    shell stayed put. `_top` sends the click to the page, so the URL advances
    and the breadcrumb bar in the shell follows the open tab. %>
<div class="border-b border-border">
  <%= render PanelsUI::Tabs.new(
        id: "guest-record-tabs",
        active: active_tab,
        variant: :line,
        aria_label: "Guest record tabs") do |tabs| %>
    <% tabs.with_tab(
         name: "details",
         label: "Details",
         href: details_hotel_guest_path(current_hotel, guest),
         data: { turbo_frame: "_top" }) %>
    <% tabs.with_tab(
         name: "booking_history",
         label: "Booking History",
         count: stays_count,
         href: booking_history_hotel_guest_path(current_hotel, guest),
         data: { turbo_frame: "_top" }) %>
  <% end %>
</div>
