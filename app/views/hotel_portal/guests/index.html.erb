<div class="space-y-4">
  <% if @guests.any? %>
    <% @guests.each do |guest| %>
      <article class="card hover:shadow-xl transition-shadow">
        <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-3 p-4 border-b border-neutral-border">
          <div>
            <h2 class="text-base font-semibold text-neutral-text-primary">
              <%= safe_guest_attr(guest, :name) %>
            </h2>
            <p class="text-xs text-neutral-text-secondary">
              <%= safe_guest_attr(guest, :gender)&.capitalize || "Unspecified" %> · <%= safe_guest_attr(guest, :document_type)&.upcase || "ID" %> · <%= safe_guest_attr(guest, :country) || "Unknown country" %>
            </p>
          </div>
          <div class="text-xs text-neutral-text-secondary text-right">
            <p>Last stayed: <%= guest.try(:last_stay_at)&.strftime("%d %b %Y") || "—" %></p>
            <p><%= pluralize(guest.bookings.where(hotel: current_hotel).count, "stay") %></p>
          </div>
        </div>
        <div class="p-4 grid sm:grid-cols-3 gap-3 border-b border-neutral-border text-xs text-neutral-text-secondary">
          <div>
            <p class="text-[10px] uppercase tracking-widest">Email</p>
            <p class="text-sm font-medium text-neutral-text-primary"><%= safe_guest_attr(guest, :email) %></p>
          </div>
          <div>
            <p class="text-[10px] uppercase tracking-widest">Phone</p>
            <p class="text-sm font-medium text-neutral-text-primary"><%= safe_guest_attr(guest, :phone) %></p>
          </div>
          <div>
            <p class="text-[10px] uppercase tracking-widest">ID / Passport</p>
            <p class="text-sm font-medium text-neutral-text-primary"><%= safe_guest_attr(guest, :government_id) %></p>
          </div>
        </div>
        <div class="p-4 space-y-2 text-xs text-neutral-text-secondary">
          <div class="flex flex-wrap gap-2">
            <% guest.bookings.where(hotel: current_hotel).group(:currency).sum(:total_amount).each do |currency, amount| %>
              <span class="px-3 py-1 rounded-full border border-neutral-border bg-neutral-bg">
                <strong><%= currency %></strong> <%= number_with_precision(amount, precision: 2) %>
              </span>
            <% end %>
          </div>
          <div class="pt-2">
            <%= link_to "View timeline", hotel_guest_path(guest), class: "text-brand-primary font-semibold hover:underline" %>
          </div>
        </div>
      </article>
    <% end %>
  <% else %>
    <div class="card p-6 text-sm text-neutral-text-secondary">
      No guests recorded yet for this property.
    </div>
  <% end %>
</div>
