<div class="w-full">
 <div class="mb-5">
    <%= link_to hotel_guests_path(current_hotel), class: "inline-flex items-center gap-x-1.5 text-sm text-muted-foreground hover:text-blue-600" do %>
      <svg class="flex-shrink-0 size-4" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg>
      Back to Guest Directory
    <% end %>
  </div>

  <%= render PanelsUI::PageHeader.new(
        title: "Add New Guest Profile",
        description: "Create a permanent guest record to track their history across stays.",
        class: "mb-8") %>

  <%= render "form", guest: @guest %>
</div>
