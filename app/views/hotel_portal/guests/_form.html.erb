<%= form_with(model: [current_hotel, guest], local: true, class: "space-y-8", data: { controller: "guest-dob tin-validation",
                        tin_validation_url_value: hotel_validate_tin_path(current_hotel) }) do |f| %>
  <% if guest.errors.any? %>
    <div class="rounded-xl bg-red-50 p-4 border border-red-100">
      <div class="flex">
        <div class="flex-shrink-0">
          <svg class="h-5 w-5 text-red-400" viewBox="0 0 20 20" fill="currentColor">
            <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd" />
          </svg>
        </div>
        <div class="ml-3">
          <h3 class="text-sm font-bold text-red-800">
            <%= pluralize(guest.errors.count, "error") %> prohibited this guest from being saved:
          </h3>
          <div class="mt-2 text-sm text-red-700">
            <ul class="list-disc pl-5 space-y-1">
              <% guest.errors.full_messages.each do |message| %>
                <li><%= message %></li>
              <% end %>
            </ul>
          </div>
        </div>
      </div>
    </div>
  <% end %>

  <div class="overflow-hidden rounded-2xl border border-border bg-card shadow-sm">
    <div class="border-b border-border bg-muted/70 px-6 py-5 sm:px-8">
      <h2 class="text-lg font-bold tracking-tight text-foreground">Basic Information</h2>
      <p class="mt-1 text-sm font-medium text-muted-foreground">Primary identity and contact details.</p>
    </div>
    <div class="p-6 sm:p-8 space-y-6">
      <div>
        <%= f.label :name, "Full Name", class: "block text-[11px] font-bold text-muted-foreground uppercase tracking-wider mb-2" %>
        <%= f.text_field :name, required: true, placeholder: "e.g. John Doe", class: "w-full rounded-xl border border-border bg-card px-4 py-2.5 text-sm font-medium text-foreground focus:border-border-interactive focus:outline-none focus:ring-0 shadow-sm" %>
      </div>

      <div class="grid sm:grid-cols-2 gap-6">
        <div>
          <%= f.label :email, "Email Address", class: "block text-[11px] font-bold text-muted-foreground uppercase tracking-wider mb-2" %>
          <%= f.email_field :email, placeholder: "e.g. john@example.com", class: "w-full rounded-xl border border-border bg-card px-4 py-2.5 text-sm font-medium text-foreground focus:border-border-interactive focus:outline-none focus:ring-0 shadow-sm" %>
        </div>
        <div>
          <%= f.label :phone, "Phone Number", class: "block text-[11px] font-bold text-muted-foreground uppercase tracking-wider mb-2" %>
          <%= f.telephone_field :phone, placeholder: "e.g. +60 12 345 6789", class: "w-full rounded-xl border border-border bg-card px-4 py-2.5 text-sm font-medium text-foreground focus:border-border-interactive focus:outline-none focus:ring-0 shadow-sm" %>
        </div>
      </div>

      <div>
        <%= f.label :home_address, "Address", class: "block text-[11px] font-bold text-muted-foreground uppercase tracking-wider mb-2" %>
        <%= f.text_area :home_address, rows: 2, placeholder: "e.g. No. 12, Jalan Ampang", class: "w-full rounded-xl border border-border bg-card px-4 py-2.5 text-sm font-medium text-foreground focus:border-border-interactive focus:outline-none focus:ring-0 shadow-sm" %>
      </div>

      <div class="grid sm:grid-cols-2 gap-6">
        <div>
          <%= f.label :city, "City", class: "block text-[11px] font-bold text-muted-foreground uppercase tracking-wider mb-2" %>
          <%= f.text_field :city, placeholder: "e.g. Kota Kinabalu", class: "w-full rounded-xl border border-border bg-card px-4 py-2.5 text-sm font-medium text-foreground focus:border-border-interactive focus:outline-none focus:ring-0 shadow-sm" %>
        </div>

        <div>
          <%= f.label :state_code, "State", class: "block text-[11px] font-bold text-muted-foreground uppercase tracking-wider mb-2" %>
          <%= f.select :state_code,
                EInvoice::MalaysiaStates.options,
                { include_blank: "Select state" },
                class: "w-full rounded-xl border border-border bg-card px-4 py-2.5 text-sm font-medium text-foreground focus:border-border-interactive focus:outline-none focus:ring-0 shadow-sm" %>
        </div>

        <div>
          <%= f.label :postal_code, "Postcode", class: "block text-[11px] font-bold text-muted-foreground uppercase tracking-wider mb-2" %>
          <%= f.text_field :postal_code, placeholder: "e.g. 88000", inputmode: "numeric", class: "w-full rounded-xl border border-border bg-card px-4 py-2.5 text-sm font-medium text-foreground focus:border-border-interactive focus:outline-none focus:ring-0 shadow-sm" %>
        </div>

        <div>
          <%= f.label :tin, "Tax identification number", class: "block text-[11px] font-bold text-muted-foreground uppercase tracking-wider mb-2" %>
          <%= f.text_field :tin, placeholder: "Only if the guest claims their stays", class: "w-full rounded-xl border border-border bg-card px-4 py-2.5 text-sm font-medium text-foreground focus:border-border-interactive focus:outline-none focus:ring-0 shadow-sm", data: { tin_validation_target: "tin", action: "blur->tin-validation#check" } %>
          <%# Checked against LHDN here so a wrong digit is caught now, not when
              the e-invoice is rejected days later. %>
          <p data-tin-validation-target="feedback" class="mt-1 text-xs text-muted-foreground" hidden></p>
        </div>

        <div>
          <%= f.label :country, "Country", class: "block text-[11px] font-bold text-muted-foreground uppercase tracking-wider mb-2" %>
          <%= f.text_field :country, required: true, placeholder: "e.g. Malaysia", class: "w-full rounded-xl border border-border bg-card px-4 py-2.5 text-sm font-medium text-foreground focus:border-border-interactive focus:outline-none focus:ring-0 shadow-sm", data: { guest_dob_target: "country", action: "input->guest-dob#autofill" } %>
        </div>
        <div>
          <%= f.label :gender, "Gender", class: "block text-[11px] font-bold text-muted-foreground uppercase tracking-wider mb-2" %>
          <%= f.select :gender, Guest::GENDERS.map { |g| [g.capitalize, g] }, { include_blank: "Select Gender" }, class: "w-full rounded-xl border border-border bg-card px-4 py-2.5 text-sm font-medium text-foreground focus:border-border-interactive focus:outline-none focus:ring-0 shadow-sm" %>
        </div>
      </div>
    </div>
  </div>

  <div class="overflow-hidden rounded-2xl border border-border bg-card shadow-sm">
    <div class="border-b border-border bg-muted/70 px-6 py-5 sm:px-8">
      <h2 class="text-lg font-bold tracking-tight text-foreground">Identity Verification</h2>
      <p class="mt-1 text-sm font-medium text-muted-foreground">Legal identification details.</p>
    </div>
    <div class="p-6 sm:p-8 space-y-6">
      <div class="grid sm:grid-cols-2 gap-6">
        <div>
          <%= f.label :document_type, "Document Type", class: "block text-[11px] font-bold text-muted-foreground uppercase tracking-wider mb-2" %>
          <%= f.select :document_type, Guest::DOCUMENT_TYPES.map { |dt| [dt.upcase, dt] }, { include_blank: "Select Document Type" }, class: "w-full rounded-xl border border-border bg-card px-4 py-2.5 text-sm font-medium text-foreground focus:border-border-interactive focus:outline-none focus:ring-0 shadow-sm", data: { guest_dob_target: "documentType", tin_validation_target: "documentType", action: "change->guest-dob#autofill change->tin-validation#check" } %>
        </div>
        <div>
          <%= f.label :government_id, "ID / Passport Number", class: "block text-[11px] font-bold text-muted-foreground uppercase tracking-wider mb-2" %>
          <%= f.text_field :government_id, placeholder: "Enter ID number", class: "w-full rounded-xl border border-border bg-card px-4 py-2.5 text-sm font-medium text-foreground focus:border-border-interactive focus:outline-none focus:ring-0 shadow-sm", data: { guest_dob_target: "governmentId", tin_validation_target: "idValue", action: "input->guest-dob#autofill blur->tin-validation#check" } %>
        </div>
      </div>

      <div class="grid sm:grid-cols-2 gap-6">
        <div>
          <%= f.label :date_of_birth, "Date of Birth", class: "block text-[11px] font-bold text-muted-foreground uppercase tracking-wider mb-2" %>
          <%= f.date_field :date_of_birth, class: "w-full rounded-xl border border-border bg-card px-4 py-2.5 text-sm font-medium text-foreground focus:border-border-interactive focus:outline-none focus:ring-0 shadow-sm", data: { guest_dob_target: "dateOfBirth" } %>
        </div>
      </div>
    </div>
  </div>

  <div class="flex items-center justify-end gap-x-4">
    <%= link_to "Cancel", hotel_guests_path(current_hotel), class: "px-6 py-3 text-sm font-bold text-muted-foreground hover:bg-muted rounded-xl transition" %>
    <%= f.submit (guest.new_record? ? "Create Guest Profile" : "Save Changes"), class: "inline-flex items-center rounded-xl bg-primary px-8 py-3 text-sm font-bold text-primary-foreground shadow-sm transition hover:bg-primary-hover" %>
  </div>
<% end %>
