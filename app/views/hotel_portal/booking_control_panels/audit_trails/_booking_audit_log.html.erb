<% history = local_assigns[:audit_history] || audit_logs.map { |log| HotelPortal::BookingAuditLogPresenter.new(log, hotel: current_hotel) } %>
<section data-controller="booking-history-filter" aria-labelledby="audit-history-heading">
  <header class="border-b border-border px-5 py-4">
    <div class="flex flex-wrap items-start justify-between gap-3">
      <div><p class="text-xs font-semibold text-muted-foreground">Booking No. <%= presenter.group_overview? ? presenter.group_booking_number : presenter.booking_number %></p><h2 id="audit-history-heading" class="mt-1 text-base font-semibold text-foreground"><%= presenter.group_overview? ? "Group Audit Trail" : "Audit Trail" %></h2><p class="mt-1 text-sm text-muted-foreground">Important booking, stay, room, and financial changes.</p></div>
      <div class="flex items-center gap-2">
        <p class="text-sm font-semibold tabular-nums text-muted-foreground"><span data-booking-history-filter-target="filteredCount"><%= history.size %></span> of <%= pluralize(history.size, "event") %></p>
        <% if local_assigns[:closeable] %><button type="button" class="rounded-md p-2 text-muted-foreground transition hover:bg-muted hover:text-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring" data-action="click->offcanvas#close" aria-label="Close audit trail"><%= app_icon "x", class: "size-4", aria: { hidden: true } %></button><% end %>
      </div>
    </div>
    <% if history.any? %><div class="mt-4 flex flex-wrap gap-2" aria-label="Filter audit trail"><% [["All", "all"], ["Status", "status"], ["Stay & Guest", "stay"], ["Rooms", "room"], ["Financial", "financial"], ["Notes", "notes"]].each do |label, category| %><button type="button" data-booking-history-filter-target="filter" data-action="booking-history-filter#filter" data-category="<%= category %>" data-active="<%= category == 'all' %>" aria-pressed="<%= category == 'all' %>" class="rounded-md border border-border-interactive bg-card px-3 py-1.5 text-xs font-semibold text-muted-foreground hover:bg-muted focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring data-[active=true]:border-border-interactive data-[active=true]:bg-primary data-[active=true]:text-primary-foreground"><%= label %></button><% end %></div><% end %>
  </header>

  <% if history.any? %>
    <div class="divide-y divide-border">
      <% history.each do |event| %>
        <article class="grid gap-3 px-5 py-4 md:grid-cols-[10rem_minmax(0,1fr)]" data-booking-history-filter-target="event" data-category="<%= event.category %>">
          <div><time class="text-xs font-semibold text-muted-foreground" datetime="<%= event.log.occurred_at&.iso8601 || event.log.created_at.iso8601 %>"><%= event.occurred_at_label %></time><p class="mt-1 text-xs text-muted-foreground">By <span class="font-semibold text-foreground"><%= event.actor_name %></span></p></div>
          <div class="min-w-0"><h3 class="text-sm font-semibold text-foreground"><%= event.title %></h3><p class="mt-1 break-words text-sm text-foreground"><%= event.summary %></p>
            <% if event.context_details.any? %><dl class="mt-3 grid gap-2 border-l-2 border-border-interactive pl-3 text-xs sm:grid-cols-2"><% event.context_details.each do |label, value| %><div><dt class="font-semibold text-muted-foreground"><%= label %></dt><dd class="mt-0.5 text-foreground"><%= value %></dd></div><% end %></dl><% end %>
            <% if event.formatted_changes.any? %><details class="mt-3"><summary class="cursor-pointer text-xs font-semibold text-primary focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring">View Changes</summary><table class="mt-2 w-full text-xs"><tbody class="divide-y divide-border"><% event.formatted_changes.each do |change| %><tr><th scope="row" class="w-36 py-2 text-left font-semibold text-muted-foreground"><%= change[:field] %></th><td class="py-2 text-foreground"><span class="line-through text-muted-foreground"><%= change[:old] %></span> → <strong><%= change[:new] %></strong></td></tr><% end %></tbody></table></details><% end %>
          </div>
        </article>
      <% end %>
    </div>
    <div class="hidden px-5 py-10 text-center text-sm text-muted-foreground" data-booking-history-filter-target="filteredEmpty">No events match this filter.</div>
  <% else %>
    <div class="px-5 py-12 text-center"><p class="font-semibold text-foreground">No audit history recorded.</p><p class="mt-1 text-sm text-muted-foreground">Important booking activity will appear here.</p></div>
  <% end %>
</section>
