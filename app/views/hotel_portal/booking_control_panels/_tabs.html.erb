<div class="shrink-0 border-b border-border bg-card px-2">
  <nav class="flex items-center overflow-x-auto overscroll-x-contain" aria-label="Booking control panel tabs">
    <% presenter.tabs.each do |tab| %>
      <% active = tab.key == presenter.active_tab %>
      <%= link_to presenter.tab_path(tab.key), class: "inline-flex h-12 shrink-0 items-center whitespace-nowrap border-b-2 px-4 text-sm transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-inset focus-visible:ring-blue-600 #{active ? "border-border-interactive font-bold text-foreground" : "border-transparent font-semibold text-muted-foreground hover:border-border-interactive hover:text-foreground"}", aria: { current: active ? "page" : nil } do %>
        <span><%= tab.label %></span>
      <% end %>
    <% end %>
  </nav>
</div>
