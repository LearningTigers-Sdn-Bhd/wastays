<div class="shrink-0 border-b border-border bg-card px-2">
  <%= render PanelsUI::Tabs.new(
        id: "booking-control-tabs",
        default: presenter.active_tab,
        variant: :underline,
        navigation: true,
        breadcrumb_id: "hotel-breadcrumb",
        aria_label: "Booking control panel tabs"
      ) do |tabs| %>
    <% presenter.tabs.each do |tab| %>
      <% tabs.with_tab(
           name: tab.key,
           label: tab.label,
           href: presenter.tab_path(tab.key),
           data: { turbo_frame: "booking_control_panel_workspace", turbo_action: "advance" }
         ) %>
    <% end %>
  <% end %>
</div>
