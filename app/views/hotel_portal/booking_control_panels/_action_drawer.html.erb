<section class="min-h-full bg-card" data-testid="control-panel-action-drawer">
  <div class="flex items-start gap-3 border-b border-border px-4 py-4">
    <div class="min-w-0 flex-1">
      <p class="text-xs font-semibold text-muted-foreground">Booking No. <%= presenter.booking_number %></p>
      <h2 class="mt-1 text-base font-bold text-foreground"><%= presenter.drawer.to_s.tr("_", " ").titleize %></h2>
    </div>
    <%= link_to presenter.close_drawer_path, class: "rounded-md p-2 text-muted-foreground hover:bg-muted hover:text-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-600", aria: { label: "Close editor" } do %>
      <%= cached_icon "x", class: "size-4" %>
    <% end %>
  </div>
  <div class="p-4">
    <%= render "hotel_portal/booking_control_panels/drawers/#{presenter.drawer}", booking: booking, presenter: presenter, folio_show: folio_show %>
  </div>
</section>
