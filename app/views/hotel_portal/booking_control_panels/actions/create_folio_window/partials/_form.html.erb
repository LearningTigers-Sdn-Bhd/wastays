<% grouped_context = booking.group_booking_id.present? %>
<% selected_option = folio_booking_options.find { |option| option[:booking].id == booking.id } || folio_booking_options.first %>
<% has_any_party = folio_booking_options.any? { |option| option[:parties].any? } %>

<%= form_with url: create_folio_window_hotel_booking_control_panel_path(current_hotel, booking), method: :post, local: true, class: "mx-auto flex h-full max-w-[1000px] flex-col", data: { controller: "folio-window-booking" } do |form| %>
  <div class="flex-1 space-y-6">
    <div>
      <p class="text-sm font-bold text-foreground">Create a folio window for a billing party on this booking.</p>
      <p class="mt-1 text-xs font-semibold text-muted-foreground">Creating a folio does not change transaction-code routing.</p>
    </div>

    <% if grouped_context %>
      <div>
        <label for="folio_window_booking_id" class="mb-2 block text-[11px] font-bold uppercase tracking-wider text-muted-foreground">Booking</label>
        <%= select_tag "folio_window[booking_id]",
          options_for_select(folio_booking_options.map { |option| [option[:label], option[:booking].id] }, selected_option[:booking].id),
          id: "folio_window_booking_id",
          required: true,
          class: "w-full rounded-xl border border-border bg-card px-4 py-2.5 text-sm text-foreground shadow-sm focus:border-border-interactive focus:outline-none focus:ring-0",
          data: { folio_window_booking_target: "booking", action: "change->folio-window-booking#change" } %>
        <p class="mt-2 text-xs font-semibold text-muted-foreground">The new folio belongs only to the selected child booking.</p>
      </div>
    <% end %>

    <div>
      <label for="folio_window_booking_billing_party_id" class="mb-2 block text-[11px] font-bold uppercase tracking-wider text-muted-foreground">Sharer / Billing party</label>
      <select id="folio_window_booking_billing_party_id" name="folio_window[booking_billing_party_id]" required class="w-full rounded-xl border border-border bg-card px-4 py-2.5 text-sm text-foreground shadow-sm focus:border-border-interactive focus:outline-none focus:ring-0" data-folio-window-booking-target="party">
        <option value="">Select billing party</option>
        <% selected_option[:parties].each do |party| %>
          <option value="<%= party.id %>"><%= party.display_name %> · <%= party.party_kind.humanize %></option>
        <% end %>
      </select>
      <% unless has_any_party %>
        <p class="mt-2 text-xs font-semibold text-amber-700">Add a guest or company billing party before creating a folio window.</p>
      <% end %>
    </div>

    <div hidden>
      <% folio_booking_options.each do |option| %>
        <template data-folio-window-booking-target="template" data-booking-id="<%= option[:booking].id %>">
          <option value="">Select billing party</option>
          <% option[:parties].each do |party| %>
            <option value="<%= party.id %>"><%= party.display_name %> · <%= party.party_kind.humanize %></option>
          <% end %>
        </template>
      <% end %>
    </div>

    <div>
      <label for="folio_window_name" class="mb-2 block text-[11px] font-bold uppercase tracking-wider text-muted-foreground">Folio name</label>
      <%= text_field_tag "folio_window[name]", nil, id: "folio_window_name", placeholder: "Incidentals Folio", class: "w-full rounded-xl border border-border px-4 py-2.5 text-sm text-foreground shadow-sm placeholder:text-muted-foreground focus:border-border-interactive focus:outline-none focus:ring-0" %>
    </div>

    <div>
      <label for="folio_window_currency" class="mb-2 block text-[11px] font-bold uppercase tracking-wider text-muted-foreground">Currency</label>
      <%= select_tag "folio_window[currency]",
        options_for_select(CurrencyCatalog.codes, booking.currency.presence || current_hotel.default_currency),
        id: "folio_window_currency",
        class: "w-full rounded-xl border border-border bg-card px-4 py-2.5 text-sm text-foreground shadow-sm focus:border-border-interactive focus:outline-none focus:ring-0" %>
    </div>

    <div>
      <label for="folio_window_reason" class="mb-2 block text-[11px] font-bold uppercase tracking-wider text-muted-foreground">Reason</label>
      <%= text_field_tag "folio_window[reason]", nil, id: "folio_window_reason", placeholder: "Optional internal reason", class: "w-full rounded-xl border border-border px-4 py-2.5 text-sm text-foreground shadow-sm placeholder:text-muted-foreground focus:border-border-interactive focus:outline-none focus:ring-0" %>
    </div>
  </div>

  <%= render "hotel_portal/shared/offcanvas/content_footer",
    show_full_page_link: false,
    submit_button: form.submit("Create folio", disabled: !has_any_party, class: "rounded-xl bg-primary px-6 py-2.5 text-sm font-bold text-primary-foreground shadow-sm transition-colors hover:bg-primary-hover disabled:cursor-not-allowed disabled:bg-muted disabled:text-muted-foreground") %>
<% end %>
