<% option_groups = presenter.folio_window_billing_party_option_groups %>

<%= form_with url: create_folio_window_hotel_booking_control_panel_path(current_hotel, booking), method: :post, local: true, class: "mx-auto flex h-full max-w-[1000px] flex-col" do |form| %>
  <div class="flex-1 space-y-6">
    <div>
      <p class="text-sm font-bold text-slate-900">Create a folio window for a billing party on this booking.</p>
      <p class="mt-1 text-xs font-semibold text-slate-500">Creating a folio does not change transaction-code routing.</p>
    </div>

    <div>
      <label for="folio_window_booking_billing_party_id" class="mb-2 block text-[11px] font-bold uppercase tracking-wider text-slate-500">Sharer / Billing party</label>
      <select id="folio_window_booking_billing_party_id" name="folio_window[booking_billing_party_id]" required class="w-full rounded-xl border border-slate-200 bg-white px-4 py-2.5 text-sm text-slate-700 shadow-sm focus:border-slate-300 focus:outline-none focus:ring-0">
        <option value="">Select billing party</option>
        <% option_groups.each do |group_label, options| %>
          <optgroup label="<%= group_label %>">
            <% options.each do |option| %>
              <%= render "hotel_portal/booking_control_panels/actions/create_folio_window/partials/billing_party_option", option: option %>
            <% end %>
          </optgroup>
        <% end %>
      </select>
      <% if option_groups.empty? %>
        <p class="mt-2 text-xs font-semibold text-amber-700">Add a guest or company billing party before creating a folio window.</p>
      <% end %>
    </div>

    <div>
      <label for="folio_window_name" class="mb-2 block text-[11px] font-bold uppercase tracking-wider text-slate-500">Folio name</label>
      <%= text_field_tag "folio_window[name]", nil, id: "folio_window_name", placeholder: "Incidentals Folio", class: "w-full rounded-xl border border-slate-200 px-4 py-2.5 text-sm text-slate-700 shadow-sm placeholder:text-slate-400 focus:border-slate-300 focus:outline-none focus:ring-0" %>
    </div>

    <div>
      <label for="folio_window_currency" class="mb-2 block text-[11px] font-bold uppercase tracking-wider text-slate-500">Currency</label>
      <%= select_tag "folio_window[currency]",
        options_for_select(CurrencyCatalog.codes, booking.currency.presence || current_hotel.default_currency),
        id: "folio_window_currency",
        class: "w-full rounded-xl border border-slate-200 bg-white px-4 py-2.5 text-sm text-slate-700 shadow-sm focus:border-slate-300 focus:outline-none focus:ring-0" %>
    </div>

    <div>
      <label for="folio_window_reason" class="mb-2 block text-[11px] font-bold uppercase tracking-wider text-slate-500">Reason</label>
      <%= text_field_tag "folio_window[reason]", nil, id: "folio_window_reason", placeholder: "Optional internal reason", class: "w-full rounded-xl border border-slate-200 px-4 py-2.5 text-sm text-slate-700 shadow-sm placeholder:text-slate-400 focus:border-slate-300 focus:outline-none focus:ring-0" %>
    </div>
  </div>

  <%= render "hotel_portal/bookings/board/partials/content_footer",
    show_full_page_link: false,
    submit_button: form.submit("Create folio", disabled: option_groups.empty?, class: "rounded-xl bg-slate-900 px-6 py-2.5 text-sm font-bold text-white shadow-sm transition-colors hover:bg-slate-700 disabled:cursor-not-allowed disabled:bg-slate-300") %>
<% end %>
