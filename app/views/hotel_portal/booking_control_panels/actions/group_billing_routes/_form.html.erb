<%= form_with url: preview_group_billing_routes_hotel_booking_control_panel_path(current_hotel, @booking), method: :post,
  class: "flex min-h-0 flex-1 flex-col", data: { turbo_frame: "offcanvas_drawer" } do %>
  <%= hidden_field_tag :idempotency_key, @group_batch_key %>
  <div class="min-h-0 flex-1 space-y-6 overflow-y-auto p-6">
    <div><%= label_tag :group_billing_arrangement_id, "Billing arrangement", class: "mb-1 block text-xs font-bold text-slate-600" %><%= select_tag :group_billing_arrangement_id, options_from_collection_for_select(@group_arrangements, :id, :name, @group_draft&.dig("group_billing_arrangement_id")), include_blank: "Select arrangement", required: true, class: "w-full rounded-md border-slate-300 text-sm" %></div>
    <fieldset><legend class="text-xs font-bold text-slate-600">Child bookings</legend><div class="mt-2 grid gap-2 sm:grid-cols-2"><% @group_children.each do |child| %><label class="flex gap-2 rounded-md border border-slate-200 p-3 text-sm"><%= check_box_tag "booking_ids[]", child.id, Array(@group_draft&.dig("booking_ids")).map(&:to_s).include?(child.id.to_s) %><span><strong>Booking No. <%= child.formatted_reservation_number.presence || "—" %></strong><span class="block text-xs text-slate-500"><%= child.guest_name %></span></span></label><% end %></div></fieldset>
    <fieldset><legend class="text-xs font-bold text-slate-600">Coverage</legend><div class="mt-2 grid gap-2 sm:grid-cols-2"><% GroupBillingChanges::Batch::CATEGORIES.each do |category| %><label class="flex gap-2 rounded-md border border-slate-200 p-3 text-sm"><%= check_box_tag "charge_categories[]", category, Array(@group_draft&.dig("charge_categories")).include?(category) %><%= category == "fb" ? "Food & Beverage" : category.humanize %></label><% end %></div></fieldset>
    <fieldset><legend class="text-xs font-bold text-slate-600">Booking-local tax inclusions</legend><p class="mt-1 text-xs text-slate-500">Only explicit Include or Exclude selections are applied to selected children.</p><div class="mt-3 space-y-2"><% @group_codes.each do |code| %><% @group_tax_candidates.each do |child| %><div class="grid grid-cols-[1fr_12rem] items-center gap-3 rounded-md border border-slate-200 p-3 text-sm"><span><strong class="font-mono"><%= code.code %></strong> · <%= child.label %></span><%= select_tag "inclusion_changes[#{code.id}][#{child.key}]", options_for_select([["No change", ""], ["Include", "include"], ["Exclude", "exclude"]], @group_draft&.dig("inclusion_changes", code.id.to_s, child.key)), class: "rounded-md border-slate-300 text-sm" %></div><% end %><% end %></div></fieldset>
    <label class="flex gap-2 text-sm"><%= check_box_tag :replace_local_exceptions, "1", ActiveModel::Type::Boolean.new.cast(@group_draft&.dig("replace_local_exceptions")) %><span>Replace booking-local exceptions for selected categories.</span></label>
  </div>
  <div class="flex justify-end gap-3 border-t border-slate-200 bg-white px-6 py-4"><button type="button" data-action="offcanvas#close" class="rounded-md border border-slate-300 px-4 py-2 text-sm font-semibold">Cancel</button><%= submit_tag "Review changes", class: "rounded-md bg-slate-950 px-4 py-2 text-sm font-semibold text-white" %></div>
<% end %>
