<%= form_with url: apply_group_billing_routes_hotel_booking_control_panel_path(current_hotel, @booking), method: :post,
  class: "flex min-h-0 flex-1 flex-col", data: { turbo_frame: "offcanvas_drawer" } do %>
  <%= hidden_field_tag :idempotency_key, @group_draft["idempotency_key"] %><%= hidden_field_tag :freshness_token, @group_preview.freshness_token %>
  <%= hidden_field_tag :group_billing_arrangement_id, @group_draft["group_billing_arrangement_id"] %><%= hidden_field_tag :replace_local_exceptions, @group_draft["replace_local_exceptions"] %>
  <% Array(@group_draft["booking_ids"]).each { |id| concat hidden_field_tag("booking_ids[]", id) } %><% Array(@group_draft["charge_categories"]).each { |category| concat hidden_field_tag("charge_categories[]", category) } %>
  <% (@group_draft["inclusion_changes"] || {}).each do |code_id, changes| %><% changes.each do |key, value| %><%= hidden_field_tag "inclusion_changes[#{code_id}][#{key}]", value %><% end %><% end %>
  <div class="min-h-0 flex-1 overflow-y-auto p-6"><div class="rounded-lg border border-amber-200 bg-amber-50 p-4"><p class="text-xs font-bold uppercase text-amber-700">Combined impact</p><p class="mt-1 text-xl font-black"><%= @group_preview.count %> posted transactions · <%= number_to_currency(@group_preview.amount, unit: "#{current_hotel.default_currency} ") %></p><p class="mt-1 text-sm"><%= @group_preview.upcoming_count %> upcoming forecasts · <%= number_to_currency(@group_preview.upcoming_amount, unit: "#{current_hotel.default_currency} ") %></p></div>
    <table class="mt-5 w-full text-left text-sm"><thead><tr class="border-b text-xs uppercase text-slate-500"><th class="py-2">Booking</th><th>Target folio</th><th class="text-right">Posted</th><th class="text-right">Upcoming</th></tr></thead><tbody class="divide-y"><% @group_preview.bookings.each do |row| %><tr><td class="py-3 font-semibold"><%= row[:booking].confirmation_token %></td><td><%= row[:target_folio]&.display_name || "Will create/resolve on apply" %></td><td class="text-right"><%= row[:count] %></td><td class="text-right"><%= row[:upcoming_count] %></td></tr><% end %></tbody></table>
    <% if @group_preview.skipped_exceptions.any? %><p class="mt-4 rounded-md border border-blue-200 bg-blue-50 p-3 text-sm text-blue-900"><%= pluralize(@group_preview.skipped_exceptions.size, "booking-local exception") %> will be preserved.</p><% end %>
    <div class="mt-6 space-y-3"><label class="flex gap-3 rounded-md border p-3 text-sm"><%= radio_button_tag :confirmation, "existing_and_future", true %><span><strong>Existing eligible and future</strong></span></label><label class="flex gap-3 rounded-md border p-3 text-sm"><%= radio_button_tag :confirmation, "future_only", false %><span><strong>Future only</strong></span></label><% if @group_preview.upcoming_count.positive? %><label class="flex gap-3 rounded-md border p-3 text-sm"><%= radio_button_tag :forecast_confirmation, "reconcile_upcoming", true %><span>Reconcile upcoming forecasts</span></label><label class="flex gap-3 rounded-md border p-3 text-sm"><%= radio_button_tag :forecast_confirmation, "leave_upcoming", false %><span>Leave upcoming forecasts</span></label><% end %><div><%= label_tag :reason, "Reason", class: "mb-1 block text-xs font-bold text-slate-600" %><%= text_field_tag :reason, nil, required: true, class: "w-full rounded-md border-slate-300 text-sm" %></div></div>
  </div><div class="flex justify-end gap-3 border-t border-slate-200 bg-white px-6 py-4"><%= link_to "Back", group_billing_routes_hotel_booking_control_panel_path(current_hotel, @booking), data: { turbo_frame: "offcanvas_drawer" }, class: "rounded-md border border-slate-300 px-4 py-2 text-sm font-semibold" %><%= submit_tag "Confirm and apply", class: "rounded-md bg-slate-950 px-4 py-2 text-sm font-semibold text-white" %></div>
<% end %>
