<%= turbo_frame_tag "offcanvas_drawer", data: { offcanvas_variant: "fullscreen-bottom" } do %>
  <% group_number = @group.formatted_reservation_number.presence || "—" %>
  <div class="flex h-full min-h-0 flex-col bg-card">
    <%= render "hotel_portal/bookings/board/partials/content_header",
      title: "Change Group Billing Routes",
      subtitle: "Group No. #{group_number} · #{@group_bookings.size} bookings · Billing Preferences",
      icon: cached_icon("route", stroke_width: 2.5, class: "size-5") %>

    <% if flash.now[:alert].present? %>
      <div class="border-b border-rose-200 bg-rose-50 px-6 py-3 text-sm font-semibold text-rose-800"><%= flash.now[:alert] %></div>
    <% end %>

    <% if @group_batch_preview&.success? && @group_batch_preview.review_required? %>
      <%= render "hotel_portal/booking_control_panels/actions/group_billing_routes/impact_review" %>
    <% else %>
      <%= render "hotel_portal/booking_control_panels/actions/group_billing_routes/selector" %>
    <% end %>
  </div>
<% end %>
