<%= turbo_frame_tag "offcanvas_drawer", data: { offcanvas_variant: "right" } do %>
  <div class="flex h-full min-h-0 flex-col bg-white">
    <%= render "hotel_portal/bookings/board/partials/content_header",
      title: "Change Billing Routes",
      subtitle: "#{@booking.confirmation_token} · Billing Preferences",
      icon: cached_icon("route", stroke_width: 2.5, class: "size-5") %>

    <% if flash.now[:alert].present? %>
      <div class="border-b border-rose-200 bg-rose-50 px-6 py-3 text-sm font-semibold text-rose-800"><%= flash.now[:alert] %></div>
    <% end %>

    <% if @batch_preview&.success? && @batch_preview.review_required? %>
      <%= render "hotel_portal/booking_control_panels/actions/billing_routes/impact_review" %>
    <% else %>
      <%= render "hotel_portal/booking_control_panels/actions/billing_routes/form" %>
    <% end %>
  </div>
<% end %>
