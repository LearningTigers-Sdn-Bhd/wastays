<%= turbo_frame_tag "offcanvas_drawer", data: { offcanvas_variant: "right" } do %>
  <% booking_number = @routing_booking.formatted_reservation_number.presence || "—" %>
  <div class="flex h-full min-h-0 flex-col bg-card">
    <%= render "hotel_portal/shared/offcanvas/content_header",
      title: "Change Billing Routes",
      subtitle: "Booking No. #{booking_number} · Billing Preferences",
      icon: cached_icon("route", stroke_width: 2.5, class: "size-5") %>

    <% if flash.now[:alert].present? %>
      <div class="border-b border-rose-200 bg-rose-50 px-6 py-3 text-sm font-semibold text-rose-800"><%= flash.now[:alert] %></div>
    <% end %>

    <% if @routing_booking_options.any? %>
      <div class="border-b border-border bg-muted px-6 py-4">
        <%= form_with url: billing_routes_hotel_booking_control_panel_path(current_hotel, @booking), method: :get,
          data: { turbo_frame: "offcanvas_drawer" }, class: "max-w-xl" do %>
          <%= label_tag :route_booking_id, "Booking", class: "mb-1 block text-xs font-bold uppercase tracking-wider text-muted-foreground" %>
          <%= select_tag :route_booking_id,
            options_from_collection_for_select(@routing_booking_options, :id, ->(child) { "Booking No. #{child.formatted_reservation_number.presence || '—'} · #{child.guest_name}" }, @routing_booking.id),
            class: "w-full rounded-md border-border-interactive bg-card text-sm font-semibold text-foreground",
            onchange: "this.form.requestSubmit()" %>
        <% end %>
      </div>
    <% end %>

    <% if @batch_preview&.success? && @batch_preview.review_required? %>
      <%= render "hotel_portal/booking_control_panels/actions/billing_routes/impact_review" %>
    <% else %>
      <%= render "hotel_portal/booking_control_panels/actions/billing_routes/form" %>
    <% end %>
  </div>
<% end %>
