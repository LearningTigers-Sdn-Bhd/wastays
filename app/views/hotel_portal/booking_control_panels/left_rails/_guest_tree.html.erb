<% if current_user.has_permission?("manage_bookings", hotel: current_hotel) && booking.status.in?(%w[confirmed checked_in]) %>
  <div class="border-b border-border px-4 py-3">
    <%= link_to hotel_booking_action_manage_guest_path(current_hotel, booking, mode: "add", return_to: presenter.close_drawer_path),
        data: { turbo_frame: "booking_action_sheet" },
        class: "inline-flex w-full items-center justify-center rounded-md bg-primary px-3 py-2 text-sm font-semibold text-primary-foreground hover:bg-primary-hover focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-600" do %>
      + Add Guest
    <% end %>
  </div>
<% end %>

<%= render "hotel_portal/booking_control_panels/left_rails/booking_entity_tree",
    booking: booking,
    presenter: presenter,
    groups: presenter.guest_tree_groups,
    aria_label: "Booking guests",
    empty_label: "No guests available.",
    single_booking: true %>
