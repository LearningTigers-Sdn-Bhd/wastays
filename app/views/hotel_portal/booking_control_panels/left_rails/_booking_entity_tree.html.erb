<nav aria-label="<%= aria_label %>" data-controller="booking-entity-tree" data-booking-entity-tree-scope-value="<%= aria_label %>">
  <% navigation_data = presenter.group_context_enabled? ? { turbo_frame: "_top", turbo_action: "advance" } : { turbo_frame: "booking_control_panel_workspace", turbo_action: "advance" } %>
  <% if local_assigns[:overview_path].present? %>
    <%= link_to overview_path,
        data: navigation_data,
        class: "flex items-center justify-between gap-3 border-b border-slate-200 px-4 py-3 text-sm font-semibold focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-inset focus-visible:ring-blue-600 #{presenter.group_overview? ? 'bg-slate-900 text-white' : 'text-slate-700 hover:bg-slate-100'}" do %>
      <span><%= overview_label %></span>
      <%= cached_icon "chevron-right", class: "size-4 shrink-0 opacity-70", aria: { hidden: true } %>
    <% end %>
  <% end %>

  <div class="divide-y divide-slate-200">
    <% groups.each_with_index do |group, index| %>
      <details class="group" data-booking-entity-tree-target="group" data-group-key="<%= index %>" data-action="toggle->booking-entity-tree#remember" <%= "open" if local_assigns.fetch(:single_booking, false) || presenter.booking_tree_group_open?(group) %>>
        <summary class="flex cursor-pointer list-none items-center justify-between gap-3 px-4 py-3 text-sm font-semibold text-slate-800 transition-colors hover:bg-slate-100 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-inset focus-visible:ring-blue-600 group-open:bg-slate-100 [&::-webkit-details-marker]:hidden">
          <span class="min-w-0">
            <span class="flex min-w-0 items-center gap-2">
              <% if presenter.group_context_enabled? && (badge = presenter.status_badge_for_tree_group(group)) %>
                <span class="inline-flex shrink-0 rounded-md border px-1.5 py-0.5 text-[9px] font-black uppercase tracking-wide <%= status_badge_classes(badge[:tone]) %>"><%= badge[:label] %></span>
              <% end %>
              <span class="truncate"><%= group.label %></span>
            </span>
            <span class="mt-0.5 block truncate text-xs font-normal text-slate-500"><%= group.description %></span>
          </span>
          <%= cached_icon "chevron-right", class: "size-4 shrink-0 text-slate-500 transition-transform duration-150 group-open:rotate-90" %>
        </summary>

        <div class="py-2">
          <% group.rows.each do |row| %>
            <%= link_to row.href,
                data: navigation_data,
                class: "mx-2 block rounded-md px-3 py-2 text-sm focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-600 #{row.active ? 'bg-slate-900 text-white' : 'text-slate-700 hover:bg-slate-100'}" do %>
              <span class="block truncate font-semibold"><%= row.label %></span>
              <span class="block truncate text-xs font-normal opacity-70"><%= row.description %></span>
            <% end %>
          <% end %>

          <% if group.rows.empty? %>
            <p class="px-4 py-2 text-xs font-semibold text-slate-400"><%= empty_label %></p>
          <% end %>
        </div>
      </details>
    <% end %>
  </div>
</nav>
