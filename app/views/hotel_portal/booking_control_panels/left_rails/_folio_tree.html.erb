<% if presenter.can_manage_folio_windows? && !presenter.group_overview? %>
  <div class="border-b border-slate-200 px-4 py-3">
    <%= link_to new_folio_window_hotel_booking_control_panel_path(current_hotel, booking),
        data: { turbo_frame: "offcanvas_drawer", offcanvas_variant: "right" },
        class: "inline-flex w-full items-center justify-center rounded-md bg-slate-950 px-3 py-2 text-sm font-semibold text-white hover:bg-slate-800 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-600" do %>
      + Add Folio
    <% end %>
  </div>
<% end %>

<%= render "hotel_portal/booking_control_panels/left_rails/booking_entity_tree",
    booking: booking,
    presenter: presenter,
    groups: [HotelPortal::BookingControlPanelPresenter::TreeGroup.new(booking.confirmation_token, presenter.booking_context_description, presenter.folio_tree_rows)],
    aria_label: "Booking folios",
    empty_label: "No folios available.",
    single_booking: true %>
