<nav aria-label="<%= aria_label %>">
  <% if local_assigns[:overview_path].present? %>
    <%= link_to overview_path,
        data: { turbo_frame: "booking_control_panel_workspace", turbo_action: "advance" },
        class: "flex items-center justify-between gap-3 border-b border-slate-200 px-4 py-3 text-sm font-semibold focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-inset focus-visible:ring-blue-600 #{presenter.group_overview? ? 'bg-slate-900 text-white' : 'text-slate-700 hover:bg-slate-100'}" do %>
      <span>Overview</span>
      <%= cached_icon "chevron-right", class: "size-4 shrink-0 opacity-70", aria: { hidden: true } %>
    <% end %>
  <% end %>

  <% rows.each do |row| %>
    <%= link_to row.href,
        data: { turbo_frame: "booking_control_panel_workspace", turbo_action: "advance" },
        class: "flex items-center justify-between gap-3 border-b border-slate-200 px-4 py-3 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-inset focus-visible:ring-blue-600 #{row.active ? 'bg-slate-900 text-white' : 'text-slate-700 hover:bg-slate-100'}" do %>
      <span class="min-w-0">
        <span class="block truncate text-sm font-bold"><%= row.label %></span>
        <span class="mt-0.5 block truncate text-xs opacity-70"><%= row.description %></span>
      </span>
      <%= cached_icon "chevron-right", class: "size-4 shrink-0 opacity-70", aria: { hidden: true } %>
    <% end %>
  <% end %>
</nav>
