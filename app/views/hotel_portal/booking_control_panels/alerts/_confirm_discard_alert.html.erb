<dialog class="fixed inset-0 z-[130] m-auto w-[min(92vw,30rem)] rounded-xl border border-slate-200 bg-white p-0 shadow-lg backdrop:bg-slate-950/45"
        role="alertdialog"
        aria-modal="true"
        aria-labelledby="confirm-discard-alert-title"
        aria-describedby="confirm-discard-alert-description"
        data-controller="confirm-discard"
        data-action="guest-details:confirm-discard@document->confirm-discard#open click->confirm-discard#closeOnBackdrop">
  <div class="border-b border-slate-200 px-5 py-4">
    <p class="text-xs font-semibold text-amber-700">Unsaved guest details</p>
    <h2 id="confirm-discard-alert-title" class="mt-1 text-lg font-bold text-slate-950">Discard your changes?</h2>
  </div>

  <div class="px-5 py-5">
    <p id="confirm-discard-alert-description" class="text-sm leading-6 text-slate-600">The changes made to this guest have not been saved. Discard them and continue?</p>
  </div>

  <div class="flex flex-col-reverse gap-2 border-t border-slate-200 px-5 py-4 sm:flex-row sm:justify-end">
    <button type="button" class="rounded-md border border-slate-300 bg-white px-4 py-2.5 text-sm font-semibold text-slate-700 hover:bg-slate-50 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-600" data-action="confirm-discard#keepEditing">Keep Editing</button>
    <button type="button" class="rounded-md bg-red-600 px-4 py-2.5 text-sm font-semibold text-white hover:bg-red-700 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-red-600" data-action="confirm-discard#discard">Discard Changes</button>
  </div>
</dialog>
