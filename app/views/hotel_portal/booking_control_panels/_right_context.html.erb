<section class="rounded-xl border border-slate-200 bg-white p-4 shadow-sm">
  <h2 class="text-sm font-black uppercase tracking-[0.18em] text-slate-600"><%= presenter.active_tab_label %></h2>
  <dl class="mt-4 space-y-3 text-sm">
    <div>
      <dt class="text-[11px] font-black uppercase tracking-wider text-slate-500">Booking</dt>
      <dd class="mt-1 font-bold text-slate-950"><%= presenter.booking_number %></dd>
    </div>
    <div>
      <dt class="text-[11px] font-black uppercase tracking-wider text-slate-500">Active Folio</dt>
      <dd class="mt-1 font-bold text-slate-950"><%= presenter.selected_folio&.display_name || "No folio" %></dd>
    </div>
    <div>
      <dt class="text-[11px] font-black uppercase tracking-wider text-slate-500">Total Balance</dt>
      <dd class="mt-1 font-bold text-slate-950"><%= presenter.money(presenter.total_balance) %></dd>
    </div>
  </dl>
</section>
