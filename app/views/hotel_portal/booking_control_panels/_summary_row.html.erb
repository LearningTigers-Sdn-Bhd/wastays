<section class="mt-4 overflow-hidden rounded-xl border border-slate-200 bg-white shadow-sm" aria-label="Booking summary">
  <div class="flex flex-col gap-4 border-b border-slate-200 px-4 py-4 lg:flex-row lg:items-center lg:justify-between">
    <div class="flex min-w-0 items-center gap-3">
      <%= link_to hotel_bookings_path(current_hotel), class: "inline-flex size-9 shrink-0 items-center justify-center rounded-lg border border-slate-200 text-slate-600 hover:bg-slate-50", aria: { label: "Back to bookings" } do %>
        <%= cached_icon "arrow-left", class: "size-4" %>
      <% end %>
      <div class="min-w-0">
        <div class="flex flex-wrap items-center gap-2">
          <h1 class="truncate text-lg font-black tracking-tight text-slate-950"><%= presenter.summary_heading %></h1>
          <% if presenter.group_booking? %>
            <span class="rounded-md border border-blue-200 bg-blue-50 px-2 py-0.5 text-[10px] font-black uppercase tracking-wider text-blue-700">Group</span>
          <% end %>
          <span class="rounded-md border border-amber-200 bg-amber-50 px-2 py-0.5 text-[10px] font-black uppercase tracking-wider text-amber-700"><%= presenter.status_label %></span>
        </div>
        <p class="mt-0.5 text-xs font-semibold text-slate-500"><%= presenter.summary_subtitle %></p>
      </div>
    </div>

    <% return_to = request.fullpath %>
    <div class="flex flex-wrap items-center gap-2">
      <% if current_user.has_permission?("manage_bookings", hotel: current_hotel) %>
        <% if booking.status == "confirmed" %>
          <%= link_to "Check-in", hotel_booking_transaction_check_in_reservation_path(current_hotel, booking, return_to: return_to), data: { turbo_frame: "offcanvas_drawer", offcanvas_variant: "right" }, class: "rounded-lg bg-slate-950 px-4 py-2 text-sm font-bold text-white shadow-sm transition hover:bg-slate-700" %>
          <%= link_to "Cancel", hotel_booking_transaction_cancel_booking_path(current_hotel, booking, return_to: return_to), data: { turbo_frame: "offcanvas_drawer", offcanvas_variant: "right" }, class: "rounded-lg border border-red-200 bg-white px-4 py-2 text-sm font-bold text-red-700 shadow-sm transition hover:bg-red-50" %>
        <% elsif booking.status == "review_no_show" %>
          <%= link_to "Backdated Check-in", hotel_booking_transaction_booking_backdated_check_in_path(current_hotel, booking, return_to: return_to), data: { turbo_frame: "offcanvas_drawer", offcanvas_variant: "right" }, class: "rounded-lg bg-slate-950 px-4 py-2 text-sm font-bold text-white shadow-sm transition hover:bg-slate-700" %>
          <%= link_to "Mark No-show", hotel_booking_transaction_mark_no_show_path(current_hotel, booking, return_to: return_to), data: { turbo_frame: "offcanvas_drawer", offcanvas_variant: "right" }, class: "rounded-lg border border-rose-200 bg-white px-4 py-2 text-sm font-bold text-rose-700 shadow-sm transition hover:bg-rose-50" %>
          <%= link_to "Cancel", hotel_booking_transaction_cancel_booking_path(current_hotel, booking, return_to: return_to), data: { turbo_frame: "offcanvas_drawer", offcanvas_variant: "right" }, class: "rounded-lg border border-red-200 bg-white px-4 py-2 text-sm font-bold text-red-700 shadow-sm transition hover:bg-red-50" %>
        <% elsif booking.status == "no_show" %>
          <%= link_to "Reinstate", hotel_booking_transaction_reinstate_no_show_path(current_hotel, booking, return_to: return_to), data: { turbo_frame: "offcanvas_drawer", offcanvas_variant: "right" }, class: "rounded-lg bg-blue-600 px-4 py-2 text-sm font-bold text-white shadow-sm transition hover:bg-blue-700" %>
          <% if current_user.has_permission?("post_folio_corrections", hotel: current_hotel) && Bookings::RepairNoShowTourismTax.needed?(booking) %>
            <%= link_to "Repair No-show Folio", hotel_booking_transaction_repair_no_show_folio_path(current_hotel, booking, return_to: return_to), data: { turbo_frame: "offcanvas_drawer", offcanvas_variant: "right" }, class: "rounded-lg border border-amber-200 bg-white px-4 py-2 text-sm font-bold text-amber-700 shadow-sm transition hover:bg-amber-50" %>
          <% end %>
        <% elsif booking.status == "checked_in" %>
          <%= link_to "Check-out", hotel_booking_transaction_check_out_path(current_hotel, booking, return_to: return_to), data: { turbo_frame: "offcanvas_drawer", offcanvas_variant: "fullscreen-bottom" }, class: "rounded-lg bg-slate-950 px-4 py-2 text-sm font-bold text-white shadow-sm transition hover:bg-slate-700" %>
          <%= link_to "Edit Check-In", hotel_booking_transaction_check_in_reservation_path(current_hotel, booking, return_to: return_to), data: { turbo_frame: "offcanvas_drawer", offcanvas_variant: "right" }, class: "rounded-lg border border-slate-200 bg-white px-4 py-2 text-sm font-bold text-slate-700 shadow-sm transition hover:bg-slate-50" %>
        <% elsif booking.status == "review_due_out" %>
          <%= link_to "Review Late Checkout", hotel_booking_transaction_late_checkout_path(current_hotel, booking, return_to: return_to), data: { turbo_frame: "offcanvas_drawer", offcanvas_variant: "right" }, class: "rounded-lg bg-amber-600 px-4 py-2 text-sm font-bold text-white shadow-sm transition hover:bg-amber-700" %>
        <% elsif booking.status == "checkout_required" %>
          <%= link_to "Complete Checkout", hotel_booking_transaction_check_out_path(current_hotel, booking, return_to: return_to), data: { turbo_frame: "offcanvas_drawer", offcanvas_variant: "fullscreen-bottom" }, class: "rounded-lg bg-slate-950 px-4 py-2 text-sm font-bold text-white shadow-sm transition hover:bg-slate-700" %>
        <% end %>
      <% end %>
    </div>
  </div>

  <div class="grid gap-px bg-slate-200 sm:grid-cols-2 xl:grid-cols-6">
    <% presenter.summary_items.each do |label, value| %>
      <div class="bg-white px-4 py-3">
        <p class="text-[10px] font-black uppercase tracking-wider text-slate-500"><%= label %></p>
        <p class="mt-1 truncate text-sm font-bold text-slate-950"><%= value %></p>
      </div>
    <% end %>
  </div>
</section>
