<section class="mt-4 overflow-hidden rounded-xl border border-border bg-card shadow-sm" aria-label="Booking summary">
  <div class="flex flex-col gap-4 border-b border-border px-4 py-4 lg:flex-row lg:items-center lg:justify-between">
    <div class="flex min-w-0 items-center gap-3">
      <%= link_to hotel_front_desk_path(current_hotel, tab: "bookings", view: "list"), class: "inline-flex size-9 shrink-0 items-center justify-center rounded-lg border border-border text-muted-foreground hover:bg-muted", aria: { label: "Back to Reservations" } do %>
        <%= cached_icon "arrow-left", class: "size-4" %>
      <% end %>
      <div class="min-w-0">
        <div class="flex flex-wrap items-center gap-2">
          <h1 class="truncate text-lg font-black tracking-tight text-foreground"><%= presenter.summary_heading %></h1>
          <% if presenter.group_booking? %>
            <span class="rounded-md border border-blue-200 bg-blue-50 px-2 py-0.5 text-[10px] font-black uppercase tracking-wider text-blue-700">Group</span>
          <% end %>
        </div>
        <p class="mt-0.5 text-xs font-semibold text-muted-foreground"><%= presenter.summary_subtitle %></p>
      </div>
    </div>

    <% return_to = request.fullpath %>
    <div class="flex flex-wrap items-center gap-2">
      <% if current_user.has_permission?("manage_bookings", hotel: current_hotel) %>
        <% summary_actions = presenter.summary_actions %>
        <% repair_no_show_available = !presenter.group_context_enabled? && booking.status == "no_show" && current_user.has_permission?("post_folio_corrections", hotel: current_hotel) && Bookings::RepairNoShowTourismTax.needed?(booking) %>
        <% if summary_actions.any? || repair_no_show_available %>
          <div class="relative inline-flex" data-controller="dropdown" data-dropdown-floating="true" data-dropdown-align="end">
            <button type="button" class="inline-flex items-center gap-2 rounded-lg bg-primary px-4 py-2 text-sm font-bold text-primary-foreground shadow-sm transition hover:bg-primary-hover focus-visible:outline-none" aria-label="Booking actions" aria-expanded="false" aria-haspopup="menu" data-dropdown-target="button" data-action="click->dropdown#toggle keydown->dropdown#handleKeydown">
              Actions
              <%= cached_icon "chevron-down", class: "size-4", aria: { hidden: true } %>
            </button>
            <div data-dropdown-target="menu" class="hidden w-56 rounded-lg border border-border bg-card p-1.5 shadow-lg" role="menu" tabindex="-1">
              <% summary_actions.each do |summary_action| %>
                <% action_booking = summary_action.target_booking %>
                <% action_path = case summary_action.key
                  when :check_in, :edit_check_in then hotel_booking_action_check_in_path(current_hotel, action_booking, return_to: return_to)
                  when :cancel then hotel_booking_action_cancel_booking_path(current_hotel, action_booking, return_to: return_to)
                  when :backdated_check_in then hotel_booking_transaction_booking_backdated_check_in_path(current_hotel, action_booking, return_to: return_to)
                  when :mark_no_show then hotel_booking_transaction_mark_no_show_path(current_hotel, action_booking, return_to: return_to)
                  when :check_out then hotel_booking_transaction_check_out_path(current_hotel, action_booking, return_to: return_to)
                  when :undo_check_in then hotel_booking_transaction_undo_check_in_path(current_hotel, action_booking, return_to: return_to)
                  when :late_checkout then hotel_booking_transaction_late_checkout_path(current_hotel, action_booking, return_to: return_to)
                  when :reinstate then hotel_booking_transaction_reinstate_no_show_path(current_hotel, action_booking, return_to: return_to)
                  end %>
                <% action_class = case summary_action.tone
                  when :danger then "text-rose-700 hover:bg-rose-50 focus-visible:bg-rose-50"
                  when :warning then "text-amber-700 hover:bg-amber-50 focus-visible:bg-amber-50"
                  else "text-foreground hover:bg-muted focus-visible:bg-muted"
                  end %>
                <% action_data = summary_action.key.in?([:cancel, :check_in, :edit_check_in]) ? { turbo_frame: "booking_action_sheet" } : { turbo_frame: "offcanvas_drawer", offcanvas_variant: summary_action.offcanvas_variant } %>
                <%= link_to action_path, role: "menuitem", data: action_data, class: "flex items-center gap-2 rounded-md px-3 py-2 text-sm font-semibold focus-visible:outline-none #{action_class}" do %>
                  <%= cached_icon summary_action.icon, class: "size-4 shrink-0", aria: { hidden: true } %>
                  <span><%= summary_action.label %></span>
                <% end %>
              <% end %>
              <% if repair_no_show_available %>
                <%= link_to hotel_booking_transaction_repair_no_show_folio_path(current_hotel, booking, return_to: return_to), role: "menuitem", data: { turbo_frame: "offcanvas_drawer", offcanvas_variant: "right" }, class: "flex items-center gap-2 rounded-md px-3 py-2 text-sm font-semibold text-amber-700 hover:bg-amber-50 focus-visible:outline-none focus-visible:bg-amber-50" do %>
                  <%= cached_icon "wrench", class: "size-4 shrink-0", aria: { hidden: true } %>
                  <span>Repair No-show Folio</span>
                <% end %>
              <% end %>
            </div>
          </div>
        <% end %>
      <% end %>
    </div>
  </div>

  <div class="grid gap-px bg-muted sm:grid-cols-2 xl:grid-cols-6">
    <% presenter.summary_items.each do |label, value| %>
      <div class="bg-card px-4 py-3">
        <p class="text-[10px] font-black uppercase tracking-wider text-muted-foreground"><%= label %></p>
        <p class="mt-1 truncate text-sm font-bold text-foreground"><%= value %></p>
      </div>
    <% end %>
  </div>
</section>
