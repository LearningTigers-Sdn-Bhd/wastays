<% requests_booking = presenter.requests_booking %>

<section class="flex h-full min-h-0 flex-col">
  <div class="shrink-0 border-b border-slate-200 px-5 py-4">
    <p class="text-xs font-semibold text-slate-500"><%= presenter.group_overview? ? presenter.group_booking.reference : requests_booking.confirmation_token %></p>
    <h2 class="mt-1 text-lg font-bold text-slate-950">Requests</h2>
    <p class="mt-1 text-sm text-slate-500"><%= presenter.group_overview? ? "Requests and complaints across the group. Select a booking to update a request." : "Room requests and complaints for this booking." %></p>
  </div>

  <div class="grid min-h-0 flex-1 divide-y divide-slate-200 bg-slate-50 xl:grid-cols-3 xl:divide-x xl:divide-y-0">
    <% presenter.requests_kanban_columns.each do |column| %>
      <div class="flex min-h-64 flex-col bg-white xl:min-h-0">
        <div class="flex items-center justify-between border-b border-slate-200 px-4 py-3">
          <h3 class="text-xs font-black uppercase tracking-[0.18em] text-slate-600"><%= column.label %></h3>
          <span class="rounded-full bg-slate-100 px-2 py-0.5 text-xs font-black text-slate-600"><%= column.cards.size %></span>
        </div>

        <div class="min-h-0 flex-1 space-y-3 p-4">
          <% if column.cards.any? %>
            <% column.cards.each do |card| %>
              <% complaint = card.type == "complaint" %>
              <article class="rounded-md border p-3 <%= complaint ? "border-amber-200 bg-amber-50/70" : "border-slate-200 bg-white" %>">
                <div class="flex items-start justify-between gap-3">
                  <div class="min-w-0">
                    <span class="inline-flex items-center rounded-full px-2 py-0.5 text-[10px] font-black uppercase tracking-wider <%= complaint ? "bg-amber-100 text-amber-800" : "bg-blue-100 text-blue-800" %>"><%= card.title %></span>
                    <p class="mt-2 text-sm font-bold leading-5 text-slate-950"><%= card.details %></p>
                    <p class="mt-1 text-xs font-semibold text-slate-500"><%= card.room_label %> · <%= card.time_label %></p>
                  </div>
                  <span class="shrink-0 text-slate-400"><%= cached_icon(complaint ? "triangle-alert" : "sparkles", class: "size-4") %></span>
                </div>

                <div class="mt-3 flex items-center justify-between gap-3">
                  <span class="text-[10px] font-black uppercase tracking-wider text-slate-500"><%= card.status.to_s.humanize %></span>
                  <% if presenter.group_overview? %>
                    <span class="text-xs font-semibold text-slate-500">Select Booking to Update</span>
                  <% elsif card.completed %>
                    <span class="rounded-lg border border-slate-200 bg-white px-2.5 py-1 text-[10px] font-black uppercase tracking-wider text-slate-500">Read-only</span>
                  <% elsif complaint %>
                    <%= button_to "Resolve", resolve_complaint_request_hotel_booking_control_panel_path(current_hotel, requests_booking, complaint_request_id: card.id), method: :post, class: "rounded-lg bg-slate-950 px-3 py-1.5 text-xs font-bold text-white" %>
                  <% else %>
                    <%= button_to "Complete", complete_housekeeping_request_hotel_booking_control_panel_path(current_hotel, requests_booking, housekeeping_request_id: card.id), method: :post, class: "rounded-lg bg-slate-950 px-3 py-1.5 text-xs font-bold text-white" %>
                  <% end %>
                </div>
              </article>
            <% end %>
          <% else %>
            <p class="px-2 py-8 text-center text-sm font-semibold text-slate-400">No requests.</p>
          <% end %>
        </div>
      </div>
    <% end %>
  </div>
</section>
