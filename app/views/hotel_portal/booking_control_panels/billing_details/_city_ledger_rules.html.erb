<% folio_origin = local_assigns[:folio_origin] %>
<% active_folio_id = folio_show.active_folio_id %>

<section data-controller="billing-instructions">
  <div class="flex flex-col gap-3 border-b border-slate-200 p-4 sm:flex-row sm:items-center sm:justify-between">
    <div class="min-w-0">
      <h2 class="text-sm font-bold text-slate-950">Billing Instructions</h2>
      <p class="mt-1 text-sm font-medium text-slate-500">Rules decide which folio receives future charges for this booking.</p>
    </div>

    <% if folio_show.can_manage_billing_instructions? %>
      <%= link_to new_routing_rule_hotel_folio_path(hotel, booking, origin: folio_origin, tab: "billing_instructions", active_folio_id: active_folio_id),
          class: "inline-flex items-center justify-center gap-1.5 rounded-md bg-slate-900 px-3 py-2 text-xs font-semibold text-white hover:bg-slate-700 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-600",
          data: { turbo_frame: "offcanvas_drawer", offcanvas_variant: "right" } do %>
        <%= cached_icon "plus", class: "size-3" %>
        Add Rule
      <% end %>
    <% end %>
  </div>

  <div class="overflow-x-auto">
    <table class="w-full min-w-[760px] table-fixed text-left text-xs">
      <thead class="bg-slate-50 text-[10px] font-semibold uppercase tracking-wider text-slate-500">
        <tr class="border-b border-slate-200">
          <th class="w-24 px-4 py-2">Code</th>
          <th class="px-4 py-2">Charge / Category</th>
          <th class="w-52 px-4 py-2">Target Folio</th>
          <th class="w-24 px-4 py-2">Status</th>
          <th class="w-28 px-4 py-2 text-right">Action</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-slate-100">
        <% if folio_show.billing_instruction_rows.any? %>
          <% folio_show.billing_instruction_rows.each do |row| %>
            <%= render "hotel_portal/booking_control_panels/billing_details/billing_instruction_row",
              row: row,
              row_kind: :rule,
              hotel: hotel,
              booking: booking,
              folio_origin: folio_origin,
              active_folio_id: active_folio_id %>
          <% end %>
        <% else %>
          <tr>
            <td colspan="5" class="px-4 py-8 text-center text-sm font-medium text-slate-500">No custom billing instructions yet.</td>
          </tr>
        <% end %>

        <tr class="border-y border-slate-200 bg-slate-50">
          <td colspan="5" class="px-4 py-2 text-[11px] font-black uppercase tracking-wider text-slate-500">Defaults</td>
        </tr>

        <% folio_show.default_billing_instruction_rows.each do |row| %>
          <%= render "hotel_portal/booking_control_panels/billing_details/billing_instruction_row",
            row: row,
            row_kind: :default,
            hotel: hotel,
            booking: booking,
            folio_origin: folio_origin,
            active_folio_id: active_folio_id %>
        <% end %>
      </tbody>
    </table>
  </div>
</section>
