<% active_folio = presenter.selected_folio %>
<% if active_folio %>
  <section aria-labelledby="folio-operations-heading">
    <header class="border-b border-border px-5 py-4">
      <div class="flex flex-col gap-3 sm:flex-row sm:items-start sm:justify-between">
        <div><p class="text-xs font-semibold text-muted-foreground">Booking No. <%= presenter.booking_number %></p><h2 id="folio-operations-heading" class="mt-1 text-lg font-bold text-foreground"><%= active_folio.display_name %></h2><p class="mt-1 text-sm text-muted-foreground"><%= active_folio.status.humanize %> · <%= active_folio.payer_display_label %> · <span class="font-semibold tabular-nums text-foreground"><%= presenter.money(active_folio.projected_outstanding_balance) %></span></p></div>
        <%= render "hotel_portal/booking_control_panels/folio_operations/window_actions", booking: booking, folio: active_folio, folio_show: folio_show %>
      </div>
      <div class="mt-4"><%= render "hotel_portal/booking_control_panels/folio_operations/folio_actions", booking: booking, hotel: current_hotel, folio_show: folio_show, redirect_to_folio: true, folio_origin: "booking_control_panel" %></div>
    </header>

    <% if active_folio.group_deposit_allocations.any? %><div class="border-b border-emerald-200 bg-emerald-50 px-5 py-3 text-sm text-emerald-900"><strong>Group Deposit Allocation:</strong> <%= active_folio.group_deposit_allocations.map { |allocation| "##{allocation.group_deposit_id} · #{presenter.money(allocation.amount)}" }.to_sentence %></div><% end %>

    <div class="px-5 pb-5"><%= render "hotel_portal/folios/show/page_ledger", folio_show: folio_show, booking: booking, hotel: current_hotel, folio_origin: "booking_control_panel" %></div>
  </section>
  <%= render "hotel_portal/booking_control_panels/folio_operations/window_dialogs", booking: booking, folio: active_folio, folio_show: folio_show %>
<% else %>
  <div class="px-5 py-12 text-center"><p class="font-semibold text-foreground">No folios are available.</p><p class="mt-1 text-sm text-muted-foreground">Create a folio before posting charges or payments.</p></div>
<% end %>
