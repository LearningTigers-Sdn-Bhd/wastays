<% if presenter.group_overview? %>
  <section aria-labelledby="folio-operations-heading">
    <header class="border-b border-slate-200 px-5 py-4"><p class="text-xs font-semibold text-slate-500"><%= presenter.group_booking.reference %></p><h2 id="folio-operations-heading" class="mt-1 text-lg font-bold text-slate-950">Group Statement</h2><p class="mt-1 text-sm text-slate-600">A presentation of child folios. Each ledger remains attached to its booking.</p></header>
    <div class="overflow-x-auto"><table class="w-full min-w-[880px] text-left text-sm"><thead class="border-b border-slate-200 bg-slate-50 text-xs font-semibold text-slate-600"><tr><th class="px-5 py-3">Booking</th><th class="px-5 py-3">Guest</th><th class="px-5 py-3">Folio</th><th class="px-5 py-3">Payer</th><th class="px-5 py-3">Status</th><th class="px-5 py-3 text-right">Balance</th></tr></thead><tbody class="divide-y divide-slate-200">
      <% presenter.child_bookings.each do |child| %><% child.booking_folios.each do |folio| %><tr><td class="px-5 py-3 font-semibold text-slate-950"><%= child.confirmation_token %></td><td class="px-5 py-3 text-slate-700"><%= child.booking_guests.find(&:primary?)&.guest&.name.presence || child.guest_name %></td><td class="px-5 py-3 text-slate-700"><%= folio.display_name %></td><td class="px-5 py-3 text-slate-700"><%= folio.payer_display_label %></td><td class="px-5 py-3 text-slate-700"><%= folio.status.humanize %></td><td class="px-5 py-3 text-right font-semibold tabular-nums text-slate-950"><%= presenter.money_for(child, folio.projected_outstanding_balance) %></td></tr><% end %><% end %>
    </tbody><tfoot class="border-t border-slate-300 bg-slate-50"><tr><th colspan="5" class="px-5 py-3 text-right font-semibold text-slate-700">Group Outstanding Balance</th><td class="px-5 py-3 text-right font-bold tabular-nums text-slate-950"><%= presenter.money(presenter.group_total_balance) %></td></tr></tfoot></table></div>

    <section class="border-t border-slate-200" aria-labelledby="group-deposits-heading"><h3 id="group-deposits-heading" class="border-b border-slate-200 px-5 py-3 text-sm font-bold text-slate-950">Group Deposits</h3><div class="overflow-x-auto"><table class="w-full min-w-[720px] text-left text-sm"><thead class="border-b border-slate-200 bg-slate-50 text-xs font-semibold text-slate-600"><tr><th class="px-5 py-3">Reference</th><th class="px-5 py-3">Received</th><th class="px-5 py-3">Method</th><th class="px-5 py-3">Status</th><th class="px-5 py-3 text-right">Amount</th><th class="px-5 py-3 text-right">Available</th></tr></thead><tbody class="divide-y divide-slate-200"><% if presenter.group_booking.group_deposits.any? %><% presenter.group_booking.group_deposits.each do |deposit| %><tr><td class="px-5 py-3 font-semibold text-slate-950"><%= deposit.external_reference.presence || "—" %></td><td class="px-5 py-3 text-slate-700"><%= presenter.time_label(deposit.received_at) %></td><td class="px-5 py-3 text-slate-700"><%= deposit.payment_method.humanize %></td><td class="px-5 py-3 text-slate-700"><%= deposit.status.humanize %></td><td class="px-5 py-3 text-right font-semibold tabular-nums text-slate-950"><%= presenter.money(deposit.amount) %></td><td class="px-5 py-3 text-right font-semibold tabular-nums text-slate-950"><%= presenter.money(deposit.available_amount) %></td></tr><% end %><% else %><tr><td colspan="6" class="px-5 py-10 text-center text-slate-500">No group deposits have been received.</td></tr><% end %></tbody></table></div></section>
  </section>
<% else %>
  <% active_folio = presenter.selected_folio %>
  <% if active_folio %>
    <section aria-labelledby="folio-operations-heading">
      <header class="border-b border-slate-200 px-5 py-4"><p class="text-xs font-semibold text-slate-500"><%= booking.confirmation_token %></p><h2 id="folio-operations-heading" class="mt-1 text-lg font-bold text-slate-950"><%= active_folio.display_name %></h2><p class="mt-1 text-sm text-slate-600"><%= active_folio.status.humanize %> · <%= active_folio.payer_display_label %> · <span class="font-semibold tabular-nums text-slate-950"><%= presenter.money(active_folio.projected_outstanding_balance) %></span></p><div class="mt-4"><%= render "hotel_portal/booking_control_panels/folio_operations/folio_actions", booking: booking, hotel: current_hotel, folio_show: folio_show, redirect_to_folio: true, folio_origin: "booking_control_panel" %></div></header>

      <% if active_folio.group_deposit_allocations.any? %><div class="border-b border-emerald-200 bg-emerald-50 px-5 py-3 text-sm text-emerald-900"><strong>Group Deposit Allocation:</strong> <%= active_folio.group_deposit_allocations.map { |allocation| "##{allocation.group_deposit_id} · #{presenter.money(allocation.amount)}" }.to_sentence %></div><% end %>

      <div class="px-5 pb-5"><%= render "hotel_portal/folios/show/page_ledger", folio_show: folio_show, booking: booking, hotel: current_hotel, folio_origin: "booking_control_panel" %></div>
    </section>
  <% else %>
    <div class="px-5 py-12 text-center"><p class="font-semibold text-slate-900">No folios are available.</p><p class="mt-1 text-sm text-slate-500">Create a folio before posting charges or payments.</p></div>
  <% end %>
<% end %>
