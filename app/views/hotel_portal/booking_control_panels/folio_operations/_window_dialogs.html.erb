<% if folio_show.can_manage_folio_windows? %>
  <% if folio.open? %>
    <% direct_bill_available = folio.payer_type == "company" && folio.hotel_corporate_account&.active? && folio.hotel_corporate_account&.direct_bill_enabled? && folio.outstanding_balance.to_d.positive? %>
    <dialog id="close-control-panel-folio-<%= folio.id %>" class="fixed inset-0 m-auto w-[min(92vw,30rem)] max-w-md rounded-2xl p-0 shadow-2xl backdrop:bg-slate-900/50" onclick="if(event.target===this){this.close()}">
      <div class="bg-white" onclick="event.stopPropagation()">
        <div class="border-b border-slate-100 px-6 py-5"><h3 class="text-lg font-bold text-slate-900">Close <%= folio.display_name %></h3><p class="mt-1 text-sm text-slate-500"><%= direct_bill_available ? "Close this folio as Direct Bill and create an AR invoice." : "Only settled folios with no pending charges can be closed." %></p></div>
        <%= form_with url: close_folio_window_hotel_booking_control_panel_path(current_hotel, booking, folio), method: :post, class: "space-y-4 p-6" do %>
          <%= hidden_field_tag "booking_folio[settlement_method]", "direct_bill" if direct_bill_available %>
          <div><%= label_tag "booking_folio_reason", "Reason", class: "mb-2 block text-xs font-bold uppercase tracking-wider text-slate-500" %><%= text_field_tag "booking_folio[reason]", nil, id: "booking_folio_reason", placeholder: "Optional internal reason", class: "w-full rounded-xl border border-slate-200 px-4 py-2.5 text-sm" %></div>
          <div class="flex justify-end gap-2"><button type="button" class="rounded-lg px-4 py-2 text-sm font-semibold text-slate-700" onclick="this.closest('dialog').close()">Cancel</button><%= submit_tag(direct_bill_available ? "Close as Direct Bill" : "Close Folio", class: "rounded-lg bg-slate-900 px-4 py-2 text-sm font-bold text-white") %></div>
        <% end %>
      </div>
    </dialog>
  <% elsif folio.closed? %>
    <dialog id="reopen-control-panel-folio-<%= folio.id %>" class="fixed inset-0 m-auto w-[min(92vw,30rem)] max-w-md rounded-2xl p-0 shadow-2xl backdrop:bg-slate-900/50" onclick="if(event.target===this){this.close()}">
      <div class="bg-white" onclick="event.stopPropagation()">
        <div class="border-b border-slate-100 px-6 py-5"><h3 class="text-lg font-bold text-slate-900">Reopen <%= folio.display_name %></h3></div>
        <%= form_with url: reopen_folio_window_hotel_booking_control_panel_path(current_hotel, booking, folio), method: :post, class: "space-y-4 p-6" do %>
          <div><%= label_tag "booking_folio_reopen_reason", "Reason", class: "mb-2 block text-xs font-bold uppercase tracking-wider text-slate-500" %><%= text_field_tag "booking_folio[reason]", nil, id: "booking_folio_reopen_reason", placeholder: "Optional internal reason", class: "w-full rounded-xl border border-slate-200 px-4 py-2.5 text-sm" %></div>
          <div class="flex justify-end gap-2"><button type="button" class="rounded-lg px-4 py-2 text-sm font-semibold text-slate-700" onclick="this.closest('dialog').close()">Cancel</button><%= submit_tag "Reopen Folio", class: "rounded-lg bg-slate-900 px-4 py-2 text-sm font-bold text-white" %></div>
        <% end %>
      </div>
    </dialog>
  <% end %>
<% end %>
