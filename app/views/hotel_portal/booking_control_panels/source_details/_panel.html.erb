<section aria-labelledby="source-details-heading">
  <header class="border-b border-slate-200 px-5 py-4"><p class="text-xs font-semibold text-slate-500">Booking No. <%= presenter.group_overview? ? presenter.group_booking_number : presenter.booking_number %></p><h2 id="source-details-heading" class="mt-1 text-lg font-bold text-slate-950">Source Details</h2><p class="mt-1 text-sm text-slate-600">Booking origin and external references.</p></header>

  <% if presenter.group_overview? %>
    <table class="w-full text-left text-sm"><tbody class="divide-y divide-slate-200"><% [["Group Source", presenter.group_booking.source.to_s.presence&.tr("_", " ")&.titleize], ["External Reference", presenter.group_booking.external_reference], ["Organizer", presenter.group_booking.organizer_guest&.name], ["Status", presenter.group_booking.projected_status.humanize]].each do |label, value| %><tr><th scope="row" class="w-56 bg-slate-50 px-5 py-3 font-semibold text-slate-600"><%= label %></th><td class="break-words px-5 py-3 font-semibold text-slate-950"><%= presenter.source_value(value) %></td></tr><% end %></tbody></table>
    <div class="overflow-x-auto"><table class="w-full min-w-[760px] text-left text-sm"><thead class="border-b border-slate-200 bg-slate-50 text-xs font-semibold text-slate-600"><tr><th class="px-5 py-3">Booking No.</th><th class="px-5 py-3">Guest</th><th class="px-5 py-3">Source</th><th class="px-5 py-3">External Reference</th><th class="px-5 py-3">Channel Manager</th></tr></thead><tbody class="divide-y divide-slate-200"><% if presenter.group_source_rows.any? %><% presenter.group_source_rows.each do |row| %><tr><td class="px-5 py-3 font-semibold text-slate-950"><%= row[:booking_number] %></td><td class="px-5 py-3 text-slate-700"><%= presenter.source_value(row[:guest]) %></td><td class="px-5 py-3 text-slate-700"><%= presenter.source_value(row[:source] == "Not available" ? nil : row[:source]) %></td><td class="px-5 py-3 text-slate-700"><%= presenter.source_value(row[:external_reference] == "—" ? nil : row[:external_reference]) %></td><td class="px-5 py-3 text-slate-700"><%= presenter.source_value(row[:channel_reference] == "—" ? nil : row[:channel_reference]) %></td></tr><% end %><% else %><tr><td colspan="5" class="px-5 py-8 text-center text-sm font-semibold text-slate-500">No booking source records are available for this group.</td></tr><% end %></tbody></table></div>
  <% else %>
    <table class="w-full text-left text-sm"><tbody class="divide-y divide-slate-200"><% [["Source", presenter.source_label == "Not available" ? nil : presenter.source_label], ["External Reference", booking.external_reference], ["Channel Manager", booking.channel_manager_reference]].each do |label, value| %><tr><th scope="row" class="w-56 bg-slate-50 px-5 py-3 font-semibold text-slate-600"><%= label %></th><td class="break-words px-5 py-3 font-semibold text-slate-950"><%= presenter.source_value(value) %></td></tr><% end %></tbody></table>
  <% end %>
</section>
