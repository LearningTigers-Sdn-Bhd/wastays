<% notes = booking.booking_notes.sort_by(&:created_at).reverse %>
<% can_manage = current_user.has_permission?("manage_bookings", hotel: current_hotel) %>
<% return_to = hotel_booking_control_panel_path(current_hotel, booking, tab: "booking_details") %>

<section id="booking_internal_notes" class="border-t border-border px-5 py-5" aria-labelledby="internal-notes-heading">
  <div class="flex flex-wrap items-start justify-between gap-3">
    <div>
      <h2 id="internal-notes-heading" class="text-base font-semibold text-foreground">Internal notes</h2>
      <p class="mt-1 text-xs text-muted-foreground">Visible only to hotel staff.</p>
    </div>
    <% if can_manage %>
      <%= render PanelsUI::Button.new(
            href: hotel_booking_action_internal_notes_path(current_hotel, booking, mode: "add", return_to: return_to),
            variant: :secondary,
            size: :sm,
            data: { turbo_frame: "booking_action_sheet" }) do %>
        <%= app_icon "plus", class: "size-4", aria: { hidden: true } %>
        <span>Add note</span>
      <% end %>
    <% end %>
  </div>

  <% if notes.any? %>
    <div class="mt-4 divide-y divide-border border-y border-border">
      <% notes.each do |note| %>
        <article class="py-4">
          <div class="flex flex-wrap items-start justify-between gap-3">
            <div>
              <p class="text-sm font-medium text-foreground"><%= note.user.name %></p>
              <p class="mt-1 text-xs text-muted-foreground"><%= note.created_at.in_time_zone(current_hotel.hotel_time_zone).strftime("%d %b %Y, %I:%M %p") %></p>
            </div>
            <% if can_manage %>
              <div class="flex flex-wrap items-center gap-2">
                <% if Array(note.edit_history).any? %>
                  <%= render PanelsUI::Button.new(
                        href: hotel_booking_action_internal_notes_path(current_hotel, booking, mode: "history", note_id: note.id, return_to: return_to),
                        variant: :ghost,
                        size: :xs,
                        data: { turbo_frame: "booking_action_sheet" }) do %>History<% end %>
                <% end %>
                <%= render PanelsUI::Button.new(
                      href: hotel_booking_action_internal_notes_path(current_hotel, booking, mode: "edit", note_id: note.id, return_to: return_to),
                      variant: :secondary,
                      size: :xs,
                      data: { turbo_frame: "booking_action_sheet" }) do %>Edit<% end %>
                <%= render PanelsUI::Button.new(
                      href: hotel_booking_action_delete_internal_note_path(current_hotel, booking, note, return_to: return_to),
                      variant: :destructive,
                      size: :xs,
                      data: { turbo_frame: "booking_action_sheet" }) do %>Delete<% end %>
              </div>
            <% end %>
          </div>
          <p class="mt-3 whitespace-pre-wrap text-sm text-foreground"><%= note.body %></p>
        </article>
      <% end %>
    </div>
  <% else %>
    <p class="mt-4 text-sm text-muted-foreground">No internal notes for this booking.</p>
  <% end %>
</section>
