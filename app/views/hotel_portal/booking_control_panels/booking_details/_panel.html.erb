<% if presenter.group_overview? %>
  <section aria-labelledby="group-booking-details-heading">
    <header class="flex flex-col gap-3 border-b border-slate-200 px-5 py-4 sm:flex-row sm:items-start sm:justify-between">
      <div>
        <p class="text-xs font-semibold text-slate-500">Booking No. <%= presenter.group_booking_number %></p>
        <h2 id="group-booking-details-heading" class="mt-1 text-lg font-bold text-slate-950"><%= presenter.group_booking.name %></h2>
        <p class="mt-1 text-sm text-slate-600"><%= pluralize(presenter.child_bookings.size, "booking") %> from <%= presenter.time_label(presenter.group_arrival) %> to <%= presenter.time_label(presenter.group_departure) %>.</p>
      </div>
      <div class="flex shrink-0 items-center gap-2">
        <span class="inline-flex self-start rounded-md bg-slate-100 px-2.5 py-1 text-xs font-semibold text-slate-700"><%= presenter.group_booking.projected_status.humanize %></span>
        <% if current_user.has_permission?("manage_bookings", hotel: current_hotel) %>
          <%= link_to "Edit Stay", hotel_booking_transaction_amend_stay_path(current_hotel, booking), data: { turbo_frame: "offcanvas_drawer", offcanvas_variant: "right" }, class: "rounded-md border border-slate-300 bg-white px-3 py-2 text-sm font-semibold text-slate-700 hover:bg-slate-50 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-600" %>
        <% end %>
      </div>
    </header>

    <% group_identifier_rows = [
      ["Confirmation", presenter.group_booking.confirmation_token.presence || "—"],
      ["Booking No.", presenter.group_booking.formatted_reservation_number.presence || "—"],
      ["Receipt No.", presenter.group_booking.formatted_receipt_number.presence || "—"],
      ["External Reference", presenter.group_booking.external_reference.presence || "—"],
      ["Organizer", presenter.group_booking.organizer_guest&.name.presence || "—"]
    ] %>
    <section class="grid border-b border-slate-200 md:grid-cols-[12rem_minmax(0,1fr)]" aria-labelledby="group-identifiers-heading">
      <h3 id="group-identifiers-heading" class="bg-slate-50 px-5 py-4 text-xs font-bold uppercase tracking-wider text-slate-600">Identifiers</h3>
      <dl class="grid sm:grid-cols-2 lg:grid-cols-3">
        <% group_identifier_rows.each do |label, value| %>
          <div class="border-t border-slate-200 px-5 py-3 first:border-t-0 sm:odd:border-r sm:[&:nth-child(2)]:border-t-0 lg:[&:nth-child(3)]:border-t-0 lg:[&:nth-child(3n)]:border-r-0 lg:odd:border-r">
            <dt class="text-xs font-semibold text-slate-500"><%= label %></dt>
            <dd class="mt-1 break-words text-sm font-semibold text-slate-950"><%= value %></dd>
          </div>
        <% end %>
      </dl>
    </section>

    <div class="overflow-x-auto">
      <table class="w-full min-w-[880px] text-left text-sm">
        <thead class="border-b border-slate-200 bg-slate-50 text-xs font-semibold text-slate-600">
          <tr><th class="px-5 py-3">Booking No.</th><th class="px-5 py-3">Guest</th><th class="px-5 py-3">Room</th><th class="px-5 py-3">Stay</th><th class="px-5 py-3">Status</th><th class="px-5 py-3 text-right">Balance</th></tr>
        </thead>
        <tbody class="divide-y divide-slate-200">
          <% presenter.group_room_rows.each do |row| %>
            <tr>
              <td class="px-5 py-3 font-semibold text-slate-950"><%= row[:booking_number] %></td>
              <td class="px-5 py-3 text-slate-700"><%= row[:guest] %></td>
              <td class="px-5 py-3 text-slate-700"><%= row[:room] %> · <%= row[:room_type] %></td>
              <td class="px-5 py-3 whitespace-nowrap text-slate-700"><%= row[:stay] %></td>
              <td class="px-5 py-3 text-slate-700"><%= row[:status] %></td>
              <td class="px-5 py-3 text-right font-semibold tabular-nums text-slate-950"><%= presenter.money_for(row[:booking], row[:booking].booking_folios.sum { |folio| folio.projected_outstanding_balance.to_d }) %></td>
            </tr>
          <% end %>
        </tbody>
        <tfoot class="border-t border-slate-300 bg-slate-50">
          <tr><th colspan="5" class="px-5 py-3 text-right text-sm font-semibold text-slate-700">Group Outstanding Balance</th><td class="px-5 py-3 text-right font-bold tabular-nums text-slate-950"><%= presenter.money(presenter.group_total_balance) %></td></tr>
        </tfoot>
      </table>
    </div>
  </section>
<% else %>
  <%= render "hotel_portal/booking_control_panels/booking_details/stay_details", booking: booking, presenter: booking_presenter %>
<% end %>
