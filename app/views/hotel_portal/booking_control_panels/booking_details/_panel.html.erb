<% if presenter.group_overview? %>
  <section aria-labelledby="group-booking-details-heading">
    <header class="flex flex-col gap-3 border-b border-border px-5 py-4 sm:flex-row sm:items-start sm:justify-between">
      <div>
        <p class="text-xs font-semibold text-muted-foreground">Booking No. <%= presenter.group_booking_number %></p>
        <h2 id="group-booking-details-heading" class="mt-1 text-lg font-bold text-foreground"><%= presenter.group_booking.name %></h2>
        <p class="mt-1 text-sm text-muted-foreground"><%= pluralize(presenter.child_bookings.size, "booking") %> from <%= presenter.time_label(presenter.group_arrival) %> to <%= presenter.time_label(presenter.group_departure) %>.</p>
      </div>
      <div class="flex shrink-0 items-center gap-2">
        <span class="inline-flex self-start rounded-md bg-muted px-2.5 py-1 text-xs font-semibold text-foreground"><%= presenter.group_booking.projected_status.humanize %></span>
        <% if current_user.has_permission?("manage_bookings", hotel: current_hotel) %>
          <%= link_to "Edit Dates", hotel_booking_action_edit_dates_path(current_hotel, booking, return_to: request.fullpath), data: { turbo_frame: "booking_action_sheet" }, class: "rounded-md border border-border-interactive bg-card px-3 py-2 text-sm font-semibold text-foreground hover:bg-muted focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring" %>
        <% end %>
      </div>
    </header>

    <% group_identifier_rows = [
      ["Confirmation", presenter.group_booking.confirmation_token.presence || "—"],
      ["Booking No.", presenter.group_booking.formatted_reservation_number.presence || "—"],
      ["Receipt No.", presenter.group_booking.formatted_receipt_number.presence || "—"],
      ["External Reference", presenter.group_booking.external_reference.presence || "—"],
      ["Organizer", presenter.group_booking.organizer_guest&.name.presence || "—"]
    ] %>
    <section class="grid border-b border-border md:grid-cols-[12rem_minmax(0,1fr)]" aria-labelledby="group-identifiers-heading">
      <h3 id="group-identifiers-heading" class="bg-muted px-5 py-4 text-xs font-bold uppercase tracking-wider text-muted-foreground">Identifiers</h3>
      <dl class="grid sm:grid-cols-2 lg:grid-cols-3">
        <% group_identifier_rows.each do |label, value| %>
          <div class="border-t border-border px-5 py-3 first:border-t-0 sm:odd:border-r sm:[&:nth-child(2)]:border-t-0 lg:[&:nth-child(3)]:border-t-0 lg:[&:nth-child(3n)]:border-r-0 lg:odd:border-r">
            <dt class="text-xs font-semibold text-muted-foreground"><%= label %></dt>
            <dd class="mt-1 break-words text-sm font-semibold text-foreground"><%= value %></dd>
          </div>
        <% end %>
      </dl>
    </section>

    <div class="overflow-x-auto">
      <table class="w-full min-w-[880px] text-left text-sm">
        <thead class="border-b border-border bg-muted text-xs font-semibold text-muted-foreground">
          <tr><th class="px-5 py-3">Booking No.</th><th class="px-5 py-3">Guest</th><th class="px-5 py-3">Room</th><th class="px-5 py-3">Stay</th><th class="px-5 py-3">Status</th><th class="px-5 py-3 text-right">Balance</th></tr>
        </thead>
        <tbody class="divide-y divide-border">
          <% presenter.group_room_rows.each do |row| %>
            <tr>
              <td class="px-5 py-3 font-semibold text-foreground"><%= row[:booking_number] %></td>
              <td class="px-5 py-3 text-foreground"><%= row[:guest] %></td>
              <td class="px-5 py-3 text-foreground"><%= row[:room] %> · <%= row[:room_type] %></td>
              <td class="px-5 py-3 whitespace-nowrap text-foreground"><%= row[:stay] %></td>
              <td class="px-5 py-3 text-foreground"><%= row[:status] %></td>
              <td class="px-5 py-3 text-right font-semibold tabular-nums text-foreground"><%= presenter.money_for(row[:booking], row[:booking].booking_folios.sum { |folio| folio.projected_outstanding_balance.to_d }) %></td>
            </tr>
          <% end %>
        </tbody>
        <tfoot class="border-t border-border-interactive bg-muted">
          <tr><th colspan="5" class="px-5 py-3 text-right text-sm font-semibold text-foreground">Group Outstanding Balance</th><td class="px-5 py-3 text-right font-bold tabular-nums text-foreground"><%= presenter.money(presenter.group_total_balance) %></td></tr>
        </tfoot>
      </table>
    </div>
  </section>
<% else %>
  <%= render "hotel_portal/booking_control_panels/booking_details/stay_details", booking: booking, presenter: booking_presenter %>
  <%= render "hotel_portal/booking_control_panels/booking_details/internal_notes", booking: booking %>
<% end %>
