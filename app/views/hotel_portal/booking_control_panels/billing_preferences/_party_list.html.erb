<div class="space-y-4">
  <div class="flex items-center justify-between gap-3">
    <h3 class="text-sm font-bold text-foreground">Billing parties</h3>
    <%= link_to "+ Add billing party", presenter.billing_preferences_path(billing_editor: "new_party"), data: { turbo_frame: "booking_control_panel_workspace", turbo_action: "advance" }, class: "rounded-md bg-primary px-3 py-2 text-sm font-semibold text-primary-foreground" %>
  </div>

  <% if presenter.billing_editor_open?("new_party") %>
    <%= form_with url: add_billing_party_hotel_booking_control_panel_path(current_hotel, booking), method: :post,
      data: (booking.group_booking_id? ? { turbo_frame: "offcanvas_drawer", offcanvas_variant: "right" } : {}),
      class: "space-y-4 rounded-lg border border-blue-200 bg-blue-50/40 p-4" do %>
      <div class="grid gap-4 sm:grid-cols-2">
        <div>
          <%= label_tag :billing_party_account_type, "Account type", class: "mb-1 block text-xs font-semibold text-muted-foreground" %>
          <select name="billing_party[account_type]" id="billing_party_account_type" class="w-full rounded-md border-border-interactive text-sm">
            <% BookingBillingParty::ACCOUNT_TYPES.each do |type| %>
              <option value="<%= type %>" <%= "disabled" if BookingBillingParty::UNAVAILABLE_ACCOUNT_TYPES.include?(type) %>><%= type.humanize %><%= " (coming soon)" if BookingBillingParty::UNAVAILABLE_ACCOUNT_TYPES.include?(type) %></option>
            <% end %>
          </select>
        </div>
        <div>
          <%= label_tag :billing_party_hotel_corporate_account_id, "Company / Government account", class: "mb-1 block text-xs font-semibold text-muted-foreground" %>
          <select name="billing_party[hotel_corporate_account_id]" id="billing_party_hotel_corporate_account_id" required
            class="w-full rounded-md border-border-interactive text-sm">
            <option value="">Select account</option>
            <% presenter.active_corporate_accounts.each do |account| %>
              <option value="<%= account.id %>"><%= account.corporate_account.name %></option>
            <% end %>
          </select>
        </div>
      </div>
      <%= render "hotel_portal/booking_control_panels/billing_preferences/terms_fields", prefix: "billing_party", object: nil %>
      <div class="flex justify-end gap-2">
        <%= link_to "Cancel", presenter.billing_preferences_path, data: { turbo_frame: "booking_control_panel_workspace" }, class: "rounded-md border border-border-interactive bg-card px-3 py-2 text-sm font-semibold" %>
        <%= submit_tag "Add billing party", class: "rounded-md bg-primary px-4 py-2 text-sm font-semibold text-primary-foreground" %>
      </div>
    <% end %>
  <% end %>

  <% presenter.billing_party_rows.each do |row| %>
    <% party = row.record %>
    <article class="rounded-lg border border-border p-4">
      <div class="flex flex-col gap-3 sm:flex-row sm:items-start sm:justify-between">
        <div>
          <div class="flex items-center gap-2">
            <span class="rounded bg-muted px-2 py-1 text-[10px] font-bold uppercase text-muted-foreground"><%= row.kind %></span>
            <h3 class="font-bold text-foreground"><%= row.label %></h3>
          </div>
          <p class="mt-1 text-sm text-muted-foreground"><%= row.role %> · <%= row.description %></p>
          <p class="mt-1 text-xs text-muted-foreground"><%= row.folio_count.positive? ? row.folio_labels.to_sentence : "No folio windows yet" %></p>
        </div>
        <div class="flex gap-3">
          <%= link_to "Edit terms", presenter.billing_preferences_path(billing_editor: "party", billing_party_id: party.id), data: { turbo_frame: "booking_control_panel_workspace" }, class: "text-sm font-semibold text-blue-700" %>
          <% if party.archiveable? %>
            <%= button_to "Remove", archive_billing_party_hotel_booking_control_panel_path(current_hotel, booking), method: :patch, params: { billing_party_id: party.id }, class: "text-sm font-semibold text-rose-700", form_class: "inline" %>
          <% end %>
        </div>
      </div>

      <% if presenter.billing_editor_open?("party", party) %>
        <%= form_with url: update_billing_terms_hotel_booking_control_panel_path(current_hotel, booking), method: :patch, class: "mt-4 space-y-4 border-t border-border pt-4" do %>
          <%= hidden_field_tag :billing_party_id, party.id %>
          <%= render "hotel_portal/booking_control_panels/billing_preferences/terms_fields", prefix: "billing_terms", object: party.billing_terms, party: party %>
          <div class="flex justify-end gap-2">
            <%= link_to "Cancel", presenter.billing_preferences_path, data: { turbo_frame: "booking_control_panel_workspace" }, class: "rounded-md border border-border-interactive px-3 py-2 text-sm font-semibold" %>
            <%= submit_tag "Save terms", class: "rounded-md bg-primary px-4 py-2 text-sm font-semibold text-primary-foreground" %>
          </div>
        <% end %>
      <% end %>
    </article>
  <% end %>
</div>
