<div class="space-y-4">
  <div class="flex items-center justify-between gap-3">
    <h3 class="text-sm font-bold text-slate-950">Billing parties</h3>
    <%= link_to "+ Add billing party", presenter.billing_preferences_path(billing_editor: "new_party"), data: { turbo_frame: "booking_control_panel_workspace", turbo_action: "advance" }, class: "rounded-md bg-slate-950 px-3 py-2 text-sm font-semibold text-white" %>
  </div>

  <% if presenter.billing_editor_open?("new_party") %>
    <%= form_with url: add_billing_party_hotel_booking_control_panel_path(current_hotel, booking), method: :post, class: "space-y-4 rounded-lg border border-blue-200 bg-blue-50/40 p-4" do %>
      <div>
        <%= label_tag :billing_party_hotel_corporate_account_id, "Company / Government account", class: "mb-1 block text-xs font-semibold text-slate-600" %>
        <%= select_tag "billing_party[hotel_corporate_account_id]", options_from_collection_for_select(presenter.active_corporate_accounts, :id, ->(account) { account.corporate_account.name }), include_blank: "Select account", required: true, class: "w-full rounded-md border-slate-300 text-sm" %>
      </div>
      <%= render "hotel_portal/booking_control_panels/billing_preferences/terms_fields", prefix: "billing_party", object: nil %>
      <div class="flex justify-end gap-2">
        <%= link_to "Cancel", presenter.billing_preferences_path, data: { turbo_frame: "booking_control_panel_workspace" }, class: "rounded-md border border-slate-300 bg-white px-3 py-2 text-sm font-semibold" %>
        <%= submit_tag "Add billing party", class: "rounded-md bg-slate-950 px-4 py-2 text-sm font-semibold text-white" %>
      </div>
    <% end %>
  <% end %>

  <% presenter.billing_party_rows.each do |row| %>
    <% party = row.record %>
    <article class="rounded-lg border border-slate-200 p-4">
      <div class="flex flex-col gap-3 sm:flex-row sm:items-start sm:justify-between">
        <div>
          <div class="flex items-center gap-2">
            <span class="rounded bg-slate-100 px-2 py-1 text-[10px] font-bold uppercase text-slate-600"><%= row.kind %></span>
            <h3 class="font-bold text-slate-950"><%= row.label %></h3>
          </div>
          <p class="mt-1 text-sm text-slate-600"><%= row.role %> · <%= row.description %></p>
          <p class="mt-1 text-xs text-slate-500"><%= row.folio_count.positive? ? row.folio_labels.to_sentence : "No folio windows yet" %></p>
        </div>
        <div class="flex gap-3">
          <%= link_to "Edit terms", presenter.billing_preferences_path(billing_editor: "party", billing_party_id: party.id), data: { turbo_frame: "booking_control_panel_workspace" }, class: "text-sm font-semibold text-blue-700" %>
          <% if party.archiveable? %>
            <%= button_to "Remove", archive_billing_party_hotel_booking_control_panel_path(current_hotel, booking), method: :patch, params: { billing_party_id: party.id }, class: "text-sm font-semibold text-rose-700", form_class: "inline" %>
          <% end %>
        </div>
      </div>

      <% if presenter.billing_editor_open?("party", party) %>
        <%= form_with url: update_billing_terms_hotel_booking_control_panel_path(current_hotel, booking), method: :patch, class: "mt-4 space-y-4 border-t border-slate-200 pt-4" do %>
          <%= hidden_field_tag :billing_party_id, party.id %>
          <%= render "hotel_portal/booking_control_panels/billing_preferences/terms_fields", prefix: "billing_terms", object: party.billing_terms %>
          <div class="flex justify-end gap-2">
            <%= link_to "Cancel", presenter.billing_preferences_path, data: { turbo_frame: "booking_control_panel_workspace" }, class: "rounded-md border border-slate-300 px-3 py-2 text-sm font-semibold" %>
            <%= submit_tag "Save terms", class: "rounded-md bg-slate-950 px-4 py-2 text-sm font-semibold text-white" %>
          </div>
        <% end %>
      <% end %>
    </article>
  <% end %>
</div>
