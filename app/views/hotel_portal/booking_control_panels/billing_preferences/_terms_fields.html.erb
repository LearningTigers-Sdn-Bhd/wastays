<% object = local_assigns[:object] %>
<div class="grid gap-4 sm:grid-cols-2">
  <div>
    <%= label_tag "#{prefix}_settlement_type", "Settlement type", class: "mb-1 block text-xs font-semibold text-slate-600" %>
    <%= select_tag "#{prefix}[settlement_type]", options_for_select([["Cash / bank", "cash_bank"], ["City Ledger", "city_ledger"]], object&.settlement_type || "cash_bank"), id: "#{prefix}_settlement_type", class: "w-full rounded-md border-slate-300 text-sm" %>
  </div>
  <div>
    <%= label_tag "#{prefix}_preferred_payment_method", "Preferred payment method", class: "mb-1 block text-xs font-semibold text-slate-600" %>
    <%= text_field_tag "#{prefix}[preferred_payment_method]", object&.preferred_payment_method, id: "#{prefix}_preferred_payment_method", class: "w-full rounded-md border-slate-300 text-sm" %>
  </div>
  <div>
    <%= label_tag "#{prefix}_purchase_order_reference", "PO reference", class: "mb-1 block text-xs font-semibold text-slate-600" %>
    <%= text_field_tag "#{prefix}[purchase_order_reference]", object&.purchase_order_reference, id: "#{prefix}_purchase_order_reference", class: "w-full rounded-md border-slate-300 text-sm" %>
  </div>
  <div>
    <%= label_tag "#{prefix}_billing_reference", "Billing reference", class: "mb-1 block text-xs font-semibold text-slate-600" %>
    <%= text_field_tag "#{prefix}[billing_reference]", object&.billing_reference, id: "#{prefix}_billing_reference", class: "w-full rounded-md border-slate-300 text-sm" %>
  </div>
  <div class="sm:col-span-2">
    <%= label_tag "#{prefix}_authorization_reference", "Authorization reference", class: "mb-1 block text-xs font-semibold text-slate-600" %>
    <%= text_field_tag "#{prefix}[authorization_reference]", object&.authorization_reference, id: "#{prefix}_authorization_reference", class: "w-full rounded-md border-slate-300 text-sm" %>
  </div>
</div>
