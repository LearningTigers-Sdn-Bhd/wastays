<section class="rounded-lg border border-slate-200 p-4" aria-labelledby="assign-billing-heading">
  <h3 id="assign-billing-heading" class="font-bold text-slate-950"><%= presenter.group_overview? ? "Apply arrangement" : "Booking-local billing exception" %></h3>
  <p class="mt-1 text-sm text-slate-600">Select the exact child bookings and charge categories. Tourism tax remains with each booking's primary guest.</p>

  <% assignment_url = presenter.group_overview? ? preview_group_billing_routes_hotel_booking_control_panel_path(current_hotel, booking) : apply_billing_hotel_booking_control_panel_path(current_hotel, booking) %>
  <%= form_with url: assignment_url, method: :post, class: "mt-4 space-y-4", data: (presenter.group_overview? ? { turbo_frame: "offcanvas_drawer" } : {}) do %>
    <%= hidden_field_tag :billing_scope, presenter.billing_scope %>
    <% if presenter.group_overview? %>
      <%= hidden_field_tag :idempotency_key, SecureRandom.uuid %>
    <% end %>

    <div>
      <%= label_tag :group_billing_arrangement_id, "Arrangement", class: "mb-1 block text-xs font-semibold text-slate-600" %>
      <%= select_tag :group_billing_arrangement_id, options_from_collection_for_select(arrangements.select { |item| item.status == "active" }, :id, :name), class: "w-full rounded-md border-slate-300 text-sm" %>
    </div>

    <fieldset>
      <legend class="text-xs font-semibold text-slate-600">Apply to</legend>
      <div class="mt-2 grid gap-2 sm:grid-cols-2">
        <% presenter.child_bookings.each do |child| %>
          <label class="flex items-center gap-2 rounded-md border border-slate-200 px-3 py-2 text-sm">
            <%= check_box_tag "booking_ids[]", child.id, presenter.group_overview? || child.id == booking.id %>
            <span>Booking No. <%= child.formatted_reservation_number.presence || "—" %> · <%= child.guest_name %></span>
          </label>
        <% end %>
      </div>
    </fieldset>

    <fieldset>
      <legend class="text-xs font-semibold text-slate-600">Coverage</legend>
      <div class="mt-2 grid gap-2 sm:grid-cols-3">
        <% GroupBillingChanges::Batch::CATEGORIES.each do |category| %>
          <label class="flex items-center gap-2 rounded-md border border-slate-200 px-3 py-2 text-sm">
            <%= check_box_tag "charge_categories[]", category, category == "accommodation" %>
            <span><%= category == "fb" ? "Food & Beverage" : category.humanize %></span>
          </label>
        <% end %>
      </div>
    </fieldset>

    <%= hidden_field_tag :local_exception, !presenter.group_overview? %>
    <% if presenter.group_overview? %>
      <label class="flex items-start gap-2 text-sm text-slate-700">
        <%= check_box_tag :replace_local_exceptions, "1", false %>
        <span>Replace booking-local exceptions for the selected categories.</span>
      </label>
    <% end %>

    <div class="flex justify-end">
      <%= submit_tag presenter.group_overview? ? "Review arrangement" : "Save local exception", class: "rounded-md bg-slate-950 px-4 py-2 text-sm font-semibold text-white" %>
    </div>
  <% end %>
</section>
