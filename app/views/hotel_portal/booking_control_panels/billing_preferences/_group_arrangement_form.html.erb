<% persisted = arrangement.persisted? %>
<% url = persisted ? update_group_billing_arrangement_hotel_booking_control_panel_path(current_hotel, booking) : create_group_billing_arrangement_hotel_booking_control_panel_path(current_hotel, booking) %>
<%= form_with url: url, method: persisted ? :patch : :post, class: "space-y-4 rounded-lg border border-blue-200 bg-blue-50/40 p-4" do %>
  <%= hidden_field_tag :group_billing_arrangement_id, arrangement.id if persisted %>
  <div class="grid gap-4 sm:grid-cols-2">
    <div><%= label_tag :group_billing_arrangement_name, "Arrangement name", class: "mb-1 block text-xs font-semibold text-slate-600" %><%= text_field_tag "group_billing_arrangement[name]", arrangement.name, id: :group_billing_arrangement_name, required: true, class: "w-full rounded-md border-slate-300 text-sm" %></div>
    <div><%= label_tag :group_billing_arrangement_payer_type, "Payer", class: "mb-1 block text-xs font-semibold text-slate-600" %><%= select_tag "group_billing_arrangement[payer_type]", options_for_select([["Guest", "guest"], ["Company / Government", "company"]], arrangement.payer_type || "company"), id: :group_billing_arrangement_payer_type, class: "w-full rounded-md border-slate-300 text-sm" %></div>
    <div class="sm:col-span-2"><%= label_tag :group_billing_arrangement_hotel_corporate_account_id, "Company / Government account", class: "mb-1 block text-xs font-semibold text-slate-600" %><%= select_tag "group_billing_arrangement[hotel_corporate_account_id]", options_from_collection_for_select(presenter.active_corporate_accounts, :id, ->(account) { account.corporate_account.name }, arrangement.hotel_corporate_account_id), include_blank: "Guest responsibility / select an account", id: :group_billing_arrangement_hotel_corporate_account_id, class: "w-full rounded-md border-slate-300 text-sm" %></div>
  </div>
  <%= render "hotel_portal/booking_control_panels/billing_preferences/terms_fields", prefix: "group_billing_arrangement", object: arrangement %>
  <fieldset><legend class="text-xs font-semibold text-slate-600">Default coverage</legend><div class="mt-2 grid gap-2 sm:grid-cols-3"><% %w[accommodation tax fb parking other].each do |category| %><label class="flex items-center gap-2 rounded-md border border-slate-200 bg-white px-3 py-2 text-sm"><%= check_box_tag "group_billing_arrangement[charge_categories][]", category, arrangement.coverage.to_h[category] %><span><%= category == "fb" ? "Food & Beverage" : category.humanize %></span></label><% end %></div></fieldset>
  <div class="grid gap-4 sm:grid-cols-2"><div><%= label_tag :group_billing_arrangement_valid_from, "Valid from", class: "mb-1 block text-xs font-semibold text-slate-600" %><%= date_field_tag "group_billing_arrangement[valid_from]", arrangement.valid_from, class: "w-full rounded-md border-slate-300 text-sm" %></div><div><%= label_tag :group_billing_arrangement_valid_until, "Valid until", class: "mb-1 block text-xs font-semibold text-slate-600" %><%= date_field_tag "group_billing_arrangement[valid_until]", arrangement.valid_until, class: "w-full rounded-md border-slate-300 text-sm" %></div></div>
  <%= hidden_field_tag "group_billing_arrangement[status]", arrangement.status.presence || "active" %>
  <div class="flex justify-end gap-2"><%= link_to "Cancel", presenter.billing_preferences_path(scope: "group"), data: { turbo_frame: "booking_control_panel_workspace" }, class: "rounded-md border border-slate-300 bg-white px-3 py-2 text-sm font-semibold text-slate-700" %><%= submit_tag persisted ? "Save arrangement" : "Create arrangement", class: "rounded-md bg-slate-950 px-4 py-2 text-sm font-semibold text-white" %></div>
<% end %>
