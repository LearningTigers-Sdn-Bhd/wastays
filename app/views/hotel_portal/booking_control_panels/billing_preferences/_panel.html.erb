<% arrangements = booking.group_booking&.group_billing_arrangements&.to_a || [] %>
<section aria-labelledby="billing-preferences-heading">
  <header class="flex flex-col gap-3 border-b border-slate-200 px-5 py-4 sm:flex-row sm:items-start sm:justify-between">
    <div><p class="text-xs font-semibold text-slate-500"><%= presenter.group_overview? ? presenter.group_booking.reference : booking.confirmation_token %></p><h2 id="billing-preferences-heading" class="mt-1 text-lg font-bold text-slate-950">Billing Preferences</h2><p class="mt-1 text-sm text-slate-600"><%= presenter.group_overview? ? "Default payers and settlement methods for the group." : "Who may be billed and the terms used for settlement. Routing is managed separately." %></p></div>
    <% if presenter.group_overview? %><%= link_to "+ Add arrangement", presenter.billing_preferences_path(scope: "group", billing_editor: "new_arrangement"), data: { turbo_frame: "booking_control_panel_workspace", turbo_action: "advance" }, class: "rounded-md bg-slate-950 px-3 py-2 text-sm font-semibold text-white" %><% elsif !presenter.group_context_enabled? %><%= link_to "+ Add billing party", presenter.billing_preferences_path(billing_editor: "new_party"), data: { turbo_frame: "booking_control_panel_workspace", turbo_action: "advance" }, class: "rounded-md bg-slate-950 px-3 py-2 text-sm font-semibold text-white" %><% end %>
  </header>

  <% if presenter.group_overview? %>
    <div class="space-y-4 p-5">
      <% if presenter.billing_editor_open?("new_arrangement") %><%= render "hotel_portal/booking_control_panels/billing_preferences/group_arrangement_form", arrangement: booking.group_booking.group_billing_arrangements.build, booking: booking, presenter: presenter %><% end %>
      <% arrangements.each do |arrangement| %>
        <article class="rounded-lg border border-slate-200 p-4">
          <div class="flex flex-col gap-3 sm:flex-row sm:items-start sm:justify-between"><div><div class="flex items-center gap-2"><h3 class="font-bold text-slate-950"><%= arrangement.name %></h3><span class="rounded bg-slate-100 px-2 py-1 text-[10px] font-bold uppercase text-slate-600"><%= arrangement.status %></span></div><p class="mt-1 text-sm text-slate-600"><%= arrangement.hotel_corporate_account&.corporate_account&.name || "Primary guest per booking" %> · <%= arrangement.settlement_type.humanize %></p><p class="mt-1 text-xs text-slate-500"><%= arrangement.coverage.to_h.keys.map { |key| key == "fb" ? "Food & Beverage" : key.humanize }.to_sentence.presence || "No default coverage" %></p></div><div class="flex gap-3"><%= link_to "Edit", presenter.billing_preferences_path(scope: "group", billing_editor: "arrangement", arrangement_id: arrangement.id), data: { turbo_frame: "booking_control_panel_workspace" }, class: "text-sm font-semibold text-blue-700" %><% if arrangement.status == "active" %><%= button_to "Deactivate", deactivate_group_billing_arrangement_hotel_booking_control_panel_path(current_hotel, booking), method: :patch, params: { group_billing_arrangement_id: arrangement.id }, class: "text-sm font-semibold text-rose-700", form_class: "inline" %><% end %></div></div>
          <% if presenter.billing_editor_open?("arrangement", arrangement) %><div class="mt-4"><%= render "hotel_portal/booking_control_panels/billing_preferences/group_arrangement_form", arrangement: arrangement, booking: booking, presenter: presenter %></div><% end %>
        </article>
      <% end %>
      <% if arrangements.empty? && !presenter.billing_editor_open?("new_arrangement") %><p class="py-8 text-center text-sm text-slate-500">No group billing arrangements have been configured.</p><% end %>
      <% if arrangements.any? %><%= render "hotel_portal/booking_control_panels/billing_preferences/assignment_form", booking: booking, presenter: presenter, arrangements: arrangements %><% end %>
    </div>
  <% elsif presenter.group_context_enabled? %>
    <div class="space-y-5 p-5"><%= render "hotel_portal/booking_control_panels/billing_preferences/assignment_form", booking: booking, presenter: presenter, arrangements: arrangements %></div>
  <% else %>
    <div class="space-y-4 p-5">
      <h3 class="text-sm font-bold text-slate-950">Billing parties</h3>
      <% if presenter.billing_editor_open?("new_party") %>
        <%= form_with url: add_billing_party_hotel_booking_control_panel_path(current_hotel, booking), method: :post, class: "space-y-4 rounded-lg border border-blue-200 bg-blue-50/40 p-4" do %><div><%= label_tag :billing_party_hotel_corporate_account_id, "Company / Government account", class: "mb-1 block text-xs font-semibold text-slate-600" %><%= select_tag "billing_party[hotel_corporate_account_id]", options_from_collection_for_select(presenter.active_corporate_accounts, :id, ->(account) { account.corporate_account.name }), include_blank: "Select account", required: true, class: "w-full rounded-md border-slate-300 text-sm" %></div><%= render "hotel_portal/booking_control_panels/billing_preferences/terms_fields", prefix: "billing_party", object: nil %><div class="flex justify-end gap-2"><%= link_to "Cancel", presenter.billing_preferences_path, data: { turbo_frame: "booking_control_panel_workspace" }, class: "rounded-md border border-slate-300 bg-white px-3 py-2 text-sm font-semibold" %><%= submit_tag "Add billing party", class: "rounded-md bg-slate-950 px-4 py-2 text-sm font-semibold text-white" %></div><% end %>
      <% end %>
      <% presenter.billing_party_rows.each do |row| %><% party = row.record %><article class="rounded-lg border border-slate-200 p-4"><div class="flex flex-col gap-3 sm:flex-row sm:items-start sm:justify-between"><div><div class="flex items-center gap-2"><span class="rounded bg-slate-100 px-2 py-1 text-[10px] font-bold uppercase text-slate-600"><%= row.kind %></span><h3 class="font-bold text-slate-950"><%= row.label %></h3></div><p class="mt-1 text-sm text-slate-600"><%= row.role %> · <%= row.description %></p><p class="mt-1 text-xs text-slate-500"><%= row.folio_count.positive? ? row.folio_labels.to_sentence : "No folio windows yet" %></p></div><div class="flex gap-3"><%= link_to "Edit terms", presenter.billing_preferences_path(billing_editor: "party", billing_party_id: party.id), data: { turbo_frame: "booking_control_panel_workspace" }, class: "text-sm font-semibold text-blue-700" %><% if party.archiveable? %><%= button_to "Remove", archive_billing_party_hotel_booking_control_panel_path(current_hotel, booking), method: :patch, params: { billing_party_id: party.id }, class: "text-sm font-semibold text-rose-700", form_class: "inline" %><% end %></div></div><% if presenter.billing_editor_open?("party", party) %><%= form_with url: update_billing_terms_hotel_booking_control_panel_path(current_hotel, booking), method: :patch, class: "mt-4 space-y-4 border-t border-slate-200 pt-4" do %><%= hidden_field_tag :billing_party_id, party.id %><%= render "hotel_portal/booking_control_panels/billing_preferences/terms_fields", prefix: "billing_terms", object: party.billing_terms %><div class="flex justify-end gap-2"><%= link_to "Cancel", presenter.billing_preferences_path, data: { turbo_frame: "booking_control_panel_workspace" }, class: "rounded-md border border-slate-300 px-3 py-2 text-sm font-semibold" %><%= submit_tag "Save terms", class: "rounded-md bg-slate-950 px-4 py-2 text-sm font-semibold text-white" %></div><% end %><% end %></article><% end %>
    </div>
  <% end %>
  <% unless presenter.group_overview? %><details class="border-t border-slate-200"><summary class="cursor-pointer px-5 py-4 text-sm font-semibold text-slate-800">Advanced Billing Rules</summary><div class="border-t border-slate-200"><%= render "hotel_portal/booking_control_panels/billing_details/city_ledger_rules", booking: booking, hotel: current_hotel, folio_show: folio_show, folio_origin: "booking_control_panel" %></div></details><% end %>
</section>
