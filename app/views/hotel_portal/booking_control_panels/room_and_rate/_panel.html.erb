<% if presenter.group_overview? %>
  <% rows = presenter.group_room_rate_rows %>
  <% issues = presenter.group_room_rate_issues %>
  <section aria-labelledby="room-rate-heading">
    <header class="border-b border-slate-200 px-5 py-4">
      <p class="text-xs font-semibold text-slate-500"><%= presenter.group_booking.reference %></p>
      <h2 id="room-rate-heading" class="mt-1 text-lg font-bold text-slate-950">Group Room &amp; Rate</h2>
      <p class="mt-1 text-sm text-slate-600">The room and agreed rate for each night across the group.</p>
    </header>

    <div class="overflow-x-auto">
      <table class="w-full min-w-[860px] text-left text-sm">
        <thead class="border-b border-slate-200 bg-slate-50 text-xs font-semibold text-slate-600">
          <tr><th class="px-5 py-3">Booking</th><th class="px-5 py-3">Stay Date</th><th class="px-5 py-3">Room Type</th><th class="px-5 py-3">Room</th><th class="px-5 py-3">Rate Plan</th><th class="px-5 py-3 text-right">Nightly Rate</th></tr>
        </thead>
        <tbody class="divide-y divide-slate-200">
          <% rows.each do |row| %>
            <tr>
              <td class="px-5 py-3 font-semibold text-slate-950"><%= row.booking_reference %></td>
              <td class="whitespace-nowrap px-5 py-3 font-semibold text-slate-950"><%= row.date.strftime("%d %b %Y") %></td>
              <td class="px-5 py-3 text-slate-700"><%= row.room_type %></td>
              <td class="px-5 py-3 text-slate-700"><%= row.room %></td>
              <td class="px-5 py-3 text-slate-700"><%= row.rate_plan %></td>
              <td class="px-5 py-3 text-right font-semibold tabular-nums <%= row.rate_missing ? 'text-amber-700' : 'text-slate-950' %>"><%= row.nightly_rate %></td>
            </tr>
          <% end %>

          <% issues.each do |issue| %>
            <tr><td class="px-5 py-4 font-semibold text-slate-950"><%= issue[:booking_reference] %></td><td colspan="5" class="px-5 py-4 text-slate-600"><%= issue[:message] %></td></tr>
          <% end %>

          <% if rows.empty? && issues.empty? %>
            <tr><td colspan="6" class="px-5 py-10 text-center text-slate-500">No room-rate rows are available for this group.</td></tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </section>
<% else %>
  <% rows = presenter.room_rate_rows %>
  <% empty_message = presenter.room_rate_empty_message %>
  <section aria-labelledby="room-rate-heading">
    <header class="flex flex-col gap-3 border-b border-slate-200 px-5 py-4 sm:flex-row sm:items-start sm:justify-between">
      <div><p class="text-xs font-semibold text-slate-500"><%= booking.confirmation_token %></p><h2 id="room-rate-heading" class="mt-1 text-lg font-bold text-slate-950">Room &amp; Rate</h2><p class="mt-1 text-sm text-slate-600">The room and agreed rate for each night of this booking.</p></div>
      <div class="flex flex-wrap gap-2">
        <%= link_to "Change Room", hotel_booking_transaction_edit_booking_timeline_path(current_hotel, booking), data: { turbo_frame: "offcanvas_drawer", offcanvas_variant: "right" }, class: "rounded-md border border-slate-300 bg-white px-3 py-2 text-sm font-semibold text-slate-700 hover:bg-slate-50 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-600" %>
        <%= link_to "Change Rate", hotel_booking_control_panel_path(current_hotel, booking, tab: "room_and_rate", alert_action: "change_rate"), data: { turbo_frame: "booking_control_panel_workspace", turbo_action: "advance", warning_dialog_trigger: "change-rate" }, class: "rounded-md bg-slate-950 px-3 py-2 text-sm font-semibold text-white hover:bg-slate-800 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-600" %>
      </div>
    </header>

    <div class="overflow-x-auto">
      <table class="w-full min-w-[720px] text-left text-sm">
        <thead class="border-b border-slate-200 bg-slate-50 text-xs font-semibold text-slate-600">
          <tr><th class="px-5 py-3">Stay Date</th><th class="px-5 py-3">Room Type</th><th class="px-5 py-3">Room</th><th class="px-5 py-3">Rate Plan</th><th class="px-5 py-3 text-right">Nightly Rate</th></tr>
        </thead>
        <tbody class="divide-y divide-slate-200">
          <% if rows.any? %>
            <% rows.each do |row| %>
              <tr>
                <td class="whitespace-nowrap px-5 py-3 font-semibold text-slate-950"><%= row.date.strftime("%d %b %Y") %></td>
                <td class="px-5 py-3 text-slate-700"><%= row.room_type %></td>
                <td class="px-5 py-3 text-slate-700"><%= row.room %></td>
                <td class="px-5 py-3 text-slate-700"><%= row.rate_plan %></td>
                <td class="px-5 py-3 text-right font-semibold tabular-nums <%= row.rate_missing ? 'text-amber-700' : 'text-slate-950' %>"><%= row.nightly_rate %></td>
              </tr>
            <% end %>
          <% else %>
            <tr><td colspan="5" class="px-5 py-10 text-center text-slate-500"><%= empty_message || "No room-rate rows are available for this booking." %></td></tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </section>
<% end %>
