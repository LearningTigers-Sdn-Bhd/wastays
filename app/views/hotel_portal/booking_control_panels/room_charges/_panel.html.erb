<section class="overflow-hidden rounded-xl border border-slate-200 bg-white shadow-sm">
  <div class="border-b border-slate-200 px-4 py-3">
    <h2 class="text-sm font-black uppercase tracking-[0.18em] text-slate-600">Room Charges</h2>
  </div>
  <div class="overflow-x-auto">
    <table class="w-full min-w-[760px] text-left text-sm">
      <thead class="bg-slate-50 text-[10px] font-black uppercase tracking-wider text-slate-500">
        <tr>
          <th class="px-4 py-3">Room</th>
          <th class="px-4 py-3">Rate Plan</th>
          <th class="px-4 py-3">Subtotal</th>
          <th class="px-4 py-3">Room Type</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-slate-100">
        <% booking.booking_rooms.each do |room| %>
          <tr>
            <td class="px-4 py-3 font-bold text-slate-950"><%= room.room_number.presence || "Unassigned" %></td>
            <td class="px-4 py-3 text-slate-700"><%= room.rate_plan&.name.presence || "Standard" %></td>
            <td class="px-4 py-3 text-slate-700"><%= presenter.money(room.subtotal) %></td>
            <td class="px-4 py-3 text-slate-700"><%= room.room_type&.name || room.room_type_snapshot.to_h["name"] || "—" %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</section>
