<div>
  <% if presenter.group_context_enabled? && booking.group_booking.group_billing_arrangements.any? %>
    <%= form_with url: apply_billing_hotel_booking_control_panel_path(current_hotel, booking), method: :post, class: "space-y-5" do %>
      <%= hidden_field_tag :billing_scope, presenter.billing_scope %>
      <div><%= label_tag :group_billing_arrangement_id, "Bill To", class: "mb-1.5 block text-xs font-semibold text-slate-600" %><%= select_tag :group_billing_arrangement_id, options_from_collection_for_select(booking.group_booking.group_billing_arrangements, :id, :name), class: "w-full rounded-md border-slate-300 bg-white text-sm focus:border-blue-600 focus:ring-blue-600" %></div>

      <fieldset>
        <legend class="text-xs font-semibold text-slate-600">Apply To</legend>
        <div class="mt-2 divide-y divide-slate-200 border-y border-slate-200">
          <% presenter.child_bookings.each do |child| %>
            <label class="flex cursor-pointer items-center gap-3 px-1 py-3 text-sm text-slate-800 hover:bg-slate-50"><%= check_box_tag "booking_ids[]", child.id, presenter.group_overview? || child.id == booking.id, class: "rounded border-slate-300 text-slate-950 focus:ring-blue-600" %><span><strong><%= child.confirmation_token %></strong> · <%= child.guest_name %></span></label>
          <% end %>
        </div>
      </fieldset>

      <fieldset>
        <legend class="text-xs font-semibold text-slate-600">Company Pays</legend>
        <div class="mt-2 grid gap-2 sm:grid-cols-2">
          <% %w[accommodation tax fb parking other].each do |category| %>
            <label class="flex cursor-pointer items-center gap-3 rounded-md border border-slate-200 px-3 py-2.5 text-sm text-slate-800 hover:bg-slate-50"><%= check_box_tag "charge_categories[]", category, category == "accommodation", class: "rounded border-slate-300 text-slate-950 focus:ring-blue-600" %><span><%= category == "fb" ? "Food & Beverage" : category.humanize %></span></label>
          <% end %>
        </div>
      </fieldset>

      <p class="text-xs leading-5 text-slate-500">Tourism tax remains with the guest unless an explicit routing rule says otherwise.</p>
      <%= hidden_field_tag :local_exception, !presenter.group_overview? %>
      <%= submit_tag "Save Billing", class: "w-full rounded-md bg-slate-950 px-4 py-2.5 text-sm font-semibold text-white hover:bg-slate-800 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-600 focus-visible:ring-offset-2" %>
    <% end %>
  <% else %>
    <p class="text-sm text-slate-600">Create a group billing arrangement before assigning company responsibility.</p>
  <% end %>
</div>
