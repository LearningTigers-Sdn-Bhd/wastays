<div class="space-y-4"><p class="text-sm text-slate-600">Group deposits are received once and allocated as credits to concrete child folios.</p><% if booking.group_booking %><% booking.group_booking.group_deposits.each do |deposit| %><div class="rounded-lg border border-slate-200 p-3"><div class="flex justify-between gap-3"><span class="font-bold text-slate-950"><%= presenter.money(deposit.amount) %></span><span class="text-xs font-bold uppercase text-slate-500"><%= deposit.status.humanize %></span></div><p class="mt-1 text-xs text-slate-500"><%= presenter.money(deposit.available_amount) %> unallocated</p><% if deposit.available_amount.positive? && booking.booking_folios.open.any? %><%= form_with url: allocate_deposit_hotel_booking_control_panel_path(current_hotel, booking), method: :post, class: "mt-3 space-y-2" do %><%= hidden_field_tag :group_deposit_id, deposit.id %><%= select_tag :booking_folio_id, options_from_collection_for_select(booking.booking_folios.open, :id, :display_name), class: "w-full rounded-lg border-slate-200 text-sm" %><%= number_field_tag :amount, nil, min: 0.01, max: deposit.available_amount, step: 0.01, placeholder: "Amount", class: "w-full rounded-lg border-slate-200 text-sm" %><%= submit_tag "Allocate to this booking", class: "w-full rounded-lg bg-slate-950 px-3 py-2 text-xs font-bold text-white" %><% end %><% end %></div><% end %><% end %></div>
