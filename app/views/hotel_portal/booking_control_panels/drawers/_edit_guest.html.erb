<% booking_guest = presenter.selected_booking_guest %>
<div class="space-y-4"><p class="text-sm text-muted-foreground">Edit the stay snapshot or change which guest is primary for this room. Sibling bookings are unaffected.</p><% if booking_guest %><%= link_to "Edit guest", hotel_booking_show_action_manage_guest_path(current_hotel, booking, mode: booking_guest.primary? ? "edit_primary" : "edit_additional", booking_guest_id: booking_guest.id), data: { turbo_frame: "offcanvas_drawer", offcanvas_variant: "compact-right" }, class: "block rounded-lg bg-primary px-4 py-2.5 text-center text-sm font-bold text-primary-foreground" %><% unless booking_guest.primary? %><%= button_to "Make primary for this room", set_primary_guest_hotel_booking_control_panel_path(current_hotel, booking, booking_guest_id: booking_guest.id), method: :patch, class: "w-full rounded-lg border border-blue-200 bg-blue-50 px-4 py-2.5 text-sm font-bold text-blue-700" %><% end %><% end %></div>
