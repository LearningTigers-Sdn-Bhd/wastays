<% folio = booking.booking_folio %>
<% balance = folio&.outstanding_balance.to_d %>
<% currency = booking.currency.presence || "MYR" %>

<dialog id="check-out-modal-show-<%= booking.id %>" class="fixed inset-0 m-auto rounded-2xl p-0 w-[min(92vw,32rem)] max-w-lg shadow-2xl backdrop:bg-slate-900/50" onclick="if(event.target===this){this.close()}">
  <div class="bg-white" onclick="event.stopPropagation()">
    <div class="border-b border-slate-100 px-6 py-5">
      <h3 class="text-lg font-bold text-slate-900">Confirm Check-Out</h3>
      <p class="text-sm text-slate-500 mt-1">Review folio settlement before checking out <%= booking.guest_name %>.</p>
    </div>

    <%= form_with url: check_out_hotel_booking_path(hotel, booking), method: :post, local: true, class: "p-6 space-y-5" do |f| %>
      <div class="grid grid-cols-2 gap-3">
        <div class="rounded-xl border border-slate-200 bg-slate-50/60 p-4">
          <p class="text-[10px] font-bold uppercase tracking-widest text-slate-500">Folio</p>
          <p class="mt-1 text-sm font-black text-slate-900"><%= folio ? booking.formatted_folio_number : "No folio" %></p>
          <p class="mt-0.5 text-xs font-semibold text-slate-500"><%= folio&.status&.humanize || "Missing" %></p>
        </div>
        <div class="rounded-xl border border-slate-200 bg-slate-50/60 p-4 text-right">
          <p class="text-[10px] font-bold uppercase tracking-widest text-slate-500">Balance</p>
          <p class="mt-1 text-lg font-black <%= balance&.zero? ? 'text-emerald-700' : 'text-amber-700' %>">
            <%= currency %> <%= number_with_precision(balance || 0, precision: 2) %>
          </p>
        </div>
      </div>

      <% if folio.blank? %>
        <div class="rounded-xl border border-red-100 bg-red-50 p-4">
          <p class="text-sm font-bold text-red-900">Folio required</p>
          <p class="mt-1 text-xs font-medium leading-relaxed text-red-700">This booking must have a folio before checkout can be completed.</p>
        </div>
      <% elsif balance.positive? %>
        <div class="rounded-xl border border-amber-100 bg-amber-50 p-4">
          <p class="text-sm font-bold text-amber-900">Payment required before checkout</p>
          <p class="mt-1 text-xs font-medium leading-relaxed text-amber-700">This folio has an outstanding balance. Post payment or adjustment before checking out this guest.</p>
        </div>
      <% elsif balance.negative? %>
        <div class="rounded-xl border border-amber-100 bg-amber-50 p-4">
          <p class="text-sm font-bold text-amber-900">Credit balance detected</p>
          <p class="mt-1 text-xs font-medium leading-relaxed text-amber-700">Process a refund or adjustment before checking out this guest.</p>
        </div>
      <% elsif folio.status == "closed" %>
        <div class="rounded-xl border border-slate-200 bg-slate-50 p-4">
          <p class="text-sm font-bold text-slate-900">Folio already closed</p>
          <p class="mt-1 text-xs font-medium leading-relaxed text-slate-600">This folio has already been closed and cannot be checked out again.</p>
        </div>
      <% else %>
        <div class="rounded-xl border border-emerald-100 bg-emerald-50 p-4">
          <p class="text-sm font-bold text-emerald-900">Ready to close folio</p>
          <p class="mt-1 text-xs font-medium leading-relaxed text-emerald-700">The folio is settled. Checkout will close the folio and mark assigned rooms pending cleaning.</p>
        </div>
      <% end %>

      <div>
        <label class="block text-[11px] font-bold text-slate-500 uppercase tracking-wider mb-2">Check-out Date & Time</label>
        <%= f.datetime_local_field :checked_out_at,
            value: Time.current.strftime("%Y-%m-%dT%H:%M"),
            class: "w-full rounded-xl border border-slate-200 bg-white py-2.5 px-4 text-sm text-slate-700 focus:border-slate-300 focus:outline-none focus:ring-0 shadow-sm" %>
      </div>

      <div class="flex items-center justify-end gap-x-3 pt-2">
        <button type="button" class="px-4 py-2 text-sm font-semibold text-slate-700 hover:bg-slate-50 rounded-lg transition" onclick="this.closest('dialog').close()">Cancel</button>
        <%= f.submit "Confirm Check-Out", class: "px-4 py-2 text-sm font-bold bg-slate-900 text-white rounded-lg hover:bg-slate-700 transition shadow-sm" %>
      </div>
    <% end %>
  </div>
</dialog>
