<% terms = @card.signed? ? @card.terms_snapshot : @card.capture_terms_snapshot_preview %>
<% primary_booking_guest = @booking.booking_guests.find(&:primary?) %>
<% guest_name = primary_booking_guest&.name_snapshot.presence || @booking.guest_name %>
<% guest_phone = primary_booking_guest&.phone_snapshot.presence || @booking.guest_phone %>
<% guest_email = primary_booking_guest&.email_snapshot.presence || @booking.guest_email %>
<% room_type_summary = @booking.room_type_summary.presence || "To be assigned" %>
<% content_for :title, "Guest Registration Card #{ @booking.guest_registration_card_number_display }" %>

<style>
  @media print {
    body * { visibility: hidden; }
    .grc-print, .grc-print * { visibility: visible; }
    .grc-print { position: absolute; inset: 0; width: 100%; }
    .grc-print-page { min-height: calc(100vh - 16mm); display: flex; flex-direction: column; }
    .grc-print-footer { margin-top: auto; }
    .grc-no-print { display: none !important; }
    @page { margin: 8mm; }
  }
</style>

<div class="w-full text-foreground print:p-0">
  <div class="grc-no-print mb-4">
    <div>
      <p class="text-xs font-semibold uppercase text-muted-foreground">Front desk document</p>
      <h1 class="text-2xl font-bold">Guest Registration Card</h1>
    </div>
  </div>

  <% if flash[:notice].present? %>
    <div class="grc-no-print mb-4 rounded-md bg-emerald-50 px-4 py-3 text-sm text-emerald-700"><%= flash[:notice] %></div>
  <% end %>

  <% if @card.errors.any? %>
    <div class="grc-no-print mb-4 rounded-md bg-red-50 px-4 py-3 text-sm text-red-700"><%= @card.errors.full_messages.to_sentence %></div>
  <% end %>

  <section class="grc-no-print grid gap-5 lg:grid-cols-[1fr_380px]">
    <div class="space-y-5">
      <section class="overflow-hidden rounded-lg border border-border bg-card shadow-sm">
        <div class="border-b border-border bg-muted px-5 py-4">
          <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
            <div>
              <p class="text-xs font-semibold uppercase text-muted-foreground">Guest Registration No.</p>
              <p class="mt-1 text-2xl font-black text-foreground"><%= @booking.guest_registration_card_number_display %></p>
            </div>
            <% if @card.field_visible?(:booking_number) %>
              <div class="rounded-md border border-border bg-card px-3 py-2 text-sm font-semibold text-foreground">
                Booking <%= @booking.confirmation_token %>
              </div>
            <% end %>
          </div>
        </div>

        <div class="grid gap-0 text-sm md:grid-cols-2">
          <div class="border-b border-border p-5 md:border-b-0 md:border-r">
            <h2 class="mb-4 text-sm font-bold uppercase text-muted-foreground">Guest</h2>
            <dl class="space-y-3">
              <div class="grid gap-1 sm:grid-cols-[7rem_1fr]"><dt class="text-muted-foreground">Name</dt><dd class="font-semibold text-foreground sm:text-right"><%= guest_name %></dd></div>
              <% if @card.field_visible?(:phone) %><div class="grid gap-1 sm:grid-cols-[7rem_1fr]"><dt class="text-muted-foreground">Phone</dt><dd class="text-foreground sm:text-right"><%= guest_phone %></dd></div><% end %>
              <% if @card.field_visible?(:email) %><div class="grid gap-1 sm:grid-cols-[7rem_1fr]"><dt class="text-muted-foreground">Email</dt><dd class="break-all text-foreground sm:text-right"><%= guest_email %></dd></div><% end %>
              <% if @card.field_visible?(:guest_count) %><div class="grid gap-1 sm:grid-cols-[7rem_1fr]"><dt class="text-muted-foreground">Guests</dt><dd class="text-foreground sm:text-right"><%= @booking.adults.to_i %> adult(s), <%= @booking.children.to_i %> child(ren)</dd></div><% end %>
            </dl>
          </div>

          <div class="p-5">
            <h2 class="mb-4 text-sm font-bold uppercase text-muted-foreground">Stay</h2>
            <dl class="space-y-3">
              <div class="grid gap-1 sm:grid-cols-[7rem_1fr]"><dt class="text-muted-foreground">Hotel</dt><dd class="font-semibold text-foreground sm:text-right"><%= current_hotel.name %></dd></div>
              <% if @card.field_visible?(:room_type) %><div class="grid gap-1 sm:grid-cols-[7rem_1fr]"><dt class="text-muted-foreground">Room type</dt><dd class="text-foreground sm:text-right"><%= room_type_summary %></dd></div><% end %>
              <% if @card.field_visible?(:check_in) %><div class="grid gap-1 sm:grid-cols-[7rem_1fr]"><dt class="text-muted-foreground">Check-in</dt><dd class="text-foreground sm:text-right"><%= l(@booking.check_in.to_date) %></dd></div><% end %>
              <% if @card.field_visible?(:check_out) %><div class="grid gap-1 sm:grid-cols-[7rem_1fr]"><dt class="text-muted-foreground">Check-out</dt><dd class="text-foreground sm:text-right"><%= l(@booking.check_out.to_date) %></dd></div><% end %>
              <% if @card.field_visible?(:room_number) %><div class="grid gap-1 sm:grid-cols-[7rem_1fr]"><dt class="text-muted-foreground">Room(s)</dt><dd class="text-foreground sm:text-right"><%= @booking.room_numbers.presence || "To be assigned" %></dd></div><% end %>
            </dl>
          </div>
        </div>
      </section>

      <section class="rounded-lg border border-border bg-card p-5 shadow-sm">
        <div class="mb-4 flex items-center justify-between gap-4">
          <div>
            <h2 class="text-lg font-bold text-foreground">Terms and Conditions</h2>
            <p class="text-sm text-muted-foreground">Shown before guest signs; saved as snapshot on signature.</p>
          </div>
        </div>

        <% if terms.present? %>
          <div class="grid gap-3 md:grid-cols-2">
            <div class="rounded-md border border-border bg-muted p-4">
              <p class="text-xs font-bold uppercase text-muted-foreground">Check-in</p>
              <p class="mt-1 text-base font-semibold text-foreground"><%= terms["check_in_time"].presence || "-" %></p>
            </div>
            <div class="rounded-md border border-border bg-muted p-4">
              <p class="text-xs font-bold uppercase text-muted-foreground">Check-out</p>
              <p class="mt-1 text-base font-semibold text-foreground"><%= terms["check_out_time"].presence || "-" %></p>
            </div>
            <% if terms["cancellation_policy"].present? %>
              <div class="rounded-md border border-border p-4 md:col-span-2">
                <p class="text-xs font-bold uppercase text-muted-foreground">Cancellation Policy</p>
                <div class="mt-2 text-sm leading-6 text-foreground"><%= simple_format(terms["cancellation_policy"]) %></div>
              </div>
            <% end %>
          </div>
        <% else %>
          <p class="rounded-md border border-dashed border-border-interactive bg-muted px-4 py-6 text-sm text-muted-foreground">Hotel terms are not configured.</p>
        <% end %>
      </section>
    </div>

    <aside class="space-y-5">
      <section class="rounded-lg border border-border bg-card p-5 shadow-sm">
        <h2 class="text-lg font-bold text-foreground">Actions</h2>
        <button type="button" onclick="window.print()" class="mt-4 w-full rounded-md bg-primary px-4 py-2.5 text-sm font-semibold text-primary-foreground shadow-sm hover:bg-primary-hover">Print official form</button>
        <% if current_user.has_permission?("manage_hotel_profile", hotel: current_hotel) %>
          <%= link_to "Configure displayed details", "#{hotel_settings_path(current_hotel, tab: "general")}#guest-registration-card", class: "mt-2 inline-flex w-full items-center justify-center rounded-md border border-border-interactive bg-card px-4 py-2.5 text-sm font-semibold text-foreground shadow-sm hover:bg-muted" %>
        <% end %>
      </section>

      <section class="rounded-lg border border-border bg-card p-5 shadow-sm">
        <h2 class="text-lg font-bold text-foreground">Signature</h2>
        <p class="mt-2 rounded-md border border-amber-200 bg-amber-50 px-3 py-2 text-sm leading-6 text-amber-900">
          Please read the terms and conditions carefully before signing. Your signature confirms the guest has reviewed the check-in, check-out, and hotel policy terms shown on this card.
        </p>

        <% if @card.signed? && @card.signature_data_url.present? %>
          <p class="mt-2 text-sm text-muted-foreground">Signed by <%= @card.signer_name %> at <%= l(@card.signed_at, format: :long) %></p>
          <div class="mt-4 rounded-md border border-border bg-muted p-3">
            <img src="<%= @card.signature_data_url %>" alt="Guest signature" class="h-24 max-w-full bg-card" />
          </div>
          <%= button_to "Remove signature", hotel_booking_guest_registration_card_path(current_hotel, @booking), method: :delete, class: "mt-4 w-full rounded-md border border-red-200 bg-card px-4 py-2 text-sm font-semibold text-red-700 hover:bg-red-50", form: { data: { turbo_confirm: "Remove this guest signature? The guest can sign again or sign the printed form." } } %>
        <% else %>
          <%= form_with model: @card, url: hotel_booking_guest_registration_card_path(current_hotel, @booking), method: :patch, class: "mt-4 space-y-4", data: { controller: "signature" } do |form| %>
            <div>
              <%= form.label :signer_name, "Signer name", class: "mb-1 block text-sm font-medium text-foreground" %>
              <%= form.text_field :signer_name, class: "block w-full rounded-md border border-border-interactive px-3 py-2 text-sm", required: true %>
            </div>

            <div>
              <label class="mb-1 block text-sm font-medium text-foreground">Signature</label>
              <canvas data-signature-target="canvas" class="h-44 w-full rounded-md border border-border-interactive bg-card"></canvas>
              <%= form.hidden_field :signature_data_url, data: { signature_target: "input" }, required: true %>
              <div class="mt-2 grid gap-2 sm:flex">
                <button type="button" data-action="signature#clear" class="rounded-md border border-border-interactive px-3 py-2 text-sm font-medium text-foreground">Clear</button>
                <%= form.submit "Save Signature", class: "rounded-md bg-primary px-4 py-2 text-sm font-semibold text-primary-foreground hover:bg-primary-hover" %>
              </div>
            </div>
          <% end %>
        <% end %>
      </section>
    </aside>
  </section>

  <article class="grc-print grc-print-page hidden overflow-hidden rounded-lg border border-border-interactive bg-card shadow-sm print:block print:rounded-none print:border-0 print:shadow-none">
    <header class="border-b-2 border-border-interactive px-7 py-6">
      <div class="flex flex-col gap-5 sm:flex-row sm:items-start sm:justify-between">
        <div class="space-y-4">
          <%= image_tag "logo/long-logo.png", alt: "WAStays", class: "h-8 w-auto" %>
          <p class="text-sm font-semibold uppercase text-muted-foreground">Guest Registration Card</p>
          <h2 class="mt-2 text-3xl font-black text-foreground"><%= current_hotel.name %></h2>
          <p class="mt-1 text-sm text-muted-foreground"><%= [current_hotel.city, current_hotel.country].compact_blank.join(", ") %></p>
        </div>
        <div class="min-w-64 overflow-hidden rounded-md border border-border-interactive bg-card">
          <div class="border-b border-border-interactive bg-muted px-4 py-2 text-center text-xs font-bold uppercase text-muted-foreground">GRC / Guest Registration No.</div>
          <div class="px-4 py-4 text-center text-2xl font-black text-foreground"><%= @booking.guest_registration_card_number_display %></div>
        </div>
      </div>
    </header>

    <section class="grid border-b border-border-interactive text-sm sm:grid-cols-2">
      <div class="border-b border-border-interactive p-5 sm:border-r">
        <p class="mb-3 text-xs font-bold uppercase text-muted-foreground">Guest details</p>
        <dl class="grid grid-cols-[7rem_1fr] gap-x-3 gap-y-2">
          <dt class="font-semibold text-muted-foreground">Name</dt><dd class="font-semibold"><%= guest_name %></dd>
          <% if @card.field_visible?(:phone) %><dt class="font-semibold text-muted-foreground">Phone</dt><dd><%= guest_phone %></dd><% end %>
          <% if @card.field_visible?(:email) %><dt class="font-semibold text-muted-foreground">Email</dt><dd><%= guest_email %></dd><% end %>
          <% if @card.field_visible?(:guest_count) %><dt class="font-semibold text-muted-foreground">Guests</dt><dd><%= @booking.adults.to_i %> adult(s), <%= @booking.children.to_i %> child(ren)</dd><% end %>
        </dl>
      </div>

      <div class="border-b border-border-interactive p-5">
        <p class="mb-3 text-xs font-bold uppercase text-muted-foreground">Stay details</p>
        <dl class="grid grid-cols-[7rem_1fr] gap-x-3 gap-y-2">
          <% if @card.field_visible?(:booking_number) %><dt class="font-semibold text-muted-foreground">Booking</dt><dd class="font-semibold"><%= @booking.confirmation_token %></dd><% end %>
          <% if @card.field_visible?(:room_type) %><dt class="font-semibold text-muted-foreground">Room type</dt><dd><%= room_type_summary %></dd><% end %>
          <% if @card.field_visible?(:check_in) %><dt class="font-semibold text-muted-foreground">Check-in</dt><dd><%= l(@booking.check_in.to_date) %></dd><% end %>
          <% if @card.field_visible?(:check_out) %><dt class="font-semibold text-muted-foreground">Check-out</dt><dd><%= l(@booking.check_out.to_date) %></dd><% end %>
          <% if @card.field_visible?(:room_number) %><dt class="font-semibold text-muted-foreground">Room(s)</dt><dd><%= @booking.room_numbers.presence || "To be assigned" %></dd><% end %>
        </dl>
      </div>
    </section>

    <section class="border-b border-border-interactive p-5">
      <div class="mb-4 flex items-center justify-between gap-4 border-b border-border pb-2">
        <h3 class="text-base font-black uppercase text-foreground">Terms and Conditions</h3>
        <span class="text-xs font-semibold text-muted-foreground">Snapshot at signing</span>
      </div>

      <p class="mb-4 rounded-md border border-border-interactive bg-muted px-4 py-3 text-sm leading-6 text-foreground">
        Please read the terms and conditions carefully before signing. Your signature confirms the guest has reviewed the check-in, check-out, and hotel policy terms shown on this card.
      </p>

      <% if terms.present? %>
        <div class="grid gap-3 text-sm sm:grid-cols-2">
          <div class="rounded-md border border-border bg-muted p-3">
            <p class="text-xs font-bold uppercase text-muted-foreground">Check-in</p>
            <p class="mt-1 font-semibold"><%= terms["check_in_time"].presence || "-" %></p>
          </div>
          <div class="rounded-md border border-border bg-muted p-3">
            <p class="text-xs font-bold uppercase text-muted-foreground">Check-out</p>
            <p class="mt-1 font-semibold"><%= terms["check_out_time"].presence || "-" %></p>
          </div>
          <% if terms["cancellation_policy"].present? %>
            <div class="rounded-md border border-border bg-muted p-3 sm:col-span-2">
              <p class="text-xs font-bold uppercase text-muted-foreground">Policy</p>
              <div class="mt-1 leading-relaxed text-foreground"><%= simple_format(terms["cancellation_policy"]) %></div>
            </div>
          <% end %>
        </div>
      <% else %>
        <p class="text-sm text-muted-foreground">Hotel terms are not configured.</p>
      <% end %>
    </section>

    <section class="flex justify-end p-5">
      <div class="min-h-44 w-full rounded-md border border-border-interactive p-4 sm:w-1/2">
        <p class="mb-3 text-xs font-bold uppercase text-muted-foreground">Guest signature</p>
        <% if @card.signed? && @card.signature_data_url.present? %>
          <img src="<%= @card.signature_data_url %>" alt="Guest signature" class="h-20 max-w-full bg-card" />
          <p class="mt-3 text-sm text-muted-foreground">Signed by <%= @card.signer_name %> at <%= l(@card.signed_at, format: :long) %></p>
        <% else %>
          <div class="mt-24 border-t border-border-interactive pt-2 text-sm text-muted-foreground">Signature</div>
        <% end %>
      </div>
    </section>

    <footer class="grc-print-footer flex items-center justify-between border-t border-border px-5 py-3 text-[10px] text-muted-foreground">
      <span>Generated <%= l(Time.current, format: :long) %></span>
      <span>Page 1 of 1</span>
    </footer>
  </article>

</div>
