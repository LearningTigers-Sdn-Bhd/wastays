<% content_for :title, "Guest Registration Card #{ @booking.guest_registration_card_number_display }" %>

<div class="mx-auto max-w-5xl px-4 py-6 text-foreground print:p-0" data-controller="registration-card" data-registration-card-url-value="<%= hotel_booking_guest_registration_card_path(current_hotel, @booking, booking_guest_id: @presenter.selected_booking_guest&.id) %>">
  <div class="grc-no-print mb-4">
    <div>
      <p class="text-xs font-semibold uppercase text-muted-foreground">Front desk document</p>
      <h1 class="text-2xl font-bold">Guest Registration Card</h1>
      <p class="mt-1 text-xs text-muted-foreground"><%= @presenter.hotel_registration_display %></p>
    </div>
  </div>

  <% if flash[:notice].present? %>
    <div class="grc-no-print mb-4 rounded-md bg-emerald-50 px-4 py-3 text-sm text-emerald-700"><%= flash[:notice] %></div>
  <% end %>

  <% if flash[:alert].present? %>
    <div class="grc-no-print mb-4 rounded-md bg-red-50 px-4 py-3 text-sm text-red-700"><%= flash[:alert] %></div>
  <% end %>

  <% if @card.errors.any? %>
    <div class="grc-no-print mb-4 rounded-md bg-red-50 px-4 py-3 text-sm text-red-700"><%= @card.errors.full_messages.to_sentence %></div>
  <% end %>

  <% terms_missing = !@card.ready_for_guest? %>
  <% if terms_missing %>
    <div class="grc-no-print mb-4 rounded-md border border-amber-200 bg-amber-50 px-4 py-3 text-sm text-amber-800">
      <p class="font-semibold">Terms &amp; Conditions required</p>
      <p class="mt-1">
        This card can't be signed, printed, or sent to the guest until the property's Terms &amp; Conditions are set.
        <% if @presenter.can_manage_hotel_profile?(current_user) %>
          <%= link_to "Set it in Settings", "#{hotel_settings_path(current_hotel, tab: "general")}#guest-registration-card", class: "font-semibold underline" %>.
        <% else %>
          Ask a hotel admin to add it.
        <% end %>
      </p>
    </div>
  <% end %>

  <% if @presenter.outstanding_balance? %>
    <% can_add_payment = @presenter.can_add_payment?(current_user) %>
    <%= render PanelsUI::Alert.new(
          tone: :warning,
          title: "Outstanding balance: #{@presenter.format_money(@presenter.due_amount)}",
          class: "grc-no-print mb-4") do |alert| %>
      <% alert.with_description do %>
        If payment has already been received, record it before printing or emailing this card.
        <% unless can_add_payment %>
          Ask an authorized staff member to record the payment.
        <% end %>
      <% end %>
      <% if can_add_payment %>
        <% alert.with_actions do %>
          <%= render PanelsUI::Button.new(
                href: hotel_folio_action_post_transaction_path(
                  current_hotel,
                  @booking,
                  transaction_type: "payment",
                  active_folio_id: @presenter.payment_folio.id,
                  amount: @presenter.due_amount.to_d.round(2).to_s("F"),
                  return_to: request.fullpath
                ),
                variant: :warning,
                size: :sm,
                data: { turbo_frame: "folio_action_sheet" }) do %>
            Add Payment
          <% end %>
        <% end %>
      <% end %>
    <% end %>
  <% end %>

  <section class="grc-no-print grid gap-5 lg:grid-cols-[1fr_380px]">
    <div class="space-y-5">
      <section class="overflow-hidden rounded-lg border border-border bg-card shadow-sm">
        <div class="border-b border-border bg-muted px-5 py-4">
          <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
            <div>
              <p class="text-xs font-semibold uppercase text-muted-foreground">Guest Registration No.</p>
              <p class="mt-1 text-2xl font-black text-foreground"><%= @booking.guest_registration_card_number_display %></p>
            </div>
            <% if @card.field_visible?(:booking_number) %>
              <div class="rounded-md border border-border bg-card px-3 py-2 text-sm font-semibold text-foreground">
                Booking <%= @booking.confirmation_token %>
              </div>
            <% end %>
          </div>
        </div>

        <div>
          <div class="border-b border-border p-5">
            <h2 class="mb-4 text-base font-semibold text-foreground">Guest details</h2>
            <dl class="grid gap-x-8 gap-y-4 sm:grid-cols-2">
              <div class="min-w-0">
                <dt class="text-xs font-medium text-muted-foreground">Name</dt>
                <dd class="mt-1 break-words text-sm font-medium text-foreground"><%= @presenter.guest_name %></dd>
              </div>
              <% if @card.field_visible?(:phone) %>
                <div class="min-w-0">
                  <dt class="text-xs font-medium text-muted-foreground">Phone</dt>
                  <dd class="mt-1 break-words text-sm font-medium text-foreground"><%= @presenter.guest_phone %></dd>
                </div>
              <% end %>
              <% if @card.field_visible?(:email) %>
                <div class="min-w-0">
                  <dt class="text-xs font-medium text-muted-foreground">Email</dt>
                  <dd class="mt-1 break-all text-sm font-medium text-foreground"><%= @presenter.guest_email %></dd>
                </div>
              <% end %>
              <% if @card.field_visible?(:nationality) %>
                <div class="min-w-0">
                  <dt class="text-xs font-medium text-muted-foreground">Nationality</dt>
                  <dd class="mt-1 break-words text-sm font-medium text-foreground"><%= @presenter.guest_country_display %></dd>
                </div>
              <% end %>
              <% if @card.field_visible?(:address) %>
                <div class="min-w-0 sm:col-span-2">
                  <dt class="text-xs font-medium text-muted-foreground">Address</dt>
                  <dd class="mt-1 whitespace-pre-line break-words text-sm font-medium text-foreground"><%= @presenter.guest_address_display %></dd>
                </div>
              <% end %>
              <% if @card.field_visible?(:guest_count) %>
                <div class="min-w-0">
                  <dt class="text-xs font-medium text-muted-foreground">Guests</dt>
                  <dd class="mt-1 break-words text-sm font-medium text-foreground"><%= @presenter.guest_count_display %></dd>
                </div>
              <% end %>
              <div class="min-w-0">
                <dt class="text-xs font-medium text-muted-foreground">Identity</dt>
                <dd class="mt-1 break-words text-sm font-medium text-foreground"><%= @presenter.guest_identity %></dd>
              </div>
            </dl>
          </div>

          <div class="border-b border-border p-5">
            <h2 class="mb-4 text-base font-semibold text-foreground">Stay details</h2>
            <dl class="grid gap-x-8 gap-y-4 sm:grid-cols-2">
              <% if @card.field_visible?(:booking_number) %>
                <div class="min-w-0">
                  <dt class="text-xs font-medium text-muted-foreground">Booking</dt>
                  <dd class="mt-1 break-words text-sm font-medium text-foreground"><%= @booking.confirmation_token %></dd>
                </div>
              <% end %>
              <% if @card.field_visible?(:room_type) %>
                <div class="min-w-0">
                  <dt class="text-xs font-medium text-muted-foreground">Room type</dt>
                  <dd class="mt-1 break-words text-sm font-medium text-foreground"><%= @presenter.room_type_summary %></dd>
                </div>
              <% end %>
              <% if @card.field_visible?(:room_number) %>
                <div class="min-w-0">
                  <dt class="text-xs font-medium text-muted-foreground">Room(s)</dt>
                  <dd class="mt-1 break-words text-sm font-medium text-foreground"><%= @presenter.room_numbers_display %></dd>
                </div>
              <% end %>
              <div class="min-w-0">
                <dt class="text-xs font-medium text-muted-foreground">Rate type</dt>
                <dd class="mt-1 break-words text-sm font-medium text-foreground"><%= @presenter.rate_type_display %></dd>
              </div>
              <% if @card.field_visible?(:check_in) %>
                <div class="min-w-0">
                  <dt class="text-xs font-medium text-muted-foreground">Check-in</dt>
                  <dd class="mt-1 text-sm font-medium tabular-nums text-foreground"><%= @presenter.check_in_display %></dd>
                </div>
              <% end %>
              <div class="min-w-0">
                <dt class="text-xs font-medium text-muted-foreground">Night(s)</dt>
                <dd class="mt-1 text-sm font-medium tabular-nums text-foreground"><%= @booking.duration_in_nights %></dd>
              </div>
              <% if @card.field_visible?(:check_out) %>
                <div class="min-w-0">
                  <dt class="text-xs font-medium text-muted-foreground">Check-out</dt>
                  <dd class="mt-1 text-sm font-medium tabular-nums text-foreground"><%= @presenter.check_out_display %></dd>
                </div>
              <% end %>
            </dl>
          </div>

          <div class="p-5">
            <h2 class="mb-4 text-base font-semibold text-foreground">Payment details</h2>
            <dl class="grid gap-x-8 gap-y-4 sm:grid-cols-2">
              <div class="min-w-0">
                <dt class="text-xs font-medium text-muted-foreground">Room price</dt>
                <dd class="mt-1 text-sm font-medium tabular-nums text-foreground"><%= @presenter.room_price_display %></dd>
              </div>
              <div class="min-w-0">
                <dt class="text-xs font-medium text-muted-foreground">Amount paid</dt>
                <dd class="mt-1 text-sm font-medium tabular-nums text-foreground"><%= @presenter.format_money(@presenter.amount_paid) %></dd>
              </div>
              <div class="min-w-0">
                <dt class="text-xs font-medium text-muted-foreground">Total charges</dt>
                <dd class="mt-1 text-sm font-medium tabular-nums text-foreground"><%= @presenter.format_money(@presenter.total_charges) %></dd>
              </div>
              <div class="min-w-0">
                <dt class="text-xs font-medium text-muted-foreground">Tax</dt>
                <dd class="mt-1 text-sm font-medium tabular-nums text-foreground"><%= @presenter.format_money(@booking.tax_total) %></dd>
              </div>
              <div class="border-t border-border pt-4 sm:col-span-2">
                <dt class="text-xs font-medium text-muted-foreground">Due amount</dt>
                <dd class="mt-1 text-base font-semibold tabular-nums text-destructive"><%= @presenter.format_money(@presenter.due_amount) %></dd>
              </div>
            </dl>
          </div>

          <% if @presenter.boat_transfer? %>
            <div class="border-t border-border p-5">
              <h2 class="mb-4 text-base font-semibold text-foreground">Boat transfer</h2>
              <dl class="grid gap-x-8 gap-y-4 sm:grid-cols-2">
                <div class="min-w-0">
                  <dt class="text-xs font-medium text-muted-foreground">Boat-in</dt>
                  <dd class="mt-1 text-sm font-medium tabular-nums text-foreground"><%= @presenter.boat_in_display %></dd>
                </div>
                <div class="min-w-0">
                  <dt class="text-xs font-medium text-muted-foreground">Boat-out</dt>
                  <dd class="mt-1 text-sm font-medium tabular-nums text-foreground"><%= @presenter.boat_out_display %></dd>
                </div>
              </dl>
            </div>
          <% end %>
        </div>
      </section>

      <section>
        <% if @presenter.terms.present? %>
          <div class="grid gap-3 md:grid-cols-2">
            <% if @presenter.cancellation_summary.present? %>
              <div class="rounded-md border border-border p-4 md:col-span-2">
                <p class="text-xs font-bold uppercase text-muted-foreground">Cancellation Policy</p>
                <div class="mt-2">
                  <%= render "hotel_portal/bookings/guest_registration_cards/cancellation_policy", summary: @presenter.cancellation_summary %>
                </div>
              </div>
            <% end %>
          </div>
        <% else %>
          <p class="rounded-md border border-dashed border-border-interactive bg-muted px-4 py-6 text-sm text-muted-foreground">Hotel terms are not configured.</p>
        <% end %>
      </section>

      <div class="space-y-4 !mt-2">
        <div class="space-y-2">
          <label for="guest_registration_card_special_requests" class="text-xs font-bold uppercase text-muted-foreground">Remark</label>
          <textarea id="guest_registration_card_special_requests" 
                    class="w-full rounded-md border border-border bg-card p-4 min-h-[4rem] text-sm font-medium text-foreground focus:border-border-interactive focus:ring-0 resize-y" 
                    data-registration-card-target="remarkInput" 
                    data-action="input->registration-card#onInput"><%= @booking.special_requests %></textarea>
        </div>

        <div class="flex flex-col gap-2 sm:flex-row sm:items-center sm:justify-between min-h-[2.5rem]">
          <p class="text-xs text-muted-foreground"></p>
          <div data-registration-card-target="status" class="text-xs font-bold text-emerald-600 flex items-center gap-1.5 opacity-0 transition-opacity duration-200 min-h-[20px]"></div>
        </div>
      </div>
    </div>

    <aside class="space-y-5">
      <section class="rounded-lg border border-border bg-card p-5 shadow-sm">
        <h2 class="text-base font-semibold text-foreground">Actions</h2>
        <% if terms_missing %>
          <p class="mt-4 rounded-md border border-dashed border-border-interactive px-4 py-2.5 text-center text-xs text-muted-foreground">Set Terms &amp; Conditions to enable printing.</p>
        <% else %>
          <%= render PanelsUI::Button.new(
                href: hotel_booking_guest_registration_card_pdf_path(current_hotel, @booking, booking_guest_id: @presenter.selected_booking_guest&.id),
                target: "_blank",
                rel: "noopener",
                variant: :primary,
                class: "mt-4 w-full justify-center") do %>Print official form<% end %>
        <% end %>
        <% if @presenter.can_manage_bookings?(current_user) %>
          <% if terms_missing %>
            <p class="mt-2 rounded-md border border-dashed border-border-interactive px-4 py-2.5 text-center text-xs text-muted-foreground">Set Terms &amp; Conditions to enable sending.</p>
          <% elsif @presenter.guest_email.present? %>
            <%= form_with url: hotel_booking_guest_registration_card_email_path(current_hotel, @booking, booking_guest_id: @presenter.selected_booking_guest&.id), method: :post, class: "mt-2" do %>
              <%= render PanelsUI::Button.new(
                    as: :button,
                    type: :submit,
                    variant: :neutral,
                    class: "w-full justify-center",
                    data: { turbo_confirm: "Email this registration card to #{@presenter.guest_email}?" }) do %>Email to guest<% end %>
            <% end %>
          <% else %>
            <p class="mt-2 rounded-md border border-dashed border-border-interactive px-4 py-2.5 text-center text-xs text-muted-foreground">Add a guest email to send this card.</p>
          <% end %>
        <% end %>
        <% if @presenter.can_manage_hotel_profile?(current_user) %>
          <%= render PanelsUI::Button.new(
                href: "#{hotel_settings_path(current_hotel, tab: "general")}#guest-registration-card",
                variant: :neutral,
                class: "mt-2 w-full justify-center") do %>Configure displayed details<% end %>
        <% end %>
      </section>

      <section class="rounded-lg border border-border bg-card p-5 shadow-sm">
        <h2 class="text-base font-semibold text-foreground">Signature</h2>
        <div class="mt-3">
          <%= render PanelsUI::Alert.new(tone: :default, title: "Review before signing") do |alert| %>
            <% alert.with_description do %>
              Collect the guest's digital signature here, or ask the guest to sign the printed form. The signature confirms that the guest reviewed the check-in, check-out, and hotel policy terms shown on this card.
            <% end %>
            <% if @presenter.terms_and_conditions.present? %>
              <% alert.with_actions do %>
                <%= render PanelsUI::Button.new(as: :button, type: :button, variant: :ghost, size: :xs,
                      command: "show-modal", commandfor: "grc-terms-dialog") do %>View T&amp;C<% end %>
              <% end %>
            <% end %>
          <% end %>
        </div>

        <% if @presenter.signed_for_active_guest? %>
          <p class="mt-2 text-sm text-muted-foreground">Signed by <%= @presenter.signer_name %> at <%= @presenter.signed_at ? l(@presenter.signed_at, format: :long) : "-" %></p>
          <div class="mt-4 rounded-md border border-border-interactive bg-card p-2">
            <img src="<%= @presenter.signature_data_url %>" alt="Guest signature" class="h-36 w-full object-contain" />
          </div>
          <%= form_with url: hotel_booking_guest_registration_card_path(current_hotel, @booking, booking_guest_id: @presenter.selected_booking_guest&.id), method: :delete, class: "mt-4" do %>
            <%= render PanelsUI::Button.new(
                  as: :button,
                  type: :submit,
                  variant: :destructive,
                  class: "w-full justify-center",
                  data: { turbo_confirm: "Remove this guest signature? The guest can sign again or sign the printed form." }) do %>Remove signature<% end %>
          <% end %>
        <% elsif terms_missing %>
          <p class="mt-4 rounded-md border border-dashed border-border-interactive bg-muted px-4 py-6 text-center text-sm text-muted-foreground">Set the property's Terms &amp; Conditions before this card can be signed.</p>
        <% else %>
          <%= form_with model: @card, url: hotel_booking_guest_registration_card_path(current_hotel, @booking, booking_guest_id: @presenter.selected_booking_guest&.id), method: :patch, id: "grc-signature-form", class: "mt-4 space-y-4", data: { controller: "signature" } do |form| %>
            <%= form.hidden_field :special_requests, value: @booking.special_requests, data: { registration_card_target: "remarkHidden" } %>
            <div>
              <%= form.label :signer_name, "Signer name", class: "mb-1 block text-sm font-medium text-foreground" %>
              <%= form.text_field :signer_name, value: @presenter.guest_name, class: "block w-full rounded-md border border-border px-3 py-2 text-sm text-foreground bg-background focus:border-border-interactive focus:outline-none focus:ring-0", required: true %>
            </div>

            <div>
              <label class="mb-1 block text-sm font-medium text-foreground">Signature</label>
              <canvas data-signature-target="canvas" class="h-36 w-full touch-none rounded-md border border-border-interactive bg-card"></canvas>
              <%= form.hidden_field :signature_data_url, data: { signature_target: "input" }, required: true %>
              <div class="mt-2 grid gap-2 sm:flex">
                <%= render PanelsUI::Button.new(as: :button, type: :button, variant: :secondary, data: { action: "signature#clear" }) do %>Clear<% end %>
                <%= render PanelsUI::Button.new(as: :button, type: :submit, variant: :primary) do %>Save Signature<% end %>
              </div>
            </div>
          <% end %>
        <% end %>
      </section>
    </aside>
  </section>

  <% if @presenter.terms_and_conditions.present? %>
    <%= render PanelsUI::Dialog.new(id: "grc-terms-dialog", title: "Terms & Conditions", size: :lg) do |dialog| %>
      <% dialog.with_body do %>
        <div class="whitespace-pre-wrap text-sm text-foreground"><%= @presenter.terms_and_conditions %></div>
      <% end %>
    <% end %>
  <% end %>

  <article class="grc-print grc-print-page hidden overflow-hidden print:overflow-visible rounded-lg border border-border-interactive bg-card shadow-sm print:block print:rounded-none print:border-0 print:shadow-none">
    <header class="border-b-2 border-border-interactive px-6 py-3 print:px-0 print:pt-0 print:pb-2">
      <div class="flex flex-col gap-5 sm:flex-row sm:items-start sm:justify-between">
        <div class="flex flex-col print:gap-1">
          <%= image_tag "logo/long-logo.png", alt: "WAStays", class: "h-8 w-auto" %>
          <h2 class="mt-2 text-md font-black text-foreground print:mt-0.5 print:text-sm print:leading-tight"><%= current_hotel.name %></h2>
          <p class="mt-1 text-sm text-muted-foreground print:mt-0 print:text-xs print:leading-tight"><%= @presenter.hotel_address_display %></p>
          <p class="mt-1 text-xs text-muted-foreground print:mt-0 print:text-xs print:leading-tight"><%= @presenter.hotel_registration_display %></p>
        </div>
        <div class="min-w-64 overflow-hidden rounded-md border border-border-interactive bg-card">
          <div class="border-b border-border-interactive bg-muted px-4 py-2 text-center text-xs font-bold uppercase text-muted-foreground">Guest Registration Card No.</div>
          <div class="px-4 py-2 text-center text-md font-black text-foreground"><%= @booking.guest_registration_card_number_display %></div>
        </div>
      </div>
    </header>
 
    <section class="border-b border-border-interactive text-sm">
      <div class="border-b border-border-interactive p-2.5">
        <p class="text-xs font-bold uppercase font-semibold text-foreground">Guest details</p>
        <dl class="grid grid-cols-2 gap-x-12">
          <div class="grid grid-cols-[6.6rem_1fr] gap-x-2"><dt class="font-semibold text-muted-foreground">Name</dt><dd class="text-foreground">: <%= @presenter.guest_name %></dd></div>
          <% if @card.field_visible?(:phone) %><div class="grid grid-cols-[6.6rem_1fr] gap-x-2"><dt class="font-semibold text-muted-foreground">Phone</dt><dd class="text-foreground">: <%= @presenter.guest_phone %></dd></div><% end %>
          <% if @card.field_visible?(:email) %><div class="grid grid-cols-[6.6rem_1fr] gap-x-2"><dt class="font-semibold text-muted-foreground">Email</dt><dd class="break-all text-foreground">: <%= @presenter.guest_email %></dd></div><% end %>
          <% if @card.field_visible?(:address) %><div class="col-span-2 grid grid-cols-[6.6rem_1fr] gap-x-2"><dt class="font-semibold text-muted-foreground">Address</dt><dd class="whitespace-pre-line text-foreground">: <%= @presenter.guest_address_display %></dd></div><% end %>
          <% if @card.field_visible?(:nationality) %><div class="grid grid-cols-[6.6rem_1fr] gap-x-2"><dt class="font-semibold text-muted-foreground">Nationality</dt><dd class="text-foreground">: <%= @presenter.guest_country_display %></dd></div><% end %>
          <% if @card.field_visible?(:guest_count) %><div class="grid grid-cols-[6.6rem_1fr] gap-x-2"><dt class="font-semibold text-muted-foreground">Guests</dt><dd class="text-foreground">: <%= @presenter.guest_count_display %></dd></div><% end %>
          <div class="grid grid-cols-[6.6rem_1fr] gap-x-2"><dt class="font-semibold text-muted-foreground">Identity</dt><dd class="text-foreground">: <%= @presenter.guest_identity %></dd></div>
        </dl>
      </div>
 
      <div class="border-b border-border-interactive p-2.5">
        <p class="text-xs font-bold uppercase font-semibold text-foreground">Stay details</p>
        <dl class="grid grid-cols-2 gap-x-6">
          <% if @card.field_visible?(:booking_number) %><div class="grid grid-cols-[4.6rem_1fr] gap-x-2"><dt class="font-semibold text-muted-foreground">Booking</dt><dd class="text-foreground">: <%= @booking.confirmation_token %></dd></div><% end %>
          <% if @card.field_visible?(:room_type) %><div class="grid grid-cols-[6.6rem_1fr] gap-x-2"><dt class="font-semibold text-muted-foreground">Room type</dt><dd class="text-foreground">: <%= @presenter.room_type_summary %></dd></div><% end %>
          <% if @card.field_visible?(:room_number) %><div class="grid grid-cols-[4.6rem_1fr] gap-x-2"><dt class="font-semibold text-muted-foreground">Room(s)</dt><dd class="text-foreground">: <%= @presenter.room_numbers_display %></dd></div><% end %>
          <div class="grid grid-cols-[6.6rem_1fr] gap-x-2"><dt class="font-semibold text-muted-foreground">Rate type</dt><dd class="text-foreground">: <%= @presenter.rate_type_display %></dd></div>
          <div class="grid grid-cols-[4.6rem_1fr] gap-x-2"><dt class="font-semibold text-muted-foreground">Night(s)</dt><dd class="text-foreground">: <%= @booking.duration_in_nights %></dd></div>
          <% if @card.field_visible?(:check_in) %><div class="grid grid-cols-[6.6rem_1fr] gap-x-2"><dt class="font-semibold text-muted-foreground">Check-in</dt><dd class="text-foreground">: <%= @presenter.check_in_display %></dd></div><% end %>
          <% if @card.field_visible?(:check_out) %><div class="grid grid-cols-[4.6rem_1fr] gap-x-2"><dt class="font-semibold text-muted-foreground">Check-out</dt><dd class="text-foreground">: <%= @presenter.check_out_display %></dd></div><% end %>
        </dl>
      </div>

      <div class="p-2.5">
        <p class="text-xs font-bold uppercase font-semibold text-foreground">Payment details</p>
        <dl class="grid grid-cols-2 gap-x-6">
          <div class="grid grid-cols-[6.6rem_1fr] gap-x-2"><dt class="font-semibold text-muted-foreground">Room price</dt><dd class="text-foreground">: <%= @presenter.room_price_display %></dd></div>
          <div class="grid grid-cols-[4.6rem_1fr] gap-x-2"><dt class="font-semibold text-muted-foreground">Amount paid</dt><dd class="text-foreground">: <%= @presenter.format_money(@presenter.amount_paid) %></dd></div>
          <div class="grid grid-cols-[6.6rem_1fr] gap-x-2"><dt class="font-semibold text-muted-foreground">Total charges</dt><dd class="text-foreground">: <%= @presenter.format_money(@presenter.total_charges) %></dd></div>
          <div class="grid grid-cols-[4.6rem_1fr] gap-x-2"><dt class="font-semibold text-muted-foreground">Tax</dt><dd class="text-foreground">: <%= @presenter.format_money(@booking.tax_total) %></dd></div>
          <div class="grid grid-cols-[6.6rem_1fr] gap-x-2"><dt class="font-semibold text-muted-foreground">Due amount</dt><dd class="font-semibold text-rose-600">: <%= @presenter.format_money(@presenter.due_amount) %></dd></div>
        </dl>
      </div>

      <% if @presenter.boat_transfer? %>
        <div class="border-t border-border-interactive p-2.5">
          <p class="text-xs font-bold uppercase font-semibold text-foreground">Boat transfer</p>
          <dl class="grid grid-cols-2 gap-x-6">
            <div class="grid grid-cols-[4.6rem_1fr] gap-x-2"><dt class="font-semibold text-muted-foreground">Boat-in</dt><dd class="text-foreground">: <%= @presenter.boat_in_display %></dd></div>
            <div class="grid grid-cols-[4.6rem_1fr] gap-x-2"><dt class="font-semibold text-muted-foreground">Boat-out</dt><dd class="text-foreground">: <%= @presenter.boat_out_display %></dd></div>
          </dl>
        </div>
      <% end %>
    </section>

    <section>
      <% if @presenter.terms.present? %>
        <div class="grid gap-2 text-xs sm:grid-cols-2">
          <% if @presenter.terms_and_conditions.present? %>
            <div class="rounded-md border border-border bg-muted p-2 sm:col-span-2">
              <p class="text-[10px] font-bold uppercase text-muted-foreground">Terms &amp; Conditions</p>
              <div class="mt-0.5 whitespace-pre-wrap text-foreground"><%= @presenter.terms_and_conditions %></div>
            </div>
          <% end %>
          <% if @presenter.cancellation_summary.present? %>
            <div class="rounded-md border border-border bg-muted p-2 sm:col-span-2">
              <p class="text-[10px] font-bold uppercase text-muted-foreground">Cancellation Policy</p>
              <div class="mt-0.5">
                <%= render "hotel_portal/bookings/guest_registration_cards/cancellation_policy", summary: @presenter.cancellation_summary, compact: true %>
              </div>
            </div>
          <% end %>
        </div>
      <% else %>
        <p class="text-xs text-muted-foreground">Hotel terms are not configured.</p>
      <% end %>
    </section>

    <section class="border-b border-border-interactive p-2.5">
      <p class="mb-1 text-xs font-bold uppercase text-muted-foreground">Remark</p>
      <div class="min-h-[5rem] w-full bg-card text-sm whitespace-pre-wrap text-foreground" data-registration-card-target="remarkPrint"><%= @booking.special_requests %></div>
    </section>
  
    <section class="flex justify-end p-2.5">
      <div class="min-h-25 w-full rounded-md border border-border-interactive p-3 sm:w-1/2">
        <p class="mb-4 text-xs font-bold uppercase text-muted-foreground">Guest signature</p>
        <% if @presenter.signed_for_active_guest? %>
          <img src="<%= @presenter.signature_data_url %>" alt="Guest signature" class="h-16 max-w-full bg-card" />
          <p class="mt-2 text-xs text-muted-foreground">Signed by <%= @presenter.signer_name %> at <%= @presenter.signed_at ? l(@presenter.signed_at, format: :long) : "-" %></p>
        <% else %>
          <div class="mt-8 border-t border-border-interactive pt-1 text-xs text-muted-foreground">Signature</div>
        <% end %>
      </div>
    </section>
 
    <footer class="grc-print-footer flex items-center justify-between border-t border-border px-4 py-2 text-[10px] text-muted-foreground">
      <span>Generated <%= l(Time.current, format: :long) %></span>
      <span>Page 1 of 1</span>
    </footer>
  </article>

</div>
