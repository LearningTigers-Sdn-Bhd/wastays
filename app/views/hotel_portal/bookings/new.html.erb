<% is_reservation_board = params[:controller].include?("reservation_board") %>
<% back_path = is_reservation_board ? hotel_reservation_board_index_path(current_hotel) : hotel_bookings_path(current_hotel) %>
<% form_url = is_reservation_board ? hotel_reservation_board_bookings_path(current_hotel) : hotel_bookings_path(current_hotel) %>

<% content_for :breadcrumbs do %>
  <div class="flex items-center gap-x-2">
    <span class="text-sm font-medium text-slate-600"><%= current_hotel.name %></span>
    <span class="text-sm text-slate-400">/</span>
    <%= link_to is_reservation_board ? "Reservation Board" : "Bookings", back_path, class: "text-sm font-medium text-slate-600 hover:text-slate-900" %>
    <span class="text-sm text-slate-400">/</span>
    <span class="text-sm font-semibold text-slate-900">New Booking</span>
  </div>
<% end %>

<div class="max-w-4xl mx-auto pb-20">
  <div class="mt-5 mb-5">
    <%= link_to back_path, class: "inline-flex items-center gap-x-1.5 text-sm text-gray-600 hover:text-blue-600" do %>
      <svg class="flex-shrink-0 size-4" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg>
      Back to <%= is_reservation_board ? "Reservation Board" : "Bookings" %>
    <% end %>
  </div>

  <%= form_with model: @booking, url: form_url, local: true, class: "space-y-8", 
      data: { 
        controller: "booking-calc room-lock", 
        room_lock_url_value: hotel_room_locks_path(current_hotel),
        booking_calc_availability_url_value: availability_hotel_bookings_path(current_hotel),
        booking_calc_price_url_value: stay_price_hotel_bookings_path(current_hotel)
      } do |f| %>
    
    <% if @booking.errors.any? %>
      <!-- ... error block remains same ... -->
    <% end %>

    <!-- Guest Information Card -->
    <div class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">
      <div class="border-b border-slate-200 bg-slate-50/70 px-6 py-6 sm:px-8">
        <h1 class="text-2xl font-bold text-gray-800">Add New Booking</h1>
        <p class="text-sm text-gray-600 mt-1">Manually enter a reservation for your property.</p>
      </div>
      <div class="p-6 sm:p-8 space-y-6">
        <h3 class="text-sm font-bold text-slate-900 border-b border-slate-100 pb-2 mb-4">Guest Information</h3>
        <div>
          <%= f.label :guest_name, "Full Name", class: "block text-[11px] font-bold text-slate-500 uppercase tracking-wider mb-2" %>
          <%= f.text_field :guest_name, required: true, placeholder: "John Doe", class: "w-full rounded-xl border border-slate-200 bg-white px-4 py-2.5 text-sm font-medium text-slate-700 focus:border-slate-300 focus:outline-none focus:ring-0 shadow-sm" %>
        </div>
        <div class="grid sm:grid-cols-2 gap-6">
          <div>
            <%= f.label :guest_email, "Email Address", class: "block text-[11px] font-bold text-slate-500 uppercase tracking-wider mb-2" %>
            <%= f.email_field :guest_email, required: true, placeholder: "john@example.com", class: "w-full rounded-xl border border-slate-200 bg-white px-4 py-2.5 text-sm font-medium text-slate-700 focus:border-slate-300 focus:outline-none focus:ring-0 shadow-sm" %>
          </div>
          <div>
            <%= f.label :guest_phone, "Phone Number", class: "block text-[11px] font-bold text-slate-500 uppercase tracking-wider mb-2" %>
            <%= f.telephone_field :guest_phone, required: true, placeholder: "+60 12-345 6789", class: "w-full rounded-xl border border-slate-200 bg-white px-4 py-2.5 text-sm font-medium text-slate-700 focus:border-slate-300 focus:outline-none focus:ring-0 shadow-sm" %>
          </div>
        </div>
      </div>
    </div>

    <!-- Stay Details -->
    <div class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">
      <div class="border-b border-slate-200 bg-slate-50/70 px-6 py-5 sm:px-8">
        <h2 class="text-lg font-bold tracking-tight text-slate-950">Stay & Room Details</h2>
        <p class="mt-1 text-sm font-medium text-slate-600">Select dates and room category.</p>
      </div>
      <div class="p-6 sm:p-8 space-y-6">
        <div class="grid sm:grid-cols-2 gap-6">
          <div>
            <%= f.label :check_in, "Check-in Date", class: "block text-[11px] font-bold text-slate-500 uppercase tracking-wider mb-2" %>
            <%= f.date_field :check_in, required: true, class: "w-full rounded-xl border border-slate-200 bg-white px-4 py-2.5 text-sm font-medium text-slate-700 focus:border-slate-300 focus:outline-none focus:ring-0 shadow-sm", data: { booking_calc_target: "checkIn", action: "change->booking-calc#calculate" } %>
          </div>
          <div>
            <%= f.label :check_out, "Check-out Date", class: "block text-[11px] font-bold text-slate-500 uppercase tracking-wider mb-2" %>
            <%= f.date_field :check_out, required: true, class: "w-full rounded-xl border border-slate-200 bg-white px-4 py-2.5 text-sm font-medium text-slate-700 focus:border-slate-300 focus:outline-none focus:ring-0 shadow-sm", data: { booking_calc_target: "checkOut", action: "change->booking-calc#calculate" } %>
          </div>
        </div>

        <div class="grid sm:grid-cols-2 gap-6">
          <div>
            <%= f.label :adults, class: "block text-[11px] font-bold text-slate-500 uppercase tracking-wider mb-2" %>
            <%= f.number_field :adults, required: true, min: 1, class: "w-full rounded-xl border border-slate-200 bg-white px-4 py-2.5 text-sm font-medium text-slate-700 focus:border-slate-300 focus:outline-none focus:ring-0 shadow-sm" %>
          </div>
          <div>
            <%= f.label :children, class: "block text-[11px] font-bold text-slate-500 uppercase tracking-wider mb-2" %>
            <%= f.number_field :children, required: true, min: 0, class: "w-full rounded-xl border border-slate-200 bg-white px-4 py-2.5 text-sm font-medium text-slate-700 focus:border-slate-300 focus:outline-none focus:ring-0 shadow-sm" %>
          </div>
        </div>

        <div class="grid sm:grid-cols-2 gap-6">
          <div>
            <label class="block text-[11px] font-bold text-slate-500 uppercase tracking-wider mb-2">Room Category</label>
            <%= f.collection_select :room_type_id, @room_types, :id, :name, { selected: @room_type_id, prompt: "Select a category" }, 
                { class: "w-full rounded-xl border border-slate-200 bg-white px-4 py-2.5 text-sm font-medium text-slate-700 focus:border-slate-300 focus:outline-none focus:ring-0 shadow-sm", 
                  data: { 
                    booking_calc_target: "roomType", 
                    action: "change->booking-calc#updateRoomNumbers change->booking-calc#calculate", 
                    prices: @room_types.map { |rt| [rt.id, rt.base_price] }.to_h.to_json,
                    room_numbers: @room_types.map { |rt| [rt.id, rt.room_numbers] }.to_h.to_json
                  } 
                } %>
          </div>
          <div class="<%= @room_number.present? ? '' : 'hidden' %>" data-booking-calc-target="roomNumberContainer">
            <label for="booking_room_number" class="block text-[11px] font-bold text-slate-500 uppercase tracking-wider mb-2">Room Number</label>
            <%= f.select :room_number, (@room_number.present? ? [[@room_number, @room_number]] : []), { selected: @room_number, prompt: "Select a room" }, 
                { id: "booking_room_number",
                  required: true,
                  class: "w-full rounded-xl border border-slate-200 bg-white px-4 py-2.5 text-sm font-medium text-slate-700 focus:border-slate-300 focus:outline-none focus:ring-0 shadow-sm", 
                  data: { 
                    booking_calc_target: "roomNumberSelect",
                    action: "change->room-lock#lock"
                  } 
                } %>
          </div>
        </div>
      </div>
    </div>

    <!-- Pricing Summary -->
    <div class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">
      <div class="border-b border-slate-200 bg-slate-50/70 px-6 py-5 sm:px-8">
        <h2 class="text-lg font-bold tracking-tight text-slate-950">Payment Summary</h2>
        <p class="mt-1 text-sm font-medium text-slate-600">Total amount for this stay.</p>
      </div>
      <div class="p-6 sm:p-8">
        <div class="flex items-center justify-between p-6 bg-slate-50 rounded-2xl border border-slate-200">
          <div>
            <p class="text-xs font-bold text-slate-500 uppercase tracking-widest">Calculated Total</p>
            <p class="text-2xl font-black text-slate-900 mt-1">MYR <span data-booking-calc-target="displayTotal">0.00</span></p>
          </div>
          <div class="w-1/3">
             <label class="block text-[10px] font-bold text-slate-500 uppercase tracking-wider mb-1 text-right">Adjust Price (Optional)</label>
             <div class="relative">
                <span class="absolute inset-y-0 left-0 flex items-center pl-3 text-slate-400 text-sm font-bold">MYR</span>
                <%= f.number_field :total_amount, step: 0.01, class: "w-full rounded-xl border border-slate-200 bg-white py-2 pl-12 pr-4 text-sm font-bold text-slate-900 focus:border-slate-300 focus:outline-none focus:ring-0 shadow-sm text-right", data: { booking_calc_target: "totalInput" } %>
             </div>
          </div>
        </div>
      </div>
    </div>

    <div class="flex items-center justify-end gap-x-4">
      <%= link_to "Cancel", hotel_bookings_path(current_hotel), class: "px-6 py-3 text-sm font-bold text-slate-600 hover:bg-slate-50 rounded-xl transition" %>
      <%= f.submit "Confirm & Create Booking", class: "inline-flex items-center rounded-xl bg-slate-900 px-8 py-3 text-sm font-bold text-white shadow-sm transition hover:bg-slate-700" %>
    </div>
  <% end %>
</div>
