<div class="space-y-8 animate-in fade-in duration-300">
  <!-- Guest Information -->
  <div class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">
    <div class="border-b border-slate-200 bg-slate-50/70 px-6 py-5 sm:px-8">
      <h2 class="text-lg font-bold tracking-tight text-slate-950">Guest Information</h2>
      <p class="mt-1 text-sm font-medium text-slate-600">Contact details and identity information.</p>
    </div>
    <div class="p-6 sm:p-8">
      <%= form_with model: booking, url: hotel_booking_path(current_hotel, booking), method: :patch, local: true, class: "space-y-6" do |f| %>
        <div class="grid sm:grid-cols-2 gap-6">
          <div class="sm:col-span-2">
            <label class="block text-[11px] font-bold text-slate-500 uppercase tracking-wider mb-2">Full Guest Name</label>
            <%= f.text_field :guest_name, class: "w-full rounded-xl border border-slate-200 bg-white px-4 py-2.5 text-sm font-medium text-slate-700 focus:border-slate-300 focus:outline-none focus:ring-0 shadow-sm" %>
          </div>
          <div>
            <label class="block text-[11px] font-bold text-slate-500 uppercase tracking-wider mb-2">Email Address</label>
            <%= f.email_field :guest_email, class: "w-full rounded-xl border border-slate-200 bg-white px-4 py-2.5 text-sm font-medium text-slate-700 focus:border-slate-300 focus:outline-none focus:ring-0 shadow-sm" %>
          </div>
          <div>
            <label class="block text-[11px] font-bold text-slate-500 uppercase tracking-wider mb-2">Phone Number</label>
            <%= f.telephone_field :guest_phone, class: "w-full rounded-xl border border-slate-200 bg-white px-4 py-2.5 text-sm font-medium text-slate-700 focus:border-slate-300 focus:outline-none focus:ring-0 shadow-sm" %>
          </div>
        </div>

        <% if !booking.pre_checkin_completed? && (booking.id_front.attached? || booking.id_back.attached?) %>
          <div class="pt-6 border-t border-slate-100">
            <dt class="text-[11px] font-bold text-slate-500 uppercase tracking-wider mb-4">Identity Verification</dt>
            <div class="grid sm:grid-cols-2 gap-6">
              <% if booking.id_front.attached? %>
                <div class="space-y-2">
                  <div class="flex items-center justify-between">
                    <span class="text-[10px] font-black uppercase tracking-widest text-slate-400">Front Side / Passport</span>
                  </div>
                  <div class="relative w-full aspect-[1.586/1] rounded-xl border border-slate-200 bg-slate-50 overflow-hidden shadow-sm flex items-center justify-center">
                    <%= image_tag booking.id_front, class: "max-w-full max-h-full object-contain" %>
                  </div>
                </div>
              <% end %>

              <% if booking.id_back.attached? %>
                <div class="space-y-2">
                  <div class="flex items-center justify-between">
                    <span class="text-[10px] font-black uppercase tracking-widest text-slate-400">Back Side</span>
                  </div>
                  <div class="relative w-full aspect-[1.586/1] rounded-xl border border-slate-200 bg-slate-50 overflow-hidden shadow-sm flex items-center justify-center">
                    <%= image_tag booking.id_back, class: "max-w-full max-h-full object-contain" %>
                  </div>
                </div>
              <% end %>
            </div>
          </div>
        <% end %>

        <div class="pt-4 flex justify-end">
          <%= f.submit "Save Changes", class: "inline-flex items-center rounded-xl bg-slate-900 px-6 py-2.5 text-sm font-bold text-white shadow-sm transition hover:bg-slate-700" %>
        </div>
      <% end %>
    </div>
  </div>

  <!-- Additional Guests -->
  <div class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">
    <div class="border-b border-slate-200 bg-slate-50/70 px-6 py-5 sm:px-8 flex items-center justify-between">
      <div>
        <h2 class="text-lg font-bold tracking-tight text-slate-950">Additional Guests</h2>
        <p class="mt-1 text-sm font-medium text-slate-600">
          All guests share Guest Reg. No. <span class="font-semibold text-slate-900"><%= booking.guest_registration_number || "—" %></span>
        </p>
      </div>
    </div>
    <div class="p-6 sm:p-8 space-y-6">
      <% if presenter.additional_guests.any? %>
        <div class="space-y-3">
          <% presenter.additional_guests.each do |bg| %>
            <div class="rounded-xl border border-slate-200 bg-slate-50/50 px-5 py-4 flex items-start justify-between gap-4">
              <div class="grid sm:grid-cols-3 gap-x-6 gap-y-3 flex-1">
                <div>
                  <p class="text-[10px] font-bold uppercase tracking-wider text-slate-400 mb-0.5">Name</p>
                  <p class="text-sm font-semibold text-slate-900"><%= bg.guest.name %></p>
                </div>
                <div>
                  <p class="text-[10px] font-bold uppercase tracking-wider text-slate-400 mb-0.5">Phone</p>
                  <p class="text-sm text-slate-700"><%= bg.guest.phone.presence || "—" %></p>
                </div>
                <div>
                  <p class="text-[10px] font-bold uppercase tracking-wider text-slate-400 mb-0.5">Email</p>
                  <p class="text-sm text-slate-700"><%= bg.guest.email.presence || "—" %></p>
                </div>
                <div>
                  <p class="text-[10px] font-bold uppercase tracking-wider text-slate-400 mb-0.5">Country</p>
                  <p class="text-sm text-slate-700"><%= bg.guest.country.presence || "—" %></p>
                </div>
                <div>
                  <p class="text-[10px] font-bold uppercase tracking-wider text-slate-400 mb-0.5">Gender</p>
                  <p class="text-sm text-slate-700"><%= bg.guest.gender&.capitalize || "—" %></p>
                </div>
                <div>
                  <p class="text-[10px] font-bold uppercase tracking-wider text-slate-400 mb-0.5"><%= presenter.guest_document_type_label(bg.guest) %></p>
                  <p class="text-sm text-slate-700"><%= bg.guest.government_id.presence || "—" %></p>
                </div>
              </div>
              <% if presenter.can_manage_bookings?(current_user) %>
                <%= button_to remove_guest_hotel_booking_path(current_hotel, booking, guest_id: bg.id), method: :delete,
                    data: { turbo_confirm: "Remove this guest?" },
                    class: "shrink-0 text-xs font-medium px-3 py-1.5 rounded-lg border border-red-100 text-red-600 hover:bg-red-50" do %>
                  Remove
                <% end %>
              <% end %>
            </div>
          <% end %>
        </div>
      <% else %>
        <p class="text-sm text-slate-400">No additional guests added.</p>
      <% end %>

      <% if presenter.can_add_guests?(current_user) %>
        <%= form_with url: add_guest_hotel_booking_path(current_hotel, booking), method: :post, local: true, class: "space-y-3 pt-4 border-t border-slate-100" do |f| %>
          <div class="grid sm:grid-cols-3 gap-3">
            <div>
              <%= label_tag :name, "Full Name *", class: "block text-xs font-medium text-slate-700 mb-1" %>
              <%= text_field_tag :name, nil, placeholder: "e.g. Ahmad bin Ali", required: true, class: "w-full rounded-xl border border-slate-200 px-3 py-2 text-sm text-slate-700 focus:outline-none focus:border-slate-300" %>
            </div>
            <div>
              <%= label_tag :phone, "Phone", class: "block text-xs font-medium text-slate-700 mb-1" %>
              <%= text_field_tag :phone, nil, placeholder: "e.g. 0123456789", class: "w-full rounded-xl border border-slate-200 px-3 py-2 text-sm text-slate-700 focus:outline-none focus:border-slate-300" %>
            </div>
            <div>
              <%= label_tag :email, "Email", class: "block text-xs font-medium text-slate-700 mb-1" %>
              <%= email_field_tag :email, nil, placeholder: "e.g. guest@email.com", class: "w-full rounded-xl border border-slate-200 px-3 py-2 text-sm text-slate-700 focus:outline-none focus:border-slate-300" %>
            </div>
          </div>
          <div class="grid sm:grid-cols-2 gap-3">
            <div>
              <%= label_tag :country, "Country *", class: "block text-xs font-medium text-slate-700 mb-1" %>
              <%= select_tag :country, options_for_select(COUNTRY_OPTIONS, "Malaysia"), required: true, class: "w-full rounded-xl border border-slate-200 px-3 py-2 text-sm text-slate-700 focus:outline-none focus:border-slate-300" %>
            </div>
            <div>
              <%= label_tag :gender, "Gender", class: "block text-xs font-medium text-slate-700 mb-1" %>
              <%= select_tag :gender, options_for_select([["— Select —", ""], ["Male", "male"], ["Female", "female"], ["Other", "other"]]), class: "w-full rounded-xl border border-slate-200 px-3 py-2 text-sm text-slate-700 focus:outline-none focus:border-slate-300" %>
            </div>
          </div>
          <div class="grid sm:grid-cols-2 gap-3">
            <div>
              <%= label_tag :document_type, "Document Type", class: "block text-xs font-medium text-slate-700 mb-1" %>
              <%= select_tag :document_type, options_for_select([["IC", "ic"], ["Passport", "passport"]], "ic"), class: "w-full rounded-xl border border-slate-200 px-3 py-2 text-sm text-slate-700 focus:outline-none focus:border-slate-300" %>
            </div>
            <div>
              <%= label_tag :government_id, "IC / Passport No.", class: "block text-xs font-medium text-slate-700 mb-1" %>
              <%= text_field_tag :government_id, nil, placeholder: "e.g. 900101-01-1234", class: "w-full rounded-xl border border-slate-200 px-3 py-2 text-sm text-slate-700 focus:outline-none focus:border-slate-300" %>
            </div>
          </div>
          <div class="flex justify-end">
            <%= submit_tag "Add Guest", class: "inline-flex items-center rounded-xl bg-slate-900 px-5 py-2 text-sm font-semibold text-white hover:bg-slate-700 transition cursor-pointer" %>
          </div>
        <% end %>
      <% end %>
    </div>
  </div>

  <!-- Pre Check-In Details -->
  <% if presenter.pre_checkin.present? %>
    <div class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">
      <div class="border-b border-slate-200 bg-slate-50/70 px-6 py-5 sm:px-8 flex items-center justify-between gap-3">
        <div>
          <h2 class="text-lg font-bold tracking-tight text-slate-950">Pre Check-In Details</h2>
          <p class="mt-1 text-sm font-medium text-slate-600">
            <% if booking.pre_checkin_completed? %>
              Guest-submitted arrival information.
            <% else %>
              Guest arrival information is pending.
            <% end %>
          </p>
        </div>
        <% 
          status_color = case booking.pre_checkin_display_status
          when "completed" then "emerald"
          when "pending", "in_progress" then "amber"
          when "failed" then "red"
          else "slate"
          end
        %>
        <span class="inline-flex items-center rounded-full border border-<%= status_color %>-200 bg-<%= status_color %>-50 px-2.5 py-1 text-[11px] font-semibold text-<%= status_color %>-700 uppercase">
          <%= booking.pre_checkin_display_status.to_s.tr("_", " ") %>
        </span>
      </div>
      <div class="p-6 sm:p-8">
        <div class="grid lg:grid-cols-3 gap-8">
          <div class="lg:col-span-1 space-y-6">
            <% if booking.pre_checkin_completed? || presenter.estimated_arrival_time_label.present? %>
              <div>
                <dt class="text-[11px] font-bold text-slate-500 uppercase tracking-wider mb-2">Estimated Arrival</dt>
                <dd class="text-base font-semibold text-slate-900"><%= presenter.estimated_arrival_time_label %></dd>
              </div>
            <% end %>

            <% if booking.pre_checkin_completed? && presenter.guest_government_id_label.present? && presenter.guest_government_id_label != "—" %>
              <div>
                <dt class="text-[11px] font-bold text-slate-500 uppercase tracking-wider mb-2">ID / Passport Number</dt>
                <dd class="text-base font-semibold text-slate-900"><%= presenter.guest_government_id_label %></dd>
              </div>
            <% end %>
          </div>

          <% if booking.pre_checkin_completed? && (booking.id_front.attached? || booking.id_back.attached?) %>
            <div class="lg:col-span-2">
              <dt class="text-[11px] font-bold text-slate-500 uppercase tracking-wider mb-4">Digital Identity Verification</dt>
              <div class="grid sm:grid-cols-2 gap-6">
                <% if booking.id_front.attached? %>
                  <div class="space-y-2">
                    <div class="flex items-center justify-between">
                      <span class="text-[10px] font-black uppercase tracking-widest text-slate-400">Front Side / Passport</span>
                    </div>
                    <div class="relative w-full aspect-[1.586/1] rounded-xl border border-slate-200 bg-slate-50 overflow-hidden shadow-sm flex items-center justify-center">
                      <%= image_tag booking.id_front, class: "max-w-full max-h-full object-contain" %>
                    </div>
                  </div>
                <% end %>

                <% if booking.id_back.attached? %>
                  <div class="space-y-2">
                    <div class="flex items-center justify-between">
                      <span class="text-[10px] font-black uppercase tracking-widest text-slate-400">Back Side</span>
                    </div>
                    <div class="relative w-full aspect-[1.586/1] rounded-xl border border-slate-200 bg-slate-50 overflow-hidden shadow-sm flex items-center justify-center">
                      <%= image_tag booking.id_back, class: "max-w-full max-h-full object-contain" %>
                    </div>
                  </div>
                <% end %>
              </div>
            </div>
          <% end %>
        </div>

        <% if !booking.pre_checkin_completed? %>
          <div class="mt-8 pt-8 border-t border-slate-100">
            <div class="flex flex-col md:flex-row md:items-center justify-between gap-6">
              <div class="flex-1">
                <p class="text-sm font-medium text-slate-600 mb-4">The guest has not yet completed their pre-check-in. You can share the following link with them to accelerate their arrival process.</p>
                <div class="flex items-center gap-2 p-3 rounded-xl bg-slate-50 border border-slate-200 group">
                  <div class="flex-1 min-w-0">
                    <p class="text-[10px] font-bold text-slate-400 uppercase tracking-widest mb-0.5">Guest Form Link</p>
                    <p class="text-xs font-mono text-slate-600 truncate"><%= pre_checkin_url(presenter.pre_checkin.token) %></p>
                  </div>
                  <button type="button" 
                          class="shrink-0 inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-white border border-slate-200 text-[11px] font-bold text-slate-700 hover:bg-slate-50 transition shadow-sm active:scale-95"
                          data-controller="clipboard" 
                          data-clipboard-text="<%= pre_checkin_url(presenter.pre_checkin.token) %>" 
                          data-action="click->clipboard#copy">
                    <svg class="size-3.5" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><rect width="14" height="14" x="8" y="8" rx="2" ry="2"/><path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"/></svg>
                    <span>Copy</span>
                  </button>
                </div>
              </div>
              <div class="flex shrink-0 gap-3">
                <button type="button" class="inline-flex items-center justify-center rounded-xl border border-slate-200 bg-white px-4 py-2.5 text-sm font-bold text-slate-700 shadow-sm transition hover:bg-slate-50">
                  Resend SMS/WhatsApp
                </button>
              </div>
            </div>
          </div>
        <% end %>
      </div>
    </div>
  <% end %>

  <div class="grid lg:grid-cols-2 gap-8">
    <!-- Stay & Room Details -->
    <div class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">
      <div class="border-b border-slate-200 bg-slate-50/70 px-6 py-5 sm:px-8 flex items-center justify-between">
        <h2 class="text-lg font-bold tracking-tight text-slate-950">Stay & Room Details</h2>
        <div class="flex items-center gap-3">
          <% if presenter.can_manage_bookings?(current_user) %>
            <button type="button" class="inline-flex items-center gap-x-1.5 text-xs font-bold text-blue-600 hover:text-blue-700 transition" onclick="document.getElementById('edit-stay-details-modal').showModal()">
              <svg class="size-3.5" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M17 3a2.85 2.83 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5Z"/><path d="m15 5 4 4"/></svg>
              Edit
            </button>
          <% end %>
        </div>
      </div>

      <dialog id="edit-stay-details-modal" 
              class="fixed inset-0 m-auto rounded-2xl p-0 w-[min(92vw,32rem)] max-w-lg shadow-2xl backdrop:bg-slate-900/50" onclick="if(event.target===this){this.close()}">
        <div class="p-6 bg-white" onclick="event.stopPropagation()">
          <h3 class="text-lg font-bold text-slate-900">Edit Stay & Room Details</h3>
          <p class="text-sm text-slate-500 mt-1">Update booking dates and room assignment.</p>

          <%= form_with model: booking, url: hotel_booking_path(current_hotel, booking), method: :patch, local: true, 
              class: "mt-6 space-y-4",
              data: { 
                controller: "booking-calc", 
                booking_calc_availability_url_value: availability_hotel_bookings_path(current_hotel),
                booking_calc_price_url_value: stay_price_hotel_bookings_path(current_hotel),
                booking_calc_exclude_booking_id_value: booking.id
              } do |f| %>
            <div class="grid sm:grid-cols-2 gap-4">
              <div>
                <label class="block text-[11px] font-bold text-slate-500 uppercase tracking-wider mb-2">Check-in Date</label>
                <%= f.date_field :check_in, class: "w-full rounded-xl border border-slate-200 bg-white py-2.5 px-4 text-sm text-slate-700 focus:border-slate-300 focus:outline-none focus:ring-0 shadow-sm", data: { booking_calc_target: "checkIn", action: "change->booking-calc#calculate" } %>
              </div>
              <div>
                <label class="block text-[11px] font-bold text-slate-500 uppercase tracking-wider mb-2">Check-out Date</label>
                <%= f.date_field :check_out, class: "w-full rounded-xl border border-slate-200 bg-white py-2.5 px-4 text-sm text-slate-700 focus:border-slate-300 focus:outline-none focus:ring-0 shadow-sm", data: { booking_calc_target: "checkOut", action: "change->booking-calc#calculate" } %>
              </div>
            </div>

            <div>
              <label class="block text-[11px] font-bold text-slate-500 uppercase tracking-wider mb-2">Room Category</label>
              <% current_room_type_id = booking.booking_rooms.first&.room_type_id %>
              <%= f.collection_select :room_type_id, presenter.room_types, :id, :name, { selected: current_room_type_id }, 
                  { class: "w-full rounded-xl border border-slate-200 bg-white px-4 py-2.5 text-sm font-medium text-slate-700 focus:border-slate-300 focus:outline-none focus:ring-0 shadow-sm", 
                    data: { 
                      booking_calc_target: "roomType", 
                      action: "change->booking-calc#updateRoomNumbers change->booking-calc#calculate",
                      prices: presenter.room_type_prices_json,
                      room_numbers: presenter.room_type_numbers_json
                    } 
                  } %>
            </div>

            <div data-controller="room-lock" 
                 data-room-lock-url-value="<%= hotel_room_locks_path(current_hotel) %>"
                 data-room-lock-room-type-id-value="<%= current_room_type_id %>"
                 data-room-lock-current-room-value="<%= presenter.current_room_number %>"
                 data-booking-calc-target="roomNumberContainer">
              <label for="booking_room_number" class="block text-[11px] font-bold text-slate-500 uppercase tracking-wider mb-2">Room Number</label>
              <%= f.select :room_number, [[presenter.current_room_number, presenter.current_room_number]], { selected: presenter.current_room_number }, 
                  { id: "booking_room_number",
                    class: "w-full rounded-xl border border-slate-200 bg-white py-2.5 px-4 text-sm text-slate-700 focus:border-slate-300 focus:outline-none focus:ring-0 shadow-sm", 
                    data: { 
                      booking_calc_target: "roomNumberSelect",
                      action: "change->room-lock#lock"
                    } 
                  } %>
              <p class="text-[10px] text-slate-400 mt-1.5 italic">Only available rooms for the selected dates are shown.</p>
            </div>

            <div class="flex items-center justify-end gap-x-3 pt-4">
              <button type="button" class="px-4 py-2 text-sm font-semibold text-slate-700 hover:bg-slate-50 rounded-lg transition" onclick="this.closest('dialog').close()">Cancel</button>
              <%= f.submit "Save Changes", class: "px-6 py-2 text-sm font-bold bg-slate-900 text-white rounded-lg hover:bg-slate-700 transition shadow-sm" %>
            </div>
          <% end %>
        </div>
      </dialog>
      <div class="p-6 sm:p-8 space-y-8">

        <div class="grid grid-cols-2 gap-6">
          <div>
            <dt class="text-[11px] font-bold text-slate-500 uppercase tracking-wider mb-1">Check-in</dt>
            <dd class="text-sm font-semibold text-slate-900"><%= presenter.check_in_formatted %></dd>
          </div>
          <div>
            <dt class="text-[11px] font-bold text-slate-500 uppercase tracking-wider mb-1">Check-out</dt>
            <dd class="text-sm font-semibold text-slate-900"><%= presenter.check_out_formatted %></dd>
          </div>
          <div>
            <dt class="text-[11px] font-bold text-slate-500 uppercase tracking-wider mb-1">Adults</dt>
            <dd class="text-sm font-semibold text-slate-900"><%= booking.adults %></dd>
          </div>
          <div>
            <dt class="text-[11px] font-bold text-slate-500 uppercase tracking-wider mb-1">Children</dt>
            <dd class="text-sm font-semibold text-slate-900"><%= booking.children %></dd>
          </div>
        </div>

        <div class="space-y-3">
          <h3 class="text-[11px] font-bold text-slate-500 uppercase tracking-wider">Reserved Units</h3>
          <% presenter.booking_rooms.each do |room| %>
            <div class="flex justify-between items-center p-4 rounded-xl border border-slate-100 bg-slate-50/50">
              <div>
                <p class="text-sm font-bold text-slate-900"><%= room.room_type_snapshot['name'] %></p>
                <p class="text-xs text-slate-500"><%= pluralize(room.quantity, 'room') %></p>
              </div>
              <div class="text-right">
                <p class="text-sm font-bold text-slate-900">MYR <%= number_with_precision(room.subtotal, precision: 2) %></p>
                <% room_number = presenter.room_number_for(room) %>
                <% if room_number.present? %>
                  <p class="text-[10px] font-black uppercase tracking-widest text-emerald-600 mt-1">Room <%= room_number %></p>
                <% end %>
              </div>
            </div>
          <% end %>
        </div>
      </div>
    </div>

    <div id="booking_notes_panel">
      <%= render "hotel_portal/bookings/internal_notes", booking: booking %>
    </div>
  </div>
</div>
