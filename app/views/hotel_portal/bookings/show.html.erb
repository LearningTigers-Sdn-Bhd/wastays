<div class="max-w-[85rem] px-4 py-10 sm:px-6 lg:px-8 lg:py-14 mx-auto">
  <!-- Back link -->
  <div class="mb-5">
    <%= link_to hotel_bookings_path(current_hotel), class: "inline-flex items-center gap-x-1.5 text-sm font-medium text-gray-500 hover:text-blue-600 focus:outline-none focus:text-blue-600" do %>
      <svg class="flex-shrink-0 w-4 h-4" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg>
      Back to Bookings
    <% end %>
  </div>

  <div class="grid lg:grid-cols-3 gap-y-10 lg:gap-x-10">
    <!-- Main Content -->
    <div class="lg:col-span-2 space-y-8">
      <!-- Header -->
      <div class="flex justify-between items-start">
        <div>
          <h1 class="text-3xl font-bold text-gray-800">Booking <%= @booking.confirmation_token %></h1>
          <p class="text-sm text-gray-500">Created on <%= @booking.created_at.strftime("%d %b %Y at %H:%M") %></p>
        </div>
        <div class="flex gap-x-2">
          <% if @booking.status == 'confirmed' %>
            <button type="button" class="py-2 px-3 inline-flex items-center gap-x-2 text-sm font-bold rounded-lg border border-transparent bg-emerald-600 text-white shadow-sm ring-2 ring-emerald-100 hover:bg-emerald-700" onclick="document.getElementById('check-in-modal-show-<%= @booking.id %>').showModal()">
              Check In Guest
            </button>
            <%= button_to "Cancel Booking", cancel_hotel_booking_path(current_hotel, @booking), method: :post, data: { turbo_confirm: "Are you sure you want to cancel this booking?", turbo_confirm_title: "Cancel Booking", turbo_confirm_color: "red" }, class: "py-2 px-3 inline-flex items-center gap-x-2 text-sm font-semibold rounded-lg border border-gray-200 bg-white text-red-600 shadow-sm hover:bg-gray-50 disabled:opacity-50 disabled:pointer-events-none" %>
          <% elsif @booking.status == 'checked_in' %>
            <button type="button" class="py-2 px-3 inline-flex items-center gap-x-2 text-sm font-bold rounded-lg border border-transparent bg-indigo-600 text-white shadow-sm ring-2 ring-indigo-100 hover:bg-indigo-700" onclick="document.getElementById('check-out-modal-show-<%= @booking.id %>').showModal()">
              Check Out Guest
            </button>
            <button type="button" class="py-2 px-3 inline-flex items-center gap-x-2 text-sm font-semibold rounded-lg border border-gray-200 bg-white text-gray-700 shadow-sm hover:bg-gray-50" onclick="document.getElementById('check-in-modal-show-<%= @booking.id %>').showModal()">
              Edit Check-In Time
            </button>
          <% end %>
        </div>
      </div>

      <dialog id="check-in-modal-show-<%= @booking.id %>" class="fixed inset-0 m-auto rounded-xl p-0 w-[min(92vw,28rem)] max-w-md backdrop:bg-black/40" onclick="if(event.target===this){this.close()}">
        <div class="p-5 bg-white rounded-xl">
          <h3 class="text-base font-bold text-gray-800"><%= @booking.checked_in? ? "Edit Check-In Date & Time" : "Confirm Check-In" %></h3>
          <p class="text-xs text-gray-500 mt-1">Timezone: <%= current_user.time_zone %></p>
          <%= form_with url: check_in_hotel_booking_path(current_hotel, @booking), method: :post, local: true, class: "mt-4 space-y-4" do |f| %>
            <%= f.datetime_local_field :checked_in_at, value: (@booking.checked_in_at || Time.current).strftime("%Y-%m-%dT%H:%M"), class: "w-full py-2.5 px-3 text-sm border border-gray-200 rounded-lg focus:border-blue-500 focus:ring-blue-500" %>
            <div class="flex items-center justify-end gap-x-2">
              <button type="button" class="py-2 px-3 text-sm font-semibold rounded-lg border border-gray-200 text-gray-600 hover:bg-gray-50" onclick="document.getElementById('check-in-modal-show-<%= @booking.id %>').close()">Cancel</button>
              <%= f.submit (@booking.checked_in? ? "Save Check-In Time" : "Confirm Check-In"), class: "py-2 px-3 text-sm font-bold rounded-lg bg-emerald-600 text-white hover:bg-emerald-700", onclick: "this.closest('dialog').close()" %>
            </div>
          <% end %>
        </div>
      </dialog>

      <dialog id="check-out-modal-show-<%= @booking.id %>" class="fixed inset-0 m-auto rounded-xl p-0 w-[min(92vw,28rem)] max-w-md backdrop:bg-black/40" onclick="if(event.target===this){this.close()}">
        <div class="p-5 bg-white rounded-xl">
          <h3 class="text-base font-bold text-gray-800">Confirm Check-Out</h3>
          <p class="text-xs text-gray-500 mt-1">Timezone: <%= current_user.time_zone %></p>
          <%= form_with url: check_out_hotel_booking_path(current_hotel, @booking), method: :post, local: true, class: "mt-4 space-y-4" do |f| %>
            <%= f.datetime_local_field :checked_out_at, value: Time.current.strftime("%Y-%m-%dT%H:%M"), class: "w-full py-2.5 px-3 text-sm border border-gray-200 rounded-lg focus:border-blue-500 focus:ring-blue-500" %>
            <div class="flex items-center justify-end gap-x-2">
              <button type="button" class="py-2 px-3 text-sm font-semibold rounded-lg border border-gray-200 text-gray-600 hover:bg-gray-50" onclick="document.getElementById('check-out-modal-show-<%= @booking.id %>').close()">Cancel</button>
              <%= f.submit "Confirm Check-Out", class: "py-2 px-3 text-sm font-bold rounded-lg bg-indigo-600 text-white hover:bg-indigo-700", onclick: "this.closest('dialog').close()" %>
            </div>
          <% end %>
        </div>
      </dialog>

      <% pre_checkin_metadata = @pre_checkin&.metadata || {} %>
      <% pre_checkin_arrival_time = pre_checkin_metadata["estimated_arrival_time"].presence || @booking.estimated_arrival_time.presence %>
      <% pre_checkin_government_id = pre_checkin_metadata["guest_government_id"].presence %>
      <% housekeeping_requests = @housekeeping_requests || [] %>
      <% complaint_requests = @complaint_requests || [] %>

      <div data-controller="booking-tabs" class="space-y-6">
        <div class="flex flex-wrap gap-2">
          <button type="button" data-booking-tabs-target="tab" data-tab-name="booking-details" data-action="click->booking-tabs#switch" class="inline-flex items-center gap-x-2 rounded-xl border border-gray-200 bg-white px-4 py-2 text-sm font-semibold text-gray-600 transition hover:bg-gray-50">
            Booking Details
          </button>
          <button type="button" data-booking-tabs-target="tab" data-tab-name="requests" data-action="click->booking-tabs#switch" class="inline-flex items-center gap-x-2 rounded-xl border border-gray-200 bg-white px-4 py-2 text-sm font-semibold text-gray-600 transition hover:bg-gray-50">
            Requests
            <% if @pending_requests_count.to_i > 0 %>
              <span class="ml-1 inline-flex items-center justify-center min-w-5 h-5 rounded-full bg-amber-100 px-1.5 text-[10px] font-bold text-amber-800">
                <%= @pending_requests_count %>
              </span>
            <% end %>
          </button>
        </div>

        <div data-booking-tabs-target="panel" data-tab-panel="booking-details" class="space-y-8">
          <div class="bg-white border border-gray-200 rounded-xl shadow-sm overflow-hidden">
            <div class="px-6 py-4 border-b border-gray-200 bg-gray-50">
              <h2 class="text-lg font-semibold text-gray-800">Guest Information</h2>
            </div>
            <div class="p-6">
              <%= form_with model: @booking, url: hotel_booking_path(current_hotel, @booking), method: :patch, local: true, class: "grid sm:grid-cols-2 gap-4" do |f| %>
                <div class="sm:col-span-2">
                  <label class="block text-sm font-medium mb-2 text-gray-700">Guest Name</label>
                  <%= f.text_field :guest_name, class: "py-3 px-4 block w-full border-gray-200 rounded-lg text-sm focus:border-blue-500 focus:ring-blue-500 border" %>
                </div>
                <div>
                  <label class="block text-sm font-medium mb-2 text-gray-700">Email Address</label>
                  <%= f.email_field :guest_email, class: "py-3 px-4 block w-full border-gray-200 rounded-lg text-sm focus:border-blue-500 focus:ring-blue-500 border" %>
                </div>
                <div>
                  <label class="block text-sm font-medium mb-2 text-gray-700">Phone Number</label>
                  <%= f.telephone_field :guest_phone, class: "py-3 px-4 block w-full border-gray-200 rounded-lg text-sm focus:border-blue-500 focus:ring-blue-500 border" %>
                </div>
                <div class="sm:col-span-2 pt-4 border-t border-gray-100 flex justify-end">
                  <%= f.submit "Update Guest Details", class: "py-2 px-4 inline-flex items-center gap-x-2 text-sm font-semibold rounded-lg border border-transparent bg-blue-600 text-white hover:bg-blue-700 transition" %>
                </div>
              <% end %>
            </div>
          </div>

          <% if @pre_checkin.present? && @booking.pre_checkin_display_status == "completed" %>
            <div class="bg-white border border-gray-200 rounded-xl shadow-sm overflow-hidden">
              <div class="px-6 py-4 border-b border-gray-200 bg-gray-50 flex items-center justify-between gap-3">
                <div>
                  <h2 class="text-lg font-semibold text-gray-800">Pre Check-In Details</h2>
                  <p class="text-xs text-gray-500 mt-1">Guest-submitted arrival information.</p>
                </div>
                <span class="inline-flex items-center gap-x-1.5 py-1.5 px-3 rounded-full text-xs font-medium 
                  <%= pre_checkin_status_class(pre_checkin_display_status(@booking)) %>">
                  <%= pre_checkin_display_status(@booking).titleize %>
                </span>
              </div>
              <div class="p-6">
                <div class="grid sm:grid-cols-2 gap-4">
                  <div>
                    <label class="block text-xs font-bold text-gray-500 uppercase tracking-wider mb-1">Estimated Arrival</label>
                    <p class="text-gray-800 font-medium"><%= pre_checkin_arrival_time.present? ? pre_checkin_arrival_time : "Not provided" %></p>
                  </div>
                  <div>
                    <label class="block text-xs font-bold text-gray-500 uppercase tracking-wider mb-1">ID / Passport Number</label>
                    <p class="text-gray-800 font-medium"><%= pre_checkin_government_id.present? ? pre_checkin_government_id : "Not provided" %></p>
                  </div>
                </div>
              </div>
            </div>
          <% end %>

          <div class="grid lg:grid-cols-2 gap-6">
            <div class="bg-white border border-gray-200 rounded-xl shadow-sm overflow-hidden">
              <div class="px-6 py-4 border-b border-gray-200 bg-gray-50">
                <h2 class="text-lg font-semibold text-gray-800">Stay & Room Details</h2>
              </div>
              <div class="p-6 space-y-6">
                <div class="grid grid-cols-2 sm:grid-cols-4 lg:grid-cols-2 gap-4">
                  <div>
                    <p class="text-xs text-gray-500 uppercase font-bold tracking-wider">Check-in</p>
                    <p class="text-gray-800 font-medium"><%= @booking.check_in.strftime("%d %b %Y") %></p>
                  </div>
                  <div>
                    <p class="text-xs text-gray-500 uppercase font-bold tracking-wider">Check-out</p>
                    <p class="text-gray-800 font-medium"><%= @booking.check_out.strftime("%d %b %Y") %></p>
                  </div>
                  <div>
                    <p class="text-xs text-gray-500 uppercase font-bold tracking-wider">Adults</p>
                    <p class="text-gray-800 font-medium"><%= @booking.adults %></p>
                  </div>
                  <div>
                    <p class="text-xs text-gray-500 uppercase font-bold tracking-wider">Children</p>
                    <p class="text-gray-800 font-medium"><%= @booking.children %></p>
                  </div>
                </div>

                <div class="space-y-4">
                  <h3 class="text-sm font-bold text-gray-800 uppercase tracking-wider">Rooms</h3>
                  <% @booking_rooms.each do |room| %>
                    <div class="flex justify-between items-center p-4 bg-gray-50 rounded-lg border border-gray-200">
                      <div>
                        <p class="font-bold text-gray-800"><%= room.room_type_snapshot['name'] %></p>
                        <p class="text-xs text-gray-500"><%= room.quantity %> room(s)</p>
                      </div>
                      <div class="text-right">
                        <p class="font-bold text-blue-600">MYR <%= room.subtotal %></p>
                      </div>
                    </div>
                  <% end %>
                </div>
              </div>
            </div>

            <div id="booking_notes_panel">
              <%= render "hotel_portal/bookings/internal_notes", booking: @booking %>
            </div>
          </div>
        </div>

        <div data-booking-tabs-target="panel" data-tab-panel="requests" class="space-y-6 hidden">
          <div class="grid lg:grid-cols-2 gap-6">
            <div class="bg-white border border-gray-200 rounded-xl shadow-sm overflow-hidden">
              <div class="px-6 py-4 border-b border-gray-200 bg-gray-50 flex items-center justify-between gap-3">
                <div>
                  <h2 class="text-lg font-semibold text-gray-800">Housekeeping Requests</h2>
                  <p class="text-xs text-gray-500 mt-1">Guest housekeeping requests.</p>
                </div>
                <span class="inline-flex items-center gap-x-1.5 py-1.5 px-3 rounded-full text-xs font-medium bg-gray-100 text-gray-800">
                  <%= pluralize(housekeeping_requests.count, "request") %>
                </span>
              </div>
              <div class="p-6">
                <% if housekeeping_requests.any? %>
                  <div class="space-y-4">
                    <% housekeeping_requests.each do |request| %>
                      <div class="rounded-xl border border-gray-200 bg-gray-50 p-4 space-y-4">
                        <div class="flex items-start justify-between gap-4">
                          <div class="flex-1 min-w-0 space-y-2">
                            <div>
                              <label class="block text-xs font-bold text-gray-500 uppercase tracking-wider">Requested At</label>
                              <p class="text-gray-800 text-sm"><%= display_housekeeping_datetime(request.display_requested_at) %></p>
                            </div>
                            <% if request.completed_at.present? %>
                              <div>
                                <label class="block text-xs font-bold text-gray-500 uppercase tracking-wider">Completed At</label>
                                <p class="text-gray-800 text-sm"><%= display_housekeeping_datetime(request.completed_at) %></p>
                              </div>
                            <% end %>
                            <div>
                              <label class="block text-xs font-bold text-gray-500 uppercase tracking-wider">Requests</label>
                              <p class="text-gray-800 text-sm leading-relaxed"><%= request.request_details %></p>
                            </div>
                          </div>

                          <div class="shrink-0 flex flex-col items-end gap-2">
                            <span class="inline-flex items-center gap-x-1.5 py-1.5 px-3 rounded-full text-xs font-medium <%= housekeeping_status_class(request.status) %>">
                              <%= request.status.titleize %>
                            </span>
                            <% unless request.completed? %>
                              <%= button_to "Complete", complete_housekeeping_request_hotel_booking_path(current_hotel, @booking, housekeeping_request_id: request.id), method: :post, class: "inline-flex items-center gap-x-2 rounded-lg border border-gray-200 bg-white px-3 py-1.5 text-xs font-semibold text-gray-700 shadow-sm hover:bg-gray-50" %>
                            <% end %>
                          </div>
                        </div>

                        <div class="<%= request.completed? ? "" : "hidden" %> -mt-2 w-full">
                          <div class="w-full">
                            <label class="block text-xs font-bold text-gray-500 uppercase tracking-wider">Internal Notes</label>
                            <% if request.internal_notes_list.any? %>
                              <div class="space-y-2 mb-3">
                                <% request.internal_notes_list.each do |note| %>
                                  <% note_time = Time.zone.parse(note["created_at"].to_s) rescue nil %>
                                  <div class="rounded-lg border border-gray-200 bg-white p-3">
                                    <div class="flex items-center justify-between gap-2">
                                      <p class="text-[10px] text-gray-500"><%= note_time ? display_housekeeping_datetime(note_time) : "Not provided" %></p>
                                    </div>
                                    <p class="mt-1 text-sm text-gray-800 whitespace-pre-wrap"><%= note["body"] %></p>
                                  </div>
                                <% end %>
                              </div>
                            <% else %>
                              <p class="text-sm text-gray-500 mb-3">No internal notes yet.</p>
                            <% end %>

                            <%= form_with url: complete_housekeeping_request_hotel_booking_path(current_hotel, @booking, housekeeping_request_id: request.id), method: :post, local: true, class: "space-y-3" do |f| %>
                              <%= text_area_tag :internal_note, nil, rows: 3, class: "py-3 px-4 block w-full border-gray-200 rounded-lg text-sm focus:border-blue-500 focus:ring-blue-500 border", placeholder: "Add internal note..." %>
                              <div class="flex justify-end">
                                <%= f.submit "Add Note", class: "inline-flex items-center gap-x-2 rounded-lg border border-gray-200 bg-white px-3 py-1.5 text-xs font-semibold text-gray-700 shadow-sm hover:bg-gray-50" %>
                              </div>
                            <% end %>
                          </div>
                        </div>
                      </div>
                    <% end %>
                  </div>
                <% else %>
                  <div class="rounded-xl border border-dashed border-gray-200 bg-white p-6 text-sm text-gray-500">
                    No housekeeping requests yet.
                  </div>
                <% end %>
              </div>
            </div>

            <div class="bg-white border border-gray-200 rounded-xl shadow-sm overflow-hidden">
              <div class="px-6 py-4 border-b border-gray-200 bg-gray-50 flex items-center justify-between gap-3">
                <div>
                  <h2 class="text-lg font-semibold text-gray-800">Complaint Requests</h2>
                  <p class="text-xs text-gray-500 mt-1">Guest complaint requests.</p>
                </div>
                <span class="inline-flex items-center gap-x-1.5 py-1.5 px-3 rounded-full text-xs font-medium bg-gray-100 text-gray-800">
                  <%= pluralize(complaint_requests.count, "complaint") %>
                </span>
              </div>
              <div class="p-6">
                <% if complaint_requests.any? %>
                  <div class="space-y-4">
                    <% complaint_requests.each do |request| %>
                      <% complaint_notes_id = "complaint-notes-#{request.id}" %>
                      <div class="rounded-xl border border-gray-200 bg-gray-50 p-4">
                        <div class="flex items-start justify-between gap-4">
                          <div class="flex-1 min-w-0 space-y-3">
                            <div>
                              <label class="block text-xs font-bold text-gray-500 uppercase tracking-wider">Requested At</label>
                              <p class="text-gray-800 text-sm"><%= display_housekeeping_datetime(request.display_requested_at) %></p>
                            </div>
                            <% if request.completed_at.present? %>
                              <div>
                                <label class="block text-xs font-bold text-gray-500 uppercase tracking-wider">Completed At</label>
                                <p class="text-gray-800 text-sm"><%= display_housekeeping_datetime(request.completed_at) %></p>
                              </div>
                            <% end %>
                            <div>
                              <label class="block text-xs font-bold text-gray-500 uppercase tracking-wider">Complaint</label>
                              <p class="text-gray-800 text-sm leading-relaxed"><%= request.complaint_details %></p>
                            </div>
                          </div>
                          <div class="shrink-0 flex flex-col items-end gap-2">
                            <span class="inline-flex items-center gap-x-1.5 py-1.5 px-3 rounded-full text-xs font-medium <%= complaint_status_class(request.status) %>">
                              <%= request.status.titleize %>
                            </span>
                            <% unless request.resolved? %>
                              <%= button_to "Resolve", resolve_complaint_request_hotel_booking_path(current_hotel, @booking, complaint_request_id: request.id), method: :post, class: "inline-flex items-center gap-x-2 rounded-lg border border-gray-200 bg-white px-3 py-1.5 text-xs font-semibold text-gray-700 shadow-sm hover:bg-gray-50" %>
                            <% end %>
                          </div>
                        </div>
                        <div id="<%= complaint_notes_id %>" class="<%= request.resolved? ? "" : "hidden" %> mt-2 w-full">
                          <div class="w-full">
                            <label class="block text-xs font-bold text-gray-500 uppercase tracking-wider">Internal Notes</label>
                            <% if request.internal_notes_list.any? %>
                              <div class="space-y-2 mb-3">
                                <% request.internal_notes_list.each do |note| %>
                                  <% note_time = Time.zone.parse(note["created_at"].to_s) rescue nil %>
                                  <div class="rounded-lg border border-gray-200 bg-white p-3">
                                    <p class="text-[10px] text-gray-500"><%= note_time ? display_housekeeping_datetime(note_time) : "Not provided" %></p>
                                    <p class="mt-1 text-sm text-gray-800 whitespace-pre-wrap"><%= note["body"] %></p>
                                  </div>
                                <% end %>
                              </div>
                            <% else %>
                              <p class="text-sm text-gray-500 mb-3">No internal notes yet.</p>
                            <% end %>

                            <%= form_with url: update_complaint_request_hotel_booking_path(current_hotel, @booking, complaint_request_id: request.id), method: :patch, local: true, class: "space-y-3" do |f| %>
                              <%= text_area_tag :internal_note, nil, rows: 3, class: "py-3 px-4 block w-full border-gray-200 rounded-lg text-sm focus:border-blue-500 focus:ring-blue-500 border", placeholder: "Add internal note..." %>
                              <div class="flex justify-end">
                                <%= f.submit "Add Note", class: "inline-flex items-center gap-x-2 rounded-lg border border-gray-200 bg-white px-3 py-1.5 text-xs font-semibold text-gray-700 shadow-sm hover:bg-gray-50" %>
                              </div>
                            <% end %>
                          </div>
                        </div>
                      </div>
                    <% end %>
                  </div>
                <% else %>
                  <div class="rounded-xl border border-dashed border-gray-200 bg-white p-6 text-sm text-gray-500">
                    No complaint requests yet.
                  </div>
                <% end %>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Sidebar -->
    <div class="space-y-6">
      <!-- Status Card -->
      <div class="bg-white border border-gray-200 rounded-xl shadow-sm overflow-hidden p-6">
        <h3 class="text-sm font-bold text-gray-800 uppercase tracking-wider mb-4">Status Summary</h3>
        <div class="space-y-4">
          <div class="flex justify-between items-center">
            <span class="text-sm text-gray-500">Booking Status</span>
            <span class="py-1 px-2 inline-flex items-center gap-x-1 text-xs font-medium rounded-full <%= booking_status_class(@booking.status) %>">
              <%= @booking.status.titleize %>
            </span>
          </div>
          <div class="flex justify-between items-center">
            <span class="text-sm text-gray-500">Payment Status</span>
            <span class="py-1 px-2 inline-flex items-center gap-x-1 text-xs font-medium rounded-full <%= payment_status_class(@booking.payment_status) %>">
              <%= @booking.payment_status.titleize %>
            </span>
          </div>
          <div class="flex justify-between items-center">
            <span class="text-sm text-gray-500">Pre Check-In Status</span>
            <% pre_checkin_status = pre_checkin_display_status(@booking) %>
            <span class="py-1 px-2 inline-flex items-center gap-x-1 text-xs font-medium rounded-full <%= pre_checkin_status_class(pre_checkin_status) %>">
              <%= pre_checkin_status.titleize %>
            </span>
          </div>
          <div class="flex justify-between items-center pt-4 border-t border-gray-100">
            <span class="text-sm font-bold text-gray-800">Total Charged</span>
            <span class="text-lg font-bold text-blue-600">MYR <%= @booking.total_amount %></span>
          </div>
        </div>
      </div>

      <!-- Quick Actions -->
      <div class="bg-white border border-gray-200 rounded-xl shadow-sm overflow-hidden p-6">
        <h3 class="text-sm font-bold text-gray-800 uppercase tracking-wider mb-4">Quick Actions</h3>
        <div class="space-y-2">
