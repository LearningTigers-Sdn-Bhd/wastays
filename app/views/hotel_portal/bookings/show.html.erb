<% content_for :breadcrumbs do %>
  <div class="flex items-center gap-x-2">
    <span class="text-sm font-medium text-slate-600"><%= current_hotel.name %></span>
    <span class="text-sm text-slate-400">/</span>
    <%= link_to "Bookings", hotel_bookings_path(current_hotel), class: "text-sm font-medium text-slate-600 hover:text-slate-900" %>
    <span class="text-sm text-slate-400">/</span>
    <span class="text-sm font-semibold text-slate-900"><%= @booking.confirmation_token %></span>
  </div>
<% end %>

<div class="max-w-[1600px] mx-auto pb-20 space-y-8">
  <!-- Header -->
  <div class="px-4 md:px-0 mt-5">
    <div class="flex flex-col md:flex-row md:items-start md:justify-between gap-6">
      <div>
        <div class="flex items-center gap-3 mb-2">
          <h1 class="text-2xl font-bold tracking-tight text-slate-950 sm:text-3xl">Booking <%= @booking.confirmation_token %></h1>
          <span class="inline-flex items-center rounded-full border px-2.5 py-1 text-[10px] font-bold tracking-wider <%= booking_status_class(@booking.status).gsub('bg-', 'border-').gsub('text-', 'text-') %> bg-opacity-10 uppercase">
            <%= @booking.status %>
          </span>
        </div>
        <p class="text-sm font-medium text-slate-600">Created on <%= @booking.created_at.strftime("%d %b %Y at %H:%M") %></p>
      </div>

      <div class="flex flex-wrap items-center gap-3">
        <% if current_user.has_permission?("manage_bookings", hotel: current_hotel) %>
          <% if @booking.status == 'confirmed' %>
            <button type="button" class="inline-flex items-center rounded-xl bg-slate-900 px-4 py-2.5 text-sm font-bold text-white shadow-sm transition hover:bg-slate-700" onclick="document.getElementById('check-in-modal-show-<%= @booking.id %>').showModal()">
              Check In Guest
            </button>
            <%= button_to "Cancel Booking", cancel_hotel_booking_path(current_hotel, @booking), method: :post, data: { turbo_confirm: "Are you sure you want to cancel this booking?", turbo_confirm_title: "Cancel Booking", turbo_confirm_color: "red" }, class: "inline-flex items-center rounded-xl bg-red-600 px-4 py-2.5 text-sm font-bold text-white shadow-sm transition hover:bg-red-700" %>
          <% elsif @booking.status == 'checked_in' %>
            <button type="button" class="inline-flex items-center rounded-xl bg-slate-900 px-4 py-2.5 text-sm font-bold text-white shadow-sm transition hover:bg-slate-700" onclick="document.getElementById('check-out-modal-show-<%= @booking.id %>').showModal()">
              Check Out Guest
            </button>
            <button type="button" class="inline-flex items-center rounded-xl border border-slate-200 bg-white px-4 py-2.5 text-sm font-bold text-slate-700 shadow-sm transition hover:bg-slate-50" onclick="document.getElementById('check-in-modal-show-<%= @booking.id %>').showModal()">
              Edit Check-In
            </button>
          <% end %>
        <% end %>
      </div>
    </div>
  </div>

  <dialog id="check-in-modal-show-<%= @booking.id %>"
          class="fixed inset-0 m-auto rounded-2xl p-0 w-[min(92vw,28rem)] max-w-md shadow-2xl backdrop:bg-slate-900/50" onclick="if(event.target===this){this.close()}">
    <div class="p-6 bg-white" onclick="event.stopPropagation()">
      <h3 class="text-lg font-bold text-slate-900"><%= @booking.checked_in? ? "Edit Check-In" : "Confirm Check-In" %></h3>
      <p class="text-sm text-slate-500 mt-1">Set check-in time and assign rooms for <%= @booking.guest_name %>.</p>
      <%= form_with model: @booking, url: check_in_hotel_booking_path(current_hotel, @booking), method: :post, local: true, 
          class: "mt-6 space-y-4" do |f| %>
        <div>
          <label class="block text-[11px] font-bold text-slate-500 uppercase tracking-wider mb-2">Check-in Date & Time</label>
          <%= f.datetime_local_field :checked_in_at,
              value: (@booking.checked_in_at || Time.current).strftime("%Y-%m-%dT%H:%M"),
              class: "w-full rounded-xl border border-slate-200 bg-white py-2.5 px-4 text-sm text-slate-700 focus:border-slate-300 focus:outline-none focus:ring-0 shadow-sm" %>
        </div>

        <div class="space-y-3">
          <label class="block text-[11px] font-bold text-slate-500 uppercase tracking-wider">Room Assignments</label>
          <%= f.fields_for :booking_rooms do |rf| %>
            <div class="flex items-center gap-3" 
                 data-controller="room-lock"
                 data-room-lock-url-value="<%= hotel_room_locks_path(current_hotel) %>"
                 data-room-lock-room-type-id-value="<%= rf.object.room_type_id %>"
                 data-room-lock-current-room-value="<%= rf.object.room_number %>">
              <div class="flex-1">
                <p class="text-[10px] font-medium text-slate-400 uppercase mb-1"><%= rf.object.room_type.name %></p>
                <%= rf.text_field :room_number, 
                    placeholder: "Room No.",
                    class: "w-full rounded-xl border border-slate-200 bg-white py-2 px-4 text-sm text-slate-700 focus:border-slate-300 focus:outline-none focus:ring-0 shadow-sm",
                    data: { action: "change->room-lock#lock" } %>
              </div>
            </div>
          <% end %>
        </div>
        <div class="flex items-center justify-end gap-x-3 pt-2">
          <button type="button" class="px-4 py-2 text-sm font-semibold text-slate-700 hover:bg-slate-50 rounded-lg transition" onclick="this.closest('dialog').close()">Cancel</button>
          <%= f.submit (@booking.checked_in? ? "Save Changes" : "Confirm Check In"), class: "px-4 py-2 text-sm font-bold bg-slate-900 text-white rounded-lg hover:bg-slate-700 transition shadow-sm" %>
        </div>
      <% end %>
    </div>
  </dialog>

  <dialog id="check-out-modal-show-<%= @booking.id %>" class="fixed inset-0 m-auto rounded-2xl p-0 w-[min(92vw,28rem)] max-w-md shadow-2xl backdrop:bg-slate-900/50" onclick="if(event.target===this){this.close()}">
    <div class="p-6 bg-white" onclick="event.stopPropagation()">
      <h3 class="text-lg font-bold text-slate-900">Confirm Check-Out</h3>
      <p class="text-sm text-slate-500 mt-1">Set check-out time for <%= @booking.guest_name %>.</p>

      <%= form_with url: check_out_hotel_booking_path(current_hotel, @booking), method: :post, local: true, class: "mt-6 space-y-4" do |f| %>
        <div>
          <label class="block text-[11px] font-bold text-slate-500 uppercase tracking-wider mb-2">Check-out Date & Time</label>
          <%= f.datetime_local_field :checked_out_at,
              value: Time.current.strftime("%Y-%m-%dT%H:%M"),
              class: "w-full rounded-xl border border-slate-200 bg-white py-2.5 px-4 text-sm text-slate-700 focus:border-slate-300 focus:outline-none focus:ring-0 shadow-sm" %>
        </div>

        <div class="flex items-center justify-end gap-x-3 pt-2">
          <button type="button" class="px-4 py-2 text-sm font-semibold text-slate-700 hover:bg-slate-50 rounded-lg transition" onclick="this.closest('dialog').close()">Cancel</button>
          <%= f.submit "Confirm Check-Out", class: "px-4 py-2 text-sm font-bold bg-slate-900 text-white rounded-lg hover:bg-slate-700 transition shadow-sm" %>
        </div>
      <% end %>
    </div>
  </dialog>

  <div class="grid lg:grid-cols-12 gap-8 px-4 md:px-0">
    <!-- Main Column -->
    <div class="lg:col-span-9 space-y-8">
      <div data-controller="booking-tabs" class="space-y-6">
        <!-- Preline Style Underlined Tabs -->
        <nav class="relative z-0 flex border border-slate-200 rounded-xl overflow-hidden" aria-label="Tabs" role="tablist">
          <button type="button"
                  data-booking-tabs-target="tab"
                  data-tab-name="booking-details"
                  data-action="click->booking-tabs#switch"
                  class="relative min-w-0 flex-1 bg-white first:border-s-0 border-s border-b-2 border-slate-200 py-4 px-4 text-slate-500 hover:text-slate-900 text-sm font-bold text-center overflow-hidden transition-all
                         data-[active=true]:border-b-blue-600 data-[active=true]:text-slate-950 data-[active=true]:bg-slate-50/50"
                  role="tab">
            Booking Details
          </button>
          <button type="button"
                  data-booking-tabs-target="tab"
                  data-tab-name="requests"
                  data-action="click->booking-tabs#switch"
                  class="relative min-w-0 flex-1 bg-white first:border-s-0 border-s border-b-2 border-slate-200 py-4 px-4 text-slate-500 hover:text-slate-900 text-sm font-bold text-center overflow-hidden transition-all
                         data-[active=true]:border-b-blue-600 data-[active=true]:text-slate-950 data-[active=true]:bg-slate-50/50 flex items-center justify-center gap-2"
                  role="tab">
            Requests
            <% if @presenter.pending_requests_count > 0 %>
              <span class="inline-flex items-center justify-center size-5 rounded-full bg-amber-100 text-[10px] font-black text-amber-800">
                <%= @presenter.pending_requests_count %>
              </span>
            <% end %>
          </button>
        </nav>

        <div data-booking-tabs-target="panel" data-tab-panel="booking-details" class="space-y-8 animate-in fade-in duration-300">
          <div class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">
            <div class="border-b border-slate-200 bg-slate-50/70 px-6 py-5 sm:px-8">
              <h2 class="text-lg font-bold tracking-tight text-slate-950">Guest Information</h2>
              <p class="mt-1 text-sm font-medium text-slate-600">Contact details and identity information.</p>
            </div>
            <div class="p-6 sm:p-8">
              <%= form_with model: @booking, url: hotel_booking_path(current_hotel, @booking), method: :patch, local: true, class: "grid sm:grid-cols-2 gap-6" do |f| %>
                <div class="sm:col-span-2">
                  <label class="block text-[11px] font-bold text-slate-500 uppercase tracking-wider mb-2">Full Guest Name</label>
                  <%= f.text_field :guest_name, class: "w-full rounded-xl border border-slate-200 bg-white px-4 py-2.5 text-sm font-medium text-slate-700 focus:border-slate-300 focus:outline-none focus:ring-0 shadow-sm" %>
                </div>
                <div>
                  <label class="block text-[11px] font-bold text-slate-500 uppercase tracking-wider mb-2">Email Address</label>
                  <%= f.email_field :guest_email, class: "w-full rounded-xl border border-slate-200 bg-white px-4 py-2.5 text-sm font-medium text-slate-700 focus:border-slate-300 focus:outline-none focus:ring-0 shadow-sm" %>
                </div>
                <div>
                  <label class="block text-[11px] font-bold text-slate-500 uppercase tracking-wider mb-2">Phone Number</label>
                  <%= f.telephone_field :guest_phone, class: "w-full rounded-xl border border-slate-200 bg-white px-4 py-2.5 text-sm font-medium text-slate-700 focus:border-slate-300 focus:outline-none focus:ring-0 shadow-sm" %>
                </div>
                <div class="sm:col-span-2 pt-4 flex justify-end">
                  <%= f.submit "Save Changes", class: "inline-flex items-center rounded-xl bg-slate-900 px-6 py-2.5 text-sm font-bold text-white shadow-sm transition hover:bg-slate-700" %>
                </div>
              <% end %>
            </div>
          </div>

          <% if @presenter.pre_checkin.present? && @booking.pre_checkin_display_status == "completed" %>
            <% pre_checkin_metadata = @presenter.pre_checkin&.metadata || {} %>
            <div class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">
              <div class="border-b border-slate-200 bg-slate-50/70 px-6 py-5 sm:px-8 flex items-center justify-between gap-3">
                <div>
                  <h2 class="text-lg font-bold tracking-tight text-slate-950">Pre Check-In Details</h2>
                  <p class="mt-1 text-sm font-medium text-slate-600">Guest-submitted arrival information.</p>
                </div>
                <span class="inline-flex items-center rounded-full border border-emerald-200 bg-emerald-50 px-2.5 py-1 text-[11px] font-semibold text-emerald-700">Completed</span>
              </div>
              <div class="p-6 sm:p-8">
                <div class="grid sm:grid-cols-2 gap-8">
                  <div>
                    <dt class="text-[11px] font-bold text-slate-500 uppercase tracking-wider mb-2">Estimated Arrival</dt>
                    <dd class="text-base font-semibold text-slate-900"><%= pre_checkin_metadata["estimated_arrival_time"].presence || @booking.estimated_arrival_time.presence || "Not provided" %></dd>
                  </div>
                  <div>
                    <dt class="text-[11px] font-bold text-slate-500 uppercase tracking-wider mb-2">ID / Passport Number</dt>
                    <dd class="text-base font-semibold text-slate-900"><%= pre_checkin_metadata["guest_government_id"].presence || "Not provided" %></dd>
                  </div>
                </div>
              </div>
            </div>
          <% end %>

          <div class="grid lg:grid-cols-2 gap-8">
            <div class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">
              <div class="border-b border-slate-200 bg-slate-50/70 px-6 py-5 sm:px-8 flex items-center justify-between">
                <h2 class="text-lg font-bold tracking-tight text-slate-950">Stay & Room Details</h2>
                <div class="flex items-center gap-3">
                  <% if current_user.has_permission?("manage_bookings", hotel: current_hotel) %>
                    <button type="button" class="inline-flex items-center gap-x-1.5 text-xs font-bold text-blue-600 hover:text-blue-700 transition" onclick="document.getElementById('edit-stay-details-modal').showModal()">
                      <svg class="size-3.5" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M17 3a2.85 2.83 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5Z"/><path d="m15 5 4 4"/></svg>
                      Edit
                    </button>
                  <% end %>
                </div>
              </div>

              <dialog id="edit-stay-details-modal" 
                      class="fixed inset-0 m-auto rounded-2xl p-0 w-[min(92vw,32rem)] max-w-lg shadow-2xl backdrop:bg-slate-900/50" onclick="if(event.target===this){this.close()}">
                <div class="p-6 bg-white" onclick="event.stopPropagation()">
                  <h3 class="text-lg font-bold text-slate-900">Edit Stay & Room Details</h3>
                  <p class="text-sm text-slate-500 mt-1">Update booking dates and room assignment.</p>

                  <%= form_with model: @booking, url: hotel_booking_path(current_hotel, @booking), method: :patch, local: true, 
                      class: "mt-6 space-y-4",
                      data: { 
                        controller: "booking-calc", 
                        booking_calc_availability_url_value: availability_hotel_bookings_path(current_hotel),
                        booking_calc_price_url_value: stay_price_hotel_bookings_path(current_hotel),
                        booking_calc_booking_id_value: @booking.id
                      } do |f| %>
                    <div class="grid sm:grid-cols-2 gap-4">
                      <div>
                        <label class="block text-[11px] font-bold text-slate-500 uppercase tracking-wider mb-2">Check-in Date</label>
                        <%= f.date_field :check_in, class: "w-full rounded-xl border border-slate-200 bg-white py-2.5 px-4 text-sm text-slate-700 focus:border-slate-300 focus:outline-none focus:ring-0 shadow-sm", data: { booking_calc_target: "checkIn", action: "change->booking-calc#calculate" } %>
                      </div>
                      <div>
                        <label class="block text-[11px] font-bold text-slate-500 uppercase tracking-wider mb-2">Check-out Date</label>
                        <%= f.date_field :check_out, class: "w-full rounded-xl border border-slate-200 bg-white py-2.5 px-4 text-sm text-slate-700 focus:border-slate-300 focus:outline-none focus:ring-0 shadow-sm", data: { booking_calc_target: "checkOut", action: "change->booking-calc#calculate" } %>
                      </div>
                    </div>

                    <div>
                      <label class="block text-[11px] font-bold text-slate-500 uppercase tracking-wider mb-2">Room Category</label>
                      <% current_room_type_id = @booking.booking_rooms.first&.room_type_id %>
                      <%= f.collection_select :room_type_id, @presenter.room_types, :id, :name, { selected: current_room_type_id }, 
                          { class: "w-full rounded-xl border border-slate-200 bg-white px-4 py-2.5 text-sm font-medium text-slate-700 focus:border-slate-300 focus:outline-none focus:ring-0 shadow-sm", 
                            data: { 
                              booking_calc_target: "roomType", 
                              action: "change->booking-calc#updateRoomNumbers change->booking-calc#calculate",
                              prices: @presenter.room_types.map { |rt| [rt.id, rt.base_price] }.to_h.to_json,
                              room_numbers: @presenter.room_types.map { |rt| [rt.id, rt.room_numbers] }.to_h.to_json
                            } 
                          } %>
                    </div>

                    <div data-controller="room-lock" 
                         data-room-lock-url-value="<%= hotel_room_locks_path(current_hotel) %>"
                         data-room-lock-room-type-id-value="<%= current_room_type_id %>"
                         data-room-lock-current-room-value="<%= @booking.hotel_snapshot.is_a?(Hash) ? (@booking.hotel_snapshot['room_number'] || @booking.hotel_snapshot.dig('assignment', 'room_number')) : nil %>"
                         data-booking-calc-target="roomNumberContainer">
                      <label for="booking_room_number" class="block text-[11px] font-bold text-slate-500 uppercase tracking-wider mb-2">Room Number</label>
                      <% current_room_number = @booking.hotel_snapshot.is_a?(Hash) ? @booking.hotel_snapshot['room_number'].presence || @booking.hotel_snapshot.dig('assignment', 'room_number').presence : nil %>
                      <%= f.select :room_number, [[current_room_number, current_room_number]], { selected: current_room_number }, 
                          { id: "booking_room_number",
                            required: true,
                            class: "w-full rounded-xl border border-slate-200 bg-white py-2.5 px-4 text-sm text-slate-700 focus:border-slate-300 focus:outline-none focus:ring-0 shadow-sm", 
                            data: { 
                              booking_calc_target: "roomNumberSelect",
                              action: "change->room-lock#lock"
                            } 
                          } %>
                      <p class="text-[10px] text-slate-400 mt-1.5 italic">Only available rooms for the selected dates are shown.</p>
                    </div>

                    <div class="flex items-center justify-end gap-x-3 pt-4">
                      <button type="button" class="px-4 py-2 text-sm font-semibold text-slate-700 hover:bg-slate-50 rounded-lg transition" onclick="this.closest('dialog').close()">Cancel</button>
                      <%= f.submit "Save Changes", class: "px-6 py-2 text-sm font-bold bg-slate-900 text-white rounded-lg hover:bg-slate-700 transition shadow-sm" %>
                    </div>
                  <% end %>
                </div>
              </dialog>
              <div class="p-6 sm:p-8 space-y-8">

                <div class="grid grid-cols-2 gap-6">
                  <div>
                    <dt class="text-[11px] font-bold text-slate-500 uppercase tracking-wider mb-1">Check-in</dt>
                    <dd class="text-sm font-semibold text-slate-900"><%= @booking.check_in.strftime("%d %b %Y") %></dd>
                  </div>
                  <div>
                    <dt class="text-[11px] font-bold text-slate-500 uppercase tracking-wider mb-1">Check-out</dt>
                    <dd class="text-sm font-semibold text-slate-900"><%= @booking.check_out.strftime("%d %b %Y") %></dd>
                  </div>
                  <div>
                    <dt class="text-[11px] font-bold text-slate-500 uppercase tracking-wider mb-1">Adults</dt>
                    <dd class="text-sm font-semibold text-slate-900"><%= @booking.adults %></dd>
                  </div>
                  <div>
                    <dt class="text-[11px] font-bold text-slate-500 uppercase tracking-wider mb-1">Children</dt>
                    <dd class="text-sm font-semibold text-slate-900"><%= @booking.children %></dd>
                  </div>
                </div>

                <div class="space-y-3">
                  <h3 class="text-[11px] font-bold text-slate-500 uppercase tracking-wider">Reserved Units</h3>
                  <% @presenter.booking_rooms.each do |room| %>
                    <div class="flex justify-between items-center p-4 rounded-xl border border-slate-100 bg-slate-50/50">
                      <div>
                        <p class="text-sm font-bold text-slate-900"><%= room.room_type_snapshot['name'] %></p>
                        <p class="text-xs text-slate-500"><%= pluralize(room.quantity, 'room') %></p>
                      </div>
                      <div class="text-right">
                        <p class="text-sm font-bold text-slate-900">MYR <%= number_with_precision(room.subtotal, precision: 2) %></p>
                        <% room_number = room.room_number.presence || (@booking.hotel_snapshot.is_a?(Hash) ? @booking.hotel_snapshot['room_number'].presence || @booking.hotel_snapshot.dig('assignment', 'room_number').presence : nil) %>
                        <% if room_number.present? %>
                          <p class="text-[10px] font-black uppercase tracking-widest text-emerald-600 mt-1">Room <%= room_number %></p>
                        <% end %>
                      </div>
                    </div>
                  <% end %>
                </div>
              </div>
            </div>

            <div id="booking_notes_panel">
              <%= render "hotel_portal/bookings/internal_notes", booking: @booking %>
            </div>
          </div>
        </div>

        <div data-booking-tabs-target="panel" data-tab-panel="requests" class="space-y-8 hidden animate-in fade-in duration-300">
          <div class="grid lg:grid-cols-2 gap-8">
            <!-- Housekeeping -->
            <div class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm h-fit">
              <div class="border-b border-slate-200 bg-slate-50/70 px-6 py-5 sm:px-8 flex items-center justify-between gap-3">
                <div>
                  <h2 class="text-lg font-bold tracking-tight text-slate-950">Housekeeping</h2>
                  <p class="mt-1 text-sm font-medium text-slate-600">Guest requests for room services.</p>
                </div>
                <span class="inline-flex items-center rounded-full border border-slate-200 bg-white px-2.5 py-1 text-[11px] font-semibold text-slate-700">
                  <%= @presenter.housekeeping_requests.to_a.count %>
                </span>
              </div>
              <div class="p-6 space-y-4">
                <% if @presenter.housekeeping_requests.any? %>
                  <% @presenter.housekeeping_requests.each do |request| %>
                    <div class="rounded-2xl border border-slate-200 bg-slate-50/60 p-4 space-y-4">
                      <div class="flex items-start justify-between gap-4">
                        <div class="flex-1 min-w-0 space-y-2">
                          <div>
                            <dt class="text-[10px] font-bold text-slate-500 uppercase tracking-widest">Requested</dt>
                            <dd class="text-xs font-semibold text-slate-900"><%= display_housekeeping_datetime(request.display_requested_at) %></dd>
                          </div>
                          <div>
                            <dt class="text-[10px] font-bold text-slate-500 uppercase tracking-widest">Details</dt>
                            <dd class="text-sm text-slate-700 leading-relaxed"><%= request.request_details %></dd>
                          </div>
                        </div>
                        <span class="inline-flex items-center rounded-full border px-2 py-0.5 text-[10px] font-bold uppercase tracking-wider <%= housekeeping_status_class(request.status).gsub('bg-', 'border-').gsub('text-', 'text-') %> bg-opacity-10">
                          <%= request.status %>
                        </span>
                      </div>
                      <% unless request.completed? || request.cancelled? %>
                        <div class="flex justify-end gap-2 pt-2">
                           <%= button_to "Complete Request", complete_housekeeping_request_hotel_booking_path(current_hotel, @booking, housekeeping_request_id: request.id), method: :post, class: "inline-flex items-center rounded-lg bg-slate-900 px-3 py-1.5 text-xs font-bold text-white shadow-sm transition hover:bg-slate-700" %>
                        </div>
                      <% end %>
                    </div>
                  <% end %>
                <% else %>
                  <div class="py-10 text-center border border-dashed border-slate-200 rounded-2xl">
                    <p class="text-sm font-medium text-slate-500">No housekeeping requests.</p>
                  </div>
                <% end %>
              </div>
            </div>

            <!-- Complaints -->
            <div class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm h-fit">
              <div class="border-b border-slate-200 bg-slate-50/70 px-6 py-5 sm:px-8 flex items-center justify-between gap-3">
                <div>
                  <h2 class="text-lg font-bold tracking-tight text-slate-950">Complaints</h2>
                  <p class="mt-1 text-sm font-medium text-slate-600">Guest-reported issues and status.</p>
                </div>
                <span class="inline-flex items-center rounded-full border border-slate-200 bg-white px-2.5 py-1 text-[11px] font-semibold text-slate-700">
                  <%= @presenter.complaint_requests.to_a.count %>
                </span>
              </div>
              <div class="p-6 space-y-4">
                <% if @presenter.complaint_requests.any? %>
                  <% @presenter.complaint_requests.each do |request| %>
                    <div class="rounded-2xl border border-slate-200 bg-slate-50/60 p-4 space-y-4">
                      <div class="flex items-start justify-between gap-4">
                        <div class="flex-1 min-w-0 space-y-2">
                          <div>
                            <dt class="text-[10px] font-bold text-slate-500 uppercase tracking-widest">Reported</dt>
                            <dd class="text-xs font-semibold text-slate-900"><%= display_housekeeping_datetime(request.display_requested_at) %></dd>
                          </div>
                          <div>
                            <dt class="text-[10px] font-bold text-slate-500 uppercase tracking-widest">Details</dt>
                            <dd class="text-sm text-slate-700 leading-relaxed"><%= request.complaint_details %></dd>
                          </div>
                        </div>
                        <span class="inline-flex items-center rounded-full border px-2 py-0.5 text-[10px] font-bold uppercase tracking-wider <%= complaint_status_class(request.status).gsub('bg-', 'border-').gsub('text-', 'text-') %> bg-opacity-10">
                          <%= request.status %>
                        </span>
                      </div>
                      <% unless request.resolved? || request.cancelled? %>
                        <div class="flex justify-end gap-2 pt-2">
                           <%= button_to "Resolve Complaint", resolve_complaint_request_hotel_booking_path(current_hotel, @booking, complaint_request_id: request.id), method: :post, class: "inline-flex items-center rounded-lg bg-slate-900 px-3 py-1.5 text-xs font-bold text-white shadow-sm transition hover:bg-slate-700" %>
                        </div>
                      <% end %>
                    </div>
                  <% end %>
                <% else %>
                  <div class="py-10 text-center border border-dashed border-slate-200 rounded-2xl">
                    <p class="text-sm font-medium text-slate-500">No complaint requests.</p>
                  </div>
                <% end %>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Sidebar Column -->
    <div class="lg:col-span-3 space-y-8">
      <!-- Summary Card -->
      <div class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">
        <div class="border-b border-slate-200 bg-slate-50/70 px-6 py-4">
          <h3 class="text-[11px] font-bold text-slate-500 uppercase tracking-widest">Summary</h3>
        </div>
        <div class="p-6 space-y-4">
          <div class="flex justify-between items-center text-sm">
            <span class="text-slate-500 font-medium">Payment</span>
            <span class="inline-flex items-center rounded-full border px-2 py-0.5 text-[10px] font-bold tracking-wider <%= hotel_payment_status_class(@booking.payment_status).gsub('bg-', 'border-').gsub('text-', 'text-') %> bg-opacity-10 uppercase">
              <%= hotel_payment_display_status(@booking.payment_status) %>
            </span>
          </div>
          <div class="flex justify-between items-center text-sm">
            <span class="text-slate-500 font-medium">Check-In Step</span>
            <% pc_status = pre_checkin_display_status(@booking) %>
            <span class="inline-flex items-center rounded-full border px-2 py-0.5 text-[10px] font-bold tracking-wider <%= pre_checkin_status_class(pc_status).gsub('bg-', 'border-').gsub('text-', 'text-') %> bg-opacity-10 uppercase">
              <%= pc_status.to_s.tr("_", " ") %>
            </span>
          </div>
          <div class="pt-4 border-t border-slate-100 flex justify-between items-baseline">
            <span class="text-xs font-bold text-slate-900 uppercase">Total Paid</span>
            <span class="text-xl font-bold text-slate-900">MYR <%= number_with_precision(@booking.total_amount, precision: 2) %></span>
          </div>
        </div>
      </div>

      <!-- Invoice Card -->
      <div class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">
        <div class="border-b border-slate-200 bg-slate-50/70 px-6 py-4">
          <h3 class="text-[11px] font-bold text-slate-500 uppercase tracking-widest">Invoice</h3>
        </div>
        <div class="p-4">
          <%= link_to invoice_booking_path(@booking.confirmation_token), target: "_blank", class: "w-full flex items-center justify-between px-4 py-2.5 rounded-xl text-sm font-semibold text-slate-700 hover:bg-slate-50 transition-colors", data: { turbo: false } do %>
            Download Invoice
            <svg class="size-3.5 text-slate-400" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3v12"/><path d="m7 10 5 5 5-5"/><path d="M5 21h14"/></svg>
          <% end %>
        </div>
      </div>

      <!-- Quick Actions -->
      <div class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">
        <div class="border-b border-slate-200 bg-slate-50/70 px-6 py-4">
          <h3 class="text-[11px] font-bold text-slate-500 uppercase tracking-widest">Actions</h3>
        </div>
        <div class="p-4 space-y-2">
          <button type="button" class="w-full flex items-center justify-between px-4 py-2.5 rounded-xl text-sm font-semibold text-slate-700 hover:bg-slate-50 transition-colors">
            Resend Confirmation
            <svg class="size-3.5 text-slate-400" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg>
          </button>
          <button type="button" class="w-full flex items-center justify-between px-4 py-2.5 rounded-xl text-sm font-semibold text-slate-700 hover:bg-slate-50 transition-colors">
            Resend Pre-Check-in
            <svg class="size-3.5 text-slate-400" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg>
          </button>
        </div>
      </div>
    </div>
  </div>
</div>
