<div class="max-w-[85rem] px-4 py-10 sm:px-6 lg:px-8 lg:py-14 mx-auto">
  <!-- Back link -->
  <div class="mb-5">
    <%= link_to hotel_bookings_path, class: "inline-flex items-center gap-x-1.5 text-sm font-medium text-gray-500 hover:text-blue-600 focus:outline-none focus:text-blue-600" do %>
      <svg class="flex-shrink-0 w-4 h-4" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg>
      Back to Bookings
    <% end %>
  </div>

  <div class="grid lg:grid-cols-3 gap-y-10 lg:gap-x-10">
    <!-- Main Content -->
    <div class="lg:col-span-2 space-y-8">
      <!-- Header -->
      <div class="flex justify-between items-start">
        <div>
          <h1 class="text-3xl font-bold text-gray-800">Booking <%= @booking.confirmation_token %></h1>
          <p class="text-sm text-gray-500">Created on <%= @booking.created_at.strftime("%d %b %Y at %H:%M") %></p>
        </div>
        <div class="flex gap-x-2">
          <% if @booking.status == 'confirmed' %>
            <%= button_to "Check In Guest", check_in_hotel_booking_path(@booking), method: :post, data: { turbo_confirm: "Are you sure you want to check in this guest?", turbo_confirm_title: "Confirm Check In" }, class: "py-2 px-3 inline-flex items-center gap-x-2 text-sm font-semibold rounded-lg border border-transparent bg-blue-600 text-white shadow-sm hover:bg-blue-700 disabled:opacity-50 disabled:pointer-events-none" %>
            <%= button_to "Cancel Booking", cancel_hotel_booking_path(@booking), method: :post, data: { turbo_confirm: "Are you sure you want to cancel this booking?", turbo_confirm_title: "Cancel Booking", turbo_confirm_color: "red" }, class: "py-2 px-3 inline-flex items-center gap-x-2 text-sm font-semibold rounded-lg border border-gray-200 bg-white text-red-600 shadow-sm hover:bg-gray-50 disabled:opacity-50 disabled:pointer-events-none" %>
          <% elsif @booking.status == 'checked_in' %>
            <%= button_to "Check Out Guest", check_out_hotel_booking_path(@booking), method: :post, data: { turbo_confirm: "Are you sure you want to check out this guest?", turbo_confirm_title: "Confirm Check Out" }, class: "py-2 px-3 inline-flex items-center gap-x-2 text-sm font-semibold rounded-lg border border-transparent bg-green-600 text-white shadow-sm hover:bg-green-700 disabled:opacity-50 disabled:pointer-events-none" %>
          <% end %>
        </div>
      </div>

      <!-- Guest Details Card -->
      <div class="bg-white border border-gray-200 rounded-xl shadow-sm overflow-hidden">
        <div class="px-6 py-4 border-b border-gray-200 bg-gray-50">
          <h2 class="text-lg font-semibold text-gray-800">Guest Information</h2>
        </div>
        <div class="p-6">
          <%= form_with model: [:hotel, @booking], local: true, class: "grid sm:grid-cols-2 gap-4" do |f| %>
            <div class="sm:col-span-2">
              <label class="block text-sm font-medium mb-2 text-gray-700">Guest Name</label>
              <%= f.text_field :guest_name, class: "py-3 px-4 block w-full border-gray-200 rounded-lg text-sm focus:border-blue-500 focus:ring-blue-500 border" %>
            </div>
            <div>
              <label class="block text-sm font-medium mb-2 text-gray-700">Email Address</label>
              <%= f.email_field :guest_email, class: "py-3 px-4 block w-full border-gray-200 rounded-lg text-sm focus:border-blue-500 focus:ring-blue-500 border" %>
            </div>
            <div>
              <label class="block text-sm font-medium mb-2 text-gray-700">Phone Number</label>
              <%= f.telephone_field :guest_phone, class: "py-3 px-4 block w-full border-gray-200 rounded-lg text-sm focus:border-blue-500 focus:ring-blue-500 border" %>
            </div>
            <div class="sm:col-span-2 pt-4 border-t border-gray-100 flex justify-end">
              <%= f.submit "Update Guest Details", class: "py-2 px-4 inline-flex items-center gap-x-2 text-sm font-semibold rounded-lg border border-transparent bg-blue-600 text-white hover:bg-blue-700 transition" %>
            </div>
          <% end %>
        </div>
      </div>

      <!-- Stay & Room Details Card -->
      <div class="bg-white border border-gray-200 rounded-xl shadow-sm overflow-hidden">
        <div class="px-6 py-4 border-b border-gray-200 bg-gray-50">
          <h2 class="text-lg font-semibold text-gray-800">Stay & Room Details</h2>
        </div>
        <div class="p-6 space-y-6">
          <div class="grid grid-cols-2 sm:grid-cols-4 gap-4">
            <div>
              <p class="text-xs text-gray-500 uppercase font-bold tracking-wider">Check-in</p>
              <p class="text-gray-800 font-medium"><%= @booking.check_in.strftime("%d %b %Y") %></p>
            </div>
            <div>
              <p class="text-xs text-gray-500 uppercase font-bold tracking-wider">Check-out</p>
              <p class="text-gray-800 font-medium"><%= @booking.check_out.strftime("%d %b %Y") %></p>
            </div>
            <div>
              <p class="text-xs text-gray-500 uppercase font-bold tracking-wider">Adults</p>
              <p class="text-gray-800 font-medium"><%= @booking.adults %></p>
            </div>
            <div>
              <p class="text-xs text-gray-500 uppercase font-bold tracking-wider">Children</p>
              <p class="text-gray-800 font-medium"><%= @booking.children %></p>
            </div>
          </div>

          <div class="space-y-4">
            <h3 class="text-sm font-bold text-gray-800 uppercase tracking-wider">Rooms</h3>
            <% @booking_rooms.each do |room| %>
              <div class="flex justify-between items-center p-4 bg-gray-50 rounded-lg border border-gray-200">
                <div>
                  <p class="font-bold text-gray-800"><%= room.room_type_snapshot['name'] %></p>
                  <p class="text-xs text-gray-500"><%= room.quantity %> room(s)</p>
                </div>
                <div class="text-right">
                  <p class="font-bold text-blue-600">MYR <%= room.subtotal %></p>
                </div>
              </div>
            <% end %>
          </div>
        </div>
      </div>
    </div>

    <!-- Sidebar -->
    <div class="space-y-6">
      <!-- Status Card -->
      <div class="bg-white border border-gray-200 rounded-xl shadow-sm overflow-hidden p-6">
        <h3 class="text-sm font-bold text-gray-800 uppercase tracking-wider mb-4">Status Summary</h3>
        <div class="space-y-4">
          <div class="flex justify-between items-center">
            <span class="text-sm text-gray-500">Booking Status</span>
            <% 
              status_class = case @booking.status
              when 'confirmed' then 'bg-green-100 text-green-800'
              when 'checked_in' then 'bg-blue-100 text-blue-800'
              when 'completed' then 'bg-gray-100 text-gray-800'
              when 'cancelled' then 'bg-red-100 text-red-800'
              when 'pending' then 'bg-yellow-100 text-yellow-800'
              else 'bg-gray-100 text-gray-800'
              end
            %>
            <span class="py-1 px-2 inline-flex items-center gap-x-1 text-xs font-medium rounded-full <%= status_class %>">
              <%= @booking.status.titleize %>
            </span>
          </div>
          <% if @booking.checked_in? %>
            <div class="flex justify-between items-center">
              <span class="text-sm text-gray-500">Checked In At</span>
              <span class="text-sm font-medium text-gray-800"><%= @booking.checked_in_at.strftime("%d %b %Y %H:%M") %></span>
            </div>
          <% end %>
          <% if @booking.checked_out? && @booking.checked_out_at.present? %>
            <div class="flex justify-between items-center">
              <span class="text-sm text-gray-500">Checked Out At</span>
              <span class="text-sm font-medium text-gray-800"><%= @booking.checked_out_at.strftime("%d %b %Y %H:%M") %></span>
            </div>
          <% end %>
          <div class="flex justify-between items-center">
            <span class="text-sm text-gray-500">Payment Status</span>
            <% 
              p_status_class = case @booking.payment_status
              when 'captured' then 'bg-green-100 text-green-800'
              when 'pending' then 'bg-yellow-100 text-yellow-800'
              when 'failed' then 'bg-red-100 text-red-800'
              else 'bg-gray-100 text-gray-800'
              end
            %>
            <span class="py-1 px-2 inline-flex items-center gap-x-1 text-xs font-medium rounded-full <%= p_status_class %>">
              <%= @booking.payment_status.titleize %>
            </span>
          </div>
          <div class="flex justify-between items-center pt-4 border-t border-gray-100">
            <span class="text-sm font-bold text-gray-800">Total Charged</span>
            <span class="text-lg font-bold text-blue-600">MYR <%= @booking.total_amount %></span>
          </div>
        </div>
      </div>

      <!-- Quick Actions -->
      <div class="bg-white border border-gray-200 rounded-xl shadow-sm overflow-hidden p-6">
        <h3 class="text-sm font-bold text-gray-800 uppercase tracking-wider mb-4">Quick Actions</h3>
        <div class="space-y-2">
          <button class="w-full py-2 px-3 inline-flex justify-center items-center gap-x-2 text-sm font-medium rounded-lg border border-gray-200 bg-white text-gray-800 shadow-sm hover:bg-gray-50">
            Resend Confirmation
          </button>
          <button class="w-full py-2 px-3 inline-flex justify-center items-center gap-x-2 text-sm font-medium rounded-lg border border-gray-200 bg-white text-gray-800 shadow-sm hover:bg-gray-50">
            Resend Pre-Check-in
          </button>
          <button class="w-full py-2 px-3 inline-flex justify-center items-center gap-x-2 text-sm font-medium rounded-lg border border-gray-200 bg-white text-gray-800 shadow-sm hover:bg-gray-50">
            Add Internal Note
          </button>
        </div>
        </div>
        </div>
        </div>

        <!-- Internal Notes -->
        <div class="bg-white border border-gray-200 rounded-xl shadow-sm overflow-hidden">
        <div class="px-6 py-4 border-b border-gray-200 bg-gray-50 flex justify-between items-center">
        <h2 class="text-lg font-semibold text-gray-800">Internal Notes</h2>
        <span class="text-xs text-gray-500 uppercase font-bold tracking-wider">Hotel Staff Only</span>
        </div>
        <div class="p-6 space-y-6">
        <div class="space-y-4 max-h-[400px] overflow-y-auto pr-2">
        <% if @booking.booking_notes.any? %>
          <% @booking.booking_notes.order(created_at: :desc).each do |note| %>
            <div class="bg-blue-50 p-4 rounded-lg border border-blue-100">
              <div class="flex justify-between items-start mb-2">
                <span class="text-xs font-bold text-blue-800"><%= note.user.name %></span>
                <span class="text-[10px] text-blue-600"><%= note.created_at.strftime("%d %b %Y %H:%M") %></span>
              </div>
              <p class="text-sm text-gray-800 whitespace-pre-wrap"><%= note.body %></p>
            </div>
          <% end %>
        <% else %>
          <p class="text-sm text-gray-500 text-center italic py-4">No internal notes for this booking.</p>
        <% end %>
        </div>

        <div class="pt-6 border-t border-gray-100">
        <%= form_with model: [:hotel, @booking, BookingNote.new], url: hotel_booking_booking_notes_path(@booking), local: true do |f| %>
          <div>
            <label class="block text-sm font-medium mb-2 text-gray-700">Add Note</label>
            <%= f.text_area :body, rows: 3, placeholder: "Type internal note here...", class: "py-3 px-4 block w-full border-gray-200 rounded-lg text-sm focus:border-blue-500 focus:ring-blue-500 border" %>
          </div>
          <div class="mt-3 flex justify-end">
            <%= f.submit "Save Note", class: "py-2 px-4 inline-flex items-center gap-x-2 text-sm font-semibold rounded-lg border border-transparent bg-blue-600 text-white hover:bg-blue-700 transition" %>
          </div>
        <% end %>
        </div>
        </div>
        </div>
        </div>
