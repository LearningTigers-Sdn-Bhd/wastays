<%= turbo_frame_tag "offcanvas_drawer" do %>
  <div class="flex h-full flex-col bg-white">
    <%= render "hotel_portal/bookings/board/partials/content_header",
      title: "Edit Booking",
      subtitle: "Guest, contact, source, and guarantee details",
      icon: cached_icon("pencil", class: "size-5") %>
    <%= form_with model: @booking, url: hotel_booking_transaction_edit_booking_path(current_hotel, @booking), method: :patch, class: "flex flex-1 flex-col p-8" do |f| %>
      <%= hidden_field_tag :return_to, @transaction_return_to if @transaction_return_to.present? %>
      <% if @booking.errors.any? %>
        <div class="mb-5 rounded-xl border border-red-200 bg-red-50 p-4 text-sm text-red-700" role="alert">
          <p class="font-bold">Booking details could not be updated.</p>
          <ul class="mt-2 list-disc space-y-1 pl-5">
            <% @booking.errors.full_messages.each do |message| %>
              <li><%= message %></li>
            <% end %>
          </ul>
        </div>
      <% end %>
      <div class="grid gap-5 sm:grid-cols-2">
        <% [ [ :guest_name, "Guest name" ], [ :guest_email, "Email" ], [ :guest_phone, "Phone" ], [ :guest_country, "Country" ], [ :source, "Source" ], [ :guarantee_method, "Guarantee method" ] ].each do |field, label| %>
          <div>
            <%= f.label field, label, class: "mb-2 block text-xs font-bold uppercase tracking-wider text-slate-500" %>
            <%= f.text_field field, class: "w-full rounded-xl border border-slate-200 px-4 py-3" %>
          </div>
        <% end %>
      </div>
      <div class="mt-auto flex flex-wrap items-center justify-between gap-3 pt-6">
        <div class="flex flex-wrap gap-2">
          <%= link_to "Amend Stay", hotel_booking_transaction_amend_stay_path(current_hotel, @booking, source: @transaction_source, return_to: @transaction_return_to), data: { turbo_frame: "offcanvas_drawer", offcanvas_variant: "right" }, class: "rounded-xl border border-slate-200 px-4 py-3 text-sm font-bold text-slate-700" %>
          <% if @booking.status == "confirmed" %>
            <%= link_to "Check In", hotel_booking_transaction_check_in_reservation_path(current_hotel, @booking, source: @transaction_source, return_to: @transaction_return_to), data: { turbo_frame: "offcanvas_drawer", offcanvas_variant: "right" }, class: "rounded-xl bg-emerald-600 px-4 py-3 text-sm font-bold text-white" %>
            <%= link_to "Cancel", hotel_booking_transaction_cancel_booking_path(current_hotel, @booking, source: @transaction_source, return_to: @transaction_return_to), data: { turbo_frame: "offcanvas_drawer", offcanvas_variant: "right" }, class: "rounded-xl border border-red-200 px-4 py-3 text-sm font-bold text-red-700" %>
          <% elsif @booking.status == "checked_in" || @booking.status == "review_due_out" %>
            <%= link_to "Check Out", hotel_booking_transaction_check_out_path(current_hotel, @booking, source: @transaction_source, return_to: @transaction_return_to), data: { turbo_frame: "offcanvas_drawer", offcanvas_variant: "fullscreen-bottom" }, class: "rounded-xl bg-slate-900 px-4 py-3 text-sm font-bold text-white" %>
          <% elsif @booking.status == "no_show" %>
            <%= link_to "Reinstate", hotel_booking_transaction_reinstate_no_show_path(current_hotel, @booking, source: @transaction_source, return_to: @transaction_return_to), data: { turbo_frame: "offcanvas_drawer", offcanvas_variant: "right" }, class: "rounded-xl bg-blue-600 px-4 py-3 text-sm font-bold text-white" %>
          <% end %>
        </div>
        <%= f.submit "Save Booking", class: "rounded-xl bg-slate-900 px-6 py-3 text-sm font-bold text-white" %>
      </div>
    <% end %>
  </div>
<% end %>
