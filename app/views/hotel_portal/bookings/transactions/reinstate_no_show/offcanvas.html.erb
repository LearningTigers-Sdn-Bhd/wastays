<%= turbo_frame_tag "offcanvas_drawer" do %>
  <div class="flex h-full flex-col bg-white">
    <%= render "hotel_portal/bookings/board/partials/content_header",
      title: "Reinstate No-show",
      subtitle: @booking.guest_name,
      icon: cached_icon("rotate-ccw", class: "size-5") %>

    <% form_data = @booking.group_booking_id? ? {
      controller: "group-lifecycle-targets",
      group_lifecycle_targets_master_detail_value: true,
      group_lifecycle_targets_initial_booking_id_value: @booking.id,
      group_lifecycle_targets_selection_mode_value: "radio"
    } : {} %>
    <%= form_with model: @booking,
      url: reinstate_hotel_booking_path(current_hotel, @booking),
      method: :post,
      class: "flex min-h-0 flex-1 flex-col",
      data: form_data do |f| %>
      <%= hidden_field_tag :return_to, @transaction_return_to if @transaction_return_to.present? %>

      <% if @booking.group_booking_id? %>
        <%= hidden_field_tag :target_scope, "individual" %>
        <div class="grid min-h-0 flex-1 grid-rows-[auto_minmax(0,1fr)] overflow-hidden lg:grid-cols-[20rem_minmax(0,1fr)] lg:grid-rows-none">
          <%= render "hotel_portal/bookings/transactions/shared/group_target_selector",
            target_presenter: HotelPortal::BookingLifecycleTargetPresenter.new(booking: @booking, action: :reinstate),
            master_detail: true,
            selection_mode: :radio %>

          <div class="min-h-0 min-w-0 overflow-y-auto custom-scrollbar lg:col-start-2">
            <div class="space-y-6 p-8">
            <% @group_reinstatement_bookings.each do |child| %>
              <% active_child = child.id == @booking.id %>
              <section <%= "hidden" unless active_child %>
                       data-group-lifecycle-targets-target="panel"
                       data-booking-id="<%= child.id %>"
                       aria-hidden="<%= !active_child %>"
                       data-action="change->group-lifecycle-targets#configurationChanged">
                <%= render "hotel_portal/bookings/transactions/reinstate_no_show/booking_fields",
                  booking: child,
                  input_prefix: "reinstatements[#{child.id}][booking_rooms_attributes]",
                  dom_prefix: "reinstatement_#{child.id}" %>
              </section>
            <% end %>

            <%= render "hotel_portal/bookings/transactions/reinstate_no_show/reason_field" %>
            </div>
          </div>
        </div>
      <% else %>
        <div class="flex-1 space-y-6 overflow-y-auto p-8">
          <%= render "hotel_portal/bookings/transactions/reinstate_no_show/booking_fields",
            booking: @booking,
            input_prefix: "booking[booking_rooms_attributes]",
            dom_prefix: "booking" %>
          <%= render "hotel_portal/bookings/transactions/reinstate_no_show/reason_field" %>
        </div>
      <% end %>

      <%= render "hotel_portal/bookings/board/partials/content_footer",
        show_full_page_link: false,
        submit_button: f.submit("Reinstate & Check In", class: "rounded-xl bg-blue-600 px-6 py-2.5 text-sm font-bold text-white") %>
    <% end %>
  </div>
<% end %>
