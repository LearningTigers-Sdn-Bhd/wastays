<% quick = @transaction == :quick_booking %>
<% form_url = case @transaction
when :quick_booking then hotel_booking_transaction_quick_booking_path(current_hotel)
when :walk_in_check_in then hotel_booking_transaction_walk_in_check_in_path(current_hotel)
when :backdated_check_in then hotel_booking_transaction_backdated_check_in_path(current_hotel)
else hotel_booking_transaction_new_booking_path(current_hotel)
end %>
<% initial_type = case @transaction
when :walk_in_check_in then "walk_in"
when :backdated_check_in then "backdated_check_in"
else params[:booking_type].presence || "reservation"
end %>

<div class="flex h-full flex-col bg-stone-50" data-controller="booking-room-rows"
     data-booking-room-rows-availability-url-value="<%= availability_hotel_bookings_path(current_hotel) %>"
     data-booking-room-rows-rate-options-url-value="<%= rate_options_hotel_bookings_path(current_hotel) %>"
     data-booking-room-rows-initial-rows-value="<%= (@initial_room_rows || [{}]).to_json %>">
  <%= form_with model: @booking, url: form_url, local: true, class: "flex min-h-0 flex-1 flex-col", id: "manual_booking_form" do |f| %>
    <header class="flex items-center justify-between border-b border-stone-200 bg-white px-5 py-4">
      <div><h2 class="text-lg font-bold text-stone-950"><%= quick ? "Quick Booking" : "Full Booking" %></h2><p class="mt-0.5 text-xs text-stone-500"><%= quick ? "Confirm rooms now. Payment stays pending." : "Reservation, walk-in, or backdated check-in" %></p></div>
      <button type="button" aria-label="Close booking form" class="rounded-md p-2 text-stone-400 hover:bg-stone-100 hover:text-stone-700" data-action="click->offcanvas#close"><%= cached_icon("x", class: "size-5") %></button>
    </header>

    <div class="min-h-0 flex-1 overflow-y-auto">
      <div class="<%= quick ? 'mx-auto w-full' : 'grid min-h-full xl:grid-cols-[minmax(0,1fr)_360px]' %>">
        <main class="min-w-0">
          <section class="px-5 py-6 lg:px-7">
            <h3 class="mb-4 text-sm font-bold text-stone-900">Stay details</h3>
            <div class="grid gap-4 md:grid-cols-2 <%= quick ? 'xl:grid-cols-[1.25fr_1.25fr_.65fr_1fr]' : 'xl:grid-cols-[1fr_2fr_2fr_.65fr]' %>">
              <% unless quick %><div><%= label_tag :booking_type, "Booking type", class: "booking-form__label" %><%= select_tag :booking_type, options_for_select([["Reservation", "reservation"], ["Walk-in", "walk_in"], ["Backdated check-in", "backdated_check_in"]], initial_type), class: "booking-form__control", data: { booking_room_rows_target: "bookingType", action: "change->booking-room-rows#toggleBackdate" } %></div><% end %>
              <div><%= f.label :check_in, "Check-in", class: "booking-form__label" %><%= f.datetime_local_field :check_in, value: @booking.check_in&.in_time_zone(current_hotel.hotel_time_zone)&.strftime("%Y-%m-%dT%H:%M"), required: true, class: "booking-form__control", data: { booking_room_rows_target: "checkIn", action: "change->booking-room-rows#stayChanged" } %></div>
              <div><%= f.label :check_out, "Check-out", class: "booking-form__label" %><%= f.datetime_local_field :check_out, value: @booking.check_out&.in_time_zone(current_hotel.hotel_time_zone)&.strftime("%Y-%m-%dT%H:%M"), required: true, class: "booking-form__control", data: { booking_room_rows_target: "checkOut", action: "change->booking-room-rows#stayChanged" } %></div>
              <div><span class="booking-form__label">Nights</span><div class="booking-form__value" data-booking-room-rows-target="nights">1</div></div>
              <div class="<%= 'xl:col-start-1' unless quick %>"><%= f.label :source, "Booking source", class: "booking-form__label" %><%= f.select :source, [["Phone", "phone"], ["Walk-in", "walk_in"], ["Email", "email"], ["WhatsApp", "whatsapp"], ["Other", "internal"]], { selected: @booking.source || "phone" }, class: "booking-form__control" %></div>
            </div>
            <% unless quick %><div class="<%= initial_type == 'backdated_check_in' ? '' : 'hidden' %> mt-5 border-l-2 border-amber-400 bg-amber-50 p-4" data-booking-room-rows-target="backdateFields"><div class="grid gap-4 md:grid-cols-3"><div><%= label_tag :posting_date, "Posting date", class: "booking-form__label" %><%= date_field_tag :posting_date, params[:posting_date] || current_hotel.current_business_date, class: "booking-form__control" %></div><div><%= label_tag :backdate_reason, "Reason", class: "booking-form__label" %><%= select_tag :backdate_reason, options_for_select([["Guest arrived earlier", "Guest arrived earlier but was not checked in"], ["System / internet issue", "System / internet issue"], ["Manual offline check-in", "Manual offline check-in"], ["Other", "Other"]], params[:backdate_reason]), include_blank: "Select reason", class: "booking-form__control" %></div><div><%= label_tag :retroactive_reason, "Details", class: "booking-form__label" %><%= text_field_tag :retroactive_reason, params[:retroactive_reason], class: "booking-form__control", placeholder: "Optional unless Other" %></div></div></div><% end %>
          </section>

          <%= render "hotel_portal/bookings/transactions/new_booking/partials/room_rate_table", f: f %>

          <section class="border-t border-stone-200 px-5 py-6 lg:px-7">
            <h3 class="mb-4 text-sm font-bold text-stone-900">Guest information</h3>
            <div class="grid gap-4 md:grid-cols-3"><div><%= f.label :guest_name, "Guest name", class: "booking-form__label" %><%= f.text_field :guest_name, required: true, class: "booking-form__control", placeholder: "Full name" %></div><div><%= f.label :guest_phone, "Phone", class: "booking-form__label" %><%= f.telephone_field :guest_phone, required: true, class: "booking-form__control", placeholder: "+60 12-345 6789" %></div><div><%= f.label :guest_email, "Email", class: "booking-form__label" %><%= f.email_field :guest_email, required: true, class: "booking-form__control", placeholder: "guest@example.com" %></div></div>
          </section>

          <% unless quick %><section class="border-t border-stone-200 px-5 py-6 lg:px-7"><h3 class="mb-4 text-sm font-bold text-stone-900">Notes</h3><%= f.text_area :internal_notes, rows: 3, class: "booking-form__textarea", placeholder: "Special requests or internal notes" %></section><% end %>
        </main>

        <% unless quick %><aside class="min-h-full border-l border-stone-200 bg-white"><div class="xl:sticky xl:top-0 xl:max-h-[calc(100vh-9rem)] xl:overflow-y-auto"><section class="p-5"><p class="text-xs font-bold uppercase tracking-wider text-stone-500">Billing summary</p><div class="mt-4 space-y-3 border-y border-stone-200 py-4 text-sm text-stone-700"><div class="flex justify-between"><span>Room charges</span><strong class="text-stone-950">MYR <span data-booking-room-rows-target="roomTotal">0.00</span></strong></div><div class="flex justify-between text-base"><span>Total</span><strong class="text-stone-950">MYR <span data-booking-room-rows-target="grandTotal">0.00</span></strong></div></div></section><section class="border-t border-stone-200 p-5"><div><%= label_tag :bill_to, "Bill to", class: "booking-form__label" %><%= select_tag :bill_to, options_for_select([["Guest", "guest"], ["Corporate", "corporate"]]), class: "booking-form__control", data: { action: "change->booking-room-rows#toggleCorporate" } %></div><div class="mt-4 hidden" data-booking-room-rows-target="corporate"><%= f.label :hotel_corporate_account_id, "Corporate account", class: "booking-form__label" %><%= f.select :hotel_corporate_account_id, @corporate_accounts.map { |relationship| [relationship.corporate_account.name, relationship.id] }, { include_blank: "Select account" }, class: "booking-form__control" %><p class="mt-2 text-xs text-stone-500">All charges will be billed to the company. The guest remains a billing party.</p></div></section><%= render "hotel_portal/bookings/transactions/new_booking/partials/payment", f: f %></div></aside><% end %>
      </div>
    </div>

    <footer class="flex items-center justify-between gap-3 border-t border-stone-200 bg-white px-5 py-4">
      <div><% if quick %><%= link_to "More options", hotel_booking_transaction_new_booking_path(current_hotel), class: "rounded-md border border-stone-300 px-4 py-2 text-sm font-semibold text-stone-700 hover:bg-stone-100", data: { turbo_frame: "offcanvas_drawer", offcanvas_variant: "fullscreen-bottom", action: "booking-room-rows#moreOptions" } %><% end %></div>
      <div class="flex gap-3"><button type="button" class="px-4 py-2 text-sm font-semibold text-stone-600" data-action="click->offcanvas#close">Cancel</button><button type="submit" class="rounded-md bg-stone-950 px-5 py-2.5 text-sm font-bold text-white" data-turbo-submits-with="Creating…"><%= quick ? "Confirm booking" : "Create booking" %></button></div>
    </footer>
  <% end %>
</div>
