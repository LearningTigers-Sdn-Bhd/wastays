<div class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">
  <div class="border-b border-slate-200 bg-slate-50/70 px-6 py-4">
    <h3 class="text-sm font-bold text-slate-900">Stay Details</h3>
  </div>
  <div class="p-6 space-y-6">
    <div class="grid sm:grid-cols-2 gap-6">
      <div>
        <%= f.label :check_in, "Scheduled Check-in", class: "block text-[11px] font-bold text-slate-500 uppercase tracking-wider mb-2" %>
        <%= f.datetime_local_field :check_in, value: @booking.check_in&.in_time_zone(current_hotel.hotel_time_zone)&.strftime("%Y-%m-%dT%H:%M"), required: true, class: "w-full rounded-xl border border-slate-200 bg-white px-4 py-2.5 text-sm font-medium text-slate-700 focus:border-slate-300 focus:outline-none focus:ring-0 shadow-sm", data: { booking_calc_target: "checkIn", action: "change->booking-calc#calculate" } %>
      </div>
      <div>
        <%= f.label :check_out, "Scheduled Check-out", class: "block text-[11px] font-bold text-slate-500 uppercase tracking-wider mb-2" %>
        <%= f.datetime_local_field :check_out, value: @booking.check_out&.in_time_zone(current_hotel.hotel_time_zone)&.strftime("%Y-%m-%dT%H:%M"), required: true, class: "w-full rounded-xl border border-slate-200 bg-white px-4 py-2.5 text-sm font-medium text-slate-700 focus:border-slate-300 focus:outline-none focus:ring-0 shadow-sm", data: { booking_calc_target: "checkOut", action: "change->booking-calc#calculate" } %>
      </div>
    </div>

    <div class="grid sm:grid-cols-2 gap-6">
      <div>
        <%= f.label :adults, class: "block text-[11px] font-bold text-slate-500 uppercase tracking-wider mb-2" %>
        <%= f.number_field :adults, required: true, min: 1, class: "w-full rounded-xl border border-slate-200 bg-white px-4 py-2.5 text-sm font-medium text-slate-700 focus:border-slate-300 focus:outline-none focus:ring-0 shadow-sm" %>
      </div>
      <div>
        <%= f.label :children, class: "block text-[11px] font-bold text-slate-500 uppercase tracking-wider mb-2" %>
        <%= f.number_field :children, required: true, min: 0, class: "w-full rounded-xl border border-slate-200 bg-white px-4 py-2.5 text-sm font-medium text-slate-700 focus:border-slate-300 focus:outline-none focus:ring-0 shadow-sm" %>
      </div>
    </div>

    <div>
      <%= f.label :source, "Booking Source", class: "block text-[11px] font-bold text-slate-500 uppercase tracking-wider mb-2" %>
      <%= f.select :source, [["Phone", "phone"], ["Walk-in", "walk_in"], ["Email", "email"], ["WhatsApp", "whatsapp"], ["Other", "internal"]], { selected: "phone" },
          { class: "w-full rounded-xl border border-slate-200 bg-white px-4 py-2.5 text-sm font-medium text-slate-700 focus:border-slate-300 focus:outline-none focus:ring-0 shadow-sm" } %>
    </div>

    <% if local_assigns[:transaction] == :backdated_check_in %>
      <div>
        <%= label_tag :retroactive_reason, "Override Reason", class: "block text-[11px] font-bold text-amber-700 uppercase tracking-wider mb-2" %>
        <%= text_area_tag :retroactive_reason, params[:retroactive_reason], required: true, rows: 5, placeholder: "Explain why this check-in is being recorded after the business date was closed.", class: "w-full resize-y rounded-xl border border-amber-300 bg-amber-50 px-4 py-3 text-sm font-medium text-slate-700 focus:border-amber-400 focus:outline-none focus:ring-0 shadow-sm" %>
      </div>
    <% end %>

    <div>
      <%= f.label :internal_notes, "Internal Notes", class: "block text-[11px] font-bold text-slate-500 uppercase tracking-wider mb-2" %>
      <%= f.text_area :internal_notes, rows: 4, placeholder: "Special requests...", class: "w-full resize-y rounded-xl border border-slate-200 bg-white px-4 py-2.5 text-sm font-medium text-slate-700 focus:border-slate-300 focus:outline-none focus:ring-0 shadow-sm" %>
    </div>
  </div>
</div>
