<%# Shared undo-check-in booking transaction sheet. %>

<%= turbo_frame_tag "offcanvas_drawer", data: { offcanvas_variant: "right" } do %>
  <div class="flex flex-col h-full bg-card">
    <%= form_with url: hotel_booking_transaction_undo_check_in_path(current_hotel, @booking), method: :post,
        class: "flex flex-col h-full",
        data: { controller: "group-lifecycle-targets", group_lifecycle_targets_selection_mode_value: "checkbox" } do |f| %>
      <%= hidden_field_tag :return_to, @transaction_return_to if @transaction_return_to.present? %>

      <%# Modal Header %>
      <%= render "hotel_portal/shared/offcanvas/content_header",
                 title: "Undo Check-In",
                 subtitle: "Revert the check-in status back to confirmed for #{@booking.guest_name}.",
                 icon: cached_icon("rotate-ccw", stroke_width: 2.5, class: "size-5") %>

      <%# Modal Content %>
      <div class="flex-1 <%= @booking.group_booking_id? ? 'grid min-h-0 grid-rows-[auto_minmax(0,1fr)] overflow-hidden lg:grid-cols-[20rem_minmax(0,1fr)] lg:grid-rows-none' : 'space-y-6 overflow-y-auto p-8 custom-scrollbar' %>">
        <%= render "hotel_portal/bookings/transactions/shared/group_target_selector",
          target_presenter: HotelPortal::BookingLifecycleTargetPresenter.new(booking: @booking, action: :undo_check_in) %>

        <% if @booking.group_booking_id? %>
          <div class="min-h-0 overflow-y-auto custom-scrollbar">
            <div class="space-y-6 p-8">
        <% end %>

        <div>
          <label class="mb-2 block text-[11px] font-bold uppercase tracking-wider text-muted-foreground">Reason to change</label>
          <%= text_field_tag :retroactive_reason, params[:retroactive_reason],
              placeholder: "Provide a reason for reverting this check-in",
              required: true,
              class: "w-full rounded-xl border border-border bg-card py-2.5 px-4 text-sm text-foreground focus:border-border-interactive focus:outline-none focus:ring-0 shadow-sm" %>
        </div>

        <% if @booking.group_booking_id? %>
            </div>
          </div>
        <% end %>
      </div>

      <%# Modal Footer %>
      <%= render "hotel_portal/shared/offcanvas/content_footer",
                 show_full_page_link: false,
                 submit_button: f.submit("Undo Check-In", class: "px-6 py-2.5 bg-rose-600 text-primary-foreground rounded-xl text-sm font-bold hover:bg-rose-700 transition-colors shadow-sm") %>
    <% end %>
  </div>
<% end %>
