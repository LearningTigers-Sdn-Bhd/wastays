<%= turbo_frame_tag "offcanvas_drawer" do %>
  <div class="flex flex-col h-full bg-card">
    <%= form_with url: process_late_checkout_hotel_booking_path(current_hotel, @booking), method: :post,
        class: "flex flex-col h-full", data: { controller: "group-lifecycle-targets" } do |f| %>
      <%= hidden_field_tag :return_to, @transaction_return_to if @transaction_return_to.present? %>

      <%# Modal Header %>
      <%= render "hotel_portal/shared/offcanvas/content_header",
                 title: "Review Late Checkout",
                 subtitle: "Calculate and post a charge for #{@booking.guest_name}.",
                  icon: cached_icon("clock-alert", stroke_width: 2.5, class: "size-5") %>

      <%# Modal Content %>
      <div class="flex-1 bg-muted <%= @booking.group_booking_id? ? 'grid min-h-0 grid-rows-[auto_minmax(0,1fr)] overflow-hidden lg:grid-cols-[20rem_minmax(0,1fr)] lg:grid-rows-none' : 'overflow-y-auto' %>">
        <%= render "hotel_portal/bookings/transactions/shared/group_target_selector",
          target_presenter: HotelPortal::BookingLifecycleTargetPresenter.new(booking: @booking, action: :late_checkout) %>

        <% if @booking.group_booking_id? %>
          <div class="min-h-0 overflow-y-auto">
        <% end %>
            <div class="space-y-6 p-6"
                 data-controller="late-checkout"
                 data-late-checkout-base-amount-value="<%= @presenter.suggested_late_checkout_amount %>"
                 data-late-checkout-currency-value="<%= @presenter.currency %>">
              <%= render "hotel_portal/bookings/transactions/late_checkout/partials/form_fields", form: f, booking: @booking, presenter: @presenter, carded: false %>
            </div>
        <% if @booking.group_booking_id? %>
          </div>
        <% end %>
      </div>

      <%# Modal Footer %>
      <%= render "hotel_portal/shared/offcanvas/content_footer",
                 show_full_page_link: false,
                 submit_button: f.submit("Process Late Checkout", class: "px-6 py-2 bg-amber-600 text-primary-foreground rounded-xl text-sm font-bold hover:bg-amber-700 transition-colors shadow-sm") %>
    <% end %>
  </div>
<% end %>
