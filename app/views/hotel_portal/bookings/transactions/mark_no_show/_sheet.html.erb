<div class="flex h-full flex-col bg-card">
  <% target_presenter = HotelPortal::BookingLifecycleTargetPresenter.new(booking: @booking, action: :mark_no_show) %>
  <% eligible_rows = target_presenter.render? ? target_presenter.rows.select(&:eligible) : [] %>
  <%= render "hotel_portal/bookings/board/partials/content_header",
    title: "Mark as No-show",
    subtitle: @booking.guest_name,
    icon: cached_icon("user-x", class: "size-5 text-rose-600") %>
  <%= form_with url: mark_no_show_hotel_booking_path(current_hotel, @booking), method: :post, class: "flex min-h-0 flex-1 flex-col", data: { controller: "group-lifecycle-targets" } do |f| %>
    <%= hidden_field_tag :return_to, @transaction_return_to if @transaction_return_to.present? %>
    <div class="flex-1 <%= @booking.group_booking_id? ? 'grid min-h-0 grid-rows-[auto_minmax(0,1fr)] overflow-hidden lg:grid-cols-[20rem_minmax(0,1fr)] lg:grid-rows-none' : 'overflow-y-auto p-8' %>">
      <%= render "hotel_portal/bookings/transactions/shared/group_target_selector",
        target_presenter: target_presenter %>
      <% if @booking.group_booking_id? %><div class="min-h-0 overflow-y-auto custom-scrollbar"><div><% end %>
      <% if @booking.errors.any? %>
        <div class="<%= @booking.group_booking_id? ? 'border-b border-red-200 px-8 py-4' : 'mb-5 rounded-xl border border-red-200 p-4' %> bg-red-50 text-sm text-red-700" role="alert">
          <p class="font-bold">No-show could not be confirmed.</p>
          <p class="mt-1"><%= @booking.errors.full_messages.to_sentence %></p>
        </div>
      <% end %>

      <% if @booking.group_booking_id? %>
        <div class="border-b border-border px-8 py-4 text-sm text-foreground">
          <p class="font-bold text-foreground">Group no-show action</p>
          <p class="mt-1">Use the group selector to choose exactly which room stays should be finalized as no-show. Unselected bookings in the group are not changed.</p>
          <p class="mt-2 text-xs font-semibold uppercase tracking-wider text-muted-foreground"><%= eligible_rows.size %> eligible group <%= 'booking'.pluralize(eligible_rows.size) %></p>
        </div>
      <% end %>

      <div class="<%= @booking.group_booking_id? ? 'border-b border-rose-200 px-8 py-4' : 'rounded-xl border border-rose-200 p-4' %> bg-rose-50 text-sm text-rose-800">
        This will finalize the no-show, post the standard first-night no-show charges, exclude tourism tax, and release the assigned room and remaining inventory. Any settled folio will close automatically.
      </div>

      <div class="<%= @booking.group_booking_id? ? 'px-8 py-5' : 'mt-5' %>">
        <%= label_tag :no_show_reason, "No-show Reason", class: "mb-2 block text-[11px] font-black uppercase tracking-[0.15em] text-muted-foreground" %>
        <%= text_area_tag :no_show_reason, params[:no_show_reason], rows: 4, required: true,
          placeholder: @booking.group_booking_id? ? "Explain why the selected group bookings are being finalized as no-show." : "Explain why this booking is being finalized as no-show.",
          class: "w-full resize-y rounded-xl border border-border bg-card px-4 py-3 text-sm font-medium text-foreground shadow-sm focus:border-border-interactive focus:outline-none focus:ring-0" %>
      </div>
      <% if @booking.group_booking_id? %></div></div><% end %>
    </div>
    <%= render "hotel_portal/bookings/board/partials/content_footer",
      show_full_page_link: false,
      submit_button: f.submit("Confirm No-show", class: "rounded-xl bg-rose-600 px-6 py-2.5 text-sm font-bold text-primary-foreground") %>
  <% end %>
</div>
