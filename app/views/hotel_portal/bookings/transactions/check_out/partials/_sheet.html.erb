<% currency = booking.currency.presence || hotel.default_currency.presence || "MYR" %>
<% checkout_error ||= nil %>
<% checkout_business_date = hotel.current_business_date %>
<% group_checkout = booking.group_booking_id.present? %>
<% target_presenter = HotelPortal::BookingLifecycleTargetPresenter.new(booking: booking, action: :checkout) %>
<% checkout_bookings = group_checkout ? target_presenter.rows.select(&:eligible).map(&:booking) : [booking] %>
<% checkout_bookings = [booking] if checkout_bookings.empty? %>
<% checkout_sheets = checkout_bookings.index_with do |checkout_booking|
  folio = checkout_booking.booking_folio
  early_departure = checkout_business_date < checkout_booking.check_out.to_date
  early_checkout_lines = early_departure && folio ? Folios::PostEarlyCheckoutCharges.pending_preview(booking: checkout_booking, folio: folio, departure_date: checkout_business_date, original_check_out: checkout_booking.check_out) : []
  HotelPortal::Checkouts::SheetPresenter.new(booking: checkout_booking, hotel: hotel, user: current_user, early_checkout_lines: early_checkout_lines)
end %>
<% selected_booking_ids = Array(params[:booking_ids]).reject(&:blank?).map(&:to_s) %>
<% selected_booking_ids = [booking.id.to_s] if group_checkout && selected_booking_ids.empty? %>
<% selected_count = group_checkout ? selected_booking_ids.size : 0 %>
<% selected_sheets = group_checkout ? checkout_sheets.select { |checkout_booking, _sheet| selected_booking_ids.include?(checkout_booking.id.to_s) } : checkout_sheets %>
<% collect_now = selected_sheets.values.sum { |sheet| sheet.folio_rows.select { |row| row.default_action == "pay_now" }.sum { |row| row.balance.to_d } } %>
<% direct_bill_total = selected_sheets.values.sum { |sheet| sheet.folio_rows.select { |row| row.default_action == "direct_bill" }.sum { |row| row.balance.to_d } } %>
<% keep_open_count = selected_sheets.values.sum { |sheet| sheet.folio_rows.count { |row| row.default_action.in?(HotelPortal::Checkouts::SheetPresenter::EXCEPTION_ACTIONS) } } %>
<% all_held_deposits = checkout_sheets.values.flat_map(&:held_deposits) %>

<div class="flex h-full min-h-0 flex-col bg-slate-100"
     data-controller="group-lifecycle-targets checkout-settlement"
     data-action="checkout-settlement:charge-changed->checkout-settlement#updateEarlyDepartureCharge group-lifecycle-targets:changed->checkout-settlement#syncBookingSections"
     data-checkout-settlement-currency-value="<%= currency %>"
     data-checkout-settlement-group-checkout-value="<%= group_checkout %>">
  <header class="z-10 shrink-0 border-b border-slate-200 bg-white">
    <div class="flex items-start justify-between gap-4 px-4 py-3 sm:px-6">
      <div class="min-w-0">
        <p class="text-[10px] font-bold uppercase tracking-[0.2em] text-slate-400"><%= group_checkout ? "Group Checkout" : "Checkout" %></p>
        <h2 class="mt-0.5 truncate text-lg font-bold tracking-tight text-slate-950"><%= group_checkout ? booking.group_booking.name : booking.guest_name %></h2>
        <div class="mt-1 flex flex-wrap items-center gap-x-2 gap-y-1 text-[11px] font-semibold uppercase tracking-wide text-slate-500">
          <span>Business date <%= checkout_business_date.strftime("%d %b %Y") %></span>
          <span>·</span>
          <span><%= booking.check_in.strftime("%d %b") %> - <%= booking.check_out.strftime("%d %b %Y") %></span>
        </div>
      </div>
      <button type="button" class="rounded-md p-1.5 text-slate-400 transition hover:bg-slate-100 hover:text-slate-700" data-action="click->offcanvas#close" aria-label="Close checkout">
        <%= cached_icon "x", stroke_width: 2.5, class: "size-5" %>
      </button>
    </div>
  </header>

  <%= form_with url: check_out_hotel_booking_path(hotel, booking), method: :post, class: "flex min-h-0 flex-1 flex-col overflow-hidden", data: { turbo_frame: "_top" } do |f| %>
    <%= hidden_field_tag :checkout_sheet, "1" %>
    <%= hidden_field_tag :source, local_assigns[:checkout_source] if local_assigns[:checkout_source].present? %>
    <%= hidden_field_tag :return_to, local_assigns[:transaction_return_to] if local_assigns[:transaction_return_to].present? %>

    <div class="grid min-h-0 flex-1 grid-cols-1 overflow-hidden lg:grid-cols-[20rem_minmax(0,1fr)] xl:grid-cols-[22rem_minmax(0,1fr)]">
      <aside class="min-h-0 overflow-y-auto border-b border-slate-200 bg-white lg:border-b-0 lg:border-r">
        <% if group_checkout %>
          <%= render "hotel_portal/bookings/transactions/shared/group_target_selector",
            target_presenter: target_presenter,
            master_detail: true,
            selected_booking_ids: selected_booking_ids,
            embedded: true %>
        <% else %>
          <% room = booking.booking_rooms.first %>
          <div class="border-b border-slate-200 px-5 py-4">
            <p class="text-[10px] font-bold uppercase tracking-[0.18em] text-slate-400">Booking</p>
            <p class="mt-2 text-sm font-black text-slate-950">Booking #<%= booking.formatted_reservation_number.presence || booking.confirmation_token %></p>
            <p class="mt-1 text-xs font-semibold text-slate-600"><%= room&.room_type&.name.presence || room&.room_type_snapshot.to_h["name"].presence || "Room type unavailable" %> - <%= room&.room_number.presence || "Unassigned room" %></p>
            <p class="mt-1 text-xs text-slate-500"><%= booking.guest_name %> · <%= booking.status.humanize %></p>
          </div>
        <% end %>
      </aside>

      <section class="flex min-h-0 flex-col overflow-y-auto bg-white">
        <div class="flex min-h-full flex-col space-y-0">
          <div class="border-b border-slate-200 bg-white px-5 py-3" data-checkout-settlement-target="requiresSelection">
            <div class="grid gap-3 text-xs sm:grid-cols-4">
              <% if group_checkout %>
                <div><p class="font-bold uppercase tracking-wider text-slate-400">Selected</p><p class="mt-0.5 font-black text-slate-950" data-checkout-settlement-target="selectedCount"><%= selected_count %> <%= 'booking'.pluralize(selected_count) %></p></div>
              <% end %>
              <div><p class="font-bold uppercase tracking-wider text-slate-400">Collect Now</p><p class="mt-0.5 font-black text-slate-950" data-checkout-settlement-target="collectNowAmount"><%= currency %> <%= format('%.2f', collect_now) %></p></div>
              <div><p class="font-bold uppercase tracking-wider text-slate-400">Direct Bill</p><p class="mt-0.5 font-black text-slate-950" data-checkout-settlement-target="directBillAmount"><%= currency %> <%= format('%.2f', direct_bill_total) %></p></div>
              <div><p class="font-bold uppercase tracking-wider text-slate-400">Keep Open</p><p class="mt-0.5 font-black text-slate-950" data-checkout-settlement-target="keepOpenCount"><%= pluralize(keep_open_count, "folio") %></p></div>
            </div>
          </div>

          <% if checkout_error.present? %>
            <div class="border-b border-red-200 bg-red-50 px-5 py-3 text-sm font-semibold text-red-800" data-controller="auto-scroll-top">
              <%= checkout_error %>
            </div>
          <% end %>

          <div class="hidden min-h-0 flex-1 items-center justify-center bg-slate-50 px-5 py-16 text-center" data-checkout-settlement-target="emptySelection">
            <div>
              <p class="text-sm font-black uppercase tracking-wider text-slate-700">Please select the bookings</p>
              <p class="mt-1 text-xs font-semibold text-slate-500">Choose at least one eligible booking from the left rail to review checkout details and folios.</p>
            </div>
          </div>

          <% early_departure_bookings = checkout_bookings.select { |cb| checkout_business_date < cb.check_out.to_date } %>
          <% current_early_departure = early_departure_bookings.any? %>
          <div class="grid items-stretch gap-px border-b border-slate-200 bg-slate-200 <%= early_departure_bookings.one? ? "xl:grid-cols-2" : "sm:grid-cols-2 xl:grid-cols-3" if current_early_departure %>" data-checkout-settlement-target="requiresSelection">
            <%= render "hotel_portal/bookings/transactions/check_out/partials/details", form: f, booking: booking, presenter: presenter %>
            <% early_departure_bookings.each do |early_booking| %>
              <% early_booking_visible = !group_checkout || selected_booking_ids.include?(early_booking.id.to_s) %>
              <%= render "hotel_portal/bookings/transactions/check_out/partials/early_departure", booking: early_booking, currency: currency, visible: early_booking_visible %>
            <% end %>
          </div>

          <% missing_folio_bookings = checkout_sheets.select { |_checkout_booking, checkout_sheet| checkout_sheet.folio_rows.empty? }.keys %>
          <% missing_folio_bookings.each do |missing_booking| %>
            <% section_visible = !group_checkout || selected_booking_ids.include?(missing_booking.id.to_s) %>
            <div class="<%= 'hidden' unless section_visible %> flex items-start gap-2 border-b border-red-200 bg-red-50 px-5 py-3" data-checkout-settlement-target="bookingRow" data-booking-id="<%= missing_booking.id %>">
              <%= cached_icon "circle-alert", class: "mt-0.5 size-4 shrink-0 text-red-700" %>
              <div>
                <p class="text-xs font-bold text-red-900">Folio required</p>
                <p class="mt-0.5 text-[11px] text-red-700"><%= missing_booking.formatted_reservation_number.presence || missing_booking.confirmation_token %> must have a folio before checkout can be completed.</p>
              </div>
            </div>
          <% end %>

          <div class="divide-y divide-slate-200 border-b border-slate-200">
            <%= render "hotel_portal/bookings/transactions/check_out/partials/folio_list", checkout_sheets: checkout_sheets, selected_booking_ids: selected_booking_ids, group_checkout: group_checkout %>
            <div class="h-3 bg-slate-50" aria-hidden="true"></div>
            <%= render "hotel_portal/bookings/transactions/check_out/partials/settlement_details", checkout_sheets: checkout_sheets, selected_booking_ids: selected_booking_ids, group_checkout: group_checkout %>
          </div>

          <% if all_held_deposits.any? %>
            <% release_security_deposit = params[:release_security_deposit].nil? || params[:release_security_deposit] == "1" %>
            <% release_method = params[:security_deposit_release_method].presence || "cash" %>
            <section class="border-b border-slate-200 bg-white" data-controller="payment-toggle">
              <div class="flex items-start justify-between gap-4 border-b border-slate-200 px-4 py-3">
                <div class="flex min-w-0 items-start gap-2.5">
                  <%= cached_icon "shield-check", stroke_width: 2.25, class: "mt-0.5 size-4 shrink-0 text-emerald-700" %>
                  <div>
                    <h3 class="text-sm font-bold text-slate-950">Security Deposit</h3>
                    <p class="mt-0.5 text-xs font-semibold text-slate-600"><%= currency %> <%= format('%.2f', all_held_deposits.sum { |deposit| deposit.amount.to_d }) %> held independently from the folio.</p>
                    <p class="mt-0.5 text-[11px] text-slate-500">Return security deposits at checkout.</p>
                  </div>
                </div>
                <div class="flex shrink-0 items-center">
                  <%= hidden_field_tag :release_security_deposit, "0", id: nil %>
                  <label class="relative inline-flex cursor-pointer items-center">
                    <%= check_box_tag :release_security_deposit, "1", release_security_deposit, class: "peer sr-only", role: "switch", aria: { label: "Return security deposit at checkout" }, data: { payment_toggle_target: "checkbox", action: "change->payment-toggle#toggle" } %>
                    <span class="block h-6 w-11 rounded-full bg-slate-200 transition peer-checked:bg-emerald-600 peer-focus-visible:ring-2 peer-focus-visible:ring-emerald-200 after:absolute after:left-[2px] after:top-[2px] after:h-5 after:w-5 after:rounded-full after:border after:border-slate-300 after:bg-white after:transition-all after:content-[''] peer-checked:after:translate-x-full peer-checked:after:border-white"></span>
                  </label>
                </div>
              </div>

              <div class="grid gap-3 px-4 py-3 sm:grid-cols-2 <%= "opacity-50" unless release_security_deposit %>" data-payment-toggle-target="container">
                <div>
                  <%= label_tag :security_deposit_release_method, "Method", class: "mb-1.5 block text-[10px] font-bold uppercase tracking-wider text-slate-500" %>
                  <%= select_tag :security_deposit_release_method, options_for_select(checkout_sheets.values.first.security_deposit_release_method_options, release_method), disabled: !release_security_deposit, class: "w-full rounded-md border border-slate-300 bg-white px-3 py-2 text-xs font-semibold text-slate-700 focus:border-slate-500 focus:outline-none disabled:cursor-not-allowed disabled:bg-slate-100 disabled:text-slate-400", data: { payment_toggle_target: "field" } %>
                </div>
                <div>
                  <%= label_tag :security_deposit_release_reference, "Reference", class: "mb-1.5 block text-[10px] font-bold uppercase tracking-wider text-slate-500" %>
                  <%= text_field_tag :security_deposit_release_reference, params[:security_deposit_release_reference], placeholder: "Optional receipt/reference", disabled: !release_security_deposit, class: "w-full rounded-md border border-slate-300 bg-white px-3 py-2 text-xs font-semibold text-slate-700 placeholder:text-slate-400 focus:border-slate-500 focus:outline-none disabled:cursor-not-allowed disabled:bg-slate-100 disabled:text-slate-400", data: { payment_toggle_target: "field" } %>
                </div>
              </div>
            </section>
          <% end %>
        </div>
      </section>
    </div>

    <footer class="z-10 shrink-0 border-t border-slate-200 bg-white px-4 py-3 shadow-[0_-4px_12px_rgba(15,23,42,0.06)] sm:px-6">
      <div class="flex items-center justify-end gap-2">
        <button type="button" class="rounded-md px-4 py-2 text-sm font-semibold text-slate-600 transition hover:bg-slate-100" data-action="click->offcanvas#close">Cancel</button>
        <%= f.submit(group_checkout ? "Complete Group Checkout" : "Complete Checkout", disabled: false, class: "cursor-pointer rounded-md bg-slate-900 px-5 py-2 text-sm font-bold text-white transition hover:bg-slate-700 disabled:cursor-not-allowed disabled:opacity-50", data: { turbo_submits_with: "Checking out...", checkout_settlement_target: "submitButton" }) %>
      </div>
    </footer>
  <% end %>
</div>
