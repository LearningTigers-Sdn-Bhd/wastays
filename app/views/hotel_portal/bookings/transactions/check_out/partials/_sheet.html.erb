<% folio = booking.booking_folio %>
<% currency = booking.currency.presence || "MYR" %>
<% checkout_error ||= nil %>
<% checkout_business_date = hotel.current_business_date %>
<% early_departure = checkout_business_date < booking.check_out.to_date %>
<% early_checkout_lines = early_departure && folio ? Folios::PostEarlyCheckoutCharges.pending_preview(booking: booking, folio: folio, departure_date: checkout_business_date, original_check_out: booking.check_out) : [] %>
<% projected_checkout_balance = if early_departure && folio
  Folios::PostEarlyCheckoutCharges.projected_checkout_balance(folio: folio, departure_date: checkout_business_date, original_check_out: booking.check_out)
else
  Folios::BookingCheckoutReadiness.call(booking: booking, hotel: hotel).projected_balance
end %>
<% checkout_sheet = HotelPortal::Checkouts::SheetPresenter.new(booking: booking, hotel: hotel, user: current_user, early_checkout_lines: early_checkout_lines) %>

<div class="flex h-full min-h-0 flex-col bg-slate-100"
     data-controller="checkout-settlement"
     data-action="checkout-settlement:charge-changed->checkout-settlement#updateEarlyDepartureCharge"
     data-checkout-settlement-currency-value="<%= currency %>"
     data-checkout-settlement-required-amount-value="<%= number_with_precision(projected_checkout_balance, precision: 2) %>"
     data-checkout-settlement-total-charges-value="<%= number_with_precision(checkout_sheet.total_charges, precision: 2) %>">
  <header class="z-10 shrink-0 border-b border-slate-200 bg-white">
    <div class="flex items-start justify-between gap-4 px-4 py-3 sm:px-6">
      <div class="min-w-0">
        <p class="text-[10px] font-bold uppercase tracking-[0.2em] text-slate-400">Step 1 of 2</p>
        <h2 class="mt-0.5 truncate text-lg font-bold tracking-tight text-slate-950"><%= booking.checkout_required? ? "Checkout Required" : "Checkout" %> <%= booking.guest_name %></h2>
        <div class="mt-1 flex flex-wrap items-center gap-x-2 gap-y-1 text-[11px] font-semibold uppercase tracking-wide text-slate-500">
          <span><%= booking.confirmation_token %> · <%= booking.check_in.strftime("%d %b") %> – <%= booking.check_out.strftime("%d %b %Y") %></span>
        </div>
      </div>
      <button type="button" class="rounded-md p-1.5 text-slate-400 transition hover:bg-slate-100 hover:text-slate-700" data-action="click->offcanvas#close" aria-label="Close checkout">
        <%= cached_icon "x", stroke_width: 2.5, class: "size-5" %>
      </button>
    </div>
    <%= render "hotel_portal/bookings/transactions/check_out/partials/summary", checkout_sheet: checkout_sheet %>
  </header>

  <%= form_with url: check_out_hotel_booking_path(hotel, booking), method: :post, class: "flex min-h-0 flex-1 flex-col", data: { turbo_frame: "_top" } do |f| %>
    <%= hidden_field_tag :checkout_sheet, "1" %>
    <%= hidden_field_tag :source, local_assigns[:checkout_source] if local_assigns[:checkout_source].present? %>
    <%= hidden_field_tag :return_to, local_assigns[:transaction_return_to] if local_assigns[:transaction_return_to].present? %>

    <div class="min-h-0 flex-1 overflow-y-auto">
      <div class="mx-auto max-w-[1500px] space-y-3 p-3 sm:p-4 lg:p-5">
        <% if checkout_error.present? %>
          <div class="rounded-md border border-red-200 bg-red-50 px-4 py-3 text-sm font-semibold text-red-800" data-controller="auto-scroll-top">
            <%= checkout_error %>
          </div>
        <% end %>

        <div class="grid items-stretch gap-3 <%= "lg:grid-cols-2" if early_departure %>">
          <%= render "hotel_portal/bookings/transactions/check_out/partials/details", form: f, booking: booking, presenter: presenter %>
          <% if early_departure %>
            <%= render "hotel_portal/bookings/transactions/check_out/partials/early_departure", booking: booking, currency: currency %>
          <% end %>
        </div>

        <% if checkout_sheet.held_deposits.any? %>
          <div class="flex flex-col gap-2 border border-amber-200 bg-amber-50 px-4 py-2.5 text-amber-950 sm:flex-row sm:items-center sm:justify-between">
            <div class="flex items-start gap-2">
              <%= cached_icon "shield-check", stroke_width: 2.25, class: "mt-0.5 size-4 shrink-0 text-amber-700" %>
              <div>
                <p class="text-xs font-bold">Held security deposit · <%= checkout_sheet.held_deposits.size %> <%= "record".pluralize(checkout_sheet.held_deposits.size) %> · <%= checkout_sheet.money(checkout_sheet.held_deposit_total) %></p>
                <p class="mt-0.5 text-[11px] text-amber-800">Security deposits are tracked independently from the folio. Return or settle them before the guest leaves.</p>
              </div>
            </div>
            <span class="self-start rounded-md border border-amber-300 bg-white px-2 py-1 text-[9px] font-bold uppercase tracking-wider text-amber-800 sm:self-center"><%= checkout_sheet.deposit_status_label %></span>
          </div>
        <% end %>

        <% if checkout_sheet.folio_rows.empty? %>
          <div class="flex items-start gap-2 border border-red-200 bg-red-50 px-4 py-3">
            <%= cached_icon "circle-alert", class: "mt-0.5 size-4 shrink-0 text-red-700" %>
            <div>
              <p class="text-xs font-bold text-red-900">Folio required</p>
              <p class="mt-0.5 text-[11px] text-red-700">This booking must have a folio before checkout can be completed.</p>
            </div>
          </div>
        <% else %>
          <%= render "hotel_portal/bookings/transactions/check_out/partials/folio_list", checkout_sheet: checkout_sheet %>
          <%= render "hotel_portal/bookings/transactions/check_out/partials/settlement_details", checkout_sheet: checkout_sheet %>
        <% end %>
      </div>
    </div>

    <footer class="z-10 shrink-0 border-t border-slate-200 bg-white px-4 py-3 shadow-[0_-4px_12px_rgba(15,23,42,0.06)] sm:px-6">
      <div class="mx-auto flex max-w-[1500px] flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
        <% if checkout_sheet.booking_balance.zero? && checkout_sheet.folio_rows.any? %>
          <div class="flex min-w-0 items-start gap-2">
            <%= cached_icon "circle-check", class: "mt-0.5 size-4 shrink-0 text-emerald-700" %>
            <div class="min-w-0">
              <p class="text-xs font-bold text-emerald-950">Ready for checkout</p>
              <p class="mt-0.5 truncate text-[11px] text-emerald-800">Resolved zero-balance folios will close during checkout.</p>
            </div>
          </div>
        <% else %>
          <div></div>
        <% end %>
        <div class="flex shrink-0 items-center justify-end gap-2">
          <button type="button" class="rounded-md px-4 py-2 text-sm font-semibold text-slate-600 transition hover:bg-slate-100" data-action="click->offcanvas#close">Cancel</button>
          <%= f.submit "Complete Checkout", disabled: !checkout_sheet.can_submit?, class: "cursor-pointer rounded-md bg-slate-900 px-5 py-2 text-sm font-bold text-white transition hover:bg-slate-700 disabled:cursor-not-allowed disabled:opacity-50", data: { turbo_submits_with: "Checking out...", checkout_settlement_target: "submitButton" } %>
        </div>
      </div>
    </footer>
  <% end %>
</div>
