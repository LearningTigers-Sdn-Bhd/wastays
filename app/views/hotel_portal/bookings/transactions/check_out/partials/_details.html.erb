<section class="flex h-full flex-col border border-slate-200 bg-white" data-checkout-card="details">
  <div class="border-b border-slate-200 px-4 py-2.5">
    <h3 class="text-xs font-bold uppercase tracking-wider text-slate-800">Checkout Details</h3>
  </div>
  <div class="flex flex-1 flex-col justify-center p-4">
    <label class="mb-1.5 block text-[10px] font-bold uppercase tracking-wider text-slate-500">Check-out date & time</label>
    <%= form.datetime_local_field :checked_out_at,
        value: presenter.checked_out_at_form_value,
        class: "w-full rounded-md border border-slate-300 bg-white px-3 py-2 text-sm font-semibold text-slate-800 shadow-sm focus:border-slate-500 focus:outline-none focus:ring-0" %>
    <p class="mt-2 text-[11px] text-slate-500">Scheduled checkout: <span class="font-semibold text-slate-700"><%= booking.check_out.strftime("%d %b %Y") %></span></p>
  </div>
</section>
