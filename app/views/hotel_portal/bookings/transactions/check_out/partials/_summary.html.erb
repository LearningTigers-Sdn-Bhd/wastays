<% folio = booking.booking_folio %>
<% currency = booking.currency.presence || "MYR" %>
<% projected_charges = Array(local_assigns[:projected_lines]).sum { |line| line[:amount].to_d } %>
<% total_charges = (folio&.total_charges || 0).to_d + projected_charges %>
<% total_payments = (folio&.total_payments || 0).to_d %>
<% total_adjustments = (folio&.total_adjustments || 0).to_d %>
<% outstanding_balance = total_charges - total_payments + total_adjustments %>

<section class="grid border-t border-slate-200 bg-white sm:grid-cols-2 lg:grid-cols-[1.35fr_0.75fr_1fr_1fr]" data-checkout-summary="true">
  <div class="border-b border-slate-200 px-4 py-2.5 sm:border-r lg:border-b-0 sm:px-6">
    <p class="text-[9px] font-bold uppercase tracking-[0.16em] text-slate-500">Outstanding balance</p>
    <p class="mt-1 text-lg font-bold tabular-nums text-slate-950"><span class="mr-1 text-[11px] text-slate-500"><%= currency %></span><span data-checkout-settlement-target="outstandingAmount"><%= number_with_precision(outstanding_balance, precision: 2) %></span></p>
  </div>
  <div class="border-b border-slate-200 px-4 py-2.5 lg:border-b-0 lg:border-r sm:px-6">
    <p class="text-[9px] font-bold uppercase tracking-[0.16em] text-slate-500">Folio status</p>
    <p class="mt-1 text-sm font-bold uppercase text-slate-900"><%= folio&.status || "N/A" %></p>
  </div>
  <div class="border-b border-slate-200 px-4 py-2.5 sm:border-b-0 sm:border-r sm:px-6">
    <p class="text-[9px] font-bold uppercase tracking-[0.16em] text-slate-500">Total charges</p>
    <p class="mt-1 text-sm font-bold tabular-nums text-slate-900" data-checkout-settlement-target="totalChargesAmount"><%= currency %> <%= number_with_precision(total_charges, precision: 2) %></p>
  </div>
  <div class="px-4 py-2.5 sm:px-6">
    <p class="text-[9px] font-bold uppercase tracking-[0.16em] text-slate-500">Total payments</p>
    <p class="mt-1 text-sm font-bold tabular-nums text-slate-900"><%= currency %> <%= number_with_precision(total_payments, precision: 2) %></p>
  </div>
</section>
