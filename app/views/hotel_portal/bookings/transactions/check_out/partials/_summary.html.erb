<% checkout_sheet = local_assigns.fetch(:checkout_sheet) %>

<section class="grid border-t border-slate-200 bg-white sm:grid-cols-2 lg:grid-cols-5" data-checkout-summary="true">
  <div class="border-b border-slate-200 px-4 py-2.5 sm:border-r lg:border-b-0 sm:px-6">
    <p class="text-[9px] font-bold uppercase tracking-[0.16em] text-slate-500">Booking Balance</p>
    <p class="mt-1 text-lg font-bold tabular-nums text-slate-950" data-checkout-settlement-target="outstandingAmount"><%= checkout_sheet.money(checkout_sheet.booking_balance) %></p>
  </div>
  <div class="border-b border-slate-200 px-4 py-2.5 lg:border-b-0 lg:border-r sm:px-6">
    <p class="text-[9px] font-bold uppercase tracking-[0.16em] text-slate-500">Folios</p>
    <p class="mt-1 text-sm font-bold text-slate-900"><%= checkout_sheet.folio_count_label %></p>
  </div>
  <div class="border-b border-slate-200 px-4 py-2.5 sm:border-r lg:border-b-0 sm:px-6">
    <p class="text-[9px] font-bold uppercase tracking-[0.16em] text-slate-500">Deposit Status</p>
    <p class="mt-1 text-sm font-bold uppercase text-slate-900"><%= checkout_sheet.deposit_status_label %></p>
  </div>
  <div class="border-b border-slate-200 px-4 py-2.5 sm:border-b-0 sm:border-r sm:px-6">
    <p class="text-[9px] font-bold uppercase tracking-[0.16em] text-slate-500">Total charges</p>
    <p class="mt-1 text-sm font-bold tabular-nums text-slate-900" data-checkout-settlement-target="totalChargesAmount"><%= checkout_sheet.money(checkout_sheet.total_charges) %></p>
  </div>
  <div class="px-4 py-2.5 sm:px-6">
    <p class="text-[9px] font-bold uppercase tracking-[0.16em] text-slate-500">Total payments</p>
    <p class="mt-1 text-sm font-bold tabular-nums text-slate-900"><%= checkout_sheet.money(checkout_sheet.total_payments) %></p>
  </div>
</section>
