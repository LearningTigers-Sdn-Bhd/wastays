<% folio = booking.booking_folio %>
<% currency = booking.currency.presence || "MYR" %>

<dialog class="backdrop:bg-primary/50 backdrop:backdrop-blur-sm open:flex open:items-center open:justify-center open:fixed open:inset-0 open:z-[200] open:w-full open:h-full"
        data-controller="checkout-success-modal"
        data-checkout-success-modal-booking-id-value="<%= booking.id %>">
  <div class="flex flex-col max-h-[85vh] w-full max-w-4xl mx-4 bg-card rounded-3xl shadow-2xl shadow-foreground/20 overflow-hidden">
    <!-- Header -->
    <div class="sticky top-0 z-10 border-b border-border bg-card px-8 py-6">
      <div class="flex items-center justify-between">
        <div>
          <p class="text-xs font-black uppercase tracking-[0.24em] text-emerald-600">Checkout Complete</p>
          <h2 class="mt-1 text-2xl font-black tracking-tight text-foreground">Invoice <%= booking.formatted_invoice_number || folio&.invoice_number || booking.confirmation_token %></h2>
          <p class="mt-1 text-sm font-semibold text-muted-foreground">Ready for <%= booking.guest_name %></p>
        </div>
        <div class="flex items-center gap-3">
          <%= link_to invoice_hotel_folio_path(hotel, booking, format: :pdf), target: "_blank", class: "inline-flex items-center rounded-xl bg-primary px-5 py-3 text-sm font-black text-primary-foreground shadow-sm transition hover:bg-primary-hover" do %>
            <svg class="mr-2 size-4" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
            Download PDF
          <% end %>
          <button type="button" class="rounded-xl border border-border bg-card px-5 py-3 text-sm font-bold text-foreground shadow-sm transition hover:bg-muted" data-action="click->checkout-success-modal#dismiss">
            Close
          </button>
        </div>
      </div>
    </div>

    <!-- Body -->
    <div class="flex-1 overflow-y-auto p-8">
      <div class="space-y-6">
        <div class="overflow-hidden rounded-3xl border border-border bg-card shadow-sm">
          <div class="bg-primary px-8 py-8 text-primary-foreground">
            <div class="flex flex-col gap-6 md:flex-row md:items-end md:justify-between">
              <div>
                <p class="text-[11px] font-black uppercase tracking-[0.24em] text-muted-foreground">Folio Invoice</p>
                <h3 class="mt-3 text-4xl font-black tracking-tight"><%= booking.formatted_invoice_number || folio&.invoice_number || "Pending" %></h3>
              </div>
              <div class="text-left md:text-right">
                <p class="text-sm font-bold text-primary-foreground"><%= hotel.name %></p>
                <p class="mt-1 text-xs font-semibold uppercase tracking-wider text-muted-foreground"><%= Time.current.strftime("%d %b %Y, %I:%M %p") %></p>
              </div>
            </div>
          </div>

          <div class="grid gap-0 md:grid-cols-3">
            <div class="border-b border-border p-6 md:border-b-0 md:border-r">
              <p class="text-[10px] font-black uppercase tracking-widest text-muted-foreground">Guest</p>
              <p class="mt-2 text-lg font-black text-foreground"><%= booking.guest_name %></p>
              <p class="mt-1 text-sm font-semibold text-muted-foreground"><%= booking.confirmation_token %></p>
            </div>
            <div class="border-b border-border p-6 md:border-b-0 md:border-r">
              <p class="text-[10px] font-black uppercase tracking-widest text-muted-foreground">Stay</p>
              <p class="mt-2 text-lg font-black text-foreground"><%= booking.check_in.strftime("%d %b") %> - <%= booking.check_out.strftime("%d %b %Y") %></p>
              <p class="mt-1 text-sm font-semibold text-muted-foreground"><%= pluralize((booking.check_out.to_date - booking.check_in.to_date).to_i, "night") %></p>
            </div>
            <div class="p-6">
              <p class="text-[10px] font-black uppercase tracking-widest text-muted-foreground">Final Balance</p>
              <p class="mt-2 text-lg font-black text-emerald-700"><%= currency %> <%= number_with_precision(folio&.projected_outstanding_balance || 0, precision: 2) %></p>
              <p class="mt-1 text-sm font-semibold text-muted-foreground"><%= folio&.status&.humanize || "Closed" %></p>
            </div>
          </div>
        </div>

        <%= render "hotel_portal/folios/show/folio_transaction_table", booking: booking %>
      </div>
    </div>
  </div>
</dialog>
