<% sheets = local_assigns[:checkout_sheets].presence || { checkout_sheet.booking => checkout_sheet } %>
<% selected_ids = Array(local_assigns[:selected_booking_ids]).reject(&:blank?).map(&:to_s) %>
<% group_checkout = local_assigns.fetch(:group_checkout, false) %>
<% detail_pairs = sheets.flat_map { |checkout_booking, sheet| sheet.folio_rows.select { |row| row.action_options.any? { |_label, value| HotelPortal::Checkouts::SheetPresenter::INPUT_ACTIONS.include?(value) } }.map { |row| [checkout_booking, sheet, row] } } %>

<section class="bg-white" data-checkout-settlement-target="requiresSelection">
  <div class="border-b border-slate-200 px-4 py-3">
    <h3 class="text-sm font-bold uppercase tracking-wide text-slate-900">Settlement Details</h3>
    <p class="mt-0.5 text-xs text-slate-500">Only folios that require input are shown here.</p>
  </div>
  <% if detail_pairs.empty? %>
    <div class="px-4 py-6 text-center text-xs font-semibold text-slate-500">No settlement input required.</div>
  <% else %>
    <div class="overflow-x-auto">
      <table class="w-full min-w-[960px] table-fixed divide-y divide-slate-200 text-left text-xs">
        <thead class="bg-slate-50 text-[10px] font-bold uppercase tracking-wider text-slate-500">
          <tr>
            <th class="w-[28%] px-4 py-2.5">Booking</th>
            <th class="w-[24%] px-4 py-2.5">Folio</th>
            <th class="w-[48%] px-4 py-2.5">Details</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-100 bg-white">
          <% detail_pairs.each do |checkout_booking, sheet, row| %>
            <% room = checkout_booking.booking_rooms.first %>
            <% booking_visible = !group_checkout || selected_ids.include?(checkout_booking.id.to_s) %>
            <% booking_title = "#{room&.room_type&.name.presence || room&.room_type_snapshot.to_h['name'].presence || 'Room type unavailable'} - #{room&.room_number.presence || 'Unassigned room'}" %>
            <% field_prefix = "checkout_bookings[#{checkout_booking.id}][folios]" %>
            <tr class="<%= 'hidden' unless row.requires_input && booking_visible %>" data-checkout-settlement-target="detailRow bookingRow" data-folio-id="<%= row.folio.id %>" data-booking-id="<%= checkout_booking.id %>">
              <td class="px-4 py-3 align-top">
                <p class="font-bold text-slate-900"><%= booking_title %></p>
                <p class="mt-0.5 text-xs font-semibold text-slate-500"><%= checkout_booking.guest_name %></p>
              </td>
              <td class="px-4 py-3 align-top">
                <p class="font-bold text-slate-900"><%= row.name %></p>
                <p class="mt-0.5 text-xs font-semibold text-slate-500"><%= row.folio.folio_reference_display %></p>
              </td>
              <td class="px-4 py-3 align-top">
                <span class="mb-2 inline-flex rounded-md bg-slate-100 px-2 py-1 text-[10px] font-bold uppercase tracking-wide text-slate-700"><%= row.default_action.to_s.humanize %></span>
                <%= hidden_field_tag "#{field_prefix}[#{row.folio.id}][amount]", number_with_precision(row.balance, precision: 2), disabled: !booking_visible %>
                <div class="grid gap-2 sm:grid-cols-[minmax(140px,180px)_1fr] <%= "hidden" unless row.requires_payment %>" data-checkout-settlement-target="paymentFields">
                  <%= select_tag "#{field_prefix}[#{row.folio.id}][payment_method]",
                        options_for_select(sheet.payment_method_options, "cash"),
                        disabled: !booking_visible,
                        class: "w-full rounded-md border border-slate-300 bg-white px-2.5 py-2 text-xs font-semibold text-slate-700 focus:border-slate-500 focus:outline-none disabled:cursor-not-allowed disabled:bg-slate-50 disabled:text-slate-500",
                        data: { required_for_action: "true" } %>
                  <%= text_field_tag "#{field_prefix}[#{row.folio.id}][payment_reference]",
                        nil,
                        placeholder: "Optional reference",
                        disabled: !booking_visible,
                        class: "w-full rounded-md border border-slate-300 bg-white px-2.5 py-2 text-xs font-semibold text-slate-700 placeholder:text-slate-400 focus:border-slate-500 focus:outline-none disabled:cursor-not-allowed disabled:bg-slate-50 disabled:text-slate-500" %>
                </div>
                <div class="<%= "hidden" unless row.requires_reason %>" data-checkout-settlement-target="reasonFields">
                  <%= text_field_tag "#{field_prefix}[#{row.folio.id}][reason]",
                        nil,
                        placeholder: "Reason",
                        disabled: !booking_visible,
                        class: "w-full rounded-md border border-slate-300 bg-white px-2.5 py-2 text-xs font-semibold text-slate-700 placeholder:text-slate-400 focus:border-slate-500 focus:outline-none disabled:cursor-not-allowed disabled:bg-slate-50 disabled:text-slate-500",
                        data: { required_for_action: "true" } %>
                </div>
                <% credit_exposure = ArInvoices::CreditExposure.call(hotel_corporate_account: row.folio.hotel_corporate_account, pending_amount: row.balance, pending_currency: row.folio.currency) if row.folio.hotel_corporate_account.present? && row.balance.to_d.positive? %>
                <div class="hidden rounded-md border border-blue-200 bg-blue-50 px-3 py-2 text-xs font-semibold text-blue-900" data-checkout-settlement-target="directBillFields">
                  AR invoice will be issued to <%= row.folio.hotel_corporate_account&.corporate_account&.name || "the company account" %>. Due date follows the account payment terms.
                  <% if credit_exposure&.warning? %>
                    <div class="mt-2 rounded border border-amber-200 bg-amber-50 px-2 py-1 text-amber-900"><%= credit_exposure.warning_message %></div>
                  <% end %>
                </div>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% end %>
</section>
