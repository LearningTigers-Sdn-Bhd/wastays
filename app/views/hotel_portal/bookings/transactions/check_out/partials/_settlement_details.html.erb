<% detail_rows = checkout_sheet.folio_rows.select { |row| row.action_options.any? { |_label, value| HotelPortal::Checkouts::SheetPresenter::INPUT_ACTIONS.include?(value) } } %>

<section class="border border-slate-200 bg-white">
  <div class="border-b border-slate-200 px-4 py-3">
    <h3 class="text-sm font-bold uppercase tracking-wide text-slate-900">Settlement Details</h3>
    <p class="mt-0.5 text-xs text-slate-500">Only folios that require input are shown here.</p>
  </div>
  <% if detail_rows.empty? %>
    <div class="px-4 py-6 text-center text-xs font-semibold text-slate-500">No settlement input required.</div>
  <% else %>
    <div class="overflow-x-auto">
      <table class="w-full min-w-[980px] table-fixed divide-y divide-slate-200 text-left text-xs">
        <thead class="bg-slate-50 text-[10px] font-bold uppercase tracking-wider text-slate-500">
          <tr>
            <th class="w-[26%] px-4 py-2.5">Folio</th>
            <th class="w-[16%] px-4 py-2.5">Action</th>
            <th class="w-[16%] px-4 py-2.5 text-right">Amount</th>
            <th class="w-[42%] px-4 py-2.5">Details</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-100 bg-white">
          <% detail_rows.each do |row| %>
            <tr class="<%= "hidden" unless row.requires_input %>" data-checkout-settlement-target="detailRow" data-folio-id="<%= row.folio.id %>">
              <td class="px-4 py-3 font-bold text-slate-900"><%= row.name %></td>
              <td class="px-4 py-3 font-semibold text-slate-600">Selected action</td>
              <td class="px-4 py-3 text-right font-bold tabular-nums text-slate-900"><%= checkout_sheet.money(row.balance.abs) %></td>
              <td class="px-4 py-3">
                <%= hidden_field_tag "checkout_folios[#{row.folio.id}][amount]", number_with_precision(row.balance, precision: 2) %>
                <div class="grid gap-2 sm:grid-cols-[minmax(140px,180px)_1fr] <%= "hidden" unless row.requires_payment %>" data-checkout-settlement-target="paymentFields">
                  <%= select_tag "checkout_folios[#{row.folio.id}][payment_method]",
                        options_for_select(checkout_sheet.payment_method_options, "cash"),
                        class: "w-full rounded-md border border-slate-300 bg-white px-2.5 py-2 text-xs font-semibold text-slate-700 focus:border-slate-500 focus:outline-none",
                        data: { required_for_action: "true" } %>
                  <%= text_field_tag "checkout_folios[#{row.folio.id}][payment_reference]",
                        nil,
                        placeholder: "Optional reference",
                        class: "w-full rounded-md border border-slate-300 bg-white px-2.5 py-2 text-xs font-semibold text-slate-700 placeholder:text-slate-400 focus:border-slate-500 focus:outline-none" %>
                </div>
                <div class="<%= "hidden" unless row.requires_reason %>" data-checkout-settlement-target="reasonFields">
                  <%= text_field_tag "checkout_folios[#{row.folio.id}][reason]",
                        nil,
                        placeholder: "Reason",
                        class: "w-full rounded-md border border-slate-300 bg-white px-2.5 py-2 text-xs font-semibold text-slate-700 placeholder:text-slate-400 focus:border-slate-500 focus:outline-none",
                        data: { required_for_action: "true" } %>
                </div>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% end %>
</section>
