<% folio_show = local_assigns.fetch(:folio_show) %>
<% header_action = local_assigns[:header_action] %>

<section class="overflow-hidden border border-slate-200 bg-white">
  <div class="flex items-center justify-between gap-3 border-b border-slate-200 px-4 py-2.5">
    <h3 class="text-xs font-bold uppercase tracking-wider text-slate-800">Transaction Ledger</h3>
    <div class="flex items-center gap-3">
      <%= header_action if header_action.present? %>
      <span class="text-[10px] font-semibold uppercase tracking-wider text-slate-500"><%= pluralize(folio_show.ledger_entry_count, "entry") %></span>
    </div>
  </div>

  <div class="overflow-x-auto">
    <table class="w-full min-w-[760px] table-fixed text-left text-xs">
      <thead class="bg-slate-50 text-[9px] font-bold uppercase tracking-wider text-slate-500">
        <tr class="border-b border-slate-200">
          <th class="w-24 px-3 py-2">Date</th>
          <th class="w-20 px-3 py-2">Code</th>
          <th class="px-3 py-2">Description / Reference</th>
          <th class="w-24 px-3 py-2 text-right">Debit</th>
          <th class="w-24 px-3 py-2 text-right">Credit</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-slate-100">
        <tr class="border-y border-amber-200 bg-amber-50/70">
          <td colspan="5" class="px-3 py-2">
            <div class="flex items-center justify-between gap-3">
              <span class="font-bold text-amber-950">Upcoming charges to post</span>
              <span class="text-[10px] font-semibold text-amber-800"><%= folio_show.forecasted_section_summary %></span>
            </div>
          </td>
        </tr>
        <% folio_show.forecasted_rows.each do |row| %>
          <tr class="border-l-2 border-l-amber-400 transition hover:bg-amber-50/40">
            <td class="whitespace-nowrap px-3 py-2 text-slate-600"><%= row.date_label %></td>
            <td class="px-3 py-2 font-mono text-[10px] font-semibold uppercase tracking-wide text-slate-700"><%= row.code %></td>
            <td class="px-3 py-2">
              <p class="font-semibold text-slate-900"><%= row.description %></p>
              <p class="mt-0.5 text-[9px] font-semibold uppercase tracking-wider text-amber-700">
                <%= row.reference_label %> · <%= row.detail_label %> · <%= row.source_label %>
              </p>
            </td>
            <td class="px-3 py-2 text-right font-bold tabular-nums text-slate-900"><%= row.debit %></td>
            <td class="px-3 py-2 text-right font-bold tabular-nums text-emerald-700"><%= row.credit %></td>
          </tr>
        <% end %>
        <% if folio_show.forecasted_rows.empty? %>
          <tr><td colspan="5" class="px-3 py-3 text-center text-[11px] text-slate-500">No upcoming charges to post.</td></tr>
        <% end %>

        <tr class="border-y border-slate-200 bg-slate-50">
          <td colspan="5" class="px-3 py-2">
            <div class="flex items-center justify-between gap-3">
              <span class="font-bold text-slate-800">Existing transactions</span>
              <span class="text-[10px] font-semibold text-slate-500"><%= folio_show.posted_section_summary %></span>
            </div>
          </td>
        </tr>
        <% folio_show.posted_rows.each do |row| %>
          <tr class="transition hover:bg-slate-50/70 <%= "text-slate-400" if row.reversed %>">
            <td class="whitespace-nowrap px-3 py-2 text-slate-600"><%= row.date_label %></td>
            <td class="px-3 py-2 font-mono text-[10px] font-semibold uppercase tracking-wide text-slate-700"><%= row.code %></td>
            <td class="px-3 py-2">
              <div class="flex items-center gap-1.5">
                <p class="font-semibold text-slate-900 <%= "line-through text-slate-400" if row.reversed %>"><%= row.description %></p>
                <% if row.reversed %>
                  <span class="rounded bg-slate-100 px-1 py-0.5 text-[8px] font-bold uppercase text-slate-500">Reversed</span>
                <% end %>
              </div>
              <p class="mt-0.5 text-[9px] font-semibold uppercase tracking-wider text-slate-500">
                <%= row.reference_label %> · <%= row.detail_label %> · <%= row.source_label %>
              </p>
            </td>
            <td class="px-3 py-2 text-right font-bold tabular-nums text-slate-900 <%= "line-through" if row.reversed %>"><%= row.debit %></td>
            <td class="px-3 py-2 text-right font-bold tabular-nums text-emerald-700 <%= "line-through" if row.reversed %>"><%= row.credit %></td>
          </tr>
        <% end %>
        <% if folio_show.posted_rows.empty? %>
          <tr><td colspan="5" class="px-3 py-3 text-center text-[11px] text-slate-500">No existing transactions.</td></tr>
        <% end %>
      </tbody>
    </table>
  </div>
</section>
