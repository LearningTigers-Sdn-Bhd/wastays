<% folio = booking.booking_folio %>
<% currency = booking.currency.presence || "MYR" %>
<% projected_lines = Array(local_assigns[:projected_lines]) %>
<% posted_transactions = folio&.folio_transactions&.order(posting_date: :asc, created_at: :asc) || [] %>
<% header_action = local_assigns[:header_action] %>
<% transaction_count = posted_transactions.size + projected_lines.size %>

<section class="overflow-hidden border border-slate-200 bg-white">
  <div class="flex items-center justify-between gap-3 border-b border-slate-200 px-4 py-2.5">
    <h3 class="text-xs font-bold uppercase tracking-wider text-slate-800">Transaction Ledger</h3>
    <div class="flex items-center gap-3">
      <%= header_action if header_action.present? %>
      <span class="text-[10px] font-semibold uppercase tracking-wider text-slate-500"><%= pluralize(transaction_count, "entry") %></span>
    </div>
  </div>

  <div class="overflow-x-auto">
    <table class="w-full min-w-[860px] table-fixed text-left text-xs">
      <thead class="bg-slate-50 text-[9px] font-bold uppercase tracking-wider text-slate-500">
        <tr class="border-b border-slate-200">
          <th class="w-24 px-3 py-2">ID</th>
          <th class="w-28 px-3 py-2">Date</th>
          <th class="px-3 py-2">Description</th>
          <th class="w-28 px-3 py-2">GL Code</th>
          <th class="w-36 px-3 py-2">Staff / Source</th>
          <th class="w-36 px-3 py-2 text-right">Amount</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-slate-100">
        <tr class="border-y border-amber-200 bg-amber-50/70">
          <td colspan="6" class="px-3 py-2">
            <div class="flex items-center justify-between gap-3">
              <span class="font-bold text-amber-950">Forecast charges to post</span>
              <span class="text-[10px] font-semibold text-amber-800"><%= projected_lines.size %> pending · <%= currency %> <%= number_with_precision(projected_lines.sum { |line| line[:amount].to_d }, precision: 2) %></span>
            </div>
          </td>
        </tr>
        <% projected_lines.each do |line| %>
          <tr class="border-l-2 border-l-amber-400 transition hover:bg-amber-50/40">
            <td class="px-3 py-2 text-[9px] font-bold uppercase tracking-wider text-amber-700">Pending</td>
            <td class="whitespace-nowrap px-3 py-2 text-slate-600"><%= line[:date].strftime("%d %b %Y") %></td>
            <td class="px-3 py-2">
              <p class="font-semibold text-slate-900"><%= line[:description] %></p>
              <p class="mt-0.5 text-[9px] font-semibold uppercase tracking-wider text-amber-700">Charge · <%= line[:category].to_s.humanize %></p>
            </td>
            <td class="px-3 py-2 font-mono text-[10px] text-slate-500">—</td>
            <td class="px-3 py-2"><p class="font-medium text-slate-700">Forecast</p><p class="text-[9px] text-slate-500">Posts on checkout</p></td>
            <td class="px-3 py-2 text-right font-bold tabular-nums text-slate-900">+<%= currency %> <%= number_with_precision(line[:amount].to_d, precision: 2) %></td>
          </tr>
        <% end %>
        <% if projected_lines.empty? %>
          <tr><td colspan="6" class="px-3 py-3 text-center text-[11px] text-slate-500">No forecast charges to post.</td></tr>
        <% end %>

        <tr class="border-y border-slate-200 bg-slate-50">
          <td colspan="6" class="px-3 py-2">
            <div class="flex items-center justify-between gap-3">
              <span class="font-bold text-slate-800">Existing transactions</span>
              <span class="text-[10px] font-semibold text-slate-500"><%= posted_transactions.size %> posted</span>
            </div>
          </td>
        </tr>
        <% posted_transactions.each do |transaction| %>
          <tr class="transition hover:bg-slate-50/70 <%= "text-slate-400" if transaction.reversed? %>">
            <td class="px-3 py-2 font-mono text-[10px] tabular-nums text-slate-500">#<%= transaction.id.to_s.last(6) %></td>
            <td class="whitespace-nowrap px-3 py-2 text-slate-600"><%= transaction.posting_date.strftime("%d %b %Y") %></td>
            <td class="px-3 py-2">
              <div class="flex items-center gap-1.5">
                <p class="font-semibold text-slate-900 <%= "line-through text-slate-400" if transaction.reversed? %>"><%= transaction.description %></p>
                <% if transaction.reversed? %>
                  <span class="rounded bg-slate-100 px-1 py-0.5 text-[8px] font-bold uppercase text-slate-500">Reversed</span>
                <% elsif transaction.reversal_of_transaction_id.present? %>
                  <span class="rounded bg-amber-100 px-1 py-0.5 text-[8px] font-bold uppercase text-amber-700">Reversal</span>
                <% end %>
              </div>
              <p class="mt-0.5 text-[9px] font-semibold uppercase tracking-wider text-slate-500"><%= transaction.transaction_type.humanize %> · <%= transaction.category.humanize %></p>
            </td>
            <td class="px-3 py-2 font-mono text-[10px] text-slate-600"><%= transaction.gl_code.presence || "—" %></td>
            <td class="px-3 py-2"><p class="font-medium text-slate-700"><%= transaction.user&.name || "Night Audit" %></p><p class="text-[9px] text-slate-500"><%= transaction.user ? "Manual" : "System" %></p></td>
            <td class="px-3 py-2 text-right font-bold tabular-nums <%= folio_transaction_amount_class(transaction) %> <%= "line-through" if transaction.reversed? %>"><%= folio_transaction_amount_label(transaction, currency: currency) %></td>
          </tr>
        <% end %>
        <% if posted_transactions.empty? %>
          <tr><td colspan="6" class="px-3 py-3 text-center text-[11px] text-slate-500">No existing transactions.</td></tr>
        <% end %>
      </tbody>
    </table>
  </div>
</section>
