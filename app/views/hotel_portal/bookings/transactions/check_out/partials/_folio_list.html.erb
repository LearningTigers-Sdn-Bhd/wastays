<% sheets = local_assigns[:checkout_sheets].presence || { checkout_sheet.booking => checkout_sheet } %>
<% selected_ids = Array(local_assigns[:selected_booking_ids]).reject(&:blank?).map(&:to_s) %>
<% group_checkout = local_assigns.fetch(:group_checkout, false) %>

<section class="bg-white" data-checkout-settlement-target="requiresSelection">
  <div class="border-b border-slate-200 px-4 py-3">
    <h3 class="text-sm font-bold uppercase tracking-wide text-slate-900">Folio List</h3>
    <p class="mt-0.5 text-xs text-slate-500">Choose the checkout action for each folio. Open folio link to view ledger.</p>
  </div>
  <div class="overflow-x-auto">
    <table class="w-full min-w-[1120px] table-fixed divide-y divide-slate-200 text-left text-xs">
      <thead class="bg-slate-50 text-[10px] font-bold uppercase tracking-wider text-slate-500">
        <tr>
          <th class="w-[24%] px-4 py-2.5">Booking</th>
          <th class="w-[22%] px-4 py-2.5">Folio</th>
          <th class="w-[14%] px-4 py-2.5">Payer</th>
          <th class="w-[14%] px-4 py-2.5 text-right">Balance</th>
          <th class="w-[12%] px-4 py-2.5">Status</th>
          <th class="w-[14%] px-4 py-2.5">Action</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-slate-100 bg-white">
        <% sheets.each do |checkout_booking, sheet| %>
          <% room = checkout_booking.booking_rooms.first %>
          <% booking_visible = !group_checkout || selected_ids.include?(checkout_booking.id.to_s) %>
          <% booking_title = "#{room&.room_type&.name.presence || room&.room_type_snapshot.to_h['name'].presence || 'Room type unavailable'} - #{room&.room_number.presence || 'Unassigned room'}" %>
          <% sheet.folio_rows.each do |row| %>
            <% field_prefix = "checkout_bookings[#{checkout_booking.id}][folios]" %>
            <% action_field_name = "#{field_prefix}[#{row.folio.id}][action]" %>
            <% single_action = row.action_options.one? %>
            <tr class="<%= 'hidden' unless booking_visible %>" data-checkout-settlement-target="bookingRow" data-booking-id="<%= checkout_booking.id %>">
              <td class="px-4 py-3 align-top">
                <p class="font-bold text-slate-900"><%= booking_title %></p>
                <p class="mt-0.5 text-xs font-semibold text-slate-500"><%= checkout_booking.guest_name %></p>
              </td>
              <td class="px-4 py-3 align-top">
                <%= link_to row.name, row.ledger_path, target: "_blank", rel: "noopener", class: "font-bold text-slate-900 underline decoration-slate-300 underline-offset-2 hover:text-slate-600", data: { turbo: false } %>
                <p class="mt-0.5 text-xs font-semibold text-slate-500"><%= row.folio.folio_reference_display %></p>
              </td>
              <td class="px-4 py-3 align-top font-semibold text-slate-600"><%= row.payer_label %></td>
              <td class="px-4 py-3 text-right align-top font-bold tabular-nums text-slate-900"><%= sheet.money(row.balance) %></td>
              <td class="px-4 py-3 align-top">
                <span class="rounded-md px-2 py-1 text-[10px] font-bold uppercase tracking-wide <%= row.status_tone == "emerald" ? "bg-emerald-50 text-emerald-700" : row.status_tone == "amber" ? "bg-amber-50 text-amber-700" : row.status_tone == "rose" ? "bg-rose-50 text-rose-700" : "bg-slate-100 text-slate-600" %>"><%= row.status_label %></span>
              </td>
              <td class="px-4 py-3 align-top">
                <%= hidden_field_tag action_field_name, row.default_action if single_action %>
                <%= select_tag action_field_name,
                      options_for_select(row.action_options, row.default_action),
                      disabled: single_action || !booking_visible,
                      class: "w-full rounded-md border border-slate-300 bg-white px-2.5 py-2 text-xs font-semibold text-slate-700 focus:border-slate-500 focus:outline-none disabled:cursor-not-allowed disabled:bg-slate-50 disabled:text-slate-500",
                      data: {
                        checkout_settlement_target: "actionSelect",
                        folio_id: row.folio.id,
                        action: "change->checkout-settlement#updateSettlementDetails"
                      } %>
              </td>
            </tr>
          <% end %>
        <% end %>
      </tbody>
    </table>
  </div>
</section>
