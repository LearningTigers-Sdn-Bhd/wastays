<%# Shared amend-stay booking transaction sheet. %>

<%= turbo_frame_tag "offcanvas_drawer", data: { offcanvas_variant: "right" } do %>
  <div class="flex flex-col h-full bg-card">
    <%= form_with model: @booking, url: hotel_booking_transaction_amend_stay_path(current_hotel, @booking), method: :patch,
        class: "flex flex-col h-full",
        data: {
          controller: "booking-calc group-lifecycle-targets",
          group_lifecycle_targets_selection_mode_value: "checkbox",
          booking_calc_availability_url_value: availability_hotel_bookings_path(current_hotel),
          booking_calc_price_url_value: stay_price_hotel_bookings_path(current_hotel),
          booking_calc_rate_options_url_value: rate_options_hotel_bookings_path(current_hotel),
          booking_calc_exclude_booking_id_value: @booking.id
        } do |f| %>
      <%# Modal Header %>
      <%= render "hotel_portal/bookings/board/partials/content_header",
                 title: "Edit Stay & Room",
                 subtitle: "Update booking dates and room assignment",
                 icon: cached_icon("pen-line", stroke_width: 2.5, class: "size-5") %>

      <%# Modal Content %>
      <div class="flex-1 <%= @booking.group_booking_id? ? 'grid min-h-0 grid-rows-[auto_minmax(0,1fr)] overflow-hidden lg:grid-cols-[20rem_minmax(0,1fr)] lg:grid-rows-none' : 'space-y-6 overflow-y-auto p-8 custom-scrollbar' %>">
        <%= render "hotel_portal/bookings/transactions/shared/group_target_selector",
          target_presenter: HotelPortal::BookingLifecycleTargetPresenter.new(booking: @booking, action: :amend_stay) %>

        <% if @booking.group_booking_id? %>
          <div class="min-h-0 overflow-y-auto custom-scrollbar">
            <div class="space-y-6 p-8">
        <% end %>

        <%= hidden_field_tag :return_to, @transaction_return_to if @transaction_return_to.present? %>

        <div class="grid sm:grid-cols-2 gap-6">
          <div class="space-y-2">
            <label class="block text-[11px] font-black text-muted-foreground uppercase tracking-[0.15em]">Scheduled Check-in</label>
            <%= f.datetime_local_field :check_in, value: @booking.check_in.in_time_zone(current_hotel.hotel_time_zone).strftime("%Y-%m-%dT%H:%M"),
                class: "w-full rounded-2xl border-2 border-border bg-muted py-3 px-4 text-sm font-bold text-foreground focus:border-border-interactive focus:bg-card focus:outline-none focus:ring-0 transition-all shadow-sm",
                data: { booking_calc_target: "checkIn", action: "change->booking-calc#calculate" } %>
          </div>
          <div class="space-y-2">
            <label class="block text-[11px] font-black text-muted-foreground uppercase tracking-[0.15em]">Scheduled Check-out</label>
            <%= f.datetime_local_field :check_out, value: @booking.check_out.in_time_zone(current_hotel.hotel_time_zone).strftime("%Y-%m-%dT%H:%M"),
                class: "w-full rounded-2xl border-2 border-border bg-muted py-3 px-4 text-sm font-bold text-foreground focus:border-border-interactive focus:bg-card focus:outline-none focus:ring-0 transition-all shadow-sm",
                data: { booking_calc_target: "checkOut", action: "change->booking-calc#calculate" } %>
          </div>
        </div>

        <div class="space-y-2">
          <label class="block text-[11px] font-black text-muted-foreground uppercase tracking-[0.15em]">Room Category</label>
          <% current_room_type_id = @booking.booking_rooms.first&.room_type_id %>
          <%= f.collection_select :room_type_id, @room_types, :id, :name, { selected: current_room_type_id },
              { class: "w-full rounded-2xl border-2 border-border bg-muted py-3 px-4 text-sm font-bold text-foreground focus:border-border-interactive focus:bg-card focus:outline-none focus:ring-0 transition-all shadow-sm",
                data: {
                  booking_calc_target: "roomType",
                  action: "change->booking-calc#updateRoomNumbers change->booking-calc#calculate",
                  prices: @room_types.map { |rt| [rt.id, rt.base_price] }.to_h.to_json,
                  room_numbers: @room_types.map { |rt| [rt.id, rt.room_numbers] }.to_h.to_json
                }
              } %>
        </div>

        <div class="space-y-2">
          <label class="block text-[11px] font-black text-muted-foreground uppercase tracking-[0.15em]">Select Rates</label>
          <% current_rate_plan = @booking.booking_rooms.first&.rate_plan %>
          <%= f.select :rate_plan_id, (current_rate_plan ? [[current_rate_plan.name, current_rate_plan.id]] : []), { selected: current_rate_plan&.id, prompt: "Select room category and dates first" },
              { class: "w-full rounded-2xl border-2 border-border bg-muted py-3 px-4 text-sm font-bold text-foreground focus:border-border-interactive focus:bg-card focus:outline-none focus:ring-0 transition-all shadow-sm",
                data: { booking_calc_target: "ratePlanSelect", action: "change->booking-calc#calculate" } } %>
        </div>

        <div data-controller="room-lock"
             data-room-lock-url-value="<%= hotel_room_locks_path(current_hotel) %>"
             data-room-lock-room-type-id-value="<%= current_room_type_id %>"
             data-room-lock-current-room-value="<%= @booking.hotel_snapshot.is_a?(Hash) ? (@booking.hotel_snapshot['room_number'] || @booking.hotel_snapshot.dig('assignment', 'room_number')) : nil %>"
             data-booking-calc-target="roomNumberContainer"
             class="space-y-2">
          <label for="booking_room_number" class="block text-[11px] font-black text-muted-foreground uppercase tracking-[0.15em]">Room Number</label>
          <% current_room_number = @booking.hotel_snapshot.is_a?(Hash) ? @booking.hotel_snapshot['room_number'].presence || @booking.hotel_snapshot.dig('assignment', 'room_number').presence : nil %>
          <%= f.select :room_number, [[current_room_number, current_room_number]], { selected: current_room_number },
              { id: "booking_room_number",
                class: "w-full rounded-2xl border-2 border-border bg-muted py-3 px-4 text-sm font-bold text-foreground focus:border-border-interactive focus:bg-card focus:outline-none focus:ring-0 transition-all shadow-sm",
                data: {
                  booking_calc_target: "roomNumberSelect",
                  action: "change->room-lock#lock"
                }
              } %>
          <p class="text-[10px] font-bold text-muted-foreground mt-2 italic uppercase tracking-wider">Only available rooms for the selected dates are shown.</p>
        </div>

        <div class="mt-8 p-6 rounded-3xl bg-muted border-2 border-border" data-booking-calc-target="estimatedTotalSection">
          <div class="flex items-center justify-between">
            <div>
              <p class="text-[11px] font-black text-muted-foreground uppercase tracking-[0.15em]">Estimated Total</p>
              <p class="text-[10px] font-bold text-muted-foreground mt-1">Includes taxes & fees</p>
            </div>
            <p class="text-2xl font-black text-foreground tracking-tight">MYR <span data-booking-calc-target="displayTotal"><%= number_with_precision(@booking.total_amount, precision: 2) %></span></p>
          </div>
          <%= f.hidden_field :total_amount, data: { booking_calc_target: "totalInput" } %>
          <%= f.hidden_field :manual_rate_override, data: { booking_calc_target: "rateOverrideFlag" } %>
          <%= f.hidden_field :guest_country, value: @booking.guest_country, data: { booking_calc_target: "guestCountry" } %>
        </div>

        <% if @booking.group_booking_id? %>
            </div>
          </div>
        <% end %>
      </div>

      <%# Modal Footer %>
      <%= render "hotel_portal/bookings/board/partials/content_footer",
                 show_full_page_link: false,
                 submit_button: f.submit("Save Changes", class: "px-6 py-2.5 bg-primary text-primary-foreground rounded-xl text-sm font-bold hover:bg-primary-hover transition-colors shadow-sm") %>
    <% end %>
  </div>
<% end %>
