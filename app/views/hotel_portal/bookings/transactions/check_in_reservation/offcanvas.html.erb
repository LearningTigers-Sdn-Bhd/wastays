<%= turbo_frame_tag "offcanvas_drawer", data: { offcanvas_variant: "right" } do %>
  <div class="flex flex-col h-full">
    <%= form_with model: @booking, url: check_in_hotel_booking_path(current_hotel, @booking), method: :post,
        class: "flex flex-col h-full" do |f| %>
      <%= hidden_field_tag :source, @transaction_source if @transaction_source.present? %>
      <%= hidden_field_tag :return_to, @transaction_return_to if @transaction_return_to.present? %>

      <%# Modal Header %>
      <%= render "hotel_portal/bookings/board/partials/content_header",
                 title: @presenter.check_in_title,
                 subtitle: "Set check-in time and assign rooms for #{@booking.guest_name}.",
                  icon: cached_icon("log-in", stroke_width: 2.5, class: "size-5") %>

      <%# Modal Content %>
      <div class="flex-1 p-6 space-y-6 overflow-y-auto custom-scrollbar">
        <%= render "hotel_portal/bookings/guarantee_status_badge", booking: @booking %>

        <div>
          <label class="block text-[11px] font-bold text-slate-500 uppercase tracking-wider mb-2">Check-in Date & Time</label>
          <%= f.datetime_local_field :checked_in_at,
              value: @presenter.checked_in_at_form_value,
              class: "w-full rounded-xl border border-slate-200 bg-white py-2.5 px-4 text-sm text-slate-700 focus:border-slate-300 focus:outline-none focus:ring-0 shadow-sm" %>
        </div>

        <% unless @booking.checked_in? %>
          <div class="rounded-2xl border border-slate-200 bg-slate-50/70 p-4">
            <label class="flex items-start justify-between gap-4">
              <span>
                <span class="block text-sm font-bold text-slate-900">Collect security deposit</span>
                <span class="mt-1 block text-xs font-medium text-slate-500">Record a manual deposit independently from the guest folio.</span>
              </span>
              <%= check_box_tag :collect_security_deposit, "1", false, class: "mt-1 rounded border-slate-300 text-slate-900 focus:ring-slate-900" %>
            </label>
            <div class="mt-4 grid gap-3 sm:grid-cols-2">
              <div>
                <%= label_tag :security_deposit_amount, "Amount", class: "mb-2 block text-[11px] font-bold uppercase tracking-wider text-slate-500" %>
                <%= number_field_tag :security_deposit_amount, nil, step: 0.01, min: 0, class: "w-full rounded-xl border border-slate-200 bg-white px-4 py-2.5 text-sm" %>
              </div>
              <div>
                <%= label_tag :security_deposit_payment_method, "Method", class: "mb-2 block text-[11px] font-bold uppercase tracking-wider text-slate-500" %>
                <%= select_tag :security_deposit_payment_method, options_for_select([["Cash", "cash"], ["Credit Card", "credit_card"], ["Bank Transfer", "bank_transfer"], ["Manual", "manual"]], "cash"), class: "w-full rounded-xl border border-slate-200 bg-white px-4 py-2.5 text-sm" %>
              </div>
            </div>
            <div class="mt-3">
              <%= label_tag :security_deposit_reference, "Reference", class: "mb-2 block text-[11px] font-bold uppercase tracking-wider text-slate-500" %>
              <%= text_field_tag :security_deposit_reference, nil, placeholder: "Optional receipt/reference", class: "w-full rounded-xl border border-slate-200 bg-white px-4 py-2.5 text-sm" %>
            </div>
          </div>

          <% if current_hotel.tourism_tax_enabled? %>
            <% tourism_tax_applicable = current_hotel.tourism_tax_applicable_for?(@booking.guest_country) %>
            <div class="rounded-2xl border border-slate-200 bg-slate-50/70 p-4" data-controller="tourism-tax-collection">
              <label class="flex items-start justify-between gap-4">
                <span>
                  <span class="block text-sm font-bold text-slate-900">Tourism Tax</span>
                  <span class="mt-1 block text-xs font-medium text-slate-500">Record collection of mandatory tourism tax.</span>
                </span>
                <%= f.check_box :tourism_tax_collected, 
                                class: "mt-1 rounded border-slate-300 text-slate-900 focus:ring-slate-900 disabled:opacity-50 disabled:cursor-not-allowed",
                                disabled: !tourism_tax_applicable,
                                data: { action: "change->tourism-tax-collection#toggle", tourism_tax_collection_target: "checkbox" } %>
              </label>
              
              <div class="mt-4 <%= 'hidden' unless @booking.tourism_tax_collected? %>" data-tourism-tax-collection-target="amountContainer">
                <div class="flex items-center justify-between p-3 rounded-xl bg-white border border-slate-200 shadow-sm gap-4">
                  <span class="text-xs font-bold text-slate-600 uppercase tracking-wider shrink-0">Amount Collected (RM)</span>
                  <%= f.text_field :tourism_tax_amount, 
                                     value: number_with_precision(f.object.tourism_tax_amount, precision: 2),
                                     readonly: true,
                                     class: "w-32 rounded-lg border border-slate-200 py-1.5 px-3 text-right text-sm font-black text-slate-900 bg-slate-50 focus:outline-none focus:ring-0 cursor-not-allowed" %>
                </div>
                <p class="mt-2 text-[10px] text-slate-400 italic text-center">Fixed amount based on stay duration.</p>
              </div>
              
              <% unless tourism_tax_applicable %>
                <p class="mt-3 text-[10px] font-bold text-orange-600 bg-orange-50 px-3 py-2 rounded-lg border border-orange-100">
                  Not applicable for Malaysian citizens.
                </p>
              <% end %>
            </div>
          <% end %>
        <% end %>

        <div class="p-4 bg-slate-50 rounded-2xl border border-slate-200">
          <label class="block text-[11px] font-bold text-slate-500 uppercase tracking-wider mb-2">Guarantee Method</label>
          <%= f.select :guarantee_method,
              @presenter.guarantee_method_options,
              { prompt: "Select Method" },
              class: "w-full rounded-xl border border-slate-200 bg-white py-2.5 px-4 text-sm font-bold text-slate-700 focus:border-slate-300 focus:outline-none focus:ring-0 shadow-sm" %>
        </div>

        <div class="space-y-3">
          <label class="block text-[11px] font-bold text-slate-500 uppercase tracking-wider">Room Assignments</label>
          <%= f.fields_for :booking_rooms do |rf| %>
            <div class="flex items-center gap-3"
                 data-controller="room-lock room-selection"
                 data-room-lock-url-value="<%= hotel_room_locks_path(current_hotel) %>"
                 data-room-lock-room-type-id-value="<%= rf.object.room_type_id %>"
                 data-room-lock-current-room-value="<%= rf.object.room_number %>"
                 data-room-selection-url-value="<%= availability_hotel_bookings_path(current_hotel) %>"
                 data-room-selection-room-type-id-value="<%= rf.object.room_type_id %>"
                 data-room-selection-check-in-value="<%= @booking.check_in.to_date %>"
                 data-room-selection-check-out-value="<%= @booking.check_out.to_date %>"
                 data-room-selection-booking-id-value="<%= @booking.id %>"
                 data-room-selection-current-room-value="<%= rf.object.room_number %>">
              <div class="flex-1">
                <p class="text-[10px] font-medium text-slate-400 uppercase mb-1"><%= rf.object.room_type.name %></p>
                <%= rf.select :room_number, [[rf.object.room_number, rf.object.room_number]], { selected: rf.object.room_number },
                    class: "w-full rounded-xl border border-slate-200 bg-white py-2.5 px-4 text-sm text-slate-700 focus:border-slate-300 focus:outline-none focus:ring-0 shadow-sm",
                    data: {
                      room_selection_target: "select",
                      action: "change->room-lock#lock"
                    } %>
                <p class="text-[10px] text-slate-400 mt-1.5 italic">Only available rooms for the stay dates are shown.</p>
              </div>
            </div>
          <% end %>
        </div>

        <% if @presenter.requires_backdated_checkin_reason? %>
          <div class="mt-4 pt-4 border-t border-slate-100">
            <div class="flex gap-3">
              <div class="flex-shrink-0 mt-0.5">
                <%= cached_icon "triangle-alert", stroke_width: 2, class: "size-4 text-orange-500" %>
              </div>
              <div class="flex-1">
                <h4 class="text-xs font-bold text-slate-900">Backdated Check-in</h4>
                <p class="text-[11px] text-slate-500 mt-1 mb-3">Night audit has already run for this check-in date. This operation is for unexpected arrivals after the audit.</p>

                <div class="space-y-3">
                  <label class="flex items-center gap-2">
                    <%= check_box_tag :override_night_audit, "1", false, class: "rounded text-slate-900 focus:ring-slate-900 border-slate-300" %>
                    <span class="text-[11px] font-bold text-slate-700 uppercase tracking-wider">Override Night Audit</span>
                  </label>

                  <div>
                    <%= text_field_tag :retroactive_reason, nil, placeholder: "Provide a reason (e.g. system offline, missed check-in)", class: "w-full rounded-xl border border-slate-200 bg-white py-2.5 px-4 text-sm text-slate-700 focus:border-slate-300 focus:outline-none focus:ring-0 shadow-sm" %>
                  </div>
                </div>
              </div>
            </div>
          </div>
        <% end %>
      </div>

      <%# Modal Footer %>
      <%= render "hotel_portal/bookings/board/partials/content_footer",
                 show_full_page_link: false,
                 submit_button: f.submit((@booking.checked_in? ? "Save Changes" : "Confirm Check In"), class: "px-6 py-2 bg-slate-900 text-white rounded-xl text-sm font-bold hover:bg-slate-700 transition-colors shadow-sm") %>
    <% end %>
  </div>
<% end %>
