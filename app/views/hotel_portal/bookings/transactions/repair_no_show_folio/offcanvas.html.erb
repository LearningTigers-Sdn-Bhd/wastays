<%= turbo_frame_tag "offcanvas_drawer" do %>
  <div class="flex h-full flex-col bg-white">
    <%= render "hotel_portal/bookings/board/partials/content_header",
      title: "Repair No-show Folio",
      subtitle: @booking.guest_name,
      icon: cached_icon("receipt-text", class: "size-5 text-amber-600") %>

    <%= form_with url: repair_no_show_folio_hotel_booking_path(current_hotel, @booking), method: :post, class: "flex min-h-0 flex-1 flex-col" do |f| %>
      <%= hidden_field_tag :return_to, @transaction_return_to if @transaction_return_to.present? %>
      <div class="flex-1 space-y-5 overflow-y-auto p-8">
        <div class="rounded-xl border border-amber-200 bg-amber-50 p-4 text-sm text-amber-900">
          This will post an audited correction for tourism tax charged when this booking was marked as a no-show. Other no-show charges and taxes will remain unchanged.
        </div>

        <section class="rounded-2xl border border-slate-200 p-5">
          <div class="flex items-center justify-between gap-4">
            <span class="text-sm font-semibold text-slate-600">Tourism tax to remove</span>
            <span class="text-base font-bold text-slate-950"><%= @booking.currency %> <%= format("%.2f", @tourism_tax_total) %></span>
          </div>
        </section>

        <div class="space-y-3">
          <% @projected_balances.each do |folio, projected_balance| %>
            <div class="rounded-xl border border-slate-200 p-4">
              <div class="flex items-center justify-between gap-4">
                <span class="text-sm font-bold text-slate-800"><%= folio.display_name %></span>
                <span class="text-sm font-semibold text-slate-700"><%= folio.currency %> <%= format("%.2f", projected_balance) %></span>
              </div>
              <p class="mt-1 text-xs font-medium text-slate-500">
                <%= projected_balance.zero? ? "This folio will close after the correction." : "This folio will remain open because its projected balance is not zero." %>
              </p>
            </div>
          <% end %>
        </div>
      </div>

      <%= render "hotel_portal/bookings/board/partials/content_footer",
        show_full_page_link: false,
        submit_button: f.submit("Remove Tourism Tax", class: "rounded-xl bg-amber-600 px-6 py-2.5 text-sm font-bold text-white") %>
    <% end %>
  </div>
<% end %>
