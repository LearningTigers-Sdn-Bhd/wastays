<% booking = @booking %>
<% presenter = @panel_presenter %>
<% can_manage_bookings = current_user.has_permission?("manage_bookings", hotel: current_hotel) %>

<%= turbo_frame_tag "offcanvas_drawer_secondary", data: { offcanvas_variant: "right" } do %>
  <div class="flex h-full flex-col bg-white">
    <%= render "hotel_portal/bookings/board/partials/content_header",
      title: "Print / Send",
      subtitle: "Select an action per booking, or act on the whole group",
      icon: cached_icon("file-text", class: "size-5") %>

    <div class="flex-1 overflow-y-auto custom-scrollbar p-6">
      <section class="mb-6 overflow-hidden rounded-xl border border-slate-200">
        <div class="border-b border-slate-200 bg-slate-50 px-4 py-2.5">
          <p class="text-[11px] font-black uppercase tracking-wider text-slate-500">Group Documents</p>
        </div>
        <div class="divide-y divide-slate-100">
          <div class="flex items-center justify-between gap-2 px-4 py-3 text-sm font-semibold text-slate-400">
            <span class="flex items-center gap-2"><%= cached_icon "receipt", class: "size-4 shrink-0 text-slate-300" %> Group Receipt</span>
            <span class="rounded-full bg-slate-100 px-2 py-0.5 text-[10px] font-semibold text-slate-500">Unavailable</span>
          </div>
          <div class="flex items-center justify-between gap-2 px-4 py-3 text-sm font-semibold text-slate-400">
            <span class="flex items-center gap-2"><%= cached_icon "file-text", class: "size-4 shrink-0 text-slate-300" %> Group Invoice</span>
            <span class="rounded-full bg-slate-100 px-2 py-0.5 text-[10px] font-semibold text-slate-500">Unavailable</span>
          </div>
          <div class="flex items-center justify-between gap-2 px-4 py-3 text-sm font-semibold text-slate-400">
            <span class="flex items-center gap-2"><%= cached_icon "send", class: "size-4 shrink-0 text-slate-300" %> Resend Group Confirmation</span>
            <span class="rounded-full bg-slate-100 px-2 py-0.5 text-[10px] font-semibold text-slate-500">Unavailable</span>
          </div>
        </div>
      </section>

      <% presenter.document_row_groups.each do |room_type, rows| %>
        <section class="mb-4 overflow-hidden rounded-xl border border-slate-200">
          <div class="border-b border-slate-200 bg-slate-50 px-4 py-2.5">
            <p class="text-[11px] font-black uppercase tracking-wider text-slate-500"><%= room_type %> (<%= rows.size %>)</p>
          </div>
          <div class="divide-y divide-slate-100">
            <% rows.each do |row| %>
              <div class="flex flex-wrap items-center justify-between gap-3 px-4 py-3">
                <p class="text-sm font-semibold text-slate-800"><%= row.room_number %> · <%= row.guest_name %></p>
                <div class="flex flex-wrap items-center gap-1.5">
                  <%= link_to receipt_booking_path(row.booking.confirmation_token), target: "_blank", data: { turbo: false }, title: "Receipt", class: "inline-flex items-center gap-1.5 rounded-lg border border-slate-200 bg-white px-2.5 py-1.5 text-xs font-bold text-slate-700 hover:bg-slate-50" do %>
                    <%= cached_icon "receipt", class: "size-3.5 text-emerald-600" %> Receipt
                  <% end %>

                  <% if row.invoice_available %>
                    <%= link_to invoice_booking_path(row.booking.confirmation_token), target: "_blank", data: { turbo: false }, title: "Invoice", class: "inline-flex items-center gap-1.5 rounded-lg border border-slate-200 bg-white px-2.5 py-1.5 text-xs font-bold text-slate-700 hover:bg-slate-50" do %>
                      <%= cached_icon "file-text", class: "size-3.5 text-blue-600" %> Invoice
                    <% end %>
                  <% else %>
                    <span class="inline-flex items-center gap-1.5 rounded-lg border border-slate-100 bg-slate-50 px-2.5 py-1.5 text-xs font-bold text-slate-400" title="Available after checkout">
                      <%= cached_icon "file-text", class: "size-3.5 text-slate-300" %> Invoice
                    </span>
                  <% end %>

                  <% if can_manage_bookings %>
                    <%= link_to hotel_booking_guest_registration_card_path(current_hotel, row.booking), target: "_blank", data: { turbo: false }, title: "Guest Registration Card", class: "inline-flex items-center gap-1.5 rounded-lg border border-slate-200 bg-white px-2.5 py-1.5 text-xs font-bold text-slate-700 hover:bg-slate-50" do %>
                      <%= cached_icon "clipboard-list", class: "size-3.5 text-amber-600" %> RegCard
                    <% end %>
                  <% end %>

                  <span class="inline-flex items-center gap-1.5 rounded-lg border border-slate-100 bg-slate-50 px-2.5 py-1.5 text-xs font-bold text-slate-400" title="Unavailable">
                    <%= cached_icon "send", class: "size-3.5 text-slate-300" %> Resend
                  </span>
                  <span class="inline-flex items-center gap-1.5 rounded-lg border border-slate-100 bg-slate-50 px-2.5 py-1.5 text-xs font-bold text-slate-400" title="Unavailable">
                    <%= cached_icon "message-circle", class: "size-3.5 text-slate-300" %> Resend
                  </span>
                </div>
              </div>
            <% end %>
          </div>
        </section>
      <% end %>
    </div>
  </div>
<% end %>
