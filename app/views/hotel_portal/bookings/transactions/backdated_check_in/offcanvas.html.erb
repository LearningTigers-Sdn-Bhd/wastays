<%= turbo_frame_tag "offcanvas_drawer" do %>
  <div class="flex h-full flex-col bg-white">
    <%= render "hotel_portal/bookings/board/partials/content_header",
      title: "Backdated Check In",
      subtitle: @booking.guest_name,
      icon: cached_icon("history", class: "size-5") %>
    <%= form_with model: @booking,
      url: hotel_booking_transaction_booking_backdated_check_in_path(current_hotel, @booking),
      method: :post,
      class: "flex min-h-0 flex-1 flex-col #{@booking.group_booking_id? ? '' : 'p-8'}",
      data: { controller: "group-lifecycle-targets" } do |f| %>
      <%= hidden_field_tag :return_to, @transaction_return_to if @transaction_return_to.present? %>
      <%= f.hidden_field :checked_in_at, value: @booking.check_in&.in_time_zone(current_hotel.hotel_time_zone)&.strftime("%Y-%m-%dT%H:%M") %>
      <div class="flex-1 <%= @booking.group_booking_id? ? 'grid min-h-0 grid-rows-[auto_minmax(0,1fr)] overflow-hidden lg:grid-cols-[20rem_minmax(0,1fr)] lg:grid-rows-none' : 'space-y-5 overflow-y-auto custom-scrollbar' %>" data-controller="backdate-reason-validation">
        <%= render "hotel_portal/bookings/transactions/shared/group_target_selector",
          target_presenter: HotelPortal::BookingLifecycleTargetPresenter.new(booking: @booking, action: :backdated_check_in) %>

        <% if @booking.group_booking_id? %><div class="min-h-0 overflow-y-auto custom-scrollbar"><div class="space-y-5 p-8"><% end %>
        <div>
          <span class="mb-2 block text-xs font-bold uppercase tracking-wider text-slate-500">Scheduled Check-in</span>
          <p class="text-sm font-semibold text-slate-800"><%= @booking.check_in.in_time_zone(current_hotel.hotel_time_zone).strftime("%d %b %Y, %H:%M") %></p>
        </div>
        <div>
          <%= label_tag :posting_date, "Posting Date", class: "mb-2 block text-xs font-bold uppercase tracking-wider text-slate-500" %>
          <%= date_field_tag :posting_date, params[:posting_date] || current_hotel.current_business_date, required: true, class: "w-full rounded-xl border border-slate-200 bg-white px-4 py-3 text-sm font-medium text-slate-700 focus:border-slate-300 focus:outline-none focus:ring-0 shadow-sm" %>
        </div>
        <div>
          <%= label_tag :backdate_reason, "Backdate Reason", class: "mb-2 block text-xs font-bold uppercase tracking-wider text-slate-500" %>
          <%= select_tag :backdate_reason, options_for_select([
            ["Guest arrived earlier but was not checked in", "Guest arrived earlier but was not checked in"],
            ["System / internet issue", "System / internet issue"],
            ["Manual offline check-in", "Manual offline check-in"],
            ["Night audit correction", "Night audit correction"],
            ["Booking was created late", "Booking was created late"],
            ["Room was occupied before system update", "Room was occupied before system update"],
            ["Other", "Other"]
          ], params[:backdate_reason]), required: true,
              data: { backdate_reason_validation_target: "select", action: "change->backdate-reason-validation#toggle" },
              class: "w-full rounded-xl border border-slate-200 bg-white px-4 py-3 text-sm font-medium text-slate-700 focus:border-slate-300 focus:outline-none focus:ring-0 shadow-sm" %>
        </div>
        <div>
          <div class="flex items-center justify-between mb-2">
            <%= label_tag :retroactive_reason, "Reason Details", class: "block text-xs font-bold uppercase tracking-wider text-slate-500" %>
            <span data-backdate-reason-validation-target="optionalBadge" class="text-[10px] font-semibold text-slate-400 uppercase tracking-wider">Optional</span>
          </div>
          <%= text_area_tag :retroactive_reason, params[:retroactive_reason], rows: 4, placeholder: "Explain why this check-in is being recorded after the business date was closed.",
              data: { backdate_reason_validation_target: "details" },
              class: "w-full resize-y rounded-xl border border-slate-200 bg-white px-4 py-3 text-sm font-medium text-slate-700 focus:border-slate-300 focus:outline-none focus:ring-0 shadow-sm" %>
        </div>
        <% if @booking.group_booking_id? %></div></div><% end %>
      </div>
      <div class="mt-auto flex justify-end <%= @booking.group_booking_id? ? 'border-t border-slate-200 p-6' : 'pt-6' %>">
        <%= f.submit "Complete Backdated Check In", class: "rounded-xl bg-slate-900 px-6 py-3 text-sm font-bold text-white shadow-sm transition hover:bg-slate-700 cursor-pointer" %>
      </div>
    <% end %>
  </div>
<% end %>
