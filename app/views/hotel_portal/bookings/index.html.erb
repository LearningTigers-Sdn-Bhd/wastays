<% content_for :breadcrumbs do %>
  <div class="flex items-center gap-x-2">
    <span class="text-sm font-medium text-slate-600"><%= current_hotel.name %></span>
    <span class="text-sm text-slate-400">/</span>
    <span class="text-sm font-semibold text-slate-900">Bookings</span>
  </div>
<% end %>

<div class="max-w-[1600px] mx-auto pb-20 space-y-8">
  <div class="px-4 md:px-0 mt-5">
    <div>
      <h1 class="text-2xl font-bold tracking-tight text-slate-950 sm:text-3xl">Bookings</h1>
      <p class="mt-1 text-sm font-medium text-slate-600">Manage your hotel reservations and guest details.</p>
    </div>
  </div>

  <div class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">
    <div class="flex items-center justify-between border-b border-slate-200 px-8 py-6">
      <div>
        <h2 class="text-lg font-bold tracking-tight text-slate-950 sm:text-xl">Reservations</h2>
        <p class="mt-1 text-sm font-medium text-slate-600">Full list of bookings associated with this property.</p>
      </div>
      <span class="text-sm font-medium text-slate-500">Total Bookings <span class="font-semibold text-slate-900"><%= @bookings.count %></span></span>
    </div>

    <div class="border-b border-slate-200 bg-slate-50/70 px-8 py-5">
      <%= form_with url: hotel_bookings_path(current_hotel), method: :get, class: "flex flex-col gap-3 xl:flex-row xl:items-center xl:justify-between", data: { turbo_frame: "bookings_results", controller: "auto-submit" } do |f| %>
        <div class="flex w-full flex-col gap-3 lg:flex-row">
          <label class="relative block flex-1">
            <span class="sr-only">Search bookings</span>
            <span class="pointer-events-none absolute inset-y-0 left-0 flex items-center pl-4 text-slate-400">
              <svg class="size-4" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
            </span>
            <%= f.text_field :query,
                             value: params[:query],
                             placeholder: "Search guest name, email, phone or reference",
                             autocomplete: "off",
                             class: "w-full rounded-xl border border-slate-200 bg-white py-2.5 pl-11 pr-4 text-sm text-slate-700 placeholder:text-slate-400 focus:border-slate-300 focus:outline-none focus:ring-0 shadow-sm",
                             data: { action: "input->auto-submit#submit" } %>
          </label>

          <%= f.select :status,
                       Booking::STATUSES.map { |s| [s.titleize, s] },
                       { include_blank: "All Statuses", selected: params[:status] },
                       class: "rounded-xl border border-slate-200 bg-white px-3 py-2.5 text-sm font-medium text-slate-700 focus:border-slate-300 focus:outline-none focus:ring-0 shadow-sm",
                       data: { action: "change->auto-submit#submit" } %>
        </div>

        <div class="flex items-center gap-2">
          <% if params[:query].present? || params[:status].present? %>
            <%= link_to "Clear", hotel_bookings_path(current_hotel), class: "inline-flex items-center rounded-lg border border-slate-200 bg-white px-3 py-2 text-sm font-semibold text-slate-700 shadow-sm transition hover:border-slate-900 hover:bg-slate-50", data: { turbo_frame: "bookings_results" } %>
          <% end %>
        </div>
      <% end %>
    </div>

    <%= turbo_frame_tag "bookings_results" do %>
      <div class="hidden lg:block overflow-x-auto">
        <table class="min-w-full table-fixed">
          <colgroup>
            <col class="w-[18%]">
            <col class="w-[22%]">
            <col class="w-[20%]">
            <col class="w-[12%]">
            <col class="w-[15%]">
            <col class="w-[13%]">
          </colgroup>
          <thead class="bg-slate-100">
            <tr>
              <th scope="col" class="px-8 py-4 text-left text-[11px] font-semibold uppercase tracking-[0.1em] text-slate-600">Reference / Status</th>
              <th scope="col" class="px-8 py-4 text-left text-[11px] font-semibold uppercase tracking-[0.1em] text-slate-600">Guest</th>
              <th scope="col" class="px-8 py-4 text-left text-[11px] font-semibold uppercase tracking-[0.1em] text-slate-600">Stay Dates</th>
              <th scope="col" class="px-8 py-4 text-left text-[11px] font-semibold uppercase tracking-[0.1em] text-slate-600">Created</th>
              <th scope="col" class="px-8 py-4 text-left text-[11px] font-semibold uppercase tracking-[0.1em] text-slate-600">Amount</th>
              <th scope="col" class="px-8 py-4 text-right text-[11px] font-semibold uppercase tracking-[0.1em] text-slate-600">Action</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-200 bg-white">
            <% if @bookings.any? %>
              <% @bookings.each_with_index do |booking, index| %>
                <tr class="align-top transition-colors hover:bg-slate-100/80 <%= index.even? ? 'bg-white' : 'bg-slate-50/55' %>">
                  <td class="px-8 py-5">
                    <div class="flex flex-col gap-2">
                      <span class="text-sm font-mono font-semibold text-slate-900"><%= booking.confirmation_token %></span>
                      <%
                        status_class = case booking.status
                        when "confirmed" then "border-emerald-200 bg-emerald-50 text-emerald-700"
                        when "cancelled" then "border-red-200 bg-red-50 text-red-700"
                        when "pending" then "border-amber-200 bg-amber-50 text-amber-700"
                        else "border-slate-200 bg-slate-50 text-slate-700"
                        end
                      %>
                      <span class="inline-flex w-fit items-center rounded-full border px-2 py-0.5 text-[10px] font-bold <%= status_class %>">
                        <%= booking.status.upcase %>
                      </span>
                    </div>
                  </td>
                  <td class="px-8 py-5">
                    <div class="flex flex-col gap-1">
                      <span class="text-sm font-semibold text-slate-900"><%= booking.guest_name %></span>
                      <span class="text-xs text-slate-500"><%= booking.guest_email %></span>
                      <span class="text-xs text-slate-500 font-mono"><%= booking.guest_phone %></span>
                    </div>
                  </td>
                  <td class="px-8 py-5 whitespace-nowrap">
                    <div class="flex flex-col gap-0.5">
                      <span class="text-sm font-medium text-slate-900"><%= booking.check_in.strftime("%d %b %Y") %></span>
                      <span class="text-xs text-slate-500">to <%= booking.check_out.strftime("%d %b %Y") %></span>
                    </div>
                  </td>
                  <td class="px-8 py-5 whitespace-nowrap text-sm text-slate-600 font-medium">
                    <%= booking.created_at.strftime("%d %b %Y") %>
                  </td>
                  <td class="px-8 py-5 whitespace-nowrap">
                    <span class="text-sm font-bold text-slate-900"><%= booking.currency %> <%= number_with_precision(booking.total_amount, precision: 2) %></span>
                  </td>
                  <td class="px-8 py-5 text-right whitespace-nowrap">
                    <%= link_to hotel_booking_path(current_hotel, booking), class: "inline-flex items-center rounded-lg border border-slate-200 bg-white px-3 py-1.5 text-xs font-semibold text-slate-700 shadow-sm transition hover:border-slate-900 hover:bg-slate-50", data: { turbo_frame: "_top" } do %>
                      View Details
                    <% end %>
                  </td>
                </tr>
              <% end %>
            <% else %>
              <tr>
                <td colspan="6" class="px-8 py-20 text-center">
                  <p class="text-sm font-medium text-slate-500">No bookings found matching your criteria.</p>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>

      <!-- Mobile View -->
      <div class="space-y-4 p-5 lg:hidden">
        <% if @bookings.any? %>
          <% @bookings.each do |booking| %>
            <div class="rounded-2xl border border-slate-200 bg-slate-50/60 p-5 shadow-sm">
              <div class="flex items-start justify-between gap-3">
                <div>
                  <p class="text-xs font-semibold uppercase tracking-[0.08em] text-slate-500">Reference</p>
                  <p class="mt-1 text-sm font-mono font-semibold text-slate-900"><%= booking.confirmation_token %></p>
                </div>
                <%
                  status_class = case booking.status
                  when "confirmed" then "border-emerald-200 bg-emerald-50 text-emerald-700"
                  when "cancelled" then "border-red-200 bg-red-50 text-red-700"
                  when "pending" then "border-amber-200 bg-amber-50 text-amber-700"
                  else "border-slate-200 bg-slate-50 text-slate-700"
                  end
                %>
                <span class="inline-flex items-center rounded-full border px-2 py-1 text-[10px] font-bold <%= status_class %>">
                  <%= booking.status.upcase %>
                </span>
              </div>

              <dl class="mt-4 space-y-3 text-sm">
                <div>
                  <dt class="text-xs font-semibold uppercase tracking-[0.08em] text-slate-500">Guest</dt>
                  <dd class="mt-1 font-bold text-slate-900"><%= booking.guest_name %></dd>
                  <dd class="text-xs text-slate-500"><%= booking.guest_email %></dd>
                </div>
                <div class="flex justify-between gap-4">
                  <div>
                    <dt class="text-xs font-semibold uppercase tracking-[0.08em] text-slate-500">Stay Dates</dt>
                    <dd class="mt-1 text-slate-700 font-medium"><%= booking.check_in.strftime("%d %b") %> – <%= booking.check_out.strftime("%d %b %Y") %></dd>
                  </div>
                  <div class="text-right">
                    <dt class="text-xs font-semibold uppercase tracking-[0.08em] text-slate-500">Amount</dt>
                    <dd class="mt-1 text-slate-900 font-black"><%= booking.currency %> <%= number_with_precision(booking.total_amount, precision: 2) %></dd>
                  </div>
                </div>
              </dl>

              <div class="mt-5 flex justify-end">
                <%= link_to hotel_booking_path(current_hotel, booking), class: "inline-flex items-center rounded-lg border border-slate-200 bg-white px-3 py-1.5 text-xs font-semibold text-slate-700 shadow-sm transition hover:border-slate-900 hover:bg-slate-50", data: { turbo_frame: "_top" } do %>
                  View Details
                <% end %>
              </div>
            </div>
          <% end %>
        <% else %>
          <div class="rounded-2xl border border-dashed border-slate-300 bg-white px-5 py-12 text-center shadow-sm">
            <p class="text-sm font-medium text-slate-500">No bookings found.</p>
          </div>
        <% end %>
      </div>

      <!-- Pagination/Summary Footer -->
      <div class="px-8 py-5 border-t border-slate-200 bg-slate-50/50">
        <p class="text-xs font-bold text-slate-500 uppercase tracking-wider italic">Showing <%= pluralize(@bookings.count, "reservation") %></p>
      </div>
    <% end %>
  </div>
</div>
