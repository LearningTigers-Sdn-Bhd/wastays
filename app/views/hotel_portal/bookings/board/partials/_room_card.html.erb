<%# app/views/hotel_portal/bookings/board/partials/_room_card.html.erb %>
<%
  bookings = room[:blocks].select { |b| b[:type] == "booking" }
  status_blocks = room[:blocks].select { |b| b[:type] == "room_status" }

  top_bar_color = if status_blocks.any?
    "bg-rose-500" # Not Ready / Blocked
  elsif bookings.any?
    first_booking = bookings.first
    case first_booking[:status].to_s
    when "pending" then "bg-amber-500"
    when "confirmed" then "bg-blue-500"
    when "checked_in" then "bg-violet-500"
    when "checkout_required" then "bg-rose-500"
    when "completed" then "bg-emerald-500"
    when "no_show" then "bg-rose-500"
    else "bg-sky-500"
    end
  else
    "bg-emerald-500" # Available (Green)
  end
%>

<div class="flex flex-col rounded-xl border border-slate-200 bg-white shadow-sm hover:shadow-md transition-shadow overflow-hidden" data-room-number="<%= room[:room_number] %>">
  <div class="h-1.5 w-full <%= top_bar_color %>"></div>
  <div class="p-3.5 flex-1 flex flex-col justify-between">
    <!-- Room Header -->
    <div class="flex items-center justify-between border-b border-slate-100 pb-2">
      <div>
        <h3 class="text-sm font-black text-slate-900 leading-none">Room <%= room[:room_number] %></h3>
      </div>
      
      <div class="flex items-center gap-1.5">
        <!-- Smoking Icon -->
        <% smoking_label = room_type.smoking_allowed ? "Smoking Allowed" : "No Smoking" %>
        <% smoking_color = room_type.smoking_allowed ? "text-emerald-500 bg-emerald-50 border-emerald-100" : "text-slate-400 bg-slate-50 border-slate-100" %>
        <div data-controller="floating" data-floating-trigger-value="hover" data-floating-placement-value="top" class="inline-flex">
          <div data-floating-target="reference" class="p-1 rounded border <%= smoking_color %> cursor-help">
            <% if room_type.smoking_allowed %>
              <%= cached_icon "alarm-smoke", stroke_width: 2.25, class: "size-3.5" %>
            <% else %>
              <%= cached_icon "ban", stroke_width: 2.25, class: "size-3.5" %>
            <% end %>
          </div>
          <div data-floating-target="floating" class="hidden z-[100] px-2 py-1 bg-slate-900 rounded shadow-xl pointer-events-none text-white text-[10px] font-bold uppercase tracking-wider">
            <%= smoking_label %>
          </div>
        </div>

        <!-- Pets Icon -->
        <% pets_label = room_type.pets_allowed ? "Pets Allowed" : "No Pets" %>
        <% pets_color = room_type.pets_allowed ? "text-emerald-500 bg-emerald-50 border-emerald-100" : "text-slate-400 bg-slate-50 border-slate-100" %>
        <div data-controller="floating" data-floating-trigger-value="hover" data-floating-placement-value="top" class="inline-flex">
          <div data-floating-target="reference" class="p-1 rounded border <%= pets_color %> cursor-help">
            <% if room_type.pets_allowed %>
              <%= cached_icon "paw-print", stroke_width: 2.25, class: "size-3.5" %>
            <% else %>
              <%= cached_icon "ban", stroke_width: 2.25, class: "size-3.5" %>
            <% end %>
          </div>
          <div data-floating-target="floating" class="hidden z-[100] px-2 py-1 bg-slate-900 rounded shadow-xl pointer-events-none text-white text-[10px] font-bold uppercase tracking-wider">
            <%= pets_label %>
          </div>
        </div>
      </div>
    </div>

    <!-- Room Status Blocks (e.g. Out of Service) -->
    <% if status_blocks.any? %>
      <div class="mt-2 space-y-1.5">
        <% status_blocks.each do |sb| %>
          <div class="rounded-lg border border-rose-200 bg-rose-50/50 p-2 flex items-center gap-1.5 text-rose-700">
            <%= cached_icon "ban", stroke_width: 2.25, class: "size-3.5 shrink-0" %>
            <div class="min-w-0">
              <p class="text-[11px] font-bold leading-none"><%= sb[:status_name] %></p>
              <p class="mt-0.5 text-[9px] opacity-75 font-semibold leading-none">Blocked</p>
            </div>
          </div>
        <% end %>
      </div>
    <% end %>

    <!-- Bookings List -->
    <div class="mt-2.5 flex-1 flex flex-col justify-between">
      <div class="space-y-2">
        <h4 class="text-[9px] font-bold uppercase tracking-wider text-slate-400">Scheduled</h4>
        <% if bookings.blank? %>
          <div class="flex flex-col items-center justify-center py-4 px-2 rounded-lg border border-dashed border-slate-200 text-center">
            <p class="text-[10px] font-semibold text-slate-400">No bookings</p>
          </div>
        <% else %>
          <div class="space-y-2">
            <% bookings.each do |block| %>
              <%
                block_label = "#{block[:guest_name]}, #{block[:status].humanize}, room #{block[:room_number]}, #{block[:check_in].strftime('%B %-d')} to #{block[:check_out].strftime('%B %-d, %Y')}"
              %>
              <% if can_manage_bookings %>
                <div
                  role="button"
                  tabindex="0"
                  aria-label="<%= block_label %>"
                  data-id="<%= block[:id] %>"
                  data-controller="booking-actions"
                  data-booking-actions-id-value="<%= block[:id] %>"
                  data-booking-actions-status-value="<%= block[:status] %>"
                  data-booking-actions-check-in-value="<%= block[:check_in] %>"
                  data-booking-actions-check-out-value="<%= block[:check_out] %>"
                  data-booking-actions-guest-name-value="<%= block[:guest_name] %>"
                  data-booking-actions-date-range-value="<%= block[:check_in].strftime("%b %-d") %> — <%= block[:check_out].strftime("%b %-d, %Y") %>"
                  data-booking-actions-source-value="<%= block[:source] %>"
                  data-booking-actions-payment-status-value="<%= block[:payment_status] %>"
                  data-booking-actions-notes-value="<%= block[:notes] %>"
                  data-action="click->booking-actions#openBookingSheet keydown.enter->booking-actions#openBookingSheet keydown.space->booking-actions#openBookingSheet"
                  class="block w-full text-left rounded-lg border p-2 hover:shadow-sm transition <%= booking_block_status_classes(block, booking_styles) %> cursor-pointer focus:outline-none focus:ring-1 focus:ring-slate-900 focus:ring-offset-1"
                >
                  <%= render "hotel_portal/bookings/board/partials/room_card_booking_content", block: block %>
                </div>
              <% else %>
                <%= link_to hotel_booking_path(current_hotel, block[:booking]),
                    aria: { label: block_label },
                    class: "block w-full text-left rounded-lg border p-2 hover:shadow-sm transition #{booking_block_status_classes(block, booking_styles)} focus:outline-none focus:ring-1 focus:ring-slate-900 focus:ring-offset-1",
                    data: { turbo_frame: "_top" } do %>
                  <%= render "hotel_portal/bookings/board/partials/room_card_booking_content", block: block %>
                <% end %>
              <% end %>
            <% end %>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</div>
