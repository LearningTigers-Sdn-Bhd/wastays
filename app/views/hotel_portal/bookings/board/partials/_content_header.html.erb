<%# app/views/hotel_portal/bookings/board/partials/_content_header.html.erb %>
<div class="px-6 py-4 bg-white border-b border-slate-200 shrink-0">
  <div class="max-w-[1000px] mx-auto flex items-center justify-between">
    <div class="flex items-center gap-4">
      <div class="size-11 rounded-xl bg-slate-50 border border-slate-100 flex items-center justify-center text-slate-900 shadow-sm">
        <%= icon.html_safe %>
      </div>
      <div>
        <div class="flex items-center gap-2">
          <h3 class="text-lg font-black tracking-tight text-slate-900 uppercase"><%= title %></h3>
          <% if local_assigns[:status_badge] %>
            <%= status_badge %>
          <% end %>
        </div>
        <p class="text-[10px] font-bold text-slate-500 uppercase tracking-widest"><%= subtitle %></p>
      </div>
    </div>
    <div class="flex items-center gap-3">
      <% if local_assigns[:actions] %>
        <%= actions %>
      <% end %>

      <button type="button" data-action="click->offcanvas#close" class="p-2 rounded-xl text-slate-400 hover:bg-slate-100 hover:text-slate-600 transition-all">
        <%= cached_icon "x", stroke_width: 2.5, class: "size-5" %>
      </button>
    </div>
  </div>
</div>
