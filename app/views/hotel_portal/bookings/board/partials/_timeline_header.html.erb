<%# app/views/hotel_portal/bookings/board/partials/_timeline_header.html.erb %>
<div class="sticky top-0 z-30 grid border-b border-border bg-card/95 backdrop-blur-sm" style="grid-template-columns: <%= grid_template_columns %>;">
  <div class="sticky left-0 z-40 border-r border-border bg-card/95 shadow-[4px_0_12px_rgba(0,0,0,0.03)] <%= card_padding %> flex items-center">
    <span class="text-[10px] font-black uppercase tracking-[0.15em] text-muted-foreground">Room Details</span>
  </div>
  <% board_dates.each do |date| %>
    <div class="flex flex-col items-center justify-center border-l border-border <%= summary_padding %> <%= date == Date.current ? 'bg-muted' : '' %>">
      <span class="text-[10px] font-black uppercase tracking-[0.15em] <%= date == Date.current ? 'text-violet-600' : 'text-muted-foreground' %>"><%= date.strftime("%a") %></span>
      <span class="text-sm font-black <%= date == Date.current ? 'text-violet-700' : 'text-foreground' %>"><%= date.day %></span>
    </div>
  <% end %>
</div>
