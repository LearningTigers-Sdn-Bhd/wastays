<%# locals: (block:, block_index:, visible_start_date:, visible_end_exclusive:, block_left_pad:, block_top:, block_step:, current_hotel:, can_manage_bookings:, board_view_type:) %>
<% if can_manage_bookings %>
  <div
    role="button"
    tabindex="0"
    aria-label="<%= booking_block_accessibility_label(block) %>"
    draggable="true"
    data-id="<%= block[:id] %>"
    data-controller="booking-actions floating"
    data-floating-trigger-value="hover"
    data-floating-placement-value="top"
    data-booking-actions-id-value="<%= block[:id] %>"
    data-booking-actions-status-value="<%= block[:status] %>"
    data-booking-actions-check-in-value="<%= block[:check_in] %>"
    data-booking-actions-check-out-value="<%= block[:check_out] %>"
    data-booking-actions-guest-name-value="<%= block[:guest_name] %>"
    data-booking-actions-date-range-value="<%= block[:check_in].strftime("%b %-d") %> — <%= block[:check_out].strftime("%b %-d, %Y") %>"
    data-booking-actions-source-value="<%= block[:source] %>"
    data-booking-actions-payment-status-value="<%= block[:payment_status] %>"
    data-booking-actions-notes-value="<%= block[:notes] %>"
    data-action="click->booking-actions#openBookingSheet keydown.enter->booking-actions#openBookingSheet keydown.space->booking-actions#openBookingSheet dragstart->booking-timeline#onDragStart dragend->booking-timeline#onDragEnd"
    class="<%= booking_block_classes(block, board_view_type, visible_start_date, visible_end_exclusive) %>"
    style="<%= booking_block_style_attributes(block, visible_start_date, visible_end_exclusive, block_left_pad, block_top, block_index, block_step) %>"
    data-floating-target="reference"
  >
    <%= render "hotel_portal/bookings/board/partials/booking_block_content",
      block: block,
      can_manage_bookings: can_manage_bookings,
      clipped_left: booking_clipped_left?(block, visible_start_date),
      clipped_right: booking_clipped_right?(block, visible_end_exclusive),
      view_type: board_view_type %>
  </div>
<% else %>
  <%= link_to hotel_booking_control_panel_path(current_hotel, block[:booking], tab: "booking_details"),
      aria: { label: booking_block_accessibility_label(block) },
      class: booking_block_classes(block, board_view_type, visible_start_date, visible_end_exclusive),
      style: booking_block_style_attributes(block, visible_start_date, visible_end_exclusive, block_left_pad, block_top, block_index, block_step),
      data: { turbo_frame: "_top" } do %>
    <%= render "hotel_portal/bookings/board/partials/booking_block_content",
      block: block,
      can_manage_bookings: can_manage_bookings,
      clipped_left: booking_clipped_left?(block, visible_start_date),
      clipped_right: booking_clipped_right?(block, visible_end_exclusive),
      view_type: board_view_type %>
  <% end %>
<% end %>
