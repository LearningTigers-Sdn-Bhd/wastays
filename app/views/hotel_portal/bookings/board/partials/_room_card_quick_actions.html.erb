<%# locals: (room_type:, room:, visible_start_date:, hotel_today:, current_hotel:) %>
<div class="flex flex-col gap-0.5 w-full max-w-[120px]">
  <% room_card_action_items(visible_start_date, hotel_today, current_hotel, room_type, room).each do |action| %>
    <%= link_to action[:path],
                class: "w-full py-0.5 rounded bg-white shadow-sm border border-slate-200 text-[10px] font-bold text-slate-600 hover:bg-slate-50 flex items-center justify-center gap-0.5 transition active:scale-95",
                data: { turbo_frame: "offcanvas_drawer", offcanvas_variant: "fullscreen-bottom" } do %>
      <%= cached_icon action[:icon], stroke_width: 2.5, class: "size-2.5 #{action[:icon_color]}" %>
      <span><%= action[:label] %></span>
    <% end %>
  <% end %>
</div>
