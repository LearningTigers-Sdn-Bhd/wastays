<%# locals: (block:) %>
<div class="flex flex-col min-w-0">
  <div class="flex items-start justify-between gap-1.5">
    <p class="truncate font-black text-xs text-slate-800 leading-tight">
      <%= block[:guest_name] %>
    </p>
  </div>

  <div class="mt-0.5 flex items-start justify-between text-[9px] font-semibold text-slate-500">
    <div class="flex flex-col min-w-0">
      <div class="flex items-center gap-1">
        <span><%= block[:check_in].strftime("%b %-d") %> → <%= block[:check_out].strftime("%b %-d") %></span>
      </div>
      <% booking = block[:booking] %>
      <% if booking %>
        <% primary_booking_guest = booking.booking_guests.find(&:primary?) || booking.booking_guests.first %>
        <% if primary_booking_guest %>
          <% checked_in_states = %w[checked_in review_due_out checkout_required completed] %>
          <% timezone = (defined?(current_user) && current_user&.time_zone) || booking.hotel.hotel_time_zone %>
          <% if checked_in_states.include?(booking.status) %>
            <% if primary_booking_guest.boat_out_at.present? %>
              <div class="flex items-center gap-1 text-[8px] text-purple-600 font-bold mt-0.5" title="Boat Departure Time">
                <%= cached_icon "ship", stroke_width: 2.5, class: "size-2.5" %>
                <span>Boat Departure: <%= primary_booking_guest.boat_out_at.in_time_zone(timezone).strftime("%H:%M") %></span>
              </div>
            <% end %>
          <% else %>
            <% if primary_booking_guest.boat_in_at.present? %>
              <div class="flex items-center gap-1 text-[8px] text-blue-600 font-bold mt-0.5" title="Boat Arrival Time">
                <%= cached_icon "ship", stroke_width: 2.5, class: "size-2.5" %>
                <span>Boat Arrival: <%= primary_booking_guest.boat_in_at.in_time_zone(timezone).strftime("%H:%M") %></span>
              </div>
            <% end %>
          <% end %>
        <% end %>
      <% end %>
    </div>
    <div class="flex items-center gap-1.5 text-slate-500 text-[9px] self-start mt-0.5">
      <% if booking %>
        <span class="inline-flex items-center gap-0.5" title="<%= pluralize(booking.adults, 'Adult') %>">
          <%= cached_icon "user", stroke_width: 2.5, class: "size-2.5 text-slate-400" %>
          <span class="font-bold text-slate-700 leading-none"><%= booking.adults %></span>
        </span>
        <span class="inline-flex items-center gap-0.5" title="<%= pluralize(booking.children.to_i, 'Child') %>">
          <%= cached_icon "baby", stroke_width: 2.5, class: "size-2.5 text-slate-400" %>
          <span class="font-bold text-slate-700 leading-none"><%= booking.children.to_i %></span>
        </span>
      <% end %>
    </div>
  </div>
</div>
