<%# locals: (block:) %>
<div class="flex flex-col min-w-0">
  <div class="flex items-start justify-between gap-1.5">
    <div class="flex items-center gap-x-1 min-w-0">
      <span class="truncate font-black text-xs text-slate-800 leading-tight">
        <%= block[:guest_name] %>
      </span>
      <% if block[:vip] %>
        <%= cached_icon "crown-simple", library: "phosphor", variant: "duotone", class: "size-3 text-amber-500 fill-amber-500 shrink-0" %>
      <% end %>
      <% if block[:blacklisted] %>
        <div class="relative size-3 flex items-center justify-center shrink-0">
          <%= cached_icon "user", library: "phosphor", variant: "light", class: "size-3 text-rose-600" %>
          <%= cached_icon "ban", class: "absolute inset-0 size-3 text-rose-600" %>
        </div>
      <% end %>
    </div>
  </div>

  <div class="mt-0.5 flex items-center justify-between text-[9px] font-semibold text-slate-500">
    <div class="flex items-center gap-1">
      <span><%= block[:check_in].strftime("%b %-d") %> → <%= block[:check_out].strftime("%b %-d") %></span>
    </div>
    <div class="flex items-center gap-1.5 text-slate-500 text-[9px]">
      <% booking = block[:booking] %>
      <% if booking %>
        <span class="inline-flex items-center gap-0.5" title="<%= pluralize(booking.adults, 'Adult') %>">
          <%= cached_icon "user", stroke_width: 2.5, class: "size-2.5 text-slate-400" %>
          <span class="font-bold text-slate-700 leading-none"><%= booking.adults %></span>
        </span>
        <span class="inline-flex items-center gap-0.5" title="<%= pluralize(booking.children.to_i, 'Child') %>">
          <%= cached_icon "baby", stroke_width: 2.5, class: "size-2.5 text-slate-400" %>
          <span class="font-bold text-slate-700 leading-none"><%= booking.children.to_i %></span>
        </span>
      <% end %>
    </div>
  </div>
</div>
