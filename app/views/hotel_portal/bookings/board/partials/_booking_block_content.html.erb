<%# locals: (block:, can_manage_bookings:, clipped_left:, clipped_right:, view_type:) %>
<% if can_manage_bookings %>
  <div class="absolute inset-y-0 left-0 w-4 cursor-grab bg-black/5 hover:bg-black/10 transition-colors flex items-center justify-center"
       data-action="mousedown->booking-timeline#onDragHandleMouseDown click->booking-timeline#onHandleClick"
       data-booking-timeline-target="dragHandle"
       aria-hidden="true">
    <div class="flex flex-col gap-0.5">
      <div class="size-0.5 rounded-full bg-black/40"></div>
      <div class="size-0.5 rounded-full bg-black/40"></div>
      <div class="size-0.5 rounded-full bg-black/40"></div>
    </div>
  </div>
<% end %>

<div class="flex flex-col items-center justify-center h-full py-1 overflow-hidden select-none <%= can_manage_bookings ? 'pl-5 pr-4' : 'px-2' %>">
  <span class="<%= booking_icon_class(block[:status]) %> shrink-0 mb-0.5">
    <%= cached_icon booking_status_icon(block[:status]), stroke_width: 3, class: "size-3" %>
  </span>
  <span class="text-[9px] font-black leading-none truncate max-w-full text-center w-full block"><%= block[:guest_name] %></span>
</div>

<% if can_manage_bookings %>
  <div class="absolute inset-y-0 right-0 w-4 cursor-ew-resize bg-black/5 hover:bg-black/10 transition-colors"
       data-action="mousedown->booking-timeline#onResizeStart click->booking-timeline#onHandleClick"
       data-booking-timeline-target="resizeHandle"
       aria-hidden="true"></div>
<% end %>

<div data-floating-target="floating" class="hidden z-[100] w-56 p-3 bg-slate-900 rounded-xl shadow-xl pointer-events-none text-left">
  <p class="text-sm font-bold text-white truncate"><%= block[:guest_name] %></p>
  <p class="text-[10px] text-slate-400 mt-1"><%= block[:check_in].strftime("%b %-d") %> → <%= block[:check_out].strftime("%b %-d, %Y") %></p>
  <div class="flex items-center gap-2 mt-1.5">
    <span class="text-[9px] font-bold text-slate-500 uppercase"><%= booking_source_name(block) %></span>
    <span class="text-[9px] font-bold uppercase <%= booking_payment_status_class(block[:payment_status]) %>"><%= block[:payment_status].humanize %></span>
  </div>
</div>
