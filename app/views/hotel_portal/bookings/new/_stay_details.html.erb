<div class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">
  <div class="border-b border-slate-200 bg-slate-50/70 px-6 py-4">
    <h3 class="text-sm font-bold text-slate-900">Stay Details</h3>
  </div>
  <div class="p-6 space-y-6">
    <div class="grid sm:grid-cols-2 gap-6">
      <div>
        <%= f.label :check_in, "Check-in Date", class: "block text-[11px] font-bold text-slate-500 uppercase tracking-wider mb-2" %>
        <%= f.date_field :check_in, required: true, class: "w-full rounded-xl border border-slate-200 bg-white px-4 py-2.5 text-sm font-medium text-slate-700 focus:border-slate-300 focus:outline-none focus:ring-0 shadow-sm", data: { booking_calc_target: "checkIn", action: "change->booking-calc#calculate" } %>
      </div>
      <div>
        <%= f.label :check_out, "Check-out Date", class: "block text-[11px] font-bold text-slate-500 uppercase tracking-wider mb-2" %>
        <%= f.date_field :check_out, required: true, class: "w-full rounded-xl border border-slate-200 bg-white px-4 py-2.5 text-sm font-medium text-slate-700 focus:border-slate-300 focus:outline-none focus:ring-0 shadow-sm", data: { booking_calc_target: "checkOut", action: "change->booking-calc#calculate" } %>
      </div>
    </div>

    <div class="grid sm:grid-cols-2 gap-6">
      <div>
        <%= f.label :adults, class: "block text-[11px] font-bold text-slate-500 uppercase tracking-wider mb-2" %>
        <%= f.number_field :adults, required: true, min: 1, class: "w-full rounded-xl border border-slate-200 bg-white px-4 py-2.5 text-sm font-medium text-slate-700 focus:border-slate-300 focus:outline-none focus:ring-0 shadow-sm" %>
      </div>
      <div>
        <%= f.label :children, class: "block text-[11px] font-bold text-slate-500 uppercase tracking-wider mb-2" %>
        <%= f.number_field :children, required: true, min: 0, class: "w-full rounded-xl border border-slate-200 bg-white px-4 py-2.5 text-sm font-medium text-slate-700 focus:border-slate-300 focus:outline-none focus:ring-0 shadow-sm" %>
      </div>
    </div>

    <div>
      <%= f.label :source, "Booking Source", class: "block text-[11px] font-bold text-slate-500 uppercase tracking-wider mb-2" %>
      <%= f.select :source, [["Phone", "phone"], ["Walk-in", "walk_in"], ["Email", "email"], ["WhatsApp", "whatsapp"], ["Other", "internal"]], { selected: "phone" },
          { class: "w-full rounded-xl border border-slate-200 bg-white px-4 py-2.5 text-sm font-medium text-slate-700 focus:border-slate-300 focus:outline-none focus:ring-0 shadow-sm" } %>
    </div>

    <div>
      <%= f.label :internal_notes, "Internal Notes", class: "block text-[11px] font-bold text-slate-500 uppercase tracking-wider mb-2" %>
      <%= f.text_area :internal_notes, rows: 4, placeholder: "Special requests...", class: "w-full resize-y rounded-xl border border-slate-200 bg-white px-4 py-2.5 text-sm font-medium text-slate-700 focus:border-slate-300 focus:outline-none focus:ring-0 shadow-sm" %>
    </div>
  </div>
</div>
