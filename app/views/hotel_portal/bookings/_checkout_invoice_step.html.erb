<% folio = booking.booking_folio %>
<% currency = booking.currency.presence || "MYR" %>

<div class="flex h-full flex-col bg-slate-50/50">
  <div class="sticky top-0 z-10 border-b border-slate-200 bg-white px-6 py-4">
    <div class="flex flex-col gap-4 lg:flex-row lg:items-center lg:justify-between">
      <div>
        <p class="text-xs font-black uppercase tracking-[0.24em] text-emerald-600">Step 2 of 2</p>
        <h2 class="mt-1 text-2xl font-black tracking-tight text-slate-950">Checkout Complete</h2>
        <p class="mt-1 text-sm font-semibold text-slate-500">Invoice <%= booking.formatted_invoice_number || folio&.invoice_number || booking.confirmation_token %> is ready for <%= booking.guest_name %>.</p>
      </div>
      <div class="flex items-center gap-3">
        <%= link_to folio_invoice_hotel_booking_path(hotel, booking, format: :pdf), target: "_blank", class: "inline-flex items-center rounded-xl bg-slate-900 px-5 py-3 text-sm font-black text-white shadow-sm transition hover:bg-slate-700" do %>
          <%= lucide_icon "download", stroke_width: 2.5, class: "mr-2 size-4" %>
          Download as PDF
        <% end %>
        <button type="button" class="rounded-xl border border-slate-200 bg-white px-5 py-3 text-sm font-bold text-slate-700 shadow-sm transition hover:bg-slate-50" data-action="click->offcanvas#close">Close</button>
      </div>
    </div>
  </div>

  <div class="min-h-0 flex-1 overflow-y-auto p-4 sm:p-6 lg:p-8">
    <div class="mx-auto max-w-[1200px] space-y-6">
      <div class="overflow-hidden rounded-3xl border border-slate-200 bg-white shadow-sm">
        <div class="bg-slate-950 px-8 py-8 text-white">
          <div class="flex flex-col gap-6 md:flex-row md:items-end md:justify-between">
            <div>
              <p class="text-[11px] font-black uppercase tracking-[0.24em] text-slate-400">Folio Invoice</p>
              <h3 class="mt-3 text-4xl font-black tracking-tight"><%= booking.formatted_invoice_number || folio&.invoice_number || "Pending" %></h3>
            </div>
            <div class="text-left md:text-right">
              <p class="text-sm font-bold text-slate-300"><%= hotel.name %></p>
              <p class="mt-1 text-xs font-semibold uppercase tracking-wider text-slate-500"><%= Time.current.strftime("%d %b %Y, %I:%M %p") %></p>
            </div>
          </div>
        </div>

        <div class="grid gap-0 md:grid-cols-3">
          <div class="border-b border-slate-200 p-6 md:border-b-0 md:border-r">
            <p class="text-[10px] font-black uppercase tracking-widest text-slate-400">Guest</p>
            <p class="mt-2 text-lg font-black text-slate-950"><%= booking.guest_name %></p>
            <p class="mt-1 text-sm font-semibold text-slate-500"><%= booking.confirmation_token %></p>
          </div>
          <div class="border-b border-slate-200 p-6 md:border-b-0 md:border-r">
            <p class="text-[10px] font-black uppercase tracking-widest text-slate-400">Stay</p>
            <p class="mt-2 text-lg font-black text-slate-950"><%= booking.check_in.strftime("%d %b") %> - <%= booking.check_out.strftime("%d %b %Y") %></p>
            <p class="mt-1 text-sm font-semibold text-slate-500"><%= pluralize((booking.check_out - booking.check_in).to_i, "night") %></p>
          </div>
          <div class="p-6">
            <p class="text-[10px] font-black uppercase tracking-widest text-slate-400">Final Balance</p>
            <p class="mt-2 text-lg font-black text-emerald-700"><%= currency %> <%= number_with_precision(folio&.outstanding_balance || 0, precision: 2) %></p>
            <p class="mt-1 text-sm font-semibold text-slate-500"><%= folio&.status&.humanize || "Closed" %></p>
          </div>
        </div>
      </div>

      <%= render "hotel_portal/bookings/folio_transaction_table", booking: booking %>
    </div>
  </div>
</div>
