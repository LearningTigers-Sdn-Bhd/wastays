<div class="space-y-4"><div class="rounded-lg border border-amber-200 bg-amber-50 p-4"><p class="text-xs font-black uppercase tracking-wider text-amber-700">Existing charge impact</p><p class="mt-1 text-2xl font-black text-amber-950"><%= presenter.routing_preview&.count.to_i %> transactions · <%= presenter.money(presenter.routing_preview&.amount || 0) %></p></div><% if presenter.selected_routing_rule %><%= form_with url: apply_routing_hotel_booking_workspace_path(current_hotel, booking), method: :post, class: "space-y-3" do %><%= hidden_field_tag :folio_routing_rule_id, presenter.selected_routing_rule.id %><label class="flex gap-3 rounded-lg border border-blue-200 bg-blue-50 p-3 text-sm"><%= radio_button_tag :confirmation, "existing_and_future", true %><span><strong>Existing eligible and future</strong><span class="block text-xs text-muted-foreground">Selected by default; confirmation is still required.</span></span></label><label class="flex gap-3 rounded-lg border border-border p-3 text-sm"><%= radio_button_tag :confirmation, "future_only", false %><span><strong>Future only</strong><span class="block text-xs text-muted-foreground">Leaves posted transactions where they are.</span></span></label><div><%= label_tag :reason, "Reason", class: "mb-1 block text-xs font-bold text-muted-foreground" %><%= text_field_tag :reason, nil, required: true, class: "w-full rounded-lg border-border text-sm" %></div><%= submit_tag "Confirm routing change", class: "w-full rounded-lg bg-primary px-4 py-2.5 text-sm font-bold text-primary-foreground" %><% end %><% end %></div>
