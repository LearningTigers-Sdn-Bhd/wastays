<div class="space-y-4">
  <p class="text-sm text-muted-foreground">Room changes apply only to <strong>Booking No. <%= booking.formatted_reservation_number.presence || "—" %></strong>. Sibling bookings are not changed.</p>
  <div class="rounded-lg border border-border bg-muted p-3 text-sm"><span class="text-muted-foreground">Current room</span><p class="mt-1 font-bold text-foreground"><%= booking.booking_rooms.first&.room_number.presence || "Unassigned" %> · <%= booking.booking_rooms.first&.room_type&.name || "Room type unavailable" %></p></div>
  <%= link_to "Open room assignment", hotel_booking_action_edit_room_path(current_hotel, booking, return_to: request.fullpath), data: { turbo_frame: "booking_action_sheet" }, class: "block rounded-lg bg-primary px-4 py-2.5 text-center text-sm font-semibold text-primary-foreground hover:bg-primary-hover" %>
</div>
