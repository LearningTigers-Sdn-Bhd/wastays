<section class="rounded-xl border border-border bg-card p-4 shadow-sm">
  <h2 class="text-sm font-black uppercase tracking-[0.18em] text-muted-foreground"><%= presenter.active_tab_label %></h2>
  <dl class="mt-4 space-y-3 text-sm">
    <div>
      <dt class="text-[11px] font-black uppercase tracking-wider text-muted-foreground">Booking</dt>
      <dd class="mt-1 font-bold text-foreground"><%= presenter.booking_number %></dd>
    </div>
    <div>
      <dt class="text-[11px] font-black uppercase tracking-wider text-muted-foreground">Active Folio</dt>
      <dd class="mt-1 font-bold text-foreground"><%= presenter.selected_folio&.display_name || "No folio" %></dd>
    </div>
    <div>
      <dt class="text-[11px] font-black uppercase tracking-wider text-muted-foreground">Total Balance</dt>
      <dd class="mt-1 font-bold text-foreground"><%= presenter.money(presenter.total_balance) %></dd>
    </div>
  </dl>
</section>
