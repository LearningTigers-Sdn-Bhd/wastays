<% if folio_show.can_manage_folio_windows? %>
  <% if folio.open? %>
    <% direct_bill_available = folio.payer_type == "company" && folio.hotel_corporate_account&.active? && folio.hotel_corporate_account&.direct_bill_enabled? && folio.outstanding_balance.to_d.positive? %>
    <% close_form_id = "close-folio-form-#{folio.id}" %>
    <%= render PanelsUI::Dialog.new(
          id: "close-workspace-folio-#{folio.id}",
          size: :sm,
          title: "Close #{folio.display_name}",
          description: direct_bill_available ? "Close this folio as Direct Bill and create an AR invoice." : "Only settled folios with no pending charges can be closed.") do |dialog| %>
      <% dialog.with_body do %>
        <%= form_with scope: :booking_folio, url: close_folio_window_hotel_booking_workspace_path(current_hotel, booking, folio), method: :post, id: close_form_id do |form| %>
          <%= form.hidden_field :settlement_method, value: "direct_bill" if direct_bill_available %>
          <%= render PanelsUI::FormField.new(form:, attribute: :reason, label: "Reason") do |field| %>
            <% field.with_input(placeholder: "Optional internal reason") %>
          <% end %>
        <% end %>
      <% end %>
      <% dialog.with_footer do %>
        <%= render PanelsUI::Button.new(as: :button, variant: :secondary, size: :sm, data: { action: "panels-ui--dialog#close" }) do %>Cancel<% end %>
        <%= render PanelsUI::Button.new(as: :button, type: :submit, form: close_form_id, variant: :primary, size: :sm) do %><%= direct_bill_available ? "Close as Direct Bill" : "Close Folio" %><% end %>
      <% end %>
    <% end %>
  <% elsif folio.closed? %>
    <% reopen_form_id = "reopen-folio-form-#{folio.id}" %>
    <%= render PanelsUI::Dialog.new(
          id: "reopen-workspace-folio-#{folio.id}",
          size: :sm,
          title: "Reopen #{folio.display_name}",
          description: "Reopening restores the folio to an editable state.") do |dialog| %>
      <% dialog.with_body do %>
        <%= form_with scope: :booking_folio, url: reopen_folio_window_hotel_booking_workspace_path(current_hotel, booking, folio), method: :post, id: reopen_form_id do |form| %>
          <%= render PanelsUI::FormField.new(form:, attribute: :reason, label: "Reason") do |field| %>
            <% field.with_input(placeholder: "Optional internal reason") %>
          <% end %>
        <% end %>
      <% end %>
      <% dialog.with_footer do %>
        <%= render PanelsUI::Button.new(as: :button, variant: :secondary, size: :sm, data: { action: "panels-ui--dialog#close" }) do %>Cancel<% end %>
        <%= render PanelsUI::Button.new(as: :button, type: :submit, form: reopen_form_id, variant: :primary, size: :sm) do %>Reopen Folio<% end %>
      <% end %>
    <% end %>
  <% end %>
<% end %>
