<% if folio_show.can_manage_folio_windows? %>
  <div class="flex flex-wrap items-center gap-2">
    <% if folio.open? %>
      <%= render PanelsUI::Button.new(
            href: edit_folio_window_hotel_booking_workspace_path(current_hotel, booking, folio),
            variant: :secondary,
            size: :sm,
            data: { turbo_frame: "offcanvas_drawer", offcanvas_variant: "right" }) do %>Edit<% end %>
      <%= render PanelsUI::Button.new(
            as: :button,
            variant: :secondary,
            size: :sm,
            command: "show-modal",
            commandfor: "close-workspace-folio-#{folio.id}") do %>Close<% end %>
    <% elsif folio.closed? %>
      <%= render PanelsUI::Button.new(
            as: :button,
            variant: :secondary,
            size: :sm,
            command: "show-modal",
            commandfor: "reopen-workspace-folio-#{folio.id}") do %>Reopen<% end %>
    <% end %>
  </div>
<% end %>
