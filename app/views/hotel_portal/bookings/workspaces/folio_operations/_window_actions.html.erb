<% if folio_show.can_manage_folio_windows? %>
  <div class="flex flex-wrap gap-2">
    <% if folio.open? %>
      <%= link_to "Edit", edit_folio_window_hotel_booking_workspace_path(current_hotel, booking, folio),
        data: { turbo_frame: "offcanvas_drawer", offcanvas_variant: "right" },
        class: "rounded-md border border-border-interactive bg-card px-3 py-2 text-sm font-semibold text-foreground hover:bg-muted" %>
      <button type="button" onclick="document.getElementById('close-workspace-folio-<%= folio.id %>').showModal()" class="rounded-md border border-border-interactive bg-card px-3 py-2 text-sm font-semibold text-foreground hover:bg-muted">Close</button>
    <% elsif folio.closed? %>
      <button type="button" onclick="document.getElementById('reopen-workspace-folio-<%= folio.id %>').showModal()" class="rounded-md border border-border-interactive bg-card px-3 py-2 text-sm font-semibold text-foreground hover:bg-muted">Reopen</button>
    <% end %>
  </div>
<% end %>
