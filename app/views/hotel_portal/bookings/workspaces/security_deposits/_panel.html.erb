<% if presenter.group_overview? %>
  <section aria-labelledby="security-deposits-heading">
    <header class="border-b border-border px-5 py-4">
      <p class="text-xs font-semibold text-muted-foreground">Booking No. <%= presenter.group_booking_number %></p>
      <h2 id="security-deposits-heading" class="mt-1 text-lg font-bold text-foreground">Security Deposits</h2>
      <p class="mt-1 text-sm text-muted-foreground">Booking-level refundable deposits across this group. Select a booking before collecting or releasing a deposit.</p>
    </header>
    <div class="overflow-x-auto">
      <table class="w-full min-w-[760px] text-left text-sm">
        <thead class="border-b border-border bg-muted text-xs font-semibold text-muted-foreground"><tr><th class="px-5 py-3">Booking No.</th><th class="px-5 py-3">Guest</th><th class="px-5 py-3">Room</th><th class="px-5 py-3">Status</th><th class="px-5 py-3 text-right">Held</th><th class="px-5 py-3 text-right">Records</th></tr></thead>
        <tbody class="divide-y divide-border">
          <% presenter.group_security_deposit_rows.each do |row| %>
            <tr><td class="px-5 py-3 font-semibold text-foreground"><%= row[:booking_number] %></td><td class="px-5 py-3 text-foreground"><%= row[:guest] %></td><td class="px-5 py-3 text-foreground"><%= row[:room] %></td><td class="px-5 py-3 text-foreground"><%= row[:status] %></td><td class="px-5 py-3 text-right font-semibold tabular-nums text-foreground"><%= row[:held] %></td><td class="px-5 py-3 text-right tabular-nums text-foreground"><%= row[:count] %></td></tr>
          <% end %>
        </tbody>
      </table>
    </div>
    <%= render "hotel_portal/bookings/workspaces/security_deposits/group_deposits", presenter: presenter %>
  </section>
<% else %>
  <% deposit_booking = presenter.security_deposit_booking %>
  <section aria-labelledby="security-deposits-heading">
    <header class="flex flex-col gap-3 border-b border-border px-5 py-4 sm:flex-row sm:items-start sm:justify-between">
      <div><p class="text-xs font-semibold text-muted-foreground">Booking No. <%= deposit_booking.formatted_reservation_number.presence || "—" %></p><h2 id="security-deposits-heading" class="mt-1 text-lg font-bold text-foreground">Security Deposits</h2><p class="mt-1 text-sm text-muted-foreground">Refundable security deposits for this booking.</p></div>
      <div class="text-left sm:text-right"><p class="text-xs font-semibold text-muted-foreground">Held Total</p><p class="mt-1 text-lg font-bold tabular-nums text-foreground"><%= presenter.money_for(deposit_booking, presenter.held_security_deposit_total) %></p><p class="text-xs text-muted-foreground"><%= presenter.security_deposit_status_label %></p></div>
    </header>

    <div class="overflow-x-auto">
      <table class="w-full min-w-[820px] text-left text-sm">
        <thead class="border-b border-border bg-muted text-xs font-semibold text-muted-foreground"><tr><th class="px-5 py-3">Amount</th><th class="px-5 py-3">Status</th><th class="px-5 py-3">Method</th><th class="px-5 py-3">Reference</th><th class="px-5 py-3">Collected</th><th class="px-5 py-3">Released</th><th class="px-5 py-3">Staff</th></tr></thead>
        <tbody class="divide-y divide-border">
          <% if presenter.security_deposit_rows.any? %>
            <% presenter.security_deposit_rows.each do |row| %>
              <tr><td class="px-5 py-3 font-semibold tabular-nums text-foreground"><%= row[:amount] %></td><td class="px-5 py-3 text-foreground"><%= row[:status] %></td><td class="px-5 py-3 text-foreground"><%= row[:method] %></td><td class="px-5 py-3 break-words text-foreground"><%= row[:reference] %></td><td class="px-5 py-3 whitespace-nowrap text-foreground"><%= row[:collected_at] %></td><td class="px-5 py-3 whitespace-nowrap text-foreground"><%= row[:released_at] %></td><td class="px-5 py-3 text-foreground"><%= row[:staff] %></td></tr>
            <% end %>
          <% else %>
            <tr><td colspan="7" class="px-5 py-10 text-center text-sm text-muted-foreground">No security deposits have been recorded. Use the form below to collect one.</td></tr>
          <% end %>
        </tbody>
      </table>
    </div>

    <div class="grid border-t border-border lg:grid-cols-2 lg:divide-x lg:divide-border">
      <section class="p-5" aria-labelledby="collect-deposit-heading">
        <h3 id="collect-deposit-heading" class="text-sm font-bold text-foreground">Collect Deposit</h3>
        <%= form_with url: collect_security_deposit_hotel_booking_workspace_path(current_hotel, deposit_booking), method: :post, class: "mt-4 grid gap-4 sm:grid-cols-2" do %>
          <div><%= label_tag :amount, "Amount", class: "mb-1.5 block text-xs font-semibold text-muted-foreground" %><%= number_field_tag :amount, nil, min: 0.01, step: 0.01, required: true, inputmode: "decimal", autocomplete: "off", class: "w-full rounded-md border border-border-interactive bg-card text-sm hover:border-border-interactive invalid:border-red-400 focus:border-blue-600 focus:ring-blue-600" %></div>
          <div><%= label_tag :payment_method, "Payment Method", class: "mb-1.5 block text-xs font-semibold text-muted-foreground" %><%= select_tag :payment_method, options_for_select(::Checkouts::PaymentMethods.release_options, "cash"), class: "w-full rounded-md border border-border-interactive bg-card text-sm hover:border-border-interactive focus:border-blue-600 focus:ring-blue-600" %></div>
          <div class="sm:col-span-2"><%= label_tag :external_reference, "Reference", class: "mb-1.5 block text-xs font-semibold text-muted-foreground" %><%= text_field_tag :external_reference, nil, autocomplete: "off", placeholder: "Receipt or transaction reference…", class: "w-full rounded-md border border-border-interactive bg-card text-sm hover:border-border-interactive focus:border-blue-600 focus:ring-blue-600" %></div>
          <div class="sm:col-span-2"><%= submit_tag "Collect Deposit", class: "rounded-md bg-primary px-4 py-2.5 text-sm font-semibold text-primary-foreground hover:bg-primary-hover focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-600 focus-visible:ring-offset-2" %></div>
        <% end %>
      </section>
      <section class="border-t border-border p-5 lg:border-t-0" aria-labelledby="release-deposit-heading">
        <h3 id="release-deposit-heading" class="text-sm font-bold text-foreground">Release Held Deposits</h3>
        <%= form_with url: release_security_deposits_hotel_booking_workspace_path(current_hotel, deposit_booking), method: :post, class: "mt-4 grid gap-4 sm:grid-cols-2" do %>
          <div><%= label_tag :method, "Release Method", class: "mb-1.5 block text-xs font-semibold text-muted-foreground" %><%= select_tag :method, options_for_select(::Checkouts::PaymentMethods.release_options, "cash"), class: "w-full rounded-md border border-border-interactive bg-card text-sm hover:border-border-interactive focus:border-blue-600 focus:ring-blue-600" %></div>
          <div><%= label_tag :reference, "Reference", class: "mb-1.5 block text-xs font-semibold text-muted-foreground" %><%= text_field_tag :reference, nil, autocomplete: "off", placeholder: "Release reference…", class: "w-full rounded-md border border-border-interactive bg-card text-sm hover:border-border-interactive focus:border-blue-600 focus:ring-blue-600" %></div>
          <div class="sm:col-span-2"><%= submit_tag "Release Held Deposits", class: "rounded-md bg-primary px-4 py-2.5 text-sm font-semibold text-primary-foreground hover:bg-primary-hover focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-600 focus-visible:ring-offset-2 disabled:cursor-not-allowed disabled:bg-muted disabled:text-muted-foreground", disabled: presenter.held_security_deposit_total.zero? %><% if presenter.held_security_deposit_total.zero? %><p class="mt-2 text-xs text-muted-foreground">No held deposit is available to release.</p><% end %></div>
        <% end %>
      </section>
    </div>
  </section>
<% end %>
