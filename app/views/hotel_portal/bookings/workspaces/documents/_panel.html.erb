<div id="documents-panel" tabindex="-1" aria-label="Booking documents" class="min-w-0 max-w-full overflow-hidden px-5 py-5" data-testid="booking-documents">
  <div class="min-w-0 max-w-full space-y-6" data-testid="document-section-grid">
    <% presenter.document_sections.each do |section| %>
      <section aria-labelledby="documents-<%= section.key %>-heading" class="min-w-0 space-y-3" data-document-section="<%= section.key %>">
        <div class="flex flex-wrap items-center justify-between gap-3">
          <h2 id="documents-<%= section.key %>-heading" class="text-base font-semibold text-foreground"><%= section.title %></h2>
          <% if section.key == :invoices && current_user.has_permission?("manage_bookings", hotel: current_hotel) %>
            <%= render "hotel_portal/bookings/shared/invoice_resend",
                       preview: @invoice_delivery_preview,
                       booking: booking,
                       dialog_id: "documents-tab-resend-dialog",
                       return_to: hotel_booking_workspace_path(current_hotel, booking, tab: "documents") %>
          <% end %>
        </div>

        <%= render PanelsUI::Table.new(
              caption: section.caption,
              density: :compact,
              hoverable: true,
              bordered: true,
              wrapper_class: "rounded-md border border-border",
              class: "table-fixed min-w-[760px] xl:min-w-0") do |table| %>
          <% table.with_header do %>
            <tr>
              <th scope="col" class="w-1/4"><%= section.primary_heading %></th>
              <th scope="col" class="w-40"><%= section.type_heading %></th>
              <th scope="col" class="w-1/4">Booking / room</th>
              <th scope="col" class="w-1/5"><%= section.party_heading %></th>
              <th scope="col" class="w-32">Issued</th>
              <% if section.amount_heading %>
                <th scope="col" class="w-32 text-right"><%= section.amount_heading %></th>
              <% end %>
              <th scope="col" class="w-20"><span class="sr-only">Actions</span></th>
            </tr>
          <% end %>
          <% table.with_body do %>
            <% if section.rows.any? %>
              <% section.rows.each do |document| %>
                <% badge_variant = case document.status
                   when "Finalized", "Issued", "Signed", "Available", "Paid" then :success
                   when "Under correction", "Partially paid", "Overdue", "Historical" then :warning
                   when "Voided", "Void" then :destructive
                   else :neutral
                   end %>
                <tr data-document-type="<%= document.type.parameterize %>">
                  <th scope="row" class="text-left font-normal">
                    <div class="min-w-0 space-y-1.5">
                      <span class="block truncate font-medium text-foreground"><%= document.number %></span>
                      <div class="flex min-w-0 items-center gap-1.5">
                        <%= render PanelsUI::Badge.new(label: document.status, variant: badge_variant, size: :sm) %>
                      </div>
                    </div>
                  </th>
                  <td><span class="line-clamp-2"><%= document.context_type %></span></td>
                  <td class="min-w-0" data-document-context>
                    <span class="block truncate text-foreground"><%= document.booking %></span>
                    <span class="mt-0.5 block truncate text-xs text-muted-foreground"><%= document.room %></span>
                  </td>
                  <td><span class="line-clamp-2"><%= document.payer %></span></td>
                  <td class="whitespace-nowrap">
                    <% if document.issued_at %>
                      <%= document.issued_at.in_time_zone(current_hotel.hotel_time_zone).strftime("%d %b %Y") %>
                    <% else %>
                      <span class="text-muted-foreground">—</span>
                    <% end %>
                  </td>
                  <% if section.amount_heading %>
                    <td class="whitespace-nowrap text-right tabular-nums">
                      <% if document.amount.present? %>
                        <% unless section.single_currency? %>
                          <span class="text-muted-foreground"><%= document.currency %></span>
                        <% end %>
                        <%= number_with_precision(document.amount, precision: 2, delimiter: ",") %>
                      <% else %>
                        <span class="text-muted-foreground">—</span>
                      <% end %>
                    </td>
                  <% end %>
                  <td>
                    <div class="flex justify-end">
                      <% if document.type == "Folio invoice" && (document.available? || document.history?) %>
                        <%= render PanelsUI::DropdownMenu.new(id: "document-actions-#{document.key}", placement: :bottom_end) do |menu| %>
                          <% menu.with_trigger(variant: :secondary, size: :sm, aria_label: "Actions for #{document.number}") do %>
                            Actions
                            <%= app_icon "chevron-down", class: "size-4", aria: { hidden: true } %>
                          <% end %>
                          <% if document.available? %>
                            <% menu.with_item(href: document.href, target: "_blank", data: { turbo: false }) { "Open current" } %>
                          <% end %>
                          <% if document.history? %>
                            <% menu.with_submenu(label: "History", id: "document-history-#{document.key}") do |history| %>
                              <% document.revision_actions.each do |revision| %>
                                <% history.with_item(href: revision[:href], target: "_blank", data: { turbo: false }) { revision[:label] } %>
                              <% end %>
                            <% end %>
                          <% end %>
                        <% end %>
                      <% elsif document.issue_required? %>
                        <%= form_with url: document.href, method: :post, data: { turbo: false }, html: { target: "_blank" } do %>
                          <%= render PanelsUI::Button.new(as: :button, type: :submit, variant: :secondary, size: :xs, aria: { label: "Issue #{document.type} for #{document.booking}" }) do %>
                            <%= app_icon "receipt", class: "size-4", aria: { hidden: true } %>
                            <span>Issue</span>
                          <% end %>
                        <% end %>
                      <% elsif document.available? %>
                        <%= render PanelsUI::Button.new(href: document.href, variant: :secondary, size: :xs, target: "_blank", data: { turbo: false }, aria: { label: "Open #{document.type} #{document.number}" }) do %>
                          <%= app_icon "external-link", class: "size-4", aria: { hidden: true } %>
                          <span>Open</span>
                        <% end %>
                      <% end %>
                    </div>
                  </td>
                </tr>
              <% end %>
            <% else %>
              <tr>
                <td colspan="<%= section.amount_heading ? 7 : 6 %>" class="py-10 text-center text-muted-foreground"><%= section.empty_message %></td>
              </tr>
            <% end %>
          <% end %>
        <% end %>
      </section>
    <% end %>

    <%# LHDN e-invoicing is a separate filing lifecycle from the folio documents
        above: each record has a status with the tax authority, not just a file. %>
    <% if current_hotel.e_invoice_setting&.enabled? %>
      <% e_invoice_submissions = booking.e_invoice_submissions.recent_first.to_a %>
      <% adjustment_preview = EInvoice::IssueAdjustment.preview(booking) %>
      <section aria-labelledby="documents-e-invoice-heading" class="min-w-0 space-y-3" data-document-section="e_invoice">
        <div class="flex flex-wrap items-center justify-between gap-3">
          <h2 id="documents-e-invoice-heading" class="text-base font-semibold text-foreground">E-Invoice</h2>
          <% if adjustment_preview.needed? && current_user.has_permission?("manage_bookings", hotel: current_hotel) %>
            <%= render PanelsUI::Button.new(
                  href: hotel_folio_action_issue_e_invoice_adjustment_path(current_hotel, booking, return_to: request.fullpath),
                  variant: :secondary,
                  size: :sm,
                  data: { turbo_frame: "folio_action_sheet" }) do %>
              <%= cached_icon "file-plus", class: "size-3.5", aria: { hidden: true } %>
              Issue adjustment note
            <% end %>
          <% end %>
        </div>

        <%# Nothing can be filed until we know who took the guest's money: it
            decides whether WAStays files as itself or on the hotel's behalf.
            Channel-manager bookings arrive without that answer. %>
        <% if booking.resolved_fund_collector == "unknown" && current_user.has_permission?("manage_bookings", hotel: current_hotel) %>
          <%= render PanelsUI::Alert.new(tone: :warning, title: "Confirm who received the guest payment") do |alert| %>
            <% alert.with_description do %>
              <p>This decides whether WAStays or the hotel issues the e-invoice. Nothing can be filed until it is set.</p>
              <%= form_with url: update_payment_receiver_hotel_e_invoice_submissions_path(current_hotel, booking_id: booking.id),
                    method: :patch,
                    scope: :booking,
                    class: "mt-3 flex flex-col gap-2 sm:flex-row sm:items-end" do |f| %>
                <div class="sm:min-w-[280px]">
                  <%= f.label :fund_collector, "Who received the guest payment?", class: "mb-1.5 block text-xs font-medium text-foreground" %>
                  <%= f.select :fund_collector,
                        [ [ "WAStays received the payment", "wastays" ], [ "Hotel received the payment directly", "hotel" ] ],
                        { prompt: "Select one" },
                        class: "w-full rounded-md border border-border bg-card px-3 py-2 text-sm text-foreground" %>
                </div>
                <%= render PanelsUI::Button.new(as: :button, type: :submit, variant: :secondary, size: :sm) do %>Save<% end %>
              <% end %>
            <% end %>
          <% end %>
        <% end %>

        <%= render PanelsUI::Table.new(
              caption: "LHDN e-invoice submissions for this booking",
              density: :compact,
              hoverable: true,
              bordered: true,
              wrapper_class: "rounded-md border border-border",
              class: "table-fixed min-w-[600px] xl:min-w-0") do |table| %>
          <% table.with_header do %>
            <tr>
              <th scope="col" class="w-1/3">Document</th>
              <th scope="col" class="w-32">Status</th>
              <th scope="col" class="w-1/4">Flow</th>
              <th scope="col" class="w-32">Updated</th>
              <th scope="col" class="w-20"><span class="sr-only">Actions</span></th>
            </tr>
          <% end %>
          <% table.with_body do %>
            <% if e_invoice_submissions.any? %>
              <% e_invoice_submissions.each do |submission| %>
                <tr>
                  <td>
                    <p class="font-medium text-foreground"><%= submission.internal_id.presence || "Draft record" %></p>
                    <p class="mt-0.5 text-xs text-muted-foreground"><%= submission.document_type_label %></p>
                  </td>
                  <td><%= render "hotel_portal/e_invoice_submissions/status_badge", submission: submission %></td>
                  <td class="text-sm text-muted-foreground"><%= submission.requested_by_guest? ? "Guest requested" : submission.document_scenario_label %></td>
                  <td class="text-sm text-muted-foreground"><%= (submission.validated_at || submission.submitted_at || submission.updated_at)&.strftime("%d %b %Y") %></td>
                  <td>
                    <%= render PanelsUI::Button.new(href: hotel_e_invoice_submission_path(current_hotel, submission), variant: :secondary, size: :xs) do %>
                      <span>Open</span>
                    <% end %>
                  </td>
                </tr>
              <% end %>
            <% else %>
              <tr>
                <td colspan="5" class="py-10 text-center text-muted-foreground">No e-invoice has been filed for this booking yet.</td>
              </tr>
            <% end %>
          <% end %>
        <% end %>

        <% if adjustment_preview.needed? %>
          <p class="text-sm text-muted-foreground"><%= adjustment_preview.message %></p>
        <% end %>
      </section>
    <% end %>
  </div>
</div>
