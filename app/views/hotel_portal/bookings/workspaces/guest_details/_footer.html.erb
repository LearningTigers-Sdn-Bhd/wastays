<% booking_guest = presenter.selected_booking_guest %>
<% can_manage = current_user.has_permission?("manage_bookings", hotel: current_hotel) %>
<% can_view_grc = can_manage || current_user.has_permission?("view_reports", hotel: current_hotel) %>
<% return_to = hotel_booking_workspace_path(current_hotel, booking, tab: "guest_details", booking_guest_id: booking_guest.id) %>
<% grc_path = hotel_booking_guest_registration_card_path(current_hotel, booking) %>

<footer class="shrink-0 bg-card px-5 pb-4 pt-2 lg:px-8" data-testid="guest-details-footer">
  <div class="flex max-w-6xl items-center justify-between gap-3">
    <div class="flex min-w-0 items-center gap-2 overflow-x-auto overscroll-x-contain">
      <% if can_view_grc %>
        <%= render PanelsUI::DropdownMenu.new(id: "guest-grc-actions", placement: :top_start) do |menu| %>
          <% menu.with_trigger(variant: :secondary, size: :sm) do %>
            GRC Actions
            <%= cached_icon "chevron-down", class: "size-3", aria: { hidden: true } %>
          <% end %>
          <% menu.with_item(href: grc_path, target: "_blank", rel: "noopener") do %>
            <%= cached_icon "clipboard-list", class: "size-4 text-muted-foreground", aria: { hidden: true } %>
            View GRC
          <% end %>
          <% menu.with_item(disabled: true, title: "Signature capture will be added in a later phase") do %>
            <%= cached_icon "pen-line", class: "size-4 text-muted-foreground", aria: { hidden: true } %>
            Add Signature
          <% end %>
        <% end %>

        <%# The menu uses popover="manual" and stays in this subtree, so the print
            target and status stay within the controller's scope. %>
        <div class="inline-flex min-w-0 items-center gap-2"
             data-controller="document-print"
             data-document-print-url-value="<%= grc_path %>">
          <%= render PanelsUI::DropdownMenu.new(id: "guest-print-actions", placement: :top_start) do |menu| %>
            <% menu.with_trigger(variant: :secondary, size: :sm) do %>
              Print
              <%= cached_icon "chevron-down", class: "size-3", aria: { hidden: true } %>
            <% end %>
            <% menu.with_item(data: { document_print_target: "button", action: "document-print#print" }) do %>
              <%= cached_icon "printer", class: "size-4 text-muted-foreground", aria: { hidden: true } %>
              Guest Registration Card
            <% end %>
          <% end %>
          <p class="hidden min-w-0 truncate whitespace-nowrap text-xs font-semibold text-muted-foreground" role="status" aria-live="polite" data-document-print-status></p>
        </div>
      <% end %>

      <% if can_manage && !booking_guest.primary? %>
        <%= render PanelsUI::Button.new(
              href: hotel_booking_action_remove_guest_path(current_hotel, booking, booking_guest, return_to: return_to),
              variant: :destructive,
              size: :sm,
              data: { turbo_frame: "booking_action_sheet" }) do %>
          Remove guest
        <% end %>
        <%= form_with url: hotel_booking_action_set_primary_guest_path(current_hotel, booking, booking_guest), method: :patch, class: "inline-flex" do %>
          <%= render PanelsUI::Button.new(as: :button, type: :submit, variant: :secondary, size: :sm) do %>Make primary<% end %>
        <% end %>
      <% end %>
    </div>

    <% if can_manage %>
      <%= render PanelsUI::ButtonGroup.new(class: "shrink-0", aria: { label: "Save guest" }) do %>
        <%= render PanelsUI::Button.new(
              as: :button,
              type: :submit,
              form: "guest-details-form",
              name: "save_scope",
              value: "snapshot") do %>Save Guest<% end %>
        <%= render PanelsUI::DropdownMenu.new(id: "guest-save-options", placement: :top_end) do |menu| %>
          <% menu.with_trigger(size: :icon, aria_label: "More save options") do %>
            <%= cached_icon "chevron-up", class: "size-4", aria: { hidden: true } %>
          <% end %>
          <% menu.with_item(type: :submit, form_id: "guest-details-form", name: "save_scope", value: "snapshot_and_profile") do %>
            <span class="block">
              <span class="block text-sm font-semibold text-foreground">Save &amp; Update Guest Record</span>
              <span class="mt-0.5 block text-xs leading-5 text-muted-foreground">Also update this guest’s reusable profile.</span>
            </span>
          <% end %>
        <% end %>
      <% end %>
    <% else %>
      <span class="text-xs font-semibold text-muted-foreground">View only</span>
    <% end %>
  </div>
</footer>
