<% booking_guest = presenter.selected_booking_guest %>
<% can_manage = presenter.can_manage_bookings?(current_user) %>
<% can_view_grc = presenter.can_view_grc?(current_user) %>
<% return_to = presenter.guest_details_return_to_path(booking, booking_guest) %>
<% grc_path = presenter.guest_registration_card_path(booking, booking_guest) %>

<footer class="shrink-0 bg-card px-5 pb-4 pt-2 lg:px-8" data-testid="guest-details-footer">
  <div class="flex max-w-6xl items-center justify-between gap-3">
    <div class="flex min-w-0 items-center gap-2 overflow-x-auto overscroll-x-contain">
      <% if can_manage && !booking_guest.primary? %>
        <%= render PanelsUI::Button.new(
              href: hotel_booking_action_remove_guest_path(current_hotel, booking, booking_guest, return_to: return_to),
              variant: :destructive,
              size: :sm,
              data: { turbo_frame: "booking_action_sheet" }) do %>
          Remove guest
        <% end %>
        <%= form_with url: hotel_booking_action_set_primary_guest_path(current_hotel, booking, booking_guest), method: :patch, class: "inline-flex" do %>
          <%= render PanelsUI::Button.new(as: :button, type: :submit, variant: :secondary, size: :sm) do %>Make primary<% end %>
        <% end %>
      <% end %>
    </div>

    <div class="flex shrink-0 items-center gap-2">
      <% if can_view_grc %>
        <%= render PanelsUI::Button.new(
              href: grc_path,
              target: "_blank",
              rel: "noopener",
              variant: :secondary,
              size: :sm) do %>
          <%= cached_icon "clipboard-list", class: "size-4", aria: { hidden: true } %>
          View GRC
        <% end %>
      <% end %>

      <% if can_manage %>
        <%= render PanelsUI::Button.new(
              as: :button,
              type: :button,
              size: :sm,
              command: "show-modal",
              commandfor: "guest-save-scope-dialog",
              aria: { haspopup: "dialog" },
              data: { testid: "guest-save-trigger" }) do %>Save<% end %>
      <% else %>
        <span class="text-xs font-semibold text-muted-foreground">View only</span>
      <% end %>
    </div>
  </div>

  <% if can_manage %>
    <%= render PanelsUI::Dialog.new(
          id: "guest-save-scope-dialog",
          title: "Save changes",
          description: "Where should these changes apply?",
          size: :md) do |dialog| %>
      <% dialog.with_body do %>
        <fieldset class="space-y-3">
          <legend class="sr-only">Save scope</legend>
          <label class="flex cursor-pointer items-start gap-3 rounded-lg border border-border p-3 hover:bg-muted/40 has-[:checked]:border-primary has-[:checked]:bg-primary/5">
            <%= radio_button_tag "save_scope", "snapshot", true, form: "guest-details-form", class: "mt-0.5" %>
            <span>
              <span class="block text-sm font-semibold text-foreground">This booking only</span>
              <span class="mt-0.5 block text-xs text-muted-foreground">Changes apply only to this reservation. The guest's saved profile remains unchanged.</span>
            </span>
          </label>
          <label class="flex cursor-pointer items-start gap-3 rounded-lg border border-border p-3 hover:bg-muted/40 has-[:checked]:border-primary has-[:checked]:bg-primary/5">
            <%= radio_button_tag "save_scope", "snapshot_and_profile", false, form: "guest-details-form", class: "mt-0.5" %>
            <span>
              <span class="block text-sm font-semibold text-foreground">Guest profile and all bookings</span>
              <span class="mt-0.5 block text-xs text-muted-foreground">Changes apply to the guest's profile and all current and future bookings.</span>
            </span>
          </label>
        </fieldset>
      <% end %>
      <% dialog.with_footer do %>
        <%= render PanelsUI::Button.new(as: :button, type: :button, variant: :secondary, size: :sm, data: { action: "panels-ui--dialog#close" }) do %>Cancel<% end %>
        <%= render PanelsUI::Button.new(as: :button, type: :submit, size: :sm, form: "guest-details-form") do %>Save<% end %>
      <% end %>
    <% end %>
  <% end %>
</footer>
