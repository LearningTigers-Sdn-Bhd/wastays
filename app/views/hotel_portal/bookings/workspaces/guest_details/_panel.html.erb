<%# locals: (booking:, entity_booking:, presenter:, booking_presenter: nil, folio_show: nil, audit_logs: nil, audit_history: nil) %>
<section class="h-full min-h-0" aria-labelledby="guest-details-heading">
  <% if presenter.selected_booking_guest && presenter.selected_guest %>
    <% return_to = presenter.guest_details_return_to %>
    <% snapshots = presenter.guest_details_snapshots %>
    <% boat_times = presenter.guest_details_boat_times %>
    <% country_choices = COUNTRY_OPTIONS.map { |country| [country, country] } %>

    <%= form_with model: presenter.selected_guest,
        url: hotel_booking_workspace_path(current_hotel, entity_booking, tab: "guest_details", booking_guest_id: presenter.selected_booking_guest.id),
        method: :patch,
        id: "guest-details-form",
        class: "flex h-full min-h-0 flex-col bg-card",
        data: { turbo: false, controller: "guest-details-editor guest-dob", action: "input->guest-details-editor#markDirty change->guest-details-editor#markDirty submit->guest-details-editor#submit" } do |form| %>
      <%= hidden_field_tag :return_to, return_to %>
      <%= hidden_field_tag :presentation, "booking_workspace" %>

      <header class="shrink-0 border-b border-border px-5 py-4">
        <p class="text-xs tabular-nums text-muted-foreground"><%= presenter.selected_guest_context_line %></p>
        <h2 id="guest-details-heading" class="mt-1 break-words text-base font-semibold text-foreground"><%= presenter.guest_display[:name] %></h2>
        <p class="mt-1 text-sm text-muted-foreground"><%= presenter.guest_display[:role] %></p>
      </header>

      <div class="min-h-0 flex-1 overflow-y-auto overscroll-contain custom-scrollbar">
        <div class="mx-auto max-w-5xl px-5 py-6 lg:px-8">
          <% if presenter.guest_details_errors.any? %>
            <div class="mb-5 rounded-md border border-destructive/40 bg-destructive/10 p-4 text-sm text-destructive" role="alert" tabindex="-1" data-guest-details-error-summary>
              <p class="font-medium">Guest details could not be saved.</p>
              <ul class="mt-2 list-disc space-y-1 pl-5">
                <% presenter.guest_details_errors.each do |message| %><li><%= message %></li><% end %>
              </ul>
            </div>
          <% end %>

          <div class="space-y-6">
            <%= render PanelsUI::FieldSet.new(
                  legend: "Guest details",
                  description: "Guest details recorded for this stay.",
                  disabled: !presenter.can_manage_bookings?(current_user)) do %>
              <%= render PanelsUI::FieldGroup.new do %>
              <div class="grid gap-4 md:grid-cols-2">
                <div class="md:col-span-2">
                  <%= render PanelsUI::FormField.new(form:, attribute: :name, label: "Full name", required: true) do |field| %>
                    <% field.with_input(value: snapshots[:name], autocomplete: "name", placeholder: "Enter full name") %>
                  <% end %>
                </div>
                <%= render PanelsUI::FormField.new(form:, attribute: :email, label: "Email") do |field| %>
                  <% field.with_input(type: :email, value: snapshots[:email], autocomplete: "email", spellcheck: false, placeholder: "guest@example.com") %>
                <% end %>
                <%= render PanelsUI::FormField.new(form:, attribute: :phone, label: "Phone") do |field| %>
                  <% field.with_input(type: :tel, value: snapshots[:phone], autocomplete: "tel", placeholder: "+60 12-345 6789") %>
                <% end %>
                <%= render PanelsUI::FormField.new(form:, attribute: :country, label: "Country", required: true) do |field| %>
                  <% field.with_combobox(country_choices, selected: snapshots[:country], prompt: "Search for a country", data: { guest_dob_target: "country", action: "change->guest-dob#autofill" }) %>
                <% end %>
                <%= render PanelsUI::FormField.new(form:, attribute: :gender, label: "Gender") do |field| %>
                  <% field.with_select_menu([["Male", "male"], ["Female", "female"], ["Other", "other"]], selected: snapshots[:gender], prompt: "Select a gender") %>
                <% end %>
              </div>
              <% end %>
            <% end %>

            <%= render PanelsUI::FieldSet.new(
                  legend: "Identity information",
                  description: "Use the identification presented by the guest.",
                  class: "border-t border-border pt-6",
                  disabled: !presenter.can_manage_bookings?(current_user)) do %>
              <%= render PanelsUI::FieldGroup.new do %>
                <div class="grid gap-4 md:grid-cols-2">
                  <%= render PanelsUI::FormField.new(form:, attribute: :document_type, label: "Document type") do |field| %>
                    <% field.with_select_menu([["IC", "ic"], ["Passport", "passport"]], selected: snapshots[:document_type], prompt: "Select a document type", data: { guest_dob_target: "documentType", action: "change->guest-dob#autofill" }) %>
                  <% end %>
                  <%= render PanelsUI::FormField.new(form:, attribute: :government_id, label: "IC / Passport no.") do |field| %>
                    <% field.with_input(value: snapshots[:government_id], autocomplete: "off", spellcheck: false, placeholder: "Enter IC or passport number", data: { guest_dob_target: "governmentId", action: "input->guest-dob#autofill" }) %>
                  <% end %>
                  <%= render PanelsUI::FormField.new(form:, attribute: :date_of_birth, label: "Date of birth") do |field| %>
                    <% field.with_date_picker(
                         value: snapshots[:date_of_birth]&.to_date&.iso8601,
                         max: Date.yesterday,
                         caption_layout: :dropdown,
                         year_range: (Date.current.year - 120)..Date.current.year,
                         placeholder: "Select date of birth",
                         data: { guest_dob_target: "dateOfBirth" }) %>
                  <% end %>
                </div>
              <% end %>
            <% end %>

            <% if current_hotel.allow_boat_information? %>
              <%= render PanelsUI::FieldSet.new(
                    legend: "Boat transfer",
                    description: "Guest boat-in and boat-out timestamps.",
                    class: "border-t border-border pt-6",
                    disabled: !presenter.can_manage_bookings?(current_user)) do %>
                <%= render PanelsUI::FieldGroup.new do %>
                <div class="grid gap-4 md:grid-cols-2">
                  <%= fields_for :booking_guest, presenter.guest_details_booking_guest_form do |booking_guest_form| %>
                    <%= render PanelsUI::FormField.new(form: booking_guest_form, attribute: :boat_in_at, label: "Boat-in") do |field| %>
                      <% field.with_date_time_picker(value: boat_times[:boat_in]) %>
                    <% end %>
                    <%= render PanelsUI::FormField.new(form: booking_guest_form, attribute: :boat_out_at, label: "Boat-out") do |field| %>
                      <% field.with_date_time_picker(value: boat_times[:boat_out]) %>
                    <% end %>
                  <% end %>
                </div>
                <% end %>
              <% end %>
            <% end %>
          </div>
        </div>
      </div>
    <% end %>
  <% else %>
    <div class="flex h-full items-center justify-center px-5 py-12 text-center">
      <div>
        <p class="font-semibold text-foreground">No guest is linked to this booking.</p>
        <p class="mt-1 text-sm text-muted-foreground">Add a primary guest before check-in.</p>
        <% if current_user.has_permission?("manage_bookings", hotel: current_hotel) && entity_booking.status.in?(%w[confirmed checked_in]) %>
          <div class="mt-4">
            <%= render PanelsUI::Button.new(
                  href: hotel_booking_action_manage_guest_path(current_hotel, entity_booking, mode: "add", return_to: presenter.close_drawer_path),
                  variant: :primary,
                  size: :sm,
                  data: { turbo_frame: "booking_action_sheet" }) do %>Add Guest<% end %>
          </div>
        <% end %>
      </div>
    </div>
  <% end %>
</section>
