<%
  history = local_assigns[:audit_history] || audit_logs.map { |log| HotelPortal::BookingAuditLogPresenter.new(log, hotel: current_hotel) }
  history_available = local_assigns.fetch(:audit_history_available, history.any?)
  active_category = local_assigns[:audit_category].to_s.presence_in(%w[all status stay room financial notes]) || "all"
  filter_frame = local_assigns.fetch(:filter_frame, "booking_workspace")
  selected_audit_booking = presenter.audit_selected_booking
  filter_params = {
    tab: params[:tab].presence,
    child_booking_id: (selected_audit_booking&.id if presenter.group_context_enabled?)
  }.compact
  filter_data = { turbo_frame: filter_frame }
  filter_data[:turbo_action] = "advance" if filter_frame == "booking_workspace"
  category_filters = [
    ["All", "all"],
    ["Status", "status"],
    ["Stay & Guest", "stay"],
    ["Rooms", "room"],
    ["Financial", "financial"],
    ["Notes", "notes"]
  ]
%>

<section aria-labelledby="audit-history-heading">
  <header class="px-5 pb-3 pt-4">
    <div class="flex items-start justify-between gap-3">
      <div>
        <h2 id="audit-history-heading" class="text-base font-semibold text-foreground">Audit Trail</h2>
        <p class="mt-1 text-sm text-muted-foreground">Important booking, stay, room, and financial changes.</p>
      </div>
      <% if local_assigns[:closeable] %>
        <button type="button" class="rounded-md p-2 text-muted-foreground transition hover:bg-muted hover:text-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring" data-action="click->offcanvas#close" aria-label="Close audit trail">
          <%= app_icon "x", class: "size-4", aria: { hidden: true } %>
        </button>
      <% end %>
    </div>
  </header>

  <div class="flex flex-col gap-3 border-b border-border px-5 pb-4 sm:flex-row sm:items-end sm:justify-between">
    <%= render PanelsUI::Tabs.new(
          id: "#{filter_frame}-audit-category-filter",
          active: active_category,
          variant: :pill,
          aria_label: "Filter audit trail by event type") do |tabs| %>
      <% category_filters.each do |label, category| %>
        <% tabs.with_tab(
             name: category,
             label: label,
             href: "#{request.path}?#{filter_params.merge(category: category).to_query}",
             data: filter_data) %>
      <% end %>
    <% end %>

    <%= form_with url: request.path,
          method: :get,
          id: "#{filter_frame}-audit-scope-form",
          class: "w-full sm:w-72 sm:shrink-0",
          data: filter_data.merge(controller: "auto-submit") do |form| %>
      <%= hidden_field_tag :tab, params[:tab] if params[:tab].present? %>
      <%= hidden_field_tag :category, active_category %>
      <%= render PanelsUI::FormField.new(
            form: form,
            attribute: :child_booking_id,
            label: "Booking",
            size: :sm,
            disabled: !presenter.group_context_enabled?) do |field| %>
        <% field.with_select_menu(
             presenter.audit_booking_options,
             selected: presenter.group_context_enabled? ? selected_audit_booking&.id.to_s : booking.id.to_s,
             data: { action: "change->auto-submit#submitNow" }) %>
      <% end %>
    <% end %>
  </div>

  <% if history.any? %>
    <div class="divide-y divide-border">
      <% history.each do |event| %>
        <article class="grid gap-3 px-5 py-4 md:grid-cols-[10rem_minmax(0,1fr)]">
          <div>
            <time class="text-xs font-semibold text-muted-foreground" datetime="<%= event.log.occurred_at&.iso8601 || event.log.created_at.iso8601 %>"><%= event.occurred_at_label %></time>
            <p class="mt-1 text-xs text-muted-foreground">By <span class="font-semibold text-foreground"><%= event.actor_name %></span></p>
          </div>
          <div class="min-w-0">
            <h3 class="text-sm font-semibold text-foreground"><%= event.title %></h3>
            <p class="mt-1 break-words text-sm text-foreground"><%= event.summary %></p>
            <% if event.context_details.any? %>
              <dl class="mt-3 grid gap-2 border-l-2 border-border-interactive pl-3 text-xs sm:grid-cols-2">
                <% event.context_details.each do |label, value| %>
                  <div>
                    <dt class="font-semibold text-muted-foreground"><%= label %></dt>
                    <dd class="mt-0.5 text-foreground"><%= value %></dd>
                  </div>
                <% end %>
              </dl>
            <% end %>
            <% if event.formatted_changes.any? %>
              <details class="mt-3">
                <summary class="cursor-pointer text-xs font-semibold text-primary focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring">View Changes</summary>
                <table class="mt-2 w-full text-xs">
                  <tbody class="divide-y divide-border">
                    <% event.formatted_changes.each do |change| %>
                      <tr>
                        <th scope="row" class="w-36 py-2 text-left font-semibold text-muted-foreground"><%= change[:field] %></th>
                        <td class="py-2 text-foreground"><span class="line-through text-muted-foreground"><%= change[:old] %></span> → <strong><%= change[:new] %></strong></td>
                      </tr>
                    <% end %>
                  </tbody>
                </table>
              </details>
            <% end %>
          </div>
        </article>
      <% end %>
    </div>
  <% elsif history_available %>
    <div class="px-5 py-10 text-center text-sm text-muted-foreground">No events match these filters.</div>
  <% else %>
    <div class="px-5 py-12 text-center">
      <p class="font-semibold text-foreground">No audit history recorded.</p>
      <p class="mt-1 text-sm text-muted-foreground">Important booking activity will appear here.</p>
    </div>
  <% end %>
</section>
