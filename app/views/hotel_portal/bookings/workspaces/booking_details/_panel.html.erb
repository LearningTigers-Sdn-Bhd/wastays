<% if presenter.group_overview? %>
  <% group_reference_rows = [
    ["Booking No.", presenter.group_booking.formatted_reservation_number.presence || "—"],
    ["Confirmation code", presenter.group_booking.confirmation_token.presence || "—"],
    ["Receipt No.", presenter.group_booking.formatted_receipt_number.presence || "—"],
    ["External Reference", presenter.group_booking.external_reference.presence || "—"],
    ["Organizer", presenter.group_booking.organizer_guest&.name.presence || "—"]
  ] %>

  <section aria-labelledby="group-overview-heading" class="divide-y divide-border">
    <div class="px-5 py-5">
      <div class="flex flex-wrap items-start justify-between gap-3">
        <div>
          <h2 id="group-overview-heading" class="text-base font-semibold text-foreground">Overview</h2>
          <p class="mt-1 text-sm text-muted-foreground">Group references and child bookings.</p>
        </div>
        <% if presenter.can_manage_bookings?(current_user) %>
          <%= render PanelsUI::Button.new(
                href: hotel_booking_action_edit_dates_path(current_hotel, booking, return_to: request.fullpath),
                variant: :secondary,
                size: :sm,
                data: { turbo_frame: "booking_action_sheet" }) do %>Edit Dates<% end %>
        <% end %>
      </div>

      <% if presenter.stay_dates_vary? %>
        <div class="mt-4">
          <%= render PanelsUI::Alert.new(tone: :info, title: "Arrival and departure schedule") do |alert| %>
            <% alert.with_description { presenter.group_stay_variation_notice } %>
          <% end %>
        </div>
      <% end %>
    </div>

    <div class="px-5 py-5">
      <h3 class="text-base font-semibold text-foreground">References</h3>
      <dl class="mt-4 grid gap-x-6 gap-y-4 sm:grid-cols-2 lg:grid-cols-3">
        <% group_reference_rows.each do |label, value| %>
          <div>
            <dt class="text-xs text-muted-foreground"><%= label %></dt>
            <dd class="mt-1 break-words text-sm text-foreground"><%= value %></dd>
          </div>
        <% end %>
      </dl>
    </div>

    <div class="px-5 py-5">
      <h3 class="text-base font-semibold text-foreground">Bookings</h3>
      <div class="mt-4 overflow-x-auto">
        <table class="w-full min-w-[880px] text-left text-sm">
          <thead class="border-b border-border text-xs font-medium text-muted-foreground">
            <tr><th class="px-3 py-2 font-medium">Booking No.</th><th class="px-3 py-2 font-medium">Guest</th><th class="px-3 py-2 font-medium">Room</th><th class="px-3 py-2 font-medium">Stay</th><th class="px-3 py-2 font-medium">Status</th><th class="px-3 py-2 text-right font-medium">Balance</th></tr>
          </thead>
          <tbody class="divide-y divide-border">
            <% presenter.group_room_rows.each do |row| %>
              <tr>
                <td class="px-3 py-2 text-foreground"><%= link_to row[:booking_number], hotel_booking_workspace_path(current_hotel, row[:booking], tab: "booking_details"), class: "font-medium underline-offset-4 hover:underline" %></td>
                <td class="px-3 py-2 text-foreground"><%= row[:guest] %></td>
                <td class="px-3 py-2 text-foreground"><%= row[:room] %> · <%= row[:room_type] %></td>
                <td class="px-3 py-2 whitespace-nowrap tabular-nums text-foreground"><%= row[:stay] %></td>
                <td class="px-3 py-2 text-foreground"><%= row[:status] %></td>
                <td class="px-3 py-2 text-right tabular-nums text-foreground"><%= presenter.money_for(row[:booking], row[:booking].booking_folios.sum { |folio| folio.projected_outstanding_balance.to_d }) %></td>
              </tr>
            <% end %>
          </tbody>
          <tfoot class="border-t border-border text-sm">
            <tr><th colspan="5" class="px-3 py-2 text-right font-medium text-foreground">Group Outstanding Balance</th><td class="px-3 py-2 text-right font-semibold tabular-nums text-foreground"><%= presenter.money(presenter.group_total_balance) %></td></tr>
          </tfoot>
        </table>
      </div>
    </div>
  </section>
<% else %>
  <%= render "hotel_portal/bookings/workspaces/booking_details/stay_details", booking: booking, presenter: booking_presenter %>
  <%= render "hotel_portal/bookings/workspaces/booking_details/internal_notes", booking: booking %>
<% end %>
