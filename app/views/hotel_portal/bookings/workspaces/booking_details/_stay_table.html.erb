<% rows = presenter.stay_rows %>
<div>
  <div class="flex flex-wrap items-start justify-between gap-3">
    <h3 class="text-base font-semibold text-foreground">Stay</h3>
    <% if presenter.can_manage_bookings?(current_user) %>
      <%= render PanelsUI::Button.new(
            href: hotel_booking_action_edit_dates_path(current_hotel, booking, return_to: request.fullpath),
            variant: :secondary,
            size: :sm,
            data: { turbo_frame: "booking_action_sheet" }) do %>Edit Dates<% end %>
    <% end %>
  </div>
  <div class="mt-3">
    <%= render PanelsUI::Table.new(
          caption: "Stay",
          density: :compact,
          hoverable: true,
          bordered: true,
          wrapper_class: "rounded-md border border-border",
          class: "min-w-[1040px]") do |table| %>
      <% table.with_header do %>
        <tr>
          <th scope="col">Booking No.</th>
          <th scope="col">Primary guest</th>
          <th scope="col">Room</th>
          <th scope="col">Arrival</th>
          <th scope="col">Departure</th>
          <th scope="col" class="text-right">Nights</th>
          <th scope="col">Pax</th>
          <th scope="col">Status</th>
          <th scope="col" class="text-right">Balance</th>
        </tr>
      <% end %>
      <% table.with_body do %>
        <% rows.each do |row| %>
          <tr>
            <td>
              <% if presenter.group_context_enabled? %>
                <%= link_to row[:booking_number], hotel_booking_workspace_path(current_hotel, row[:booking], tab: "booking_details", scope: "booking"), class: "font-medium tabular-nums underline-offset-4 hover:underline" %>
              <% else %>
                <span class="font-medium tabular-nums"><%= row[:booking_number] %></span>
              <% end %>
            </td>
            <td><%= row[:guest] %></td>
            <td><%= row[:room] %> · <%= row[:room_type] %></td>
            <td class="whitespace-nowrap tabular-nums"><%= row[:arrival] %></td>
            <td class="whitespace-nowrap tabular-nums"><%= row[:departure] %></td>
            <td class="text-right tabular-nums"><%= row[:nights] %></td>
            <td class="whitespace-nowrap tabular-nums"><%= row[:pax] %></td>
            <td>
              <% if row[:status] %>
                <%= render PanelsUI::Badge.new(label: row[:status][:label], variant: row[:status][:variant], size: :sm) %>
              <% end %>
            </td>
            <td class="text-right tabular-nums"><%= row[:balance] %></td>
          </tr>
        <% end %>
      <% end %>
      <% if presenter.group_context_enabled? %>
        <% table.with_footer do %>
          <tr>
            <th colspan="8" scope="row" class="text-right font-medium text-foreground">Group Outstanding Balance</th>
            <td class="text-right font-semibold tabular-nums text-foreground"><%= presenter.stay_rows_total_balance %></td>
          </tr>
        <% end %>
      <% end %>
    <% end %>
  </div>
</div>
