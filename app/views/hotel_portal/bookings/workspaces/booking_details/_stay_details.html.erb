<% stay_rows = [
  ["Check-in", presenter.check_in_formatted.presence || "—"],
  ["Check-out", presenter.check_out_formatted.presence || "—"],
  ["Nights", presenter.nights_count],
  ["Occupancy", presenter.occupancy_text(variant: :desktop)],
  ["Room", presenter.room_display_text(variant: :desktop)],
  ["Rate Plan", presenter.rate_plan_label.presence || "Standard Rate"]
] %>
<% financial_rows = [
  ["Projected Balance", presenter.formatted_projected_balance],
  ["Payment Status", presenter.payment_status_label],
  ["Guarantee", presenter.guarantee_method_label],
  ["Security Deposit", presenter.security_deposit_status_label],
  ["Room Total", presenter.formatted_room_total],
  ["Taxes & Charges", presenter.formatted_taxes_total],
  ["Total Amount", presenter.formatted_total_amount]
] %>
<% reference_rows = [
  ["Booking No.", booking.formatted_reservation_number.presence || "—"],
  ["Confirmation code", booking.confirmation_token.presence || "—"],
  ["Receipt No.", booking.formatted_receipt_number.presence || "—"],
  ["Source", presenter.source_label],
  ["External Reference", booking.external_reference.presence || "—"],
  ["Folio Account", booking.folio_account_reference_display.presence || "—"],
  ["Guest Registration", booking.formatted_guest_registration_number.presence || "—"],
  ["Channel Manager", booking.channel_manager_reference.presence || "—"]
] %>

<section aria-labelledby="booking-overview-heading" class="divide-y divide-border">
  <div class="px-5 py-5">
    <h2 id="booking-overview-heading" class="text-base font-semibold text-foreground">Overview</h2>
    <p class="mt-1 text-sm text-muted-foreground">Stay, financial, and reference information.</p>
  </div>
  <div class="px-5 py-5">
    <div class="flex flex-wrap items-start justify-between gap-3">
      <h3 id="stay-heading" class="text-base font-semibold text-foreground">Stay</h3>
      <% if presenter.can_manage_bookings?(current_user) %>
        <%= render PanelsUI::Button.new(
              href: hotel_booking_action_edit_dates_path(current_hotel, booking, return_to: request.fullpath),
              variant: :secondary,
              size: :sm,
              data: { turbo_frame: "booking_action_sheet" }) do %>Edit Dates<% end %>
      <% end %>
    </div>
    <dl class="mt-4 grid gap-x-6 gap-y-4 sm:grid-cols-2 lg:grid-cols-3">
      <% stay_rows.each do |label, value| %>
        <div>
          <dt class="text-xs text-muted-foreground"><%= label %></dt>
          <dd class="mt-1 break-words text-sm tabular-nums text-foreground"><%= value %></dd>
        </div>
      <% end %>
    </dl>
  </div>

  <div class="px-5 py-5">
    <h3 class="text-base font-semibold text-foreground">Financial</h3>
    <dl class="mt-4 grid gap-x-6 gap-y-4 sm:grid-cols-2 lg:grid-cols-3">
      <% financial_rows.each do |label, value| %>
        <div>
          <dt class="text-xs text-muted-foreground"><%= label %></dt>
          <dd class="mt-1 break-words text-sm tabular-nums text-foreground"><%= value %></dd>
        </div>
      <% end %>
    </dl>
  </div>

  <div class="px-5 py-5">
    <h3 class="text-base font-semibold text-foreground">References</h3>
    <dl class="mt-4 grid gap-x-6 gap-y-4 sm:grid-cols-2 lg:grid-cols-3">
      <% reference_rows.each do |label, value| %>
        <div>
          <dt class="text-xs text-muted-foreground"><%= label %></dt>
          <dd class="mt-1 break-words text-sm tabular-nums text-foreground"><%= value %></dd>
        </div>
      <% end %>
    </dl>
  </div>

  <% if booking.special_requests.present? %>
    <div class="px-5 py-5">
      <h3 class="text-base font-semibold text-foreground">Special requests</h3>
      <p class="mt-3 whitespace-pre-wrap text-sm leading-6 text-foreground"><%= booking.special_requests %></p>
    </div>
  <% end %>
</section>
