<section aria-labelledby="billing-preferences-heading">
  <header class="flex flex-col gap-3 border-b border-border px-5 py-4 sm:flex-row sm:items-start sm:justify-between">
    <div><% if presenter.group_context_enabled? && !presenter.group_overview? %><p class="text-xs text-muted-foreground">Booking <%= presenter.booking_number %></p><% end %><h2 id="billing-preferences-heading" class="mt-1 text-base font-semibold text-foreground">Billing</h2><p class="mt-1 text-sm text-muted-foreground">Register billing parties and settlement terms. Routing is managed separately.</p></div>
    <% if current_user.superadmin? || current_user.has_permission?("manage_folio_movements", hotel: current_hotel) %>
      <% if presenter.group_context_enabled? %>
        <div class="relative shrink-0" data-controller="dropdown" data-dropdown-align="right">
          <%= render PanelsUI::Button.new(type: :button, variant: :secondary, size: :sm, data: { dropdown_target: "button", action: "click->dropdown#toggle keydown->dropdown#handleKeydown" }, aria: { expanded: false, haspopup: "menu" }) do %>
            <%= app_icon "route", class: "size-4", aria: { hidden: true } %>
            Change Billing Routes
            <%= app_icon "chevron-down", class: "size-4", aria: { hidden: true } %>
          <% end %>
          <div data-dropdown-target="menu" class="absolute right-0 z-50 mt-2 hidden w-64 rounded-md border border-border bg-card p-1.5 shadow-lg" role="menu" tabindex="-1">
            <%= link_to "Group Billing Routes", hotel_folio_action_group_billing_routes_path(current_hotel, booking, return_to: request.fullpath), role: "menuitem", class: "block rounded-md px-3 py-2 text-sm font-medium text-foreground hover:bg-muted", data: { turbo_frame: "folio_action_sheet" } %>
            <%= link_to "Selective Billing Routes", hotel_folio_action_billing_routes_path(current_hotel, booking, return_to: request.fullpath), role: "menuitem", class: "block rounded-md px-3 py-2 text-sm font-medium text-foreground hover:bg-muted", data: { turbo_frame: "folio_action_sheet" } %>
          </div>
        </div>
      <% else %>
        <%= render PanelsUI::Button.new(href: hotel_folio_action_billing_routes_path(current_hotel, booking, return_to: request.fullpath), variant: :secondary, size: :sm, class: "shrink-0", data: { turbo_frame: "folio_action_sheet" }) do %>
          <%= app_icon "route", class: "size-4", aria: { hidden: true } %>
          Change Billing Routes
        <% end %>
      <% end %>
    <% end %>
  </header>

  <div class="p-5">
    <%= render "hotel_portal/bookings/workspaces/billing_preferences/party_list", booking: booking, presenter: presenter %>
  </div>
</section>
