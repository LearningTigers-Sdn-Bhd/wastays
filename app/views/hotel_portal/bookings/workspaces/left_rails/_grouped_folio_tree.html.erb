<% if presenter.can_manage_folio_windows?(current_user) %>
  <div class="border-b border-border px-4 py-3">
    <%= render PanelsUI::Button.new(
          href: new_folio_window_hotel_booking_workspace_path(current_hotel, entity_booking),
          variant: :primary,
          size: :sm,
          class: "w-full",
          data: { turbo_frame: "offcanvas_drawer", offcanvas_variant: "right" }) do %>Add Folio<% end %>
  </div>
<% end %>

<nav aria-label="Bookings and folios" class="divide-y divide-border">
  <% presenter.grouped_folio_tree_groups.each do |group| %>
    <section aria-labelledby="folio-group-<%= group.booking_id %>">
      <h3 id="folio-group-<%= group.booking_id %>" class="px-4 pt-4 text-xs font-medium text-muted-foreground"><%= group.label %></h3>
      <%= render "hotel_portal/bookings/workspaces/left_rails/folio_rows", rows: group.rows %>
      <% if group.rows.empty? %>
        <p class="px-4 pb-4 text-sm text-muted-foreground">No folios available.</p>
      <% end %>
    </section>
  <% end %>
</nav>
