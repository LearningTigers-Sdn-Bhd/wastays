<% if presenter.can_manage_folio_windows?(current_user) %>
  <div class="border-b border-border px-4 py-3">
    <%= render PanelsUI::Button.new(
          href: new_folio_window_hotel_booking_workspace_path(current_hotel, entity_booking),
          variant: :primary,
          size: :sm,
          class: "w-full",
           data: {
             turbo_frame: "offcanvas_drawer",
             offcanvas_variant: "right",
             action: ("panels-ui--sheet#close" if mobile_entity_selection)
           }.compact) do %>Add Folio<% end %>
  </div>
<% end %>

<nav aria-label="Bookings and folios" class="divide-y divide-border">
  <% presenter.grouped_folio_tree_groups.each do |group| %>
    <% heading_id = "#{id_prefix}-folio-group-#{group.booking_id}" %>
    <section aria-labelledby="<%= heading_id %>">
      <h3 id="<%= heading_id %>" class="px-4 pt-4 text-xs font-medium text-muted-foreground"><%= group.label %></h3>
      <%= render "hotel_portal/bookings/workspaces/left_rails/folio_rows",
        rows: group.rows,
        mobile_entity_selection: mobile_entity_selection %>
      <% if group.rows.empty? %>
        <p class="px-4 pb-4 text-sm text-muted-foreground">No folios available.</p>
      <% end %>
    </section>
  <% end %>
</nav>
