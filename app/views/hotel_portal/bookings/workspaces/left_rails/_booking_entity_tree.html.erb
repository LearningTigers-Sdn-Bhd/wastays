<nav aria-label="<%= aria_label %>" data-controller="booking-entity-tree" data-booking-entity-tree-scope-value="<%= aria_label %>">
  <% navigation_data = presenter.group_context_enabled? ? { turbo_frame: "_top", turbo_action: "advance" } : { turbo_frame: "booking_workspace", turbo_action: "advance" } %>
  <% if local_assigns[:overview_path].present? %>
    <%= link_to overview_path,
        data: navigation_data,
        class: "flex items-center justify-between gap-3 border-b border-border px-4 py-3 text-sm font-semibold focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-inset focus-visible:ring-ring #{presenter.group_overview? ? 'bg-primary text-primary-foreground' : 'text-foreground hover:bg-muted'}" do %>
      <span><%= overview_label %></span>
      <%= cached_icon "chevron-right", class: "size-4 shrink-0 opacity-70", aria: { hidden: true } %>
    <% end %>
  <% end %>

  <div class="divide-y divide-border">
    <% groups.each_with_index do |group, index| %>
      <details class="group" data-booking-entity-tree-target="group" data-group-key="<%= index %>" data-action="toggle->booking-entity-tree#remember" <%= "open" if local_assigns.fetch(:single_booking, false) || presenter.booking_tree_group_open?(group) %>>
        <summary class="flex cursor-pointer list-none items-center justify-between gap-3 px-4 py-3 text-sm font-semibold text-foreground transition-colors hover:bg-muted focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-inset focus-visible:ring-ring group-open:bg-muted [&::-webkit-details-marker]:hidden">
          <span class="min-w-0">
            <span class="flex min-w-0 items-center gap-2">
              <% if presenter.group_context_enabled? && (badge = presenter.status_badge_for_tree_group(group)) %>
                <%= render PanelsUI::Badge.new(label: badge[:label], variant: presenter.badge_variant_for(badge[:tone]), size: :sm, class: "shrink-0") %>
              <% end %>
              <span class="truncate"><%= group.label %></span>
            </span>
            <span class="mt-0.5 block truncate text-xs font-normal text-muted-foreground"><%= group.description %></span>
          </span>
          <%= cached_icon "chevron-right", class: "size-4 shrink-0 text-muted-foreground transition-transform duration-150 group-open:rotate-90" %>
        </summary>

        <div class="py-2">
          <% group.rows.each do |row| %>
            <%= link_to row.href,
                data: navigation_data,
                class: "mx-2 block rounded-md px-3 py-2 text-sm focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring #{row.active ? 'bg-primary text-primary-foreground' : 'text-foreground hover:bg-muted'}" do %>
              <span class="block truncate font-semibold"><%= row.label %></span>
              <span class="block truncate text-xs font-normal opacity-70"><%= row.description %></span>
            <% end %>
          <% end %>

          <% if group.rows.empty? %>
            <p class="px-4 py-2 text-xs font-semibold text-muted-foreground"><%= empty_label %></p>
          <% end %>
        </div>
      </details>
    <% end %>
  </div>
</nav>
