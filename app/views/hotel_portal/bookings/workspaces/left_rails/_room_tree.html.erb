<div class="divide-y divide-border">
  <% if presenter.room_tree_groups.any? %>
    <% presenter.room_tree_groups.each do |group| %>
      <details class="group" open>
        <summary class="flex cursor-pointer items-center justify-between gap-3 px-4 py-3 text-sm font-bold text-foreground hover:bg-muted">
          <span><%= group.label %></span>
          <span class="text-[11px] font-semibold text-muted-foreground"><%= group.description %></span>
        </summary>
        <div class="space-y-1 px-3 pb-3">
          <% group.rows.each do |row| %>
            <%= link_to hotel_booking_workspace_path(current_hotel, booking, tab: presenter.active_tab, room_id: row.id, folio_id: params[:folio_id]), data: { turbo_frame: "booking_workspace", turbo_action: "advance" }, class: "block rounded-lg px-3 py-2 text-sm #{row.active ? "bg-primary text-primary-foreground" : "text-foreground hover:bg-muted"}" do %>
              <span class="block font-bold"><%= row.label %></span>
              <span class="block truncate text-xs opacity-75"><%= row.description %></span>
            <% end %>
          <% end %>
        </div>
      </details>
    <% end %>
  <% else %>
    <p class="m-3 rounded-lg border border-dashed border-border px-3 py-4 text-sm text-muted-foreground">No rooms added.</p>
  <% end %>
</div>
