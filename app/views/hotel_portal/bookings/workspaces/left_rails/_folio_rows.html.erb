<div class="space-y-1 py-2">
  <% rows.each do |row| %>
    <% link_data = { turbo_frame: "_top", turbo_action: "advance" } %>
    <% if mobile_entity_selection %>
      <% link_data.merge!(
        action: "workspace-entity-selection#select panels-ui--sheet#close",
        workspace_entity_selection_heading_param: "folio-operations-heading"
      ) %>
    <% end %>
    <%= link_to row.href,
        aria: { current: ("page" if row.active) },
        data: link_data,
        class: "mx-2 block rounded-md px-3 py-2 text-sm focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring #{row.active ? 'bg-muted text-foreground ring-1 ring-border-interactive' : 'text-foreground hover:bg-muted'}" do %>
      <span class="flex items-center gap-2 font-medium">
        <% if row.active %>
          <span class="size-1.5 shrink-0 rounded-full bg-primary" aria-hidden="true"></span>
          <span class="sr-only">Selected:</span>
        <% end %>
        <span class="min-w-0 break-words"><%= row.label %></span>
      </span>
      <span class="mt-0.5 block break-words text-xs tabular-nums text-muted-foreground"><%= row.description %></span>
    <% end %>
  <% end %>
</div>
