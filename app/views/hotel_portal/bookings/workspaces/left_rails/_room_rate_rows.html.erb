<div class="mt-2 space-y-1">
  <% rows.each do |row| %>
    <% link_data = { turbo_frame: "_top", turbo_action: "advance" } %>
    <% if mobile_entity_selection %>
      <% link_data.merge!(
        action: "workspace-entity-selection#select panels-ui--sheet#close",
        workspace_entity_selection_heading_param: "room-rate-panel"
      ) %>
    <% end %>
    <%= link_to row.href,
        aria: { current: ("page" if row.active) },
        data: link_data,
        class: "-mx-2 block rounded-md px-2 py-2 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring #{row.active ? 'bg-muted' : 'hover:bg-muted'}" do %>
      <span class="grid grid-cols-[minmax(0,1fr)_auto] gap-3">
        <span class="min-w-0">
          <span class="flex items-center gap-2 text-xs text-muted-foreground">
            <% if row.active %>
              <span class="size-1.5 shrink-0 rounded-full bg-primary" aria-hidden="true"></span>
              <span class="sr-only">Selected:</span>
            <% end %>
            Rate plan
          </span>
          <span class="mt-0.5 block truncate text-sm font-medium text-foreground"><%= row.rate_plan %></span>
        </span>
        <span class="text-right">
          <span class="block text-xs text-muted-foreground">Total rate</span>
          <span class="mt-0.5 block whitespace-nowrap text-sm font-medium tabular-nums text-foreground"><%= row.total_rate %></span>
        </span>
      </span>
    <% end %>
  <% end %>
</div>
