<% booking = local_assigns.fetch(:booking) { @booking } %>
<% group = booking.group_booking_id? %>
<% target_presenter = HotelPortal::BookingLifecycleTargetPresenter.new(booking: booking, action: :cancel) %>

<div data-controller="panels-ui--sheet-frame">
  <%= render PanelsUI::Sheet.new(
        id: "booking-cancellation-sheet",
        side: :right,
        size: group ? :xl : :md,
        title: "Cancel booking",
        description: booking.guest_name,
        body_class: "p-0") do |sheet| %>
    <% sheet.with_body do %>
      <%= form_with url: hotel_booking_action_cancel_booking_path(current_hotel, booking), method: :post, class: "flex h-full min-h-0 flex-col", data: { controller: "group-lifecycle-targets" } do |f| %>
        <%= hidden_field_tag :return_to, @return_to if @return_to.present? %>
        <div class="min-h-0 flex-1 <%= group ? 'grid grid-rows-[auto_minmax(0,1fr)] overflow-hidden lg:grid-cols-[20rem_minmax(0,1fr)] lg:grid-rows-none' : 'overflow-y-auto' %>">
          <%= render "hotel_portal/bookings/actions/shared/group_target_selector", target_presenter: target_presenter %>
          <% if group %><div class="min-h-0 overflow-y-auto custom-scrollbar"><% end %>
          <div class="p-4">
            <% if booking.errors.any? %>
              <div class="mb-5 rounded-xl border border-destructive/30 bg-destructive/10 p-4 text-sm text-destructive" role="alert"><%= booking.errors.full_messages.to_sentence %></div>
            <% end %>
            <p class="text-sm text-muted-foreground">Cancellation releases the reservation inventory and cannot be reinstated.</p>

            <% quote = cancellation_quote(booking) %>
            <% per_booking = cancellation_policy_per_booking? %>
            <% charges_fee = quote.success? && quote.fee_amount.to_d.positive? %>
            <% if charges_fee %>
              <section class="mt-5 space-y-3 rounded-md border border-border bg-muted/50 p-4" aria-labelledby="cancellation-policy-heading">
                <h3 id="cancellation-policy-heading" class="text-sm font-medium text-foreground">Cancellation policy</h3>
                <% if per_booking %>
                  <p class="text-sm text-muted-foreground">Policy applied per booking. Each selected booking is charged its own cancellation fee, and its own refund balance is worked out from what that guest has paid.</p>
                <% else %>
                  <dl class="space-y-1 text-sm">
                    <div class="flex items-center justify-between gap-4">
                      <dt class="text-muted-foreground">Cancellation fee</dt>
                      <dd class="font-medium tabular-nums"><%= booking.hotel.default_currency %> <%= number_with_precision(quote.fee_amount, precision: 2, delimiter: ",") %></dd>
                    </div>
                    <div class="flex items-center justify-between gap-4">
                      <dt class="text-muted-foreground">Paid to date</dt>
                      <dd class="tabular-nums"><%= booking.hotel.default_currency %> <%= number_with_precision(quote.amount_paid, precision: 2, delimiter: ",") %></dd>
                    </div>
                    <div class="flex items-center justify-between gap-4">
                      <dt class="text-muted-foreground">Refund due</dt>
                      <dd class="font-medium tabular-nums"><%= booking.hotel.default_currency %> <%= number_with_precision(quote.refund_amount, precision: 2, delimiter: ",") %></dd>
                    </div>
                  </dl>
                  <p class="text-xs text-muted-foreground">Cancelled <%= pluralize(quote.days_out, "day") %> before arrival. The fee is pre-tax — taxes post separately from the room revenue rules. Any refund is returned through the deposit or refund request it was taken on.</p>
                <% end %>

                <%= render PanelsUI::RadioGroup.new(
                      form: f, attribute: :charge_fee,
                      label: "Cancellation fee",
                      size: :sm,
                      orientation: :horizontal,
                      selected: params[:charge_fee].presence || "true",
                      options: [
                        { label: "Charge the fee", value: "true" },
                        { label: "Waive the fee", value: "false" }
                      ]) %>
              </section>
            <% end %>

            <div class="mt-5">
              <%= render PanelsUI::FormField.new(form: f, attribute: :cancellation_reason, label: "Cancellation reason", required: true) do |field| %>
                <% field.with_text_area(value: params[:cancellation_reason], rows: 5, placeholder: "Explain why this reservation is being cancelled.") %>
              <% end %>
            </div>
          </div>
          <% if group %></div><% end %>
        </div>
        <div class="flex items-center justify-end gap-2 border-t border-border px-6 py-4">
          <%= render PanelsUI::Button.new(as: :button, type: :button, variant: :ghost, data: { action: "panels-ui--sheet#close" }) do %>Cancel<% end %>
          <%= render PanelsUI::Button.new(as: :button, type: :submit, variant: :destructive, data: { turbo_submits_with: "Cancelling…" }) do %>Confirm cancellation<% end %>
        </div>
      <% end %>
    <% end %>
  <% end %>
</div>
