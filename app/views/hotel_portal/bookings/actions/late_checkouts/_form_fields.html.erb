<div class="space-y-3 border-b border-border pb-4">
  <label class="block text-[11px] font-bold uppercase tracking-wider text-muted-foreground">Do you approve this booking late checkout?</label>
  <div class="flex flex-col gap-4">
    <label class="group flex cursor-pointer items-center gap-3">
      <%= form.radio_button :charge_type, "charge", checked: true,
          class: "sr-only",
          data: { action: "change->booking-actions--late-checkout#updateUI", "booking-actions--late-checkout-target": "toggleRadio" } %>
      <div class="flex size-4 flex-shrink-0 items-center justify-center rounded-full border border-border-interactive transition-colors group-has-[input:checked]:border-amber-600 group-has-[input:checked]:bg-amber-600">
        <div class="size-1.5 rounded-full bg-card opacity-0 transition-opacity group-has-[input:checked]:opacity-100"></div>
      </div>
      <span class="text-sm font-bold text-foreground">Yes, approve with charges.</span>
    </label>
    <label class="group flex cursor-pointer items-center gap-3">
      <%= form.radio_button :charge_type, "none",
          class: "sr-only",
          data: { action: "change->booking-actions--late-checkout#updateUI", "booking-actions--late-checkout-target": "toggleRadio" } %>
      <div class="flex size-4 flex-shrink-0 items-center justify-center rounded-full border border-border-interactive transition-colors group-has-[input:checked]:border-amber-600 group-has-[input:checked]:bg-amber-600">
        <div class="size-1.5 rounded-full bg-card opacity-0 transition-opacity group-has-[input:checked]:opacity-100"></div>
      </div>
      <span class="text-sm font-bold text-muted-foreground">No, reject it</span>
    </label>
  </div>
</div>

<div data-booking-actions--late-checkout-target="chargeSection" class="space-y-6">
  <div class="space-y-4">
    <label class="block text-[11px] font-bold uppercase tracking-wider text-muted-foreground">Charge calculation</label>
    <div class="grid grid-cols-1 gap-4">
      <label class="group relative flex cursor-pointer flex-col overflow-hidden rounded-2xl border border-border bg-card shadow-sm focus:outline-none has-[input:checked]:border-amber-600 has-[input:checked]:ring-1 has-[input:checked]:ring-amber-600">
        <%= form.radio_button :charge_calculation, "standard", checked: true,
            class: "sr-only peer",
            data: { action: "change->booking-actions--late-checkout#updateUI", "booking-actions--late-checkout-target": "typeRadio" } %>
        <div class="flex items-start gap-3 p-4">
          <div class="mt-1 flex size-4 flex-shrink-0 items-center justify-center rounded-full border border-border-interactive transition-colors group-has-[input:checked]:border-amber-600 group-has-[input:checked]:bg-amber-600">
            <div class="size-1.5 rounded-full bg-card opacity-0 transition-opacity group-has-[input:checked]:opacity-100"></div>
          </div>
          <div class="flex-1">
            <span class="block text-sm font-bold text-foreground">Current rate charge</span>
            <p class="mt-1 text-xs leading-relaxed text-muted-foreground">Current booking property rate for the extended date including taxes.</p>
          </div>
        </div>
        <div class="hidden border-t border-border bg-muted/50 p-4 peer-checked:block">
          <div class="flex items-center justify-between">
            <span class="text-xs font-semibold text-muted-foreground">Total charge</span>
            <span class="text-sm font-bold text-foreground"><%= presenter.currency %> <%= number_with_precision(presenter.suggested_late_checkout_amount, precision: 2) %></span>
          </div>
        </div>
      </label>

      <label class="group relative flex cursor-pointer flex-col overflow-hidden rounded-2xl border border-border bg-card shadow-sm focus:outline-none has-[input:checked]:border-amber-600 has-[input:checked]:ring-1 has-[input:checked]:ring-amber-600">
        <%= form.radio_button :charge_calculation, "custom",
            class: "sr-only peer",
            data: { action: "change->booking-actions--late-checkout#updateUI", "booking-actions--late-checkout-target": "typeRadio" } %>
        <div class="flex items-start gap-3 p-4">
          <div class="mt-1 flex size-4 flex-shrink-0 items-center justify-center rounded-full border border-border-interactive transition-colors group-has-[input:checked]:border-amber-600 group-has-[input:checked]:bg-amber-600">
            <div class="size-1.5 rounded-full bg-card opacity-0 transition-opacity group-has-[input:checked]:opacity-100"></div>
          </div>
          <div class="flex-1">
            <span class="block text-sm font-bold text-foreground">Additional charge</span>
            <p class="mt-1 text-xs leading-relaxed text-muted-foreground">Impose an additional charge on the current property rate for the extended date including taxes.</p>
          </div>
        </div>
        <div class="hidden space-y-4 border-t border-border bg-muted/50 p-4 peer-checked:block" data-booking-actions--late-checkout-target="customSection">
          <div class="grid grid-cols-2 gap-4">
            <div>
              <label class="mb-2 block text-[10px] font-bold uppercase tracking-wider text-muted-foreground">Adjustment type</label>
              <%= form.select :custom_type, [ [ "Fixed Amount", "amount" ], [ "Percentage (%)", "percentage" ] ], {},
                  class: "w-full rounded-xl border border-border bg-card px-3 py-2 text-xs font-medium text-foreground focus:border-ring focus:ring-ring",
                  data: { action: "change->booking-actions--late-checkout#updateCalculation", "booking-actions--late-checkout-target": "customType" } %>
            </div>
            <div>
              <label class="mb-2 block text-[10px] font-bold uppercase tracking-wider text-muted-foreground">Amount / %</label>
              <%= form.number_field :custom_value, step: 0.01, placeholder: "0.00",
                  class: "w-full rounded-xl border border-border bg-card px-3 py-2 text-xs font-medium text-foreground focus:border-ring focus:ring-ring",
                  data: { action: "input->booking-actions--late-checkout#updateCalculation", "booking-actions--late-checkout-target": "customValue" } %>
            </div>
          </div>
          <div class="flex items-center justify-between border-t border-border pt-2">
            <div class="flex flex-col">
              <span class="text-[10px] font-bold uppercase text-muted-foreground">Calculated total</span>
              <span class="text-[10px] font-medium text-muted-foreground">Rate + taxes + adjustment</span>
            </div>
            <span class="text-sm font-bold text-foreground" data-booking-actions--late-checkout-target="displayAmount"><%= presenter.currency %> 0.00</span>
          </div>
        </div>
      </label>
    </div>
  </div>
</div>

<%= form.hidden_field :amount, data: { "booking-actions--late-checkout-target": "amountInput" } %>

<div data-booking-actions--late-checkout-target="checkoutSection" class="space-y-3 border-b border-border pb-4">
  <label class="block text-[11px] font-bold uppercase tracking-wider text-muted-foreground">Checkout period</label>
  <%= form.datetime_local_field :check_out, value: booking.check_out.in_time_zone(booking.hotel.hotel_time_zone).strftime("%Y-%m-%dT%H:%M"),
      class: "w-full rounded-xl border border-border bg-card px-4 py-2.5 text-sm text-foreground focus:border-ring focus:ring-ring" %>
  <p class="text-[10px] text-muted-foreground">Updating this will change the booking's scheduled checkout date and time.</p>
</div>
