<% ns = local_assigns.fetch(:ns) %>
<% checkout_booking = local_assigns.fetch(:checkout_booking) %>
<% sheet = local_assigns.fetch(:sheet) %>
<% row = local_assigns.fetch(:row) %>
<% form_state = local_assigns.fetch(:form_state) %>
<% booking_visible = local_assigns.fetch(:booking_visible, true) %>
<% bordered = local_assigns.fetch(:bordered, true) %>
<% badge_tones = { "emerald" => :success, "amber" => :warning, "rose" => :destructive, "slate" => :neutral } %>
<% exception_actions = HotelPortal::Bookings::Actions::Checkouts::SheetPresenter::EXCEPTION_ACTIONS %>
<% values = form_state.folio_values(checkout_booking, row) %>
<% field_scope = "checkout_bookings[#{checkout_booking.id}][folios][#{row.folio.id}]" %>
<% single_action = row.action_options.one? %>
<% credit_exposure = local_assigns[:credit_exposure] %>

<article class="<%= bordered ? 'rounded-lg border border-border bg-card p-3' : 'py-3' %> <%= 'hidden' unless booking_visible %>"
         data-<%= ns %>-target="bookingRow folioRow"
         data-booking-id="<%= checkout_booking.id %>"
         data-folio-id="<%= row.folio.id %>">
  <div class="flex items-center gap-3">
    <span class="min-w-0 flex-1">
      <span class="block truncate text-sm font-medium"><%= row.name %></span>
      <span class="mt-0.5 block truncate text-xs text-muted-foreground"><%= row.folio.folio_reference_display %> · <%= row.payer_label %></span>
    </span>
    <span class="shrink-0 text-sm font-semibold tabular-nums"><%= sheet.money(row.balance) %></span>
    <%= render PanelsUI::Badge.new(label: row.status_label, variant: badge_tones.fetch(row.status_tone, :neutral), size: :sm) %>
  </div>

  <%= fields_for field_scope, OpenStruct.new(values) do |folio_form| %>
    <%= folio_form.hidden_field :amount, value: values[:amount] %>
    <%= folio_form.hidden_field :action, value: values[:action] if single_action %>

    <div class="mt-3 grid gap-3 sm:grid-cols-2 sm:items-start">
      <%= render PanelsUI::FormField.new(
            form: folio_form,
            attribute: :action,
            label: "Resolution",
            disabled: single_action || !booking_visible,
            size: :sm) do |field| %>
        <% field.with_select_menu(
             row.action_options,
             selected: values[:action],
             data: {
               "#{ns}-target": "actionControl",
               folio_id: row.folio.id,
               permanent_disabled: single_action,
               action: "change->#{ns}#updateSettlementDetails"
             }) %>
      <% end %>

      <div class="min-w-0">
        <div class="<%= 'hidden' unless values[:action] == 'pay_now' %>" data-<%= ns %>-target="paymentFields">
          <div class="grid gap-3 sm:grid-cols-2">
            <div data-conditional-required="true">
              <%= render PanelsUI::FormField.new(form: folio_form, attribute: :payment_method, label: "Payment method", size: :sm, disabled: !booking_visible) do |field| %>
                <% field.with_select_menu(sheet.payment_method_options, selected: values[:payment_method]) %>
              <% end %>
            </div>
            <%= render PanelsUI::FormField.new(form: folio_form, attribute: :payment_reference, label: "Payment reference", hint: "Optional.", size: :sm, disabled: !booking_visible) do |field| %>
              <% field.with_input(value: values[:payment_reference], placeholder: "e.g. receipt no.") %>
            <% end %>
          </div>
        </div>

        <div class="<%= 'hidden' unless exception_actions.include?(values[:action]) %>" data-<%= ns %>-target="reasonFields">
          <div data-conditional-required="true">
            <%= render PanelsUI::FormField.new(form: folio_form, attribute: :reason, label: "Reason", hint: "Why this folio cannot be closed at checkout.", size: :sm, disabled: !booking_visible) do |field| %>
              <% field.with_input(value: values[:reason], placeholder: "e.g. awaiting manager approval") %>
            <% end %>
          </div>
        </div>

        <div class="<%= 'hidden' unless values[:action] == 'direct_bill' %>" data-<%= ns %>-target="directBillFields">
          <%= render PanelsUI::Alert.new(tone: credit_exposure&.warning? ? :warning : :info, title: "Direct bill") do |alert| %>
            <% alert.with_description do %>
              AR invoice issued to <%= row.folio.hotel_corporate_account&.corporate_account&.name || "the company account" %>.
              <% if credit_exposure&.warning? %><span class="mt-1 block"><%= credit_exposure.warning_message %></span><% end %>
            <% end %>
          <% end %>

          <% if credit_exposure&.requires_override? && current_user.has_permission?(ArInvoices::AuthorizeCreditExposure::PERMISSION, hotel: current_hotel) %>
            <div class="mt-3 space-y-3">
              <%= render PanelsUI::Checkbox.new(
                    form: folio_form,
                    attribute: :credit_override,
                    label: "Override corporate credit control",
                    description: "Confirms that an authorized exception has been approved.",
                    checked: ActiveModel::Type::Boolean.new.cast(values[:credit_override]),
                    size: :sm,
                    disabled: !booking_visible) %>
              <%= render PanelsUI::FormField.new(
                    form: folio_form,
                    attribute: :credit_override_reason,
                    label: "Override reason",
                    hint: "Required when overriding the credit control.",
                    size: :sm,
                    disabled: !booking_visible) do |field| %>
                <% field.with_input(value: values[:credit_override_reason], placeholder: "e.g. approved by finance manager") %>
              <% end %>
            </div>
          <% end %>
        </div>
      </div>
    </div>

    <div class="mt-2 flex justify-end">
      <%= link_to row.ledger_path, target: "_blank", rel: "noopener",
            class: "inline-flex items-center gap-1.5 text-xs font-medium text-primary hover:underline",
            data: { turbo: false } do %>
        View folio ledger
        <%= app_icon "external-link", class: "size-3.5", aria: { hidden: true } %>
      <% end %>
    </div>
  <% end %>
</article>
