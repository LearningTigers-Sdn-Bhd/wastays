<% ns = local_assigns.fetch(:ns) %>
<% sheets = local_assigns.fetch(:checkout_sheets) %>
<% form_state = local_assigns.fetch(:form_state) %>
<% group_checkout = local_assigns.fetch(:group_checkout, false) %>
<% currency = local_assigns.fetch(:currency) %>
<% checkout_business_date = local_assigns.fetch(:checkout_business_date) %>
<% any_guest_payable = sheets.values.any? { |sheet| sheet.folio_rows.any? { |row| row.folio.folio_type.to_s == "guest" && row.folio.payer_type.to_s == "guest" && row.action_options.any? { |option| option.last == "pay_now" } } } %>

<section aria-labelledby="folio-resolver-heading" class="space-y-4">
  <div class="flex flex-wrap items-start justify-between gap-3">
    <div>
      <h3 id="folio-resolver-heading" class="text-base font-semibold">Resolve folios</h3>
      <p class="mt-1 text-sm text-muted-foreground">Choose how each folio settles. Guest folios default to Pay Now.</p>
    </div>
    <% if any_guest_payable %>
      <%= render PanelsUI::Button.new(as: :button, type: :button, variant: :secondary, size: :sm,
            data: { action: "#{ns}#resolveAllGuestFolios" }) do %>
        Resolve all guest folios · Pay now / Cash
      <% end %>
    <% end %>
  </div>

  <div class="space-y-4" data-testid="folio-resolver-list">
    <% sheets.each do |checkout_booking, sheet| %>
      <% room = checkout_booking.booking_rooms.first %>
      <% booking_visible = !group_checkout || form_state.selected?(checkout_booking) %>
      <% room_type_name = room&.room_type&.name.presence || room&.room_type_snapshot.to_h["name"].presence || "Room type unavailable" %>
      <% room_number = room&.room_number.presence || "Unassigned room" %>
      <% folio_count = sheet.folio_rows.size %>
      <% early_departure = checkout_business_date < checkout_booking.check_out.to_date %>

      <% card_locals = { ns: ns, checkout_booking: checkout_booking, sheet: sheet, form_state: form_state, booking_visible: booking_visible } %>
      <% early_departure_locals = { booking: checkout_booking, currency: currency, visible: booking_visible, values: form_state.early_departure_values(checkout_booking), ns: ns } %>

      <% if group_checkout %>
        <div class="<%= 'hidden' unless booking_visible %>"
             data-<%= ns %>-target="bookingRow"
             data-booking-id="<%= checkout_booking.id %>">
          <%= render PanelsUI::Collapsible.new(
                id: "checkout-booking-#{checkout_booking.id}",
                open: true,
                heading_level: 3,
                region: true,
                class: "overflow-hidden rounded-lg border border-border bg-card",
                trigger_class: "group items-center gap-3 px-4 py-3 text-left transition-colors hover:bg-muted/50",
                content_class: "space-y-3 border-t border-border bg-muted/20 p-3"
              ) do |group_card| %>
            <% group_card.with_trigger do %>
              <span class="min-w-0 flex-1">
                <span class="block truncate text-sm font-semibold"><%= room_number %> · <%= room_type_name %></span>
                <span class="mt-0.5 block truncate text-xs text-muted-foreground"><%= checkout_booking.guest_name %></span>
              </span>
              <span class="shrink-0 text-xs text-muted-foreground tabular-nums"><%= pluralize(folio_count, "folio") %> · <%= sheet.money(sheet.booking_balance) %></span>
              <%= app_icon "chevron-down", class: "panel-collapsible__indicator size-4 shrink-0 text-muted-foreground", aria: { hidden: true } %>
            <% end %>
            <% group_card.with_body do %>
              <% if early_departure %>
                <div class="rounded-lg border border-info/40 bg-info/5 p-3">
                  <%= render "hotel_portal/bookings/actions/checkouts/early_departure", **early_departure_locals %>
                </div>
              <% end %>
              <% sheet.folio_rows.each do |row| %>
                <%= render "hotel_portal/bookings/actions/checkouts/folio_card", **card_locals, row: row %>
              <% end %>
            <% end %>
          <% end %>
        </div>
      <% else %>
        <div class="space-y-3">
          <% if early_departure %>
            <div class="rounded-lg border border-info/40 bg-info/5 p-3">
              <%= render "hotel_portal/bookings/actions/checkouts/early_departure", **early_departure_locals %>
            </div>
          <% end %>
          <% sheet.folio_rows.each do |row| %>
            <%= render "hotel_portal/bookings/actions/checkouts/folio_card", **card_locals, row: row %>
          <% end %>
        </div>
      <% end %>
    <% end %>
  </div>
</section>
