<section class="flex h-full flex-col bg-card" data-checkout-card="details">
  <div class="border-b border-border px-4 py-2.5">
    <h3 class="text-xs font-bold uppercase tracking-wider text-foreground">Checkout Details</h3>
  </div>
  <div class="flex flex-1 flex-col justify-center p-4">
    <label class="mb-1.5 block text-[10px] font-bold uppercase tracking-wider text-muted-foreground">Check-out date &amp; time</label>
    <%= form.datetime_local_field :checked_out_at,
        value: presenter.checked_out_at_form_value,
        required: booking.checkout_required?,
        class: "w-full rounded-md border border-border-interactive bg-card px-3 py-2 text-sm font-semibold text-foreground shadow-sm focus:border-ring focus:outline-none focus:ring-0" %>
    <p class="mt-2 text-[11px] text-muted-foreground">Scheduled checkout: <span class="font-semibold text-foreground"><%= booking.check_out.strftime("%d %b %Y") %></span></p>
  </div>
</section>
