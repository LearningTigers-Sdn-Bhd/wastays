<% release_enabled = form_state.release_security_deposit? %>

<section aria-labelledby="security-deposit-heading" class="space-y-4" data-controller="payment-toggle">
  <div class="flex flex-wrap items-start justify-between gap-4">
    <div>
      <h3 id="security-deposit-heading" class="text-base font-semibold">Security deposit</h3>
      <p class="mt-1 text-sm text-muted-foreground"><%= currency %> <%= format("%.2f", deposits.sum { |deposit| deposit.amount.to_d }) %> is held separately from the folios.</p>
    </div>
    <%= render PanelsUI::Switch.new(
          name: "release_security_deposit",
          checked: release_enabled,
          label: "Return at checkout",
          data: { payment_toggle_target: "checkbox", action: "change->payment-toggle#toggle" }) %>
  </div>

  <div class="grid gap-4 sm:grid-cols-2 <%= 'opacity-50' unless release_enabled %>" data-payment-toggle-target="container">
    <%= fields_for "", OpenStruct.new(
          security_deposit_release_method: form_state.security_deposit_release_method,
          security_deposit_release_reference: form_state.security_deposit_release_reference) do |deposit_form| %>
      <div data-payment-toggle-target="field">
        <%= render PanelsUI::FormField.new(form: deposit_form, attribute: :security_deposit_release_method, label: "Return method", disabled: !release_enabled) do |field| %>
          <% field.with_select_menu(
               checkout_sheets.values.first.security_deposit_release_method_options,
               selected: form_state.security_deposit_release_method) %>
        <% end %>
      </div>
      <div data-payment-toggle-target="field">
        <%= render PanelsUI::FormField.new(
              form: deposit_form,
              attribute: :security_deposit_release_reference,
              label: "Reference",
              hint: "Optional receipt or return reference.",
              disabled: !release_enabled) do |field| %>
          <% field.with_input(value: form_state.security_deposit_release_reference, placeholder: "e.g. receipt or return ref") %>
        <% end %>
      </div>
    <% end %>
  </div>
</section>
