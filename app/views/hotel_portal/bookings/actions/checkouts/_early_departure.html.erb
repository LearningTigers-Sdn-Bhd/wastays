<% ns = local_assigns.fetch(:ns) %>
<% ed = "booking-actions--early-departure" %>
<% nights = (booking.check_out.to_date - booking.check_in.to_date).to_i %>
<% suggested_charge = nights.positive? ? (booking.total_amount.to_d / nights).round(2) : 0 %>
<% field_prefix = "early_departures[#{booking.id}]" %>
<% visible = local_assigns.fetch(:visible, true) %>

<section class="flex h-full flex-col bg-card <%= "hidden" unless visible %>"
         data-checkout-card="early-departure"
         data-<%= ns %>-target="bookingRow"
         data-booking-id="<%= booking.id %>"
         data-controller="<%= ed %>"
         data-<%= ed %>-booking-id-value="<%= booking.id %>"
         data-<%= ed %>-base-amount-value="<%= suggested_charge %>"
         data-<%= ed %>-currency-value="<%= currency %>"
         data-<%= ed %>-event-prefix-value="<%= ns %>"
         data-<%= ed %>-target-folio-id-value="<%= checkout_penalty_folio_id(booking) %>">
  <div class="flex items-center justify-between gap-2 border-b border-border px-4 py-2.5">
    <h3 class="text-xs font-bold uppercase tracking-wider text-foreground">Early Departure</h3>
    <span class="rounded-md bg-blue-50 px-1.5 py-0.5 text-[9px] font-bold uppercase tracking-wider text-blue-700">Early</span>
  </div>
  <div class="flex flex-1 flex-col p-4">
    <div class="flex flex-wrap items-center justify-between gap-2">
      <p class="text-[11px] text-muted-foreground">
        <% if booking.group_booking_id.present? %>
          <span class="font-semibold text-foreground"><%= booking.booking_rooms.first&.room_number.presence || "Unassigned room" %></span> ·
        <% end %>
        Scheduled checkout: <span class="font-semibold text-foreground"><%= booking.check_out.strftime("%d %b %Y") %></span>
      </p>
      <div class="grid grid-cols-2 gap-1.5">
        <label class="cursor-pointer rounded-md border border-border-interactive bg-card px-3 py-2 text-center transition has-[:checked]:border-blue-600 has-[:checked]:bg-blue-50 has-[:checked]:text-blue-800">
          <%= radio_button_tag "#{field_prefix}[apply_charge]", "false", true, disabled: !visible, class: "sr-only", data: { action: "change->#{ed}#updateUI", "#{ed}-target": "chargeChoice" } %>
          <span class="text-[11px] font-bold">No charge</span>
        </label>
        <label class="cursor-pointer rounded-md border border-border-interactive bg-card px-3 py-2 text-center transition has-[:checked]:border-blue-600 has-[:checked]:bg-blue-50 has-[:checked]:text-blue-800">
          <%= radio_button_tag "#{field_prefix}[apply_charge]", "true", false, disabled: !visible, class: "sr-only", data: { action: "change->#{ed}#updateUI", "#{ed}-target": "chargeChoice" } %>
          <span class="text-[11px] font-bold">Apply early departure charge</span>
        </label>
      </div>
    </div>
    <p class="mt-2 text-[11px] leading-relaxed text-muted-foreground">Guest is checking out before the scheduled date. Pending charges will post when checkout is completed.</p>

    <div class="mt-3 hidden border-t border-border pt-3" data-<%= ed %>-target="customFields">
      <div class="grid grid-cols-1 items-end gap-2 sm:grid-cols-[1fr_1fr_auto]">
        <div>
          <label class="mb-1 block text-[9px] font-bold uppercase tracking-wider text-muted-foreground">Charge type</label>
          <%= select_tag "#{field_prefix}[type]", options_for_select([ [ "Fixed Amount", "amount" ], [ "Percentage (%)", "percentage" ] ], "amount"),
              disabled: !visible,
              class: "w-full rounded-md border border-border-interactive bg-card px-2.5 py-2 text-xs font-semibold text-foreground focus:border-ring focus:outline-none",
              data: { action: "change->#{ed}#updateCalculation" } %>
        </div>
        <div>
          <label class="mb-1 block text-[9px] font-bold uppercase tracking-wider text-muted-foreground">Value</label>
          <%= number_field_tag "#{field_prefix}[value]", nil, step: 0.01, placeholder: "0.00",
              disabled: !visible,
              class: "w-full rounded-md border border-border-interactive bg-card px-2.5 py-2 text-xs font-semibold text-foreground focus:border-ring focus:outline-none",
              data: { action: "input->#{ed}#updateCalculation" } %>
        </div>
        <div class="min-w-28 rounded-md bg-muted px-3 py-2 text-right">
          <p class="text-[9px] font-bold uppercase tracking-wider text-muted-foreground">Total charge</p>
          <p class="text-xs font-bold tabular-nums text-foreground" data-<%= ed %>-target="displayAmount"><%= currency %> 0.00</p>
        </div>
      </div>
      <%= hidden_field_tag "#{field_prefix}[charge_amount]", 0, disabled: !visible, data: { "#{ed}-target": "amountInput" } %>
    </div>
  </div>
</section>
