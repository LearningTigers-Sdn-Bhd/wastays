<% ns = local_assigns.fetch(:ns) %>
<% values = local_assigns.fetch(:values) %>
<% early_departure = "booking-actions--early-departure" %>
<% nights = (booking.check_out.to_date - booking.check_in.to_date).to_i %>
<% suggested_charge = nights.positive? ? (booking.total_amount.to_d / nights).round(2) : 0 %>
<% field_scope = "early_departures[#{booking.id}]" %>
<% visible = local_assigns.fetch(:visible, true) %>
<% room = booking.booking_rooms.first %>

<article class="space-y-3 <%= 'hidden' unless visible %>"
         data-<%= ns %>-target="bookingRow"
         data-booking-id="<%= booking.id %>"
         data-controller="<%= early_departure %>"
         data-<%= early_departure %>-booking-id-value="<%= booking.id %>"
         data-<%= early_departure %>-base-amount-value="<%= suggested_charge %>"
         data-<%= early_departure %>-currency-value="<%= currency %>"
         data-<%= early_departure %>-event-prefix-value="<%= ns %>"
         data-<%= early_departure %>-target-folio-id-value="<%= checkout_penalty_folio_id(booking) %>">
  <%= fields_for field_scope, OpenStruct.new(values) do |departure_form| %>
    <div class="flex flex-wrap items-center justify-between gap-x-4 gap-y-2">
      <div class="min-w-0">
        <h4 class="text-sm font-medium">
          <%= room&.room_number.presence || "Unassigned room" %> · <%= booking.guest_name %>
          <span class="ml-2 align-middle"><%= render PanelsUI::Badge.new(label: "Early departure", variant: :info, size: :sm) %></span>
        </h4>
        <p class="mt-0.5 text-xs text-muted-foreground">Scheduled checkout: <%= booking.check_out.strftime("%d %b %Y") %></p>
      </div>

      <%= render PanelsUI::RadioGroup.new(
            form: departure_form,
            attribute: :apply_charge,
            label: "Early-departure charge",
            selected: values[:apply_charge],
            disabled: !visible,
            orientation: :horizontal,
            size: :sm,
            class: "shrink-0 [&_legend]:sr-only",
            options: [
              { label: "No additional charge", value: "false" },
              { label: "Apply a charge", value: "true" }
            ],
            data: { action: "change->#{early_departure}#updateUI" }) %>
    </div>

    <div class="space-y-3 <%= 'hidden' unless values[:apply_charge] == 'true' %>" data-<%= early_departure %>-target="customFields">
      <div class="grid gap-4 sm:grid-cols-[minmax(0,12rem)_minmax(0,12rem)_1fr] sm:items-end">
        <%= render PanelsUI::FormField.new(form: departure_form, attribute: :type, label: "Charge type", size: :sm, disabled: !visible) do |field| %>
          <% field.with_select_menu(
               [ [ "Fixed amount", "amount" ], [ "Percentage (%)", "percentage" ] ],
               selected: values[:type],
               data: { action: "change->#{early_departure}#updateCalculation" }) %>
        <% end %>
        <%= render PanelsUI::FormField.new(form: departure_form, attribute: :value, label: "Value", size: :sm, disabled: !visible) do |field| %>
          <% field.with_input(type: :number, value: values[:value], min: 0, step: 0.01, placeholder: "0.00", data: { action: "input->#{early_departure}#updateCalculation" }) %>
        <% end %>
        <div class="flex items-center justify-end gap-2 pb-1">
          <span class="text-sm text-muted-foreground">Additional charge</span>
          <span class="text-sm font-medium tabular-nums" data-<%= early_departure %>-target="displayAmount"><%= currency %> <%= format("%.2f", values[:charge_amount].to_d) %></span>
        </div>
      </div>
    </div>
    <%= departure_form.hidden_field :charge_amount, value: values[:charge_amount], data: { "#{early_departure}-target": "amountInput" } %>
  <% end %>
</article>
