<%= turbo_frame_tag(turbo_frame_request_id.presence || "booking_action_sheet") do %>
  <div data-controller="panels-ui--sheet-frame">
    <%= render PanelsUI::Sheet.new(
          id: "booking-no-show-folio-repair-sheet",
          side: :right,
          size: :lg,
          title: "Repair no-show folio",
          description: @booking.guest_name,
          body_class: "p-0") do |sheet| %>
      <% sheet.with_body do %>
        <% if @tourism_tax_charges.any? %>
          <%= form_with url: hotel_booking_action_repair_no_show_folio_path(current_hotel, @booking), method: :post, class: "flex h-full min-h-0 flex-col" do %>
            <%= hidden_field_tag :return_to, @return_to if @return_to.present? %>
            <div class="min-h-0 flex-1 overflow-y-auto">
              <div class="space-y-5 p-6">
                <%= render PanelsUI::Alert.new(tone: :warning) do |alert| %>
                  <% alert.with_description do %>
                    This posts an audited correction for tourism tax charged when this booking was marked as a no-show. Other no-show charges and taxes remain unchanged.
                  <% end %>
                <% end %>

                <section class="rounded-2xl border border-border p-5">
                  <div class="flex items-center justify-between gap-4">
                    <span class="text-sm font-semibold text-muted-foreground">Tourism tax to remove</span>
                    <span class="text-base font-bold text-foreground"><%= @booking.currency %> <%= format("%.2f", @tourism_tax_total) %></span>
                  </div>
                </section>

                <div class="space-y-3">
                  <% @projected_balances.each do |folio, projected_balance| %>
                    <div class="rounded-xl border border-border p-4">
                      <div class="flex items-center justify-between gap-4">
                        <span class="text-sm font-bold text-foreground"><%= folio.display_name %></span>
                        <span class="text-sm font-semibold text-foreground"><%= folio.currency %> <%= format("%.2f", projected_balance) %></span>
                      </div>
                      <p class="mt-1 text-xs font-medium text-muted-foreground">
                        <%= projected_balance.zero? ? "This folio will close after the correction." : "This folio will remain open because its projected balance is not zero." %>
                      </p>
                    </div>
                  <% end %>
                </div>
              </div>
            </div>
            <div class="flex items-center justify-end gap-2 border-t border-border px-6 py-4">
              <%= render PanelsUI::Button.new(as: :button, type: :button, variant: :ghost, data: { action: "panels-ui--sheet#close" }) do %>Cancel<% end %>
              <%= render PanelsUI::Button.new(as: :button, type: :submit, variant: :warning, data: { turbo_submits_with: "Removing…" }) do %>Remove tourism tax<% end %>
            </div>
          <% end %>
        <% else %>
          <div class="p-6">
            <div class="rounded-xl border border-border bg-muted p-4 text-sm text-muted-foreground">This booking has no no-show tourism tax to repair.</div>
            <div class="mt-5 flex justify-end">
              <%= render PanelsUI::Button.new(as: :button, type: :button, variant: :ghost, data: { action: "panels-ui--sheet#close" }) do %>Close<% end %>
            </div>
          </div>
        <% end %>
      <% end %>
    <% end %>
  </div>
<% end %>
