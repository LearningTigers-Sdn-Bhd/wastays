<%# One booking-creation room row. locals: index (String), values (Hash).
    Rate plan and room number start with a placeholder choice and are repopulated
    at runtime through SelectMenu#replaceOptions after the availability/rate AJAX
    resolves — no native <select>, no <template> cloning. %>
<% values = local_assigns.fetch(:values, {}).symbolize_keys %>
<% allow_deferred_room = local_assigns.fetch(:allow_deferred_room, true) %>
<% room_type_choices = @room_types.map { |room_type| [ room_type.name, room_type.id ] }.presence || [ [ "No room types available", "" ] ] %>
<% popover_index = index.to_s.parameterize(separator: "-").presence || "0" %>
<div class="grid grid-cols-[1.4fr_1.5fr_1fr_.55fr_.55fr_1fr_36px] items-center gap-1.5 border-b border-border px-3 py-3 last:border-b-0"
     data-booking-room-rows-target="row"
     data-preserved-room-type="<%= values[:room_type_id] %>"
     data-preserved-rate-plan="<%= values[:rate_plan_id] %>"
     data-preserved-room-number="<%= values[:room_number] %>">
  <%= fields_for "booking[rooms][#{index}]", BookingRoom.new do |rf| %>
    <div class="min-w-0" data-role="room-type">
      <%= render PanelsUI::FormField.new(form: rf, attribute: :room_type_id, label: "Room type", label_hidden: true, class: "min-w-0") do |field| %>
        <% field.with_select_menu(
             room_type_choices,
             selected: values[:room_type_id],
             prompt: "Select type",
             class: "min-w-0",
             data: { action: "change->booking-room-rows#roomTypeChanged" }) %>
      <% end %>
    </div>
    <div class="min-w-0" data-role="rate-plan">
      <%= render PanelsUI::FormField.new(form: rf, attribute: :rate_plan_id, label: "Rate plan", label_hidden: true, class: "min-w-0") do |field| %>
        <% field.with_select_menu(
             [["Select type and dates", ""]],
             selected: "",
             class: "min-w-0",
             data: { action: "change->booking-room-rows#rateChanged" }) %>
      <% end %>
    </div>
    <div class="min-w-0" data-role="room-number">
      <%= render PanelsUI::FormField.new(form: rf, attribute: :room_number, label: "Room", label_hidden: true, class: "min-w-0") do |field| %>
        <% room_placeholder = allow_deferred_room ? (current_hotel.auto_assign_rooms_enabled? ? "Auto-assign" : "Select room later") : "Select room" %>
        <% field.with_select_menu(
             [[room_placeholder, ""]],
             selected: "",
             class: "min-w-0") %>
      <% end %>
    </div>
    <%# Party size drives the price on a per-guest property, so both fields
        carry a role the controller can read and re-quote from. %>
    <div class="min-w-0" data-role="adults">
      <%= render PanelsUI::FormField.new(form: rf, attribute: :adults, label: "Adults", label_hidden: true, required: true, class: "min-w-0") do |field| %>
        <% field.with_input(type: :number, value: values[:adults] || 1, min: 1,
                            data: { action: "change->booking-room-rows#occupancyChanged" }) %>
      <% end %>
    </div>
    <div class="min-w-0" data-role="children">
      <%= render PanelsUI::FormField.new(form: rf, attribute: :children, label: "Children", label_hidden: true, required: true, class: "min-w-0") do |field| %>
        <% field.with_input(type: :number, value: values[:children] || 0, min: 0,
                            data: { action: "change->booking-room-rows#occupancyChanged" }) %>
      <% end %>
    </div>
  <% end %>
  <%# Room net (excl. tax) is never typed directly — it is solved from the Rate
      cell below whenever that is priced by hand, and carried here only so the
      form submits it. %>
  <% if rate_override_allowed? %>
    <%= hidden_field_tag "booking[rooms][#{index}][manual_rate_override]", values[:manual_rate_override],
          data: { role: "manual-rate-override" } %>
  <% end %>
  <div class="flex items-center justify-end gap-1 text-right text-sm font-semibold tabular-nums text-foreground">
    <%# For stays sold at a price the rate plan does not produce — an OTA that
        quotes the hotel its net payout, most often — staff type the final total
        directly and the room charge and tax are worked out from it. %>
    <% if rate_override_allowed? %>
      <input type="number" step="0.01" min="0" data-role="rate"
             aria-label="Total, tax included — click to edit"
             class="w-20 rounded border border-transparent bg-transparent px-1 py-0.5 text-right tabular-nums text-foreground hover:border-border-interactive focus:border-border-interactive focus:outline-none focus:ring-0"
             data-action="input->booking-room-rows#totalOverrideChanged" value="0.00" />
    <% else %>
      <span data-role="rate">0.00</span>
    <% end %>
    <%= render PanelsUI::Popover.new(
          id: "booking-room-rate-breakdown-#{popover_index}",
          placement: :left,
          trigger_on: :hover,
          delay: 100,
          close_delay: 150,
          class: "w-72 p-0") do |popover| %>
      <% popover.with_trigger(
           unstyled: true,
           aria_label: "Show rate breakdown",
           class: "inline-flex size-6 items-center justify-center rounded text-muted-foreground hover:bg-muted hover:text-foreground focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring") do %>
        <%= cached_icon("info", class: "size-3.5") %>
      <% end %>
      <div class="w-72 text-left font-normal tabular-nums" data-role="price-breakdown">
        <div class="border-b border-border px-3 py-2.5">
          <p class="text-sm font-semibold text-foreground">Rate breakdown</p>
          <p class="mt-0.5 text-xs text-muted-foreground" data-role="breakdown-status">Select a room type, dates, and rate plan.</p>
        </div>
        <div class="hidden space-y-3 px-3 py-2.5 text-xs" data-role="breakdown-details">
          <p class="hidden rounded-md bg-muted px-2 py-1.5 text-[11px] font-medium text-muted-foreground" data-role="manual-note">Priced manually — room charge and tax are calculated back from this total.</p>
          <div class="space-y-1" data-role="nightly-breakdown"></div>
          <div class="space-y-1 border-t border-border pt-2" data-role="tax-breakdown"></div>
          <div class="flex items-center justify-between gap-3 border-t border-border pt-2 text-sm font-semibold text-foreground">
            <span>Total</span>
            <span class="whitespace-nowrap" data-role="breakdown-total">MYR 0.00</span>
          </div>
          <div class="hidden items-center justify-between gap-3 rounded-md bg-warning/10 px-2 py-1.5 text-warning-foreground" data-role="tourism-tax-breakdown">
            <span>Tourism tax (collect at check-in)</span>
            <span class="whitespace-nowrap font-medium" data-role="tourism-tax-amount">MYR 0.00</span>
          </div>
        </div>
      </div>
    <% end %>
  </div>
  <button type="button" class="rounded text-muted-foreground hover:bg-destructive/10 hover:text-destructive disabled:invisible" aria-label="Remove room" data-role="remove" data-action="booking-room-rows#remove"><%= cached_icon("x", class: "size-4 mx-auto") %></button>
</div>
