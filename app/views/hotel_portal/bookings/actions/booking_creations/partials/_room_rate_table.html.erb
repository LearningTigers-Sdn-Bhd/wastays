<%# Compact repeating-row table. Each row is server-rendered (partial: room_row)
    so its PanelsUI SelectMenus are real controls Stimulus hydrates on insertion;
    "Add room" fetches a fresh row from bookings/room_rows. Density is deliberate
    — it minimizes dialog scrolling. %>
<section class="space-y-4">
  <div class="flex items-center justify-between gap-4">
    <div>
      <h3 class="text-base font-semibold text-foreground">Room &amp; rate</h3>
      <p class="mt-1 text-sm text-muted-foreground">Every row creates one room booking.</p>
      <% if @booking.errors.any? %><p class="mt-2 text-xs font-semibold text-destructive"><%= @booking.errors.full_messages.to_sentence %></p><% end %>
    </div>
    <button type="button" class="rounded-md border border-border bg-card px-3 py-2 text-xs font-bold text-foreground hover:bg-muted" data-action="booking-room-rows#add">Add room</button>
  </div>
  <div class="overflow-x-auto rounded-md border border-border">
    <div class="min-w-[920px]">
      <div class="grid grid-cols-[1.4fr_1.5fr_1fr_.55fr_.55fr_1fr_36px] gap-1.5 border-b border-border bg-muted px-3 py-2 text-[10px] font-bold uppercase tracking-wider text-muted-foreground">
        <span>Room type</span><span>Rate plan</span><span>Room</span><span>Adult</span><span>Child</span>
        <span>Rate (MYR, tax inc.)<% if rate_override_allowed? %> <span class="normal-case font-normal text-muted-foreground/80">· click to edit</span><% end %></span>
        <span></span>
      </div>
      <div data-booking-room-rows-target="rows">
        <% (@initial_room_rows.presence || [ {} ]).each_with_index do |values, index| %>
          <%= render "hotel_portal/bookings/actions/booking_creations/partials/room_row",
                index: index.to_s,
                values: values,
                allow_deferred_room: allow_deferred_room %>
        <% end %>
      </div>
    </div>
  </div>
</section>
