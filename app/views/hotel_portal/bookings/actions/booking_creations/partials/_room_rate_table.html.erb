<section class="border-t border-stone-200 px-5 py-6 lg:px-7">
  <div class="flex items-center justify-between pb-4"><div><h3 class="text-sm font-bold text-stone-900">Room & rate</h3><p class="mt-0.5 text-xs text-stone-500">Every row creates one room booking.</p><% if @booking.errors.any? %><p class="mt-2 text-xs font-semibold text-red-700"><%= @booking.errors.full_messages.to_sentence %></p><% end %></div><button type="button" class="rounded-md border border-stone-300 bg-card px-3 py-2 text-xs font-bold text-stone-700 hover:bg-stone-100" data-action="booking-room-rows#add">Add room</button></div>
  <div class="overflow-x-auto border-x border-stone-200"><div class="min-w-[920px]"><div class="grid grid-cols-[1.4fr_1.5fr_1fr_.55fr_.55fr_1fr_36px] gap-3 border-y border-stone-200 bg-stone-100/70 px-1 py-2 text-[10px] font-bold uppercase tracking-wider text-stone-500"><span>Room type</span><span>Rate plan</span><span>Room</span><span>Adult</span><span>Child</span><span>Rate (MYR, tax inc.)</span><span></span></div><div data-booking-room-rows-target="rows"></div></div></div>
  <template data-booking-room-rows-target="template"><div class="grid grid-cols-[1.4fr_1.5fr_1fr_.55fr_.55fr_1fr_36px] gap-3 border-b border-stone-200 px-1 py-3" data-booking-room-rows-target="row"><select name="booking[rooms][INDEX][room_type_id]" required class="booking-form__control" data-role="room-type" data-action="change->booking-room-rows#roomTypeChanged"><option value="">Select type</option><%= options_from_collection_for_select(@room_types, :id, :name) %></select><select name="booking[rooms][INDEX][rate_plan_id]" class="booking-form__control" data-role="rate-plan" data-action="change->booking-room-rows#rateChanged"><option value="">Select type and dates</option></select><select name="booking[rooms][INDEX][room_number]" class="booking-form__control" data-role="room-number" disabled><option value="">Select room later</option></select><input name="booking[rooms][INDEX][adults]" type="number" min="1" value="1" required class="booking-form__control"><input name="booking[rooms][INDEX][children]" type="number" min="0" value="0" required class="booking-form__control"><div class="booking-form__value justify-end" data-role="rate">0.00</div><button type="button" class="rounded text-stone-400 hover:bg-rose-50 hover:text-rose-600 disabled:invisible" aria-label="Remove room" data-role="remove" data-action="booking-room-rows#remove"><%= cached_icon("x", class: "size-4 mx-auto") %></button></div></template>
</section>
