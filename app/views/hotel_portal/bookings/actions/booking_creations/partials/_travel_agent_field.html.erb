<%# Shown while the source is Travel Agent on a reservation. The chosen agent is
    who the booking is under and who its room charges bill to; see
    Bookings::CreateStaffBooking. %>
<% f = local_assigns.fetch(:f) %>
<% travel_agent_accounts = local_assigns.fetch(:travel_agent_accounts) %>

<div class="col-span-full <%= "hidden" unless local_assigns.fetch(:visible) %>" data-booking-room-rows-target="travelAgent">
  <% if travel_agent_accounts.any? %>
    <%= render PanelsUI::FormField.new(form: f, attribute: :travel_agent_account_id, label: "Travel agent", hint: "The room and the package extras bill to this agent.", class: "w-full min-w-0 max-w-full") do |field| %>
      <% field.with_combobox(
           travel_agent_accounts.map { |relationship| [relationship.corporate_account.name, relationship.id] },
           prompt: "Select agent",
           selected: params.dig(:booking, :travel_agent_account_id)) %>
    <% end %>
  <% else %>
    <p class="rounded-md border border-border bg-muted px-3 py-2 text-xs text-muted-foreground">No active travel agents yet. Add one under Corporate Accounts in settings to book under an agent.</p>
  <% end %>
</div>
