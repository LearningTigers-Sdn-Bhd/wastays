<div class="space-y-5" data-controller="payment-toggle">
  <p class="text-xs font-bold uppercase tracking-wider text-muted-foreground">Payment</p>
  <label class="flex items-center justify-between gap-4">
    <span>
      <span class="block text-sm font-bold text-foreground">Record payment now</span>
      <span class="mt-1 block text-xs text-muted-foreground">Otherwise payment remains pending.</span>
    </span>
    <span class="relative inline-flex shrink-0 items-center">
      <%= f.check_box :record_payment,
          class: "peer sr-only",
          aria: { label: "Record booking payment now" },
          data: { action: "change->payment-toggle#toggle", payment_toggle_target: "checkbox" } %>
      <span class="h-7 w-12 rounded-full bg-muted transition peer-checked:bg-primary peer-focus:ring-2 peer-focus:ring-ring"></span>
      <span class="absolute left-1 size-5 rounded-full bg-card shadow transition peer-checked:translate-x-5"></span>
    </span>
  </label>

  <div class="space-y-4 border-t border-border pt-5 opacity-50" data-payment-toggle-target="container">
    <%# payment-toggle disables the wrapper's inner <select> AND trigger <button>,
        which is what gates the SelectMenu, so the runtime enable/disable works. %>
    <%= render PanelsUI::FormField.new(form: f, attribute: :payment_method, label: "Payment method") do |field| %>
      <% field.with_select_menu(
           [["Cash", "cash"], ["Credit Card", "credit_card"], ["Bank Transfer", "bank_transfer"]],
           selected: "cash",
           disabled: true,
           data: { payment_toggle_target: "field" }) %>
    <% end %>
    <div>
      <%= f.label :payment_amount, "Amount (MYR)", class: "mb-1.5 block text-sm font-medium text-foreground" %>
      <%= f.number_field :payment_amount, step: 0.01, disabled: true, class: "booking-form__control", data: { booking_calc_target: "paymentAmountInput", payment_toggle_target: "field" } %>
      <p class="mt-1.5 text-[10px] text-muted-foreground">Defaults to the total if left blank.</p>
    </div>
    <div>
      <%= f.label :payment_reference, "Reference / receipt no.", class: "mb-1.5 block text-sm font-medium text-foreground" %>
      <%= f.text_field :payment_reference, placeholder: "Optional reference", disabled: true, class: "booking-form__control", data: { payment_toggle_target: "field" } %>
    </div>
  </div>
</div>
