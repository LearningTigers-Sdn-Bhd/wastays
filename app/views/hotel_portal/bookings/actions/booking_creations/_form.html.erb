<% quick = @transaction == :quick_booking %>
<% backdated = @transaction == :backdated_check_in %>
<% form_url = case @transaction
when :quick_booking then hotel_booking_action_quick_booking_path(current_hotel)
when :walk_in_check_in then hotel_booking_action_walk_in_check_in_path(current_hotel)
when :backdated_check_in then hotel_booking_action_backdated_check_in_path(current_hotel)
else hotel_booking_action_new_booking_path(current_hotel)
end %>
<% initial_type = case @transaction
when :walk_in_check_in then "walk_in"
when :backdated_check_in then "backdated_check_in"
else params.dig(:booking, :booking_type).presence || params[:booking_type].presence || "reservation"
end %>
<% sheet_title = case @transaction
when :quick_booking then "Quick Booking"
when :walk_in_check_in then "Walk-in Check-in"
when :backdated_check_in then "Backdated Check-in"
else "New Booking"
end %>
<% tz = current_hotel.hotel_time_zone %>
<% check_in_value = @booking.check_in&.in_time_zone(tz)&.strftime("%Y-%m-%dT%H:%M") %>
<% check_out_value = @booking.check_out&.in_time_zone(tz)&.strftime("%Y-%m-%dT%H:%M") %>
<% stay_range_value = "#{check_in_value}/#{check_out_value}" %>

<div data-controller="panels-ui--sheet-frame">
  <%= render PanelsUI::Sheet.new(
        id: "booking-creation-sheet",
        side: quick ? :right : :bottom,
        size: quick ? :lg : :full,
        title: sheet_title,
        body_class: "p-0") do |sheet| %>
    <% sheet.with_body do %>
      <div class="flex h-full flex-col" data-controller="booking-room-rows"
           data-booking-room-rows-availability-url-value="<%= availability_hotel_bookings_path(current_hotel) %>"
           data-booking-room-rows-rate-options-url-value="<%= rate_options_hotel_bookings_path(current_hotel) %>"
           data-booking-room-rows-price-url-value="<%= stay_price_hotel_bookings_path(current_hotel) %>"
           data-booking-room-rows-room-row-url-value="<%= room_row_hotel_bookings_path(current_hotel) %>">
        <%= form_with model: @booking, url: form_url, local: true, class: "flex min-h-0 flex-1 flex-col", id: "manual_booking_form",
              data: { controller: "booking-guest-autofill", action: "panels-ui:autocomplete-select->booking-guest-autofill#selectGuest" } do |f| %>
          <%# Backend param contract: the range picker feeds these hidden fields. %>
          <%= f.hidden_field :check_in, value: check_in_value, data: { booking_room_rows_target: "checkIn" } %>
          <%= f.hidden_field :check_out, value: check_out_value, data: { booking_room_rows_target: "checkOut" } %>

          <div class="min-h-0 flex-1 overflow-y-auto">
            <div class="grid <%= "xl:min-h-full xl:grid-cols-[minmax(0,1fr)_360px]" unless quick %>">
              <main class="min-w-0 space-y-8 p-4 lg:p-6">
                <section class="<%= quick ? "space-y-4" : "grid gap-x-3 gap-y-4 md:grid-cols-2" %>">
                  <div class="<%= "md:col-span-2" unless quick %>">
                    <h3 class="text-base font-semibold text-foreground">Stay details</h3>
                    <p class="mt-1 text-sm text-muted-foreground">When the guest stays and how the booking reached you.</p>
                  </div>
                  <div class="grid <%= quick ? "gap-4 md:grid-cols-2" : "grid-cols-3 gap-x-3 gap-y-4" %>" data-role="stay-window-fields">
                    <div class="<%= "col-span-2" unless quick %>">
                      <%= render PanelsUI::FormField.new(form: f, attribute: :stay_range, label: "Check-in → Check-out") do |field| %>
                        <% field.with_date_time_picker(
                             range: true,
                             months: 2,
                             value: stay_range_value,
                             data: { action: "change->booking-room-rows#rangeChanged" }) %>
                      <% end %>
                    </div>
                    <div class="panel-form-field" data-size="md" data-readonly="true">
                      <span id="booking_nights_label" class="panel-form-field__label">Nights</span>
                      <output class="panel-input flex items-center bg-muted font-semibold"
                              aria-labelledby="booking_nights_label"
                              data-booking-room-rows-target="nights">1</output>
                    </div>
                  </div>
                  <div class="grid <%= quick ? "gap-4 md:grid-cols-2" : "grid-cols-2 gap-x-3 gap-y-4" %>" data-role="booking-classification-fields">
                    <% unless quick %>
                      <%= render PanelsUI::FormField.new(form: f, attribute: :booking_type, label: "Booking type") do |field| %>
                        <% field.with_select_menu(
                             [["Reservation", "reservation"], ["Walk-in", "walk_in"], ["Backdated check-in", "backdated_check_in"]],
                             selected: initial_type,
                             data: { booking_room_rows_target: "bookingType", action: "change->booking-room-rows#toggleBackdate" }) %>
                      <% end %>
                    <% end %>
                    <%= render PanelsUI::FormField.new(form: f, attribute: :source, label: "Booking source") do |field| %>
                      <% field.with_select_menu(
                           booking_source_choices,
                           selected: @booking.source || "phone") %>
                    <% end %>
                  </div>
                  <% unless quick %>
                    <div class="<%= initial_type == 'backdated_check_in' ? '' : 'hidden' %> rounded-md border-l-2 border-amber-400 bg-amber-50 p-4 md:col-span-2" data-booking-room-rows-target="backdateFields">
                      <div class="grid gap-4 md:grid-cols-3">
                        <div><%= label_tag :posting_date, "Posting date", class: "mb-1.5 block text-sm font-medium text-foreground" %><%= date_field_tag :posting_date, params[:posting_date] || current_hotel.current_business_date, class: "panel-input" %></div>
                        <%= render PanelsUI::FormField.new(form: f, attribute: :backdate_reason, label: "Reason") do |field| %>
                          <% field.with_select_menu(
                               [["Guest arrived earlier", "Guest arrived earlier but was not checked in"], ["System / internet issue", "System / internet issue"], ["Manual offline check-in", "Manual offline check-in"], ["Other", "Other"]],
                               selected: params.dig(:booking, :backdate_reason).presence || params[:backdate_reason],
                               prompt: "Select reason") %>
                        <% end %>
                        <div><%= label_tag :retroactive_reason, "Details", class: "mb-1.5 block text-sm font-medium text-foreground" %><%= text_field_tag :retroactive_reason, params[:retroactive_reason], class: "panel-input", placeholder: "Optional unless Other" %></div>
                      </div>
                    </div>
                  <% end %>
                </section>

                <%= render "hotel_portal/bookings/actions/booking_creations/partials/room_rate_table",
                      f: f,
                      allow_deferred_room: quick || initial_type == "reservation" %>

                <section class="space-y-4">
                  <div>
                    <h3 class="text-base font-semibold text-foreground">Guest information</h3>
                    <p class="mt-1 text-sm text-muted-foreground">Primary guest contact and identity details.</p>
                  </div>
                  <div class="grid gap-x-3 gap-y-4 <%= quick ? "md:grid-cols-3" : "md:grid-cols-2" %>" data-role="guest-primary-fields">
                    <%= render PanelsUI::FormField.new(form: f, attribute: :guest_name, label: "Guest name") do |field| %>
                      <% field.with_autocomplete(
                           endpoint: search_hotel_guests_path(current_hotel),
                           required: true,
                           placeholder: "Full name",
                           data: { booking_guest_autofill_target: "nameField" }) %>
                    <% end %>
                    <div class="<%= quick ? "contents" : "grid gap-x-3 gap-y-4 md:grid-cols-2" %>" data-role="guest-contact-fields">
                      <%= render PanelsUI::FormField.new(form: f, attribute: :guest_email, label: "Email") do |field| %>
                        <% field.with_autocomplete(
                             endpoint: search_hotel_guests_path(current_hotel),
                             type: :email,
                             required: true,
                             placeholder: "guest@example.com",
                             data: { booking_guest_autofill_target: "emailField" }) %>
                      <% end %>
                      <%= render PanelsUI::FormField.new(form: f, attribute: :guest_phone, label: "Phone") do |field| %>
                        <% field.with_autocomplete(
                             endpoint: search_hotel_guests_path(current_hotel),
                             type: :tel,
                             required: true,
                             placeholder: "+60 12-345 6789",
                             data: { booking_guest_autofill_target: "phoneField" }) %>
                      <% end %>
                    </div>
                  </div>
                  <div class="grid gap-x-3 gap-y-4 md:grid-cols-3" data-role="guest-demographic-fields">
                    <%= render PanelsUI::FormField.new(form: f, attribute: :guest_date_of_birth, label: "Date of birth", required: true) do |field| %>
                      <% field.with_date_picker(
                           value: @booking.guest_date_of_birth.to_s.presence,
                           max: Date.yesterday,
                           caption_layout: :dropdown,
                           year_range: (Date.current.year - 120)..Date.current.year,
                           placeholder: "Select date of birth",
                           data: { booking_guest_autofill_target: "dateOfBirthField" }) %>
                    <% end %>
                    <%= render PanelsUI::FormField.new(form: f, attribute: :guest_gender, label: "Gender") do |field| %>
                      <% field.with_select_menu(
                           Guest::GENDERS.map { |gender| [gender.titleize, gender] },
                           selected: @booking.guest_gender,
                           prompt: "Select gender",
                           data: { booking_guest_autofill_target: "genderField" }) %>
                    <% end %>
                    <%= render PanelsUI::FormField.new(form: f, attribute: :guest_country, label: "Nationality") do |field| %>
                      <% field.with_combobox(
                           COUNTRY_OPTIONS,
                           required: true,
                           prompt: "Select nationality",
                           data: {
                             booking_room_rows_target: "guestCountry",
                             booking_guest_autofill_target: "countryField",
                             action: "change->booking-room-rows#guestCountryChanged"
                           }) %>
                    <% end %>
                  </div>
                  <% selected_guest_id = params.dig(:booking, :existing_guest_id).presence || @booking.existing_guest_id %>
                  <%= f.hidden_field :existing_guest_id, value: selected_guest_id, data: { booking_guest_autofill_target: "existingGuestId" } %>
                  <div class="flex flex-col gap-3 rounded-md border border-border bg-muted/30 p-3 <%= "md:flex-row md:items-center md:justify-between" unless quick %>"
                       <%= "hidden" if selected_guest_id.blank? %>
                       data-booking-guest-autofill-target="profileRow">
                    <div class="min-w-0">
                      <div class="flex items-center gap-2">
                        <span class="truncate text-sm font-medium text-foreground" tabindex="-1" data-booking-guest-autofill-target="linkedName"><%= @booking.guest_name.presence || "Existing guest" %></span>
                        <button type="button" class="text-xs font-medium text-primary hover:underline" data-action="booking-guest-autofill#clearGuest">Change guest</button>
                      </div>
                      <p class="truncate text-xs text-muted-foreground" data-booking-guest-autofill-target="linkedDescription"><%= [@booking.guest_email, @booking.guest_phone].compact_blank.join(" · ") %></p>
                      <p class="text-xs text-destructive" hidden data-booking-guest-autofill-target="blacklistWarning">This guest is blacklisted at this hotel.</p>
                    </div>
                    <%= render PanelsUI::Switch.new(
                          name: "booking[guest_update_intent]",
                          value: "update_existing",
                          unchecked_value: "keep_existing",
                          checked: params.dig(:booking, :guest_update_intent) == "update_existing",
                          label: "Update guest profile",
                          description: "Save the guest information entered here to the guest database.",
                          data: { booking_guest_autofill_target: "updateSwitch" }) %>
                  </div>
                </section>

                <% if @boat_schedule&.enabled? %>
                  <section class="space-y-4">
                    <div>
                      <h3 class="text-base font-semibold text-foreground">Boat transfer</h3>
                      <p class="mt-1 text-sm text-muted-foreground">Pick the transfer slots this guest is booked on.</p>
                    </div>
                    <%= render "hotel_portal/bookings/boat_transfer_fields",
                          form: f,
                          schedule: @boat_schedule,
                          boat_in: params.dig(:booking, :boat_in_time),
                          boat_out: params.dig(:booking, :boat_out_time) %>
                  </section>
                <% end %>

                <% if quick %>
                  <section>
                    <%= render "hotel_portal/bookings/actions/booking_creations/partials/billing_summary" %>
                  </section>
                <% else %>
                  <section class="space-y-4">
                    <div>
                      <h3 class="text-base font-semibold text-foreground">Notes</h3>
                      <p class="mt-1 text-sm text-muted-foreground">Special requests or internal remarks for this booking.</p>
                    </div>
                    <%= render PanelsUI::FormField.new(form: f, attribute: :internal_notes, label: "Internal notes", label_hidden: true) do |field| %>
                      <% field.with_text_area(rows: 3, placeholder: "Special requests or internal notes") %>
                    <% end %>
                  </section>
                <% end %>
              </main>

              <% unless quick %>
                <aside class="bg-muted/30">
                  <div class="space-y-8 p-4 lg:p-6 xl:sticky xl:top-0 xl:max-h-[calc(100vh-9rem)] xl:overflow-y-auto">
                    <section>
                      <%= render "hotel_portal/bookings/actions/booking_creations/partials/billing_summary" %>
                    </section>
                    <section class="space-y-4">
                      <%= render PanelsUI::FormField.new(form: f, attribute: :bill_to, label: "Bill to") do |field| %>
                        <% field.with_select_menu(
                             [["Guest", "guest"], ["Corporate", "corporate"]],
                             selected: "guest",
                             data: { action: "change->booking-room-rows#toggleCorporate" }) %>
                      <% end %>
                      <div class="hidden space-y-4" data-booking-room-rows-target="corporate">
                        <% if @corporate_accounts.any? %>
                          <%= render PanelsUI::FormField.new(form: f, attribute: :hotel_corporate_account_id, label: "Corporate account") do |field| %>
                            <% field.with_combobox(
                                 @corporate_accounts.map { |relationship| [relationship.corporate_account.name, relationship.id] },
                                 prompt: "Select account") %>
                          <% end %>
                        <% else %>
                          <p class="rounded-md border border-border bg-muted px-3 py-2 text-xs text-muted-foreground">No active Corporate Accounts yet. Add one in settings to bill a Corporate Account.</p>
                        <% end %>
                        <p class="text-xs text-muted-foreground">Room charges are billed to the company. The guest remains a billing party for incidentals.</p>
                        <%= render PanelsUI::Switch.new(
                              form: f,
                              attribute: :bill_tourism_tax_to_company,
                              checked: false,
                              label: "Bill tourism tax to company",
                              description: "Off: tourism tax stays on the guest folio.") %>
                      </div>
                    </section>
                    <section>
                      <%= render "hotel_portal/bookings/actions/booking_creations/partials/payment", f: f %>
                    </section>
                  </div>
                </aside>
              <% end %>
            </div>
          </div>
        <% end %>
      </div>
    <% end %>

    <% sheet.with_footer do %>
      <% if quick %>
        <%= link_to "More options",
              hotel_booking_action_new_booking_path(current_hotel, params.permit(:return_to, :source)),
              class: "mr-auto rounded-md border border-border px-4 py-2 text-sm font-semibold text-foreground hover:bg-muted",
              data: {
                controller: "booking-form-transfer",
                action: "booking-form-transfer#open",
                booking_form_transfer_form_id_value: "manual_booking_form",
                booking_form_transfer_frame_value: "booking_action_sheet"
              } %>
      <% end %>
      <button type="button" class="px-4 py-2 text-sm font-semibold text-muted-foreground" data-action="panels-ui--sheet#close">Cancel</button>
      <button type="submit" form="manual_booking_form" class="rounded-md bg-primary px-5 py-2.5 text-sm font-bold text-primary-foreground hover:bg-primary-hover" data-turbo-submits-with="Creating…"><%= quick ? "Confirm booking" : "Create booking" %></button>
    <% end %>
  <% end %>
</div>
