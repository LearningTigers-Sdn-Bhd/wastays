<% quick = @transaction == :quick_booking %>
<% backdated = @transaction == :backdated_check_in %>
<% form_url = case @transaction
when :quick_booking then hotel_booking_action_quick_booking_path(current_hotel)
when :walk_in_check_in then hotel_booking_action_walk_in_check_in_path(current_hotel)
when :backdated_check_in then hotel_booking_action_backdated_check_in_path(current_hotel)
else hotel_booking_action_new_booking_path(current_hotel)
end %>
<% initial_type = case @transaction
when :walk_in_check_in then "walk_in"
when :backdated_check_in then "backdated_check_in"
else params.dig(:booking, :booking_type).presence || params[:booking_type].presence || "reservation"
end %>
<% sheet_title = case @transaction
when :quick_booking then "Quick Booking"
when :walk_in_check_in then "Walk-in Check-in"
when :backdated_check_in then "Backdated Check-in"
else "New Booking"
end %>
<% tz = current_hotel.hotel_time_zone %>
<% check_in_value = @booking.check_in&.in_time_zone(tz)&.strftime("%Y-%m-%dT%H:%M") %>
<% check_out_value = @booking.check_out&.in_time_zone(tz)&.strftime("%Y-%m-%dT%H:%M") %>
<% stay_range_value = "#{check_in_value}/#{check_out_value}" %>

<div data-controller="panels-ui--sheet-frame">
  <%= render PanelsUI::Sheet.new(
        id: "booking-creation-sheet",
        side: quick ? :right : :bottom,
        size: quick ? :lg : :full,
        title: sheet_title,
        body_class: "p-0") do |sheet| %>
    <% sheet.with_body do %>
      <div class="flex h-full flex-col bg-muted" data-controller="booking-room-rows"
           data-booking-room-rows-availability-url-value="<%= availability_hotel_bookings_path(current_hotel) %>"
           data-booking-room-rows-rate-options-url-value="<%= rate_options_hotel_bookings_path(current_hotel) %>"
           data-booking-room-rows-price-url-value="<%= stay_price_hotel_bookings_path(current_hotel) %>"
           data-booking-room-rows-room-row-url-value="<%= room_row_hotel_bookings_path(current_hotel) %>">
        <%= form_with model: @booking, url: form_url, local: true, class: "flex min-h-0 flex-1 flex-col", id: "manual_booking_form" do |f| %>
          <%# Backend param contract: the range picker feeds these hidden fields. %>
          <%= f.hidden_field :check_in, value: check_in_value, data: { booking_room_rows_target: "checkIn" } %>
          <%= f.hidden_field :check_out, value: check_out_value, data: { booking_room_rows_target: "checkOut" } %>

          <div class="min-h-0 flex-1 overflow-y-auto p-2.5">
            <div class="grid gap-2.5 <%= "xl:grid-cols-[minmax(0,1fr)_360px]" unless quick %>">
              <main class="min-w-0 rounded-md border border-border bg-card">
                <section class="space-y-4 p-4 lg:p-5">
                  <h3 class="text-sm font-bold text-foreground">Stay details</h3>
                  <div class="grid gap-4 md:grid-cols-2 <%= "xl:grid-cols-[2fr_1fr]" unless quick %>">
                    <%= render PanelsUI::FormField.new(form: f, attribute: :stay_range, label: "Check-in → Check-out") do |field| %>
                      <% field.with_date_time_picker(
                           range: true,
                           months: 2,
                           value: stay_range_value,
                           data: { action: "change->booking-room-rows#rangeChanged" }) %>
                    <% end %>
                    <div>
                      <span class="mb-1.5 block text-sm font-medium text-foreground">Nights</span>
                      <div class="flex h-9 items-center rounded-md border border-border bg-muted px-3 text-sm font-semibold text-foreground" data-booking-room-rows-target="nights">1</div>
                    </div>
                  </div>
                  <div class="grid gap-4 md:grid-cols-2">
                    <% unless quick %>
                      <%= render PanelsUI::FormField.new(form: f, attribute: :booking_type, label: "Booking type") do |field| %>
                        <% field.with_select_menu(
                             [["Reservation", "reservation"], ["Walk-in", "walk_in"], ["Backdated check-in", "backdated_check_in"]],
                             selected: initial_type,
                             data: { booking_room_rows_target: "bookingType", action: "change->booking-room-rows#toggleBackdate" }) %>
                      <% end %>
                    <% end %>
                    <%= render PanelsUI::FormField.new(form: f, attribute: :source, label: "Booking source") do |field| %>
                      <% field.with_select_menu(
                           [["Phone", "phone"], ["Walk-in", "walk_in"], ["Email", "email"], ["WhatsApp", "whatsapp"], ["Other", "internal"]],
                           selected: @booking.source || "phone") %>
                    <% end %>
                  </div>
                  <% unless quick %>
                    <div class="<%= initial_type == 'backdated_check_in' ? '' : 'hidden' %> rounded-md border-l-2 border-amber-400 bg-amber-50 p-4" data-booking-room-rows-target="backdateFields">
                      <div class="grid gap-4 md:grid-cols-3">
                        <div><%= label_tag :posting_date, "Posting date", class: "mb-1.5 block text-sm font-medium text-foreground" %><%= date_field_tag :posting_date, params[:posting_date] || current_hotel.current_business_date, class: "booking-form__control" %></div>
                        <%= render PanelsUI::FormField.new(form: f, attribute: :backdate_reason, label: "Reason") do |field| %>
                          <% field.with_select_menu(
                               [["Guest arrived earlier", "Guest arrived earlier but was not checked in"], ["System / internet issue", "System / internet issue"], ["Manual offline check-in", "Manual offline check-in"], ["Other", "Other"]],
                               selected: params.dig(:booking, :backdate_reason).presence || params[:backdate_reason],
                               prompt: "Select reason") %>
                        <% end %>
                        <div><%= label_tag :retroactive_reason, "Details", class: "mb-1.5 block text-sm font-medium text-foreground" %><%= text_field_tag :retroactive_reason, params[:retroactive_reason], class: "booking-form__control", placeholder: "Optional unless Other" %></div>
                      </div>
                    </div>
                  <% end %>
                </section>

                <%= render "hotel_portal/bookings/actions/booking_creations/partials/room_rate_table", f: f %>

                <section class="space-y-4 border-t border-border p-4 lg:p-5">
                  <h3 class="text-sm font-bold text-foreground">Guest information</h3>
                  <div class="grid gap-4 md:grid-cols-3">
                    <%= render PanelsUI::FormField.new(form: f, attribute: :guest_name, label: "Guest name") do |field| %>
                      <% field.with_input(required: true, placeholder: "Full name") %>
                    <% end %>
                    <%= render PanelsUI::FormField.new(form: f, attribute: :guest_phone, label: "Phone") do |field| %>
                      <% field.with_input(type: :tel, required: true, placeholder: "+60 12-345 6789") %>
                    <% end %>
                    <%= render PanelsUI::FormField.new(form: f, attribute: :guest_email, label: "Email") do |field| %>
                      <% field.with_input(type: :email, required: true, placeholder: "guest@example.com") %>
                    <% end %>
                  </div>
                  <div class="grid gap-4 md:grid-cols-2">
                    <%= render PanelsUI::FormField.new(form: f, attribute: :guest_date_of_birth, label: "Date of birth") do |field| %>
                      <% field.with_input(type: :date, required: true) %>
                    <% end %>
                    <%= render PanelsUI::FormField.new(form: f, attribute: :guest_country, label: "Nationality") do |field| %>
                      <% field.with_combobox(
                           COUNTRY_OPTIONS,
                           required: true,
                           prompt: "Select nationality",
                           data: { booking_room_rows_target: "guestCountry", action: "change->booking-room-rows#guestCountryChanged" }) %>
                    <% end %>
                  </div>
                </section>

                <% if quick %>
                  <section class="border-t border-border p-4 lg:p-5">
                    <%= render "hotel_portal/bookings/actions/booking_creations/partials/billing_summary" %>
                  </section>
                <% else %>
                  <section class="space-y-3 border-t border-border p-4 lg:p-5">
                    <h3 class="text-sm font-bold text-foreground">Notes</h3>
                    <%= render PanelsUI::FormField.new(form: f, attribute: :internal_notes, label: "Internal notes", label_hidden: true) do |field| %>
                      <% field.with_text_area(rows: 3, placeholder: "Special requests or internal notes") %>
                    <% end %>
                  </section>
                <% end %>
              </main>

              <% unless quick %>
                <aside class="rounded-md border border-border bg-card">
                  <div class="xl:sticky xl:top-0 xl:max-h-[calc(100vh-9rem)] xl:overflow-y-auto">
                    <section class="p-4 lg:p-5">
                      <%= render "hotel_portal/bookings/actions/booking_creations/partials/billing_summary" %>
                    </section>
                    <section class="space-y-4 border-t border-border p-4 lg:p-5">
                      <%= render PanelsUI::FormField.new(form: f, attribute: :bill_to, label: "Bill to") do |field| %>
                        <% field.with_select_menu(
                             [["Guest", "guest"], ["Corporate", "corporate"]],
                             selected: "guest",
                             data: { action: "change->booking-room-rows#toggleCorporate" }) %>
                      <% end %>
                      <div class="hidden space-y-4" data-booking-room-rows-target="corporate">
                        <% if @corporate_accounts.any? %>
                          <%= render PanelsUI::FormField.new(form: f, attribute: :hotel_corporate_account_id, label: "Corporate account") do |field| %>
                            <% field.with_combobox(
                                 @corporate_accounts.map { |relationship| [relationship.corporate_account.name, relationship.id] },
                                 prompt: "Select account") %>
                          <% end %>
                        <% else %>
                          <p class="rounded-md border border-border bg-muted px-3 py-2 text-xs text-muted-foreground">No active Company &amp; Government accounts yet. Add one in settings to bill a company.</p>
                        <% end %>
                        <p class="text-xs text-muted-foreground">Room charges are billed to the company. The guest remains a billing party for incidentals.</p>
                        <%= render PanelsUI::Switch.new(
                              form: f,
                              attribute: :bill_tourism_tax_to_company,
                              checked: false,
                              label: "Bill tourism tax to company",
                              description: "Off: tourism tax stays on the guest folio.") %>
                      </div>
                    </section>
                    <section class="border-t border-border p-4 lg:p-5">
                      <%= render "hotel_portal/bookings/actions/booking_creations/partials/payment", f: f %>
                    </section>
                  </div>
                </aside>
              <% end %>
            </div>
          </div>
        <% end %>
      </div>
    <% end %>

    <% sheet.with_footer do %>
      <% if quick %>
        <%= link_to "More options", hotel_booking_action_new_booking_path(current_hotel), class: "mr-auto rounded-md border border-border px-4 py-2 text-sm font-semibold text-foreground hover:bg-muted", data: { turbo_frame: "booking_action_sheet" } %>
      <% end %>
      <button type="button" class="px-4 py-2 text-sm font-semibold text-muted-foreground" data-action="panels-ui--sheet#close">Cancel</button>
      <button type="submit" form="manual_booking_form" class="rounded-md bg-primary px-5 py-2.5 text-sm font-bold text-primary-foreground hover:bg-primary-hover" data-turbo-submits-with="Creating…"><%= quick ? "Confirm booking" : "Create booking" %></button>
    <% end %>
  <% end %>
</div>
