<% common = { source: params[:source], return_to: @return_to }.compact %>
<% stay_links = [
     [ "Edit dates", hotel_booking_action_edit_dates_path(current_hotel, @booking, common), "calendar-range" ],
     [ "Change room", hotel_booking_action_edit_room_path(current_hotel, @booking, common), "bed-double" ],
     [ "Change rate", hotel_booking_action_edit_rate_path(current_hotel, @booking, common), "tag" ]
   ] %>

<div data-controller="panels-ui--sheet-frame">
  <%= render PanelsUI::Sheet.new(
        id: "booking-edit-sheet",
        side: :right,
        size: :xl,
        title: "Edit booking",
        description: @booking.guest_name,
        body_class: "p-0") do |sheet| %>
    <% sheet.with_body do %>
      <%= form_with scope: :booking,
            url: hotel_booking_action_edit_booking_path(current_hotel, @booking),
            method: :patch,
            class: "flex h-full min-h-0 flex-col" do |form| %>
        <%= hidden_field_tag :return_to, @return_to if @return_to.present? %>
        <%= hidden_field_tag :source, params[:source] if params[:source].present? %>

        <div class="min-h-0 flex-1 overflow-y-auto">
          <div class="space-y-6 p-6">
            <% if @booking.errors.any? %>
              <div class="rounded-md border border-destructive/30 bg-destructive/10 p-4 text-sm text-destructive" role="alert" aria-live="polite">
                <p class="font-semibold">Booking details could not be updated.</p>
                <ul class="mt-2 list-disc space-y-1 pl-5">
                  <% @booking.errors.full_messages.each do |message| %><li><%= message %></li><% end %>
                </ul>
              </div>
            <% end %>

            <section aria-labelledby="details-heading" class="space-y-4">
              <div>
                <h3 id="details-heading" class="text-base font-semibold">Guest & booking details</h3>
                <p class="mt-1 text-sm text-muted-foreground">Dates, room, and rate have their own editors below.</p>
              </div>
              <div class="grid gap-4 sm:grid-cols-2">
                <% [ [ :guest_name, "Guest name" ], [ :guest_email, "Email" ], [ :guest_phone, "Phone" ], [ :guest_country, "Country" ], [ :source, "Source" ], [ :guarantee_method, "Guarantee method" ] ].each do |attribute, label| %>
                  <%= render PanelsUI::FormField.new(form:, attribute:, label:) do |field| %>
                    <% field.with_input %>
                  <% end %>
                <% end %>
              </div>
            </section>

            <section aria-labelledby="stay-editing-heading" class="space-y-3">
              <h3 id="stay-editing-heading" class="text-base font-semibold">Stay editing</h3>
              <div class="flex flex-wrap gap-2">
                <% stay_links.each do |label, href, icon| %>
                  <%= link_to href, data: { turbo_frame: "booking_action_sheet_secondary" }, class: "inline-flex items-center gap-2 rounded-md border border-border px-3 py-2 text-sm font-medium text-foreground transition hover:bg-muted" do %>
                    <%= app_icon(icon, class: "size-4", aria: { hidden: true }) %><%= label %>
                  <% end %>
                <% end %>
              </div>
            </section>
          </div>
        </div>

        <div class="flex items-center justify-end gap-2 border-t border-border px-6 py-4">
          <%= render PanelsUI::Button.new(as: :button, type: :button, variant: :ghost, data: { action: "panels-ui--sheet#close" }) do %>Cancel<% end %>
          <%= render PanelsUI::Button.new(as: :button, type: :submit, data: { turbo_submits_with: "Saving…" }) do %>Save changes<% end %>
        </div>
      <% end %>
    <% end %>
  <% end %>
</div>
