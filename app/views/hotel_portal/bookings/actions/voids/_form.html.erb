<% booking = local_assigns.fetch(:booking) { @booking } %>
<% group = booking.group_booking_id? %>
<% target_presenter = HotelPortal::BookingLifecycleTargetPresenter.new(booking:, action: :void) %>

<div data-controller="panels-ui--sheet-frame">
  <%= render PanelsUI::Sheet.new(
        id: "booking-void-sheet",
        side: :right,
        size: group ? :xl : :md,
        title: "Void booking",
        description: booking.guest_name,
        body_class: "p-0") do |sheet| %>
    <% sheet.with_body do %>
      <%= form_with url: hotel_booking_action_void_booking_path(current_hotel, booking), method: :post, class: "flex h-full min-h-0 flex-col", data: { controller: "group-lifecycle-targets" } do |form| %>
        <%= hidden_field_tag :return_to, @return_to if @return_to.present? %>
        <div class="min-h-0 flex-1 <%= group ? 'grid grid-rows-[auto_minmax(0,1fr)] overflow-hidden lg:grid-cols-[20rem_minmax(0,1fr)] lg:grid-rows-none' : 'overflow-y-auto' %>">
          <%= render "hotel_portal/bookings/actions/shared/group_target_selector", target_presenter: target_presenter %>
          <% if group %><div class="min-h-0 overflow-y-auto custom-scrollbar"><% end %>
          <div class="space-y-5 p-4">
            <% if booking.errors.any? %>
              <%= render PanelsUI::Alert.new(tone: :destructive, title: "Booking could not be voided", role: :alert) do |alert| %>
                <% alert.with_description { booking.errors.full_messages.to_sentence } %>
              <% end %>
            <% end %>

            <%= render PanelsUI::Alert.new(tone: :warning, title: "This action bypasses the normal booking lifecycle") do |alert| %>
              <% alert.with_description do %>
                Existing folios, charges, payments, deposits, and invoices will not be changed. Any financial correction or settlement must be completed separately.
              <% end %>
            <% end %>

            <%= render PanelsUI::FormField.new(form:, attribute: :void_reason, label: "Void reason", required: true) do |field| %>
              <% field.with_text_area(value: params[:void_reason], rows: 5, placeholder: "Explain why this booking must be voided.") %>
            <% end %>
          </div>
          <% if group %></div><% end %>
        </div>
        <div class="flex items-center justify-end gap-2 border-t border-border px-6 py-4">
          <%= render PanelsUI::Button.new(as: :button, type: :button, variant: :ghost, data: { action: "panels-ui--sheet#close" }) do %>Cancel<% end %>
          <%= render PanelsUI::Button.new(as: :button, type: :submit, variant: :destructive, data: { turbo_submits_with: "Voiding…" }) do %>Confirm void<% end %>
        </div>
      <% end %>
    <% end %>
  <% end %>
</div>
