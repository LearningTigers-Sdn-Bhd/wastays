<% target_presenter = local_assigns.fetch(:target_presenter) %>
<% master_detail = local_assigns.fetch(:master_detail, false) %>
<% show_status_badges = local_assigns.fetch(:show_status_badges, false) %>
<% selection_mode = local_assigns.fetch(:selection_mode, :checkbox).to_sym %>
<% radio_mode = selection_mode == :radio %>
<% selected_booking_ids = Array(local_assigns[:selected_booking_ids]).reject(&:blank?).map(&:to_s) %>
<% target_scope = local_assigns.fetch(:target_scope, "individual").to_s %>

<% if target_presenter.render? %>
  <div class="min-h-0 overflow-y-auto border-b border-border custom-scrollbar lg:col-start-1 lg:row-span-[99] lg:h-full lg:border-b-0 <%= 'lg:border-r' unless local_assigns[:embedded] %>" data-group-lifecycle-targets-target="rail">
    <% unless radio_mode %>
      <div class="px-6 pt-6 pb-5">
        <p class="text-xs font-bold uppercase tracking-wider text-muted-foreground">Perform <%= target_presenter.action_label %> on:</p>
        <div class="mt-4 flex flex-wrap gap-4 text-sm font-medium text-foreground">
          <label class="inline-flex items-center gap-2">
            <%= radio_button_tag :target_scope, "group", target_scope == "group", data: { group_lifecycle_targets_target: "scope", action: "group-lifecycle-targets#scopeChanged" }, class: "size-4 border-border-interactive text-foreground focus:ring-ring" %>
            <span>Group</span>
          </label>
          <label class="inline-flex items-center gap-2">
            <%= radio_button_tag :target_scope, "individual", target_scope != "group", data: { group_lifecycle_targets_target: "scope", action: "group-lifecycle-targets#scopeChanged" }, class: "size-4 border-border-interactive text-foreground focus:ring-ring" %>
            <span>Individual Booking</span>
          </label>
        </div>
      </div>
    <% end %>

    <div class="divide-y divide-border border-y border-border <%= 'border-t-0' if radio_mode %>">
      <% target_presenter.groups.each do |group| %>
        <details class="group" open>
          <summary class="flex cursor-pointer list-none items-center gap-2 px-6 py-3 text-xs font-bold uppercase tracking-wider text-foreground transition hover:text-foreground [&::-webkit-details-marker]:hidden">
            <%= cached_icon("chevron-right", class: "size-3 text-muted-foreground transition-transform group-open:rotate-90", stroke_width: 2.25) %>
            <span><%= group.room_type %> (<%= group.rows.size %>)</span>
          </summary>
          <div class="divide-y divide-border">
            <% group.rows.each do |row| %>
              <% initially_active = if selected_booking_ids.any?
                selected_booking_ids.include?(row.booking.id.to_s)
              else
                master_detail && row.booking.id == target_presenter.booking.id
              end %>
              <div class="flex items-center gap-2 px-6 py-2 text-sm transition <%= row.eligible ? 'text-foreground' : 'text-muted-foreground' %> <%= 'font-semibold text-foreground' if initially_active %>"
                   data-group-lifecycle-targets-target="row"
                   data-booking-id="<%= row.booking.id %>"
                   aria-selected="<%= initially_active %>">
                <% if radio_mode %>
                  <%= radio_button_tag "booking_ids[]", row.booking.id, initially_active,
                    disabled: !row.eligible,
                    data: { booking_id: row.booking.id, group_lifecycle_targets_target: "checkbox", action: "group-lifecycle-targets#selectionChanged" },
                    class: "size-4 border-border-interactive text-foreground focus:ring-ring disabled:cursor-not-allowed disabled:bg-muted disabled:text-muted-foreground" %>
                <% else %>
                  <%= check_box_tag "booking_ids[]", row.booking.id, initially_active,
                    disabled: !row.eligible,
                    data: { booking_id: row.booking.id, group_lifecycle_targets_target: "checkbox", action: "group-lifecycle-targets#selectionChanged" },
                    class: "size-4 rounded border-border-interactive text-foreground focus:ring-ring disabled:cursor-not-allowed disabled:bg-muted disabled:text-muted-foreground" %>
                <% end %>
                <% if master_detail && row.eligible %>
                  <button type="button" class="min-w-0 flex-1 truncate text-left font-semibold focus:outline-none focus-visible:ring-2 focus-visible:ring-ring"
                           data-booking-id="<%= row.booking.id %>"
                           data-action="group-lifecycle-targets#activatePanel"><%= row.room_number %> - <%= row.guest_name %></button>
                <% else %>
                  <span class="min-w-0 flex-1 truncate"><%= row.room_number %> - <%= row.guest_name %></span>
                <% end %>
                <% if show_status_badges && row.eligible %>
                  <span class="shrink-0 rounded-full px-2 py-0.5 text-[10px] font-bold tracking-wider"
                        data-group-lifecycle-targets-target="statusBadge"
                        data-booking-id="<%= row.booking.id %>"
                        hidden></span>
                <% end %>
              </div>
            <% end %>
          </div>
        </details>
      <% end %>
    </div>

    <% if target_presenter.eligible_count.zero? %>
      <div class="px-6 py-4">
        <p class="rounded-md border border-amber-200 bg-amber-50 px-3 py-2 text-xs font-semibold text-amber-800">No group bookings are eligible for this action.</p>
      </div>
    <% end %>
  </div>
<% end %>
