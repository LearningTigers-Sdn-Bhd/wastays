<% currency = current_hotel.default_currency.presence || booking.currency.presence || "MYR" %>

<% if booking.guarantee_method.present? && booking.guarantee_method != "none" %>
  <%= render "hotel_portal/bookings/guarantee_status_badge", booking: booking %>
<% end %>

<section aria-labelledby="arrival-details-heading-<%= booking.id %>" class="space-y-4">
  <div>
    <h3 id="arrival-details-heading-<%= booking.id %>" class="text-base font-semibold">Arrival details</h3>
    <p class="mt-1 text-sm text-muted-foreground">Confirm this guest's actual arrival time and room assignment.</p>
  </div>

  <%= render PanelsUI::FormField.new(form:, attribute: :checked_in_at, label: "Check-in date and time", required: true, hint: values[:business_date_hint]) do |field| %>
    <% field.with_date_time_picker(value: values[:checked_in_at], max: values[:checked_in_at_max], minute_step: 5, data: { lifecycle_required: true }) %>
  <% end %>

  <% if editing %>
    <%= render PanelsUI::FormField.new(form:, attribute: :reason, label: "Reason to change", required: true, hint: "This reason is recorded in the booking audit trail.") do |field| %>
      <% field.with_input(value: values[:reason], placeholder: "Explain why the check-in details are changing", data: { lifecycle_required: true }) %>
    <% end %>
  <% elsif values[:requires_override] %>
    <div class="space-y-4 rounded-md border border-warning/30 bg-warning/10 p-4">
      <div class="flex gap-3">
        <%= app_icon("triangle-alert", class: "mt-0.5 size-4 shrink-0 text-warning", aria: { hidden: true }) %>
        <div>
          <h3 class="text-sm font-semibold text-foreground">Closed business date</h3>
          <p class="mt-1 text-sm text-muted-foreground">Night audit has already run for this arrival date. An override and reason are required.</p>
        </div>
      </div>
      <%= render PanelsUI::Switch.new(
            form:,
            attribute: :override_night_audit,
            checked: values[:override_night_audit],
            label: "Override night audit",
            description: "Use only for an arrival that was not recorded before audit completed.") %>
      <%= render PanelsUI::FormField.new(form:, attribute: :reason, label: "Override reason", required: true) do |field| %>
        <% field.with_input(value: values[:reason], placeholder: "For example, the check-in system was offline", data: { lifecycle_required: true }) %>
      <% end %>
    </div>
  <% end %>
</section>

<% if boat_schedule.enabled? %>
  <section aria-labelledby="boat-transfer-heading-<%= booking.id %>" class="space-y-4">
    <div>
      <h3 id="boat-transfer-heading-<%= booking.id %>" class="text-base font-semibold">Boat transfer</h3>
      <p class="mt-1 text-sm text-muted-foreground">Pick the transfer slots this guest is booked on.</p>
    </div>

    <%= render "hotel_portal/bookings/boat_transfer_fields",
          form: form,
          schedule: boat_schedule,
          boat_in: values[:boat_in_time],
          boat_out: values[:boat_out_time] %>
  </section>
<% end %>

<section aria-labelledby="room-assignments-heading-<%= booking.id %>" class="space-y-4">
  <div>
    <h3 id="room-assignments-heading-<%= booking.id %>" class="text-base font-semibold">Room assignments</h3>
    <p class="mt-1 text-sm text-muted-foreground">Only rooms available for the full stay can be selected.</p>
  </div>
  <div class="space-y-4">
    <% booking.booking_rooms.each do |booking_room| %>
      <% option_data = room_options.fetch(booking_room) %>
      <%= fields_for "#{form.object_name}[room_assignments][#{booking_room.id}]", OpenStruct.new(room_number: option_data[:selected]) do |room_form| %>
        <div data-controller="room-lock"
             data-room-lock-url-value="<%= hotel_room_locks_path(current_hotel) %>"
             data-room-lock-room-type-id-value="<%= booking_room.room_type_id %>"
             data-room-lock-current-room-value="<%= booking_room.room_number %>">
          <%= render PanelsUI::FormField.new(form: room_form, attribute: :room_number, label: booking_room.room_type.name) do |field| %>
            <% field.with_select_menu(
                 option_data[:choices],
                 selected: option_data[:selected],
                 prompt: "Select an available room",
                 data: { action: "change->room-lock#lock" }) %>
          <% end %>
        </div>
      <% end %>
    <% end %>
  </div>
</section>

<% unless editing %>
  <section aria-labelledby="security-deposit-heading-<%= booking.id %>" class="space-y-4 border-t border-border pt-6" data-controller="payment-toggle">
    <%= render PanelsUI::Switch.new(
          name: "#{form.object_name}[collect_security_deposit]",
          checked: values[:collect_security_deposit],
          label: "Record a security deposit",
          description: "Record a refundable deposit separately from the guest folio.",
          data: { payment_toggle_target: "checkbox", action: "change->payment-toggle#toggle" }) %>

    <div class="space-y-4 <%= 'opacity-50' unless values[:collect_security_deposit] %>" data-payment-toggle-target="container">
      <%= fields_for "#{form.object_name}[security_deposit]", OpenStruct.new(
            amount: values[:security_deposit_amount],
            external_reference: values[:security_deposit_reference]) do |deposit_form| %>
        <h3 id="security-deposit-heading-<%= booking.id %>" class="text-base font-semibold">Security deposit</h3>
        <div class="grid gap-4 sm:grid-cols-2">
          <%= render PanelsUI::FormField.new(form: deposit_form, attribute: :amount, label: "Amount") do |field| %>
            <% field.with_input(type: :number, value: values[:security_deposit_amount], min: 0, step: 0.01, data: { payment_toggle_target: "field" }) %>
            <% field.with_addon(align: :inline_start) { currency } %>
          <% end %>
          <%= render "hotel_portal/bookings/actions/booking_creations/partials/configured_payment_method_fields",
                form: deposit_form,
                method_groups: { direct: @direct_payment_methods },
                purpose: :direct,
                selected_method_id: values[:security_deposit_payment_method_id],
                selected_type: values[:security_deposit_payment_method_type],
                required: true %>
        </div>
        <%= render PanelsUI::FormField.new(form: deposit_form, attribute: :external_reference, label: "Reference", hint: "Optional receipt or payment reference.") do |field| %>
          <% field.with_input(value: values[:security_deposit_reference], data: { payment_toggle_target: "field" }) %>
        <% end %>
      <% end %>
    </div>
  </section>

  <% if booking.tourism_tax_total.positive? %>
    <section aria-labelledby="tourism-tax-heading-<%= booking.id %>" class="space-y-4 border-t border-border pt-6">
      <div class="flex items-start justify-between gap-4">
        <div>
          <h3 id="tourism-tax-heading-<%= booking.id %>" class="text-base font-semibold">Tourism tax</h3>
          <p class="mt-1 text-sm text-muted-foreground">Record whether the mandatory tourism tax has been collected.</p>
        </div>
        <p class="shrink-0 text-sm font-semibold text-foreground"><%= currency %> <%= number_with_precision(booking.tourism_tax_total, precision: 2, delimiter: ",") %></p>
      </div>
      <%= render PanelsUI::Switch.new(
            form:,
            attribute: :tourism_tax_collected,
            checked: values[:tourism_tax_collected],
            label: "Tourism tax collected",
            description: "When off, the tax remains unpaid on the guest folio.") %>
    </section>
  <% end %>
<% end %>
