<%= render PanelsUI::DropdownMenu.new(id: "booking-summary-print-send", placement: :bottom_end, class: "w-72") do |menu| %>
  <% menu.with_trigger(variant: :secondary, size: :sm) do %>
    <%= app_icon "file-text", class: "size-4", aria: { hidden: true } %>
    <span>Print / Send</span>
    <%= app_icon "chevron-down", class: "size-4", aria: { hidden: true } %>
  <% end %>

  <% menu.with_group(label: "Print") do |group| %>
    <% group.with_item(href: receipt_booking_path(booking.confirmation_token), target: "_blank", data: { turbo: false }) do %>
      <%= app_icon "receipt", class: "size-4", aria: { hidden: true } %>
      <span>Receipt</span>
    <% end %>

    <% if booking.status == "completed" %>
      <% group.with_item(href: invoice_booking_path(booking.confirmation_token), target: "_blank", data: { turbo: false }) do %>
        <%= app_icon "file-text", class: "size-4", aria: { hidden: true } %>
        <span>Invoice</span>
      <% end %>
    <% else %>
      <% group.with_item(disabled: true) do %>
        <%= app_icon "file-text", class: "size-4", aria: { hidden: true } %>
        <span class="flex flex-1 items-center justify-between gap-2">
          <span>Invoice</span>
          <%= render PanelsUI::Badge.new(label: "After checkout", variant: :neutral, size: :sm) %>
        </span>
      <% end %>
    <% end %>

    <% if current_user.has_permission?("manage_bookings", hotel: current_hotel) %>
      <% group.with_item(href: hotel_booking_guest_registration_card_path(current_hotel, booking), target: "_blank", data: { turbo: false }) do %>
        <%= app_icon "clipboard-list", class: "size-4", aria: { hidden: true } %>
        <span>Guest Registration Card</span>
      <% end %>

      <% if booking.tourism_tax? %>
        <% if booking.tourism_tax_voucher_number? %>
          <% group.with_item(href: hotel_booking_tourism_tax_voucher_path(current_hotel, booking), target: "_blank", data: { turbo: false }) do %>
            <%= app_icon "receipt", class: "size-4", aria: { hidden: true } %>
            <span>Tourism Tax Voucher</span>
          <% end %>
        <% else %>
          <% group.with_item(
               href: issue_hotel_booking_tourism_tax_voucher_path(current_hotel, booking),
               method: :post,
               form: { target: "_blank", data: { turbo: false } }) do %>
            <%= app_icon "receipt", class: "size-4", aria: { hidden: true } %>
            <span>Issue Tourism Tax Voucher</span>
          <% end %>
        <% end %>
      <% end %>
    <% end %>
  <% end %>

  <% menu.with_separator %>
  <% menu.with_group(label: "Send") do |group| %>
    <% group.with_item(disabled: true) do %>
      <%= app_icon "send", class: "size-4", aria: { hidden: true } %>
      <span class="flex flex-1 items-center justify-between gap-2">
        <span>Resend Confirmation</span>
        <%= render PanelsUI::Badge.new(label: "Unavailable", variant: :neutral, size: :sm) %>
      </span>
    <% end %>
    <% group.with_item(disabled: true) do %>
      <%= app_icon "message-circle", class: "size-4", aria: { hidden: true } %>
      <span class="flex flex-1 items-center justify-between gap-2">
        <span>Resend Pre-Check-in</span>
        <%= render PanelsUI::Badge.new(label: "Unavailable", variant: :neutral, size: :sm) %>
      </span>
    <% end %>
  <% end %>
<% end %>
