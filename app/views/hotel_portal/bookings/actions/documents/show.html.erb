<% presenter = @panel_presenter %>
<% can_manage_bookings = current_user.has_permission?("manage_bookings", hotel: current_hotel) %>

<%= render "hotel_portal/bookings/actions/shared/sheet",
      id: "booking-group-documents-sheet",
      title: "Print / Send",
      description: "Choose documents for individual rooms in this group.",
      side: :right,
      size: :lg do %>
  <div class="space-y-6">
    <%= render PanelsUI::Button.new(
          variant: :ghost,
          size: :sm,
          data: { action: "panels-ui--sheet#close" }) do %>
      <%= app_icon "arrow-left", class: "size-4", aria: { hidden: true } %>
      <span>Back to booking summary</span>
    <% end %>

    <section aria-labelledby="group-documents-heading" class="overflow-hidden rounded-lg border border-border">
      <div class="border-b border-border bg-muted px-4 py-3">
        <h3 id="group-documents-heading" class="text-base font-semibold">Group documents</h3>
      </div>
      <ul class="divide-y divide-border">
        <% [ [ "receipt", "Group Receipt" ], [ "file-text", "Group Invoice" ], [ "send", "Resend Group Confirmation" ] ].each do |icon, label| %>
          <li class="flex items-center justify-between gap-3 px-4 py-3">
            <span class="flex items-center gap-2 text-sm font-medium text-muted-foreground"><%= app_icon icon, class: "size-4", aria: { hidden: true } %><%= label %></span>
            <%= render PanelsUI::Badge.new(label: "Unavailable", variant: :neutral, size: :sm) %>
          </li>
        <% end %>
      </ul>
    </section>

    <div class="space-y-5">
      <% presenter.document_row_groups.each do |room_type, rows| %>
        <section aria-labelledby="document-room-type-<%= room_type.parameterize %>" class="overflow-hidden rounded-lg border border-border">
          <div class="border-b border-border bg-muted px-4 py-3">
            <h3 id="document-room-type-<%= room_type.parameterize %>" class="text-sm font-semibold"><%= room_type %> (<%= rows.size %>)</h3>
          </div>
          <ul class="divide-y divide-border">
            <% rows.each do |row| %>
              <li class="space-y-3 px-4 py-3">
                <p class="text-sm font-medium text-foreground"><%= row.room_number %> · <%= row.guest_name %></p>
                <div class="flex flex-wrap items-center gap-2">
                  <%= render PanelsUI::Button.new(href: receipt_booking_path(row.booking.confirmation_token), variant: :secondary, size: :xs, target: "_blank", data: { turbo: false }) do %>
                    <%= app_icon "receipt", class: "size-4", aria: { hidden: true } %><span>Receipt</span>
                  <% end %>

                  <%= render PanelsUI::Button.new(href: (invoice_booking_path(row.booking.confirmation_token) if row.invoice_available), variant: :secondary, size: :xs, disabled: !row.invoice_available, target: "_blank", data: { turbo: false }, title: ("Available after checkout" unless row.invoice_available)) do %>
                    <%= app_icon "file-text", class: "size-4", aria: { hidden: true } %><span>Invoice</span>
                  <% end %>

                  <% if can_manage_bookings %>
                    <%= render PanelsUI::Button.new(href: hotel_booking_guest_registration_card_path(current_hotel, row.booking), variant: :secondary, size: :xs, target: "_blank", data: { turbo: false }) do %>
                      <%= app_icon "clipboard-list", class: "size-4", aria: { hidden: true } %><span>Registration card</span>
                    <% end %>
                  <% end %>

                  <%= render PanelsUI::Button.new(label: "Resend confirmation", variant: :secondary, size: :xs, disabled: true) %>
                  <%= render PanelsUI::Button.new(label: "Resend pre-check-in", variant: :secondary, size: :xs, disabled: true) %>
                </div>
              </li>
            <% end %>
          </ul>
        </section>
      <% end %>
    </div>
  </div>
<% end %>
