<dialog id="late-checkout-modal-show-<%= booking.id %>" 
        class="fixed inset-0 m-auto rounded-2xl p-0 w-[min(92vw,32rem)] max-w-lg shadow-2xl backdrop:bg-slate-900/50" 
        onclick="if(event.target===this){this.close()}">
  <div class="p-6 bg-white" onclick="event.stopPropagation()" 
       data-controller="late-checkout"
       data-late-checkout-base-amount-value="<%= @presenter.suggested_late_checkout_amount %>">
    <h3 class="text-lg font-bold text-slate-900">Review Late Checkout</h3>
    <p class="text-sm text-slate-500 mt-1">Calculate and post a charge for <%= booking.guest_name %>.</p>

    <%= form_with url: process_late_checkout_hotel_booking_path(current_hotel, booking), method: :post, local: true, class: "mt-6 space-y-6" do |f| %>
      
      <!-- Charge Toggle -->
      <div class="space-y-3 pb-4 border-b border-slate-100">
        <label class="block text-[11px] font-bold text-slate-500 uppercase tracking-wider">Charge Late Checkout Fee?</label>
        <div class="flex gap-6">
          <label class="flex items-center gap-2 cursor-pointer">
            <%= f.radio_button :charge_type, "charge", checked: true, 
                class: "size-4 border-slate-300 text-blue-600 focus:ring-blue-600",
                data: { action: "change->late-checkout#updateUI", late_checkout_target: "toggleRadio" } %>
            <span class="text-sm font-bold text-slate-700">Yes, Charge</span>
          </label>
          <label class="flex items-center gap-2 cursor-pointer">
            <%= f.radio_button :charge_type, "none", 
                class: "size-4 border-slate-300 text-blue-600 focus:ring-blue-600",
                data: { action: "change->late-checkout#updateUI", late_checkout_target: "toggleRadio" } %>
            <span class="text-sm font-bold text-slate-700 text-slate-500">No Charge</span>
          </label>
        </div>
      </div>

      <div data-late-checkout-target="chargeSection" class="space-y-6">
        <!-- Charge Type Selection -->
        <div class="space-y-3">
          <label class="block text-[11px] font-bold text-slate-500 uppercase tracking-wider">Charge Calculation</label>
          <div class="grid grid-cols-1 gap-3">
            <label class="relative flex cursor-pointer rounded-xl border border-slate-200 bg-white p-4 shadow-sm focus:outline-none has-[:checked]:border-blue-600 has-[:checked]:ring-1 has-[:checked]:ring-blue-600">
              <%= f.radio_button :charge_calculation, "standard", checked: true, 
                  class: "sr-only", 
                  data: { action: "change->late-checkout#updateUI", late_checkout_target: "typeRadio" } %>
              <span class="flex flex-1">
                <span class="flex flex-col">
                    <span class="block text-sm font-bold text-slate-900">Standard Charge</span>
                  <span class="mt-1 flex items-center text-xs text-slate-500">
                    Current room rate + taxes (<%= @presenter.currency %> <%= number_with_precision(@presenter.suggested_late_checkout_amount, precision: 2) %>)
                  </span>
                </span>
              </span>
              <svg class="size-5 text-blue-600 invisible [.peer:checked~&]:visible" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" /></svg>
            </label>

            <label class="relative flex cursor-pointer rounded-xl border border-slate-200 bg-white p-4 shadow-sm focus:outline-none has-[:checked]:border-blue-600 has-[:checked]:ring-1 has-[:checked]:ring-blue-600">
              <%= f.radio_button :charge_calculation, "custom", 
                  class: "sr-only", 
                  data: { action: "change->late-checkout#updateUI", late_checkout_target: "typeRadio" } %>
              <span class="flex flex-1">
                <span class="flex flex-col">
                    <span class="block text-sm font-bold text-slate-900">Custom Charge</span>
                  <span class="mt-1 flex items-center text-xs text-slate-500">
                    Apply a custom amount or percentage
                  </span>
                </span>
              </span>
              <svg class="size-5 text-blue-600 invisible [.peer:checked~&]:visible" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" /></svg>
            </label>
          </div>
        </div>

        <!-- Custom Input Section -->
        <div class="hidden space-y-4 rounded-2xl border border-slate-100 bg-slate-50/50 p-4" data-late-checkout-target="customSection">
          <div class="grid grid-cols-2 gap-4">
            <div>
              <%= f.label :custom_type, "Adjustment Type", class: "block text-[11px] font-bold text-slate-500 uppercase tracking-wider mb-2" %>
              <%= f.select :custom_type, [["Fixed Amount", "amount"], ["Percentage (%)", "percentage"]], {}, 
                  class: "w-full rounded-xl border border-slate-200 bg-white py-2.5 px-4 text-sm text-slate-700 focus:border-slate-300 focus:outline-none focus:ring-0 shadow-sm",
                  data: { action: "change->late-checkout#updateCalculation", late_checkout_target: "customType" } %>
            </div>
            <div>
              <label class="block text-[11px] font-bold text-slate-500 uppercase tracking-wider mb-2">Value</label>
              <%= f.number_field :custom_value, step: 0.01, placeholder: "0.00",
                  class: "w-full rounded-xl border border-slate-200 bg-white py-2.5 px-4 text-sm text-slate-700 focus:border-slate-300 focus:outline-none focus:ring-0 shadow-sm",
                  data: { action: "input->late-checkout#updateCalculation", late_checkout_target: "customValue" } %>
            </div>
          </div>
          <div class="pt-2 border-t border-slate-100">
            <p class="text-xs font-semibold text-slate-500">Calculated Charge: <span class="text-slate-900" data-late-checkout-target="displayAmount"><%= @presenter.currency %> 0.00</span></p>
          </div>
        </div>
      </div>

      <!-- Hidden field for final amount -->
      <%= f.hidden_field :amount, data: { late_checkout_target: "amountInput" } %>

      <!-- Post-Action Selection -->
      <div class="space-y-3">
        <label class="block text-[11px] font-bold text-slate-500 uppercase tracking-wider">Next Action</label>
        <div class="flex gap-4">
          <label class="flex items-center gap-2 cursor-pointer">
            <%= f.radio_button :after_action, "stay", checked: true, class: "rounded-full border-slate-300 text-blue-600 focus:ring-blue-600" %>
            <span class="text-sm font-medium text-slate-700">Apply & Keep In-House</span>
          </label>
          <label class="flex items-center gap-2 cursor-pointer">
            <%= f.radio_button :after_action, "checkout", class: "rounded-full border-slate-300 text-blue-600 focus:ring-blue-600" %>
            <span class="text-sm font-medium text-slate-700">Apply & Check Out</span>
          </label>
        </div>
      </div>

      <div class="flex items-center justify-end gap-x-3 pt-2">
        <button type="button" class="px-4 py-2 text-sm font-semibold text-slate-700 hover:bg-slate-50 rounded-lg transition" onclick="this.closest('dialog').close()">Cancel</button>
        <%= f.submit "Process Late Checkout", class: "px-4 py-2 text-sm font-bold bg-amber-600 text-white rounded-lg hover:bg-amber-700 transition shadow-sm" %>
      </div>
    <% end %>
  </div>
</dialog>
