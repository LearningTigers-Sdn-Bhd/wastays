<div class="grid gap-4 lg:grid-cols-2">
  <section class="overflow-hidden rounded-lg border border-slate-200 bg-white">
    <div class="border-b border-slate-200 bg-slate-50 px-4 py-3">
      <h2 class="inline-flex items-center gap-2 text-sm font-semibold text-slate-950"><span class="inline-flex size-6 items-center justify-center rounded-md bg-slate-100 text-slate-700"><%= cached_icon "files", class: "size-3.5" %></span> Documents</h2>
    </div>
    <div class="divide-y divide-slate-100 text-sm">
      <%= link_to receipt_booking_path(booking.confirmation_token), target: "_blank", class: "flex items-center justify-between px-4 py-3 text-slate-700 hover:bg-slate-50", data: { turbo: false } do %>
        <span class="inline-flex items-center gap-2"><span class="inline-flex size-6 items-center justify-center rounded-md bg-emerald-50 text-emerald-700"><%= cached_icon "receipt", class: "size-3.5" %></span> Receipt</span>
        <span class="inline-flex items-center gap-1 text-xs font-semibold text-slate-500">Download <%= cached_icon "download", class: "size-3" %></span>
      <% end %>

      <div class="flex items-center justify-between px-4 py-3 text-slate-400">
        <span class="inline-flex items-center gap-2"><span class="inline-flex size-6 items-center justify-center rounded-md bg-slate-100 text-slate-400"><%= cached_icon "clipboard-list", class: "size-3.5" %></span> Guest Registration</span>
        <span class="rounded-full bg-slate-100 px-2 py-0.5 text-[10px] font-semibold text-slate-500">Unavailable</span>
      </div>

      <% if booking.status == "completed" %>
        <%= link_to invoice_booking_path(booking.confirmation_token), target: "_blank", class: "flex items-center justify-between px-4 py-3 text-slate-700 hover:bg-slate-50", data: { turbo: false } do %>
          <span class="inline-flex items-center gap-2"><span class="inline-flex size-6 items-center justify-center rounded-md bg-blue-50 text-blue-700"><%= cached_icon "file-text", class: "size-3.5" %></span> Invoice</span>
          <span class="inline-flex items-center gap-1 text-xs font-semibold text-slate-500">Download <%= cached_icon "download", class: "size-3" %></span>
        <% end %>
      <% else %>
        <div class="flex items-center justify-between px-4 py-3 text-slate-400">
          <span class="inline-flex items-center gap-2"><span class="inline-flex size-6 items-center justify-center rounded-md bg-slate-100 text-slate-400"><%= cached_icon "file-text", class: "size-3.5" %></span> Invoice</span>
          <span class="rounded-full bg-slate-100 px-2 py-0.5 text-[10px] font-semibold text-slate-500">After checkout</span>
        </div>
      <% end %>
    </div>
  </section>

  <section class="overflow-hidden rounded-lg border border-slate-200 bg-white">
    <div class="border-b border-slate-200 bg-slate-50 px-4 py-3">
      <h2 class="inline-flex items-center gap-2 text-sm font-semibold text-slate-950"><span class="inline-flex size-6 items-center justify-center rounded-md bg-slate-100 text-slate-700"><%= cached_icon "settings-2", class: "size-3.5" %></span> Actions</h2>
    </div>
    <div class="divide-y divide-slate-100 text-sm">
      <%= link_to hotel_folio_path(current_hotel, booking), class: "flex items-center justify-between px-4 py-3 text-slate-700 hover:bg-slate-50" do %>
        <span class="inline-flex items-center gap-2"><span class="inline-flex size-6 items-center justify-center rounded-md bg-amber-50 text-amber-700"><%= cached_icon "book-open", class: "size-3.5" %></span> Manage Folio</span>
        <span class="inline-flex items-center gap-1 text-xs font-semibold text-slate-500">Open <%= cached_icon "chevron-right", class: "size-3" %></span>
      <% end %>

      <div class="flex items-center justify-between px-4 py-3 text-slate-400">
        <span class="inline-flex items-center gap-2"><span class="inline-flex size-6 items-center justify-center rounded-md bg-slate-100 text-slate-400"><%= cached_icon "send", class: "size-3.5" %></span> Resend Confirmation</span>
        <span class="rounded-full bg-slate-100 px-2 py-0.5 text-[10px] font-semibold text-slate-500">Unavailable</span>
      </div>

      <div class="flex items-center justify-between px-4 py-3 text-slate-400">
        <span class="inline-flex items-center gap-2"><span class="inline-flex size-6 items-center justify-center rounded-md bg-slate-100 text-slate-400"><%= cached_icon "message-circle", class: "size-3.5" %></span> Resend Pre-Check-in</span>
        <span class="rounded-full bg-slate-100 px-2 py-0.5 text-[10px] font-semibold text-slate-500">Unavailable</span>
      </div>

      <% if presenter.can_request_refund? %>
        <% eligibility = presenter.refund_eligibility %>
        <% if eligibility.success? %>
          <%= link_to new_hotel_booking_refund_request_path(current_hotel, booking), class: "flex items-center justify-between px-4 py-3 text-red-700 hover:bg-red-50", data: { turbo_frame: "offcanvas_drawer" } do %>
            <span class="inline-flex items-center gap-2"><span class="inline-flex size-6 items-center justify-center rounded-md bg-red-50 text-red-700"><%= cached_icon "rotate-ccw", class: "size-3.5" %></span> Initiate Refund Request</span>
            <span class="inline-flex items-center gap-1 text-xs font-semibold">Open <%= cached_icon "chevron-right", class: "size-3" %></span>
          <% end %>
        <% else %>
          <div class="px-4 py-3 text-xs text-red-600"><%= eligibility.error %></div>
        <% end %>
      <% elsif booking.refund_request.present? %>
        <div class="flex items-center justify-between px-4 py-3 text-slate-700">
          <span>Refund Status</span>
          <span class="text-xs font-semibold uppercase"><%= booking.refund_request.status %></span>
        </div>
      <% end %>
    </div>
  </section>
</div>
