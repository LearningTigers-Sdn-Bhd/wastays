<% all_notes = booking.booking_notes.sort_by(&:created_at).reverse %>
<% preview_notes = all_notes.first(2) %>
<% can_manage = current_user.has_permission?("manage_bookings", hotel: current_hotel) %>

<section class="overflow-hidden rounded-lg border border-slate-200 bg-white">
  <div class="flex items-center justify-between gap-3 border-b border-slate-200 bg-slate-50 px-4 py-3">
    <div>
      <h2 class="inline-flex items-center gap-2 text-sm font-semibold text-slate-950"><span class="inline-flex size-6 items-center justify-center rounded-md bg-blue-50 text-blue-700"><%= cached_icon "sticky-note", class: "size-3.5" %></span> Internal Notes</h2>
      <p class="text-xs text-slate-500">Hotel staff only.</p>
    </div>
    <% if can_manage %>
      <%= link_to hotel_booking_show_action_manage_internal_notes_path(current_hotel, booking, mode: "add"), data: { turbo_frame: "offcanvas_drawer", offcanvas_variant: "compact-right" }, class: "inline-flex items-center gap-1.5 rounded-md border border-slate-200 bg-white px-3 py-1.5 text-xs font-semibold text-slate-700 hover:bg-slate-50" do %>
        <%= cached_icon "plus", class: "size-3" %> Add Note
      <% end %>
    <% end %>
  </div>

  <div class="divide-y divide-slate-100">
    <% if preview_notes.any? %>
      <% preview_notes.each do |note| %>
        <div class="px-4 py-3">
          <div class="mb-1 flex items-start justify-between gap-3">
            <div>
              <p class="inline-flex items-center gap-1 text-xs font-semibold text-slate-900"><%= cached_icon "user", class: "size-3 text-slate-400" %><%= note.user.name %></p>
              <p class="mt-0.5 inline-flex items-center gap-1 text-[11px] text-slate-500"><%= cached_icon "clock", class: "size-3 text-slate-400" %><%= note.created_at.strftime("%d %b %Y") %></p>
            </div>
            <% if can_manage %>
              <div class="flex items-center gap-2 text-xs">
                <% if Array(note.edit_history).any? %>
                  <%= link_to hotel_booking_show_action_manage_internal_notes_path(current_hotel, booking, mode: "history", note_id: note.id), data: { turbo_frame: "offcanvas_drawer", offcanvas_variant: "compact-right" }, class: "inline-flex items-center gap-1 rounded-md border border-slate-200 bg-slate-50 px-2.5 py-1.5 text-xs font-semibold text-slate-700 hover:bg-slate-100" do %>
                    History
                  <% end %>
                <% end %>
                <%= link_to hotel_booking_show_action_manage_internal_notes_path(current_hotel, booking, mode: "edit", note_id: note.id), data: { turbo_frame: "offcanvas_drawer", offcanvas_variant: "compact-right" }, class: "inline-flex items-center gap-1 rounded-md border border-blue-200 bg-blue-50 px-2.5 py-1.5 text-xs font-semibold text-blue-700 hover:bg-blue-100" do %>
                  <%= cached_icon "pencil", class: "size-3" %> Edit
                <% end %>
                <%= link_to hotel_booking_show_action_confirmation_path(current_hotel, booking, action_type: "delete_internal_note", target_id: note.id), data: { turbo_frame: "offcanvas_drawer", offcanvas_variant: "compact-right" }, class: "inline-flex items-center gap-1 rounded-md border border-red-200 bg-red-50 px-2.5 py-1.5 text-xs font-semibold text-red-700 hover:bg-red-100" do %>
                  <%= cached_icon "trash-2", class: "size-3" %> Delete
                <% end %>
              </div>
            <% end %>
          </div>
          <p class="whitespace-pre-wrap text-sm text-slate-700"><%= note.body %></p>
        </div>
      <% end %>
    <% else %>
      <div class="flex items-center gap-2 px-4 py-3 text-sm text-slate-500">
        <span class="inline-flex size-6 items-center justify-center rounded-md bg-slate-100 text-slate-400"><%= cached_icon "sticky-note", class: "size-3.5" %></span>
        No internal notes for this booking.
      </div>
    <% end %>
  </div>

  <% if all_notes.size > 2 %>
    <details class="border-t border-slate-100">
      <summary class="cursor-pointer list-none px-4 py-3 text-xs font-semibold text-slate-700 hover:bg-slate-50 [&::-webkit-details-marker]:hidden">
        <span class="inline-flex items-center gap-1.5"><%= cached_icon "list", class: "size-3" %> View all <%= all_notes.size %> notes</span>
      </summary>
      <div class="max-h-96 divide-y divide-slate-100 overflow-y-auto border-t border-slate-100">
        <% all_notes.drop(2).each do |note| %>
          <div class="px-4 py-3">
            <div class="mb-1 flex items-start justify-between gap-3">
              <p class="text-xs font-semibold text-slate-900"><%= note.user.name %> · <%= note.created_at.strftime("%d %b %Y") %></p>
              <% if can_manage %>
                <div class="flex gap-2 text-xs">
                  <% if Array(note.edit_history).any? %>
                    <%= link_to hotel_booking_show_action_manage_internal_notes_path(current_hotel, booking, mode: "history", note_id: note.id), data: { turbo_frame: "offcanvas_drawer", offcanvas_variant: "compact-right" }, class: "inline-flex items-center gap-1 rounded-md border border-slate-200 bg-slate-50 px-2.5 py-1.5 text-xs font-semibold text-slate-700 hover:bg-slate-100" do %>
                      History
                    <% end %>
                  <% end %>
                  <%= link_to hotel_booking_show_action_manage_internal_notes_path(current_hotel, booking, mode: "edit", note_id: note.id), data: { turbo_frame: "offcanvas_drawer", offcanvas_variant: "compact-right" }, class: "inline-flex items-center gap-1 rounded-md border border-blue-200 bg-blue-50 px-2.5 py-1.5 text-xs font-semibold text-blue-700 hover:bg-blue-100" do %>
                    <%= cached_icon "pencil", class: "size-3" %> Edit
                  <% end %>
                  <%= link_to hotel_booking_show_action_confirmation_path(current_hotel, booking, action_type: "delete_internal_note", target_id: note.id), data: { turbo_frame: "offcanvas_drawer", offcanvas_variant: "compact-right" }, class: "inline-flex items-center gap-1 rounded-md border border-red-200 bg-red-50 px-2.5 py-1.5 text-xs font-semibold text-red-700 hover:bg-red-100" do %>
                    <%= cached_icon "trash-2", class: "size-3" %> Delete
                  <% end %>
                </div>
              <% end %>
            </div>
            <p class="whitespace-pre-wrap text-sm text-slate-700"><%= note.body %></p>
          </div>
        <% end %>
      </div>
    </details>
  <% end %>
</section>
