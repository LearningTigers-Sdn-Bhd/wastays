<section class="overflow-hidden rounded-lg border border-slate-200 bg-white">
  <div class="flex items-center gap-2 border-b border-slate-200 bg-slate-50 px-4 py-3">
    <span class="inline-flex size-6 items-center justify-center rounded-md bg-violet-50 text-violet-700"><%= cached_icon "hash", class: "size-3.5" %></span>
    <div>
      <h2 class="text-sm font-semibold text-slate-950">References IDs</h2>
      <p class="text-xs text-slate-500">Internal and channel booking identifiers.</p>
    </div>
  </div>

  <div class="grid gap-px bg-slate-200 sm:grid-cols-2 lg:grid-cols-6">
    <% presenter.reference_ids.each do |label, value| %>
      <div class="min-w-0 bg-white px-4 py-3">
        <p class="text-[10px] font-semibold uppercase tracking-wide text-slate-500"><%= label %></p>
        <p class="mt-1 truncate text-sm font-medium text-slate-950" title="<%= value.presence || "—" %>"><%= value.presence || "—" %></p>
      </div>
    <% end %>
  </div>
</section>
