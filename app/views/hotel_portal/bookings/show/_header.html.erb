<div class="px-4 md:px-0 mt-5">
  <div class="flex flex-col md:flex-row md:items-start md:justify-between gap-6">
    <div>
      <div class="flex items-center gap-3 mb-2">
        <h1 class="text-2xl font-bold tracking-tight text-slate-950 sm:text-3xl">Booking <%= presenter.confirmation_token %></h1>
        <span class="inline-flex items-center rounded-full border px-2.5 py-1 text-[10px] font-bold tracking-wider <%= presenter.status_label_class %> bg-opacity-10 uppercase">
          <%= presenter.status %>
        </span>
      </div>
      <p class="text-sm font-medium text-slate-600">Created on <%= presenter.created_at_formatted %></p>
      <div class="flex flex-wrap gap-x-4 gap-y-1 mt-1">
        <% if booking.reservation_number %>
          <span class="text-xs text-slate-500">Reservation No. <span class="font-semibold text-slate-700"><%= booking.formatted_reservation_number %></span></span>
        <% end %>
        <% if booking.receipt_number %>
          <span class="text-xs text-slate-500">Receipt No. <span class="font-semibold text-slate-700"><%= booking.formatted_receipt_number %></span></span>
        <% end %>
        <% if booking.folio_number %>
          <span class="text-xs text-slate-500">Folio No. <span class="font-semibold text-slate-700"><%= booking.formatted_folio_number %></span></span>
        <% end %>
        <% if booking.invoice_number %>
          <span class="text-xs text-slate-500">Invoice No. <span class="font-semibold text-slate-700"><%= booking.formatted_invoice_number %></span></span>
        <% end %>
        <% if booking.guest_registration_number %>
          <span class="text-xs text-slate-500">Guest Reg. No. <span class="font-semibold text-slate-700"><%= booking.formatted_guest_registration_number %></span></span>
        <% end %>
      </div>
    </div>

    <div class="flex flex-wrap items-center gap-3">
      <% if presenter.can_manage_bookings?(current_user) %>
        <% if booking.status == 'confirmed' %>
          <button type="button" class="inline-flex items-center rounded-xl bg-slate-900 px-4 py-2.5 text-sm font-bold text-white shadow-sm transition hover:bg-slate-700" onclick="document.getElementById('check-in-modal-show-<%= booking.id %>').showModal()">
            Check In Guest
          </button>
          <%= button_to "Cancel Booking", cancel_hotel_booking_path(current_hotel, booking), method: :post, data: { turbo_confirm: "Are you sure you want to cancel this booking?", turbo_confirm_title: "Cancel Booking", turbo_confirm_color: "red" }, class: "inline-flex items-center rounded-xl bg-red-600 px-4 py-2.5 text-sm font-bold text-white shadow-sm transition hover:bg-red-700" %>
        <% elsif booking.status == 'no_show' %>
          <button type="button" class="inline-flex items-center rounded-xl bg-blue-600 px-4 py-2.5 text-sm font-bold text-white shadow-sm transition hover:bg-blue-700" onclick="document.getElementById('reinstate-modal-show-<%= booking.id %>').showModal()">
            Reinstate Guest
          </button>
        <% elsif booking.status == 'checked_in' %>
          <%= link_to checkout_hotel_booking_path(current_hotel, booking), data: { turbo_frame: "offcanvas_drawer", offcanvas_variant: "fullscreen-bottom" }, class: "inline-flex items-center rounded-xl bg-slate-900 px-4 py-2.5 text-sm font-bold text-white shadow-sm transition hover:bg-slate-700" do %>
            Check Out Guest
          <% end %>
          <button type="button" class="inline-flex items-center rounded-xl border border-slate-200 bg-white px-4 py-2.5 text-sm font-bold text-slate-700 shadow-sm transition hover:bg-slate-50" onclick="document.getElementById('check-in-modal-show-<%= booking.id %>').showModal()">
            Edit Check-In
          </button>
        <% elsif booking.status == 'review_due_out' %>
          <button type="button" class="inline-flex items-center rounded-xl bg-amber-600 px-4 py-2.5 text-sm font-bold text-white shadow-sm transition hover:bg-amber-700" onclick="document.getElementById('late-checkout-modal-show-<%= booking.id %>').showModal()">
            Review Late Checkout
          </button>
          <%= link_to checkout_hotel_booking_path(current_hotel, booking), data: { turbo_frame: "offcanvas_drawer", offcanvas_variant: "fullscreen-bottom" }, class: "inline-flex items-center rounded-xl border border-slate-200 bg-white px-4 py-2.5 text-sm font-bold text-slate-700 shadow-sm transition hover:bg-slate-50" do %>
            Check Out Guest
          <% end %>
        <% end %>
      <% end %>
    </div>
  </div>
</div>
