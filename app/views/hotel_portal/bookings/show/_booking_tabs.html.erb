<div class="mt-8 mb-3 rounded-xl border border-slate-200 bg-white p-1.5">
  <nav class="flex items-center gap-1 overflow-x-auto" aria-label="Tabs" role="tablist">
    <!-- Booking Details Tab -->
    <button type="button"
            data-tabs-target="tab"
            data-tab-name="booking-details"
            data-tab-label="Booking Details"
            data-action="click->tabs#switch"
            class="group inline-flex h-9 items-center gap-2 rounded-lg px-4 text-sm font-medium text-slate-600 hover:bg-slate-50 hover:text-slate-900 data-[active=true]:bg-blue-600 data-[active=true]:text-white data-[active=true]:font-semibold transition-all duration-150 whitespace-nowrap"
            aria-controls="booking-details-panel"
            role="tab">
      <%= cached_icon "file-text", class: "size-4" %>
      <span>Booking Details</span>
    </button>

    <!-- Requests Tab -->
    <button type="button"
            data-tabs-target="tab"
            data-tab-name="requests"
            data-tab-label="Requests"
            data-action="click->tabs#switch"
            class="group inline-flex h-9 items-center gap-2 rounded-lg px-4 text-sm font-medium text-slate-600 hover:bg-slate-50 hover:text-slate-900 data-[active=true]:bg-blue-600 data-[active=true]:text-white data-[active=true]:font-semibold transition-all duration-150 whitespace-nowrap"
            aria-controls="requests-panel"
            role="tab">
      <%= cached_icon "inbox", class: "size-4" %>
      <span>Requests</span>
      <span class="rounded-full px-1.5 py-0.5 text-[10px] font-bold bg-slate-100 text-slate-500 group-data-[active=true]:bg-white/20 group-data-[active=true]:text-white transition-colors duration-150">
        <%= presenter.pending_requests_count %>
      </span>
    </button>

    <!-- History Tab -->
    <% audit_count = local_assigns[:audit_logs] ? audit_logs.size : 0 %>
    <button type="button"
            data-tabs-target="tab"
            data-tab-name="history"
            data-tab-label="History"
            data-action="click->tabs#switch"
            class="group inline-flex h-9 items-center gap-2 rounded-lg px-4 text-sm font-medium text-slate-600 hover:bg-slate-50 hover:text-slate-900 data-[active=true]:bg-blue-600 data-[active=true]:text-white data-[active=true]:font-semibold transition-all duration-150 whitespace-nowrap"
            aria-controls="history-panel"
            role="tab">
      <%= cached_icon "history", class: "size-4" %>
      <span>History</span>
      <span class="rounded-full px-1.5 py-0.5 text-[10px] font-bold bg-slate-100 text-slate-500 group-data-[active=true]:bg-white/20 group-data-[active=true]:text-white transition-colors duration-150">
        <%= audit_count %>
      </span>
    </button>
  </nav>
</div>
