<div class="mx-auto max-w-[1600px] px-4 pb-12 md:px-0">
  <div class="space-y-4">
    <%= render "hotel_portal/bookings/show/booking_header", booking: booking, presenter: presenter %>
    <%= render "hotel_portal/bookings/show/booking_summary_strip", booking: booking, presenter: presenter %>
    <%= render "hotel_portal/bookings/show/stay_details", booking: booking, presenter: presenter %>

    <%= render "hotel_portal/bookings/check_in_modal", booking: booking, hotel: current_hotel, presenter: presenter %>
    <%= render "hotel_portal/bookings/show/modals/reinstate_modal", booking: booking %>
    <%= render "hotel_portal/bookings/show/modals/late_checkout_modal", booking: booking %>
    <%= render "hotel_portal/bookings/checkout/success_modal", booking: booking, presenter: presenter, hotel: current_hotel if params[:checkout_success] %>

    <div data-controller="booking-tabs" class="space-y-4">
      <%= render "hotel_portal/bookings/show/booking_tabs", presenter: presenter %>

      <div data-booking-tabs-target="panel" data-tab-panel="booking-details" class="space-y-4">
        <%= render "hotel_portal/bookings/show/guests_table", booking: booking, presenter: presenter %>
        <%= render "hotel_portal/bookings/show/price_summary", booking: booking, presenter: presenter %>
        <%= render "hotel_portal/bookings/show/documents_actions", booking: booking, presenter: presenter %>
        <%= render "hotel_portal/bookings/show/internal_notes", booking: booking %>
      </div>

      <div data-booking-tabs-target="panel" data-tab-panel="requests" class="hidden">
        <%= render "hotel_portal/bookings/show/tab_requests", booking: booking, presenter: presenter %>
      </div>

      <div data-booking-tabs-target="panel" data-tab-panel="history" class="hidden">
        <%= render "hotel_portal/bookings/show/audit_history", audit_logs: audit_logs %>
      </div>
    </div>
  </div>
</div>
