<div class="mt-5">
  <div class="flex flex-col gap-3 lg:flex-row lg:items-start lg:justify-between">
    <div class="min-w-0">
      <div class="flex flex-wrap items-center gap-2">
        <h1 class="text-2xl font-bold tracking-tight text-slate-950 sm:text-3xl">Booking <%= presenter.confirmation_token %></h1>
        <span class="inline-flex items-center rounded-md border px-2 py-0.5 text-[11px] font-semibold uppercase tracking-wide <%= presenter.status_label_class %>">
          <%= presenter.status.tr("_", " ") %>
        </span>
      </div>

      <div class="mt-1 flex flex-wrap gap-x-3 gap-y-1 text-sm font-medium text-slate-600">
        <span>Created <span class="font-medium text-slate-700"><%= presenter.created_at_formatted %></span></span>
      </div>
    </div>

    <div class="flex flex-wrap items-center gap-2">
      <% if presenter.can_manage_bookings?(current_user) %>
        <% if booking.status == "confirmed" %>
          <%= link_to "Check In", hotel_booking_transaction_check_in_reservation_path(current_hotel, booking), data: { turbo_frame: "offcanvas_drawer", offcanvas_variant: "right" }, class: "rounded-xl bg-slate-900 px-4 py-2.5 text-sm font-bold text-white shadow-sm transition hover:bg-slate-700" %>
          <%= link_to "Cancel", hotel_booking_transaction_cancel_booking_path(current_hotel, booking), data: { turbo_frame: "offcanvas_drawer", offcanvas_variant: "right" }, class: "rounded-xl border border-red-200 bg-white px-4 py-2.5 text-sm font-bold text-red-700 shadow-sm transition hover:bg-red-50" %>
        <% elsif booking.status == "review_no_show" %>
          <%= link_to "Backdated Check-in", hotel_booking_transaction_booking_backdated_check_in_path(current_hotel, booking), data: { turbo_frame: "offcanvas_drawer", offcanvas_variant: "right" }, class: "rounded-xl bg-slate-900 px-4 py-2.5 text-sm font-bold text-white shadow-sm transition hover:bg-slate-700" %>
          <%= link_to "Mark No-show", hotel_booking_transaction_mark_no_show_path(current_hotel, booking), data: { turbo_frame: "offcanvas_drawer", offcanvas_variant: "right" }, class: "rounded-xl border border-rose-200 bg-white px-4 py-2.5 text-sm font-bold text-rose-700 shadow-sm transition hover:bg-rose-50" %>
          <%= link_to "Cancel", hotel_booking_transaction_cancel_booking_path(current_hotel, booking), data: { turbo_frame: "offcanvas_drawer", offcanvas_variant: "right" }, class: "rounded-xl border border-red-200 bg-white px-4 py-2.5 text-sm font-bold text-red-700 shadow-sm transition hover:bg-red-50" %>
        <% elsif booking.status == "no_show" %>
          <%= link_to "Reinstate", hotel_booking_transaction_reinstate_no_show_path(current_hotel, booking), data: { turbo_frame: "offcanvas_drawer", offcanvas_variant: "right" }, class: "rounded-xl bg-blue-600 px-4 py-2.5 text-sm font-bold text-white shadow-sm transition hover:bg-blue-700" %>
          <% if current_user.has_permission?("post_folio_corrections", hotel: current_hotel) && Bookings::RepairNoShowTourismTax.needed?(booking) %>
            <%= link_to "Repair No-show Folio", hotel_booking_transaction_repair_no_show_folio_path(current_hotel, booking), data: { turbo_frame: "offcanvas_drawer", offcanvas_variant: "right" }, class: "rounded-xl border border-amber-200 bg-white px-4 py-2.5 text-sm font-bold text-amber-700 shadow-sm transition hover:bg-amber-50" %>
          <% end %>
        <% elsif booking.status == "checked_in" %>
          <%= link_to hotel_booking_transaction_check_out_path(current_hotel, booking), data: { turbo_frame: "offcanvas_drawer", offcanvas_variant: "fullscreen-bottom" }, class: "rounded-xl bg-slate-900 px-4 py-2.5 text-sm font-bold text-white shadow-sm transition hover:bg-slate-700" do %>
            Check Out
          <% end %>
          <%= link_to "Edit Check-In", hotel_booking_transaction_check_in_reservation_path(current_hotel, booking), data: { turbo_frame: "offcanvas_drawer", offcanvas_variant: "right" }, class: "rounded-xl border border-slate-200 bg-white px-4 py-2.5 text-sm font-bold text-slate-700 shadow-sm transition hover:bg-slate-50" %>
        <% elsif booking.status == "review_due_out" %>
          <%= link_to "Review Late Checkout", hotel_booking_transaction_late_checkout_path(current_hotel, booking), data: { turbo_frame: "offcanvas_drawer", offcanvas_variant: "right" }, class: "rounded-xl bg-amber-600 px-4 py-2.5 text-sm font-bold text-white shadow-sm transition hover:bg-amber-700" %>
        <% elsif booking.status == "checkout_required" %>
          <%= link_to hotel_booking_transaction_check_out_path(current_hotel, booking), data: { turbo_frame: "offcanvas_drawer", offcanvas_variant: "fullscreen-bottom" }, class: "rounded-xl border border-slate-200 bg-white px-4 py-2.5 text-sm font-bold text-slate-700 shadow-sm transition hover:bg-slate-50" do %>
            Complete Checkout
          <% end %>
        <% end %>
      <% end %>
    </div>
  </div>
</div>
