<div class="border-b border-slate-200 pb-3 pt-4">
  <div class="flex flex-col gap-3 lg:flex-row lg:items-start lg:justify-between">
    <div class="min-w-0">
      <div class="flex flex-wrap items-center gap-2">
        <h1 class="text-xl font-semibold tracking-tight text-slate-950 sm:text-2xl">Booking <%= presenter.confirmation_token %></h1>
        <span class="inline-flex items-center rounded-md border px-2 py-0.5 text-[11px] font-semibold uppercase tracking-wide <%= presenter.status_label_class %>">
          <%= presenter.status.tr("_", " ") %>
        </span>
      </div>

      <div class="mt-1 flex flex-wrap gap-x-3 gap-y-1 text-xs text-slate-500">
        <span>Folio <span class="font-medium text-slate-700"><%= booking.formatted_folio_number || "—" %></span></span>
        <span>Guest Reg. <span class="font-medium text-slate-700"><%= booking.formatted_guest_registration_number || "—" %></span></span>
        <span>Created <span class="font-medium text-slate-700"><%= presenter.created_at_formatted %></span></span>
        <span>Source <span class="font-medium text-slate-700"><%= presenter.source_label %></span></span>
      </div>
    </div>

    <div class="flex flex-wrap items-center gap-2">
      <% if presenter.can_manage_bookings?(current_user) %>
        <% if booking.status == "confirmed" %>
          <%= link_to "Check In", hotel_booking_transaction_check_in_reservation_path(current_hotel, booking), data: { turbo_frame: "offcanvas_drawer", offcanvas_variant: "right" }, class: "rounded-md bg-slate-900 px-3 py-2 text-xs font-semibold text-white hover:bg-slate-700" %>
          <%= link_to "Cancel", hotel_booking_transaction_cancel_booking_path(current_hotel, booking), data: { turbo_frame: "offcanvas_drawer", offcanvas_variant: "right" }, class: "rounded-md border border-red-200 bg-white px-3 py-2 text-xs font-semibold text-red-700 hover:bg-red-50" %>
        <% elsif booking.status == "no_show" %>
          <%= link_to "Reinstate", hotel_booking_transaction_reinstate_no_show_path(current_hotel, booking), data: { turbo_frame: "offcanvas_drawer", offcanvas_variant: "right" }, class: "rounded-md bg-blue-600 px-3 py-2 text-xs font-semibold text-white hover:bg-blue-700" %>
        <% elsif booking.status == "checked_in" %>
          <%= link_to hotel_booking_transaction_check_out_path(current_hotel, booking), data: { turbo_frame: "offcanvas_drawer", offcanvas_variant: "fullscreen-bottom" }, class: "rounded-md bg-slate-900 px-3 py-2 text-xs font-semibold text-white hover:bg-slate-700" do %>
            Check Out
          <% end %>
          <%= link_to "Edit Check-In", hotel_booking_transaction_check_in_reservation_path(current_hotel, booking), data: { turbo_frame: "offcanvas_drawer", offcanvas_variant: "right" }, class: "rounded-md border border-slate-200 bg-white px-3 py-2 text-xs font-semibold text-slate-700 hover:bg-slate-50" %>
        <% elsif booking.status == "review_due_out" %>
          <%= link_to "Review Late Checkout", hotel_booking_transaction_late_checkout_path(current_hotel, booking), data: { turbo_frame: "offcanvas_drawer", offcanvas_variant: "right" }, class: "rounded-md bg-amber-600 px-3 py-2 text-xs font-semibold text-white hover:bg-amber-700" %>
          <%= link_to hotel_booking_transaction_check_out_path(current_hotel, booking), data: { turbo_frame: "offcanvas_drawer", offcanvas_variant: "fullscreen-bottom" }, class: "rounded-md border border-slate-200 bg-white px-3 py-2 text-xs font-semibold text-slate-700 hover:bg-slate-50" do %>
            Check Out
          <% end %>
        <% end %>
      <% end %>
    </div>
  </div>
</div>
