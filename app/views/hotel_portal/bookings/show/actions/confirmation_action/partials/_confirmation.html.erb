<% target_id = action_type == "remove_guest" ? booking_guest.id : note.id %>
<% target_name = action_type == "remove_guest" ? booking_guest.guest.name : "this internal note" %>
<% submit_label = action_type == "remove_guest" ? "Remove Guest" : "Delete Note" %>

<%= form_with url: hotel_booking_show_action_confirmation_path(current_hotel, booking, action_type: action_type, target_id: target_id), method: :delete, class: "flex min-h-0 flex-1 flex-col" do |f| %>
  <%= hidden_field_tag :return_to, @return_to %>
  <div class="flex-1 overflow-y-auto p-6">
    <div class="rounded-xl border border-red-200 bg-red-50 p-5">
      <p class="font-bold text-red-800">Are you sure?</p>
      <p class="mt-2 text-sm text-red-700">
        <% if action_type == "remove_guest" %>
          Remove <strong><%= target_name %></strong> from this booking's guest records?
        <% else %>
          Permanently delete <%= target_name %>? Its edit history will also be removed.
        <% end %>
      </p>
    </div>
  </div>
  <%= render "hotel_portal/shared/offcanvas/content_footer",
    show_full_page_link: false,
    submit_button: f.submit(submit_label, class: "rounded-xl bg-red-600 px-6 py-2.5 text-sm font-bold text-primary-foreground hover:bg-red-700") %>
<% end %>
