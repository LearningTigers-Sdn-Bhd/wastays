<%= turbo_frame_tag "offcanvas_drawer" do %>
  <div class="flex h-full flex-col bg-card">
    <%= render "hotel_portal/shared/offcanvas/content_header",
      title: @action_type == "remove_guest" ? "Remove Guest" : "Delete Internal Note",
      subtitle: @booking.guest_name,
      icon: cached_icon("triangle-alert", class: "size-5 text-red-600") %>

    <%= render "hotel_portal/bookings/show/actions/confirmation_action/partials/confirmation",
      booking: @booking, action_type: @action_type, booking_guest: @booking_guest, note: @note %>
  </div>
<% end %>
