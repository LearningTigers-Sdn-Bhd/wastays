<div class="flex-1 overflow-y-auto p-6">
  <div class="space-y-3">
    <% if Array(note.edit_history).any? %>
      <% Array(note.edit_history).reverse_each do |entry| %>
        <% edited_time = Time.zone.parse(entry["edited_at"].to_s) rescue nil %>
        <div class="rounded-xl border border-slate-200 bg-slate-50 p-4">
          <p class="text-xs font-semibold text-slate-600"><%= entry["edited_by_name"].presence || "User" %> · <%= edited_time ? edited_time.strftime("%d %b %Y, %I:%M %p") : "—" %></p>
          <p class="mt-2 whitespace-pre-wrap text-sm text-slate-800"><%= entry["body"] %></p>
        </div>
      <% end %>
    <% else %>
      <p class="text-sm text-slate-500">This note has no edit history.</p>
    <% end %>
  </div>
</div>
