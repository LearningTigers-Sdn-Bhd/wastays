<div class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">
  <div class="border-b border-slate-200 bg-slate-50/70 px-6 py-5 sm:px-8 flex items-center justify-between">
    <h2 class="text-lg font-bold tracking-tight text-slate-950">Stay & Room Details</h2>
    <div class="flex items-center gap-3">
      <% if current_user.has_permission?("manage_bookings", hotel: current_hotel) %>
        <button type="button" class="inline-flex items-center gap-x-1.5 text-xs font-bold text-blue-600 hover:text-blue-700 transition" onclick="document.getElementById('edit-stay-details-modal').showModal()">
          <svg class="size-3.5" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M17 3a2.85 2.83 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5Z"/><path d="m15 5 4 4"/></svg>
          Edit
        </button>
      <% end %>
    </div>
  </div>

  <dialog id="edit-stay-details-modal"
          class="fixed inset-0 m-auto rounded-2xl p-0 w-[min(92vw,32rem)] max-w-lg shadow-2xl backdrop:bg-slate-900/50" onclick="if(event.target===this){this.close()}">
    <div class="p-6 bg-white" onclick="event.stopPropagation()">
      <h3 class="text-lg font-bold text-slate-900">Edit Stay & Room Details</h3>
      <p class="text-sm text-slate-500 mt-1">Update booking dates and room assignment.</p>

      <%= form_with model: booking, url: hotel_booking_path(current_hotel, booking), method: :patch, local: true,
          class: "mt-6 space-y-4",
          data: {
            controller: "booking-calc",
            booking_calc_availability_url_value: availability_hotel_bookings_path(current_hotel),
            booking_calc_price_url_value: stay_price_hotel_bookings_path(current_hotel),
            booking_calc_booking_id_value: booking.id
          } do |f| %>
        <div class="grid sm:grid-cols-2 gap-4">
          <div>
            <label class="block text-[11px] font-bold text-slate-500 uppercase tracking-wider mb-2">Check-in Date</label>
            <%= f.date_field :check_in, class: "w-full rounded-xl border border-slate-200 bg-white py-2.5 px-4 text-sm text-slate-700 focus:border-slate-300 focus:outline-none focus:ring-0 shadow-sm", data: { booking_calc_target: "checkIn", action: "change->booking-calc#calculate" } %>
          </div>
          <div>
            <label class="block text-[11px] font-bold text-slate-500 uppercase tracking-wider mb-2">Check-out Date</label>
            <%= f.date_field :check_out, class: "w-full rounded-xl border border-slate-200 bg-white py-2.5 px-4 text-sm text-slate-700 focus:border-slate-300 focus:outline-none focus:ring-0 shadow-sm", data: { booking_calc_target: "checkOut", action: "change->booking-calc#calculate" } %>
          </div>
        </div>

        <div>
          <label class="block text-[11px] font-bold text-slate-500 uppercase tracking-wider mb-2">Room Category</label>
          <% current_room_type_id = booking.booking_rooms.first&.room_type_id %>
          <%= f.collection_select :room_type_id, presenter.room_types, :id, :name, { selected: current_room_type_id },
              { class: "w-full rounded-xl border border-slate-200 bg-white px-4 py-2.5 text-sm font-medium text-slate-700 focus:border-slate-300 focus:outline-none focus:ring-0 shadow-sm",
                data: {
                  booking_calc_target: "roomType",
                  action: "change->booking-calc#updateRoomNumbers change->booking-calc#calculate",
                  prices: presenter.room_types.map { |rt| [rt.id, rt.base_price] }.to_h.to_json,
                  room_numbers: presenter.room_types.map { |rt| [rt.id, rt.room_numbers] }.to_h.to_json
                }
              } %>
        </div>

        <div data-controller="room-lock"
             data-room-lock-url-value="<%= hotel_room_locks_path(current_hotel) %>"
             data-room-lock-room-type-id-value="<%= current_room_type_id %>"
             data-room-lock-current-room-value="<%= booking.hotel_snapshot.is_a?(Hash) ? (booking.hotel_snapshot['room_number'] || booking.hotel_snapshot.dig('assignment', 'room_number')) : nil %>"
             data-booking-calc-target="roomNumberContainer">
          <label for="booking_room_number" class="block text-[11px] font-bold text-slate-500 uppercase tracking-wider mb-2">Room Number</label>
          <% current_room_number = booking.hotel_snapshot.is_a?(Hash) ? booking.hotel_snapshot['room_number'].presence || booking.hotel_snapshot.dig('assignment', 'room_number').presence : nil %>
          <%= f.select :room_number, [[current_room_number, current_room_number]], { selected: current_room_number },
              { id: "booking_room_number",
                required: true,
                class: "w-full rounded-xl border border-slate-200 bg-white py-2.5 px-4 text-sm text-slate-700 focus:border-slate-300 focus:outline-none focus:ring-0 shadow-sm",
                data: {
                  booking_calc_target: "roomNumberSelect",
                  action: "change->room-lock#lock"
                }
              } %>
          <p class="text-[10px] text-slate-400 mt-1.5 italic">Only available rooms for the selected dates are shown.</p>
        </div>

        <div class="flex items-center justify-end gap-x-3 pt-4">
          <button type="button" class="px-4 py-2 text-sm font-semibold text-slate-700 hover:bg-slate-50 rounded-lg transition" onclick="this.closest('dialog').close()">Cancel</button>
          <%= f.submit "Save Changes", class: "px-6 py-2 text-sm font-bold bg-slate-900 text-white rounded-lg hover:bg-slate-700 transition shadow-sm" %>
        </div>
      <% end %>
    </div>
  </dialog>

  <div class="p-6 sm:p-8 space-y-8">
    <div class="grid grid-cols-2 gap-6">
      <div>
        <dt class="text-[11px] font-bold text-slate-500 uppercase tracking-wider mb-1">Check-in</dt>
        <dd class="text-sm font-semibold text-slate-900"><%= booking.check_in.strftime("%d %b %Y") %></dd>
      </div>
      <div>
        <dt class="text-[11px] font-bold text-slate-500 uppercase tracking-wider mb-1">Check-out</dt>
        <dd class="text-sm font-semibold text-slate-900"><%= booking.check_out.strftime("%d %b %Y") %></dd>
      </div>
      <div>
        <dt class="text-[11px] font-bold text-slate-500 uppercase tracking-wider mb-1">Adults</dt>
        <dd class="text-sm font-semibold text-slate-900"><%= booking.adults %></dd>
      </div>
      <div>
        <dt class="text-[11px] font-bold text-slate-500 uppercase tracking-wider mb-1">Children</dt>
        <dd class="text-sm font-semibold text-slate-900"><%= booking.children %></dd>
      </div>
    </div>

    <div class="space-y-3">
      <h3 class="text-[11px] font-bold text-slate-500 uppercase tracking-wider">Reserved Units</h3>
      <% presenter.booking_rooms.each do |room| %>
        <div class="flex justify-between items-center p-4 rounded-xl border border-slate-100 bg-slate-50/50">
          <div>
            <p class="text-sm font-bold text-slate-900"><%= room.room_type_snapshot['name'] %></p>
            <p class="text-xs text-slate-500"><%= pluralize(room.quantity, 'room') %></p>
          </div>
          <div class="text-right">
            <p class="text-sm font-bold text-slate-900">MYR <%= number_with_precision(room.subtotal, precision: 2) %></p>
            <% room_number = room.room_number.presence || (booking.hotel_snapshot.is_a?(Hash) ? booking.hotel_snapshot['room_number'].presence || booking.hotel_snapshot.dig('assignment', 'room_number').presence : nil) %>
            <% if room_number.present? %>
              <p class="text-[10px] font-black uppercase tracking-widest text-emerald-600 mt-1">Room <%= room_number %></p>
            <% end %>
          </div>
        </div>
      <% end %>
    </div>
  </div>
</div>
