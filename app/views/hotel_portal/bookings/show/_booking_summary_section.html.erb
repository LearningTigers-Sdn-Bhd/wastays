<!-- Top summary bento grid -->
<div class="space-y-4">
  <!-- Identifiers Card (Full width) -->
  <div class="overflow-hidden rounded-xl border border-slate-200 bg-white shadow-sm">
    <header class="flex items-center justify-between border-b border-slate-200 bg-slate-50/60 px-4 py-2.5">
      <div class="flex items-center gap-2">
        <span class="inline-flex size-6 items-center justify-center rounded bg-violet-50 text-violet-700">
          <%= cached_icon "hash", class: "size-3.5" %>
        </span>
        <h3 class="text-xs font-bold uppercase tracking-wider text-slate-700">Identifiers</h3>
      </div>
    </header>
    <div class="grid grid-cols-2 md:grid-cols-3 gap-px bg-slate-200">
      <!-- Confirmation -->
      <div class="bg-white px-4 py-2.5 min-w-0 order-1 md:order-1">
        <div class="text-[10px] font-bold uppercase tracking-wider text-slate-500">Confirmation</div>
        <div class="mt-0.5 truncate text-sm font-semibold text-slate-900" title="<%= presenter.confirmation_token %>"><%= presenter.confirmation_token.presence || "—" %></div>
      </div>
      <!-- Reservation -->
      <div class="bg-white px-4 py-2.5 min-w-0 order-2 md:order-4">
        <div class="text-[10px] font-bold uppercase tracking-wider text-slate-500">Reservation</div>
        <div class="mt-0.5 truncate text-sm font-semibold text-slate-900" title="<%= booking.formatted_reservation_number %>"><%= booking.formatted_reservation_number.presence || "—" %></div>
      </div>
      <!-- Folio -->
      <div class="bg-white px-4 py-2.5 min-w-0 order-3 md:order-2">
        <div class="text-[10px] font-bold uppercase tracking-wider text-slate-500">Folio</div>
        <div class="mt-0.5 truncate text-sm font-semibold text-slate-900" title="<%= booking.formatted_folio_number %>"><%= booking.formatted_folio_number.presence || "—" %></div>
      </div>
      <!-- Guest Registration -->
      <div class="bg-white px-4 py-2.5 min-w-0 order-4 md:order-3">
        <div class="text-[10px] font-bold uppercase tracking-wider text-slate-500">Guest Registration</div>
        <div class="mt-0.5 truncate text-sm font-semibold text-slate-900" title="<%= booking.formatted_guest_registration_number %>"><%= booking.formatted_guest_registration_number.presence || "—" %></div>
      </div>
      <!-- External -->
      <div class="bg-white px-4 py-2.5 min-w-0 order-5 md:order-5">
        <div class="text-[10px] font-bold uppercase tracking-wider text-slate-500">External</div>
        <div class="mt-0.5 truncate text-sm font-semibold text-slate-900" title="<%= booking.external_reference %>"><%= booking.external_reference.presence || "—" %></div>
      </div>
      <!-- Channel Manager -->
      <div class="bg-white px-4 py-2.5 min-w-0 order-6 md:order-6">
        <div class="text-[10px] font-bold uppercase tracking-wider text-slate-500">Channel Manager</div>
        <div class="mt-0.5 truncate text-sm font-semibold text-slate-900" title="<%= booking.channel_manager_reference %>"><%= booking.channel_manager_reference.presence || "—" %></div>
      </div>
    </div>
  </div>

  <!-- Stay + Financial Wrapper (2 columns on desktop/lg, stacked on mobile) -->
  <div class="grid grid-cols-1 gap-4 lg:grid-cols-2 items-start">
    <!-- Stay Card -->
    <div class="overflow-hidden rounded-xl border border-slate-200 bg-white shadow-sm">
      <header class="flex items-center justify-between border-b border-slate-200 bg-slate-50/60 px-4 py-2.5">
        <div class="flex items-center gap-2">
          <span class="inline-flex size-6 items-center justify-center rounded bg-blue-50 text-blue-700">
            <%= cached_icon "bed", class: "size-3.5" %>
          </span>
          <h3 class="text-xs font-bold uppercase tracking-wider text-slate-700">Stay</h3>
        </div>
        <% if presenter.can_manage_bookings?(current_user) %>
          <%= link_to hotel_booking_transaction_amend_stay_path(current_hotel, booking), data: { turbo_frame: "offcanvas_drawer", offcanvas_variant: "right" }, class: "inline-flex items-center gap-1 rounded border border-slate-200 bg-white px-2 py-1 text-[11px] font-semibold text-slate-600 hover:bg-slate-50 hover:text-slate-900" do %>
            <%= cached_icon "pencil", class: "size-3" %> Edit Stay
          <% end %>
        <% end %>
      </header>
      <div class="grid grid-cols-2 gap-px bg-slate-200">
        <!-- Check-in -->
        <div class="bg-white px-4 py-2.5 min-w-0">
          <div class="text-[10px] font-bold uppercase tracking-wider text-slate-500">Check-in</div>
          <div class="mt-0.5 truncate text-sm font-semibold text-slate-900" title="<%= presenter.check_in_formatted %>"><%= presenter.check_in_formatted.presence || "—" %></div>
        </div>
        <!-- Check-out -->
        <div class="bg-white px-4 py-2.5 min-w-0">
          <div class="text-[10px] font-bold uppercase tracking-wider text-slate-500">Check-out</div>
          <div class="mt-0.5 truncate text-sm font-semibold text-slate-900" title="<%= presenter.check_out_formatted %>"><%= presenter.check_out_formatted.presence || "—" %></div>
        </div>
        <!-- Nights -->
        <div class="bg-white px-4 py-2.5 min-w-0">
          <div class="text-[10px] font-bold uppercase tracking-wider text-slate-500">Nights</div>
          <div class="mt-0.5 truncate text-sm font-semibold text-slate-900"><%= presenter.nights_count %></div>
        </div>
        <!-- Occupancy -->
        <div class="bg-white px-4 py-2.5 min-w-0">
          <div class="text-[10px] font-bold uppercase tracking-wider text-slate-500">Occupancy</div>
          <div class="mt-0.5 text-sm font-semibold text-slate-900">
            <span class="hidden sm:inline"><%= presenter.occupancy_text(variant: :desktop) %></span>
            <span class="inline sm:hidden"><%= presenter.occupancy_text(variant: :mobile) %></span>
          </div>
        </div>
        <!-- Room (spans 2 columns) -->
        <div class="col-span-2 bg-white px-4 py-2.5 min-w-0">
          <div class="text-[10px] font-bold uppercase tracking-wider text-slate-500">Room</div>
          <div class="mt-0.5 text-sm font-semibold text-slate-900">
            <span class="hidden sm:inline" title="<%= presenter.room_display_text(variant: :desktop) %>"><%= presenter.room_display_text(variant: :desktop) %></span>
            <span class="inline sm:hidden" title="<%= presenter.room_display_text(variant: :mobile) %>"><%= presenter.room_display_text(variant: :mobile) %></span>
          </div>
        </div>
        <!-- booking source -->
        <div class="bg-white px-4 py-2.5 min-w-0">
          <div class="text-[10px] font-bold uppercase tracking-wider text-slate-500">Source</div>
          <div class="mt-0.5 truncate text-sm font-semibold text-slate-900" title="<%= presenter.source_label %>"><%= presenter.source_label.presence || "—" %></div>
        </div>
        <!-- Rate -->
        <div class="bg-white px-4 py-2.5 min-w-0">
          <div class="text-[10px] font-bold uppercase tracking-wider text-slate-500">Rate</div>
          <div class="mt-0.5 truncate text-sm font-semibold text-slate-900" title="<%= presenter.rate_plan_label.presence || "Standard Rate" %>"><%= presenter.rate_plan_label.presence || "Standard Rate" %></div>
        </div>
        <!-- Special Requests (spans 2 columns) -->
        <% if booking.special_requests.present? %>
          <div class="col-span-2 bg-white px-4 py-1.5 min-w-0">
            <div class="text-[10px] font-bold uppercase tracking-wider text-amber-700 flex items-center gap-1">
              <%= cached_icon "message-square", class: "size-3" %> Guest Special Request
            </div>
            <div class="mt-0.5 text-sm font-semibold text-slate-900 whitespace-pre-wrap leading-relaxed"><%= booking.special_requests %></div>
          </div>
        <% end %>
      </div>
    </div>

    <!-- Financial Card -->
    <div class="overflow-hidden rounded-xl border border-slate-200 bg-white shadow-sm">
      <header class="flex items-center justify-between border-b border-slate-200 bg-slate-50/60 px-4 py-2.5">
        <div class="flex items-center gap-2">
          <span class="inline-flex size-6 items-center justify-center rounded bg-emerald-50 text-emerald-700">
            <%= cached_icon "wallet", class: "size-3.5" %>
          </span>
          <h3 class="text-xs font-bold uppercase tracking-wider text-slate-700">Financial</h3>
        </div>
      </header>
      <div class="grid grid-cols-2 gap-px bg-slate-200">
        <!-- Balance -->
        <div class="bg-white px-4 py-2.5 min-w-0 flex flex-col justify-center">
          <div class="text-[10px] font-bold uppercase tracking-wider text-slate-500">Balance</div>
          <div class="mt-0.5 flex flex-wrap items-center gap-1.5 text-sm font-semibold text-slate-900">
            <span><%= presenter.formatted_projected_balance %></span>
            <% if presenter.balance_due? %>
              <span class="inline-flex items-center rounded bg-amber-50 px-1.5 py-0.5 text-[9px] font-bold text-amber-800 ring-1 ring-inset ring-amber-600/20">Due</span>
            <% else %>
              <span class="inline-flex items-center rounded bg-emerald-50 px-1.5 py-0.5 text-[9px] font-bold text-emerald-800 ring-1 ring-inset ring-emerald-600/20">Paid</span>
            <% end %>
          </div>
        </div>
        <!-- Payment -->
        <div class="bg-white px-4 py-2.5 min-w-0">
          <div class="text-[10px] font-bold uppercase tracking-wider text-slate-500">Payment</div>
          <div class="mt-0.5 truncate text-sm font-semibold text-slate-900" title="<%= presenter.payment_status_label %>"><%= presenter.payment_status_label %></div>
        </div>
        <!-- Guarantee -->
        <div class="bg-white px-4 py-2.5 min-w-0">
          <div class="text-[10px] font-bold uppercase tracking-wider text-slate-500">Guarantee</div>
          <div class="mt-0.5 truncate text-sm font-semibold text-slate-900" title="<%= presenter.guarantee_method_label %>"><%= presenter.guarantee_method_label %></div>
        </div>
        <!-- Folio -->
        <div class="bg-white px-4 py-2.5 min-w-0 flex items-center justify-between">
          <div>
            <div class="text-[10px] font-bold uppercase tracking-wider text-slate-500">Folio</div>
            <div class="mt-0.5 truncate text-sm font-semibold text-slate-900"><%= presenter.folio_forecast_count %> unposted</div>
          </div>
          <div>
            <%= link_to hotel_folio_path(current_hotel, booking), class: "inline-flex items-center gap-0.5 text-xs font-semibold text-blue-600 hover:text-blue-700" do %>
              Manage <%= cached_icon "chevron-right", class: "size-3" %>
            <% end %>
          </div>
        </div>
        <!-- Room Total -->
        <div class="bg-white px-4 py-2.5 min-w-0">
          <div class="text-[10px] font-bold uppercase tracking-wider text-slate-500">Room Total</div>
          <div class="mt-0.5 truncate text-sm font-semibold text-slate-900"><%= presenter.formatted_room_total %></div>
        </div>
        <!-- Taxes / Charges -->
        <div class="bg-white px-4 py-2.5 min-w-0">
          <div class="text-[10px] font-bold uppercase tracking-wider text-slate-500">Taxes / Charges</div>
          <div class="mt-0.5 truncate text-sm font-semibold text-slate-900"><%= presenter.formatted_taxes_total %></div>
        </div>
        <!-- Total Paid (spans 2 columns) -->
        <div class="col-span-2 bg-white px-4 py-2.5 min-w-0">
          <div class="text-[10px] font-bold uppercase tracking-wider text-slate-500">Total Paid</div>
          <div class="mt-0.5 truncate text-sm font-semibold text-slate-900"><%= presenter.formatted_total_amount %></div>
        </div>
      </div>
    </div>
  </div>
</div>
