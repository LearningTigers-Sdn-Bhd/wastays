<!-- Check-In / Edit Check-In Modal -->
<dialog id="check-in-modal-show-<%= booking.id %>"
        class="fixed inset-0 m-auto rounded-2xl p-0 w-[min(92vw,42rem)] max-w-2xl shadow-2xl backdrop:bg-slate-900/50" onclick="if(event.target===this){this.close()}">
  <div class="p-6 bg-white" onclick="event.stopPropagation()" data-controller="scanner">
    <h3 class="text-lg font-bold text-slate-900"><%= booking.checked_in? ? "Edit Check-In" : "Confirm Check-In" %></h3>
    <p class="text-sm text-slate-500 mt-1">Set check-in time and assign rooms for <%= booking.guest_name %>.</p>

    <%= form_with model: booking, url: check_in_hotel_booking_path(current_hotel, booking), method: :post, 
        class: "mt-4 space-y-4" do |f| %>
      <div>
        <label class="block text-[11px] font-bold text-slate-500 uppercase tracking-wider mb-2">Check-in Date & Time</label>
        <%= f.datetime_local_field :checked_in_at,
            value: presenter.checked_in_at_form_value,
            class: "w-full rounded-xl border border-slate-200 bg-white py-2.5 px-4 text-sm text-slate-700 focus:border-slate-300 focus:outline-none focus:ring-0 shadow-sm" %>
      </div>

      <% unless booking.checked_in? %>
        <div class="rounded-2xl border border-slate-200 bg-slate-50/70 p-4">
          <label class="flex items-start justify-between gap-4">
            <span>
              <span class="block text-sm font-bold text-slate-900">Collect security deposit</span>
              <span class="mt-1 block text-xs font-medium text-slate-500">Record a manual security deposit (e.g., cash, card authorization). This is tracked independently from the guest folio.</span>
            </span>
            <%= check_box_tag :collect_security_deposit, "1", false, class: "mt-1 rounded border-slate-300 text-slate-900 focus:ring-slate-900" %>
          </label>

          <div class="mt-4 grid gap-3 sm:grid-cols-2">
            <div>
              <%= label_tag :security_deposit_amount, "Amount", class: "block text-[11px] font-bold text-slate-500 uppercase tracking-wider mb-2" %>
              <%= number_field_tag :security_deposit_amount, nil, step: 0.01, min: 0, class: "w-full rounded-xl border border-slate-200 bg-white py-2.5 px-4 text-sm text-slate-700 focus:border-slate-300 focus:outline-none focus:ring-0 shadow-sm" %>
            </div>
            <div>
              <%= label_tag :security_deposit_payment_method, "Method", class: "block text-[11px] font-bold text-slate-500 uppercase tracking-wider mb-2" %>
              <%= select_tag :security_deposit_payment_method, options_for_select([["Cash", "cash"], ["Credit Card", "credit_card"], ["Bank Transfer", "bank_transfer"], ["Manual", "manual"]], "cash"), class: "w-full rounded-xl border border-slate-200 bg-white py-2.5 px-4 text-sm text-slate-700 focus:border-slate-300 focus:outline-none focus:ring-0 shadow-sm" %>
            </div>
          </div>
          <div class="mt-3">
            <%= label_tag :security_deposit_reference, "Reference", class: "block text-[11px] font-bold text-slate-500 uppercase tracking-wider mb-2" %>
            <%= text_field_tag :security_deposit_reference, nil, placeholder: "Optional receipt/reference", class: "w-full rounded-xl border border-slate-200 bg-white py-2.5 px-4 text-sm text-slate-700 focus:border-slate-300 focus:outline-none focus:ring-0 shadow-sm" %>
          </div>
        </div>
      <% end %>

      <div class="p-4 bg-slate-50 rounded-2xl border border-slate-200">
        <label class="block text-[11px] font-bold text-slate-500 uppercase tracking-wider mb-2">Guarantee Method</label>
        <%= f.select :guarantee_method,
            Booking::GUARANTEE_METHODS.map { |m| [m.titleize, m] },
            { prompt: "Select Method" },
            class: "w-full rounded-xl border border-slate-200 bg-white py-2.5 px-4 text-sm font-bold text-slate-700 focus:border-slate-300 focus:outline-none focus:ring-0 shadow-sm" %>
      </div>

      <div class="space-y-3">
        <label class="block text-[11px] font-bold text-slate-500 uppercase tracking-wider">Room Assignments</label>
        <%= f.fields_for :booking_rooms do |rf| %>
          <div class="flex items-center gap-3" 
               data-controller="room-lock"
               data-room-lock-url-value="<%= hotel_room_locks_path(current_hotel) %>"
               data-room-lock-room-type-id-value="<%= rf.object.room_type_id %>"
               data-room-lock-current-room-value="<%= rf.object.room_number %>">
            <div class="flex-1">
              <p class="text-[10px] font-medium text-slate-400 uppercase mb-1"><%= rf.object.room_type.name %></p>
              <%= rf.text_field :room_number, 
                  placeholder: "Room No.",
                  class: "w-full rounded-xl border border-slate-200 bg-white py-2 px-4 text-sm text-slate-700 focus:border-slate-300 focus:outline-none focus:ring-0 shadow-sm",
                  data: { action: "change->room-lock#lock" } %>
            </div>
          <% end %>
          </div>
          </div>

          <% if presenter.requires_backdated_checkin_reason? %>
          <div class="mt-4 pt-4 border-t border-slate-100">
          <div class="flex gap-3">
            <div class="flex-shrink-0 mt-0.5">
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-orange-500"><path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3Z"/><path d="M12 9v4"/><path d="M12 17h.01"/></svg>
            </div>
            <div class="flex-1">
              <h4 class="text-xs font-bold text-slate-900">Backdated Check-in</h4>
              <p class="text-[11px] text-slate-500 mt-1 mb-3">Night audit has already run for this check-in date. This operation is for unexpected arrivals after the audit.</p>

              <div class="space-y-3">
                <label class="flex items-center gap-2">
                  <%= check_box_tag :override_night_audit, "1", false, class: "rounded text-slate-900 focus:ring-slate-900 border-slate-300" %>
                  <span class="text-[11px] font-bold text-slate-700 uppercase tracking-wider">Override Night Audit</span>
                </label>

                <div>
                  <%= text_field_tag :retroactive_reason, nil, placeholder: "Provide a reason (e.g. system offline, missed check-in)", class: "w-full rounded-xl border border-slate-200 bg-white py-2.5 px-4 text-sm text-slate-700 focus:border-slate-300 focus:outline-none focus:ring-0 shadow-sm" %>
                </div>
              </div>
            </div>
          </div>
          </div>
          <% end %>

          <div class="mt-4 pt-4 border-t border-slate-100">
          <label class="block text-[11px] font-bold text-slate-500 uppercase tracking-wider mb-4">Identity Verification</label>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <%= render "shared/id_scanner", f: f, field: :id_front, side: :front, label: "Front / Passport" %>
          <%= render "shared/id_scanner", f: f, field: :id_back, side: :back, label: "Back (Optional)" %>
        </div>
      </div>

      <div class="flex items-center justify-end gap-x-3 pt-2">
        <button type="button" class="px-4 py-2 text-sm font-semibold text-slate-700 hover:bg-slate-50 rounded-lg transition" onclick="this.closest('dialog').close()">Cancel</button>
        <%= f.submit (booking.checked_in? ? "Save Changes" : "Confirm Check In"), class: "px-4 py-2 text-sm font-bold bg-slate-900 text-white rounded-lg hover:bg-slate-700 transition shadow-sm" %>
      </div>
    <% end %>

    <%= render "shared/scanner_modal" %>
  </div>
</dialog>

<!-- Check-Out Modal -->
<dialog id="check-out-modal-show-<%= booking.id %>" class="fixed inset-0 m-auto rounded-2xl p-0 w-[min(92vw,28rem)] max-w-md shadow-2xl backdrop:bg-slate-900/50" onclick="if(event.target===this){this.close()}">
  <div class="p-6 bg-white" onclick="event.stopPropagation()">
    <h3 class="text-lg font-bold text-slate-900">Confirm Check-Out</h3>
    <p class="text-sm text-slate-500 mt-1">Set check-out time for <%= booking.guest_name %>.</p>

    <%= form_with url: check_out_hotel_booking_path(current_hotel, booking), method: :post, class: "mt-6 space-y-4" do |f| %>
      <div>
        <label class="block text-[11px] font-bold text-slate-500 uppercase tracking-wider mb-2">Check-out Date & Time</label>
        <%= f.datetime_local_field :checked_out_at,
            value: presenter.checked_out_at_form_value,
            class: "w-full rounded-xl border border-slate-200 bg-white py-2.5 px-4 text-sm text-slate-700 focus:border-slate-300 focus:outline-none focus:ring-0 shadow-sm" %>
      </div>

      <div class="flex items-center justify-end gap-x-3 pt-2">
        <button type="button" class="px-4 py-2 text-sm font-semibold text-slate-700 hover:bg-slate-50 rounded-lg transition" onclick="this.closest('dialog').close()">Cancel</button>
        <%= f.submit "Confirm Check-Out", class: "px-4 py-2 text-sm font-bold bg-slate-900 text-white rounded-lg hover:bg-slate-700 transition shadow-sm" %>
      </div>
    <% end %>
  </div>
</dialog>
