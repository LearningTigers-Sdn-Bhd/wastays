<dialog id="late-checkout-modal-show-<%= booking.id %>" 
        class="fixed inset-0 m-auto rounded-2xl p-0 w-[min(92vw,32rem)] max-w-lg shadow-2xl backdrop:bg-slate-900/50" 
        onclick="if(event.target===this){this.close()}">
  <div class="p-6 bg-white" onclick="event.stopPropagation()" 
       data-controller="late-checkout"
       data-late-checkout-base-amount-value="<%= @presenter.suggested_late_checkout_amount %>"
       data-late-checkout-currency-value="<%= @presenter.currency %>">
    <h3 class="text-lg font-bold text-slate-900">Review Late Checkout</h3>
    <p class="text-sm text-slate-500 mt-1">Calculate and post a charge for <%= booking.guest_name %>.</p>

    <%= form_with url: process_late_checkout_hotel_booking_path(current_hotel, booking), method: :post, local: true, class: "mt-6 space-y-6" do |f| %>
      <%= render "hotel_portal/bookings/show/modals/late_checkout_form_fields", form: f, booking: booking, presenter: @presenter %>

      <div class="flex items-center justify-end gap-x-3 pt-2">
        <button type="button" class="px-4 py-2 text-sm font-semibold text-slate-700 hover:bg-slate-50 rounded-lg transition" onclick="this.closest('dialog').close()">Cancel</button>
        <%= f.submit "Process Late Checkout", class: "px-4 py-2 text-sm font-bold bg-amber-600 text-white rounded-lg hover:bg-amber-700 transition shadow-sm" %>
      </div>
    <% end %>
  </div>
</dialog>
