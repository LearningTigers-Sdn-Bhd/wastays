<%# app/views/hotel_portal/bookings/_reinstate_modal.html.erb %>
<dialog id="reinstate-modal-show-<%= booking.id %>"
        class="fixed inset-0 m-auto rounded-2xl p-0 w-[min(92vw,34rem)] max-w-xl shadow-2xl backdrop:bg-slate-900/50" onclick="if(event.target===this){this.close()}">
  <div class="p-6 bg-white" onclick="event.stopPropagation()">
    <h3 class="text-lg font-bold text-slate-900">Reinstate Reservation</h3>
    <p class="text-sm text-slate-500 mt-1">This booking was marked as No-Show. Reinstate it to check the guest in and resume the stay.</p>
    
    <%= form_with model: booking, url: reinstate_hotel_booking_path(current_hotel, booking), method: :post, local: true, class: "mt-6 space-y-4" do |f| %>
      <div class="space-y-3">
        <h4 class="text-[11px] font-bold text-slate-500 uppercase tracking-wider">Stay Information</h4>
        <div class="grid grid-cols-2 gap-4">
          <div>
            <p class="text-[10px] text-slate-500 uppercase font-bold">Check-in</p>
            <p class="text-sm font-semibold text-slate-900"><%= booking.check_in.strftime("%d %b %Y") %></p>
          </div>
          <div>
            <p class="text-[10px] text-slate-500 uppercase font-bold">Check-out</p>
            <p class="text-sm font-semibold text-slate-900"><%= booking.check_out.strftime("%d %b %Y") %></p>
          </div>
        </div>
      </div>

      <div class="space-y-3">
        <label class="block text-[11px] font-bold text-slate-500 uppercase tracking-wider">Room Assignment</label>
        <p class="text-xs text-slate-500 leading-relaxed">Confirm or select a room category, room number, and rate before reinstating.</p>
        
        <%= f.fields_for :booking_rooms do |rf| %>
          <div class="rounded-xl border border-slate-200 bg-white p-4 space-y-4"
               data-controller="booking-calc room-lock"
               data-room-lock-url-value="<%= hotel_room_locks_path(current_hotel) %>"
               data-room-lock-current-room-value="<%= rf.object.room_number %>"
               data-room-lock-room-type-id-value="<%= rf.object.room_type_id %>"
               data-booking-calc-availability-url-value="<%= availability_hotel_bookings_path(current_hotel) %>"
               data-booking-calc-rate-options-url-value="<%= rate_options_hotel_bookings_path(current_hotel) %>"
               data-booking-calc-exclude-booking-id-value="<%= booking.id %>">
            <%= rf.hidden_field :id %>
            <input type="hidden" value="<%= booking.check_in %>" data-booking-calc-target="checkIn">
            <input type="hidden" value="<%= booking.check_out %>" data-booking-calc-target="checkOut">

            <div class="grid gap-4 sm:grid-cols-2">
              <div>
                <%= rf.label :room_type_id, "Room Category", class: "block text-[11px] font-bold text-slate-500 uppercase tracking-wider mb-2" %>
                <%= rf.collection_select :room_type_id, current_hotel.room_types.order(:name), :id, :name, { prompt: "Select a category" },
                    { required: true,
                      class: "w-full rounded-xl border border-slate-200 bg-white px-4 py-2.5 text-sm font-medium text-slate-700 focus:border-slate-300 focus:outline-none focus:ring-0 shadow-sm",
                      data: { booking_calc_target: "roomType", action: "change->booking-calc#calculate" } } %>
              </div>
              <div data-booking-calc-target="roomNumberContainer">
                <%= rf.label :room_number, "Room Number", class: "block text-[11px] font-bold text-slate-500 uppercase tracking-wider mb-2" %>
                <%= rf.select :room_number, (rf.object.room_number.present? ? [[rf.object.room_number, rf.object.room_number]] : []), { prompt: "Select a room" },
                    { required: true,
                      disabled: rf.object.room_number.blank?,
                      class: "w-full rounded-xl border border-slate-200 bg-white px-4 py-2.5 text-sm font-medium text-slate-700 focus:border-slate-300 focus:outline-none focus:ring-0 shadow-sm",
                      data: { booking_calc_target: "roomNumberSelect", action: "change->room-lock#lock" } } %>
              </div>
            </div>

            <div>
              <%= rf.label :rate_plan_id, "Select Rate", class: "block text-[11px] font-bold text-slate-500 uppercase tracking-wider mb-2" %>
              <%= rf.select :rate_plan_id, (rf.object.rate_plan.present? ? [[rf.object.rate_plan.name, rf.object.rate_plan_id]] : []), { prompt: "Select a rate" },
                  { class: "w-full rounded-xl border border-slate-200 bg-white px-4 py-2.5 text-sm font-medium text-slate-700 focus:border-slate-300 focus:outline-none focus:ring-0 shadow-sm",
                    data: { booking_calc_target: "ratePlanSelect", action: "change->booking-calc#calculate" } } %>
            </div>
          </div>
        <% end %>
      </div>

      <div class="space-y-2">
        <label class="text-[11px] font-bold text-slate-500 uppercase tracking-wider">Reason for Reinstatement</label>
        <%= text_area_tag :retroactive_reason, "Guest arrived late after night audit.", 
            rows: 2, 
            required: true,
            class: "w-full rounded-xl border border-slate-200 bg-white py-2.5 px-4 text-sm text-slate-700 placeholder:text-slate-400 focus:border-slate-300 focus:outline-none focus:ring-0 shadow-sm" %>
      </div>

      <div class="flex items-center gap-3 pt-4">
        <button type="button" class="flex-1 rounded-xl border border-slate-200 bg-white px-4 py-2.5 text-sm font-bold text-slate-700 transition hover:bg-slate-50" onclick="this.closest('dialog').close()">
          Cancel
        </button>
        <button type="submit" class="flex-1 rounded-xl bg-blue-600 px-4 py-2.5 text-sm font-bold text-white shadow-sm transition hover:bg-blue-700">
          Reinstate & Check In
        </button>
      </div>
    <% end %>
  </div>
</dialog>
