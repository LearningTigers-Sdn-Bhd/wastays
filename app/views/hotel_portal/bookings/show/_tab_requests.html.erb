<div class="space-y-4 animate-in fade-in duration-300">
  <div class="grid gap-4 lg:grid-cols-2">
    <!-- Housekeeping -->
    <div class="h-fit overflow-hidden rounded-lg border border-slate-200 bg-white">
      <div class="flex items-center justify-between gap-3 border-b border-slate-200 bg-slate-50 px-4 py-3">
        <div>
          <h2 class="inline-flex items-center gap-2 text-sm font-semibold tracking-tight text-slate-950"><span class="inline-flex size-6 items-center justify-center rounded-md bg-blue-50 text-blue-700"><%= cached_icon "sparkles", class: "size-3.5" %></span> Housekeeping</h2>
          <p class="mt-1 text-sm font-medium text-slate-600">Guest requests for room services.</p>
        </div>
        <span class="inline-flex items-center gap-1 rounded-full border border-slate-200 bg-white px-2.5 py-1 text-[11px] font-semibold text-slate-700">
          <%= cached_icon "inbox", class: "size-3" %>
          <%= presenter.housekeeping_requests.to_a.count %>
        </span>
      </div>
      <div class="space-y-3 p-4">
        <% if presenter.housekeeping_requests.any? %>
          <% presenter.housekeeping_requests.each do |request| %>
            <div class="space-y-3 rounded-lg border border-slate-200 bg-slate-50/60 p-3">
              <div class="flex items-start justify-between gap-4">
                <div class="flex-1 min-w-0 space-y-2">
                  <div>
                    <dt class="inline-flex items-center gap-1 text-[10px] font-bold text-slate-500 uppercase tracking-widest"><%= cached_icon "clock", class: "size-3 text-slate-400" %> Requested</dt>
                    <dd class="text-xs font-semibold text-slate-900"><%= display_housekeeping_datetime(request.display_requested_at) %></dd>
                  </div>
                  <div>
                    <dt class="inline-flex items-center gap-1 text-[10px] font-bold text-slate-500 uppercase tracking-widest"><%= cached_icon "message-square", class: "size-3 text-slate-400" %> Details</dt>
                    <dd class="text-sm text-slate-700 leading-relaxed"><%= request.request_details %></dd>
                  </div>
                </div>
                <span class="inline-flex items-center gap-1 rounded-full border px-2 py-0.5 text-[10px] font-bold uppercase tracking-wider <%= status_badge_class(housekeeping_status_class(request.status)) %> bg-opacity-10">
                  <%= cached_icon "circle", class: "size-2" %>
                  <%= request.status %>
                </span>
              </div>
              <% unless request.completed? || request.cancelled? %>
                <div class="flex justify-end gap-2 pt-2">
                   <%= button_to complete_housekeeping_request_hotel_booking_path(current_hotel, booking, housekeeping_request_id: request.id), method: :post, class: "inline-flex items-center gap-1.5 rounded-md bg-slate-900 px-3 py-1.5 text-xs font-semibold text-white transition hover:bg-slate-700" do %>
                     <%= cached_icon "check", class: "size-3" %> Complete Request
                   <% end %>
                </div>
              <% end %>
            </div>
          <% end %>
        <% else %>
          <div class="flex items-center justify-center gap-2 rounded-lg border border-dashed border-slate-200 py-6 text-center">
            <span class="inline-flex size-6 items-center justify-center rounded-md bg-slate-100 text-slate-400"><%= cached_icon "sparkles", class: "size-3.5" %></span>
            <p class="text-sm font-medium text-slate-500">No housekeeping requests.</p>
          </div>
        <% end %>
      </div>
    </div>

    <!-- Complaints -->
    <div class="h-fit overflow-hidden rounded-lg border border-slate-200 bg-white">
      <div class="flex items-center justify-between gap-3 border-b border-slate-200 bg-slate-50 px-4 py-3">
        <div>
          <h2 class="inline-flex items-center gap-2 text-sm font-semibold tracking-tight text-slate-950"><span class="inline-flex size-6 items-center justify-center rounded-md bg-amber-50 text-amber-700"><%= cached_icon "triangle-alert", class: "size-3.5" %></span> Complaints</h2>
          <p class="mt-1 text-sm font-medium text-slate-600">Guest-reported issues and status.</p>
        </div>
        <span class="inline-flex items-center gap-1 rounded-full border border-slate-200 bg-white px-2.5 py-1 text-[11px] font-semibold text-slate-700">
          <%= cached_icon "inbox", class: "size-3" %>
          <%= presenter.complaint_requests.to_a.count %>
        </span>
      </div>
      <div class="space-y-3 p-4">
        <% if presenter.complaint_requests.any? %>
          <% presenter.complaint_requests.each do |request| %>
            <div class="space-y-3 rounded-lg border border-slate-200 bg-slate-50/60 p-3">
              <div class="flex items-start justify-between gap-4">
                <div class="flex-1 min-w-0 space-y-2">
                  <div>
                    <dt class="inline-flex items-center gap-1 text-[10px] font-bold text-slate-500 uppercase tracking-widest"><%= cached_icon "clock", class: "size-3 text-slate-400" %> Reported</dt>
                    <dd class="text-xs font-semibold text-slate-900"><%= display_housekeeping_datetime(request.display_requested_at) %></dd>
                  </div>
                  <div>
                    <dt class="inline-flex items-center gap-1 text-[10px] font-bold text-slate-500 uppercase tracking-widest"><%= cached_icon "message-square", class: "size-3 text-amber-500" %> Details</dt>
                    <dd class="text-sm text-slate-700 leading-relaxed"><%= request.complaint_details %></dd>
                  </div>
                </div>
                <span class="inline-flex items-center gap-1 rounded-full border px-2 py-0.5 text-[10px] font-bold uppercase tracking-wider <%= status_badge_class(complaint_status_class(request.status)) %> bg-opacity-10">
                  <%= cached_icon "circle", class: "size-2" %>
                  <%= request.status %>
                </span>
              </div>
              <% unless request.resolved? || request.cancelled? %>
                <div class="flex justify-end gap-2 pt-2">
                   <%= button_to resolve_complaint_request_hotel_booking_path(current_hotel, booking, complaint_request_id: request.id), method: :post, class: "inline-flex items-center gap-1.5 rounded-md bg-slate-900 px-3 py-1.5 text-xs font-semibold text-white transition hover:bg-slate-700" do %>
                     <%= cached_icon "check-circle", class: "size-3" %> Resolve Complaint
                   <% end %>
                </div>
              <% end %>
            </div>
          <% end %>
        <% else %>
          <div class="flex items-center justify-center gap-2 rounded-lg border border-dashed border-slate-200 py-6 text-center">
            <span class="inline-flex size-6 items-center justify-center rounded-md bg-slate-100 text-slate-400"><%= cached_icon "triangle-alert", class: "size-3.5" %></span>
            <p class="text-sm font-medium text-slate-500">No complaint requests.</p>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</div>
