<section class="overflow-hidden rounded-lg border border-slate-200 bg-white">
  <details>
    <summary class="flex cursor-pointer list-none items-center justify-between gap-3 border-b border-slate-200 bg-slate-50 px-4 py-3 [&::-webkit-details-marker]:hidden">
      <div>
        <h2 class="inline-flex items-center gap-2 text-sm font-semibold text-slate-950"><span class="inline-flex size-6 items-center justify-center rounded-md bg-emerald-50 text-emerald-700"><%= cached_icon "coins", class: "size-3.5" %></span> Price Summary</h2>
        <p class="text-xs text-slate-500">Room total, taxes, and booking total.</p>
      </div>
      <span class="inline-flex items-center gap-1 rounded-md border border-slate-200 bg-white px-2 py-1 text-xs font-semibold text-slate-700"><%= cached_icon "list", class: "size-3" %> Breakdown ▾</span>
    </summary>

    <div class="border-b border-slate-200 bg-white px-4 py-3">
      <div class="space-y-2 text-sm">
        <% booking.booking_rooms.each do |room| %>
          <div class="flex items-start justify-between gap-4">
            <div>
              <p class="inline-flex items-center gap-1 font-medium text-slate-800"><%= cached_icon "bed", class: "size-3 text-slate-400" %><%= room.room_type_snapshot["name"].presence || room.room_type&.name || "Room" %></p>
              <p class="text-xs text-slate-500"><%= pluralize(room.quantity, "room") %><%= " · #{room.rate_plan.name}" if room.rate_plan.present? %></p>
            </div>
            <p class="font-medium text-slate-900"><%= presenter.currency %> <%= number_with_precision(room.subtotal, precision: 2) %></p>
          </div>
        <% end %>

        <% Array(booking.tax_lines).each do |tax| %>
          <div class="flex items-center justify-between gap-4 border-t border-slate-100 pt-2">
            <p class="inline-flex items-center gap-1 text-slate-600"><%= cached_icon "percent", class: "size-3 text-amber-500" %><%= tax["name"] %></p>
            <p class="font-medium text-slate-900"><%= presenter.currency %> <%= number_with_precision(tax["amount"], precision: 2) %></p>
          </div>
        <% end %>
      </div>
    </div>
  </details>

  <div class="grid divide-y divide-slate-200 sm:grid-cols-3 sm:divide-x sm:divide-y-0">
    <div class="px-4 py-3">
      <p class="inline-flex items-center gap-1 text-[10px] font-semibold uppercase tracking-wide text-slate-500"><%= cached_icon "bed", class: "size-3 text-slate-400" %> Room Total</p>
      <p class="mt-1 text-sm font-semibold text-slate-950"><%= presenter.currency %> <%= number_with_precision(presenter.room_total, precision: 2) %></p>
    </div>
    <div class="px-4 py-3">
      <p class="inline-flex items-center gap-1 text-[10px] font-semibold uppercase tracking-wide text-slate-500"><%= cached_icon "receipt-text", class: "size-3 text-amber-500" %> Taxes / Charges</p>
      <p class="mt-1 text-sm font-semibold text-slate-950"><%= presenter.currency %> <%= number_with_precision(presenter.taxes_total, precision: 2) %></p>
    </div>
    <div class="px-4 py-3">
      <p class="inline-flex items-center gap-1 text-[10px] font-semibold uppercase tracking-wide text-slate-500"><%= cached_icon "credit-card", class: "size-3 text-emerald-600" %> Total Paid</p>
      <p class="mt-1 text-sm font-semibold text-slate-950"><%= presenter.currency %> <%= number_with_precision(booking.total_amount, precision: 2) %></p>
    </div>
  </div>
</section>
