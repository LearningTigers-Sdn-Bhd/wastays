<% folio = booking.booking_folio %>
<% balance = (folio&.outstanding_balance || 0).to_d %>
<% currency = booking.currency.presence || "MYR" %>
<% checkout_error ||= nil %>
<% checkout_business_date = hotel.business_date_for(Time.current).to_date %>
<% early_departure = checkout_business_date < booking.check_out.to_date %>
<% early_checkout_lines = early_departure ? Folios::PostEarlyCheckoutCharges.pending_preview(booking: booking, folio: folio, departure_date: checkout_business_date, original_check_out: booking.check_out) : [] %>
<% early_checkout_total = early_checkout_lines.sum { |line| line[:amount].to_d } %>
<% projected_checkout_balance = early_departure ? balance + early_checkout_total : balance %>
<% can_record_checkout_refund = projected_checkout_balance.negative? && folio&.status == "open" && current_user.has_permission?("execute_folio_refunds", hotel: hotel) %>

<div class="flex h-full flex-col bg-slate-50/50">
  <div class="sticky top-0 z-10 border-b border-slate-200 bg-white px-6 py-4">
    <div class="flex items-start justify-between gap-4">
      <div>
        <p class="text-xs font-black uppercase tracking-[0.24em] text-slate-400">Step 1 of 2</p>
        <h2 class="mt-1 text-xl font-black tracking-tight text-slate-950">Checkout <%= booking.guest_name %></h2>
        <div class="mt-1.5 flex items-center gap-2">
          <p class="text-xs font-semibold uppercase tracking-wider text-slate-500"><%= booking.confirmation_token %> - <%= booking.check_in.strftime("%d %b") %> - <%= booking.check_out.strftime("%d %b %Y") %></p>
          <span class="inline-flex items-center rounded-full bg-slate-100 px-2 py-0.5 text-[10px] font-bold text-slate-600 uppercase tracking-widest">
            Deposit: <%= (booking.deposit_status || 'not_required').titleize %>
          </span>
        </div>
      </div>
      <button type="button" class="text-slate-400 transition hover:text-slate-600" data-action="click->offcanvas#close">
        <%= lucide_icon "x", stroke_width: 2.5, class: "size-6" %>
      </button>
    </div>
  </div>

  <div class="min-h-0 flex-1 overflow-y-auto p-4 sm:p-6 lg:p-8">
    <div class="mx-auto max-w-[1500px] space-y-6">
      <% if checkout_error.present? %>
        <div class="rounded-2xl border border-red-200 bg-red-50 p-4 text-sm font-semibold text-red-800" data-controller="auto-scroll-top">
          <%= checkout_error %>
        </div>
      <% end %>

      <%= render "hotel_portal/bookings/folio/folio_balance_summary", booking: booking, projected_lines: early_checkout_lines %>

      <%= form_with url: check_out_hotel_booking_path(hotel, booking), method: :post, class: "grid gap-6 xl:grid-cols-[420px_1fr]", data: { turbo_frame: "_top" } do |f| %>
        <%= hidden_field_tag :checkout_sheet, "1" %>

        <div class="space-y-6">
          <div class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">
            <div class="border-b border-slate-200 bg-slate-50/70 px-6 py-4">
              <h3 class="text-sm font-black uppercase tracking-widest text-slate-900">Checkout Time</h3>
            </div>
            <div class="p-6">
              <label class="block text-[11px] font-bold text-slate-500 uppercase tracking-wider mb-2">Check-out Date & Time</label>
              <%= f.datetime_local_field :checked_out_at,
                  value: presenter.checked_out_at_form_value,
                  class: "w-full rounded-xl border border-slate-200 bg-white px-4 py-2.5 text-sm font-semibold text-slate-700 shadow-sm focus:border-slate-300 focus:outline-none focus:ring-0" %>
            </div>
          </div>

          <% if early_departure %>
            <% nights = (booking.check_out.to_date - booking.check_in.to_date).to_i %>
            <% suggested_charge = nights.positive? ? (booking.total_amount.to_d / nights).round(2) : 0 %>
            <div class="overflow-hidden rounded-2xl border border-blue-200 bg-white shadow-sm"
                 data-controller="early-departure"
                 data-early-departure-base-amount-value="<%= suggested_charge %>">
              <div class="border-b border-blue-100 bg-blue-50/50 px-6 py-4 flex items-center justify-between">
                <div>
                  <h3 class="text-sm font-black uppercase tracking-widest text-blue-900">Early Departure Review</h3>
                  <p class="text-[11px] font-bold text-blue-700">Scheduled: <%= booking.check_out.strftime("%d %b %Y") %></p>
                </div>
                <span class="inline-flex items-center rounded-full bg-blue-100 px-2 py-0.5 text-[10px] font-bold text-blue-700 uppercase tracking-wider">Early</span>
              </div>
              <div class="p-6 space-y-4">
                <div>
                  <p class="text-[13px] font-medium leading-relaxed text-slate-600">The guest is departing before their scheduled checkout date. Any charges for unused nights will be posted to the folio upon completion of this checkout process.</p>
                </div>

                <div class="space-y-3">
                  <label class="block text-[10px] font-black text-slate-500 uppercase tracking-widest">Apply Additional Charge?</label>
                  <div class="grid grid-cols-2 gap-3">
                    <label class="flex items-center justify-center gap-2 rounded-xl border border-slate-200 bg-white p-3 cursor-pointer has-[:checked]:border-blue-600 has-[:checked]:bg-blue-50/50 transition-all shadow-sm">
                      <%= radio_button_tag :apply_charge, "false", true, class: "sr-only", data: { action: "change->early-departure#updateUI", early_departure_target: "chargeChoice" } %>
                      <span class="text-xs font-bold text-slate-600">No Charge</span>
                    </label>
                    <label class="flex items-center justify-center gap-2 rounded-xl border border-slate-200 bg-white p-3 cursor-pointer has-[:checked]:border-blue-600 has-[:checked]:bg-blue-50/50 transition-all shadow-sm">
                      <%= radio_button_tag :apply_charge, "true", false, class: "sr-only", data: { action: "change->early-departure#updateUI", early_departure_target: "chargeChoice" } %>
                      <span class="text-xs font-bold text-slate-600">Apply Charge</span>
                    </label>
                  </div>
                </div>

                <div class="hidden space-y-4 pt-3 border-t border-slate-100" data-early-departure-target="customFields">
                  <div class="grid grid-cols-2 gap-4">
                    <div>
                      <label class="block text-[10px] font-black text-slate-500 uppercase tracking-widest mb-2">Type</label>
                      <%= select_tag "early_departure[type]", options_for_select([["Fixed Amount", "amount"], ["Percentage (%)", "percentage"]], "amount"), 
                          class: "w-full rounded-xl border border-slate-200 bg-white py-2 px-3 text-xs font-bold text-slate-700 focus:border-slate-300 focus:outline-none shadow-sm",
                          data: { action: "change->early-departure#updateCalculation" } %>
                    </div>
                    <div>
                      <label class="block text-[10px] font-black text-slate-500 uppercase tracking-widest mb-2">Value</label>
                      <%= number_field_tag "early_departure[value]", nil, step: 0.01, placeholder: "0.00",
                          class: "w-full rounded-xl border border-slate-200 bg-white py-2 px-3 text-xs font-bold text-slate-700 focus:border-slate-300 focus:outline-none shadow-sm",
                          data: { action: "input->early-departure#updateCalculation" } %>
                    </div>
                  </div>
                  <div class="flex items-center justify-between pt-2">
                    <span class="text-[11px] font-bold text-slate-500 uppercase tracking-wider">Total Charge</span>
                    <span class="text-sm font-black text-slate-900" data-early-departure-target="displayAmount"><%= currency %> 0.00</span>
                  </div>
                  <%= hidden_field_tag :charge_amount, 0, data: { early_departure_target: "amountInput" } %>
                </div>
              </div>
            </div>
          <% end %>

          <% held_deposits = booking.deposits.where(status: "collected") %>
          <% show_deposit_section = held_deposits.any? || (booking.deposit_status.present? && booking.deposit_status != "not_required") %>
          
          <% if show_deposit_section %>
            <div class="overflow-hidden rounded-2xl border border-amber-200 bg-white shadow-sm">
              <div class="border-b border-amber-100 bg-amber-50/50 px-6 py-4 flex items-center justify-between">
                <div>
                  <h3 class="text-sm font-black uppercase tracking-widest text-amber-900">Security Deposit Status</h3>
                  <p class="text-[11px] font-bold text-amber-700">Tracking for damages and incidentals.</p>
                </div>
                <div class="size-8 rounded-xl bg-amber-100 flex items-center justify-center text-amber-600">
                  <%= lucide_icon "shield-check", stroke_width: 2.5, class: "size-4" %>
                </div>
              </div>
              <div class="p-6 space-y-4">
                <div class="flex items-center justify-between">
                  <span class="text-xs font-bold text-slate-500 uppercase tracking-wider">Current Status</span>
                  <span class="inline-flex items-center rounded-full bg-amber-100 px-2.5 py-1 text-[10px] font-black text-amber-700 uppercase tracking-widest">
                    <%= (booking.deposit_status || 'not_required').titleize %>
                  </span>
                </div>

                <% if held_deposits.any? %>
                  <div class="pt-4 border-t border-slate-100">
                    <p class="text-[10px] font-black text-slate-400 uppercase tracking-[0.15em] mb-3">Collected Records</p>
                    <table class="w-full text-left text-sm">
                      <tbody class="divide-y divide-slate-100">
                        <% held_deposits.each do |deposit| %>
                          <tr>
                            <td class="py-2">
                              <p class="text-xs font-bold text-slate-900"><%= deposit.payment_method.to_s.titleize %> Deposit</p>
                              <p class="text-[10px] text-slate-500 font-medium"><%= deposit.collected_at&.strftime("%d %b %Y, %H:%M") || deposit.created_at.strftime("%d %b %Y, %H:%M") %></p>
                            </td>
                            <td class="py-2 text-right font-black text-slate-900">
                              <%= deposit.currency %> <%= number_with_precision(deposit.amount, precision: 2) %>
                            </td>
                          </tr>
                        <% end %>
                      </tbody>
                    </table>
                  </div>
                <% end %>

                <div class="rounded-xl bg-slate-50 p-3 border border-slate-100">
                  <p class="text-[11px] font-semibold leading-relaxed text-slate-600 italic">
                    Reminder: Security deposits are tracked independently from the folio. Ensure they are returned or settled before the guest leaves.
                  </p>
                </div>
              </div>
            </div>
          <% end %>

          <div class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">
            <div class="border-b border-slate-200 bg-slate-50/70 px-6 py-4">
              <h3 class="text-sm font-black uppercase tracking-widest text-slate-900">Resolve Balance</h3>
            </div>
            <div class="space-y-5 p-6">
              <% if folio.blank? %>
                <div class="rounded-xl border border-red-100 bg-red-50 p-4">
                  <p class="text-sm font-bold text-red-900">Folio required</p>
                  <p class="mt-1 text-xs font-medium leading-relaxed text-red-700">This booking must have a folio before checkout can be completed.</p>
                </div>
              <% elsif projected_checkout_balance.positive? %>
                <div class="rounded-xl border border-amber-100 bg-amber-50 p-4">
                  <p class="text-sm font-bold text-amber-900">Payment required before checkout</p>
                  <p class="mt-1 text-xs font-medium leading-relaxed text-amber-700">Post a settlement payment below. Checkout will run immediately after the payment is recorded.</p>
                </div>

                <div>
                  <%= label_tag :checkout_payment_method, "Payment Method", class: "block text-[11px] font-bold text-slate-500 uppercase tracking-wider mb-2" %>
                  <%= select_tag :checkout_payment_method,
                      options_for_select([["Cash", "cash"]], "cash"),
                      class: "w-full rounded-xl border border-slate-200 bg-white px-4 py-2.5 text-sm font-semibold text-slate-700 shadow-sm focus:border-slate-300 focus:outline-none focus:ring-0" %>
                  <p class="mt-1.5 text-[11px] font-medium text-slate-500">Additional payment categories can be enabled once General Ledger (GL) mappings are configured.</p>
                </div>

                <div>
                  <%= label_tag :checkout_payment_amount, "Amount (#{currency})", class: "block text-[11px] font-bold text-slate-500 uppercase tracking-wider mb-2" %>
                  <%= number_field_tag :checkout_payment_amount, number_with_precision(projected_checkout_balance, precision: 2), step: "0.01", min: "0.01", max: projected_checkout_balance, required: true, class: "w-full rounded-xl border border-slate-200 bg-white px-4 py-2.5 text-sm font-semibold text-slate-700 shadow-sm focus:border-slate-300 focus:outline-none focus:ring-0" %>
                </div>

                <div>
                  <%= label_tag :checkout_payment_reference, "Receipt / Reference No.", class: "block text-[11px] font-bold text-slate-500 uppercase tracking-wider mb-2" %>
                  <%= text_field_tag :checkout_payment_reference, nil, placeholder: "Optional receipt number", class: "w-full rounded-xl border border-slate-200 bg-white px-4 py-2.5 text-sm font-semibold text-slate-700 placeholder:text-slate-400 shadow-sm focus:border-slate-300 focus:outline-none focus:ring-0" %>
                </div>
              <% elsif projected_checkout_balance.negative? %>
                <div class="rounded-xl border border-amber-100 bg-amber-50 p-4">
                  <p class="text-sm font-bold text-amber-900">Credit balance detected</p>
                  <p class="mt-1 text-xs font-medium leading-relaxed text-amber-700">Record a refund for the remaining credit before checking out this guest.</p>
                </div>
              <% elsif folio.status == "closed" %>
                <div class="rounded-xl border border-slate-200 bg-slate-50 p-4">
                  <p class="text-sm font-bold text-slate-900">Folio already closed</p>
                  <p class="mt-1 text-xs font-medium leading-relaxed text-slate-600">This folio has already been closed.</p>
                </div>
              <% else %>
                <div class="rounded-xl border border-emerald-100 bg-emerald-50 p-4">
                  <p class="text-sm font-bold text-emerald-900">Ready to close folio</p>
                  <p class="mt-1 text-xs font-medium leading-relaxed text-emerald-700">The folio is settled. Checkout will close the folio and move assigned rooms to pending cleaning.</p>
                </div>
              <% end %>
            </div>
          </div>
        </div>

        <div class="min-w-0">
          <% refund_action = nil %>
          <% if can_record_checkout_refund %>
            <% refund_action = capture do %>
              <button type="button" class="rounded-xl border border-amber-200 bg-amber-50 px-3 py-2 text-xs font-bold text-amber-800 shadow-sm transition hover:bg-amber-100" onclick="document.getElementById('checkout-refund-modal-<%= booking.id %>').showModal()">Record Refund</button>
            <% end %>
          <% end %>
          <%= render "hotel_portal/bookings/folio/folio_transaction_table", booking: booking, projected_lines: early_checkout_lines, header_action: refund_action %>
        </div>

        <div class="xl:col-span-2 flex items-center justify-end gap-x-4 border-t border-slate-200 bg-white px-6 py-4 rounded-2xl shadow-sm">
          <button type="button" class="rounded-xl px-6 py-3 text-sm font-bold text-slate-600 transition hover:bg-slate-50" data-action="click->offcanvas#close">Cancel</button>
          <%= f.submit "Complete Checkout", class: "cursor-pointer rounded-xl bg-slate-900 px-8 py-3 text-sm font-black text-white shadow-sm transition hover:bg-slate-700", data: { turbo_submits_with: "Checking out..." } %>
        </div>
      <% end %>

      <% if can_record_checkout_refund %>
        <%= render "hotel_portal/bookings/folio/modals/folio_transaction_modal",
            booking: booking,
            hotel: hotel,
            modal_id: "checkout-refund-modal-#{booking.id}",
            title: "Record Refund",
            description: "Record a refund for the remaining guest credit before checkout.",
            transaction_type: "payment",
            category: "refund",
            signed_amount: false,
            amount: projected_checkout_balance.abs,
            submit_label: "Record Refund",
            redirect_to_checkout: true %>
      <% end %>

    </div>
  </div>
</div>
