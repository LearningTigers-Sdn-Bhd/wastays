<%# locals: (form:, attribute:, label:, hint:, choices:, current: nil, custom_time: nil, error: nil) %>

<div class="space-y-3" data-controller="boat-transfer" data-action="change->boat-transfer#update">
  <%= render PanelsUI::FormField.new(form:, attribute:, label:, hint:, error:) do |field| %>
    <% field.with_select_menu(choices, selected: current.to_s) %>
  <% end %>
  <%= tag.div(hidden: !current.to_s.in?(BookingGuest::CUSTOM_BOAT_TYPES), data: { boat_transfer_target: "custom" }) do %>
    <%= render PanelsUI::FormField.new(
          form: form, attribute: attribute.to_s.sub("_time", "_custom_time").to_sym,
          label: "#{label} time", hint: "Required for Charter Boat. Optional for Own Boat.") do |field| %>
      <% field.with_time_picker(value: custom_time.to_s, minute_step: 1) %>
    <% end %>
  <% end %>
</div>
