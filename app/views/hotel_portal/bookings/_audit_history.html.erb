<div class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">
  <div class="border-b border-slate-200 bg-slate-50/70 px-6 py-5 sm:px-8">
    <h2 class="text-lg font-bold tracking-tight text-slate-950">Audit History</h2>
    <p class="mt-1 text-sm font-medium text-slate-600">Track all changes made to this booking.</p>
  </div>
  <div class="p-0">
    <div class="overflow-x-auto">
      <table class="w-full text-left">
        <thead class="bg-slate-50/50 border-b border-slate-200">
          <tr>
            <th class="px-6 py-3 text-[10px] font-bold text-slate-500 uppercase tracking-widest">Date & Time</th>
            <th class="px-6 py-3 text-[10px] font-bold text-slate-500 uppercase tracking-widest">User</th>
            <th class="px-6 py-3 text-[10px] font-bold text-slate-500 uppercase tracking-widest">Target</th>
            <th class="px-6 py-3 text-[10px] font-bold text-slate-500 uppercase tracking-widest">Action</th>
            <th class="px-6 py-3 text-[10px] font-bold text-slate-500 uppercase tracking-widest">Changes</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-100">
          <% if audit_logs.any? %>
            <% audit_logs.each do |log| %>
              <tr class="hover:bg-slate-50/50 transition-colors">
                <td class="px-6 py-4 text-sm text-slate-600 whitespace-nowrap">
                  <%= log.created_at.strftime("%d %b %Y, %H:%M") %>
                </td>
                <td class="px-6 py-4 text-sm font-medium text-slate-900 whitespace-nowrap">
                  <% if log.user.present? %>
                    <%= log.user.name %>
                  <% elsif %w[convert create pre_checkin_completed].include?(log.action_type) %>
                    <span class="text-blue-600">Guest</span>
                  <% else %>
                    <span class="text-slate-400">System</span>
                  <% end %>
                </td>
                <td class="px-6 py-4 text-sm text-slate-500 whitespace-nowrap">
                  <%= log.display_auditable_name %>
                </td>
                <td class="px-6 py-4 whitespace-nowrap">
                  <span class="inline-flex items-center rounded-md bg-slate-100 px-2 py-1 text-[10px] font-bold text-slate-600 uppercase">
                    <%= log.action_type %>
                  </span>
                </td>
                <td class="px-6 py-4 text-sm text-slate-600">
                  <%= log.display_value_change %>
                </td>
              </tr>
            <% end %>
          <% else %>
            <tr>
              <td colspan="4" class="px-6 py-10 text-center text-sm font-medium text-slate-500">
                No audit logs found for this booking.
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
</div>
