<div class="w-full">
  <div class="mb-5">
    <%= link_to hotel_room_types_path, class: "inline-flex items-center gap-x-1.5 text-sm text-muted-foreground hover:text-blue-600" do %>
      <svg class="flex-shrink-0 size-4" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg>
      Back to Room Types
    <% end %>
  </div>

  <div class="bg-card border border-border rounded-xl shadow-sm p-4 sm:p-7">
    <div class="mb-8 text-center">
      <h2 class="text-2xl font-bold text-foreground">Edit Room Type</h2>
      <p class="text-sm text-muted-foreground">Update your room category settings.</p>
    </div>
    <%= render 'form', room_type: @room_type %>
  </div>
</div>
