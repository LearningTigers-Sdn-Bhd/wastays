<% frame_id = turbo_frame_request_id.presence || "settings_action_sheet" %>
<% persisted = room_type.persisted? %>
<% form_id = persisted ? "edit-room-category-#{room_type.id}-form" : "new-room-category-form" %>

<%= turbo_frame_tag frame_id do %>
  <div data-controller="panels-ui--sheet-frame">
    <%# Locked (dismissible: false): the form is long enough that a stray Esc or
        backdrop click would discard real work. Cancel in the footer is the way out. %>
    <%= render PanelsUI::Sheet.new(
          id: persisted ? "edit-room-category-sheet" : "new-room-category-sheet",
          side: :bottom,
          size: :full,
          dismissible: false,
          title: title,
          description: description) do |sheet| %>
      <% sheet.with_body do %>
        <div class="mx-auto w-full max-w-7xl py-2">
          <%= render "form", room_type: room_type, form_id: form_id %>
        </div>
      <% end %>

      <% sheet.with_footer do %>
        <%= render PanelsUI::Button.new(
              as: :button,
              type: :button,
              variant: :secondary,
              size: :sm,
              data: { action: "click->panels-ui--sheet#close" }) do %>
          Cancel
        <% end %>
        <%= render PanelsUI::Button.new(
              as: :button,
              type: :submit,
              form: form_id,
              size: :sm,
              data: { turbo_submits_with: "Saving…" }) do %>
          <%= submit_label %>
        <% end %>
      <% end %>
    <% end %>
  </div>
<% end %>
