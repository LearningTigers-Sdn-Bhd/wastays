<% assignments = room_type.room_type_rate_plans.sort_by { |assignment| [ assignment.rate_plan.standard_rate? ? 0 : 1, assignment.rate_plan.name.downcase, assignment.id ] } %>

<article class="relative" role="listitem" data-room-type-id="<%= room_type.id %>">
  <%= render PanelsUI::Collapsible.new(
        id: "room-inventory-#{room_type.id}",
        open: true,
        region: true,
        heading_level: 3,
        trigger_class: "w-full px-4 py-4 pr-32 text-left hover:bg-muted/30 sm:pr-72",
        content_class: "border-t border-border bg-muted/20") do |item| %>
    <% item.with_trigger do %>
      <span class="grid min-w-0 gap-3 md:grid-cols-[minmax(0,2fr)_minmax(0,1fr)_minmax(0,.7fr)_minmax(0,1fr)] md:items-center md:gap-4">
        <span class="flex min-w-0 items-start gap-2.5">
          <%= app_icon "chevron-down", class: "panel-collapsible__indicator mt-0.5 size-4 shrink-0 text-muted-foreground", aria: { hidden: true } %>
          <span class="min-w-0">
            <span class="block truncate text-sm font-medium text-foreground"><%= room_type.name %></span>
            <span class="mt-1 block truncate text-xs font-normal text-muted-foreground"><%= room_type.description.presence || room_type.room_group&.name || "No description added" %></span>
          </span>
        </span>
        <span class="ml-6 flex items-center gap-1.5 text-xs font-normal text-muted-foreground md:ml-0">
          <%= pluralize(room_type.max_adults, "adult") %>
          <span aria-hidden="true">·</span>
          <%= pluralize(room_type.max_children.to_i, "child") %>
        </span>
        <span class="ml-6 text-xs font-normal text-muted-foreground md:ml-0">
          <%= pluralize(room_type.quantity, "unit") %>
        </span>
        <span class="ml-6 text-xs font-medium text-foreground md:ml-0">
          <%= current_hotel.default_currency || "MYR" %> <%= number_with_precision(room_type.base_price, precision: 2, delimiter: ",") %>
        </span>
      </span>
    <% end %>

    <% item.with_body do %>
      <div class="divide-y divide-border/70">
        <% assignments.each do |assignment| %>
          <%= render "hotel_portal/room_types/inventory_rate_plan", assignment: assignment, room_type: room_type %>
        <% end %>
      </div>
    <% end %>
  <% end %>

  <div class="absolute right-3 top-3 flex items-center gap-1">
    <%= render PanelsUI::Button.new(
          href: new_hotel_rate_plan_path(current_hotel, room_type_id: room_type.id),
          variant: :secondary,
          size: :sm,
          class: "hidden sm:inline-flex",
          data: { turbo_frame: "settings_action_sheet" }) do %>
      <%= app_icon "plus", class: "size-4", aria: { hidden: true } %>
      New rate plan
    <% end %>
    <%= render PanelsUI::Button.new(
          href: new_hotel_rate_plan_path(current_hotel, room_type_id: room_type.id),
          variant: :secondary,
          size: :icon_sm,
          class: "sm:hidden",
          aria_label: "Create rate plan for #{room_type.name}",
          data: { turbo_frame: "settings_action_sheet" }) do %>
      <%= app_icon "plus", class: "size-4", aria: { hidden: true } %>
    <% end %>
    <%= render PanelsUI::Button.new(
          href: new_hotel_rate_plan_attachment_path(current_hotel, room_type_id: room_type.id),
          variant: :ghost,
          size: :sm,
          class: "hidden sm:inline-flex",
          aria_label: "Attach rate plan to #{room_type.name}",
          data: { turbo_frame: "settings_action_sheet" }) do %>
      <%= app_icon "link", class: "size-4", aria: { hidden: true } %>
      Attach
    <% end %>
    <%= render PanelsUI::Button.new(
          href: new_hotel_rate_plan_attachment_path(current_hotel, room_type_id: room_type.id),
          variant: :ghost,
          size: :icon_sm,
          class: "sm:hidden",
          aria_label: "Attach rate plan to #{room_type.name}",
          data: { turbo_frame: "settings_action_sheet" }) do %>
      <%= app_icon "link", class: "size-4", aria: { hidden: true } %>
    <% end %>
    <%= render "hotel_portal/room_types/record_actions", room_type: room_type, id_prefix: "inventory" %>
  </div>
</article>
