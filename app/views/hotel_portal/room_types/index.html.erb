<%
  active_room_group_tab = if @active_group_id == "unassigned" && @unassigned_count.positive?
    "unassigned"
  elsif @room_groups.any? { |group| group.id.to_s == @active_group_id.to_s }
    "group-#{@active_group_id}"
  else
    "all"
  end
%>

<div class="w-full space-y-6">
  <% if onboarding_incomplete?(current_hotel) %>
    <%= render PanelsUI::Button.new(
          href: hotel_dashboard_path(current_hotel),
          variant: :ghost,
          size: :sm) do %>
      <%= app_icon "chevron-left", class: "size-4", aria: { hidden: true } %>
      Back to onboarding
    <% end %>
  <% end %>

  <%= render "hotel_portal/settings/property_page_header" %>
  <%= render "hotel_portal/settings/group_tabs" %>

  <section aria-labelledby="room-inventory-heading" class="space-y-5">
    <div class="flex flex-col gap-4 sm:flex-row sm:items-start sm:justify-between">
      <div>
        <h2 id="room-inventory-heading" class="text-base font-semibold text-foreground">Room Inventory</h2>
        <p class="mt-1 text-sm text-muted-foreground">Manage each room category and the rate plans guests can book.</p>
      </div>
      <div class="flex w-full flex-col gap-2 sm:w-auto sm:flex-row">
        <%= render PanelsUI::Button.new(
              href: hotel_room_groups_path(current_hotel),
              variant: :secondary,
              size: :sm,
              class: "w-full sm:w-auto",
              data: { turbo_frame: "settings_action_sheet" }) do %>
          <%= app_icon "layout-grid", class: "size-4", aria: { hidden: true } %>
          Manage room groups
        <% end %>
        <%= render PanelsUI::Button.new(
              href: new_hotel_room_type_path(current_hotel),
              size: :sm,
              class: "w-full sm:w-auto",
              data: { turbo_frame: "settings_action_sheet" }) do %>
          <%= app_icon "plus", class: "size-4", aria: { hidden: true } %>
          Create room category
        <% end %>
      </div>
    </div>

    <turbo-frame id="room_types_results">
      <% if @room_groups.any? %>
        <div class="mb-5">
          <%= render PanelsUI::Tabs.new(
                id: "room-group-filter",
                active: active_room_group_tab,
                variant: :pill,
                aria_label: "Room Group Filter") do |tabs| %>
            <% tabs.with_tab(
                 name: "all",
                 label: "All",
                 href: hotel_room_types_path(current_hotel),
                 data: { turbo_action: "advance" }) %>
            <% @room_groups.each do |group| %>
              <% tabs.with_tab(
                   name: "group-#{group.id}",
                   label: group.name,
                   href: hotel_room_types_path(current_hotel, room_group_id: group.id),
                   data: { turbo_action: "advance" }) %>
            <% end %>
            <% if @unassigned_count.positive? %>
              <% tabs.with_tab(
                   name: "unassigned",
                   label: "Unassigned",
                   href: hotel_room_types_path(current_hotel, room_group_id: "unassigned"),
                   data: { turbo_action: "advance" }) %>
            <% end %>
          <% end %>
        </div>
      <% end %>

      <% if @room_types.any? %>
        <div class="overflow-hidden rounded-lg border border-border bg-card" aria-label="Room categories and rate plans">
          <div class="hidden grid-cols-[minmax(0,2fr)_minmax(0,1fr)_minmax(0,.7fr)_minmax(0,1fr)_auto] gap-4 border-b border-border bg-muted/40 px-4 py-2 text-xs font-medium text-muted-foreground md:grid" aria-hidden="true">
            <span>Room category</span>
            <span>Capacity</span>
            <span>Quantity</span>
            <span>Standard Rate</span>
            <span class="w-44">Actions</span>
          </div>

          <div class="divide-y divide-border" role="list">
            <% @room_types.each do |room_type| %>
              <%= render "hotel_portal/room_types/inventory_room", room_type: room_type %>
            <% end %>
          </div>
        </div>
      <% else %>
        <div class="rounded-lg border border-dashed border-border px-4 py-10 text-center">
          <div class="mx-auto flex size-10 items-center justify-center rounded-md bg-muted text-muted-foreground" aria-hidden="true">
            <%= app_icon "bed-double", class: "size-5" %>
          </div>
          <h3 class="mt-3 text-sm font-medium text-foreground">No room categories found</h3>
          <p class="mt-1 text-sm text-muted-foreground">Create a room category to start building inventory and rates.</p>
          <div class="mt-4">
            <%= render PanelsUI::Button.new(
                  label: "Create room category",
                  href: new_hotel_room_type_path(current_hotel),
                  size: :sm,
                  data: { turbo_frame: "settings_action_sheet" }) %>
          </div>
        </div>
      <% end %>

      <% if @room_types.total_pages > 1 %>
        <div class="mt-5 flex justify-center">
          <%= paginate @room_types %>
        </div>
      <% end %>
    </turbo-frame>
  </section>
</div>
