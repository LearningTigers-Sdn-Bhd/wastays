<div class="max-w-[1600px] mx-auto pb-20 space-y-8">
  <% if onboarding_incomplete?(current_hotel) %>
    <div class="px-4 md:px-0 mb-6">
      <%= link_to hotel_dashboard_path(current_hotel), class: "inline-flex items-center gap-x-1.5 py-1.5 px-3 text-xs font-bold text-brand-primary border border-brand-primary/20 bg-brand-primary/5 rounded-lg hover:bg-brand-primary/10 transition-colors" do %>
        <%= cached_icon "chevron-left", class: "size-3.5" %>
        Back to Onboarding
      <% end %>
    </div>
  <% end %>

  <div class="px-4 md:px-0">
    <div class="mt-5 flex flex-col md:flex-row md:items-center md:justify-between gap-4">
      <div>
        <h1 class="text-2xl font-bold tracking-tight text-slate-950 sm:text-3xl">Room Categories</h1>
        <p class="mt-1 text-sm font-medium text-slate-600">Define categories, occupancy, and base pricing here, then manage live inventory and pricing from the Rates & Availability calendar.</p>
      </div>

      <div class="inline-flex gap-x-2">
        <%= link_to hotel_inventory_index_path(current_hotel), class: "inline-flex items-center rounded-xl border border-emerald-200 bg-emerald-50 px-4 py-2.5 text-sm font-bold text-emerald-800 shadow-sm transition hover:bg-emerald-100" do %>
          <%= cached_icon "calendar-days", class: "size-4 me-2" %>
          Open Rates & Availability
        <% end %>

        <%= link_to hotel_room_groups_path(current_hotel), 
                    class: "inline-flex items-center rounded-xl border border-slate-200 bg-white px-4 py-2.5 text-sm font-bold text-slate-700 shadow-sm transition hover:bg-slate-50",
                    data: { turbo_frame: "offcanvas_drawer", offcanvas_variant: "compact-right" } do %>
          <%= cached_icon "layout-grid", class: "size-4 me-2" %>
          Manage Room Groups
        <% end %>

        <%= link_to new_hotel_room_type_path(current_hotel), class: "inline-flex items-center rounded-xl bg-slate-900 px-4 py-2.5 text-sm font-bold text-white shadow-sm transition hover:bg-slate-700" do %>
          <%= cached_icon "plus", class: "size-4 me-2" %>
          Add Room Category
        <% end %>
      </div>
    </div>
  </div>

  <turbo-frame id="room_types_results">
    <!-- Tabs Filter -->
    <% if current_hotel.room_groups.any? %>
      <div class="rounded-xl border border-slate-200 bg-white p-1.5 shadow-sm mb-6">
        <nav class="flex items-center gap-1 overflow-x-auto" aria-label="Room Group Filter" role="tablist">
          <% active_group_id = params[:room_group_id] %>
          
          <!-- All Tab -->
          <%= link_to hotel_room_types_path(current_hotel),
                      class: room_group_tab_class(active_group_id, :all),
                      data: { turbo_action: "advance" } do %>
            <span>All</span>
          <% end %>

          <!-- Group Tabs -->
          <% current_hotel.room_groups.order(:name).each do |group| %>
            <%= link_to hotel_room_types_path(current_hotel, room_group_id: group.id),
                        class: room_group_tab_class(active_group_id, group.id),
                        data: { turbo_action: "advance" } do %>
              <span><%= group.name %></span>
            <% end %>
          <% end %>

          <!-- Unassigned Tab -->
          <% unassigned_count = unassigned_room_types_count(current_hotel) %>
          <% if unassigned_count > 0 %>
            <%= link_to hotel_room_types_path(current_hotel, room_group_id: 'unassigned'),
                        class: room_group_tab_class(active_group_id, :unassigned),
                        data: { turbo_action: "advance" } do %>
              <span>Unassigned (<%= unassigned_count %>)</span>
            <% end %>
          <% end %>
        </nav>
      </div>
    <% end %>

  <div class="rounded-2xl border border-slate-200 bg-white shadow-sm overflow-visible">
    <div class="flex items-center justify-between border-b border-slate-200 px-6 py-5 sm:px-8 rounded-t-2xl">
      <div>
        <h2 class="text-lg font-bold tracking-tight text-slate-950 sm:text-xl">Room Types</h2>
        <p class="mt-1 text-sm font-medium text-slate-600">All available room configurations for this property.</p>
      </div>
      <span class="text-sm font-medium text-slate-500">Total Categories <span class="font-semibold text-slate-900"><%= @all_room_types.count %></span></span>
    </div>

    <div class="hidden lg:block overflow-visible">
      <table class="min-w-full table-fixed">
        <colgroup>
          <col class="w-[35%]">
          <col class="w-[20%]">
          <col class="w-[10%]">
          <col class="w-[15%]">
          <col class="w-[20%]">
        </colgroup>
        <thead class="bg-slate-100">
          <tr>
            <th scope="col" class="px-6 py-4 text-left text-[11px] font-semibold uppercase tracking-[0.1em] text-slate-600 sm:px-8">Category / Description</th>
            <th scope="col" class="px-6 py-4 text-left text-[11px] font-semibold uppercase tracking-[0.1em] text-slate-600">Occupancy</th>
            <th scope="col" class="px-6 py-4 text-left text-[11px] font-semibold uppercase tracking-[0.1em] text-slate-600">Units</th>
            <th scope="col" class="px-6 py-4 text-left text-[11px] font-semibold uppercase tracking-[0.1em] text-slate-600">Base Price</th>
            <th scope="col" class="px-6 py-4 text-right text-[11px] font-semibold uppercase tracking-[0.1em] text-slate-600 sm:px-8">Action</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-200 bg-white">
          <% if @room_types.any? %>
            <% @room_types.each do |room_type| %>
              <tr class="align-top transition-colors hover:bg-slate-100/80 even:bg-white odd:bg-slate-50/55">
                <td class="px-6 py-4 sm:px-8">
                  <div class="flex items-start gap-x-4">
                    <div class="flex-none size-10 rounded-xl bg-slate-100 flex items-center justify-center text-slate-500">
                      <%= cached_icon "images", library: "phosphor", variant: "regular", class: "size-6" %>
                    </div>
                    <div class="flex flex-col gap-1">
                      <span class="text-sm font-bold text-slate-900"><%= room_type.name %></span>
                      <span class="text-xs text-slate-500 line-clamp-2 leading-relaxed"><%= room_type.description %></span>
                    </div>
                  </div>
                </td>
                <td class="px-6 py-4">
                  <div class="flex flex-wrap gap-1.5">
                    <span class="inline-flex items-center rounded-full border border-slate-200 bg-slate-50 px-2.5 py-1 text-[11px] font-semibold text-slate-700">
                      <%= room_type.max_adults %> Adults
                    </span>
                    <% if room_type.max_children.to_i > 0 %>
                      <span class="inline-flex items-center rounded-full border border-slate-200 bg-slate-50 px-2.5 py-1 text-[11px] font-semibold text-slate-700">
                        <%= room_type.max_children %> Kids
                      </span>
                    <% end %>
                  </div>
                </td>
                <td class="px-6 py-4 whitespace-nowrap text-sm font-bold text-slate-900">
                  <%= room_type.quantity %>
                </td>
                <td class="px-6 py-4 whitespace-nowrap">
                  <span class="text-sm font-bold text-slate-900">MYR <%= number_with_precision(room_type.base_price, precision: 2) %></span>
                </td>
                <td class="px-6 py-4 text-right whitespace-nowrap sm:px-8">
                  <div class="relative inline-flex" data-controller="dropdown">
                    <button type="button" data-action="click->dropdown#toggle" class="inline-flex items-center rounded-lg border border-slate-200 bg-white px-3 py-1.5 text-xs font-semibold text-slate-700 shadow-sm transition hover:border-slate-900 hover:bg-slate-50">
                      Manage
                      <%= cached_icon "chevron-down", class: "ms-1.5 size-3.5" %>
                    </button>
                    <div data-dropdown-target="menu" class="hidden absolute right-0 top-full z-[100] mt-2 min-w-[14rem] overflow-hidden rounded-2xl border border-slate-200 bg-white p-1.5 shadow-xl animate-in fade-in zoom-in duration-200">
                      <%= link_to hotel_inventory_index_path(current_hotel, room_type_id: room_type.id), class: "flex items-center gap-x-3 rounded-xl px-3 py-2.5 text-sm font-semibold text-emerald-700 hover:bg-emerald-50 transition-colors", data: { turbo_frame: "_top" } do %>
                        <%= cached_icon "calendar", class: "size-4 text-emerald-500" %>
                        Open Rates & Availability
                      <% end %>
                      <div class="my-1 border-t border-slate-100"></div>
                      <%= link_to edit_hotel_room_type_path(current_hotel, room_type), class: "flex items-center gap-x-3 rounded-xl px-3 py-2.5 text-sm text-slate-700 hover:bg-slate-50 hover:text-slate-900 transition-colors", data: { turbo_frame: "_top" } do %>
                        <%= cached_icon "pencil", class: "size-4 text-slate-400" %>
                        Edit Details
                      <% end %>
                      <%= link_to hotel_room_type_path(current_hotel, room_type), 
                          data: { turbo_method: :delete, turbo_confirm: "Are you sure you want to delete this room category?", turbo_frame: "_top" }, 
                          class: "flex items-center gap-x-3 rounded-xl px-3 py-2.5 text-sm text-red-600 hover:bg-red-50 transition-colors" do %>
                        <%= cached_icon "trash-2", class: "size-4 text-red-400" %>
                        Delete Category
                      <% end %>
                    </div>
                  </div>
                </td>
              </tr>
            <% end %>
          <% else %>
            <tr>
              <td colspan="5" class="px-6 py-20 text-center sm:px-8">
                <div class="mx-auto flex size-12 items-center justify-center rounded-2xl bg-slate-50 text-slate-400">
                  <%= cached_icon "images", library: "phosphor", variant: "regular", class: "size-6" %>
                </div>
                <h3 class="mt-4 text-sm font-bold text-slate-900">No room categories found</h3>
                <p class="mt-1 text-sm text-slate-500 text-sm">Start by adding your first room configuration.</p>
                <div class="mt-6">
                  <%= link_to "Add Room Category", new_hotel_room_type_path(current_hotel), class: "inline-flex items-center rounded-xl bg-slate-900 px-4 py-2 text-sm font-bold text-white shadow-sm transition hover:bg-slate-700", data: { turbo_frame: "_top" } %>
                </div>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>

    <!-- Mobile View -->
    <div class="space-y-4 p-4 sm:p-6 lg:hidden">
      <% if @room_types.any? %>
        <% @room_types.each do |room_type| %>
          <div class="rounded-2xl border border-slate-200 bg-slate-50/60 p-4 shadow-sm">
            <div class="flex items-start gap-3">
              <div class="flex-none size-10 rounded-xl bg-white border border-slate-200 flex items-center justify-center text-slate-500 shadow-sm">
                <%= cached_icon "images", library: "phosphor", variant: "regular", class: "size-6" %>
              </div>
              <div class="min-w-0">
                <p class="text-sm font-bold text-slate-900 truncate"><%= room_type.name %></p>
                <p class="mt-1 text-xs text-slate-500 line-clamp-1"><%= room_type.description %></p>
              </div>
            </div>

            <dl class="mt-4 space-y-3 text-sm">
              <div class="flex items-center justify-between">
                <dt class="text-xs font-semibold uppercase tracking-[0.08em] text-slate-500">Occupancy</dt>
                <dd class="flex gap-1">
                  <span class="text-[11px] font-bold text-slate-700 bg-slate-200/50 px-2 py-0.5 rounded-md"><%= room_type.max_adults %>A</span>
                  <% if room_type.max_children.to_i > 0 %>
                    <span class="text-[11px] font-bold text-slate-700 bg-slate-200/50 px-2 py-0.5 rounded-md"><%= room_type.max_children %>C</span>
                  <% end %>
                </dd>
              </div>
              <div class="flex items-center justify-between">
                <dt class="text-xs font-semibold uppercase tracking-[0.08em] text-slate-500">Inventory</dt>
                <dd class="text-slate-900 font-bold"><%= room_type.quantity %> Units</dd>
              </div>
              <div class="flex items-center justify-between">
                <dt class="text-xs font-semibold uppercase tracking-[0.08em] text-slate-500">Base Price</dt>
                <dd class="text-slate-900 font-bold">MYR <%= number_with_precision(room_type.base_price, precision: 2) %></dd>
              </div>
            </dl>

            <div class="mt-6 flex flex-wrap items-center justify-end gap-2">
              <%= link_to "Calendar", hotel_inventory_index_path(current_hotel, room_type_id: room_type.id), class: "inline-flex items-center rounded-lg border border-emerald-200 bg-emerald-50 px-3 py-1.5 text-xs font-bold text-emerald-800 shadow-sm transition", data: { turbo_frame: "_top" } %>
              <%= link_to "Edit", edit_hotel_room_type_path(current_hotel, room_type), class: "inline-flex items-center rounded-lg border border-slate-200 bg-white px-3 py-1.5 text-xs font-semibold text-slate-700 shadow-sm transition", data: { turbo_frame: "_top" } %>
            </div>
          </div>
        <% end %>
      <% else %>
        <div class="rounded-2xl border border-dashed border-slate-300 bg-white px-5 py-10 text-center shadow-sm">
          <p class="text-sm font-medium text-slate-500">No room categories found.</p>
        </div>
      <% end %>
    </div>

    <div class="px-6 py-5 border-t border-slate-200 bg-slate-50/50 flex justify-center sm:px-8 rounded-b-2xl">
      <%= paginate @room_types %>
    </div>
  </turbo-frame>
</div>
