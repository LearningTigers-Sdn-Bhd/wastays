<%# Amenities read as "Bathroom · Hair dryer": the category is folded into the
    label so one searchable list replaces the old category accordion. %>
<% amenity_choices = categorized_room_amenities.flat_map do |group|
     group[:items].map { |amenity| { label: "#{group[:category]} · #{amenity[:name]}", value: amenity[:id] } }
   end %>
<% room_group_choices = @hotel.room_groups.order(:name).map { |group| { label: group.name, value: group.id } } %>
<% custom_numbering = room_type.room_number_mode == "custom" %>
<% currency = @hotel.default_currency %>

<%= form_with model: [ @hotel, room_type],
              local: true,
              id: form_id,
              class: "grid grid-cols-1 gap-x-8 gap-y-10 lg:grid-cols-2",
              data: { controller: "room-number-generator" } do |f| %>
  <% if room_type.errors.any? %>
    <div class="lg:col-span-2">
      <%= render PanelsUI::Alert.new(
            tone: :destructive,
            title: pluralize(room_type.errors.count, "error") + " prevented this room category from being saved",
            role: :alert) do |alert| %>
        <% alert.with_description do %>
          <ul class="list-disc space-y-1 ps-5">
            <% room_type.errors.full_messages.each do |message| %>
              <li><%= message %></li>
            <% end %>
          </ul>
        <% end %>
      <% end %>
    </div>
  <% end %>

  <section aria-labelledby="room-category-basics-heading">
    <div>
      <h2 id="room-category-basics-heading" class="text-base font-semibold text-foreground">Basic Info</h2>
      <p class="mt-2 text-sm text-muted-foreground">Name this room category and place it in a room group.</p>
    </div>

    <div class="mt-4 grid items-start gap-4 sm:grid-cols-2">
      <%= render PanelsUI::FormField.new(form: f, attribute: :name, label: "Room Category Name", required: true) do |field| %>
        <% field.with_input(placeholder: "e.g. Deluxe Twin Room", autocomplete: "off") %>
      <% end %>

      <%# Omitted entirely until the property has room groups — the control would
          be an empty list, and groups are created from the category list. %>
      <% if room_group_choices.any? %>
        <%= render PanelsUI::FormField.new(form: f, attribute: :room_group_id, label: "Room Group") do |field| %>
          <% field.with_select_menu(
               room_group_choices,
               selected: room_type.room_group_id,
               include_blank: "No Group") %>
        <% end %>
      <% end %>

      <%= render PanelsUI::FormField.new(
            form: f,
            attribute: :description,
            label: "Description",
            class: "sm:col-span-2") do |field| %>
        <% field.with_text_area(rows: 3, placeholder: "e.g. Spacious room with two twin beds and a city view.") %>
      <% end %>
    </div>
  </section>

  <section aria-labelledby="room-category-capacity-heading">
    <div>
      <h2 id="room-category-capacity-heading" class="text-base font-semibold text-foreground">Capacity &amp; Standard Rate</h2>
      <p class="mt-2 text-sm text-muted-foreground">Base occupancy, how many units exist, and this category's default nightly price.</p>
    </div>

    <div class="mt-4 grid items-start gap-4 sm:grid-cols-2">
      <%= render PanelsUI::FormField.new(form: f, attribute: :max_adults, label: "Max Adults", required: true) do |field| %>
        <% field.with_input(type: :number, min: 1, step: 1) %>
      <% end %>

      <%= render PanelsUI::FormField.new(form: f, attribute: :max_children, label: "Max Children", required: true) do |field| %>
        <% field.with_input(type: :number, min: 0, step: 1) %>
      <% end %>

      <%= render PanelsUI::FormField.new(form: f, attribute: :quantity, label: "Total Number of Rooms", required: true) do |field| %>
        <% field.with_input(
             type: :number,
             min: 0,
             step: 1,
             data: { room_number_generator_target: "quantity", action: "input->room-number-generator#generate" }) %>
      <% end %>

      <%= render PanelsUI::FormField.new(
            form: f,
            attribute: :base_price,
            label: "Standard Rate (#{currency})",
            hint: safe_join([
              "The default nightly price for any date without an override. Other plans derive from it in ",
              link_to("Rate Settings", hotel_rates_settings_path(@hotel), class: "underline"),
              "."
            ]),
            required: true) do |field| %>
        <% field.with_input(type: :number, min: 0, step: 0.01, inputmode: "decimal") %>
      <% end %>
    </div>
  </section>

  <section aria-labelledby="room-category-amenities-heading">
    <div>
      <h2 id="room-category-amenities-heading" class="text-base font-semibold text-foreground">Amenities</h2>
      <p class="mt-2 text-sm text-muted-foreground">What's included in this room.</p>
    </div>

    <div class="mt-4">
      <% if amenity_choices.any? %>
        <%= render PanelsUI::FormField.new(
              form: f,
              attribute: :amenities,
              label: "Room amenities",
              label_hidden: true) do |field| %>
          <% field.with_multi_select(
               amenity_choices,
               selected: room_type.amenities,
               prompt: "Search and select amenities",
               empty_text: "No amenities found") %>
        <% end %>
      <% else %>
        <p class="text-sm text-muted-foreground">No amenities are configured for this property yet.</p>
      <% end %>
    </div>
  </section>

  <section aria-labelledby="room-category-restrictions-heading">
    <div>
      <h2 id="room-category-restrictions-heading" class="text-base font-semibold text-foreground">Restrictions</h2>
      <p class="mt-2 text-sm text-muted-foreground">House rules that apply to this room category.</p>
    </div>

    <div class="mt-4 grid gap-3">
      <%= render PanelsUI::Switch.new(
            form: f,
            attribute: :smoking_allowed,
            checked: room_type.smoking_allowed?,
            label: "Smoking Allowed",
            description: "Guests may smoke in rooms of this category.",
            variant: :card) %>

      <%= render PanelsUI::Switch.new(
            form: f,
            attribute: :pets_allowed,
            checked: room_type.pets_allowed?,
            label: "Pets Allowed",
            description: "Guests may bring pets into rooms of this category.",
            variant: :card) %>
    </div>
  </section>

  <section aria-labelledby="room-category-numbering-heading" class="lg:col-span-2">
    <div>
      <h2 id="room-category-numbering-heading" class="text-base font-semibold text-foreground">Room Numbering</h2>
      <p class="mt-2 text-sm text-muted-foreground">Generate room numbers from a starting number, or enter them yourself.</p>
    </div>

    <div class="mt-4 space-y-4">
      <%= render PanelsUI::Switch.new(
            form: f,
            attribute: :room_number_mode,
            value: "custom",
            unchecked_value: "range",
            checked: custom_numbering,
            label: "Enter room numbers manually",
            description: "Off, numbers run consecutively from the starting number.",
            variant: :card,
            data: {
              room_number_generator_target: "modeCheckbox",
              action: "change->room-number-generator#toggleMode"
            }) %>

      <div class="grid items-start gap-4 sm:grid-cols-2">
        <div data-room-number-generator-target="rangeFields" class="panel-form-field" data-size="md">
          <label for="room-numbering-start" class="panel-form-field__label">Start Number</label>
          <input type="number"
                 id="room-numbering-start"
                 class="panel-input"
                 data-size="md"
                 placeholder="e.g. 101"
                 data-room-number-generator-target="start"
                 data-action="input->room-number-generator#generate">
        </div>

        <div data-room-number-generator-target="customFields" class="panel-form-field hidden" data-size="md">
          <label for="room-numbering-list" class="panel-form-field__label">Room Numbers</label>
          <textarea id="room-numbering-list"
                    rows="2"
                    class="panel-text-area"
                    data-size="md"
                    placeholder="101, 102, 103, 105, 107"
                    data-room-number-generator-target="customList"
                    data-action="input->room-number-generator#generate"><%= room_type.room_numbers&.join(", ") %></textarea>
        </div>
      </div>

      <p data-room-number-generator-target="hint" class="hidden text-sm text-destructive" role="status"></p>

      <div>
        <p class="panel-form-field__label">Preview</p>
        <div data-room-number-generator-target="preview"
             class="mt-2 flex min-h-20 flex-wrap items-center justify-center gap-2 rounded-md border border-dashed border-border bg-muted/30 p-4">
          <span class="text-sm text-muted-foreground">Enter a start number to generate a preview…</span>
        </div>
      </div>

      <div data-room-number-generator-target="inputContainer" class="hidden">
        <% room_type.room_numbers&.each do |number| %>
          <input type="hidden" name="room_type[room_numbers][]" value="<%= number %>">
        <% end %>
      </div>
    </div>
  </section>

  <section aria-labelledby="room-category-photos-heading"
           class="lg:col-span-2"
           data-controller="drag-drop-upload"
           data-drag-drop-upload-existing-count-value="<%= room_type.photos.count %>"
           data-drag-drop-upload-max-count-value="<%= RoomType::MAX_PHOTOS %>">
    <div>
      <h2 id="room-category-photos-heading" class="text-base font-semibold text-foreground">Photos</h2>
      <p class="mt-2 text-sm text-muted-foreground">Show off this room category to guests. Up to <%= RoomType::MAX_PHOTOS %> photos.</p>
    </div>

    <div class="mt-4 space-y-4">
      <div data-drag-drop-upload-target="dropzone" class="flex justify-center rounded-md border-2 border-dashed border-border bg-card px-8 py-10 transition-colors hover:bg-muted/50">
        <div class="space-y-2 text-center">
          <%= app_icon "image", class: "mx-auto size-8 text-muted-foreground", aria: { hidden: true } %>
          <div class="flex justify-center text-sm text-muted-foreground">
            <label for="<%= f.field_id(:photos) %>" class="cursor-pointer font-semibold text-foreground underline">
              <span>Click to upload photos</span>
              <%= f.file_field :photos, multiple: true, accept: "image/*", class: "sr-only", data: { drag_drop_upload_target: "input", action: "change->drag-drop-upload#onFileSelect" } %>
            </label>
            <p class="ps-1">or drag and drop them here</p>
          </div>
          <p class="text-xs text-muted-foreground">PNG, JPG, or JPEG · maximum 10MB per file</p>
        </div>
      </div>

      <p data-drag-drop-upload-target="error" class="hidden rounded-md border border-destructive/30 bg-destructive/10 px-4 py-3 text-sm text-destructive" role="alert"></p>

      <div data-drag-drop-upload-target="previewContainer" class="hidden grid-cols-2 gap-4 rounded-md border border-border bg-muted/30 p-4 md:grid-cols-4 lg:grid-cols-5"></div>

      <% if room_type.photos.attached? %>
        <div class="rounded-md border border-border bg-card p-4">
          <div class="mb-4 flex items-center justify-between gap-3">
            <h3 class="text-sm font-semibold text-foreground">Current photos</h3>
            <%= render PanelsUI::Button.new(
                  as: :button,
                  type: :submit,
                  form: "bulk-delete-photos-form",
                  variant: :ghost,
                  size: :sm,
                  class: "text-destructive",
                  data: { turbo_confirm: "Delete the selected photos?", turbo_confirm_tone: "destructive" }) do %>
              Delete selected
            <% end %>
          </div>
          <div class="grid grid-cols-2 gap-4 md:grid-cols-4 lg:grid-cols-5">
            <% room_type.photos.each do |photo| %>
              <div class="relative aspect-square">
                <%= image_tag photo, class: "size-full rounded-md border border-border object-cover" %>
                <div class="absolute right-2 top-2">
                  <input type="checkbox" name="photo_ids[]" value="<%= photo.id %>" form="bulk-delete-photos-form"
                         class="panel-checkbox__input" aria-label="Select photo for deletion">
                </div>
              </div>
            <% end %>
          </div>
        </div>
      <% end %>
    </div>
  </section>
<% end %>

<% unless room_type.new_record? %>
  <%= form_with url: bulk_destroy_photos_hotel_room_type_path(@hotel, room_type), method: :delete, id: "bulk-delete-photos-form", class: "hidden" do |form| %>
  <% end %>
<% end %>
