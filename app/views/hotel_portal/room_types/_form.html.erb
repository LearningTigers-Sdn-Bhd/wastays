<%= form_with model: [@hotel, room_type], local: true, data: { controller: "room-number-generator" } do |f| %>
  <div class="grid gap-y-6">
    <div>
      <%= f.label :name, "Room Type Name", class: "block text-sm mb-2 font-medium" %>
      <%= f.text_field :name, class: "py-3 px-4 block w-full border border-gray-200 rounded-lg text-sm focus:border-blue-500 focus:ring-blue-500", required: true, placeholder: "e.g. Deluxe Twin Room" %>
    </div>

    <div>
      <%= f.label :description, class: "block text-sm mb-2 font-medium" %>
      <%= f.text_area :description, rows: 3, class: "py-3 px-4 block w-full border border-gray-200 rounded-lg text-sm focus:border-blue-500 focus:ring-blue-500", placeholder: "e.g. Spacious room with two twin beds and city view." %>
    </div>

    <div class="grid grid-cols-2 gap-4">
      <div>
        <%= f.label :max_adults, "Max Adults", class: "block text-sm mb-2 font-medium" %>
        <%= f.number_field :max_adults, class: "py-3 px-4 block w-full border border-gray-200 rounded-lg text-sm focus:border-blue-500 focus:ring-blue-500", required: true, min: 1 %>
      </div>
      <div>
        <%= f.label :max_children, "Max Children", class: "block text-sm mb-2 font-medium" %>
        <%= f.number_field :max_children, class: "py-3 px-4 block w-full border border-gray-200 rounded-lg text-sm focus:border-blue-500 focus:ring-blue-500", required: true, min: 0 %>
      </div>
    </div>

    <div class="grid grid-cols-2 gap-4">
      <div>
        <%= f.label :quantity, "Total Number of Rooms", class: "block text-sm mb-2 font-medium" %>
        <%= f.number_field :quantity, 
            class: "py-3 px-4 block w-full border border-gray-200 rounded-lg text-sm focus:border-blue-500 focus:ring-blue-500", 
            required: true, 
            min: 0,
            data: { room_number_generator_target: "quantity", action: "input->room-number-generator#generate" } %>
      </div>
      <div>
        <%= f.label :base_price, "Base Nightly Rate (MYR)", class: "block text-sm mb-2 font-medium" %>
        <%= f.number_field :base_price, step: 0.01, class: "py-3 px-4 block w-full border border-gray-200 rounded-lg text-sm focus:border-blue-500 focus:ring-blue-500", required: true, min: 0 %>
      </div>
    </div>

    <!-- Room Number Management -->
    <div class="p-5 border border-slate-200 rounded-2xl bg-slate-50/50 space-y-4">
      <div class="flex items-center justify-between">
        <div>
          <h3 class="text-sm font-bold text-slate-900">Room Number</h3>
          <p class="text-xs text-slate-500 mt-0.5">Define how rooms are numbered for this category.</p>
        </div>
        <select data-room-number-generator-target="mode" data-action="change->room-number-generator#toggleMode" class="text-xs font-bold border-slate-200 rounded-lg focus:ring-blue-500 focus:border-blue-500 bg-white py-1.5 px-3">
          <option value="range">Range</option>
          <option value="custom">Custom</option>
        </select>
      </div>

      <div data-room-number-generator-target="rangeFields" class="grid sm:grid-cols-1 gap-4">
        <div>
          <label class="block text-[11px] font-bold text-slate-500 uppercase tracking-wider mb-2">Start Number</label>
          <input type="number" data-room-number-generator-target="start" data-action="input->room-number-generator#generate" value="101" class="py-2.5 px-4 block w-full border border-gray-200 rounded-xl text-sm focus:border-blue-500 focus:ring-blue-500">
        </div>
      </div>

      <div data-room-number-generator-target="customFields" class="hidden">
        <label class="block text-[11px] font-bold text-slate-500 uppercase tracking-wider mb-2">Room Numbers (Comma separated)</label>
        <textarea data-room-number-generator-target="customList" data-action="input->room-number-generator#generate" rows="2" placeholder="101, 102, 103, 105, 107" class="py-2.5 px-4 block w-full border border-gray-200 rounded-xl text-sm focus:border-blue-500 focus:ring-blue-500"><%= room_type.room_numbers&.join(", ") %></textarea>
      </div>

      <div class="space-y-2">
        <label class="block text-[11px] font-bold text-slate-500 uppercase tracking-wider">Preview</label>
        <div data-room-number-generator-target="preview" class="flex flex-wrap gap-2 min-h-[40px] p-3 border border-dashed border-slate-200 rounded-xl bg-white">
          <span class="text-slate-400 italic text-sm">Waiting for input...</span>
        </div>
        <p id="room-numbers-hint" class="text-xs hidden"></p>
      </div>

      <div data-room-number-generator-target="inputContainer" class="hidden">
        <% room_type.room_numbers&.each do |num| %>
          <input type="hidden" name="room_type[room_numbers][]" value="<%= num %>">
        <% end %>
      </div>
    </div>

    <div>
      <%= f.label :photos, "Room Photos", class: "block text-sm mb-2 font-medium" %>
      <%= f.file_field :photos, multiple: true, accept: 'image/*', class: "block w-full border border-gray-200 shadow-sm rounded-lg text-sm focus:z-10 focus:border-blue-500 focus:ring-blue-500 disabled:opacity-50 disabled:pointer-events-none file:bg-gray-50 file:border-0 file:me-4 file:py-3 file:px-4" %>
      <p class="mt-1 text-xs text-gray-500">You can upload multiple photos.</p>
    </div>

    <% if room_type.photos.attached? %>
      <div class="grid grid-cols-4 gap-2 mt-2">
        <% room_type.photos.each do |photo| %>
          <div class="relative group">
            <%= image_tag photo, class: "w-full h-24 object-cover rounded-lg border border-gray-200" %>
          </div>
        <% end %>
      </div>
    <% end %>

    <div class="mt-5">
      <%= f.submit (room_type.new_record? ? "Create Room Type" : "Update Room Type"), class: "w-full py-3 px-4 inline-flex justify-center items-center gap-x-2 text-sm font-semibold rounded-lg border border-transparent bg-blue-600 text-white hover:bg-blue-700 disabled:opacity-50 disabled:pointer-events-none" %>
    </div>
  </div>
<% end %>
