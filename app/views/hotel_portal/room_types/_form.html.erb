<%= form_with model: [@hotel, room_type], local: true, data: { controller: "room-number-generator" } do |f| %>
  <div class="max-w-4xl mx-auto space-y-10">
    <!-- Basic Info -->
    <div class="space-y-6">
      <div>
        <%= f.label :name, "Room Type Name", class: "block text-sm mb-2 font-semibold text-slate-800" %>
        <%= f.text_field :name, class: "py-3.5 px-5 block w-full border border-slate-200 rounded-2xl text-sm focus:border-blue-500 focus:ring-blue-500 transition-all shadow-sm", required: true, placeholder: "e.g. Deluxe Twin Room" %>
      </div>

      <div>
        <%= f.label :description, "Description", class: "block text-sm mb-2 font-semibold text-slate-800" %>
        <%= f.text_area :description, rows: 3, class: "py-3.5 px-5 block w-full border border-slate-200 rounded-2xl text-sm focus:border-blue-500 focus:ring-blue-500 transition-all shadow-sm", placeholder: "e.g. Spacious room with two twin beds and city view." %>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <div>
          <%= f.label :max_adults, "Max Adults", class: "block text-sm mb-2 font-semibold text-slate-800" %>
          <%= f.number_field :max_adults, class: "py-3.5 px-5 block w-full border border-slate-200 rounded-2xl text-sm focus:border-blue-500 focus:ring-blue-500 transition-all shadow-sm", required: true, min: 1 %>
        </div>
        <div>
          <%= f.label :max_children, "Max Children", class: "block text-sm mb-2 font-semibold text-slate-800" %>
          <%= f.number_field :max_children, class: "py-3.5 px-5 block w-full border border-slate-200 rounded-2xl text-sm focus:border-blue-500 focus:ring-blue-500 transition-all shadow-sm", required: true, min: 0 %>
        </div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <div>
          <%= f.label :quantity, "Total Number of Rooms", class: "block text-sm mb-2 font-semibold text-slate-800" %>
          <%= f.number_field :quantity,
              class: "py-3.5 px-5 block w-full border border-slate-200 rounded-2xl text-sm focus:border-blue-500 focus:ring-blue-500 transition-all shadow-sm",
              required: true,
              min: 0,
              data: { room_number_generator_target: "quantity", action: "input->room-number-generator#generate" } %>
        </div>
        <div>
          <%= f.label :base_price, "Base Nightly Rate (MYR)", class: "block text-sm mb-2 font-semibold text-slate-800" %>
          <%= f.number_field :base_price, step: 0.01, class: "py-3.5 px-5 block w-full border border-slate-200 rounded-2xl text-sm focus:border-blue-500 focus:ring-blue-500 transition-all shadow-sm", required: true, min: 0 %>
        </div>
      </div>
    </div>

    <!-- Amenities -->
    <div data-controller="multi-select-dropdown"
         data-multi-select-dropdown-selected-value="<%= (room_type.amenities || []).to_json %>"
         data-multi-select-dropdown-all-value="<%= Hotel::ROOM_AMENITIES.to_json %>"
         data-action="click@window->multi-select-dropdown#hideDropdown">
      <div class="flex items-center justify-between mb-3">
        <%= f.label :amenities, "Room Amenities", class: "block text-sm font-semibold text-slate-800" %>
      </div>

      <div class="relative">
        <div class="min-h-[60px] w-full rounded-2xl border border-slate-200 bg-white p-3 flex flex-wrap items-center gap-2 focus-within:border-blue-500 focus-within:ring-1 focus-within:ring-blue-500 transition-all cursor-text shadow-sm"
             data-action="click->multi-select-dropdown#focusInput">
          <div class="flex flex-wrap gap-2" data-multi-select-dropdown-target="pillsContainer">
            <!-- Pills rendered here -->
          </div>
          
          <input type="text" 
                 class="flex-grow min-w-[150px] border-none bg-transparent focus:ring-0 focus:outline-none text-sm text-slate-900 placeholder:text-slate-400" 
                 data-multi-select-dropdown-target="input"
                 data-action="input->multi-select-dropdown#filterOptions focus->multi-select-dropdown#openDropdown click->multi-select-dropdown#stopProp keydown->multi-select-dropdown#navigate">

          <div class="ml-auto pr-2">
            <svg class="w-4 h-4 text-slate-400 transition-transform duration-200" data-multi-select-dropdown-target="chevron" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6"/></svg>
          </div>
        </div>

        <div class="absolute z-50 mt-2 w-full max-h-60 overflow-y-auto rounded-xl border border-slate-200 bg-white shadow-xl hidden" 
             data-multi-select-dropdown-target="dropdown">
          <% Hotel::ROOM_AMENITIES.each do |amenity| %>
            <button type="button"
                    class="w-full text-left px-4 py-3 text-sm text-slate-700 hover:bg-slate-50 transition-colors border-b border-slate-50 last:border-0"
                    data-id="<%= amenity[:id] %>"
                    data-name="<%= amenity[:name] %>"
                    data-multi-select-dropdown-target="option"
                    data-action="click->multi-select-dropdown#select">
              <%= amenity[:name] %>
            </button>
          <% end %>
        </div>
      </div>

      <template data-multi-select-dropdown-target="template">
        <div class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-slate-900 text-white text-xs font-semibold">
          <span data-name></span>
          <button type="button" class="hover:text-slate-300 transition-colors" data-remove-id data-action="click->multi-select-dropdown#remove">
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg>
          </button>
          <input type="hidden" name="room_type[amenities][]" value="">
        </div>
      </template>
    </div>

    <!-- Room Restrictions -->
    <div class="space-y-4">
      <h3 class="text-sm font-semibold text-slate-800">Room Restrictions</h3>
      <div class="bg-slate-50 rounded-2xl p-6 space-y-4 border border-slate-100">
        <div class="flex items-center justify-between py-2 border-b border-slate-200 last:border-0">
          <%= f.label :smoking_allowed, "Smoking Allowed", class: "text-sm font-medium text-slate-700" %>
          <label class="relative inline-flex items-center cursor-pointer">
            <%= f.check_box :smoking_allowed, class: "sr-only peer" %>
            <div class="w-11 h-6 bg-gray-200 peer-focus:outline-none peer-focus:ring-4 peer-focus:ring-blue-300 rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-gray-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-blue-600"></div>
          </label>
        </div>
        <div class="flex items-center justify-between py-2 border-b border-slate-200 last:border-0">
          <%= f.label :pets_allowed, "Pets Allowed", class: "text-sm font-medium text-slate-700" %>
          <label class="relative inline-flex items-center cursor-pointer">
            <%= f.check_box :pets_allowed, class: "sr-only peer" %>
            <div class="w-11 h-6 bg-gray-200 peer-focus:outline-none peer-focus:ring-4 peer-focus:ring-blue-300 rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-gray-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-blue-600"></div>
          </label>
        </div>
      </div>
    </div>

    <!-- Room Numbering -->
    <div class="p-8 border border-slate-200 rounded-[2.5rem] bg-white space-y-8 shadow-sm">
      <div class="flex items-center gap-x-3">
        <div class="w-10 h-10 rounded-xl bg-slate-900 flex items-center justify-center text-white">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="18" x="3" y="3" rx="2"/><path d="M7 7h.01"/><path d="M12 7h.01"/><path d="M17 7h.01"/><path d="M7 12h.01"/><path d="M12 12h.01"/><path d="M17 12h.01"/><path d="M7 17h.01"/><path d="M12 17h.01"/><path d="M17 17h.01"/></svg>
        </div>
        <h3 class="text-lg font-bold text-slate-900">Room Numbering</h3>
      </div>

      <div data-room-number-generator-target="rangeFields" class="space-y-2">
        <label class="block text-[10px] font-bold text-slate-400 uppercase tracking-widest ml-1">Start Number</label>
        <input type="number" data-room-number-generator-target="start" data-action="input->room-number-generator#generate" placeholder="e.g. 101" class="py-4 px-6 block w-full border border-slate-100 rounded-2xl text-sm focus:border-blue-500 focus:ring-blue-500 bg-slate-50/50">
      </div>

      <div data-room-number-generator-target="customFields" class="hidden space-y-2">
        <label class="block text-[10px] font-bold text-slate-400 uppercase tracking-widest ml-1">Room Numbers</label>
        <textarea data-room-number-generator-target="customList" data-action="input->room-number-generator#generate" rows="3" placeholder="101, 102, 103, 105, 107" class="py-4 px-6 block w-full border border-slate-100 rounded-2xl text-sm focus:border-blue-500 focus:ring-blue-500 bg-slate-50/50"><%= room_type.room_numbers&.join(", ") %></textarea>
      </div>

      <div class="space-y-4">
        <label class="block text-[10px] font-bold text-slate-400 uppercase tracking-widest ml-1">Preview</label>
        <div data-room-number-generator-target="preview" class="flex flex-wrap gap-2 min-h-[80px] p-6 border border-dashed border-slate-200 rounded-[2rem] bg-slate-50/30 items-center justify-center">
          <span class="text-slate-400 italic text-sm text-center">Enter a start number to generate a preview...</span>
        </div>

        <div class="flex items-center gap-x-3 pt-2">
          <%= f.hidden_field :room_number_mode, data: { room_number_generator_target: "modeInput" } %>
          <label class="relative inline-flex items-center cursor-pointer">
            <input type="checkbox" id="custom-mode-toggle"
                   data-room-number-generator-target="modeCheckbox"
                   data-action="change->room-number-generator#toggleMode"
                   <%= 'checked' if room_type.room_number_mode == 'custom' %>
                   class="sr-only peer">
            <div class="w-11 h-6 bg-gray-200 peer-focus:outline-none peer-focus:ring-4 peer-focus:ring-blue-300 rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-gray-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-blue-600"></div>
            <span class="ml-3 text-xs font-bold text-slate-600 uppercase tracking-wide">Manual Customization</span>
          </label>
        </div>
        <p data-room-number-generator-target="hint" class="text-xs hidden"></p>
      </div>

      <div data-room-number-generator-target="inputContainer" class="hidden">
        <% room_type.room_numbers&.each do |num| %>
          <input type="hidden" name="room_type[room_numbers][]" value="<%= num %>">
        <% end %>
      </div>
    </div>

    <!-- Photos -->
    <div class="space-y-6">
      <div>
        <%= f.label :photos, "Room Photos", class: "block text-sm mb-3 font-semibold text-slate-800" %>
        <div class="relative group">
          <div class="flex justify-center px-8 pt-10 pb-12 border-2 border-slate-300 border-dashed rounded-[2.5rem] bg-white group-hover:bg-slate-50 transition-all group-hover:border-blue-400">
            <div class="space-y-4 text-center">
              <div class="w-16 h-16 bg-blue-50 rounded-2xl flex items-center justify-center mx-auto text-blue-500 mb-4 group-hover:scale-110 transition-transform">
                <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="18" x="3" y="3" rx="2" ry="2"/><circle cx="9" cy="9" r="2"/><path d="m21 15-3.086-3.086a2 2 0 0 0-2.828 0L6 21"/></svg>
              </div>
              <div class="flex text-sm text-slate-600 justify-center">
                <label for="<%= f.field_id(:photos) %>" class="relative cursor-pointer bg-white rounded-md font-bold text-blue-600 hover:text-blue-500 focus-within:outline-none focus-within:ring-2 focus-within:ring-offset-2 focus-within:ring-blue-500 px-2">
                  <span>Click to upload photos</span>
                  <%= f.file_field :photos, multiple: true, accept: 'image/*', class: "sr-only" %>
                </label>
                <p class="pl-1">or drag and drop them here</p>
              </div>
              <p class="text-xs text-slate-400">Supported: PNG, JPG, JPEG • Max 10MB per file</p>
            </div>
          </div>
        </div>
      </div>

      <% if room_type.photos.attached? %>
        <div class="mt-8 p-8 border border-slate-200 rounded-[2.5rem] bg-white shadow-sm">
          <div class="flex items-center justify-between mb-6">
            <h3 class="text-sm font-bold text-slate-900 uppercase tracking-widest">Manage Current Photos</h3>
            <button type="submit" form="bulk-delete-photos-form" class="py-2 px-5 text-xs font-bold rounded-xl bg-red-50 text-red-600 hover:bg-red-100 transition-colors shadow-sm" data-turbo-confirm="Delete selected photos?">
              Delete Selected
            </button>
          </div>
          <div class="grid grid-cols-2 md:grid-cols-4 lg:grid-cols-5 gap-4">
            <% room_type.photos.each do |photo| %>
              <div class="relative group aspect-square">
                <%= image_tag photo, class: "w-full h-full object-cover rounded-2xl border border-slate-100 shadow-sm group-hover:opacity-75 transition-opacity" %>
                <div class="absolute top-3 right-3">
                  <input type="checkbox" name="photo_ids[]" value="<%= photo.id %>" form="bulk-delete-photos-form" class="h-5 w-5 rounded-lg border-slate-300 text-red-600 focus:ring-red-500 cursor-pointer shadow-sm transition-transform active:scale-90">
                </div>
              </div>
            <% end %>
          </div>
        </div>
      <% end %>
    </div>

    <!-- Submit -->
    <div class="pt-10 border-t border-slate-100">
      <%= f.submit (room_type.new_record? ? "Create Room Type" : "Update Room Type"), class: "w-full py-5 px-8 text-base font-bold rounded-[2rem] bg-blue-600 text-white hover:bg-blue-700 focus:outline-none focus:ring-4 focus:ring-blue-500/20 transition-all shadow-xl shadow-blue-500/20 active:scale-[0.98]" %>
    </div>
  </div>
<% end %>

<% unless room_type.new_record? %>
  <%= form_with url: bulk_destroy_photos_hotel_room_type_path(@hotel, room_type), method: :delete, id: "bulk-delete-photos-form", class: "hidden" do |f| %>
  <% end %>
<% end %>
