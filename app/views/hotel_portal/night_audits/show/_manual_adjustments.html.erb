<details class="group overflow-hidden rounded-xl border border-slate-200 bg-white shadow-sm" <%= "open" if presenter.manual_adjustments_open? %> data-testid="manual-adjustments">
  <summary class="flex cursor-pointer list-none items-center justify-between gap-3 bg-slate-50/70 px-4 py-3 [&::-webkit-details-marker]:hidden">
    <div>
      <h2 class="inline-flex items-center gap-2 text-sm font-bold text-slate-950">
        <%= cached_icon "chevron-right", class: "size-4 transition-transform group-open:rotate-90", aria: { hidden: true } %>
        <span class="inline-flex size-6 items-center justify-center rounded-md bg-amber-50 text-amber-700"><%= cached_icon "receipt-text", class: "size-3.5", aria: { hidden: true } %></span>
        Manual Adjustments & Voids
      </h2>
      <p class="mt-0.5 text-xs text-slate-500">Staff interventions, rebates, voids, and revenue corrections.</p>
    </div>
    <span class="shrink-0 text-xs font-bold text-slate-500"><%= presenter.manual_adjustment_rows.count %> records</span>
  </summary>

  <div class="border-t border-slate-200">
    <% if presenter.manual_adjustment_rows.any? %>
      <div class="hidden overflow-x-auto md:block">
        <table class="min-w-full divide-y divide-slate-200 text-sm">
          <thead class="bg-slate-50 text-left text-[10px] font-bold uppercase tracking-wider text-slate-500">
            <tr><th class="px-4 py-2">Time</th><th class="px-4 py-2">Guest / Ref</th><th class="px-4 py-2">Category</th><th class="px-4 py-2">User</th><th class="px-4 py-2">Reason</th><th class="px-4 py-2 text-right">Amount</th></tr>
          </thead>
          <tbody class="divide-y divide-slate-100">
            <% presenter.manual_adjustment_rows.each do |row| %>
              <tr>
                <td class="px-4 py-2.5 text-slate-600"><%= row.time %></td>
                <td class="px-4 py-2.5"><p class="font-semibold text-slate-950"><%= row.guest %></p><p class="text-[10px] text-slate-500">#<%= row.reference %></p></td>
                <td class="px-4 py-2.5 text-amber-700"><%= row.category %></td>
                <td class="px-4 py-2.5 text-slate-600"><%= row.user %></td>
                <td class="px-4 py-2.5 text-slate-600"><%= row.reason %></td>
                <td class="px-4 py-2.5 text-right font-bold tabular-nums text-slate-950"><%= row.amount %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
      <div class="divide-y divide-slate-100 md:hidden">
        <% presenter.manual_adjustment_rows.each do |row| %>
          <article class="px-4 py-3">
            <div class="flex items-center justify-between gap-3"><p class="text-xs font-bold text-amber-700"><%= row.category %></p><p class="text-sm font-bold tabular-nums text-slate-950"><%= row.amount %></p></div>
            <p class="mt-1 text-sm font-semibold text-slate-950"><%= row.guest %> · #<%= row.reference %></p>
            <p class="mt-1 text-xs text-slate-600"><%= row.time %> · <%= row.user %> · <%= row.reason %></p>
          </article>
        <% end %>
      </div>
    <% else %>
      <p class="px-4 py-3 text-sm font-medium text-slate-600"><%= presenter.empty_state(:adjustments) %></p>
    <% end %>
  </div>
</details>
