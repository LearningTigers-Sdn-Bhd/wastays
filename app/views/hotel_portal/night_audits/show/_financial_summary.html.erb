<% tone_text = { "danger" => "text-red-700", "warning" => "text-amber-700", "success" => "text-emerald-700", nil => "text-foreground" } %>

<section class="overflow-hidden rounded-xl border border-border bg-card shadow-sm">
  <header class="flex flex-col gap-2 border-b border-border bg-muted/70 px-4 py-2.5 sm:flex-row sm:items-center sm:justify-between">
    <div>
      <h2 class="inline-flex items-center gap-2 text-xs font-bold uppercase tracking-wider text-foreground">
        <span class="inline-flex size-6 items-center justify-center rounded-md bg-emerald-50 text-emerald-700"><%= cached_icon "chart-no-axes-combined", class: "size-3.5", aria: { hidden: true } %></span>
        Business-Date Financial Summary
      </h2>
      <p class="mt-0.5 text-xs text-muted-foreground">Calculated totals for business date <%= presenter.audit_details.first.value %>.</p>
    </div>
    <div class="flex items-baseline justify-between gap-4 sm:justify-end">
      <span class="text-[10px] font-bold uppercase tracking-wider text-muted-foreground">Net Revenue</span>
      <span class="text-lg font-bold tabular-nums text-foreground"><%= presenter.net_revenue %></span>
    </div>
  </header>

  <% if presenter.financial_rows.any? %>
    <div class="grid gap-px bg-muted sm:grid-cols-2">
      <% presenter.financial_rows.each do |row| %>
        <div class="grid grid-cols-[1fr_auto] gap-3 bg-card px-4 py-2.5">
          <span class="text-xs font-semibold text-muted-foreground"><%= row.label %></span>
          <span class="text-sm font-bold tabular-nums <%= tone_text.fetch(row.tone, tone_text[nil]) %>"><%= row.value %></span>
        </div>
      <% end %>
    </div>
  <% else %>
    <p class="px-4 py-3 text-sm font-medium text-muted-foreground"><%= presenter.empty_state(:financial) %></p>
  <% end %>
</section>
