<% presenter = @presenter %>

<% if presenter.auto_refresh? %>
  <% content_for :head do %>
    <meta http-equiv="refresh" content="5">
  <% end %>
<% end %>

<div class="mx-auto max-w-[1600px] space-y-4 px-4 pb-16 pt-5 md:px-0">
  <%= render "hotel_portal/night_audits/show/header", presenter: presenter %>
  <%= render "hotel_portal/night_audits/show/result_banner", presenter: presenter %>
  <%= render "hotel_portal/night_audits/show/summary", presenter: presenter %>
  <%= render "hotel_portal/night_audits/show/financial_summary", presenter: presenter %>
  <%= render "hotel_portal/night_audits/show/run_results", presenter: presenter %>
  <%= render "hotel_portal/night_audits/show/blockers_and_warnings", presenter: presenter %>
  <%= render "hotel_portal/night_audits/show/manual_adjustments", presenter: presenter %>
</div>
