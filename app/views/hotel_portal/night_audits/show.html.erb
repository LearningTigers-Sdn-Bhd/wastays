<% presenter = @presenter %>

<% if presenter.auto_refresh? %>
  <% content_for :head do %>
    <meta http-equiv="refresh" content="5">
  <% end %>
<% end %>

<div class="w-full space-y-4">
  <%= render "hotel_portal/night_audits/show/header", presenter: presenter %>
  <%= render "hotel_portal/night_audits/show/result_banner", presenter: presenter %>
  <%= render "hotel_portal/night_audits/show/summary", presenter: presenter %>

  <div data-testid="night-audit-show-tabs">
  <%= render PanelsUI::Tabs.new(id: "night-audit-show-tabs", active: @active_tab, variant: :pill, url: { param: "tab" }, class: "space-y-4", aria_label: "Night Audit record sections") do |tabs| %>
    <% tabs.with_tab(name: "results", label: "Results", icon: "list-checks", count: presenter.run_result_counters.sum { |counter| counter.value.to_i }, panel_id: "results-panel") %>
    <% tabs.with_tab(name: "financial-summary", label: "Financial Summary", icon: "chart-no-axes-combined", panel_id: "financial-summary-panel") %>
    <% tabs.with_tab(name: "advanced-actions", label: "Advanced Actions", icon: "settings-2", count: presenter.manual_adjustment_rows.count, panel_id: "advanced-actions-panel") %>
    <% tabs.with_panel(name: "results", id: "results-panel", class: "space-y-4", data: { testid: "results-panel" }) do %>
      <%= render "hotel_portal/night_audits/show/run_results", presenter: presenter %>
      <%= render "hotel_portal/night_audits/show/blockers_and_warnings", presenter: presenter %>
    <% end %>
    <% tabs.with_panel(name: "financial-summary", id: "financial-summary-panel", data: { testid: "financial-summary-panel" }) do %>
      <%= render "hotel_portal/night_audits/show/financial_summary", presenter: presenter %>
    <% end %>
    <% tabs.with_panel(name: "advanced-actions", id: "advanced-actions-panel", data: { testid: "show-advanced-actions-panel" }) do %>
      <%= render "hotel_portal/night_audits/show/manual_adjustments", presenter: presenter %>
    <% end %>
  <% end %>
  </div>
</div>
