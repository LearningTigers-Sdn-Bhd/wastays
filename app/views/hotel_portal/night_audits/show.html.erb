<% if @night_audit.status == "running" %>
  <% content_for :head do %>
    <meta http-equiv="refresh" content="5">
  <% end %>
<% end %>

<% content_for :breadcrumbs do %>
  <div class="flex items-center gap-x-2">
    <span class="text-sm font-medium text-slate-600"><%= current_hotel.name %></span>
    <span class="text-sm text-slate-400">/</span>
    <%= link_to "Night Audit", hotel_night_audits_path(current_hotel), class: "text-sm font-medium text-slate-600 hover:text-slate-900" %>
    <span class="text-sm text-slate-400">/</span>
    <span class="text-sm font-semibold text-slate-900"><%= @night_audit.business_date.strftime("%d %b %Y") %></span>
  </div>
<% end %>

<% status_class = case @night_audit.status
  when "completed" then "border-emerald-200 bg-emerald-50 text-emerald-700"
  when "blocked" then "border-amber-200 bg-amber-50 text-amber-700"
  when "failed" then "border-red-200 bg-red-50 text-red-700"
  when "running" then "border-blue-200 bg-blue-50 text-blue-700"
  else "border-slate-200 bg-slate-50 text-slate-700"
end %>

<% blockers = @night_audit.blocked_details || {} %>
<% warnings = @night_audit.exceptions || {} %>

<div class="max-w-[1600px] mx-auto pb-20 space-y-8">
  <div class="px-4 md:px-0 mt-5">
    <div class="flex flex-col gap-4 md:flex-row md:items-start md:justify-between">
      <div>
        <div class="flex items-center gap-3 mb-2">
          <h1 class="text-2xl font-bold tracking-tight text-slate-950 sm:text-3xl">Night Audit <%= @night_audit.business_date.strftime("%d %b %Y") %></h1>
          <span class="inline-flex items-center rounded-full border px-2.5 py-1 text-[10px] font-bold uppercase tracking-wider <%= status_class %>"><%= @night_audit.status.humanize %></span>
        </div>
        <p class="text-sm font-medium text-slate-600">Trigger: <%= @night_audit.trigger_mode.humanize %> · Performed by <%= @night_audit.performed_by_user&.name || "System" %></p>
      </div>
      <div class="flex flex-col gap-2 sm:flex-row">
        <% if @night_audit.completed? %>
          <%= link_to hotel_night_audit_path(current_hotel, @night_audit, format: :pdf), target: "_blank", class: "inline-flex items-center gap-2 rounded-xl bg-slate-900 px-4 py-2.5 text-sm font-bold text-white shadow-sm transition hover:bg-slate-800" do %>
            <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
            </svg>
            View Audit Packet
          <% end %>
        <% end %>
        <% if @night_audit.blocked? %>
          <%= link_to resolve_hotel_night_audit_path(current_hotel, @night_audit), class: "inline-flex items-center gap-2 rounded-xl bg-red-600 px-4 py-2.5 text-sm font-bold text-white shadow-sm transition hover:bg-red-700" do %>
            <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
            </svg>
            Resolve Blockers &rarr;
          <% end %>
        <% end %>
        <%= link_to "Back to Night Audit", hotel_night_audits_path(current_hotel), class: "inline-flex items-center rounded-xl border border-slate-200 bg-white px-4 py-2.5 text-sm font-bold text-slate-700 shadow-sm transition hover:border-slate-900 hover:bg-slate-50" %>
      </div>
    </div>
  </div>

  <% if @night_audit.status == "running" %>
    <div class="mx-4 md:mx-0 rounded-2xl border border-blue-200 bg-blue-50/50 p-6 shadow-sm flex items-center gap-4 animate-pulse">
      <div class="flex h-10 w-10 items-center justify-center rounded-xl bg-blue-600 text-white">
        <svg class="animate-spin h-5 w-5 text-white" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
          <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
          <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
        </svg>
      </div>
      <div>
        <h3 class="text-sm font-bold text-blue-950">Night Audit in Progress</h3>
        <p class="text-xs font-medium text-blue-700 mt-1">Processing due-out checkouts, no-show candidates, and nightly room/tax charges in the background. This page will refresh automatically.</p>
      </div>
    </div>
  <% end %>

  <div class="grid grid-cols-1 overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm md:grid-cols-4 mx-4 md:mx-0">
    <div class="p-6 md:border-r md:border-slate-200 md:p-8">
      <p class="mb-2 text-[11px] font-semibold uppercase tracking-[0.08em] text-slate-500">Arrivals</p>
      <h2 class="text-3xl font-bold tabular-nums tracking-tight text-slate-950"><%= @night_audit.summary["arrivals_count"] || 0 %></h2>
    </div>
    <div class="bg-slate-50/30 p-6 md:border-r md:border-slate-200 md:p-8">
      <p class="mb-2 text-[11px] font-semibold uppercase tracking-[0.08em] text-slate-500">Due Outs</p>
      <h2 class="text-3xl font-bold tabular-nums tracking-tight text-slate-950"><%= @night_audit.summary["due_out_count"] || 0 %></h2>
    </div>
    <div class="p-6 md:border-r md:border-slate-200 md:p-8">
      <p class="mb-2 text-[11px] font-semibold uppercase tracking-[0.08em] text-slate-500">Checked Out</p>
      <h2 class="text-3xl font-bold tabular-nums tracking-tight text-slate-950"><%= @night_audit.summary["checked_out_count"] || 0 %></h2>
    </div>
    <div class="p-6 md:p-8">
      <p class="mb-2 text-[11px] font-semibold uppercase tracking-[0.08em] text-slate-500">In-House</p>
      <h2 class="text-3xl font-bold tabular-nums tracking-tight text-slate-950"><%= @night_audit.summary["in_house_count"] || 0 %></h2>
    </div>
  </div>

  <div class="grid gap-8 lg:grid-cols-3 px-4 md:px-0">
    <div class="lg:col-span-2 space-y-8">
      <% financial_summary = @night_audit.financial_summary %>
      <% if financial_summary %>
        <div class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">
          <div class="border-b border-slate-200 bg-slate-50/70 px-6 py-5 sm:px-8">
            <h2 class="text-lg font-bold tracking-tight text-slate-950">Financial Summary</h2>
            <p class="mt-1 text-sm font-medium text-slate-600">Calculated totals for the business date <%= @night_audit.business_date.strftime("%d %b %Y") %>.</p>
          </div>
          <div class="p-6 sm:p-8">
            <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
              <div class="rounded-2xl border border-slate-200 bg-slate-50 p-5">
                <p class="text-[11px] font-bold uppercase tracking-wider text-slate-500 mb-2">Room Revenue</p>
                <p class="text-2xl font-bold text-slate-950"><%= number_to_currency(financial_summary.room_revenue) %></p>
              </div>
              <div class="rounded-2xl border border-slate-200 bg-slate-50 p-5">
                <p class="text-[11px] font-bold uppercase tracking-wider text-slate-500 mb-2">Tax Revenue</p>
                <p class="text-2xl font-bold text-slate-950"><%= number_to_currency(financial_summary.tax_revenue) %></p>
              </div>
              <div class="rounded-2xl border border-slate-200 bg-slate-50 p-5">
                <p class="text-[11px] font-bold uppercase tracking-wider text-slate-500 mb-2">No-Show Charges</p>
                <p class="text-2xl font-bold text-slate-950"><%= number_to_currency(financial_summary.no_show_charges) %></p>
              </div>
              <div class="rounded-2xl border border-emerald-100 bg-emerald-50/50 p-5">
                <p class="text-[11px] font-bold uppercase tracking-wider text-emerald-600 mb-2">Payments Received</p>
                <p class="text-2xl font-bold text-emerald-700"><%= number_to_currency(financial_summary.payments_total) %></p>
              </div>
              <div class="rounded-2xl border border-red-100 bg-red-50/50 p-5">
                <p class="text-[11px] font-bold uppercase tracking-wider text-red-600 mb-2">Refunds Issued</p>
                <p class="text-2xl font-bold text-red-700"><%= number_to_currency(financial_summary.refunds_total) %></p>
              </div>
              <div class="rounded-2xl border border-amber-100 bg-amber-50/50 p-5">
                <p class="text-[11px] font-bold uppercase tracking-wider text-amber-600 mb-2">Manual Adjustments</p>
                <p class="text-2xl font-bold text-amber-700"><%= number_to_currency(financial_summary.adjustments_total) %></p>
              </div>
              <div class="rounded-2xl border border-slate-200 bg-slate-950 p-5 sm:col-span-2 lg:col-span-3">
                <div class="flex items-center justify-between">
                  <p class="text-[11px] font-bold uppercase tracking-wider text-slate-400">Net Revenue</p>
                  <p class="text-3xl font-bold text-white"><%= number_to_currency(financial_summary.room_revenue + financial_summary.tax_revenue + financial_summary.no_show_charges - financial_summary.refunds_total) %></p>
                </div>
              </div>
            </div>
          </div>
        </div>
      <% end %>

      <!-- Manual Adjustments Table -->
      <div class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">
        <div class="border-b border-slate-200 bg-slate-50/70 px-6 py-5 sm:px-8">
          <h2 class="text-lg font-bold tracking-tight text-slate-950">Manual Adjustments & Voids</h2>
          <p class="mt-1 text-sm font-medium text-slate-600">Detailed record of staff interventions, rebates, and revenue corrections.</p>
        </div>
        <div class="overflow-x-auto">
          <table class="min-w-full divide-y divide-slate-200">
            <thead class="bg-slate-50">
              <tr>
                <th scope="col" class="px-6 py-3 text-left text-[10px] font-bold uppercase tracking-wider text-slate-500">Time</th>
                <th scope="col" class="px-6 py-3 text-left text-[10px] font-bold uppercase tracking-wider text-slate-500">Guest Name</th>
                <th scope="col" class="px-6 py-3 text-left text-[10px] font-bold uppercase tracking-wider text-slate-500">Category</th>
                <th scope="col" class="px-6 py-3 text-left text-[10px] font-bold uppercase tracking-wider text-slate-500">User</th>
                <th scope="col" class="px-6 py-3 text-right text-[10px] font-bold uppercase tracking-wider text-slate-500">Amount</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-slate-200 bg-white">
              <% if @adjustments.any? %>
                <% @adjustments.each do |adj| %>
                  <tr>
                    <td class="whitespace-nowrap px-6 py-4 text-xs font-medium text-slate-600"><%= adj.created_at.strftime("%H:%M") %></td>
                    <td class="px-6 py-4">
                      <p class="text-xs font-bold text-slate-900"><%= adj.booking_folio.booking.guest_name %></p>
                      <p class="text-[10px] font-medium text-slate-500">#<%= adj.booking_folio.booking.confirmation_token %></p>
                    </td>
                    <td class="whitespace-nowrap px-6 py-4">
                      <span class="inline-flex items-center rounded-md bg-amber-50 px-2 py-1 text-[10px] font-bold text-amber-700 ring-1 ring-inset ring-amber-600/20"><%= adj.category.humanize %></span>
                    </td>
                    <td class="whitespace-nowrap px-6 py-4 text-xs font-medium text-slate-600"><%= adj.user&.name || "System" %></td>
                    <td class="whitespace-nowrap px-6 py-4 text-right text-xs font-bold text-slate-900"><%= number_to_currency(adj.amount) %></td>
                  </tr>
                <% end %>
              <% else %>
                <tr>
                  <td colspan="5" class="px-6 py-10 text-center text-xs font-medium italic text-slate-400">No manual adjustments recorded for this business date.</td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      </div>

      <!-- Blocked Details Table -->
      <div class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">
        <div class="border-b border-slate-200 bg-slate-50/70 px-6 py-5 sm:px-8">
          <h2 class="text-lg font-bold tracking-tight text-slate-950">Audit Blockers</h2>
          <p class="mt-1 text-sm font-medium text-slate-600">Operational blockers identified during the audit process.</p>
        </div>        <div class="overflow-x-auto">
          <table class="min-w-full divide-y divide-slate-200">
            <thead class="bg-red-50">
              <tr>
                <th scope="col" class="px-6 py-3 text-left text-[10px] font-bold uppercase tracking-wider text-red-700">Type</th>
                <th scope="col" class="px-6 py-3 text-left text-[10px] font-bold uppercase tracking-wider text-red-700">Guest / Confirmation</th>
                <th scope="col" class="px-6 py-3 text-left text-[10px] font-bold uppercase tracking-wider text-red-700">Reason</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-slate-200 bg-white">
              <% if blockers.values.flatten.any? %>
                <% blockers.each do |label, rows| %>
                  <% rows.each do |row| %>
                    <tr>
                      <td class="whitespace-nowrap px-6 py-4 text-[10px] font-bold uppercase tracking-wider text-slate-500"><%= label.humanize %></td>
                      <td class="px-6 py-4">
                        <p class="text-xs font-bold text-slate-900"><%= row["guest_name"] %></p>
                        <p class="text-[10px] font-medium text-slate-500">#<%= row["confirmation_token"] %></p>
                      </td>
                      <td class="px-6 py-4 text-xs font-medium text-slate-600"><%= row["reason"] %></td>
                    </tr>
                  <% end %>
                <% end %>
              <% else %>
                <tr>
                  <td colspan="3" class="px-6 py-10 text-center text-xs font-medium italic text-slate-400">No audit blockers were recorded.</td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      </div>

      <!-- Warnings Table -->
      <div class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">
        <div class="border-b border-slate-200 bg-slate-50/70 px-6 py-5 sm:px-8">
          <h2 class="text-lg font-bold tracking-tight text-slate-950">Operational Warnings</h2>
          <p class="mt-1 text-sm font-medium text-slate-600">Open items preserved as warnings for management review.</p>
        </div>
        <div class="overflow-x-auto">
          <table class="min-w-full divide-y divide-slate-200">
            <thead class="bg-amber-50">
              <tr>
                <th scope="col" class="px-6 py-3 text-left text-[10px] font-bold uppercase tracking-wider text-amber-700">Type</th>
                <th scope="col" class="px-6 py-3 text-left text-[10px] font-bold uppercase tracking-wider text-amber-700">Guest / Confirmation</th>
                <th scope="col" class="px-6 py-3 text-left text-[10px] font-bold uppercase tracking-wider text-amber-700">Details</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-slate-200 bg-white">
              <% if warnings.values.flatten.any? %>
                <% warnings.each do |label, rows| %>
                  <% rows.each do |row| %>
                    <tr>
                      <td class="whitespace-nowrap px-6 py-4 text-[10px] font-bold uppercase tracking-wider text-slate-500"><%= label.humanize %></td>
                      <td class="px-6 py-4">
                        <p class="text-xs font-bold text-slate-900"><%= row["guest_name"] || "N/A" %></p>
                        <p class="text-[10px] font-medium text-slate-500">#<%= row["confirmation_token"] || "N/A" %></p>
                      </td>
                      <td class="px-6 py-4 text-xs font-medium text-slate-600"><%= row["reason"] || row["details"] || "General exception" %></td>
                    </tr>
                  <% end %>
                <% end %>
              <% else %>
                <tr>
                  <td colspan="3" class="px-6 py-10 text-center text-xs font-medium italic text-slate-400">No operational exceptions were recorded.</td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      </div>
    </div>

    <div class="space-y-8">
      <div class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">
        <div class="border-b border-slate-200 bg-slate-50/70 px-6 py-5">
          <h2 class="text-lg font-bold tracking-tight text-slate-950">Audit Details</h2>
        </div>
        <div class="p-6 space-y-4 text-sm">
          <div>
            <p class="text-[11px] font-bold uppercase tracking-wider text-slate-500">Started At</p>
            <p class="mt-1 font-semibold text-slate-900"><%= @night_audit.started_at&.strftime("%d %b %Y, %I:%M %p") || "-" %></p>
          </div>
          <div>
            <p class="text-[11px] font-bold uppercase tracking-wider text-slate-500">Completed At</p>
            <p class="mt-1 font-semibold text-slate-900"><%= @night_audit.completed_at&.strftime("%d %b %Y, %I:%M %p") || "-" %></p>
          </div>
          <div>
            <p class="text-[11px] font-bold uppercase tracking-wider text-slate-500">Business Date</p>
            <p class="mt-1 font-semibold text-slate-900"><%= @night_audit.business_date.strftime("%d %b %Y") %></p>
          </div>
          <div>
            <p class="text-[11px] font-bold uppercase tracking-wider text-slate-500">Payment Status Counts</p>
            <% payment_status_counts = @night_audit.summary.fetch("payment_status_counts", {}) %>
            <% if payment_status_counts.any? %>
              <div class="mt-2 space-y-2">
                <% payment_status_counts.each do |status, count| %>
                  <div class="flex items-center justify-between rounded-xl border border-slate-200 bg-slate-50 px-3 py-2">
                    <span class="text-xs font-semibold uppercase tracking-wider text-slate-500"><%= status %></span>
                    <span class="text-sm font-bold text-slate-900"><%= count %></span>
                  </div>
                <% end %>
              </div>
            <% else %>
              <p class="mt-1 font-semibold text-slate-900">No payment rows captured.</p>
            <% end %>
          </div>
          <% if @night_audit.notes.present? %>
            <div>
              <p class="text-[11px] font-bold uppercase tracking-wider text-slate-500">Notes</p>
              <p class="mt-1 text-sm font-medium text-slate-700"><%= @night_audit.notes %></p>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>
