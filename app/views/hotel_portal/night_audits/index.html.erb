<% content_for :breadcrumbs do %>
  <div class="flex items-center gap-x-2">
    <span class="text-sm font-medium text-slate-600"><%= current_hotel.name %></span>
    <span class="text-sm text-slate-400">/</span>
    <span class="text-sm font-semibold text-slate-900">Night Audit</span>
  </div>
<% end %>

<div class="max-w-[1600px] mx-auto pb-20 space-y-8">
  <div class="px-4 md:px-0 mt-5">
    <h1 class="text-2xl font-bold tracking-tight text-slate-950 sm:text-3xl">Night Audit</h1>
    <p class="mt-1 text-sm font-medium text-slate-600">Night audit runs automatically every day at 6:00 AM. Use manual run only when needed.</p>
  </div>

  <div class="px-4 md:px-0">
    <div class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">
      <div class="border-b border-slate-200 bg-slate-50/70 px-6 py-5 sm:px-8">
        <h2 class="text-lg font-bold tracking-tight text-slate-950">Manual Run</h2>
        <p class="mt-1 text-sm font-medium text-slate-600">Run night audit for a business date. The field defaults to yesterday to match the scheduled run.</p>
      </div>
      <div class="p-6 sm:p-8">
        <%= form_with url: hotel_night_audits_path(current_hotel), method: :post, scope: :night_audit, class: "grid gap-4 lg:grid-cols-[220px,1fr,180px] lg:items-end", data: { testid: "manual-night-audit-form" } do |f| %>
          <div>
            <%= f.label :business_date, "Business Date", class: "block text-[11px] font-bold uppercase tracking-wider text-slate-500 mb-2" %>
            <%= f.date_field :business_date, value: @suggested_business_date, class: "w-full rounded-xl border border-slate-200 bg-white px-4 py-2.5 text-sm font-medium text-slate-700 focus:border-slate-300 focus:outline-none focus:ring-0 shadow-sm" %>
          </div>
          <div>
            <%= f.label :notes, "Notes", class: "block text-[11px] font-bold uppercase tracking-wider text-slate-500 mb-2" %>
            <%= f.text_field :notes, class: "w-full rounded-xl border border-slate-200 bg-white px-4 py-2.5 text-sm font-medium text-slate-700 focus:border-slate-300 focus:outline-none focus:ring-0 shadow-sm", placeholder: "Optional note for this run" %>
          </div>
          <div>
            <%= f.submit "Run Audit", class: "inline-flex w-full items-center justify-center rounded-xl bg-slate-900 px-4 py-2.5 text-sm font-bold text-white shadow-sm transition hover:bg-slate-700" %>
          </div>
        <% end %>
      </div>
    </div>
  </div>

  <div class="px-4 md:px-0">
    <div class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">
      <div class="border-b border-slate-200 bg-slate-50/50 px-6 py-5 sm:px-8">
        <h2 class="text-lg font-bold tracking-tight text-slate-950 sm:text-xl">Audit History</h2>
        <p class="mt-1 text-sm font-medium text-slate-600">Each row is one business date for this hotel.</p>
      </div>

      <div class="overflow-x-auto">
        <table class="min-w-full table-fixed">
          <colgroup>
            <col class="w-[18%]">
            <col class="w-[16%]">
            <col class="w-[16%]">
            <col class="w-[18%]">
            <col class="w-[18%]">
            <col class="w-[14%]">
          </colgroup>
          <thead class="bg-slate-100">
            <tr>
              <th class="px-6 py-4 text-left text-[11px] font-semibold uppercase tracking-[0.1em] text-slate-600 sm:px-8">Business Date</th>
              <th class="px-6 py-4 text-left text-[11px] font-semibold uppercase tracking-[0.1em] text-slate-600">Status</th>
              <th class="px-6 py-4 text-left text-[11px] font-semibold uppercase tracking-[0.1em] text-slate-600">Trigger</th>
              <th class="px-6 py-4 text-left text-[11px] font-semibold uppercase tracking-[0.1em] text-slate-600">Performed By</th>
              <th class="px-6 py-4 text-left text-[11px] font-semibold uppercase tracking-[0.1em] text-slate-600">Completed At</th>
              <th class="px-6 py-4 text-right text-[11px] font-semibold uppercase tracking-[0.1em] text-slate-600 sm:px-8">Action</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-200 bg-white">
            <% if @night_audits.any? %>
              <% @night_audits.each_with_index do |night_audit, index| %>
                <% badge_class = case night_audit.status
                  when "completed" then "border-emerald-200 bg-emerald-50 text-emerald-700"
                  when "blocked" then "border-amber-200 bg-amber-50 text-amber-700"
                  when "failed" then "border-red-200 bg-red-50 text-red-700"
                  else "border-slate-200 bg-slate-50 text-slate-700"
                end %>
                <tr class="align-top transition-colors hover:bg-slate-100/80 <%= index.even? ? 'bg-white' : 'bg-slate-50/55' %>">
                  <td class="px-6 py-5 sm:px-8 text-sm font-bold text-slate-950"><%= night_audit.business_date.strftime("%d %b %Y") %></td>
                  <td class="px-6 py-5">
                    <span class="inline-flex items-center rounded-full border px-2 py-0.5 text-[10px] font-bold uppercase tracking-wider <%= badge_class %>"><%= night_audit.status.humanize %></span>
                  </td>
                  <td class="px-6 py-5 text-sm font-medium text-slate-700"><%= night_audit.trigger_mode.humanize %></td>
                  <td class="px-6 py-5 text-sm font-medium text-slate-700"><%= night_audit.performed_by_user&.name || "System" %></td>
                  <td class="px-6 py-5 text-sm font-medium text-slate-700"><%= night_audit.completed_at&.strftime("%d %b %Y, %I:%M %p") || "In progress" %></td>
                  <td class="px-6 py-5 text-right sm:px-8">
                    <%= link_to "View", hotel_night_audit_path(current_hotel, night_audit), class: "inline-flex items-center rounded-lg border border-slate-200 bg-white px-3 py-1.5 text-xs font-semibold text-slate-700 shadow-sm transition hover:border-slate-900 hover:bg-slate-50" %>
                  </td>
                </tr>
              <% end %>
            <% else %>
              <tr>
                <td colspan="6" class="px-6 py-20 text-center sm:px-8">
                  <p class="text-sm font-medium italic text-slate-500">No night audits have been run for this hotel yet.</p>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>

      <div class="px-6 py-4 border-t border-slate-200 bg-slate-50/50 flex justify-center sm:px-8">
        <%= paginate @night_audits %>
      </div>
    </div>
  </div>
</div>
