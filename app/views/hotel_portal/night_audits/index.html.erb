<% presenter = @presenter %>
<% primary_action = presenter.primary_action %>

<div class="mx-auto max-w-[1600px] space-y-6 px-4 pb-20 pt-5 md:px-0">
  <section class="space-y-3">
    <div class="flex flex-col gap-3 lg:flex-row lg:items-start lg:justify-between">
      <div>
        <h1 class="text-2xl font-bold tracking-tight text-slate-950 sm:text-3xl"><%= presenter.page_title %></h1>
        <p class="mt-1 text-sm font-medium text-slate-600"><%= presenter.page_subtitle %></p>
      </div>
      <span class="inline-flex w-fit items-center rounded-full border px-3 py-1 text-xs font-bold uppercase tracking-wider <%= presenter.status_badge_class %>">
        <%= presenter.status_label %>
      </span>
    </div>
    <p class="max-w-4xl text-sm font-medium text-slate-700"><%= presenter.main_message %></p>
  </section>

  <section class="overflow-hidden rounded-lg border border-slate-200 bg-white shadow-sm">
    <div class="border-b border-slate-200 bg-slate-50 px-5 py-4 sm:px-6">
      <h2 class="text-base font-bold tracking-tight text-slate-950">Business Date Control</h2>
      <p class="mt-1 text-sm font-medium text-slate-600">Hotel business date is the accounting authority for Night Audit.</p>
    </div>
    <div class="grid gap-4 p-5 sm:grid-cols-2 sm:p-6 lg:grid-cols-[1fr,1fr,2fr]">
      <% presenter.date_tiles.each do |tile| %>
        <div class="rounded-lg border border-slate-200 bg-slate-50 p-4">
          <p class="text-[11px] font-bold uppercase tracking-wider text-slate-500"><%= tile.label %></p>
          <p class="mt-1 text-xl font-bold text-slate-950"><%= tile.value %></p>
          <p class="mt-1 text-xs font-medium text-slate-500"><%= tile.detail %></p>
        </div>
      <% end %>
      <div class="rounded-lg border <%= presenter.date_difference? ? 'border-amber-200 bg-amber-50' : 'border-slate-200 bg-slate-50' %> p-4 sm:col-span-2 lg:col-span-1">
        <p class="text-[11px] font-bold uppercase tracking-wider <%= presenter.date_difference? ? 'text-amber-700' : 'text-slate-500' %>">Business Date vs Calendar Date</p>
        <p class="mt-2 text-sm font-semibold <%= presenter.date_difference? ? 'text-amber-900' : 'text-slate-700' %>"><%= presenter.date_explanation %></p>
      </div>
    </div>
  </section>

  <section class="overflow-hidden rounded-lg border border-slate-200 bg-white shadow-sm">
    <div class="border-b border-slate-200 bg-slate-50 px-5 py-4 sm:px-6">
      <h2 class="text-base font-bold tracking-tight text-slate-950">Close Readiness</h2>
      <p class="mt-1 text-sm font-medium text-slate-600">Current blocker, warning, arrival, and due-out state for <%= presenter.current_business_date_label %>.</p>
    </div>
    <div class="space-y-5 p-5 sm:p-6">
      <div class="grid grid-cols-2 gap-3 lg:grid-cols-4">
        <% presenter.readiness_counters.each do |counter| %>
          <% tone_class = case counter.tone
            when "danger" then "text-red-600"
            when "warning" then "text-amber-600"
            else "text-slate-950"
          end %>
          <div class="rounded-lg border border-slate-200 bg-slate-50 p-4">
            <p class="text-[10px] font-bold uppercase tracking-wider text-slate-500"><%= counter.label %></p>
            <p class="mt-1 text-2xl font-bold <%= tone_class %>"><%= counter.value %></p>
            <p class="mt-1 text-xs font-medium text-slate-500"><%= counter.detail %></p>
          </div>
        <% end %>
      </div>

      <div class="grid gap-4 lg:grid-cols-2">
        <div class="rounded-lg border border-slate-200 p-4">
          <div class="flex items-center justify-between gap-3">
            <h3 class="text-sm font-bold text-slate-950">Blockers</h3>
            <span class="text-xs font-semibold text-slate-500"><%= presenter.blocker_groups.sum(&:count) %> total</span>
          </div>
          <% if presenter.blocker_groups.any? %>
            <div class="mt-3 space-y-3">
              <% presenter.blocker_groups.each do |group| %>
                <div class="rounded-lg border border-red-200 bg-red-50 p-3">
                  <p class="text-xs font-bold text-red-900"><%= group.label %></p>
                  <p class="mt-1 text-xs font-medium text-red-800"><%= group.count %> items requiring attention</p>
                  <% if group.rows.first.is_a?(Hash) && group.rows.first["reason"].present? %>
                    <p class="mt-2 text-xs font-medium text-red-700"><%= group.rows.first["reason"] %></p>
                  <% end %>
                </div>
              <% end %>
            </div>
          <% else %>
            <p class="mt-3 text-sm font-medium text-slate-600">No blockers.</p>
          <% end %>
        </div>

        <div class="rounded-lg border border-slate-200 p-4">
          <div class="flex items-center justify-between gap-3">
            <h3 class="text-sm font-bold text-slate-950">Warnings</h3>
            <span class="text-xs font-semibold text-slate-500"><%= presenter.warning_groups.sum(&:count) %> total</span>
          </div>
          <% if presenter.warning_groups.any? %>
            <div class="mt-3 space-y-3">
              <% presenter.warning_groups.each do |group| %>
                <div class="rounded-lg border border-amber-200 bg-amber-50 p-3">
                  <p class="text-xs font-bold text-amber-900"><%= group.label %></p>
                  <p class="mt-1 text-xs font-medium text-amber-800"><%= group.count %> non-blocking items</p>
                </div>
              <% end %>
            </div>
          <% else %>
            <p class="mt-3 text-sm font-medium text-slate-600">No warnings.</p>
          <% end %>
        </div>
      </div>

      <div class="grid gap-3 sm:grid-cols-2">
        <% [presenter.arrival_review_summary, presenter.due_out_review_summary].each do |summary| %>
          <div class="rounded-lg border border-slate-200 bg-slate-50 p-4">
            <p class="text-[11px] font-bold uppercase tracking-wider text-slate-500"><%= summary[:label] %></p>
            <p class="mt-1 text-xl font-bold text-slate-950"><%= summary[:value] %></p>
            <p class="mt-1 text-xs font-medium text-slate-600"><%= summary[:detail] %></p>
          </div>
        <% end %>
      </div>
    </div>
  </section>

  <section class="grid gap-6 lg:grid-cols-[minmax(0,1fr),380px]">
    <div class="overflow-hidden rounded-lg border border-slate-200 bg-white shadow-sm">
      <div class="border-b border-slate-200 bg-slate-50 px-5 py-4 sm:px-6">
        <h2 class="text-base font-bold tracking-tight text-slate-950">Audit Action</h2>
        <p class="mt-1 text-sm font-medium text-slate-600">Run or retry Night Audit for the authoritative current business date.</p>
      </div>
      <div class="space-y-5 p-5 sm:p-6">
        <% if presenter.last_attempt_summary.present? %>
          <% attempt = presenter.last_attempt_summary %>
          <div class="rounded-lg border border-slate-200 bg-slate-50 p-4">
            <div class="flex flex-col gap-3 sm:flex-row sm:items-start sm:justify-between">
              <div>
                <p class="text-[11px] font-bold uppercase tracking-wider text-slate-500">Last Audit Attempt</p>
                <p class="mt-1 text-sm font-bold text-slate-950"><%= attempt[:status] %></p>
              </div>
              <div class="grid gap-2 text-xs font-medium text-slate-600 sm:grid-cols-2">
                <p><span class="font-bold text-slate-700">Trigger:</span> <%= attempt[:trigger] %></p>
                <p><span class="font-bold text-slate-700">By:</span> <%= attempt[:performed_by] %></p>
                <p><span class="font-bold text-slate-700">Started:</span> <%= attempt[:started_at] %></p>
                <p><span class="font-bold text-slate-700">Finished At:</span> <%= attempt[:finished_at] %></p>
              </div>
            </div>
            <% if attempt[:failure].present? %>
              <p class="mt-3 rounded-lg border border-red-200 bg-red-50 p-3 text-xs font-semibold text-red-800"><%= attempt[:failure] %></p>
            <% end %>
          </div>
        <% else %>
          <p class="rounded-lg border border-slate-200 bg-slate-50 p-4 text-sm font-medium text-slate-600">No audit attempt has been started for this business date.</p>
        <% end %>

        <% if primary_action.night_audit.present? && primary_action.label != "Retry Audit" %>
          <%= link_to primary_action.label, hotel_night_audit_path(current_hotel, primary_action.night_audit), class: "inline-flex w-full items-center justify-center rounded-lg bg-slate-900 px-5 py-2.5 text-sm font-bold text-white shadow-sm transition hover:bg-slate-700 sm:w-auto" %>
        <% else %>
          <%= form_with url: hotel_night_audits_path(current_hotel), method: :post, scope: :night_audit, class: "grid gap-4 lg:grid-cols-[1fr,auto]", data: { testid: "audit-action-form" } do |f| %>
            <%= f.hidden_field :business_date, value: presenter.form_business_date_value %>
            <div>
              <%= f.label :notes, "Notes", class: "block text-[11px] font-bold uppercase tracking-wider text-slate-500 mb-2" %>
              <%= f.text_field :notes, class: "w-full rounded-lg border border-slate-200 bg-white px-4 py-2.5 text-sm font-medium text-slate-700 shadow-sm focus:border-slate-300 focus:outline-none focus:ring-0", placeholder: "Required for early audit or retry context" %>
            </div>
            <div class="lg:self-end">
              <%= f.submit primary_action.label, disabled: !primary_action.enabled, class: "inline-flex w-full items-center justify-center rounded-lg bg-slate-900 px-5 py-2.5 text-sm font-bold text-white shadow-sm transition hover:bg-slate-700 disabled:cursor-not-allowed disabled:bg-slate-300 lg:w-auto" %>
            </div>
          <% end %>
          <% if primary_action.disabled_reason.present? %>
            <p class="text-sm font-medium text-slate-500"><%= primary_action.disabled_reason %></p>
          <% end %>
        <% end %>

        <% if (resolve_action = presenter.resolve_action).present? %>
          <%= link_to resolve_action.label, resolve_hotel_night_audit_path(current_hotel, resolve_action.night_audit), class: "inline-flex w-full items-center justify-center rounded-lg border border-amber-300 bg-amber-50 px-5 py-2.5 text-sm font-bold text-amber-800 shadow-sm transition hover:bg-amber-100 sm:w-auto" %>
        <% end %>
      </div>
    </div>

    <div class="overflow-hidden rounded-lg border border-red-200 bg-white shadow-sm">
      <div class="border-b border-red-200 bg-red-50 px-5 py-4 sm:px-6">
        <h2 class="text-base font-bold tracking-tight text-red-950">Danger Zone</h2>
        <p class="mt-1 text-sm font-medium text-red-800">Exceptional override for business date continuity.</p>
      </div>
      <div class="space-y-4 p-5 sm:p-6">
        <h3 class="text-sm font-bold text-red-950">Force Close Business Date</h3>
        <p class="text-sm font-medium text-red-800">
          Force close advances <%= presenter.current_business_date_label %> to <%= presenter.format_date(presenter.next_business_date) %> without resolving every blocker.
        </p>
        <% if presenter.can_force_close? %>
          <%= form_with url: hotel_night_audits_path(current_hotel), method: :post, scope: :night_audit, class: "space-y-3" do |f| %>
            <%= f.hidden_field :business_date, value: presenter.form_business_date_value %>
            <%= f.hidden_field :force_roll, value: "1" %>
            <div>
              <%= f.label :notes, "Override Reason", class: "block text-[11px] font-bold uppercase tracking-wider text-red-700 mb-2" %>
              <%= f.text_area :notes, rows: 3, required: true, class: "w-full rounded-lg border border-red-200 bg-white px-4 py-2.5 text-sm font-medium text-slate-700 shadow-sm focus:border-red-300 focus:outline-none focus:ring-0", placeholder: "Required: explain why this business date must be force closed" %>
            </div>
            <%= f.submit "Force Close Business Date", class: "inline-flex w-full items-center justify-center rounded-lg bg-red-600 px-5 py-2.5 text-sm font-bold text-white shadow-sm transition hover:bg-red-700", data: { turbo_confirm: presenter.force_close_confirmation } %>
          <% end %>
        <% else %>
          <p class="rounded-lg border border-slate-200 bg-slate-50 p-3 text-sm font-medium text-slate-600"><%= presenter.force_close_unavailable_reason %></p>
        <% end %>
      </div>
    </div>
  </section>

  <% if Rails.env.development? %>
    <section class="overflow-hidden rounded-lg border border-amber-200 bg-white shadow-sm">
      <div class="border-b border-amber-200 bg-amber-50 px-5 py-4 sm:px-6">
        <h2 class="text-base font-bold tracking-tight text-amber-950">Development Tools</h2>
        <p class="mt-1 text-sm font-medium text-amber-800">Development-only bypass for the current accounting business date.</p>
      </div>
      <div class="flex flex-col gap-4 p-5 sm:flex-row sm:items-center sm:justify-between sm:p-6">
        <p class="text-sm font-medium text-amber-800">Run an audit without the production closability time check.</p>
        <%= form_with url: hotel_night_audits_path(current_hotel), method: :post, scope: :night_audit do |f| %>
          <%= f.hidden_field :business_date, value: presenter.form_business_date_value %>
          <%= f.hidden_field :allow_unclosable_date, value: "1" %>
          <%= f.hidden_field :notes, value: "Dev mode force run" %>
          <%= f.submit "DEV MODE: RUN TODAY AUDIT", class: "inline-flex w-full items-center justify-center rounded-lg bg-amber-600 px-5 py-2.5 text-sm font-bold text-white shadow-sm transition hover:bg-amber-700 sm:w-auto" %>
        <% end %>
      </div>
    </section>
  <% end %>

  <section class="overflow-hidden rounded-lg border border-slate-200 bg-white shadow-sm">
    <div class="border-b border-slate-200 bg-slate-50 px-5 py-4 sm:px-6">
      <h2 class="text-base font-bold tracking-tight text-slate-950">Audit History</h2>
      <p class="mt-1 text-sm font-medium text-slate-600">Each row is one business date for this hotel.</p>
    </div>

    <div class="hidden overflow-x-auto lg:block">
      <table class="min-w-full table-fixed">
        <colgroup>
          <col class="w-[18%]">
          <col class="w-[16%]">
          <col class="w-[16%]">
          <col class="w-[18%]">
          <col class="w-[18%]">
          <col class="w-[14%]">
        </colgroup>
        <thead class="bg-slate-100">
          <tr>
            <th class="px-6 py-4 text-left text-[11px] font-semibold uppercase tracking-wider text-slate-600">Business Date</th>
            <th class="px-6 py-4 text-left text-[11px] font-semibold uppercase tracking-wider text-slate-600">Status</th>
            <th class="px-6 py-4 text-left text-[11px] font-semibold uppercase tracking-wider text-slate-600">Trigger</th>
            <th class="px-6 py-4 text-left text-[11px] font-semibold uppercase tracking-wider text-slate-600">Performed By</th>
            <th class="px-6 py-4 text-left text-[11px] font-semibold uppercase tracking-wider text-slate-600">Finished At</th>
            <th class="px-6 py-4 text-right text-[11px] font-semibold uppercase tracking-wider text-slate-600">Action</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-200 bg-white">
          <% if presenter.history_rows.any? %>
            <% presenter.history_rows.each_with_index do |row, index| %>
              <tr class="align-top transition-colors hover:bg-slate-100/80 <%= index.even? ? 'bg-white' : 'bg-slate-50/55' %>">
                <td class="px-6 py-5 text-sm font-bold text-slate-950"><%= row.business_date %></td>
                <td class="px-6 py-5">
                  <span class="inline-flex items-center rounded-full border px-2 py-0.5 text-[10px] font-bold uppercase tracking-wider <%= row.status_class %>"><%= row.status_label %></span>
                </td>
                <td class="px-6 py-5 text-sm font-medium text-slate-700"><%= row.trigger_label %></td>
                <td class="px-6 py-5 text-sm font-medium text-slate-700"><%= row.performed_by %></td>
                <td class="px-6 py-5 text-sm font-medium text-slate-700"><%= row.finished_at %></td>
                <td class="px-6 py-5 text-right">
                  <%= link_to "View", hotel_night_audit_path(current_hotel, row.night_audit), class: "inline-flex items-center rounded-lg border border-slate-200 bg-white px-3 py-1.5 text-xs font-semibold text-slate-700 shadow-sm transition hover:border-slate-900 hover:bg-slate-50" %>
                </td>
              </tr>
            <% end %>
          <% else %>
            <tr>
              <td colspan="6" class="px-6 py-16 text-center">
                <p class="text-sm font-medium italic text-slate-500">No night audits have been run for this hotel yet.</p>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>

    <div class="divide-y divide-slate-200 lg:hidden">
      <% if presenter.history_rows.any? %>
        <% presenter.history_rows.each do |row| %>
          <div class="space-y-3 p-5">
            <div class="flex items-start justify-between gap-3">
              <div>
                <p class="text-sm font-bold text-slate-950"><%= row.business_date %></p>
                <p class="mt-1 text-xs font-medium text-slate-500"><%= row.trigger_label %> by <%= row.performed_by %></p>
              </div>
              <span class="inline-flex items-center rounded-full border px-2 py-0.5 text-[10px] font-bold uppercase tracking-wider <%= row.status_class %>"><%= row.status_label %></span>
            </div>
            <div class="flex items-center justify-between gap-3">
              <p class="text-xs font-medium text-slate-600"><span class="font-bold text-slate-700">Finished At:</span> <%= row.finished_at %></p>
              <%= link_to "View", hotel_night_audit_path(current_hotel, row.night_audit), class: "inline-flex items-center rounded-lg border border-slate-200 bg-white px-3 py-1.5 text-xs font-semibold text-slate-700 shadow-sm" %>
            </div>
          </div>
        <% end %>
      <% else %>
        <p class="px-5 py-14 text-center text-sm font-medium italic text-slate-500">No night audits have been run for this hotel yet.</p>
      <% end %>
    </div>

    <div class="border-t border-slate-200 bg-slate-50 px-5 py-4">
      <div class="flex justify-center"><%= paginate @night_audits %></div>
    </div>
  </section>
</div>
