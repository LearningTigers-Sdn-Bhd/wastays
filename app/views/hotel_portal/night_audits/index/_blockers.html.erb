<section class="overflow-hidden rounded-xl border border-border bg-card shadow-sm">
  <header class="flex items-center justify-between gap-3 border-b border-border bg-muted/60 px-4 py-2.5">
    <h2 class="inline-flex items-center gap-2 text-xs font-bold uppercase tracking-wider text-foreground">
      <span class="inline-flex size-6 items-center justify-center rounded-md bg-red-50 text-red-700"><%= cached_icon "triangle-alert", class: "size-3.5", aria: { hidden: true } %></span>
      Blockers
    </h2>
    <span class="text-xs font-semibold text-muted-foreground"><%= presenter.flattened_blocker_rows.count %> total</span>
  </header>

  <% if presenter.flattened_blocker_rows.any? %>
    <div class="hidden overflow-x-auto md:block">
      <table class="min-w-full divide-y divide-border text-sm" data-testid="blockers-table">
        <thead class="bg-card text-left text-[10px] font-semibold uppercase tracking-wide text-muted-foreground">
          <tr>
            <th class="w-[22%] px-4 py-2">Type</th>
            <th class="w-[34%] px-4 py-2">Reason</th>
            <th class="px-4 py-2">Detail / Affected Record</th>
            <th class="w-[16%] px-4 py-2 text-right">Action</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-border bg-card">
          <% presenter.flattened_blocker_rows.each do |row| %>
            <tr class="align-top hover:bg-red-50/30">
              <td class="px-4 py-2.5"><span class="inline-flex rounded bg-card px-1.5 py-0.5 text-[10px] font-bold uppercase tracking-wide text-red-700 ring-1 ring-inset ring-red-600/25"><%= row.type %></span></td>
              <td class="px-4 py-2.5 font-semibold text-foreground"><%= row.reason %></td>
              <td class="px-4 py-2.5 text-muted-foreground"><%= row.detail %></td>
              <td class="px-4 py-2.5 text-right">
                <% if row.action == "resolve" && resolve_action.present? %>
                  <%= link_to "Resolve blockers", resolve_hotel_night_audit_path(current_hotel, resolve_action.night_audit), class: "inline-flex rounded-md border border-amber-200 bg-amber-50 px-2.5 py-1 text-xs font-semibold text-amber-800 hover:bg-amber-100" %>
                <% elsif row.action == "booking" && row.booking_id.present? %>
                  <%= link_to hotel_booking_workspace_path(current_hotel, row.booking_id, tab: "folio_operations"), class: "inline-flex items-center gap-1 rounded-md bg-primary px-2.5 py-1 text-xs font-semibold text-primary-foreground transition hover:bg-primary-hover" do %>
                    View Booking <%= cached_icon "arrow-up-right", class: "size-3", aria: { hidden: true } %>
                  <% end %>
                <% else %>
                  <span class="text-xs text-muted-foreground">—</span>
                <% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>

    <div class="divide-y divide-border md:hidden">
      <% presenter.flattened_blocker_rows.each do |row| %>
        <div class="space-y-2 px-4 py-3">
          <p class="text-xs font-bold uppercase tracking-wide text-red-700"><%= row.type %></p>
          <p class="text-sm font-semibold text-foreground"><%= row.reason %></p>
          <p class="text-xs text-muted-foreground"><%= row.detail %></p>
          <% if row.action == "resolve" && resolve_action.present? %>
            <%= link_to "Resolve blockers", resolve_hotel_night_audit_path(current_hotel, resolve_action.night_audit), class: "inline-flex rounded-md border border-amber-200 bg-amber-50 px-2.5 py-1 text-xs font-semibold text-amber-800" %>
          <% elsif row.action == "booking" && row.booking_id.present? %>
            <%= link_to hotel_booking_workspace_path(current_hotel, row.booking_id, tab: "folio_operations"), class: "inline-flex items-center gap-1 rounded-md bg-primary px-2.5 py-1 text-xs font-semibold text-primary-foreground" do %>
              View Booking <%= cached_icon "arrow-up-right", class: "size-3", aria: { hidden: true } %>
            <% end %>
          <% end %>
        </div>
      <% end %>
    </div>
  <% else %>
    <p class="px-4 py-5 text-sm font-medium text-muted-foreground">No blockers.</p>
  <% end %>
</section>
