<section class="overflow-hidden rounded-xl border border-border bg-card shadow-sm">
  <header class="flex items-center justify-between gap-3 border-b border-border bg-muted/60 px-4 py-2.5">
    <div>
      <h2 class="inline-flex items-center gap-2 text-xs font-bold uppercase tracking-wider text-foreground">
        <span class="inline-flex size-6 items-center justify-center rounded-md bg-indigo-50 text-indigo-700"><%= cached_icon "history", class: "size-3.5", aria: { hidden: true } %></span>
        Audit History
      </h2>
      <p class="mt-0.5 text-xs text-muted-foreground">One row per business date</p>
    </div>
  </header>

  <div class="overflow-x-auto">
    <table class="min-w-[900px] w-full table-fixed divide-y divide-border text-sm" data-testid="audit-history-table">
      <colgroup>
        <col class="w-[18%]">
        <col class="w-[16%]">
        <col class="w-[16%]">
        <col class="w-[18%]">
        <col class="w-[20%]">
        <col class="w-[12%]">
      </colgroup>
      <thead class="bg-muted/80 text-left text-[10px] font-semibold uppercase tracking-wide text-muted-foreground">
        <tr>
          <th class="px-4 py-2">Business Date</th>
          <th class="px-4 py-2">Status</th>
          <th class="px-4 py-2">Trigger</th>
          <th class="px-4 py-2">Performed By</th>
          <th class="px-4 py-2">Finished At</th>
          <th class="px-4 py-2 text-right">Action</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-border bg-card">
        <% if presenter.history_rows.any? %>
          <% presenter.history_rows.each_with_index do |row, index| %>
            <tr class="align-top transition-colors hover:bg-muted/80 <%= index.even? ? 'bg-card' : 'bg-muted/40' %>">
              <td class="px-4 py-2.5 font-semibold text-foreground"><%= row.business_date %></td>
              <td class="px-4 py-2.5">
                <span class="inline-flex items-center rounded-full border px-2 py-0.5 text-[10px] font-bold uppercase tracking-wider <%= row.status_class %>"><%= row.status_label %></span>
              </td>
              <td class="px-4 py-2.5 font-medium text-foreground"><%= row.trigger_label %></td>
              <td class="px-4 py-2.5 font-medium text-foreground"><%= row.performed_by %></td>
              <td class="px-4 py-2.5 font-medium text-foreground"><%= row.finished_at %></td>
              <td class="px-4 py-2.5 text-right">
                <%= link_to hotel_night_audit_path(current_hotel, row.night_audit), class: "inline-flex items-center gap-1 rounded-md bg-primary px-2.5 py-1 text-xs font-semibold text-primary-foreground shadow-sm transition hover:bg-primary-hover" do %>
                  View <%= cached_icon "arrow-up-right", class: "size-3", aria: { hidden: true } %>
                <% end %>
              </td>
            </tr>
          <% end %>
        <% else %>
          <tr>
            <td colspan="6" class="px-4 py-10 text-center text-sm font-medium italic text-muted-foreground">No night audits have been run for this hotel yet.</td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>

  <div class="border-t border-border bg-muted px-4 py-3">
    <div class="flex justify-center"><%= paginate night_audits %></div>
  </div>
</section>
