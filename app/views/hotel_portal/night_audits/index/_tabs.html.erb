<div class="rounded-xl border border-border bg-card p-1.5 shadow-sm" data-testid="night-audit-index-tabs">
  <nav class="flex items-center gap-1 overflow-x-auto" aria-label="Night Audit sections" role="tablist">
    <% [
      { name: "audit-history", label: "Audit History", icon: "history", count: presenter.history_rows.count },
      { name: "advanced-actions", label: "Advanced Actions", icon: "settings-2", count: nil }
    ].each do |tab| %>
      <button type="button"
              data-tabs-target="tab"
              data-tab-name="<%= tab[:name] %>"
              data-tab-label="<%= tab[:label] %>"
              data-action="click->tabs#switch"
              class="group inline-flex h-9 items-center gap-2 whitespace-nowrap rounded-lg px-4 text-sm font-medium text-muted-foreground transition-all duration-150 hover:bg-muted hover:text-foreground data-[active=true]:bg-blue-600 data-[active=true]:font-semibold data-[active=true]:text-primary-foreground"
              aria-controls="<%= tab[:name] %>-panel"
              role="tab">
        <%= cached_icon tab[:icon], class: "size-4", aria: { hidden: true } %>
        <span><%= tab[:label] %></span>
        <% unless tab[:count].nil? %>
          <span class="rounded-full bg-muted px-1.5 py-0.5 text-[10px] font-bold text-muted-foreground transition-colors duration-150 group-data-[active=true]:bg-card/20 group-data-[active=true]:text-primary-foreground"><%= tab[:count] %></span>
        <% end %>
      </button>
    <% end %>
  </nav>
</div>
