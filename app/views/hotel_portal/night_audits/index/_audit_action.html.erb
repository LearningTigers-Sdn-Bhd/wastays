<section class="overflow-hidden rounded-xl border border-slate-200 bg-white shadow-sm">
  <header class="flex items-center justify-between gap-3 border-b border-slate-200 bg-slate-50/60 px-4 py-2.5">
    <h2 class="inline-flex items-center gap-2 text-xs font-bold uppercase tracking-wider text-slate-700">
      <span class="inline-flex size-6 items-center justify-center rounded-md bg-blue-50 text-blue-700"><%= cached_icon "moon-star", class: "size-3.5", aria: { hidden: true } %></span>
      Audit Action
    </h2>
    <span class="text-xs font-semibold text-slate-500"><%= presenter.current_business_date_label %></span>
  </header>

  <% if presenter.last_attempt_summary.present? %>
    <% attempt = presenter.last_attempt_summary %>
    <div class="grid gap-px bg-slate-200 sm:grid-cols-2 lg:grid-cols-5">
      <div class="bg-white px-4 py-2.5">
        <p class="text-[10px] font-bold uppercase tracking-wider text-slate-500">Last Attempt</p>
        <p class="mt-0.5 text-sm font-semibold text-slate-950"><%= attempt[:status] %></p>
      </div>
      <div class="bg-white px-4 py-2.5">
        <p class="text-[10px] font-bold uppercase tracking-wider text-slate-500">Trigger</p>
        <p class="mt-0.5 text-sm font-semibold text-slate-950"><%= attempt[:trigger] %></p>
      </div>
      <div class="bg-white px-4 py-2.5">
        <p class="text-[10px] font-bold uppercase tracking-wider text-slate-500">Performed By</p>
        <p class="mt-0.5 text-sm font-semibold text-slate-950"><%= attempt[:performed_by] %></p>
      </div>
      <div class="bg-white px-4 py-2.5">
        <p class="text-[10px] font-bold uppercase tracking-wider text-slate-500">Started</p>
        <p class="mt-0.5 text-sm font-semibold text-slate-950"><%= attempt[:started_at] %></p>
      </div>
      <div class="bg-white px-4 py-2.5 sm:col-span-2 lg:col-span-1">
        <p class="text-[10px] font-bold uppercase tracking-wider text-slate-500">Finished At</p>
        <p class="mt-0.5 text-sm font-semibold text-slate-950"><%= attempt[:finished_at] %></p>
      </div>
    </div>
    <% if attempt[:failure].present? %>
      <p class="border-t border-red-200 bg-red-50 px-4 py-2.5 text-xs font-semibold text-red-800"><%= attempt[:failure] %></p>
    <% end %>
  <% else %>
    <p class="border-b border-slate-200 px-4 py-3 text-sm font-medium text-slate-600">No audit attempt has been started for this business date.</p>
  <% end %>

  <div class="p-4">
    <% if primary_action.night_audit.present? && primary_action.label != "Retry Audit" %>
      <%= link_to primary_action.label, hotel_night_audit_path(current_hotel, primary_action.night_audit), class: "inline-flex w-full items-center justify-center rounded-md bg-slate-900 px-4 py-2 text-sm font-bold text-white shadow-sm transition hover:bg-slate-700 sm:w-auto" %>
    <% else %>
      <%= form_with url: hotel_night_audits_path(current_hotel), method: :post, scope: :night_audit, class: "grid gap-3 lg:grid-cols-[minmax(0,1fr),auto]", data: { testid: "audit-action-form" } do |f| %>
        <%= f.hidden_field :business_date, value: presenter.form_business_date_value %>
        <div>
          <%= f.label :notes, "Notes", class: "mb-1 block text-[10px] font-bold uppercase tracking-wider text-slate-500" %>
          <%= f.text_field :notes, class: "w-full rounded-md border border-slate-200 bg-white px-3 py-2 text-sm font-medium text-slate-700 shadow-sm focus:border-slate-300 focus:outline-none focus:ring-0", placeholder: "Required for early audit or retry context" %>
        </div>
        <div class="lg:self-end">
          <%= f.submit primary_action.label, disabled: !primary_action.enabled, class: "inline-flex w-full items-center justify-center rounded-md bg-slate-900 px-4 py-2 text-sm font-bold text-white shadow-sm transition hover:bg-slate-700 disabled:cursor-not-allowed disabled:bg-slate-300 lg:w-auto" %>
        </div>
      <% end %>
      <% if primary_action.disabled_reason.present? %>
        <p class="mt-2 inline-flex items-center gap-1.5 rounded-md border border-slate-200 bg-slate-50 px-2.5 py-1.5 text-xs font-medium text-slate-600">
          <%= cached_icon "circle-alert", class: "size-3.5 shrink-0 text-slate-500", aria: { hidden: true } %>
          <%= primary_action.disabled_reason %>
        </p>
      <% end %>
    <% end %>

    <% if resolve_action.present? %>
      <%= link_to resolve_action.label, resolve_hotel_night_audit_path(current_hotel, resolve_action.night_audit), class: "mt-3 inline-flex w-full items-center justify-center rounded-md border border-amber-300 bg-amber-50 px-4 py-2 text-sm font-bold text-amber-800 shadow-sm transition hover:bg-amber-100 sm:w-auto" %>
    <% end %>
  </div>
</section>
