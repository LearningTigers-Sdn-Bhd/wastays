<div class="max-w-5xl mx-auto py-12 px-4 sm:px-6 lg:px-8 space-y-6">
  <div class="flex items-center justify-between gap-4">
    <div>
      <p class="text-sm font-medium text-slate-500">Hotel Portal</p>
      <h1 class="text-3xl font-bold tracking-tight text-slate-950">Onboarding Sessions</h1>
      <p class="mt-2 text-sm text-slate-600">Review the onboarding and training sessions scheduled for your hotel.</p>
    </div>

    <%= link_to hotel_dashboard_path(current_hotel), class: "inline-flex items-center justify-center rounded-xl border border-slate-200 bg-white px-4 py-2.5 text-sm font-semibold text-slate-700 transition hover:bg-slate-50" do %>
      Back to Dashboard
    <% end %>
  </div>

  <div class="rounded-2xl border border-slate-200 bg-white shadow-sm">
    <div class="border-b border-slate-200 px-6 py-4 sm:px-8">
      <h2 class="text-lg font-bold text-slate-950">Session History</h2>
      <p class="mt-1 text-sm text-slate-500">These are the onboarding sessions recorded for <%= current_hotel.name %>.</p>
    </div>

    <div class="divide-y divide-slate-200">
      <% if @sessions.any? %>
        <% @sessions.each do |session| %>
          <div class="flex flex-col gap-4 px-6 py-5 sm:px-8">
            <div class="flex flex-col gap-1 sm:flex-row sm:items-center sm:justify-between">
              <div>
                <p class="text-sm font-bold text-slate-900"><%= session.trainer_name.presence&.titleize || "No trainer assigned" %></p>
                <p class="text-xs text-slate-500">
                  Scheduled: <%= session.scheduled_at&.strftime("%d %b %Y at %I:%M %p") || "Not set" %>
                </p>
              </div>
              <span class="inline-flex items-center rounded-full px-2.5 py-1 text-[11px] font-semibold <%= case session.status
                when 'completed' then 'bg-emerald-50 text-emerald-700 ring-1 ring-inset ring-emerald-200'
                when 'cancelled' then 'bg-rose-50 text-rose-700 ring-1 ring-inset ring-rose-200'
                else 'bg-amber-50 text-amber-700 ring-1 ring-inset ring-amber-200'
              end %>">
                <%= session.status.titleize %>
              </span>
            </div>

            <div class="flex flex-col gap-3 text-sm">
              <div class="flex flex-wrap items-center gap-3">
                <% if session.meeting_link.present? && session.status == "scheduled" %>
                  <%= link_to session.formatted_meeting_link, target: "_blank", class: "inline-flex items-center gap-1.5 rounded-lg border border-blue-100 bg-blue-50 px-3 py-2 text-xs font-semibold text-blue-700 transition hover:bg-blue-100" do %>
                    Join Call
                  <% end %>
                <% elsif session.meeting_link.present? %>
                  <span class="inline-flex items-center gap-1.5 rounded-lg border border-slate-200 bg-slate-100 px-3 py-2 text-xs font-semibold text-slate-400 cursor-not-allowed">
                    Join Call
                  </span>
                <% end %>

                <span class="text-xs text-slate-500">
                  <% if session.status == "completed" %>
                    Completed at <%= session.completed_at&.strftime("%d %b %Y at %I:%M %p") || "N/A" %>
                  <% elsif session.status == "cancelled" %>
                    Cancelled
                  <% else %>
                    Awaiting completion
                  <% end %>
                </span>
              </div>

              <% if session.status == "cancelled" && session.notes.present? %>
                <% cancellation_reason = session.notes.to_s[/CANCELLED:\s*(.*)\z/m, 1] || session.notes %>
                <div class="rounded-xl border border-rose-100 bg-rose-50 px-4 py-3 text-xs text-rose-700">
                  <span class="font-semibold">Cancellation note:</span>
                  <%= cancellation_reason %>
                </div>
              <% end %>

              <% if session.status == "scheduled" %>
                <div class="relative w-fit ml-auto" data-controller="cancel-panel">
                  <button type="button"
                          data-cancel-panel-target="trigger"
                          data-action="click->cancel-panel#toggle"
                          aria-expanded="false"
                          class="inline-flex items-center gap-1.5 rounded-xl border border-rose-200 bg-rose-50 px-4 py-2 text-xs font-semibold text-rose-700 transition hover:bg-rose-100">
                    Cancel
                  </button>
                  <div data-cancel-panel-target="panel"
                       class="absolute left-0 z-20 mt-3 hidden w-[320px] rounded-xl border border-slate-200 bg-white p-4 shadow-2xl ring-1 ring-black/10">
                    <p class="text-xs text-slate-500">Please provide a reason before cancelling this session.</p>
                    <%= form_with url: hotel_cancel_onboarding_session_path(current_hotel, session_id: session.id), method: :post, class: "mt-3 space-y-3" do |f| %>
                      <%= text_area_tag :cancel_reason, nil, rows: 3, required: true, minlength: 10, class: "w-full rounded-sm border-slate-200 text-sm focus:border-rose-400 focus:ring-0" %>
                      <div class="flex justify-end">
                        <%= f.submit "Confirm Cancel", class: "inline-flex items-center justify-center rounded-xl bg-rose-600 px-4 py-2 text-xs font-semibold text-white transition hover:bg-rose-700" %>
                      </div>
                    <% end %>
                  </div>
                </div>
              <% end %>
            </div>
          </div>
        <% end %>
      <% else %>
        <div class="px-6 py-10 text-center text-sm text-slate-500 italic sm:px-8">
          No onboarding sessions have been scheduled yet.
        </div>
      <% end %>
    </div>
  </div>
</div>
