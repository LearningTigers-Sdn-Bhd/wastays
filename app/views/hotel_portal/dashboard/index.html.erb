<% content_for :title, "#{@current_hotel.name} Dashboard | WAStays" %>

<div class="w-full space-y-3.5">
  <%# ─── ONBOARDING WIZARD ─── %>
  <% if @current_hotel.onboarding? %>
    <%= render "onboarding_wizard" %>
  <% end %>

  <%# ─── TOP HEADER: OPERATIONS SUMMARY ─── %>
  <% unless @current_hotel.onboarding? %>
    <div>
      <div class="grid grid-cols-1 overflow-hidden rounded-2xl border border-border bg-card shadow-sm md:grid-cols-4">
        <div class="p-3 border-b border-border md:border-b-0 md:border-r md:border-border md:p-3">
          <p class="mb-2 text-[11px] font-semibold uppercase tracking-[0.08em] text-muted-foreground">Revenue <span class="text-[10px] font-medium text-muted-foreground">(This Month)</span></p>
          <h2 class="text-2xl font-bold tabular-nums tracking-tight text-foreground"><%= @dashboard_presenter.revenue_this_month_formatted %></h2>
        </div>

        <div class="bg-muted/30 p-3 border-b border-border md:border-b-0 md:border-r md:border-border md:p-3">
          <p class="mb-2 text-[11px] font-semibold uppercase tracking-[0.08em] text-muted-foreground">Bookings <span class="text-[10px] font-medium text-muted-foreground">(This Month)</span></p>
          <h2 class="text-2xl font-bold tabular-nums tracking-tight text-foreground"><%= @dashboard_presenter.bookings_this_month_count %></h2>
        </div>

        <div class="p-3 border-b border-border md:border-b-0 md:border-r md:border-border md:p-3">
          <p class="mb-2 text-[11px] font-semibold uppercase tracking-[0.08em] text-muted-foreground">Check-ins (Today)</p>
          <h2 class="text-2xl font-bold tabular-nums tracking-tight text-foreground"><%= @dashboard_presenter.today_arrivals_count %></h2>
        </div>

        <div class="bg-muted/30 p-3 border-b border-border md:border-b-0 md:border-r md:border-border md:p-3">
          <p class="mb-2 text-[11px] font-semibold uppercase tracking-[0.08em] text-muted-foreground">Check-outs (Today)</p>
          <h2 class="text-2xl font-bold tabular-nums tracking-tight text-foreground"><%= @dashboard_presenter.today_checkouts_count %></h2>
        </div>
      </div>
    </div>
  <% end %>

  <%# ─── MAIN CONTENT: SPLIT PANE ─── %>
  <div class="grid lg:grid-cols-12 gap-8">

    <%# SIDE PANE: STATUS & TOOLS %>
    <div class="lg:col-span-3 space-y-4">

      <%# Live Inventory Counter %>
      <% unless @current_hotel.onboarding? %>
        <div class="rounded-2xl border border-border bg-card px-6 py-3 shadow-sm">
          <h3 class="mb-2 border-b border-border pb-3 text-[11px] font-semibold uppercase tracking-[0.08em] text-muted-foreground">Inventory <span class="text-[10px] font-medium text-muted-foreground">(Today)</span></h3>
          <div class="space-y-4">
            <% @dashboard_presenter.live_inventory_items.each do |item| %>
              <div>
                <div class="flex justify-between items-start mb-1.5">
                  <div class="flex flex-col">
                    <span class="text-xs font-bold text-foreground"><%= item[:name] %></span>
                    <span class="text-[10px] font-medium text-muted-foreground"><%= item[:total] %> Total Units</span>
                  </div>
                  <div class="flex flex-col items-end">
                    <span class="text-xs font-black <%= item[:remaining_color_class] %>">
                      <%= item[:remaining_label] %>
                    </span>
                    <span class="text-[10px] font-bold text-muted-foreground"><%= item[:sold] %> Sold</span>
                  </div>
                </div>
                <div class="flex w-full h-2 bg-muted rounded-full overflow-hidden">
                  <div class="flex flex-col justify-center overflow-hidden bg-brand-primary transition-all duration-500" role="progressbar" style="width: <%= item[:percentage] %>%" aria-valuenow="<%= item[:sold] %>" aria-valuemin="0" aria-valuemax="<%= item[:total] %>"></div>
                </div>
              </div>
            <% end %>
          </div>
        </div>
      <% end %>

      <%# 7-Day Occupancy %>
      <% unless @current_hotel.onboarding? %>
        <div class="rounded-2xl border border-border bg-card px-6 py-3 shadow-sm">
          <h3 class="mb-2 border-b border-border pb-3 text-[11px] font-semibold uppercase tracking-[0.08em] text-muted-foreground">7-Day Occupancy</h3>
          <div class="space-y-3">
            <% @dashboard_presenter.occupancy_snapshot_days.each do |day| %>
              <div>
                <div class="flex justify-between items-center mb-1">
                  <span class="text-xs font-medium text-muted-foreground"><%= day[:date_label] %></span>
                  <span class="text-xs font-bold <%= day[:percent_text_class] %>">
                    <%= day[:percent] %>% (<%= day[:sold] %>/<%= day[:total] %>)
                  </span>
                </div>
                <div class="flex w-full h-1.5 bg-muted rounded-full overflow-hidden">
                  <div class="flex flex-col justify-center overflow-hidden <%= day[:percent_bar_class] %>" role="progressbar" style="width: <%= day[:percent] %>%" aria-valuenow="<%= day[:percent] %>" aria-valuemin="0" aria-valuemax="100"></div>
                </div>
              </div>
            <% end %>
          </div>
        </div>
      <% end %>

    </div>

    <%# MAIN PANE: ARRIVALS AND TRANSACTIONS ─── %>
    <div class="lg:col-span-9 space-y-10">
      <% if @current_hotel.onboarding? %>
        <div class="rounded-2xl border border-dashed border-border-interactive bg-card py-12 pl-12 pr-20 mr-90 text-center">
          <div class="flex size-16 items-center justify-center rounded-full bg-muted text-muted-foreground mb-4 mx-auto">
            <%= cached_icon "bar-chart-2", class: "size-8 text-muted-foreground" %>
          </div>
          <h3 class="text-lg font-bold text-foreground">Your operational data will appear here</h3>
          <p class="mt-2 text-sm text-muted-foreground max-w-md mx-auto">Once your hotel is approved and goes live, you will see arrivals, bookings, and occupancy trends in this section.</p>
        </div>
      <% else %>
        <%# Arrivals Board %>
        <div class="self-start">
          <div class="flex flex-wrap items-center gap-x-4">
            <h3 class="text-xl font-bold tracking-tight text-foreground shrink-0">Arrival Board</h3>
            <% if @today_arrivals.any? %>
              <%= render PanelsUI::Tabs.new(id: "tabs-arrivals", active: "today", variant: :pill, class: "contents", panels_class: "w-full mt-2", aria_label: "Arrivals") do |tabs| %>
                <% tabs.with_tab(name: "today", label: "Today", count: @dashboard_presenter.today_arrivals_count, id: "tabs-arrivals-1", panel_id: "tabs-arrivals-panel-1") %>
                <% tabs.with_tab(name: "tomorrow", label: "Tomorrow", count: @tomorrow_arrivals.count, id: "tabs-arrivals-2", panel_id: "tabs-arrivals-panel-2") %>
                <% tabs.with_panel(name: "today", id: "tabs-arrivals-panel-1", tab_id: "tabs-arrivals-1") do %>
                <div class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-3 gap-4">
                  <% @today_arrivals.limit(6).each do |booking| %>
                    <% booking_presenter = HotelPortal::BookingPresenter.new(booking, @current_hotel) %>
                    <div class="flex flex-col gap-y-3 p-4 bg-card rounded-xl border border-border hover:border-border-interactive transition-colors cursor-pointer" onclick="Turbo.visit('<%= hotel_booking_workspace_path(@current_hotel, booking, tab: "booking_details") %>')">
                      <div class="flex items-center justify-between gap-x-3">
                        <div class="min-w-0">
                          <div class="flex items-center gap-x-1.5">
                            <p class="text-sm font-semibold text-foreground truncate"><%= booking_presenter.guest_name %></p>
                            <% if booking_presenter.vip? %>
                              <%= render PanelsUI::Tooltip.new(text: "VIP guest") do %>
                                <%= cached_icon "crown-simple", library: "phosphor", variant: "duotone", class: "size-4 text-amber-500 fill-amber-500 shrink-0" %>
                              <% end %>
                            <% end %>
                            <% if booking_presenter.blacklisted? %>
                              <%= render PanelsUI::Tooltip.new(text: "Blacklisted guest") do %>
                                <div class="relative size-4 flex items-center justify-center shrink-0">
                                  <%= cached_icon "user", library: "phosphor", variant: "light", class: "size-3.5 text-rose-600" %>
                                  <%= cached_icon "ban", class: "absolute inset-0 size-4 text-rose-600" %>
                                </div>
                              <% end %>
                            <% end %>
                            <% if booking_presenter.repeat? %>
                              <%= render PanelsUI::Tooltip.new(text: "Repeat guest") do %>
                                <%= cached_icon "repeat", library: "lucide", variant: "outline", class: "size-4 text-blue-500 shrink-0" %>
                              <% end %>
                            <% end %>
                          </div>
                          <p class="text-xs font-medium text-muted-foreground truncate"><%= booking_presenter.room_display_text %></p>
                        </div>
                        <%= link_to hotel_booking_workspace_path(@current_hotel, booking, tab: "booking_details"), class: "shrink-0 text-muted-foreground hover:text-foreground transition-colors" do %>
                          <%= cached_icon "chevron-right", class: "size-4" %>
                        <% end %>
                      </div>
                      <div class="flex items-center justify-between gap-x-2 text-xs text-muted-foreground">
                        <div class="flex items-center gap-x-2">
                          <span><%= booking_presenter.formatted_check_in_date %> – <%= booking_presenter.formatted_check_out_date %></span>
                          <span>·</span>
                          <span><%= pluralize(booking_presenter.nights_count, "night") %></span>
                        </div>
                        <span class="text-sm font-semibold tabular-nums text-foreground"><%= booking_presenter.formatted_total_amount_dashboard %></span>
                      </div>
                      <div class="flex items-center justify-between gap-x-2 rounded-lg bg-muted px-3 py-2 text-xs">
                        <div class="flex items-center gap-x-2 text-muted-foreground">
                          <%= render "hotel_portal/front_desk/booking_source_icon", source: booking.source %>
                          <%= render "hotel_portal/front_desk/occupancy", adults: booking.adults, children: booking.children %>
                        </div>
                        <span class="inline-flex items-center rounded px-1.5 py-0.5 text-[10px] font-bold uppercase tracking-widest ring-1 ring-inset <%= booking_presenter.pre_checkin_badge_class %>">
                          <%= booking_presenter.pre_checkin_badge_label %>
                        </span>
                      </div>
                    </div>
                  <% end %>
                </div>
              <% end %>

              <% tabs.with_panel(name: "tomorrow", id: "tabs-arrivals-panel-2", tab_id: "tabs-arrivals-2") do %>
              <% if @tomorrow_arrivals.any? %>
                <div class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-3 gap-4">
                  <% @tomorrow_arrivals.limit(6).each do |booking| %>
                    <% booking_presenter = HotelPortal::BookingPresenter.new(booking, @current_hotel) %>
                    <div class="flex flex-col gap-y-3 p-4 bg-card rounded-xl border border-border hover:border-border-interactive transition-colors cursor-pointer" onclick="Turbo.visit('<%= hotel_booking_workspace_path(@current_hotel, booking, tab: "booking_details") %>')">
                      <div class="flex items-center justify-between gap-x-3">
                        <div class="min-w-0">
                          <div class="flex items-center gap-x-1.5">
                            <p class="text-sm font-semibold text-foreground truncate"><%= booking_presenter.guest_name %></p>
                            <% if booking_presenter.vip? %>
                              <%= render PanelsUI::Tooltip.new(text: "VIP guest") do %>
                                <%= cached_icon "crown-simple", library: "phosphor", variant: "duotone", class: "size-4 text-amber-500 fill-amber-500 shrink-0" %>
                              <% end %>
                            <% end %>
                            <% if booking_presenter.blacklisted? %>
                              <%= render PanelsUI::Tooltip.new(text: "Blacklisted guest") do %>
                                <div class="relative size-4 flex items-center justify-center shrink-0">
                                  <%= cached_icon "user", library: "phosphor", variant: "light", class: "size-3.5 text-rose-600" %>
                                  <%= cached_icon "ban", class: "absolute inset-0 size-4 text-rose-600" %>
                                </div>
                              <% end %>
                            <% end %>
                            <% if booking_presenter.repeat? %>
                              <%= render PanelsUI::Tooltip.new(text: "Repeat guest") do %>
                                <%= cached_icon "repeat", library: "lucide", variant: "outline", class: "size-4 text-blue-500 shrink-0" %>
                              <% end %>
                            <% end %>
                          </div>
                          <p class="text-xs font-medium text-muted-foreground truncate"><%= booking_presenter.room_display_text %></p>
                        </div>
                        <%= link_to hotel_booking_workspace_path(@current_hotel, booking, tab: "booking_details"), class: "shrink-0 text-muted-foreground hover:text-foreground transition-colors" do %>
                          <%= cached_icon "chevron-right", class: "size-4" %>
                        <% end %>
                      </div>
                      <div class="flex items-center justify-between gap-x-2 text-xs text-muted-foreground">
                        <div class="flex items-center gap-x-2">
                          <span><%= booking_presenter.formatted_check_in_date %> – <%= booking_presenter.formatted_check_out_date %></span>
                          <span>·</span>
                          <span><%= pluralize(booking_presenter.nights_count, "night") %></span>
                        </div>
                        <span class="text-sm font-semibold tabular-nums text-foreground"><%= booking_presenter.formatted_total_amount_dashboard %></span>
                      </div>
                      <div class="flex items-center justify-between gap-x-2 rounded-lg bg-muted px-3 py-2 text-xs">
                        <div class="flex items-center gap-x-2 text-muted-foreground">
                          <%= render "hotel_portal/front_desk/booking_source_icon", source: booking.source %>
                          <%= render "hotel_portal/front_desk/occupancy", adults: booking.adults, children: booking.children %>
                        </div>
                        <span class="inline-flex items-center rounded px-1.5 py-0.5 text-[10px] font-bold uppercase tracking-widest ring-1 ring-inset <%= booking_presenter.pre_checkin_badge_class %>">
                          <%= booking_presenter.pre_checkin_badge_label %>
                        </span>
                      </div>
                    </div>
                  <% end %>
                </div>
              <% else %>
                <p class="text-sm font-medium italic text-muted-foreground py-4">No arrivals tomorrow.</p>
              <% end %>
            <% end %>
          <% end %>

          <% if @dashboard_presenter.today_arrivals_count > 6 || @tomorrow_arrivals.count > 6 %>
            <%= link_to hotel_front_desk_path(@current_hotel, tab: "arrivals", view: "rooms"), class: "mt-6 flex items-center justify-center gap-x-2 w-full rounded-lg bg-brand-primary py-3 text-sm font-bold text-primary-foreground shadow-sm transition hover:bg-brand-secondary" do %>
              Go to Front Desk Arrivals
              <%= cached_icon "arrow-right", class: "size-4" %>
            <% end %>
          <% end %>
          <% end %>
        </div>

        <%# Recent Bookings Table %>
        <div class="self-start pt-5">
          <div>
            <h3 class="text-xl font-bold tracking-tight text-foreground">Recent Bookings</h3>
          </div>

          <%# Desktop Table view %>
          <div class="mt-4 hidden lg:block rounded-2xl border border-border overflow-x-auto">
            <table class="min-w-full divide-y divide-border">
              <thead class="bg-muted">
                <tr>
                  <th class="px-8 py-4 text-left text-[11px] font-semibold uppercase tracking-[0.08em] text-muted-foreground">Reference</th>
                  <th class="px-8 py-4 text-left text-[11px] font-semibold uppercase tracking-[0.08em] text-muted-foreground">Guest</th>
                  <th class="px-8 py-4 text-left text-[11px] font-semibold uppercase tracking-[0.08em] text-muted-foreground">Dates</th>
                  <th class="px-8 py-4 text-left text-[11px] font-semibold uppercase tracking-[0.08em] text-muted-foreground">Booked on</th>
                  <th class="px-8 py-4 text-right text-[11px] font-semibold uppercase tracking-[0.08em] text-muted-foreground">Total</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-border bg-card">
                <% if @recent_bookings.any? %>
                  <% @recent_bookings.each do |booking| %>
                    <% booking_presenter = HotelPortal::BookingPresenter.new(booking, @current_hotel) %>
                    <tr class="group cursor-pointer <%= booking.blacklisted? ? 'bg-rose-100' : 'odd:bg-card even:bg-muted/60 hover:bg-muted/70 transition-colors' %>" onclick="Turbo.visit('<%= hotel_booking_workspace_path(@current_hotel, booking, tab: "booking_details") %>')">
                      <td class="whitespace-nowrap py-4 pr-8 <%= booking.blacklisted? ? 'border-l-4 border-l-rose-600 pl-7' : 'pl-8' %>">
                        <div class="flex items-center gap-x-2">
                          <%= render "hotel_portal/front_desk/booking_source_icon", source: booking.source %>
                          <span class="font-mono text-sm font-semibold text-foreground">#<%= booking_presenter.confirmation_token %></span>
                        </div>
                      </td>
                      <td class="whitespace-nowrap px-8 py-4">
                        <div class="flex items-center gap-x-1.5">
                          <span class="text-sm font-semibold text-foreground"><%= booking_presenter.guest_name %></span>
                          <% if booking_presenter.vip? %>
                            <%= render PanelsUI::Tooltip.new(text: "VIP guest") do %>
                              <%= cached_icon "crown-simple", library: "phosphor", variant: "duotone", class: "size-4 text-amber-500 fill-amber-500 shrink-0" %>
                            <% end %>
                          <% end %>
                          <% if booking_presenter.blacklisted? %>
                            <%= render PanelsUI::Tooltip.new(text: "Blacklisted guest") do %>
                              <div class="relative size-4 flex items-center justify-center shrink-0">
                                <%= cached_icon "user", library: "phosphor", variant: "light", class: "size-3.5 text-rose-600" %>
                                <%= cached_icon "ban", class: "absolute inset-0 size-4 text-rose-600" %>
                              </div>
                            <% end %>
                          <% end %>
                          <% if booking_presenter.repeat? %>
                            <%= render PanelsUI::Tooltip.new(text: "Repeat guest") do %>
                              <%= cached_icon "repeat", library: "lucide", variant: "outline", class: "size-4 text-blue-500 shrink-0" %>
                            <% end %>
                          <% end %>
                        </div>
                      </td>
                      <td class="whitespace-nowrap px-8 py-4">
                        <div class="inline-flex items-center gap-x-2 text-sm font-medium text-foreground">
                          <span><%= booking_presenter.formatted_check_in_date %></span>
                          <span class="text-muted-foreground">—</span>
                          <span><%= booking_presenter.formatted_check_out_date %></span>
                        </div>
                      </td>
                      <td class="whitespace-nowrap px-8 py-4">
                        <span class="text-sm font-medium text-muted-foreground"><%= booking_presenter.created_at_date %></span>
                      </td>
                      <td class="whitespace-nowrap px-8 py-4 text-right">
                        <span class="text-base font-semibold tabular-nums text-foreground"><%= booking_presenter.formatted_total_amount_dashboard %></span>
                      </td>
                    </tr>
                  <% end %>
                <% else %>
                  <tr>
                    <td colspan="5" class="px-8 py-8 text-center">
                      <p class="text-sm font-medium italic text-muted-foreground">No bookings found.</p>
                    </td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          </div>

          <%# Mobile Card view %>
          <div class="mt-4 block lg:hidden divide-y divide-border rounded-2xl border border-border">
            <% if @recent_bookings.any? %>
              <% @recent_bookings.each do |booking| %>
                <% booking_presenter = HotelPortal::BookingPresenter.new(booking, @current_hotel) %>
                <div class="p-6 space-y-4 cursor-pointer <%= booking.blacklisted? ? 'bg-rose-100 border-t-4 border-t-rose-600 pt-5' : '' %>" onclick="Turbo.visit('<%= hotel_booking_workspace_path(@current_hotel, booking, tab: "booking_details") %>')">
                  <div class="flex items-center justify-between">
                    <div class="flex items-center gap-x-2">
                      <span class="font-mono text-sm font-semibold text-foreground">#<%= booking_presenter.confirmation_token %></span>
                      <%= render "hotel_portal/front_desk/booking_source_icon", source: booking.source %>
                    </div>
                    <span class="text-xs font-medium text-muted-foreground">Booked on <%= booking_presenter.created_at_date %></span>
                  </div>

                  <div class="space-y-1">
                    <div class="flex items-center gap-x-1.5">
                      <span class="text-sm font-semibold text-foreground"><%= booking_presenter.guest_name %></span>
                      <% if booking_presenter.vip? %>
                        <%= render PanelsUI::Tooltip.new(text: "VIP guest") do %>
                          <%= cached_icon "crown-simple", library: "phosphor", variant: "duotone", class: "size-4 text-amber-500 fill-amber-500 shrink-0" %>
                        <% end %>
                      <% end %>
                      <% if booking_presenter.blacklisted? %>
                        <%= render PanelsUI::Tooltip.new(text: "Blacklisted guest") do %>
                          <div class="relative size-4 flex items-center justify-center shrink-0">
                            <%= cached_icon "user", library: "phosphor", variant: "light", class: "size-3.5 text-rose-600" %>
                            <%= cached_icon "ban", class: "absolute inset-0 size-4 text-rose-600" %>
                          </div>
                        <% end %>
                      <% end %>
                      <% if booking_presenter.repeat? %>
                        <%= render PanelsUI::Tooltip.new(text: "Repeat guest") do %>
                          <%= cached_icon "repeat", library: "lucide", variant: "outline", class: "size-4 text-blue-500 shrink-0" %>
                        <% end %>
                      <% end %>
                    </div>
                    <p class="text-xs text-muted-foreground">
                      <%= booking_presenter.formatted_check_in_date %> — <%= booking_presenter.formatted_check_out_date %>
                    </p>
                  </div>

                  <div class="flex items-center justify-end pt-3 border-t border-border">
                    <span class="text-base font-semibold tabular-nums text-foreground"><%= booking_presenter.formatted_total_amount_dashboard %></span>
                  </div>
                </div>
              <% end %>
            <% else %>
              <div class="p-8 text-center">
                <p class="text-sm font-medium italic text-muted-foreground">No bookings found.</p>
              </div>
            <% end %>
          </div>

          <%= link_to hotel_front_desk_path(@current_hotel, tab: "bookings", view: "rooms"), class: "mt-6 flex items-center justify-center gap-x-2 w-full rounded-lg bg-brand-primary py-3 text-sm font-bold text-primary-foreground shadow-sm transition hover:bg-brand-secondary" do %>
            Go to Front Desk Bookings
            <%= cached_icon "arrow-right", class: "size-4" %>
          <% end %>
        </div>
      <% end %>
    </div>
  </div>
</div>
