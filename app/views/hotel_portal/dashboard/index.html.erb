<div class="space-y-6 pb-12">
  <!-- Page Header -->
  <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-y-4">
    <div>
      <nav class="flex mb-2" aria-label="Breadcrumb">
        <ol class="flex items-center whitespace-nowrap min-w-0">
          <li class="flex items-center text-sm text-neutral-text-secondary">
            Hotel Admin
            <svg class="flex-shrink-0 mx-2 overflow-visible h-4 w-4 text-gray-400" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg>
          </li>
          <li class="text-sm font-semibold text-brand-primary truncate" aria-current="page">
            Dashboard
          </li>
        </ol>
      </nav>
      <h1 class="text-2xl font-bold text-neutral-text-primary"><%= @current_hotel.name %> Dashboard</h1>
    </div>

    <div class="inline-flex gap-x-2">
      <a class="btn btn-secondary" href="<%= help_center_path %>">
        <svg class="w-4 h-4 me-2" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
        Help Center
      </a>
    </div>
  </div>

  <!-- Quick Actions -->
  <div class="grid grid-cols-2 md:grid-cols-4 lg:grid-cols-6 gap-3">
    <a href="<%= hotel_arrivals_path(current_hotel) %>" class="card p-3 flex flex-col items-center justify-center text-center hover:bg-neutral-bg transition-colors group">
      <svg class="w-6 h-6 text-brand-primary mb-2 group-hover:scale-110 transition-transform" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
      <span class="text-xs font-semibold text-neutral-text-primary">Arrivals</span>
    </a>
    <a href="<%= hotel_bookings_path(current_hotel) %>" class="card p-3 flex flex-col items-center justify-center text-center hover:bg-neutral-bg transition-colors group">
      <svg class="w-6 h-6 text-brand-primary mb-2 group-hover:scale-110 transition-transform" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="18" x="3" y="4" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
      <span class="text-xs font-semibold text-neutral-text-primary">Bookings</span>
    </a>
    <a href="<%= hotel_inventory_index_path(current_hotel) %>" class="card p-3 flex flex-col items-center justify-center text-center hover:bg-neutral-bg transition-colors group">
      <svg class="w-6 h-6 text-brand-primary mb-2 group-hover:scale-110 transition-transform" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="18" x="3" y="4" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/><path d="M7 14h.01"/><path d="M12 14h.01"/><path d="M17 14h.01"/><path d="M7 18h.01"/><path d="M12 18h.01"/><path d="M17 18h.01"/></svg>
      <span class="text-xs font-semibold text-neutral-text-primary">Rates</span>
    </a>
    <a href="<%= hotel_room_types_path(current_hotel) %>" class="card p-3 flex flex-col items-center justify-center text-center hover:bg-neutral-bg transition-colors group">
      <svg class="w-6 h-6 text-brand-primary mb-2 group-hover:scale-110 transition-transform" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 20h20"/><path d="M7 20v-5a2 2 0 0 1 2-2h6a2 2 0 0 1 2 2v5"/><path d="M10 8V5a2 2 0 0 1 2-2h0a2 2 0 0 1 2 2v3"/><path d="M12 17v.01"/><path d="M10 13h4"/></svg>
      <span class="text-xs font-semibold text-neutral-text-primary">Rooms</span>
    </a>
    <a href="<%= hotel_reports_path(current_hotel) %>" class="card p-3 flex flex-col items-center justify-center text-center hover:bg-neutral-bg transition-colors group">
      <svg class="w-6 h-6 text-brand-primary mb-2 group-hover:scale-110 transition-transform" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 3v18h18"/><path d="m19 9-5 5-4-4-3 3"/></svg>
      <span class="text-xs font-semibold text-neutral-text-primary">Reports</span>
    </a>
    <a href="<%= hotel_settings_path(current_hotel) %>" class="card p-3 flex flex-col items-center justify-center text-center hover:bg-neutral-bg transition-colors group">
      <svg class="w-6 h-6 text-brand-primary mb-2 group-hover:scale-110 transition-transform" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12.22 2h-.44a2 2 0 0 0-2 2v.18a2 2 0 0 1-1 1.73l-.43.25a2 2 0 0 1-2 0l-.15-.08a2 2 0 0 0-2.73.73l-.22.38a2 2 0 0 0 .73 2.73l.15.1a2 2 0 0 1 1 1.72v.51a2 2 0 0 1-1 1.74l-.15.09a2 2 0 0 0-.73 2.73l.22.38a2 2 0 0 0 2.73.73l.15-.08a2 2 0 0 1 2 0l.43.25a2 2 0 0 1 1 1.73V20a2 2 0 0 0 2 2h.44a2 2 0 0 0 2-2v-.18a2 2 0 0 1 1-1.73l.43-.25a2 2 0 0 1 2 0l.15.08a2 2 0 0 0 2.73-.73l.22-.39a2 2 0 0 0-.73-2.73l-.15-.08a2 2 0 0 1-1-1.74v-.5a2 2 0 0 1 1-1.74l.15-.09a2 2 0 0 0 .73-2.73l-.22-.38a2 2 0 0 0-2.73-.73l-.15.08a2 2 0 0 1-2 0l-.43-.25a2 2 0 0 1-1-1.73V4a2 2 0 0 0-2-2z"/><circle cx="12" cy="12" r="3"/></svg>
      <span class="text-xs font-semibold text-neutral-text-primary">Settings</span>
    </a>
  </div>

  <div class="grid lg:grid-cols-3 gap-6">
    <!-- Arrivals Snapshot -->
    <div class="card lg:col-span-2 flex flex-col">
      <div class="p-4 md:p-5 border-b border-neutral-border flex justify-between items-center">
        <h2 class="text-lg font-bold text-neutral-text-primary">Arrival Board</h2>
        <a class="text-sm font-medium text-brand-primary hover:underline" href="<%= hotel_arrivals_path(current_hotel) %>">View board</a>
      </div>
      <div class="p-4 md:p-5">
        <div class="border-b border-neutral-border mb-4">
          <nav class="flex space-x-6" aria-label="Tabs" role="tablist">
            <button type="button" class="hs-tab-active:font-bold hs-tab-active:border-brand-primary hs-tab-active:text-brand-primary py-4 px-1 inline-flex items-center gap-x-2 border-b-2 border-transparent text-sm whitespace-nowrap text-neutral-text-secondary hover:text-brand-primary active" id="tabs-arrivals-1" data-hs-tab="#tabs-arrivals-panel-1" aria-controls="tabs-arrivals-panel-1" role="tab">
              Today <span class="badge badge-neutral ms-1"><%= @today_arrivals.count %></span>
            </button>
            <button type="button" class="hs-tab-active:font-bold hs-tab-active:border-brand-primary hs-tab-active:text-brand-primary py-4 px-1 inline-flex items-center gap-x-2 border-b-2 border-transparent text-sm whitespace-nowrap text-neutral-text-secondary hover:text-brand-primary" id="tabs-arrivals-2" data-hs-tab="#tabs-arrivals-panel-2" aria-controls="tabs-arrivals-panel-2" role="tab">
              Tomorrow <span class="badge badge-neutral ms-1"><%= @tomorrow_arrivals.count %></span>
            </button>
          </nav>
        </div>

        <div id="tabs-arrivals-panel-1" role="tabpanel" aria-labelledby="tabs-arrivals-1">
          <% if @today_arrivals.any? %>
            <ul class="divide-y divide-neutral-border">
              <% @today_arrivals.limit(5).each do |booking| %>
                <li class="py-3 flex items-center justify-between">
                  <div class="flex items-center gap-x-3">
                    <div class="w-8 h-8 rounded-full bg-neutral-bg flex items-center justify-center text-xs font-bold text-neutral-text-secondary">
                      <%= booking.guest_name[0] %>
                    </div>
                    <div>
                      <p class="text-sm font-medium text-neutral-text-primary"><%= booking.guest_name %></p>
                      <p class="text-xs text-neutral-text-secondary"><%= booking.booking_rooms.first.room_type.name %></p>
                    </div>
                  </div>
                  <div class="flex items-center gap-x-3">
                    <% precheckin = booking.pre_checkin %>
                    <% if precheckin&.completed? %>
                      <span class="badge badge-success">Pre-checked</span>
                    <% else %>
                      <span class="badge badge-warning">Pending</span>
                    <% end %>
                    <a href="<%= hotel_booking_path(current_hotel, booking) %>" class="text-neutral-text-secondary hover:text-brand-primary">
                      <svg class="w-4 h-4" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg>
                    </a>
                  </div>
                </li>
              <% end %>
              <% if @today_arrivals.count > 5 %>
                <li class="pt-3 text-center">
                  <a class="text-xs font-medium text-neutral-text-secondary hover:text-brand-primary" href="<%= hotel_arrivals_path(current_hotel, date: Date.today) %>">
                    + <%= @today_arrivals.count - 5 %> more arrivals today
                  </a>
                </li>
              <% end %>
            </ul>
          <% else %>
            <div class="text-center py-10">
              <p class="text-sm text-neutral-text-secondary">No arrivals today.</p>
            </div>
          <% end %>
        </div>

        <div id="tabs-arrivals-panel-2" class="hidden" role="tabpanel" aria-labelledby="tabs-arrivals-2">
          <% if @tomorrow_arrivals.any? %>
            <ul class="divide-y divide-neutral-border">
              <% @tomorrow_arrivals.limit(5).each do |booking| %>
                <li class="py-3 flex items-center justify-between">
                  <div class="flex items-center gap-x-3">
                    <div class="w-8 h-8 rounded-full bg-neutral-bg flex items-center justify-center text-xs font-bold text-neutral-text-secondary">
                      <%= booking.guest_name[0] %>
                    </div>
                    <div>
                      <p class="text-sm font-medium text-neutral-text-primary"><%= booking.guest_name %></p>
                      <p class="text-xs text-neutral-text-secondary"><%= booking.booking_rooms.first.room_type.name %></p>
                    </div>
                  </div>
                  <div class="flex items-center gap-x-3">
                    <a href="<%= hotel_booking_path(current_hotel, booking) %>" class="text-neutral-text-secondary hover:text-brand-primary">
                      <svg class="w-4 h-4" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg>
                    </a>
                  </div>
                </li>
              <% end %>
            <% else %>
              <div class="text-center py-10">
                <p class="text-sm text-neutral-text-secondary">No arrivals tomorrow.</p>
              </div>
            <% end %>
        </div>
      </div>
    </div>

  <!-- Right Column: Pending Actions & Occupancy -->
  <div class="space-y-6">
      <!-- Pending Actions -->
      <div class="card p-4 md:p-5">
        <h3 class="text-sm font-bold text-neutral-text-primary uppercase tracking-wider mb-4">Pending Actions</h3>
        <% if @pending_actions_count > 0 %>
          <div class="flex items-center gap-x-3">
            <span class="flex-shrink-0 inline-flex justify-center items-center w-10 h-10 rounded-lg bg-amber-50 text-status-warning border border-amber-100">
              <svg class="w-5 h-5" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
            </span>
            <div>
              <p class="text-sm font-semibold text-neutral-text-primary"><%= @pending_actions_count %> Pre-check-ins pending</p>
              <a href="<%= hotel_arrivals_path(current_hotel) %>" class="text-xs text-brand-primary font-medium hover:underline">Review arrivals</a>
            </div>
          </div>
        <% else %>
          <div class="flex items-center gap-x-3 text-status-success">
            <svg class="w-5 h-5" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
            <p class="text-sm font-medium">All arrivals are ready</p>
          </div>
        <% end %>
      </div>

      <!-- 7-day Occupancy -->
      <div class="card p-4 md:p-5">
        <h3 class="text-sm font-bold text-neutral-text-primary uppercase tracking-wider mb-4">7-Day Occupancy</h3>
        <div class="space-y-4">
          <% @occupancy_snapshot.each do |day| %>
            <div>
              <div class="flex justify-between items-center mb-1">
                <span class="text-xs font-medium text-neutral-text-secondary"><%= day[:date].strftime("%a, %b %d") %></span>
                <span class="text-xs font-bold text-neutral-text-primary">
                  <%= day[:percent] %>% (<%= day[:sold] %>/<%= day[:total] || 0 %>)
                </span>
              </div>
              <div class="flex w-full h-1.5 bg-gray-100 rounded-full overflow-hidden">
                <div class="flex flex-col justify-center overflow-hidden bg-brand-primary" role="progressbar" style="width: <%= day[:percent] %>%" aria-valuenow="<%= day[:percent] %>" aria-valuemin="0" aria-valuemax="100"></div>
              </div>
            </div>
          <% end %>
      </div>
    </div>
  </div>
  </div>

  <!-- Recent Bookings Table -->
  <div class="card overflow-hidden">
    <div class="p-4 md:p-5 border-b border-neutral-border flex justify-between items-center">
      <h2 class="text-lg font-bold text-neutral-text-primary">Recent Bookings</h2>
      <a class="text-sm font-medium text-brand-primary hover:underline" href="<%= hotel_bookings_path(current_hotel) %>">View all bookings</a>
    </div>
    <div class="hidden sm:block overflow-x-auto">
      <table class="table-container">
        <thead class="table-header">
          <tr>
            <th class="px-6 py-3">Ref #</th>
            <th class="px-6 py-3">Guest</th>
            <th class="px-6 py-3">Dates</th>
            <th class="px-6 py-3">Rooms</th>
            <th class="px-6 py-3 text-right">Total</th>
            <th class="px-6 py-3">Status</th>
            <th class="px-6 py-3"></th>
          </tr>
        </thead>
        <tbody class="divide-y divide-neutral-border">
          <% if @recent_bookings.any? %>
            <% @recent_bookings.each do |booking| %>
              <tr class="hover:bg-neutral-bg transition-colors">
                <td class="px-6 py-4 text-sm font-bold text-neutral-text-primary">#<%= booking.confirmation_token %></td>
                <td class="px-6 py-4 text-sm text-neutral-text-primary"><%= booking.guest_name %></td>
                <td class="px-6 py-4 text-sm text-neutral-text-secondary">
                  <%= booking.check_in.strftime("%b %d") %> - <%= booking.check_out.strftime("%b %d") %>
                </td>
                <td class="px-6 py-4 text-sm text-neutral-text-secondary">
                  <%= booking.booking_rooms.count %> <%= 'room'.pluralize(booking.booking_rooms.count) %>
                </td>
                <td class="px-6 py-4 text-sm font-medium text-neutral-text-primary text-right">RM <%= number_with_precision(booking.total_amount, precision: 2) %></td>
                <td class="px-6 py-4">
                  <% case booking.status %>
                  <% when 'confirmed' %>
                    <span class="badge badge-success">Confirmed</span>
                  <% when 'cancelled' %>
                    <span class="badge badge-error">Cancelled</span>
                  <% else %>
                    <span class="badge badge-neutral"><%= booking.status.capitalize %></span>
                  <% end %>
                </td>
                <td class="px-6 py-4 text-right">
                  <a href="<%= hotel_booking_path(current_hotel, booking) %>" class="text-brand-primary hover:text-red-700 font-medium text-sm">Details</a>
                </td>
              </tr>
            <% end %>
          <% else %>
            <tr>
              <td colspan="7" class="px-6 py-10 text-center text-sm text-neutral-text-secondary">
                No bookings found.
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
    <div class="sm:hidden space-y-3 p-4">
      <% if @recent_bookings.any? %>
        <% @recent_bookings.each do |booking| %>
          <div class="border border-neutral-border rounded-2xl p-4 bg-white shadow-sm">
            <div class="flex justify-between items-center">
              <p class="text-xs font-semibold text-neutral-text-secondary">#<%= booking.confirmation_token %></p>
              <span class="text-xs font-semibold text-neutral-text-primary"><%= booking.status.capitalize %></span>
            </div>
            <p class="text-base font-bold text-neutral-text-primary mt-2"><%= booking.guest_name %></p>
            <p class="text-xs text-neutral-text-secondary"><%= booking.guest_phone %></p>
            <div class="flex items-center justify-between mt-3 text-xs text-neutral-text-secondary">
              <span><%= booking.check_in.strftime("%b %d") %> → <%= booking.check_out.strftime("%b %d") %></span>
              <a class="text-brand-primary font-semibold" href="<%= hotel_booking_path(current_hotel, booking) %>">View</a>
            </div>
          </div>
        <% end %>
      <% else %>
        <p class="text-center text-sm text-neutral-text-secondary">No bookings found.</p>
      <% end %>
    </div>
  </div>
</div>
