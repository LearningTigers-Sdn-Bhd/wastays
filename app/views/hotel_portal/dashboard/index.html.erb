<% content_for :title, "#{@current_hotel.name} Dashboard | WAStays" %>

<% content_for :breadcrumbs do %>
  <nav class="flex items-center whitespace-nowrap min-w-0" aria-label="Breadcrumb">
    <ol class="flex items-center">
      <li class="flex items-center text-sm text-neutral-text-secondary">
        Hotel Admin
        <span class="mx-2 text-muted-foreground-2">/</span>
      </li>
      <li class="text-sm font-bold text-neutral-text-primary truncate" aria-current="page">
        Dashboard
      </li>
    </ol>
  </nav>
<% end %>


<div class="space-y-6">
  <div class="flex justify-between items-center">
    <div>
      <h2 class="text-xl font-bold text-neutral-text-primary tracking-tight"><%= @current_hotel.name %> Overview</h2>
      <p class="text-xs text-neutral-text-secondary mt-0.5 opacity-80">Welcome back to your property management portal</p>
    </div>
  </div>


  <% arrivals_body = capture do %>
    <div class="border-b border-neutral-border mb-4">
      <nav class="flex space-x-6" aria-label="Tabs" role="tablist">
        <button type="button" class="hs-tab-active:font-bold hs-tab-active:border-brand-primary hs-tab-active:text-brand-primary py-4 px-1 inline-flex items-center gap-x-2 border-b-2 border-transparent text-sm whitespace-nowrap text-neutral-text-secondary hover:text-brand-primary active" id="tabs-arrivals-1" data-hs-tab="#tabs-arrivals-panel-1" aria-controls="tabs-arrivals-panel-1" role="tab">
          Today <%= render "shared/dashboard/badge", tone: "neutral", label: @today_arrivals.count, class: "ms-1" %>
        </button>
        <button type="button" class="hs-tab-active:font-bold hs-tab-active:border-brand-primary hs-tab-active:text-brand-primary py-4 px-1 inline-flex items-center gap-x-2 border-b-2 border-transparent text-sm whitespace-nowrap text-neutral-text-secondary hover:text-brand-primary" id="tabs-arrivals-2" data-hs-tab="#tabs-arrivals-panel-2" aria-controls="tabs-arrivals-panel-2" role="tab">
          Tomorrow <%= render "shared/dashboard/badge", tone: "neutral", label: @tomorrow_arrivals.count, class: "ms-1" %>
        </button>
      </nav>
    </div>

    <div id="tabs-arrivals-panel-1" role="tabpanel" aria-labelledby="tabs-arrivals-1">
      <% if @today_arrivals.any? %>
        <ul class="divide-y divide-neutral-border">
          <% @today_arrivals.limit(5).each do |booking| %>
            <li class="py-3 flex items-center justify-between">
              <div class="flex items-center gap-x-3">
                <div class="w-8 h-8 rounded-full bg-neutral-bg flex items-center justify-center text-xs font-bold text-neutral-text-secondary">
                  <%= booking.guest_name[0] %>
                </div>
                <div>
                  <p class="text-sm font-medium text-neutral-text-primary"><%= booking.guest_name %></p>
                  <p class="text-xs text-neutral-text-secondary"><%= booking.booking_rooms.first.room_type.name %></p>
                </div>
              </div>
              <div class="flex items-center gap-x-3">
                <% precheckin = booking.pre_checkin %>
                <% if precheckin&.completed? %>
                  <%= render "shared/dashboard/badge", tone: "success", label: "Pre-checked" %>
                <% else %>
                  <%= render "shared/dashboard/badge", tone: "warning", label: "Pending" %>
                <% end %>
                <a href="<%= hotel_booking_path(current_hotel, booking) %>" class="text-neutral-text-secondary hover:text-brand-primary">
                  <svg class="w-4 h-4" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg>
                </a>
              </div>
            </li>
          <% end %>
          <% if @today_arrivals.count > 5 %>
            <li class="pt-3 text-center">
              <a class="text-xs font-medium text-neutral-text-secondary hover:text-brand-primary" href="<%= hotel_arrivals_path(current_hotel, date: Date.today) %>">
                + <%= @today_arrivals.count - 5 %> more arrivals today
              </a>
            </li>
          <% end %>
        </ul>
      <% else %>
        <%= render "shared/dashboard/empty_state", message: "No arrivals today." %>
      <% end %>
    </div>

    <div id="tabs-arrivals-panel-2" class="hidden" role="tabpanel" aria-labelledby="tabs-arrivals-2">
      <% if @tomorrow_arrivals.any? %>
        <ul class="divide-y divide-neutral-border">
          <% @tomorrow_arrivals.limit(5).each do |booking| %>
            <li class="py-3 flex items-center justify-between">
              <div class="flex items-center gap-x-3">
                <div class="w-8 h-8 rounded-full bg-neutral-bg flex items-center justify-center text-xs font-bold text-neutral-text-secondary">
                  <%= booking.guest_name[0] %>
                </div>
                <div>
                  <p class="text-sm font-medium text-neutral-text-primary"><%= booking.guest_name %></p>
                  <p class="text-xs text-neutral-text-secondary"><%= booking.booking_rooms.first.room_type.name %></p>
                </div>
              </div>
              <div class="flex items-center gap-x-3">
                <a href="<%= hotel_booking_path(current_hotel, booking) %>" class="text-neutral-text-secondary hover:text-brand-primary">
                  <svg class="w-4 h-4" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg>
                </a>
              </div>
            </li>
          <% end %>
        </ul>
      <% else %>
        <%= render "shared/dashboard/empty_state", message: "No arrivals tomorrow." %>
      <% end %>
    </div>
  <% end %>

  <% pending_actions_body = capture do %>
    <% if @pending_actions_count > 0 %>
      <div class="flex items-center gap-x-3">
        <span class="flex-shrink-0 inline-flex justify-center items-center w-10 h-10 rounded-lg bg-amber-50 text-status-warning border border-amber-100">
          <svg class="w-5 h-5" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
        </span>
        <div>
          <p class="text-sm font-semibold text-neutral-text-primary"><%= @pending_actions_count %> Pre-check-ins pending</p>
          <a href="<%= hotel_arrivals_path(current_hotel) %>" class="text-xs text-brand-primary font-medium hover:underline">Review arrivals</a>
        </div>
      </div>
    <% else %>
      <div class="flex items-center gap-x-3 text-status-success">
        <svg class="w-5 h-5" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
        <p class="text-sm font-medium">All arrivals are ready</p>
      </div>
    <% end %>
  <% end %>

  <% occupancy_body = capture do %>
    <div class="space-y-4">
      <% @occupancy_snapshot.each do |day| %>
        <div>
          <div class="flex justify-between items-center mb-1">
            <span class="text-xs font-medium text-neutral-text-secondary"><%= day[:date].strftime("%a, %b %d") %></span>
            <span class="text-xs font-bold text-neutral-text-primary">
              <%= day[:percent] %>% (<%= day[:sold] %>/<%= day[:total] || 0 %>)
            </span>
          </div>
          <div class="flex w-full h-1.5 bg-gray-100 rounded-full overflow-hidden">
            <div class="flex flex-col justify-center overflow-hidden bg-brand-primary" role="progressbar" style="width: <%= day[:percent] %>%" aria-valuenow="<%= day[:percent] %>" aria-valuemin="0" aria-valuemax="100"></div>
          </div>
        </div>
      <% end %>
    </div>
  <% end %>

  <% recent_bookings_body = capture do %>
    <table class="table-container">
      <thead class="table-header">
        <tr>
          <th class="px-6 py-3">Ref #</th>
          <th class="px-6 py-3">Guest</th>
          <th class="px-6 py-3">Dates</th>
          <th class="px-6 py-3">Rooms</th>
          <th class="px-6 py-3 text-right">Total</th>
          <th class="px-6 py-3">Status</th>
          <th class="px-6 py-3"></th>
        </tr>
      </thead>
      <tbody class="divide-y divide-neutral-border">
        <% if @recent_bookings.any? %>
          <% @recent_bookings.each do |booking| %>
            <tr class="hover:bg-neutral-bg transition-colors">
              <td class="px-6 py-4 text-sm font-bold text-neutral-text-primary">#<%= booking.confirmation_token %></td>
              <td class="px-6 py-4 text-sm text-neutral-text-primary"><%= booking.guest_name %></td>
              <td class="px-6 py-4 text-sm text-neutral-text-secondary">
                <%= booking.check_in.strftime("%b %d") %> - <%= booking.check_out.strftime("%b %d") %>
              </td>
              <td class="px-6 py-4 text-sm text-neutral-text-secondary">
                <%= booking.booking_rooms.count %> <%= 'room'.pluralize(booking.booking_rooms.count) %>
              </td>
              <td class="px-6 py-4 text-sm font-medium text-neutral-text-primary text-right">RM <%= number_with_precision(booking.total_amount, precision: 2) %></td>
              <td class="px-6 py-4">
                <% case booking.status %>
                <% when 'confirmed' %>
                  <%= render "shared/dashboard/badge", tone: "success", label: "Confirmed" %>
                <% when 'cancelled' %>
                  <%= render "shared/dashboard/badge", tone: "error", label: "Cancelled" %>
                <% else %>
                  <%= render "shared/dashboard/badge", tone: "neutral", label: booking.status.capitalize %>
                <% end %>
              </td>
              <td class="px-6 py-4 text-right">
                <a href="<%= hotel_booking_path(current_hotel, booking) %>" class="text-brand-primary hover:text-red-700 font-medium text-sm">Details</a>
              </td>
            </tr>
          <% end %>
        <% else %>
          <tr>
            <td colspan="7" class="px-6 py-10 text-center text-sm text-neutral-text-secondary">
              <%= render "shared/dashboard/empty_state", message: "No bookings found." %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% end %>

  <div class="grid lg:grid-cols-3 gap-6">
    <%= render "shared/dashboard/panel",
      title: "Arrival Board",
      action: link_to("View board", hotel_arrivals_path(current_hotel), class: "text-sm font-medium text-brand-primary hover:underline"),
      panel_classes: "lg:col-span-2 flex flex-col",
      body: arrivals_body %>

    <%= render "shared/dashboard/panel",
      title: "Pending Actions",
      body: pending_actions_body %>

    <%= render "shared/dashboard/panel",
      title: "7-Day Occupancy",
      body: occupancy_body %>

    <%= render "shared/dashboard/panel",
      title: "Recent Bookings",
      action: link_to("View all bookings", hotel_bookings_path(current_hotel), class: "text-sm font-medium text-brand-primary hover:underline"),
      panel_classes: "overflow-hidden lg:col-span-3",
      body_classes: "hidden sm:block overflow-x-auto",
      body: recent_bookings_body %>
  </div>

  <div class="sm:hidden space-y-3 p-4">
    <% if @recent_bookings.any? %>
      <% @recent_bookings.each do |booking| %>
        <div class="border border-neutral-border rounded-2xl p-4 bg-white shadow-sm">
          <div class="flex justify-between items-center">
            <p class="text-xs font-semibold text-neutral-text-secondary">#<%= booking.confirmation_token %></p>
            <%= render "shared/dashboard/badge", tone: booking.status == 'confirmed' ? "success" : (booking.status == 'cancelled' ? "error" : "neutral"), label: booking.status.capitalize %>
          </div>
          <p class="text-base font-bold text-neutral-text-primary mt-2"><%= booking.guest_name %></p>
          <p class="text-xs text-neutral-text-secondary"><%= booking.guest_phone %></p>
          <div class="flex items-center justify-between mt-3 text-xs text-neutral-text-secondary">
            <span><%= booking.check_in.strftime("%b %d") %> → <%= booking.check_out.strftime("%b %d") %></span>
            <a class="text-brand-primary font-semibold" href="<%= hotel_booking_path(current_hotel, booking) %>">View</a>
          </div>
        <% end %>
        <% else %>
        <%= render "shared/dashboard/empty_state", message: "No bookings found." %>
        <% end %>
        </div>
        </div>
