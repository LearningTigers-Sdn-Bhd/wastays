<% persisted = @room_block.persisted? %>
<div data-controller="ui--unsaved-changes ui--sheet-frame">
  <%= render PanelsUI::Sheet.new(
        id: "stay-view-room-block-sheet",
        side: :right,
        size: :lg,
        title: persisted ? "Edit room block" : "Block room",
        description: "#{@room_block.room_type.name} · Room #{@room_block.room_number}",
        body_class: "p-0") do |sheet| %>
    <% sheet.with_body do %>
      <div class="flex h-full min-h-0 flex-col">
        <%= form_with model: @room_block, url: persisted ? hotel_stay_view_room_block_path(current_hotel, @room_block) : hotel_stay_view_room_blocks_path(current_hotel), method: persisted ? :patch : :post, class: "flex min-h-0 flex-1 flex-col", data: { turbo_stream: true, "ui--unsaved-changes-target": "form" } do |form| %>
          <%= render "hotel_portal/stay_view/state_fields", state: stay_view_state, return_to: @return_to %>
          <%= form.hidden_field :room_type_id %>
          <%= form.hidden_field :room_number %>
          <div class="min-h-0 flex-1 space-y-5 overflow-y-auto p-6">
            <%= render "hotel_portal/stay_view/errors", record: @room_block, title: "The room block could not be saved." %>
            <div class="grid gap-4 sm:grid-cols-2">
              <%= render PanelsUI::FormField.new(form:, attribute: :start_date, label: "Start date", required: true) do |field| %>
                <% field.with_date_picker(value: @room_block.start_date, linked_to: :end_date) %>
              <% end %>
              <%= render PanelsUI::FormField.new(form:, attribute: :end_date, label: "End date", required: true) do |field| %>
                <% field.with_date_picker(value: @room_block.end_date, min: @room_block.start_date) %>
              <% end %>
            </div>
            <%= render PanelsUI::FormField.new(form:, attribute: :block_type, label: "Block type", required: true) do |field| %>
              <% block_type_options = RoomBlock::BLOCK_TYPES.map { |type| { label: type.humanize, value: type } } %>
              <% if persisted && @room_block.block_type.present? && !RoomBlock::BLOCK_TYPES.include?(@room_block.block_type) %>
                <% block_type_options << { label: "#{@room_block.block_type.humanize} (existing)", value: @room_block.block_type } %>
              <% end %>
              <% field.with_select_menu(block_type_options, selected: @room_block.block_type) %>
            <% end %>
            <%= render PanelsUI::FormField.new(form:, attribute: :reason, label: "Reason", required: true) do |field| %>
              <% field.with_text_area(rows: 4) %>
            <% end %>
            <%= render PanelsUI::FormField.new(form:, attribute: :notes, label: "Internal notes") do |field| %>
              <% field.with_text_area(rows: 3) %>
            <% end %>
          </div>
          <div class="flex justify-end gap-2 border-t border-border p-4">
            <%= render PanelsUI::Button.new(as: :button, type: :button, variant: :ghost, data: { action: "ui--sheet#close" }) do %>Cancel<% end %>
            <%= render PanelsUI::Button.new(as: :button, type: :submit, data: { turbo_submits_with: "Saving…" }) do %><%= persisted ? "Save block" : "Block room" %><% end %>
          </div>
        <% end %>
        <% if persisted %>
          <% block_active_today = @room_block.active_on?(current_hotel.business_date_for) %>
          <div class="border-t border-border px-4 py-3" data-controller="stay-view--room-block-return">
            <div class="flex items-center justify-between gap-3" data-stay-view--room-block-return-target="prompt">
              <% if block_active_today %>
                <%= render PanelsUI::Button.new(as: :button, type: :button, variant: :secondary, size: :sm, class: "gap-1.5", data: { action: "stay-view--room-block-return#reveal" }) do %>
                  <%= cached_icon "circle-check", class: "size-4" %>Return to service
                <% end %>
              <% else %>
                <%= form_with url: finish_hotel_stay_view_room_block_path(current_hotel, @room_block), method: :post, data: { turbo_stream: true } do %>
                  <%= render "hotel_portal/stay_view/state_fields", state: stay_view_state, return_to: @return_to %>
                  <%= render PanelsUI::Button.new(as: :button, type: :submit, variant: :secondary, size: :sm, class: "gap-1.5", data: { turbo_submits_with: "Returning…" }) do %>
                    <%= cached_icon "circle-check", class: "size-4" %>Return to service
                  <% end %>
                <% end %>
              <% end %>
              <%= form_with url: hotel_stay_view_room_block_path(current_hotel, @room_block), method: :delete, data: { turbo_stream: true, turbo_confirm: "Delete this block? It disappears from the room's history." } do %>
                <%= render "hotel_portal/stay_view/state_fields", state: stay_view_state, return_to: @return_to %>
                <%= render PanelsUI::Button.new(as: :button, type: :submit, variant: :ghost, size: :sm, class: "text-muted-foreground", data: { turbo_submits_with: "Deleting…" }) do %>Delete block<% end %>
              <% end %>
            </div>
            <% if block_active_today %>
              <div class="space-y-3" hidden
                   data-stay-view--room-block-return-target="choice"
                   data-ui--unsaved-changes-target="step">
                <p class="text-sm text-foreground">
                  Room <%= @room_block.room_number %> is back in service. What state is it in?
                </p>
                <div class="flex gap-2">
                  <% [ { status: "dirty", variant: :warning, icon: Rooms::StatusPresentation.icon(:dirty), label: Rooms::StatusPresentation.label(:dirty), hint: "Needs cleaning first" },
                       { status: "ready", variant: :success, icon: Rooms::StatusPresentation.icon(:ready), label: Rooms::StatusPresentation.label(:ready), hint: "Can be sold now" } ].each do |choice| %>
                    <%= form_with url: finish_hotel_stay_view_room_block_path(current_hotel, @room_block), method: :post, class: "flex-1", data: { turbo_stream: true } do %>
                      <%= render "hotel_portal/stay_view/state_fields", state: stay_view_state, return_to: @return_to %>
                      <%= hidden_field_tag :room_status, choice[:status] %>
                      <%= render PanelsUI::Button.new(as: :button, type: :submit, variant: choice[:variant], size: :sm, class: "h-auto w-full flex-col items-start gap-0.5 py-2", data: { turbo_submits_with: "Returning…" }) do %>
                        <span class="flex items-center gap-1.5 font-medium"><%= cached_icon choice[:icon], class: "size-4" %><%= choice[:label] %></span>
                        <span class="text-xs font-normal opacity-80"><%= choice[:hint] %></span>
                      <% end %>
                    <% end %>
                  <% end %>
                </div>
                <%= render PanelsUI::Button.new(as: :button, type: :button, variant: :ghost, size: :sm, class: "text-muted-foreground", data: { action: "stay-view--room-block-return#cancel" }) do %>Cancel<% end %>
              </div>
            <% end %>
          </div>
        <% end %>
      </div>

      <%= render PanelsUI::AlertDialog.new(
            id: "stay-view-room-block-discard-alert",
            title: "Discard your progress?",
            description: "Closing this sheet now loses the progress you have not saved.",
            tone: :warning,
            data: { "ui--unsaved-changes-target": "alert" }) do |alert| %>
        <% alert.with_icon { cached_icon "triangle-alert", class: "size-5" } %>
        <% alert.with_cancel(label: "Keep editing", data: { action: "ui--unsaved-changes#keepEditing" }) %>
        <% alert.with_action(label: "Discard changes", data: { action: "ui--unsaved-changes#discardChanges" }) %>
      <% end %>
    <% end %>
  <% end %>
</div>
