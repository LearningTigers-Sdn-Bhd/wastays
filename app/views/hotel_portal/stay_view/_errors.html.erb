<% if record.errors.any? %>
  <div class="rounded-md border border-destructive bg-destructive/10 p-3 text-sm text-destructive" role="alert" aria-live="polite">
    <p class="font-medium"><%= title %></p>
    <ul class="mt-2 list-disc space-y-1 pl-5">
      <% record.errors.full_messages.each do |message| %><li><%= message %></li><% end %>
    </ul>
  </div>
<% end %>
