<div class="max-h-[65dvh] space-y-6 overflow-y-auto overflow-x-hidden pr-1" data-testid="stay-view-room-cards">
  <% if state.grouped_rooms? %>
    <% board.room_groups.each do |room_group| %>
      <% next if room_group.rooms.empty? %>
      <section class="space-y-3">
        <div class="flex items-center gap-3">
          <h3 class="shrink-0 text-sm font-semibold text-foreground"><%= room_group.name %></h3>
          <hr class="flex-1 border-border">
        </div>

        <div class="grid gap-4 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-6">
          <% room_group.rooms.each do |room| %>
            <%= render "hotel_portal/stay_view/board/room_card", room:, state:, heading_level: :h4 %>
          <% end %>
        </div>
      </section>
    <% end %>
  <% else %>
    <div class="grid gap-4 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-6">
      <% board.room_groups.flat_map(&:rooms).each do |room| %>
        <%= render "hotel_portal/stay_view/board/room_card", room:, state:, heading_level: :h3 %>
      <% end %>
    </div>
  <% end %>
</div>
