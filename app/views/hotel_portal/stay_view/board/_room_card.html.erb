<% bookings = room.booking_segments %>
<% financial_signals = bookings.flat_map(&:financial_signals) %>
<%= render PanelsUI::Card.new(as: :article, width: :full, density: :compact, variant: :outlined, id: room.dom_id, class: "h-full min-h-44", aria: { label: "Room #{room.room_number}, #{room.room_type_name}" }) do |card| %>
  <% card.with_header(actions_layout: :wrap, id: "#{room.dom_id}-header") do |header| %>
    <% header.with_actions do %>
      <%= render HotelPortal::StayView::RoomSummary.new(room:, state:, actions: stay_view_room_menu_actions(room, state), show_identity: false, class: "h-auto w-full p-0") %>
    <% end %>
  <% end %>

  <% card.with_card_content(class: "flex flex-col gap-3") do %>
    <div class="flex items-start justify-between gap-2">
      <div class="flex min-w-0 flex-col">
        <%= tag.public_send(heading_level, room.room_number, id: "#{room.dom_id}-title", class: "truncate text-sm font-semibold leading-5 text-foreground") %>
        <p class="truncate text-[0.6875rem] leading-4 text-muted-foreground"><%= room.room_type_name %></p>
      </div>
      <div class="flex shrink-0 flex-col items-start">
        <%= render HotelPortal::StayView::OperationalStatusBadge.new(
          room:,
          status: stay_view_room_operational_status(room, state),
          reference_date: state.date_window.start_date
        ) %>
      </div>
    </div>

    <% if bookings.any? %>
      <hr class="border-border">
      <div class="space-y-3">
        <% bookings.each do |segment| %>
          <div class="space-y-1">
            <p class="truncate text-xs font-medium text-foreground"><%= segment.guest_label %></p>
            <% if segment.group_reference.present? %>
              <p class="truncate text-[0.6875rem] leading-4 text-muted-foreground"><%= [ segment.group_name, segment.group_reference ].compact_blank.join(" · ") %></p>
            <% end %>
            <p class="text-[0.6875rem] leading-4 text-muted-foreground"><%= segment.check_in.to_fs(:medium) %> – <%= segment.check_out.to_fs(:medium) %></p>
            <% if segment.source_label.present? %>
              <p class="text-[0.6875rem] leading-4 text-muted-foreground">Source: <%= segment.source_label %></p>
            <% end %>
          </div>
        <% end %>
      </div>
    <% end %>

    <% if financial_signals.any? %>
      <div class="mt-auto flex flex-wrap items-center gap-2">
        <% financial_signals.each do |signal| %>
          <%= render PanelsUI::Badge.new(
            label: signal.label,
            variant: stay_view_financial_badge_variant(signal),
            size: :sm,
            class: "max-w-full whitespace-normal break-words text-left",
            data: { slot: "stay-view-financial-signal" }
          ) %>
        <% end %>
      </div>
    <% end %>
  <% end %>
<% end %>
