<% content_for :title, "Stay View" %>

<div class="space-y-6">
  <header class="flex flex-col gap-4 lg:flex-row lg:items-start lg:justify-between">
    <div class="min-w-0">
      <h1 class="text-base font-semibold tracking-tight text-foreground">Stay View</h1>
      <p class="mt-1 text-sm text-muted-foreground">Plan stays and manage room operations from one shared view.</p>
    </div>

    <% if @board.capabilities.create_booking? %>
      <div class="flex flex-wrap gap-2">
        <%= render PanelsUI::Button.new(
          href: hotel_booking_transaction_walk_in_check_in_path(current_hotel, return_to: @stay_view_state.return_path(current_hotel)),
          variant: :secondary,
          size: :sm,
          data: stay_view_action_data
        ) do %>
          <%= app_icon "footprints", class: "size-4", aria: { hidden: true } %>
          Walk-in
        <% end %>
        <%= render PanelsUI::Button.new(
          href: hotel_booking_transaction_new_booking_path(current_hotel, return_to: @stay_view_state.return_path(current_hotel)),
          size: :sm,
          data: stay_view_action_data
        ) do %>
          <%= app_icon "plus", class: "size-4", aria: { hidden: true } %>
          Add booking
        <% end %>
      </div>
    <% end %>
  </header>

  <%= render "board", board: @board, state: @stay_view_state %>
</div>
