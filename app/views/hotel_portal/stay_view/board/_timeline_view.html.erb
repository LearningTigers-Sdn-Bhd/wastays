<div class="space-y-3">
  <p class="text-xs text-muted-foreground">Booking bars run from the middle of check-in day to the middle of checkout day. Hatched bars mark room blocks.</p>

  <%= render PanelsUI::Timeline::Table.new(
    caption: "Room stays from #{state.date_window.start_date.to_fs(:long)} to #{(state.date_window.end_date - 1.day).to_fs(:long)}",
    track_count: state.date_window.days * 2,
    density: state.density,
    id: "stay-view-timeline",
    data: {
      controller: "stay-view--interaction stay-view--viewport",
      "stay-view--interaction-long-press-value": 350,
      "stay-view--interaction-drag-threshold-value": 6,
      "stay-view--interaction-touch-tolerance-value": 8,
      "stay-view--interaction-drawer-id-value": "offcanvas_drawer",
      "stay-view--viewport-state-key-value": state.query.to_query
    }
  ) do |timeline| %>
    <% timeline.with_header(
      room_label: "Room",
      dates: state.date_window.dates.map do |date|
        {
          label: l(date, format: "%a"),
          metadata: l(date, format: "%-d %b"),
          accessible_label: l(date, format: :long),
          current: date == state.date_window.operational_date
        }
      end
    ) %>

    <% board.room_groups.each do |room_group| %>
      <% timeline.with_group(label: room_group.name, count: room_group.rooms.size) do |group| %>
        <% room_group.inventory_summaries.each do |summary| %>
          <% group.with_summary do %>
            <%= render HotelPortal::StayView::RoomTypeDateSummary.new(
              summary:,
              room_type_name: room_group.name,
              view_rates: board.capabilities.view_rates?
            ) %>
          <% end %>
        <% end %>

        <% room_group.rooms.each do |room| %>
          <% group.with_custom_row(component: HotelPortal::StayView::TimelineRow.new(room:, state:)) %>
        <% end %>
      <% end %>
    <% end %>

    <% timeline.with_footer do |footer| %>
      <% available_row = footer.with_row(label: "Available inventory") %>
      <% board.footer_summaries.each do |summary| %>
        <% available_row.with_summary do %>
          <%= render HotelPortal::StayView::TimelineFooterMetric.new(summary:, metric: :available) %>
        <% end %>
      <% end %>

      <% occupancy_row = footer.with_row(label: "Occupancy") %>
      <% board.footer_summaries.each do |summary| %>
        <% occupancy_row.with_summary do %>
          <%= render HotelPortal::StayView::TimelineFooterMetric.new(summary:, metric: :occupancy) %>
        <% end %>
      <% end %>
    <% end %>
  <% end %>
</div>
