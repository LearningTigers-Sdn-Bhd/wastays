<div class="space-y-4 rounded-lg border border-border bg-card p-4">
  <%= form_with url: hotel_stay_view_path(current_hotel), method: :get,
        class: "space-y-4",
        data: {
          controller: "stay-view--filters",
          action: "change->stay-view--filters#submit turbo:submit-start->stay-view--filters#start turbo:submit-end->stay-view--filters#finish",
          turbo_frame: "stay_view_board",
          turbo_action: "advance"
        } do |form| %>
    <%= hidden_field_tag :view, board.view_mode %>

    <div class="flex flex-col gap-3 lg:flex-row lg:items-center lg:justify-between">
      <%= render PanelsUI::Tabs.new(id: "stay-view-modes", active: board.view_mode, variant: :pill, aria_label: "Stay View mode") do |tabs| %>
        <% tabs.with_tab(
          name: "timeline",
          label: "Timeline",
          icon: "timeline",
          href: stay_view_path_for(state, view: :timeline, start_date: state.date_window.start_date, days: (state.date_window.days == 1 ? 14 : state.date_window.days), date: nil)
        ) %>
        <% tabs.with_tab(
          name: "rooms",
          label: "Rooms",
          icon: "bed-double",
          href: stay_view_path_for(state, view: :rooms, date: state.date_window.start_date, start_date: nil, days: nil)
        ) %>
      <% end %>

      <div class="flex flex-wrap items-center justify-end gap-2" aria-label="Date navigation">
        <% previous_date = state.date_window.previous.start_date %>
        <% next_date = state.date_window.next.start_date %>
        <% date_key = board.view_mode == :rooms ? :date : :start_date %>
        <%= render PanelsUI::Button.new(href: stay_view_path_for(state, date_key => previous_date), variant: :ghost, size: :icon_sm, aria_label: "Previous date range") do %>
          <%= app_icon "chevron-left", class: "size-4", aria: { hidden: true } %>
        <% end %>
        <% if board.view_mode == :rooms %>
          <%= render PanelsUI::FormField.new(form:, attribute: :date, label: "Date", label_hidden: true, size: :sm, class: "w-40") do |field| %>
            <% field.with_date_picker(value: state.date_window.start_date.iso8601) %>
          <% end %>
        <% else %>
          <%= render PanelsUI::FormField.new(form:, attribute: :start_date, label: "Start date", label_hidden: true, size: :sm, class: "w-40") do |field| %>
            <% field.with_date_picker(value: state.date_window.start_date.iso8601) %>
          <% end %>
          <%= render PanelsUI::FormField.new(form:, attribute: :days, label: "Range", label_hidden: true, size: :sm, class: "w-32") do |field| %>
            <% field.with_select_menu(
              StayView::DateWindow::ALLOWED_DAYS.map { |days| { label: "#{days} days", value: days } },
              selected: state.date_window.days
            ) %>
          <% end %>
        <% end %>
        <%= render PanelsUI::Button.new(href: stay_view_path_for(state, date_key => next_date), variant: :ghost, size: :icon_sm, aria_label: "Next date range") do %>
          <%= app_icon "chevron-right", class: "size-4", aria: { hidden: true } %>
        <% end %>
        <%= render PanelsUI::Button.new(href: stay_view_path_for(state, date_key => state.date_window.operational_date), variant: :secondary, size: :sm) do %>
          Today
        <% end %>
      </div>
    </div>

    <div class="grid gap-3 sm:grid-cols-2 xl:grid-cols-5">
      <%= render PanelsUI::FormField.new(form:, attribute: :room_type_id, label: "Room type", size: :sm) do |field| %>
        <% field.with_select_menu(
          [ { label: "All room types", value: "" } ] + board.room_type_options.map { |option| { label: option.name, value: option.id } },
          selected: board.filters.room_type_id
        ) %>
      <% end %>
      <%= render PanelsUI::FormField.new(form:, attribute: :booking_status, label: "Booking status", size: :sm) do |field| %>
        <% field.with_select_menu(
          [ { label: "All booking statuses", value: "" } ] + Booking::OCCUPYING_STATUSES.map { |status| { label: status.humanize, value: status } },
          selected: board.filters.booking_status
        ) %>
      <% end %>
      <%= render PanelsUI::FormField.new(form:, attribute: :occupancy, label: "Occupancy", size: :sm) do |field| %>
        <% field.with_select_menu(
          [ { label: "All occupancy states", value: "" } ] + HotelPortal::StayViewHelper::OCCUPANCY_LABELS.map { |value, label| { label:, value: } },
          selected: board.filters.occupancy
        ) %>
      <% end %>
      <%= render PanelsUI::FormField.new(form:, attribute: :physical_status, label: "Physical status", size: :sm) do |field| %>
        <% field.with_select_menu(
          [ { label: "All physical statuses", value: "" } ] + (RoomStatus::STATUSES - [ "late_checkout_detected" ]).map { |status| { label: status.humanize, value: status } },
          selected: board.filters.physical_status
        ) %>
      <% end %>
      <div class="flex items-end">
        <%= render PanelsUI::Button.new(href: stay_view_path_for(state, room_type_id: nil, booking_status: nil, occupancy: nil, physical_status: nil), variant: :ghost, size: :sm) do %>Clear<% end %>
        <noscript><button type="submit" class="panel-button" data-variant="primary" data-size="sm">Apply filters</button></noscript>
      </div>
    </div>
  <% end %>

  <div class="flex flex-wrap gap-x-4 gap-y-2 text-xs text-muted-foreground" aria-label="Stay View summary">
    <span><strong class="font-medium text-foreground"><%= board.status_counts.rooms %></strong> rooms</span>
    <% board.status_counts.occupancies.each do |status, count| %>
      <span><strong class="font-medium text-foreground"><%= count %></strong> <%= status.to_s.humanize.downcase %></span>
    <% end %>
  </div>
</div>
