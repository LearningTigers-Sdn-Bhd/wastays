<div id="stay_view_toolbar" class="overflow-hidden rounded-lg border border-border bg-card">
  <%= form_with url: hotel_stay_view_path(current_hotel), method: :get,
        class: "space-y-3 p-2",
        data: {
          controller: "stay-view--filters",
          action: "change->stay-view--filters#submit turbo:submit-start->stay-view--filters#start turbo:submit-end->stay-view--filters#finish",
          turbo_frame: "stay_view_board",
          turbo_action: "advance"
        } do |form| %>
    <%= hidden_field_tag :view, board.view_mode %>
    <%# Timeline hosts the room-type filter in its sticky room column header, so it only needs the value preserved here. Room View has no such header, so it gets a visible selector below. %>
    <% unless board.view_mode == :rooms %>
      <%= hidden_field_tag :room_type_id, board.filters.room_type_id %>
    <% end %>

    <div class="flex flex-col gap-3 lg:flex-row lg:items-center lg:justify-between">
      <div class="flex flex-wrap items-end gap-2">
        <% if board.view_mode == :rooms %>
          <%= render PanelsUI::FormField.new(form:, attribute: :room_type_id, label: "Room type", size: :sm, class: "w-44") do |field| %>
            <% field.with_select_menu(
              [ { label: "All room types", value: "" } ] + board.room_type_options.map { |option| { label: option.name, value: option.id } },
              selected: board.filters.room_type_id
            ) %>
          <% end %>
          <%= render PanelsUI::FormField.new(form:, attribute: :group_by, label: "Grouping", size: :sm, class: "w-40") do |field| %>
            <% field.with_select_menu(
              [ { label: "By room type", value: "room_type" }, { label: "Ungrouped", value: "none" } ],
              selected: state.room_grouping
            ) %>
          <% end %>
        <% end %>
        <%= render PanelsUI::FormField.new(form:, attribute: :booking_status, label: "Booking status", size: :sm, class: "w-44") do |field| %>
          <% field.with_select_menu(
            [ { label: "All booking statuses", value: "" } ] + Booking::OCCUPYING_STATUSES.map { |status| { label: status.humanize, value: status } },
            selected: board.filters.booking_status
          ) %>
        <% end %>
        <% if board.view_mode == :rooms %>
          <%= render PanelsUI::FormField.new(form:, attribute: :room_state, label: "Room state", size: :sm, class: "w-44") do |field| %>
            <% field.with_select_menu(
              [ { label: "All room states", value: "" } ] + StayView::ROOM_CARD_STATES.map { |value| { label: value.to_s.humanize, value: } },
              selected: board.filters.room_state
            ) %>
          <% end %>
        <% else %>
          <%= render PanelsUI::FormField.new(form:, attribute: :occupancy, label: "Occupancy", size: :sm, class: "w-44") do |field| %>
            <% field.with_select_menu(
              [ { label: "All occupancy states", value: "" } ] + HotelPortal::StayViewHelper::OCCUPANCY_LABELS.map { |value, label| { label:, value: } },
              selected: board.filters.occupancy
            ) %>
          <% end %>
        <% end %>
        <%= render PanelsUI::FormField.new(form:, attribute: :physical_status, label: "Physical status", size: :sm, class: "w-44") do |field| %>
          <% field.with_select_menu(
            [ { label: "All physical statuses", value: "" } ] + (RoomStatus::STATUSES - [ "late_checkout_detected" ]).map { |status| { label: status.humanize, value: status } },
            selected: board.filters.physical_status
          ) %>
        <% end %>
        <div class="flex items-center pb-0.5">
          <%= render PanelsUI::Button.new(href: stay_view_path_for(state, room_type_id: nil, booking_status: nil, occupancy: nil, physical_status: nil, room_state: nil), variant: :ghost, size: :sm) do %>Clear<% end %>
          <noscript><button type="submit" class="panel-button" data-variant="primary" data-size="sm">Apply filters</button></noscript>
        </div>
      </div>

      <div class="flex flex-wrap items-center gap-2 lg:justify-end" aria-label="Date navigation">
        <% previous_date = state.date_window.previous.start_date %>
        <% next_date = state.date_window.next.start_date %>
        <% date_key = board.view_mode == :rooms ? :date : :start_date %>
        <%= render PanelsUI::Button.new(href: stay_view_path_for(state, date_key => previous_date), variant: :ghost, size: :icon_sm, aria_label: "Previous date range") do %>
          <%= app_icon "chevron-left", class: "size-4", aria: { hidden: true } %>
        <% end %>
        <% if board.view_mode == :rooms %>
          <%= render PanelsUI::FormField.new(form:, attribute: :date, label: "Date", label_hidden: true, size: :sm, class: "w-40") do |field| %>
            <% field.with_date_picker(value: state.date_window.start_date.iso8601) %>
          <% end %>
        <% else %>
          <%= render PanelsUI::FormField.new(form:, attribute: :start_date, label: "Start date", label_hidden: true, size: :sm, class: "w-40") do |field| %>
            <% field.with_date_picker(value: state.date_window.start_date.iso8601) %>
          <% end %>
          <%= render PanelsUI::FormField.new(form:, attribute: :days, label: "Range", label_hidden: true, size: :sm, class: "w-32") do |field| %>
            <% field.with_select_menu(
              StayView::DateWindow::ALLOWED_DAYS.map { |days| { label: "#{days} days", value: days } },
              selected: state.date_window.days
            ) %>
          <% end %>
        <% end %>
        <%= render PanelsUI::Button.new(href: stay_view_path_for(state, date_key => next_date), variant: :ghost, size: :icon_sm, aria_label: "Next date range") do %>
          <%= app_icon "chevron-right", class: "size-4", aria: { hidden: true } %>
        <% end %>
        <%= render PanelsUI::Button.new(href: stay_view_path_for(state, date_key => state.date_window.operational_date), variant: :secondary, size: :sm) do %>
          Today
        <% end %>
        <%= render HotelPortal::StayView::StatusGuide.new(view_financial_status: board.capabilities.view_financial_status?) %>
      </div>
    </div>
  <% end %>

  <div class="flex flex-wrap items-center justify-between gap-2 border-t border-border p-2">
    <%= render HotelPortal::StayView::OperationalCounts.new(counts: board.status_counts) %>
    <% if board.capabilities.create_booking? %>
      <div class="flex flex-wrap items-center gap-2" data-slot="stay-view-global-actions">
        <%= render PanelsUI::Button.new(
          href: hotel_booking_transaction_walk_in_check_in_path(current_hotel, return_to: state.return_path(current_hotel)),
          variant: :secondary,
          size: :sm,
          data: stay_view_action_data
        ) do %>
          <%= app_icon "footprints", class: "size-4", aria: { hidden: true } %>
          Walk-in
        <% end %>
        <%= render PanelsUI::Button.new(
          href: hotel_booking_transaction_new_booking_path(current_hotel, return_to: state.return_path(current_hotel)),
          size: :sm,
          data: stay_view_action_data
        ) do %>
          <%= app_icon "plus", class: "size-4", aria: { hidden: true } %>
          Add booking
        <% end %>
      </div>
    <% end %>
  </div>
</div>
