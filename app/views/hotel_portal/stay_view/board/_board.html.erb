<%= turbo_frame_tag "stay_view_board", data: { turbo_action: "advance" } do %>
  <section class="space-y-4" aria-labelledby="stay-view-workspace-title">
    <h2 id="stay-view-workspace-title" class="sr-only">Stay View workspace</h2>
    <%= render "hotel_portal/stay_view/board/toolbar", board:, state: %>

    <% if board.empty? %>
      <div class="rounded-lg border border-border bg-card p-6 text-center">
        <%= app_icon "bed-double", class: "mx-auto size-6 text-muted-foreground", aria: { hidden: true } %>
        <h3 class="mt-3 text-base font-semibold text-foreground">No rooms to show</h3>
        <p class="mt-1 text-sm text-muted-foreground">Clear the filters or configure room numbers before using Stay View.</p>
        <% if board.filters.to_h.compact.any? %>
          <div class="mt-4">
            <%= render PanelsUI::Button.new(href: stay_view_path_for(state, room_type_id: nil, booking_status: nil, occupancy: nil, physical_status: nil), variant: :secondary, size: :sm) do %>
              Clear filters
            <% end %>
          </div>
        <% end %>
      </div>
    <% elsif board.view_mode == :rooms %>
      <%= render "hotel_portal/stay_view/board/room_view", board:, state: %>
    <% else %>
      <%= render "hotel_portal/stay_view/board/timeline_view", board:, state: %>
    <% end %>
  </section>
<% end %>
