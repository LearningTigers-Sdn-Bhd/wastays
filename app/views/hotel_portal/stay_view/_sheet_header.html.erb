<header class="flex items-start justify-between gap-4 border-b border-border px-6 py-5">
  <div class="min-w-0">
    <h1 class="text-base font-semibold text-foreground"><%= title %></h1>
    <% if local_assigns[:subtitle].present? %><p class="mt-1 truncate text-sm text-muted-foreground"><%= subtitle %></p><% end %>
  </div>
  <%= render PanelsUI::Button.new(as: :button, type: :button, variant: :ghost, size: :icon_sm, aria_label: "Close", data: { action: "click->offcanvas#close" }) do %>
    <%= app_icon "x", class: "size-4", aria: { hidden: true } %>
  <% end %>
</header>
