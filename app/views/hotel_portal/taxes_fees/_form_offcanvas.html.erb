<%= turbo_frame_tag "offcanvas_drawer", data: { offcanvas_variant: "fullscreen-bottom" } do %>
  <% persisted = hotel_tax.persisted? %>
  <div class="flex h-full min-h-0 flex-col bg-slate-100">
    <header class="z-10 shrink-0 border-b border-slate-200 bg-white">
      <div class="mx-auto flex max-w-[1100px] items-start justify-between gap-4 px-4 py-4 sm:px-6">
        <div class="min-w-0">
          <p class="text-[10px] font-bold uppercase tracking-[0.2em] text-slate-400">Taxes &amp; Fees</p>
          <h2 class="mt-0.5 text-lg font-bold tracking-tight text-slate-950"><%= title %></h2>
          <p class="mt-1 text-xs font-medium text-slate-500">Configure custom levies and service fees that appear as invoice line items.</p>
        </div>
        <button type="button" class="rounded-md p-1.5 text-slate-400 transition hover:bg-slate-100 hover:text-slate-700" data-action="click->offcanvas#close" aria-label="Close fee form">
          <%= cached_icon "x", stroke_width: 2.5, class: "size-5" %>
        </button>
      </div>
    </header>

    <%= form_with model: [ current_hotel, hotel_tax ],
                  method: persisted ? :patch : :post,
                  class: "flex min-h-0 flex-1 flex-col",
                  data: { turbo_frame: "_top" } do |f| %>
      <div class="min-h-0 flex-1 overflow-y-auto">
        <div class="mx-auto max-w-[1100px] space-y-5 p-4 sm:p-6">
          <% if hotel_tax.errors.any? %>
            <div class="rounded-xl border border-red-200 bg-red-50 px-4 py-3 text-sm font-semibold text-red-800" data-controller="auto-scroll-top">
              <%= hotel_tax.errors.full_messages.to_sentence %>
            </div>
          <% end %>

          <div class="grid gap-5 md:grid-cols-2">
            <div class="md:col-span-2">
              <%= f.label :name, "Name", class: "mb-1.5 block text-sm font-semibold text-slate-900" %>
              <%= f.text_field :name,
                  placeholder: "e.g. Heritage Fee",
                  class: "w-full rounded-xl border border-slate-200 px-4 py-3 text-sm text-slate-700 focus:border-slate-400 focus:outline-none focus:ring-0" %>
            </div>

            <div>
              <%= f.label :rate_type, "Type", class: "mb-1.5 block text-sm font-semibold text-slate-900" %>
              <%= f.select :rate_type,
                  [["Fixed RM", "flat"], ["Percentage", "percentage"]],
                  {},
                  class: "w-full rounded-xl border border-slate-200 px-4 py-3 text-sm text-slate-700 focus:border-slate-400 focus:outline-none focus:ring-0" %>
            </div>

            <div>
              <%= f.label :amount, "Amount", class: "mb-1.5 block text-sm font-semibold text-slate-900" %>
              <%= f.number_field :amount,
                  step: 0.01,
                  min: 0,
                  placeholder: "e.g. 10.00",
                  class: "w-full rounded-xl border border-slate-200 px-4 py-3 text-sm text-slate-700 focus:border-slate-400 focus:outline-none focus:ring-0" %>
            </div>

            <div>
              <span class="mb-2 block text-sm font-semibold text-slate-900">Status</span>
              <%= render "hotel_portal/taxes_fees/status_toggle",
                         form: f,
                         field: :enabled,
                         checked: hotel_tax.enabled?,
                         label: "Enabled" %>
            </div>

            <div>
              <span class="mb-2 block text-sm font-semibold text-slate-900">Rule</span>
              <%= render "hotel_portal/taxes_fees/status_toggle",
                         form: f,
                         field: :foreign_guests_only,
                         checked: hotel_tax.foreign_guests_only?,
                         label: "Foreign guests only" %>
            </div>
          </div>
        </div>
      </div>

      <footer class="z-10 shrink-0 border-t border-slate-200 bg-white px-4 py-3 shadow-[0_-4px_12px_rgba(15,23,42,0.06)] sm:px-6">
        <div class="mx-auto flex max-w-[1100px] items-center justify-end gap-2">
          <button type="button" class="rounded-md px-4 py-2 text-sm font-semibold text-slate-600 transition hover:bg-slate-100" data-action="click->offcanvas#close">Cancel</button>
          <%= f.submit submit_label, class: "cursor-pointer rounded-md bg-slate-900 px-5 py-2 text-sm font-bold text-white transition hover:bg-slate-700", data: { turbo_submits_with: "Saving..." } %>
        </div>
      </footer>
    <% end %>
  </div>
<% end %>
