<% content_for :breadcrumbs do %>
  <div class="flex items-center gap-x-2">
    <span class="text-sm font-medium text-slate-600"><%= current_hotel.name %></span>
    <span class="text-sm text-slate-400">/</span>
    <span class="text-sm font-semibold text-slate-900">Hotel FAQ</span>
  </div>
<% end %>

<div class="max-w-[1600px] mx-auto pb-20 space-y-8">
  <%= form_with model: @hotel, url: hotel_faq_path(@hotel), method: :patch, local: true, id: "hotel-faq-form", data: { controller: "hotel-faq", hotel_faq_initial_value: @hotel.faq.to_json } do |f| %>
    <div class="px-4 md:px-0">
      <div class="mt-5 flex flex-col gap-5 sm:flex-row sm:items-end sm:justify-between">
        <div>
          <h1 class="text-2xl font-bold tracking-tight text-slate-950 sm:text-3xl">Hotel FAQ</h1>
          <p class="mt-1 max-w-2xl text-sm font-medium leading-6 text-slate-600">Curate a clear library of guest questions and answers, grouped by theme so your team can keep responses consistent.</p>
        </div>

        <div class="flex items-center gap-3">
          <button type="button"
                  data-action="click->hotel-faq#addSection"
                  class="inline-flex items-center justify-center gap-2 rounded-xl border border-slate-200 bg-white px-4 py-2.5 text-sm font-semibold text-slate-700 shadow-sm transition hover:border-slate-300 hover:bg-slate-50">
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="M12 5v14"/></svg>
            Add Section
          </button>
        </div>
      </div>
    </div>

    <div class="px-4 md:px-0">
      <div class="bg-slate-50/30 py-4 sm:py-6 lg:py-8">
        <%= f.hidden_field :faq, data: { hotel_faq_target: "hiddenInput" } %>

        <div data-hotel-faq-target="container" class="space-y-4">
        </div>
      </div>
    </div>
  <% end %>
</div>
