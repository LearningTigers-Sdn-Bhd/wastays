<%= form_with model: attraction,
              scope: :attraction,
              url: preview_hotel_nearby_attractions_path(@hotel),
              id: "nearby-attraction-form",
              data: { turbo_frame: "nearby_attraction_form" } do |form| %>
  <%= render PanelsUI::FieldGroup.new do %>
    <%= render PanelsUI::FormField.new(
          form: form,
          attribute: :google_maps_url,
          label: "Google Maps URL",
          hint: "Open the place in Google Maps and copy the full URL from your browser address bar.",
          required: true) do |field| %>
      <% field.with_input(
           type: :url,
           placeholder: "https://www.google.com/maps/place/...",
           autocomplete: "url") %>
    <% end %>
  <% end %>
<% end %>
