<%= turbo_frame_tag "nearby_attraction_form" do %>
  <div data-controller="panels-ui--sheet-frame">
    <%= render PanelsUI::Sheet.new(
          id: "nearby-attraction-sheet",
          side: :right,
          size: :md,
          title: "Add Nearby Attraction",
          description: "Add a place with its full Google Maps browser URL.") do |sheet| %>
      <% sheet.with_body do %>
        <%= render "form", attraction: attraction %>
      <% end %>
      <% sheet.with_footer do %>
        <%= render PanelsUI::Button.new(
              as: :button,
              type: :button,
              variant: :secondary,
              size: :sm,
              data: { action: "click->panels-ui--sheet#close" }) do %>
          Cancel
        <% end %>
        <%= render PanelsUI::Button.new(
              as: :button,
              type: :submit,
              form: "nearby-attraction-form",
              variant: :primary,
              size: :sm) do %>
          Find attraction
        <% end %>
      <% end %>
    <% end %>
  </div>
<% end %>
