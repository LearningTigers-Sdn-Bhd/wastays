<div class="max-w-2xl mx-auto py-10 px-4 sm:px-6 lg:px-8">
  <div class="mb-5">
    <%= link_to hotel_nearby_attractions_path, class: "inline-flex items-center gap-x-1.5 text-sm text-gray-600 hover:text-blue-600" do %>
      <svg class="flex-shrink-0 size-4" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg>
      Back to Nearby Attractions
    <% end %>
  </div>

  <div class="bg-white border border-gray-200 rounded-xl shadow-sm p-4 sm:p-7">
    <div class="mb-8 text-center">
      <h2 class="text-2xl font-bold text-gray-800">Add Nearby Attraction</h2>
      <p class="text-sm text-gray-600">Highlight popular places guests can visit around your hotel.</p>
    </div>

    <%= render "form", nearby_attraction: @nearby_attraction %>
  </div>
</div>
