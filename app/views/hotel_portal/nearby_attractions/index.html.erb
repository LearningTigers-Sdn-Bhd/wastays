<div class="w-full space-y-6">
  <%= render "hotel_portal/settings/property_page_header" %>
  <%= render "hotel_portal/settings/group_tabs" %>

  <section aria-labelledby="nearby-attractions-heading">
    <div class="flex flex-col gap-4 sm:flex-row sm:items-start sm:justify-between">
      <div>
        <h2 id="nearby-attractions-heading" class="text-base font-semibold text-foreground">Nearby Attractions</h2>
        <p class="mt-2 text-sm text-muted-foreground">Recommend local places to your guests and manage your guest descriptions.</p>
      </div>
      <%= render PanelsUI::Button.new(
            href: new_hotel_nearby_attraction_path(@hotel),
            size: :sm,
            class: "w-full sm:w-auto",
            data: { turbo_frame: "nearby_attraction_form" }) do %>
        <%= app_icon "plus", class: "size-4", aria: { hidden: "true" } %>
        <span>Add attraction</span>
      <% end %>
    </div>

    <div class="mt-8 space-y-8">
      <%= render "suggestions" %>
      <div>
        <div>
          <h3 class="text-sm font-semibold text-foreground">Added to your hotel</h3>
          <p class="mt-1 text-sm text-muted-foreground">These attractions can appear in guest recommendations.</p>
        </div>
        <%= render "list" %>
      </div>
    </div>
  </section>
</div>

<% content_for :body_end do %>
  <%= turbo_frame_tag "nearby_attraction_form" %>
<% end %>
