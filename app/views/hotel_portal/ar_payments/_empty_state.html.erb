<div class="py-12 text-center">
  <span class="mx-auto inline-flex size-11 items-center justify-center rounded-full bg-muted text-muted-foreground">
    <%= cached_icon "landmark", class: "size-5" %>
  </span>
  <p class="mt-3 text-sm font-bold text-foreground">No payment records found</p>
  <p class="mt-1 text-xs text-muted-foreground"><%= presenter.filters_active? ? "Try changing or clearing the current filters." : "Recorded corporate payments and agent submissions will appear here." %></p>
  <% if presenter.filters_active? %>
    <%= link_to "Reset Filters", hotel_ar_payments_path(current_hotel), class: "mt-4 inline-flex rounded-lg border border-border bg-card px-3 py-1.5 text-xs font-black text-foreground shadow-sm", data: { turbo_frame: "_top" } %>
  <% end %>
</div>
