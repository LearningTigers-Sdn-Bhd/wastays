<%= render PanelsUI::PageHeader.new(title: "Payment Record", description: "Track corporate payments and agent submissions, and reconcile them against invoice allocations.") do |header| %>
  <% if current_user.has_permission?("manage_ar_payments", hotel: current_hotel) %>
    <% header.with_actions do %>
      <%= render PanelsUI::Button.new(as: :a, href: new_hotel_ar_payment_path(current_hotel), variant: :primary, size: :md, class: "w-full lg:w-auto") do %>
        <%= cached_icon "circle-dollar-sign", class: "size-4", aria: { hidden: true } %>
        Record Received Payment
      <% end %>
    <% end %>
  <% end %>
<% end %>
