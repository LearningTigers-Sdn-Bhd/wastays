<div class="border-b border-border pb-5">
  <%= render PanelsUI::PageHeader.new(title: presenter.reference) do |header| %>
    <% header.with_caption do %>
      <%= presenter.company_name %>
    <% end %>
    <% header.with_actions do %>
      <%= render PanelsUI::Button.new(as: :a, href: hotel_ar_payments_path(current_hotel), variant: :secondary, size: :sm, class: "w-full lg:w-auto") do %>
        <%= cached_icon "arrow-left", class: "size-3.5", aria: { hidden: true } %>
        Payment ledger
      <% end %>
      <% if presenter.can_void? %>
        <%= render PanelsUI::Button.new(type: :button, variant: :destructive, size: :sm, class: "w-full lg:w-auto", onclick: "document.getElementById('void-payment').showModal()") do %>
          Void payment
        <% end %>
      <% end %>
    <% end %>
  <% end %>
  <div class="mt-1 flex flex-wrap items-center gap-3">
    <span class="inline-flex rounded-md border px-2 py-1 text-[10px] font-black uppercase tracking-wider <%= presenter.status_class %>"><%= presenter.status_label %></span>
  </div>
</div>
<% if presenter.voided? %>
  <div class="mt-4 rounded-xl border border-border bg-muted px-4 py-3 text-sm" data-testid="payment-voided-notice">
    <p class="font-bold text-foreground">Voided by <%= presenter.voided_by %> on <%= presenter.voided_at %></p>
    <p class="mt-1 text-muted-foreground">Reason: <%= presenter.void_reason %></p>
  </div>
<% elsif presenter.void_blocked_hint %>
  <p class="mt-3 text-xs font-semibold text-muted-foreground" data-testid="void-blocked-hint"><%= presenter.void_blocked_hint %></p>
<% end %>
<% if presenter.can_void? %>
  <dialog id="void-payment" class="fixed inset-0 m-auto w-[min(92vw,30rem)] rounded-2xl border border-border p-0 shadow-2xl backdrop:bg-primary/50" onclick="if(event.target===this){this.close()}">
    <%= form_with url: hotel_ar_payment_void_path(current_hotel, presenter.payment), method: :post, class: "p-6 text-left" do %>
      <h3 class="text-lg font-bold text-foreground">Void this payment?</h3>
      <p class="mt-2 text-sm text-muted-foreground"><%= presenter.reference %> · <%= presenter.amount_label %>. The receipt will be voided. This cannot be undone.</p>
      <%= text_area_tag :reason, nil, required: true, rows: 3, placeholder: "Reason for voiding", class: "mt-4 w-full rounded-xl border border-border px-3 py-2 text-sm" %>
      <div class="mt-4 flex justify-end gap-2"><button type="button" class="rounded-lg px-3 py-2 text-sm font-bold text-muted-foreground" onclick="this.closest('dialog').close()">Cancel</button><%= submit_tag "Void payment", class: "rounded-lg bg-red-600 px-4 py-2 text-sm font-bold text-primary-foreground" %></div>
    <% end %>
  </dialog>
<% end %>
