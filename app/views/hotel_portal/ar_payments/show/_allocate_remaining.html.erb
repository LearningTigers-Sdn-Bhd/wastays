<section class="overflow-hidden rounded-xl border border-slate-200 bg-white shadow-sm" data-controller="ar-payment-form">
  <header class="flex flex-col gap-2 border-b border-slate-200 bg-slate-50/60 px-4 py-3 sm:flex-row sm:items-center sm:justify-between sm:px-5">
    <div>
      <h2 class="inline-flex items-center gap-2 text-xs font-bold uppercase tracking-wider text-slate-700">
        <span class="inline-flex size-6 items-center justify-center rounded bg-amber-50 text-amber-700">
          <%= cached_icon "hand-coins", class: "size-3.5", aria: { hidden: true } %>
        </span>
        Open invoices
      </h2>
      <p class="mt-1 text-[11px] font-medium text-slate-500">Apply this receipt to eligible invoices for the same account and currency.</p>
    </div>
    <div class="rounded-lg border border-amber-200 bg-amber-50 px-3 py-2 text-right">
      <p class="text-[9px] font-bold uppercase tracking-wider text-amber-700">Available to allocate</p>
      <p class="mt-0.5 text-sm font-black tabular-nums text-amber-950"><%= presenter.unapplied_amount_label %></p>
    </div>
  </header>
  <%= form_with url: hotel_ar_payment_allocations_path(current_hotel, presenter.payment), method: :post do %>
    <div class="overflow-x-auto">
      <table class="min-w-[850px] w-full text-left text-sm">
        <thead class="border-b border-slate-200 bg-slate-50 text-[10px] font-bold uppercase tracking-wider text-slate-500"><tr><th class="px-4 py-3">Invoice</th><th class="px-4 py-3">Source</th><th class="px-4 py-3">Due</th><th class="px-4 py-3 text-right">Outstanding</th><th class="px-4 py-3">Allocate</th></tr></thead>
        <tbody class="divide-y divide-slate-100">
          <% presenter.eligible_invoices.each do |invoice| %>
            <tr><td class="px-4 py-3 font-bold">AR-<%= invoice.invoice_number %></td><td class="px-4 py-3 text-slate-600"><%= invoice.booking.confirmation_token %> · <%= invoice.booking_folio.folio_reference_display %></td><td class="px-4 py-3 text-slate-600"><%= invoice.due_on.strftime("%d %b %Y") %></td><td class="px-4 py-3 text-right font-bold"><%= invoice.currency %> <%= number_with_precision(invoice.outstanding_amount, precision: 2) %></td><td class="px-4 py-3"><%= number_field_tag "allocations[#{invoice.id}]", nil, step: "0.01", min: "0", max: [ invoice.outstanding_amount, presenter.unapplied_amount_value ].min, class: "w-full rounded-lg border border-slate-200 px-3 py-2 text-sm" %></td></tr>
          <% end %>
        </tbody>
      </table>
    </div>
    <div class="flex justify-end border-t border-slate-200 p-4"><%= submit_tag "Allocate Balance", class: "rounded-xl bg-slate-900 px-5 py-2.5 text-sm font-bold text-white" %></div>
  <% end %>
</section>
