<section class="overflow-hidden rounded-xl border border-border bg-card shadow-sm" data-testid="allocation-history">
  <header class="flex items-center justify-between border-b border-border bg-muted/60 px-4 py-3 sm:px-5">
    <h2 class="inline-flex items-center gap-2 text-xs font-bold uppercase tracking-wider text-foreground">
      <span class="inline-flex size-6 items-center justify-center rounded bg-emerald-50 text-emerald-700">
        <%= cached_icon "rows-3", class: "size-3.5", aria: { hidden: true } %>
      </span>
      Allocation ledger
    </h2>
    <span class="text-[10px] font-bold uppercase tracking-wider text-muted-foreground"><%= pluralize(presenter.allocation_rows.size, "entry") %></span>
  </header>
  <% if presenter.allocation_rows.any? %>
    <div class="hidden overflow-x-auto md:block">
      <table class="min-w-[900px] w-full text-left text-sm">
        <thead class="border-b border-border bg-muted text-[10px] font-bold uppercase tracking-wider text-muted-foreground"><tr><th class="px-4 py-3">Invoice</th><th class="px-4 py-3">Allocated</th><th class="px-4 py-3">Recorded</th><th class="px-4 py-3">Status / Reversal</th><th class="px-4 py-3 text-right">Action</th></tr></thead>
        <tbody class="divide-y divide-border">
          <% presenter.allocation_rows.each do |row| %>
            <tr class="<%= "bg-muted text-muted-foreground" if row.reversed %>">
              <td class="px-4 py-3"><%= link_to row.invoice_label, row.invoice_path, class: "font-bold text-foreground hover:underline" %></td>
              <td class="px-4 py-3 font-bold tabular-nums <%= "line-through" if row.reversed %>"><%= row.allocated_amount %></td>
              <td class="px-4 py-3 text-xs"><%= row.allocated_at %></td>
              <td class="px-4 py-3">
                <% if row.reversed %>
                  <p class="font-bold text-red-700">Reversed</p>
                  <p class="mt-1 text-xs"><%= row.reversal_reason %> · <%= row.reversed_by %> · <%= row.reversed_at %></p>
                <% else %>
                  <span class="font-bold text-emerald-700">Active</span>
                <% end %>
              </td>
              <td class="px-4 py-3 text-right">
                <% if presenter.can_manage? && !row.reversed %>
                  <button type="button" class="rounded-lg border border-red-200 bg-card px-3 py-1.5 text-xs font-bold text-red-700" onclick="document.getElementById('reverse-allocation-<%= row.allocation.id %>').showModal()">Reverse</button>
                  <dialog id="reverse-allocation-<%= row.allocation.id %>" class="fixed inset-0 m-auto w-[min(92vw,30rem)] rounded-2xl border border-border p-0 shadow-2xl backdrop:bg-primary/50" onclick="if(event.target===this){this.close()}">
                    <%= form_with url: hotel_ar_payment_allocation_reversal_path(current_hotel, presenter.payment, row.allocation), method: :post, class: "p-6 text-left" do %>
                      <h3 class="text-lg font-bold text-foreground">Reverse allocation</h3>
                      <p class="mt-2 text-sm text-muted-foreground">This restores <%= row.allocated_amount %> to <%= row.invoice_label %> and returns it to the payment's unapplied balance.</p>
                      <%= text_area_tag :reason, nil, required: true, rows: 3, placeholder: "Reason for reversal", class: "mt-4 w-full rounded-xl border border-border px-3 py-2 text-sm" %>
                      <div class="mt-4 flex justify-end gap-2"><button type="button" class="rounded-lg px-3 py-2 text-sm font-bold text-muted-foreground" onclick="this.closest('dialog').close()">Cancel</button><%= submit_tag "Reverse Allocation", class: "rounded-lg bg-red-600 px-4 py-2 text-sm font-bold text-primary-foreground" %></div>
                    <% end %>
                  </dialog>
                <% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
    <div class="divide-y divide-border md:hidden">
      <% presenter.allocation_rows.each do |row| %>
        <article class="p-4 <%= "bg-muted" if row.reversed %>">
          <div class="flex items-start justify-between gap-3">
            <div>
              <p class="text-[10px] font-bold uppercase tracking-wider text-muted-foreground">Invoice</p>
              <%= link_to row.invoice_label, row.invoice_path, class: "mt-1 inline-flex text-sm font-black text-foreground hover:underline" %>
            </div>
            <div class="text-right">
              <p class="text-[10px] font-bold uppercase tracking-wider text-muted-foreground">Allocated</p>
              <p class="mt-1 text-sm font-black tabular-nums text-foreground <%= "line-through text-muted-foreground" if row.reversed %>"><%= row.allocated_amount %></p>
            </div>
          </div>
          <div class="mt-3 flex items-start justify-between gap-3 border-t border-border pt-3">
            <div>
              <p class="text-[10px] font-bold uppercase tracking-wider text-muted-foreground">Recorded</p>
              <p class="mt-1 text-xs font-semibold text-muted-foreground"><%= row.allocated_at %></p>
              <% if row.reversed %>
                <p class="mt-2 text-xs font-bold text-red-700">Reversed</p>
                <p class="mt-0.5 text-xs leading-5 text-muted-foreground"><%= row.reversal_reason %> · <%= row.reversed_by %> · <%= row.reversed_at %></p>
              <% else %>
                <p class="mt-2 text-xs font-bold text-emerald-700">Active allocation</p>
              <% end %>
            </div>
            <% if presenter.can_manage? && !row.reversed %>
              <button type="button" class="shrink-0 rounded-lg border border-red-200 bg-card px-3 py-1.5 text-xs font-bold text-red-700" onclick="document.getElementById('reverse-allocation-<%= row.allocation.id %>').showModal()">Reverse</button>
            <% end %>
          </div>
        </article>
      <% end %>
    </div>
  <% else %>
    <div class="px-6 py-12 text-center"><p class="text-sm font-semibold text-foreground">No allocations yet</p><p class="mt-1 text-xs text-muted-foreground">This payment is currently fully unapplied.</p></div>
  <% end %>
</section>
