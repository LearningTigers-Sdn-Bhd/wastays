<div class="mx-auto max-w-5xl space-y-6 pb-20">
  <div class="flex flex-col gap-4 sm:flex-row sm:items-start sm:justify-between">
    <div>
      <p class="text-xs font-bold uppercase tracking-[0.2em] text-slate-400">Accounts Receivable</p>
      <h1 class="mt-1 text-3xl font-bold tracking-tight text-slate-950">Record Corporate Payment</h1>
      <p class="mt-1 text-sm text-slate-600">Allocate one payment across one or more open AR invoices.</p>
    </div>
    <%= link_to "Back to AR Invoices", hotel_ar_invoices_path(current_hotel), class: "rounded-xl border border-slate-200 bg-white px-4 py-2 text-sm font-bold text-slate-700 shadow-sm transition hover:bg-slate-50" %>
  </div>

  <% if @ar_payment_error.present? %>
    <div class="rounded-xl border border-red-200 bg-red-50 px-4 py-3 text-sm font-semibold text-red-800"><%= @ar_payment_error %></div>
  <% end %>

  <%= form_with url: hotel_ar_payments_path(current_hotel), method: :post, local: true, class: "space-y-6" do %>
    <%= hidden_field_tag "ar_payment[ar_invoice_id]", @source_invoice&.id if @source_invoice.present? %>
    <section class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">
      <div class="border-b border-slate-200 px-6 py-5">
        <h2 class="text-lg font-bold text-slate-950">Payment Details</h2>
      </div>
      <div class="grid gap-4 p-6 sm:grid-cols-2">
        <div>
          <label class="mb-2 block text-xs font-bold uppercase tracking-wider text-slate-500">Corporate Account</label>
          <%= select_tag "ar_payment[hotel_corporate_account_id]",
            options_from_collection_for_select(current_hotel.hotel_corporate_accounts.includes(:corporate_account).order(created_at: :desc), :id, ->(relationship) { relationship.corporate_account.name }, @hotel_corporate_account&.id),
            class: "w-full rounded-xl border border-slate-200 bg-white px-4 py-2.5 text-sm font-semibold text-slate-700" %>
        </div>
        <div>
          <label class="mb-2 block text-xs font-bold uppercase tracking-wider text-slate-500">Reference Number</label>
          <%= text_field_tag "ar_payment[reference_number]", params.dig(:ar_payment, :reference_number), required: true, class: "w-full rounded-xl border border-slate-200 px-4 py-2.5 text-sm font-semibold text-slate-700" %>
        </div>
        <div>
          <label class="mb-2 block text-xs font-bold uppercase tracking-wider text-slate-500">Amount</label>
          <%= number_field_tag "ar_payment[amount]", params.dig(:ar_payment, :amount), step: "0.01", min: "0.01", required: true, class: "w-full rounded-xl border border-slate-200 px-4 py-2.5 text-sm font-semibold text-slate-700" %>
        </div>
        <div>
          <label class="mb-2 block text-xs font-bold uppercase tracking-wider text-slate-500">Currency</label>
          <%= text_field_tag "ar_payment[currency]", params.dig(:ar_payment, :currency).presence || current_hotel.default_currency, required: true, class: "w-full rounded-xl border border-slate-200 px-4 py-2.5 text-sm font-semibold text-slate-700" %>
        </div>
        <div>
          <label class="mb-2 block text-xs font-bold uppercase tracking-wider text-slate-500">Received At</label>
          <%= date_field_tag "ar_payment[received_at]", params.dig(:ar_payment, :received_at).presence || current_hotel.current_business_date, required: true, class: "w-full rounded-xl border border-slate-200 px-4 py-2.5 text-sm font-semibold text-slate-700" %>
        </div>
        <div>
          <label class="mb-2 block text-xs font-bold uppercase tracking-wider text-slate-500">Payment Method</label>
          <%= select_tag "ar_payment[payment_method]", options_for_select(ArPayment::PAYMENT_METHODS.map { |method| [ method.humanize, method ] }, params.dig(:ar_payment, :payment_method).presence || "bank_transfer"), class: "w-full rounded-xl border border-slate-200 bg-white px-4 py-2.5 text-sm font-semibold text-slate-700" %>
        </div>
        <div class="sm:col-span-2">
          <label class="mb-2 block text-xs font-bold uppercase tracking-wider text-slate-500">Notes</label>
          <%= text_area_tag "ar_payment[notes]", params.dig(:ar_payment, :notes), rows: 3, class: "w-full rounded-xl border border-slate-200 px-4 py-2.5 text-sm font-semibold text-slate-700" %>
        </div>
      </div>
    </section>

    <section class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">
      <div class="border-b border-slate-200 px-6 py-5">
        <h2 class="text-lg font-bold text-slate-950">Invoice Allocations</h2>
      </div>
      <% if @open_invoices.any? %>
        <div class="overflow-x-auto">
          <table class="w-full min-w-[900px] text-left text-sm">
            <thead class="border-b border-slate-200 bg-slate-50 text-xs uppercase tracking-wider text-slate-500">
              <tr>
                <th class="px-6 py-3">Invoice</th>
                <th class="px-6 py-3">Source</th>
                <th class="px-6 py-3">Due</th>
                <th class="px-6 py-3 text-right">Outstanding</th>
                <th class="px-6 py-3">Allocate</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-slate-100">
              <% @open_invoices.each do |invoice| %>
                <tr>
                  <td class="px-6 py-4 font-bold text-slate-950">AR-<%= invoice.invoice_number %></td>
                  <td class="px-6 py-4 text-slate-600"><%= invoice.booking.confirmation_token %> · <%= invoice.booking_folio.folio_reference_display %></td>
                  <td class="px-6 py-4 text-slate-600"><%= invoice.due_on.strftime("%d %b %Y") %></td>
                  <td class="px-6 py-4 text-right font-bold tabular-nums text-slate-950"><%= invoice.currency %> <%= number_with_precision(invoice.outstanding_amount, precision: 2) %></td>
                  <td class="px-6 py-4">
                    <%= number_field_tag "allocations[#{invoice.id}]", (@source_invoice&.id == invoice.id ? invoice.outstanding_amount : nil), step: "0.01", min: "0", max: invoice.outstanding_amount, class: "w-full rounded-xl border border-slate-200 px-4 py-2.5 text-sm font-semibold text-slate-700" %>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      <% else %>
        <p class="px-6 py-10 text-center text-sm text-slate-500">No open invoices are available for this corporate account.</p>
      <% end %>
    </section>

    <div class="flex justify-end gap-2">
      <%= link_to "Cancel", (@source_invoice ? hotel_ar_invoice_path(current_hotel, @source_invoice) : hotel_ar_invoices_path(current_hotel)), class: "rounded-xl px-5 py-2.5 text-sm font-bold text-slate-600 transition hover:bg-slate-100" %>
      <%= submit_tag "Record Received Payment", class: "rounded-xl bg-slate-900 px-5 py-2.5 text-sm font-bold text-white shadow-sm transition hover:bg-slate-700" %>
    </div>
  <% end %>
</div>
