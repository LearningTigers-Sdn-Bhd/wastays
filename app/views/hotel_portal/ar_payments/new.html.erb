<div class="w-full space-y-3.5" data-controller="ar-payment-form" data-ar-payment-form-invoices-url-value="<%= eligible_invoices_hotel_ar_payments_path(current_hotel) %>">
  <div>
    <%= render PanelsUI::PageHeader.new(title: "Record Corporate Payment", description: "Record funds now and allocate all, some, or none to open invoices.") do |header| %>
      <% header.with_actions do %>
        <%= render PanelsUI::Button.new(label: "Back to AR Payments", as: :a, href: hotel_ar_payments_path(current_hotel), variant: :secondary, size: :md, class: "w-full lg:w-auto") %>
      <% end %>
    <% end %>
  </div>

  <% if @ar_payment_error.present? %>
    <div class="rounded-xl border border-red-200 bg-red-50 px-4 py-3 text-sm font-semibold text-red-800"><%= @ar_payment_error %></div>
  <% end %>

  <% if @ar_payment_submission.present? %>
    <div class="flex items-start justify-between gap-4 rounded-xl border border-blue-200 bg-blue-50 px-4 py-3">
      <div class="text-sm font-semibold text-blue-900">
        Recording this against the agent's submitted payment slip from <%= l(@ar_payment_submission.created_at, format: :short) %>.
        <%= link_to "View slip", rails_blob_path(@ar_payment_submission.slip, disposition: "inline"), target: "_blank", rel: "noopener", class: "underline" %>
      </div>
    </div>
  <% end %>

  <%= form_with url: hotel_ar_payments_path(current_hotel), method: :post, local: true, class: "space-y-6" do %>
    <%= hidden_field_tag "ar_payment[ar_invoice_id]", @source_invoice&.id if @source_invoice.present? %>
    <%= hidden_field_tag "ar_payment_submission_id", @ar_payment_submission&.id if @ar_payment_submission.present? %>
    <%= render "payment_fields" %>
    <%= render "allocation_summary", currency: params.dig(:ar_payment, :currency).presence || current_hotel.default_currency %>
    <%= render "invoice_allocations", open_invoices: @open_invoices, source_invoice: @source_invoice %>

    <div class="flex justify-end gap-2">
      <%= link_to "Cancel", hotel_ar_payments_path(current_hotel), class: "rounded-xl px-5 py-2.5 text-sm font-bold text-muted-foreground hover:bg-muted" %>
      <%= submit_tag "Record Received Payment", class: "rounded-xl bg-primary px-5 py-2.5 text-sm font-bold text-primary-foreground shadow-sm hover:bg-primary-hover" %>
    </div>
  <% end %>
</div>
