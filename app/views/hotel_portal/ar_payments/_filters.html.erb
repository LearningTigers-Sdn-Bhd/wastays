<%= form_with url: hotel_ar_payments_path(current_hotel), method: :get, class: "space-y-2 ", data: { controller: "auto-submit", turbo_frame: "ar_payments_results", turbo_action: "advance" } do |form| %>
  <div class="grid gap-3 lg:grid-cols-[minmax(16rem,1fr)_18rem_12rem_12rem]">
    <div class="relative">
      <div class="pointer-events-none absolute inset-y-0 left-0 flex items-center pl-3">
        <%= cached_icon "search", stroke_width: 2, class: "size-4 text-muted-foreground" %>
      </div>
      <%= form.text_field :query, value: presenter.query, placeholder: "Search reference or corporate account...",
        class: "block w-full rounded-lg border border-border bg-card py-2 pl-10 pr-3 text-sm shadow-sm",
        data: { action: "input->auto-submit#submit" } %>
    </div>

    <%= form.select :hotel_corporate_account_id,
      options_for_select(presenter.corporate_account_options.map { |option| [ option.name, option.id ] }, presenter.selected_corporate_account_id),
      { include_blank: "All corporate accounts" },
      class: "block w-full rounded-lg border border-border bg-card px-3 py-2 text-sm shadow-sm",
      data: { action: "change->auto-submit#submitNow" } %>

    <%= form.date_field :received_from, value: presenter.received_from, aria: { label: "Received from" },
      class: "block w-full rounded-lg border border-border bg-card px-3 py-2 text-sm shadow-sm",
      data: { action: "change->auto-submit#submitNow" } %>

    <%= form.date_field :received_to, value: presenter.received_to, aria: { label: "Received to" },
      class: "block w-full rounded-lg border border-border bg-card px-3 py-2 text-sm shadow-sm",
      data: { action: "change->auto-submit#submitNow" } %>
  </div>

  <div class="flex items-center justify-between gap-3">
    <div class="-mx-0.5 flex min-w-0 flex-1 items-center gap-2 overflow-x-auto px-0.5 py-2 no-scrollbar">
      <div class="shrink-0">
        <input type="radio" name="status" value="" id="ar_payment_status_all" class="peer sr-only" <%= "checked" if presenter.selected_status.blank? %> data-action="change->auto-submit#submitNow">
        <label for="ar_payment_status_all" class="inline-flex cursor-pointer rounded-full border border-border bg-card px-4 py-1.5 text-xs font-bold uppercase tracking-wider text-muted-foreground peer-checked:border-border-interactive peer-checked:bg-primary peer-checked:text-primary-foreground">All</label>
      </div>
      <% presenter.status_options.each do |label, value| %>
        <div class="shrink-0">
          <input type="radio" name="status" value="<%= value %>" id="ar_payment_status_<%= value %>" class="peer sr-only" <%= "checked" if presenter.selected_status == value %> data-action="change->auto-submit#submitNow">
          <label for="ar_payment_status_<%= value %>" class="inline-flex cursor-pointer rounded-full border border-border bg-card px-4 py-1.5 text-xs font-bold uppercase tracking-wider text-muted-foreground peer-checked:border-border-interactive peer-checked:bg-primary peer-checked:text-primary-foreground"><%= label %></label>
        </div>
      <% end %>
    </div>

    <% if current_user.has_permission?("manage_ar_payments", hotel: current_hotel) %>
      <%= render PanelsUI::Button.new(as: :a, href: new_hotel_ar_payment_path(current_hotel), variant: :primary, size: :md, class: "shrink-0") do %>
        <%= cached_icon "circle-dollar-sign", class: "size-4", aria: { hidden: true } %>
        Record Received Payment
      <% end %>
    <% end %>
  </div>
<% end %>
