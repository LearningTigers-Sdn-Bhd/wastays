<%= turbo_frame_tag "ar_payment_invoice_allocations" do %>
  <section class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">
    <div class="border-b border-slate-200 px-6 py-5">
      <h2 class="text-lg font-bold text-slate-950">Invoice Allocations</h2>
      <p class="mt-1 text-xs text-slate-500">Optional. Any remainder stays unapplied on the corporate account.</p>
    </div>
    <% if open_invoices.any? %>
      <div class="overflow-x-auto">
        <table class="w-full min-w-[900px] text-left text-sm">
          <thead class="border-b border-slate-200 bg-slate-50 text-xs uppercase tracking-wider text-slate-500"><tr><th class="px-6 py-3">Invoice</th><th class="px-6 py-3">Source</th><th class="px-6 py-3">Due</th><th class="px-6 py-3 text-right">Outstanding</th><th class="px-6 py-3">Allocate</th></tr></thead>
          <tbody class="divide-y divide-slate-100">
            <% open_invoices.each do |invoice| %>
              <tr>
                <td class="px-6 py-4 font-bold text-slate-950">AR-<%= invoice.invoice_number %></td>
                <td class="px-6 py-4 text-slate-600"><%= invoice.booking.confirmation_token %> · <%= invoice.booking_folio.folio_reference_display %></td>
                <td class="px-6 py-4 text-slate-600"><%= invoice.due_on.strftime("%d %b %Y") %></td>
                <td class="px-6 py-4 text-right font-bold tabular-nums text-slate-950"><%= invoice.currency %> <%= number_with_precision(invoice.outstanding_amount, precision: 2) %></td>
                <td class="px-6 py-4"><%= number_field_tag "allocations[#{invoice.id}]", (source_invoice&.id == invoice.id ? invoice.outstanding_amount : nil), step: "0.01", min: "0", max: invoice.outstanding_amount, class: "w-full rounded-xl border border-slate-200 px-4 py-2.5 text-sm font-semibold text-slate-700", data: { ar_payment_form_target: "allocation", action: "input->ar-payment-form#recalculate" } %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% else %>
      <p class="px-6 py-10 text-center text-sm text-slate-500">No open invoices are available for this corporate account.</p>
    <% end %>
  </section>
<% end %>
