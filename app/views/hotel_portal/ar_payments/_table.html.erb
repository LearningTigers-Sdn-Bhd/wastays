<%= turbo_frame_tag "ar_payments_results" do %>
  <div class="hidden overflow-x-auto rounded-xl border border-slate-200 bg-white shadow-sm lg:block">
    <table class="min-w-[1400px] divide-y divide-slate-200">
      <thead class="bg-slate-50/50">
        <tr>
          <% [ "Received", "Reference", "Status", "Corporate Account", "Method", "Amount", "Allocated", "Unapplied" ].each do |heading| %>
            <th scope="col" class="whitespace-nowrap px-6 py-3 text-left text-[10px] font-bold uppercase tracking-widest text-slate-500 <%= "text-right" if heading.in?([ "Amount", "Allocated", "Unapplied" ]) %>"><%= heading %></th>
          <% end %>
        </tr>
      </thead>
      <tbody class="divide-y divide-slate-100 bg-white">
        <% if presenter.paginated_rows.any? %>
          <% presenter.paginated_rows.each do |row| %>
            <tr class="group cursor-pointer transition hover:bg-slate-50/80"
                role="link" tabindex="0" data-controller="clickable-row"
                data-testid="ar-payment-row-<%= row.payment.id %>"
                data-clickable-row-url-value="<%= hotel_ar_payment_path(current_hotel, row.payment) %>"
                data-action="click->clickable-row#visit keydown->clickable-row#visitFromKeyboard">
              <td class="whitespace-nowrap px-6 py-3 text-sm font-semibold text-slate-700"><%= row.received_on %></td>
              <td class="whitespace-nowrap px-6 py-3 text-sm font-black text-slate-950 group-hover:underline"><%= row.payment.reference_number %></td>
              <td class="whitespace-nowrap px-6 py-3"><span class="inline-flex rounded-md border px-1.5 py-0.5 text-[10px] font-black uppercase tracking-wider <%= row.status_class %>"><%= row.status_label %></span></td>
              <td class="whitespace-nowrap px-6 py-3 text-sm font-bold text-slate-900"><%= row.account_name %></td>
              <td class="whitespace-nowrap px-6 py-3 text-sm text-slate-600"><%= row.payment.payment_method.humanize %></td>
              <td class="whitespace-nowrap px-6 py-3 text-right text-sm font-black tabular-nums text-slate-950"><%= row.amount_label %></td>
              <td class="whitespace-nowrap px-6 py-3 text-right text-sm font-bold tabular-nums text-slate-700"><%= row.allocated_label %></td>
              <td class="whitespace-nowrap px-6 py-3 text-right text-sm font-black tabular-nums text-slate-950"><%= row.unapplied_label %></td>
            </tr>
          <% end %>
        <% else %>
          <tr><td colspan="8"><%= render "empty_state", presenter: presenter %></td></tr>
        <% end %>
      </tbody>
    </table>
  </div>

  <div class="space-y-3 px-4 md:px-0 lg:hidden">
    <% if presenter.paginated_rows.any? %>
      <% presenter.paginated_rows.each do |row| %>
        <article class="cursor-pointer rounded-xl border border-slate-200 bg-white p-4 shadow-sm"
                 role="link" tabindex="0" data-controller="clickable-row"
                 data-testid="ar-payment-card-<%= row.payment.id %>"
                 data-clickable-row-url-value="<%= hotel_ar_payment_path(current_hotel, row.payment) %>"
                 data-action="click->clickable-row#visit keydown->clickable-row#visitFromKeyboard">
          <div class="flex items-start justify-between gap-3">
            <div><p class="text-[10px] font-bold uppercase tracking-widest text-slate-400">Reference</p><p class="mt-1 text-sm font-black text-slate-900"><%= row.payment.reference_number %></p></div>
            <span class="inline-flex rounded-md border px-1.5 py-0.5 text-[10px] font-black uppercase tracking-wider <%= row.status_class %>"><%= row.status_label %></span>
          </div>
          <p class="mt-3 text-sm font-bold text-slate-900"><%= row.account_name %></p>
          <div class="mt-4 grid grid-cols-3 gap-3 border-t border-slate-100 pt-4 text-right">
            <div><p class="text-[9px] font-bold uppercase text-slate-400">Amount</p><p class="mt-1 text-xs font-black"><%= row.amount_label %></p></div>
            <div><p class="text-[9px] font-bold uppercase text-slate-400">Allocated</p><p class="mt-1 text-xs font-bold"><%= row.allocated_label %></p></div>
            <div><p class="text-[9px] font-bold uppercase text-slate-400">Unapplied</p><p class="mt-1 text-xs font-black"><%= row.unapplied_label %></p></div>
          </div>
        </article>
      <% end %>
    <% else %>
      <div class="rounded-xl border border-dashed border-slate-200 bg-white p-6"><%= render "empty_state", presenter: presenter %></div>
    <% end %>
  </div>

  <% if presenter.pagination.total_pages > 1 %>
    <div class="mt-6 flex justify-center"><%= paginate presenter.pagination %></div>
  <% end %>
<% end %>
