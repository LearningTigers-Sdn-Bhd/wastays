<%= turbo_frame_tag "ar_payments_results" do %>
  <div class="hidden overflow-x-auto rounded-xl border border-border bg-card shadow-sm lg:block">
    <table class="w-full divide-y divide-border">
      <thead class="bg-muted/50">
        <tr>
          <% [ "Corporate Account", "Amount", "Status", "Reference" ].each do |heading| %>
            <th scope="col" class="whitespace-nowrap px-6 py-3 text-left text-[10px] font-bold uppercase tracking-widest text-muted-foreground <%= "text-right" if heading == "Amount" %>"><%= heading %></th>
          <% end %>
        </tr>
      </thead>
      <tbody class="divide-y divide-border bg-card">
        <% if presenter.paginated_rows.any? %>
          <% presenter.paginated_rows.each do |row| %>
            <tr class="group cursor-pointer transition hover:bg-muted/80"
                role="link" tabindex="0" data-controller="clickable-row"
                data-testid="payment-record-row-<%= row.kind %>-<%= row.reference %>"
                data-clickable-row-url-value="<%= row.path(current_hotel) %>"
                data-action="click->clickable-row#visit keydown->clickable-row#visitFromKeyboard">
              <td class="whitespace-nowrap px-6 py-3 text-sm font-bold text-foreground"><%= row.account_name %></td>
              <td class="whitespace-nowrap px-6 py-3 text-right text-sm font-black tabular-nums text-foreground"><%= row.amount_label %></td>
              <td class="whitespace-nowrap px-6 py-3"><%= tag.span row.status_label, class: "inline-flex rounded-md border px-1.5 py-0.5 text-[10px] font-black uppercase tracking-wider #{row.status_class}", title: row.status_title %></td>
              <td class="whitespace-nowrap px-6 py-3 text-sm">
                <span class="inline-flex items-center gap-1.5 font-black text-foreground group-hover:underline">
                  <% if row.kind == :submission %>
                    <%= cached_icon "upload", class: "size-3.5 text-muted-foreground", aria: { hidden: true } %>
                  <% end %>
                  <%= row.reference %>
                </span>
                <p class="mt-0.5 text-xs font-medium text-muted-foreground"><%= row.method_label %> · <%= row.received_on %></p>
              </td>
            </tr>
          <% end %>
        <% else %>
          <tr><td colspan="4"><%= render "empty_state", presenter: presenter %></td></tr>
        <% end %>
      </tbody>
    </table>
  </div>

  <div class="space-y-3  lg:hidden">
    <% if presenter.paginated_rows.any? %>
      <% presenter.paginated_rows.each do |row| %>
        <article class="cursor-pointer rounded-xl border border-border bg-card p-4 shadow-sm"
                 role="link" tabindex="0" data-controller="clickable-row"
                 data-testid="payment-record-card-<%= row.kind %>-<%= row.reference %>"
                 data-clickable-row-url-value="<%= row.path(current_hotel) %>"
                 data-action="click->clickable-row#visit keydown->clickable-row#visitFromKeyboard">
          <div class="flex items-start justify-between gap-3">
            <div>
              <p class="text-[10px] font-bold uppercase tracking-widest text-muted-foreground">Corporate Account</p>
              <p class="mt-1 text-sm font-bold text-foreground"><%= row.account_name %></p>
            </div>
            <p class="text-right text-sm font-black tabular-nums text-foreground"><%= row.amount_label %></p>
          </div>
          <div class="mt-4 flex items-center justify-between border-t border-border pt-4">
            <%= tag.span row.status_label, class: "inline-flex rounded-md border px-1.5 py-0.5 text-[10px] font-black uppercase tracking-wider #{row.status_class}", title: row.status_title %>
            <div class="text-right">
              <p class="inline-flex items-center gap-1.5 text-xs font-black text-foreground">
                <% if row.kind == :submission %>
                  <%= cached_icon "upload", class: "size-3.5 text-muted-foreground", aria: { hidden: true } %>
                <% end %>
                <%= row.reference %>
              </p>
              <p class="mt-0.5 text-[11px] font-medium text-muted-foreground"><%= row.method_label %> · <%= row.received_on %></p>
            </div>
          </div>
        </article>
      <% end %>
    <% else %>
      <div class="rounded-xl border border-dashed border-border bg-card p-6"><%= render "empty_state", presenter: presenter %></div>
    <% end %>
  </div>

  <% if presenter.pagination.total_pages > 1 %>
    <div class="mt-6 flex justify-center"><%= paginate presenter.pagination %></div>
  <% end %>
<% end %>
