<% content_for :breadcrumbs do %>
  <div class="flex items-center gap-x-2">
    <span class="text-sm font-medium text-slate-600"><%= current_hotel.name %></span>
    <span class="text-sm text-slate-400">/</span>
    <span class="text-sm font-semibold text-slate-900">FAQs Management</span>
  </div>
<% end %>

<%= render "hotel_portal/knowledge_base/documents_table",
  documents: @documents,
  title: "FAQs Management",
  subtitle: "Manage frequently asked questions for the AI concierge.",
  add_button_text: "Add FAQ",
  empty_title: "No FAQ documents found",
  empty_description: "Add FAQ documents for the AI concierge to reference." %>
