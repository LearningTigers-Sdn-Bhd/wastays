<div class="w-full space-y-3.5">
  <%= render PanelsUI::PageHeader.new(title: "Today's Check-Outs", description: "Guests who completed check-out today at your hotel.") %>

  <div class="overflow-hidden rounded-2xl border border-border bg-card shadow-sm">
    <div class="flex items-center justify-between border-b border-border px-6 py-5 sm:px-8">
      <div>
        <h2 class="text-lg font-bold tracking-tight text-foreground sm:text-xl">Checked-Out Guests</h2>
        <p class="mt-1 text-sm font-medium text-muted-foreground">Operational view of departures completed today for this property.</p>
      </div>
      <span class="text-sm font-medium text-muted-foreground">Checked Out Today <span class="font-semibold text-foreground"><%= @checked_out_count %></span></span>
    </div>

    <div class="border-b border-border bg-muted/70 px-6 py-4 sm:px-8">
      <%= form_with url: hotel_checked_out_guests_path(current_hotel), method: :get, class: "flex flex-col gap-3 xl:flex-row xl:items-center xl:justify-between", data: { controller: "auto-submit" } do |f| %>
        <div class="flex w-full flex-col gap-3 lg:flex-row">
          <label class="relative block flex-1">
            <span class="sr-only">Search today's checked-out guests</span>
            <span class="pointer-events-none absolute inset-y-0 left-0 flex items-center pl-4 text-muted-foreground">
              <svg class="size-4" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
            </span>
            <%= f.search_field :query,
                               value: @query,
                               id: "checked-out-guests-search",
                               placeholder: "Search guest, contact, or booking reference",
                               class: "w-full rounded-xl border border-border bg-card py-2.5 pl-11 pr-4 text-sm text-foreground placeholder:text-muted-foreground focus:border-border-interactive focus:outline-none focus:ring-0",
                               data: { action: "input->auto-submit#submit" } %>
          </label>
        </div>

        <div class="flex items-center gap-2">
          <% if @query.present? %>
            <%= link_to "Clear", hotel_checked_out_guests_path(current_hotel), class: "inline-flex items-center rounded-lg border border-border bg-card px-3 py-2 text-sm font-semibold text-foreground shadow-sm transition hover:border-border-interactive hover:bg-muted" %>
          <% end %>
        </div>
      <% end %>
    </div>

    <div class="hidden lg:block overflow-x-auto">
      <table class="min-w-full table-fixed">
        <colgroup>
          <col class="w-[16%]">
          <col class="w-[18%]">
          <col class="w-[13%]">
          <col class="w-[13%]">
          <col class="w-[14%]">
          <col class="w-[12%]">
          <col class="w-[14%]">
        </colgroup>
        <thead class="bg-muted">
          <tr>
            <th scope="col" class="px-6 py-4 text-left text-[11px] font-semibold uppercase tracking-[0.1em] text-muted-foreground sm:px-8">Guest / Reference</th>
            <th scope="col" class="px-6 py-4 text-left text-[11px] font-semibold uppercase tracking-[0.1em] text-muted-foreground">Contact</th>
            <th scope="col" class="px-6 py-4 text-left text-[11px] font-semibold uppercase tracking-[0.1em] text-muted-foreground">Stay Dates</th>
            <th scope="col" class="px-6 py-4 text-left text-[11px] font-semibold uppercase tracking-[0.1em] text-muted-foreground">Checked In</th>
            <th scope="col" class="px-6 py-4 text-left text-[11px] font-semibold uppercase tracking-[0.1em] text-muted-foreground">Checked Out</th>
            <th scope="col" class="px-6 py-4 text-left text-[11px] font-semibold uppercase tracking-[0.1em] text-muted-foreground">Rooms</th>
            <th scope="col" class="px-6 py-4 text-right text-[11px] font-semibold uppercase tracking-[0.1em] text-muted-foreground sm:px-8">Actions</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-border bg-card">
          <% if @checked_out_guests.any? %>
            <% @checked_out_guests.each_with_index do |booking, index| %>
              <tr class="align-top transition-colors hover:bg-muted/80 <%= index.even? ? 'bg-card' : 'bg-muted/55' %>">
                <td class="px-6 py-4 sm:px-8">
                  <div class="flex flex-col gap-1.5">
                    <span class="text-sm font-semibold text-foreground"><%= booking.guest_name %></span>
                    <span class="text-xs font-mono text-muted-foreground"><%= booking.confirmation_token %></span>
                  </div>
                </td>
                <td class="px-6 py-4">
                  <div class="flex flex-col gap-1">
                    <span class="text-sm text-foreground"><%= booking.guest_email %></span>
                    <span class="text-sm text-muted-foreground"><%= booking.guest_phone %></span>
                  </div>
                </td>
                <td class="px-6 py-4 whitespace-nowrap">
                  <div class="flex flex-col gap-0.5">
                    <span class="text-sm font-medium text-foreground"><%= booking.check_in.strftime("%d %b %Y") %></span>
                    <span class="text-xs text-muted-foreground">to <%= booking.check_out.strftime("%d %b %Y") %></span>
                  </div>
                </td>
                <td class="px-6 py-4 whitespace-nowrap">
                  <span class="text-sm font-medium text-foreground"><%= booking.checked_in_at&.in_time_zone(current_user.time_zone)&.strftime("%d %b %Y, %I:%M %p") || "—" %></span>
                </td>
                <td class="px-6 py-4 whitespace-nowrap">
                  <span class="text-sm font-medium text-foreground"><%= booking.checked_out_at&.in_time_zone(current_user.time_zone)&.strftime("%d %b %Y, %I:%M %p") || "—" %></span>
                </td>
                <td class="px-6 py-4">
                  <% if booking.booking_rooms.any? %>
                    <div class="flex flex-wrap gap-2">
                      <% booking.booking_rooms.group_by { |r| r.room_type_snapshot["name"].presence || r.room_type.name }.each do |room_name, rooms| %>
                        <span class="inline-flex items-center rounded-full border border-border bg-muted px-2.5 py-1 text-xs font-medium text-foreground">
                          <%= rooms.size %>x <%= room_name %>
                        </span>
                      <% end %>
                    </div>
                  <% else %>
                    <span class="text-sm text-muted-foreground">No rooms assigned</span>
                  <% end %>
                </td>
                <td class="px-6 py-4 text-right whitespace-nowrap sm:px-8">
                  <%= link_to "View booking", hotel_booking_control_panel_path(current_hotel, booking, tab: "booking_details"), class: "inline-flex items-center rounded-lg border border-border bg-card px-3 py-1.5 text-xs font-semibold text-foreground shadow-sm transition hover:border-border-interactive hover:bg-muted" %>
                </td>
              </tr>
            <% end %>
          <% else %>
            <tr>
              <td colspan="7" class="px-6 py-12 text-center sm:px-8">
                <% if @query.present? && @checked_out_count.positive? %>
                  <p class="text-sm font-medium text-muted-foreground">No today's check-outs matched your search.</p>
                  <p class="mt-1 text-sm text-muted-foreground">Try a different guest name, contact detail, or booking reference.</p>
                <% else %>
                  <p class="text-sm font-medium text-muted-foreground">No guests have checked out today.</p>
                  <p class="mt-1 text-sm text-muted-foreground">Completed departures recorded today will appear here.</p>
                <% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>

    <div class="space-y-4 p-4 sm:p-6 lg:hidden">
      <% if @checked_out_guests.any? %>
        <% @checked_out_guests.each do |booking| %>
          <div class="rounded-2xl border border-border bg-muted/60 p-4 shadow-sm">
            <div class="flex items-start justify-between gap-3">
              <div>
                <p class="text-xs font-semibold uppercase tracking-[0.08em] text-muted-foreground">Guest</p>
                <p class="mt-1 text-sm font-semibold text-foreground"><%= booking.guest_name %></p>
                <p class="mt-1 text-xs font-mono text-muted-foreground"><%= booking.confirmation_token %></p>
              </div>
              <span class="inline-flex items-center rounded-full border border-border bg-card px-2.5 py-1 text-[11px] font-semibold text-foreground">Checked out</span>
            </div>

            <dl class="mt-4 space-y-3 text-sm">
              <div>
                <dt class="text-xs font-semibold uppercase tracking-[0.08em] text-muted-foreground">Contact</dt>
                <dd class="mt-1 text-foreground"><%= booking.guest_email %></dd>
                <dd class="text-muted-foreground"><%= booking.guest_phone %></dd>
              </div>
              <div>
                <dt class="text-xs font-semibold uppercase tracking-[0.08em] text-muted-foreground">Stay Dates</dt>
                <dd class="mt-1 text-foreground"><%= booking.check_in.strftime("%d %b %Y") %> to <%= booking.check_out.strftime("%d %b %Y") %></dd>
              </div>
              <div>
                <dt class="text-xs font-semibold uppercase tracking-[0.08em] text-muted-foreground">Checked In</dt>
                <dd class="mt-1 text-foreground">
                  <% if booking.checked_in_at.present? %>
                    <span class="block font-medium text-foreground"><%= booking.checked_in_at.in_time_zone(current_user.time_zone).strftime("%d %b %Y, %I:%M %p") %></span>
                  <% else %>
                    —
                  <% end %>
                </dd>
              </div>
              <div>
                <dt class="text-xs font-semibold uppercase tracking-[0.08em] text-muted-foreground">Checked Out</dt>
                <dd class="mt-1 text-foreground">
                  <% if booking.checked_out_at.present? %>
                    <span class="block font-medium text-foreground"><%= booking.checked_out_at.in_time_zone(current_user.time_zone).strftime("%d %b %Y, %I:%M %p") %></span>
                  <% else %>
                    —
                  <% end %>
                </dd>
              </div>
              <div>
                <dt class="text-xs font-semibold uppercase tracking-[0.08em] text-muted-foreground">Rooms</dt>
                <dd class="mt-1 flex flex-wrap gap-1.5">
                  <% if booking.booking_rooms.any? %>
                    <% booking.booking_rooms.group_by { |r| r.room_type_snapshot["name"].presence || r.room_type.name }.each do |room_name, rooms| %>
                      <span class="inline-flex items-center rounded-full border border-border bg-card px-2 py-1 text-xs font-medium text-foreground">
                        <%= rooms.size %>x <%= room_name %>
                      </span>
                    <% end %>
                  <% else %>
                    <span class="text-muted-foreground">No rooms assigned</span>
                  <% end %>
                </dd>
              </div>
            </dl>

            <div class="mt-4 flex items-center justify-end gap-2">
              <%= link_to "View booking", hotel_booking_control_panel_path(current_hotel, booking, tab: "booking_details"), class: "inline-flex items-center rounded-lg border border-border bg-card px-3 py-1.5 text-xs font-semibold text-foreground shadow-sm transition hover:border-border-interactive hover:bg-muted" %>
            </div>
          </div>
        <% end %>
      <% else %>
        <div class="rounded-2xl border border-dashed border-border-interactive bg-card px-5 py-10 text-center shadow-sm">
          <% if @query.present? && @checked_out_count.positive? %>
            <p class="text-sm font-medium text-muted-foreground">No today's check-outs matched your search.</p>
            <p class="mt-1 text-sm text-muted-foreground">Try a different guest name, contact detail, or booking reference.</p>
          <% else %>
            <p class="text-sm font-medium text-muted-foreground">No guests have checked out today.</p>
            <p class="mt-1 text-sm text-muted-foreground">Completed departures recorded today will appear here.</p>
          <% end %>
        </div>
      <% end %>
    </div>

    <div class="px-6 py-5 border-t border-border bg-muted/50 flex justify-center sm:px-8">
      <%= paginate @checked_out_guests %>
    </div>
  </div>
</div>
