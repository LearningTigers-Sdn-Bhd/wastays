<section aria-label="Reservation view" class="space-y-4 rounded-xl border border-slate-200 bg-slate-50/70 p-4 shadow-sm">
  <% if @bookings.any? %>
    <div class="grid grid-cols-1 gap-4 md:grid-cols-2 2xl:grid-cols-3">
      <% @bookings.each do |booking| %>
        <% presenter = HotelPortal::InHouseGuestPresenter.new(booking, current_user.time_zone) %>
        <% room_numbers = booking.booking_rooms.filter_map { |room| room.room_number.presence }.join(" · ").presence || "Unassigned" %>
        <% nights = booking.check_in && booking.check_out ? (booking.check_out.to_date - booking.check_in.to_date).to_i : nil %>
        <% transactions = booking.booking_folios.flat_map { |folio| folio.folio_transactions.to_a } %>
        <% balance = transactions.sum { |transaction| transaction.amount.to_d } %>
        <% total = booking.total_amount.to_d %>
        <% paid = [total - balance, 0].max %>
        <% actions = [{ label: "View booking", path: hotel_booking_control_panel_path(current_hotel, booking, tab: "booking_details") }] %>
        <% if presenter.status == "review_due_out" %><% actions << { label: "Review late checkout", path: hotel_booking_transaction_late_checkout_path(current_hotel, booking, return_to: request.fullpath), data: { turbo_frame: "offcanvas_drawer", offcanvas_variant: "right" } } %><% elsif presenter.status == "checkout_required" %><% actions << { label: "Complete checkout", path: hotel_booking_transaction_check_out_path(current_hotel, booking, return_to: request.fullpath), data: { turbo_frame: "offcanvas_drawer", offcanvas_variant: "fullscreen-bottom" } } %><% else %><% actions << { label: "Check out", path: check_out_hotel_booking_path(current_hotel, booking), method: :post, data: { turbo_confirm: "Are you sure you want to check out this guest?" } } %><% end %>
        <article class="front-desk-stay-card min-w-0 overflow-hidden rounded-xl border border-slate-200 bg-white shadow-sm">
          <header class="flex min-w-0 items-stretch gap-3 border-b border-slate-200 p-4">
            <span class="flex max-w-[35%] shrink-0 items-center truncate border-r border-slate-200 pr-3 <%= room_numbers == 'Unassigned' ? 'text-xs font-semibold text-slate-600' : 'text-lg font-black tracking-tight text-blue-700' %>"><span class="<%= 'inline-flex rounded-md bg-slate-100 px-2 py-1' if room_numbers == 'Unassigned' %>"><%= room_numbers %></span></span>
            <div class="min-w-0 flex-1">
              <div class="flex min-w-0 items-center gap-1.5"><p class="truncate text-sm font-bold text-slate-950"><%= presenter.guest_name %></p><% [("VIP" if presenter.vip?), ("Blacklisted" if presenter.blacklisted?), ("Repeat" if presenter.repeat?)].compact.each do |marker| %><span class="shrink-0 text-[9px] font-bold uppercase text-slate-400"><%= marker %></span><% end %></div>
              <p class="mt-0.5 truncate font-mono text-xs text-slate-500"><%= presenter.confirmation_token %></p>
            </div>
            <%= render "card_action_menu", actions: %>
          </header>
          <section class="mx-4 mt-4 flex items-stretch gap-3 rounded-lg bg-slate-50 px-3 py-2 text-sm"><div class="min-w-0 flex flex-1 flex-col justify-center"><p class="text-[10px] font-bold uppercase tracking-widest text-slate-500">Arrival</p><p class="mt-1 truncate"><%= presenter.check_in_formatted %></p></div><span class="-my-2 self-stretch border-l border-slate-300" aria-hidden="true"></span><div class="flex shrink-0 flex-col justify-center text-center"><p class="text-[10px] font-bold uppercase tracking-widest text-slate-500">Stay</p><p class="mt-1 font-semibold text-slate-950"><%= nights ? pluralize(nights, "night") : "—" %></p></div><span class="-my-2 self-stretch border-l border-slate-300" aria-hidden="true"></span><div class="flex min-w-0 flex-1 flex-col justify-center text-right"><p class="text-[10px] font-bold uppercase tracking-widest text-slate-500">Departure</p><p class="mt-1 truncate"><%= presenter.check_out_formatted %></p></div></section>
          <div class="px-4 pt-3"><span class="<%= presenter.mobile_status_badge_class %>"><%= presenter.mobile_status_label %></span></div>
          <dl class="grid grid-cols-2 gap-x-6 gap-y-4 px-4 py-4 text-sm"><div class="min-w-0"><dt class="text-[10px] font-bold uppercase tracking-widest text-slate-500">Contact</dt><dd class="mt-1 break-all text-slate-950"><%= presenter.guest_email %><br><%= presenter.guest_phone %></dd></div><div class="min-w-0"><dt class="text-[10px] font-bold uppercase tracking-widest text-slate-500">Checked in</dt><dd class="mt-1 break-words text-slate-950"><%= presenter.checked_in_at_formatted %></dd></div><div class="col-span-2 min-w-0"><dt class="text-[10px] font-bold uppercase tracking-widest text-slate-500">Rooms</dt><dd class="mt-1 break-words text-slate-950"><%= presenter.rooms_summary.presence || "No rooms assigned" %></dd></div></dl>
          <dl class="mx-4 mb-4 grid grid-cols-3 gap-3 rounded-lg bg-slate-50 px-3 py-2 text-sm tabular-nums"><div><dt class="text-[10px] font-bold uppercase tracking-widest text-slate-500">Total</dt><dd class="mt-1 font-semibold text-slate-950"><%= number_to_currency(total, unit: "RM ") %></dd></div><div><dt class="text-[10px] font-bold uppercase tracking-widest text-slate-500">Paid</dt><dd class="mt-1 font-semibold text-slate-950"><%= number_to_currency(paid, unit: "RM ") %></dd></div><div class="text-right"><dt class="text-[10px] font-bold uppercase tracking-widest text-slate-500">Balance</dt><dd class="mt-1 font-semibold <%= balance.positive? ? 'text-rose-600' : 'text-slate-950' %>"><%= number_to_currency(balance, unit: "RM ") %></dd></div></dl>
        </article>
      <% end %>
    </div>
  <% else %>
    <div class="rounded-xl border border-slate-200 bg-white px-4 py-12 text-center text-sm text-slate-500 shadow-sm">No guests are currently checked in.</div>
  <% end %>
  <div class="flex justify-center rounded-xl border border-slate-200 bg-white p-4 shadow-sm"><%= paginate @bookings, param_name: @page_param %></div>
</section>
