<section aria-label="Reservation view" class="space-y-4 rounded-xl border border-border bg-muted p-4 shadow-sm">
  <% if @bookings.any? %>
    <div class="grid grid-cols-1 gap-3 md:grid-cols-2 xl:grid-cols-4">
      <% @bookings.each do |booking| %>
        <% presenter = HotelPortal::InHouseGuestPresenter.new(booking, current_user.time_zone) %>
        <% room_numbers = booking.booking_rooms.filter_map { |room| room.room_number.presence }.join(" · ").presence || "Unassigned" %>
        <% nights = booking.check_in && booking.check_out ? (booking.check_out.to_date - booking.check_in.to_date).to_i : nil %>
        <% transactions = booking.booking_folios.flat_map { |folio| folio.folio_transactions.to_a } %>
        <% balance = transactions.sum { |transaction| transaction.amount.to_d } %>
        <% total = booking.total_amount.to_d %>
        <% paid = [total - balance, 0].max %>
        <% actions = [{ label: "View booking", path: hotel_booking_workspace_path(current_hotel, booking, tab: "booking_details") }] %>
        <% if current_user.has_permission?("manage_bookings", hotel: current_hotel) %><% actions << { label: "Print invoice", path: invoice_booking_path(booking.confirmation_token), data: { turbo: false }, target: "_blank" } %><% end %>
        <% if current_user.has_permission?("view_bookings", hotel: current_hotel) && current_hotel.feature_enabled?("full_audit_trail") %><% actions << { label: "Audit trail", path: hotel_booking_action_audit_trail_path(current_hotel, booking), data: { turbo_frame: "booking_action_sheet" } } %><% end %>
        <% if presenter.status == "review_due_out" %><% actions << { label: "Review late checkout", path: hotel_booking_action_late_checkout_path(current_hotel, booking, return_to: request.fullpath), data: { turbo_frame: "booking_action_sheet" } } %><% elsif presenter.status == "checkout_required" %><% actions << { label: "Complete checkout", path: hotel_booking_action_checkout_path(current_hotel, booking, return_to: request.fullpath), data: { turbo_frame: "booking_action_sheet" } } %><% else %><% actions << { label: "Check out", path: hotel_booking_action_checkout_path(current_hotel, booking, return_to: request.fullpath), data: { turbo_frame: "booking_action_sheet" } } %><% end %>
        <article class="front-desk-stay-card min-w-0 overflow-hidden rounded-xl border border-border bg-card shadow-sm">
          <header class="flex min-w-0 items-stretch gap-2 border-b border-border p-3">
            <span class="flex max-w-[35%] shrink-0 items-center border-r border-border pr-3 <%= room_numbers == 'Unassigned' ? 'flex-col justify-center text-xs font-medium leading-tight text-muted-foreground' : 'truncate text-lg font-semibold tracking-tight text-primary' %>"><span><%= room_numbers %></span><% if room_numbers == "Unassigned" %><span class="mt-0.5">Room</span><% end %></span>
            <div class="min-w-0 flex-1">
              <div class="flex min-w-0 flex-wrap items-start gap-1.5"><p class="min-w-0 flex-1 break-words text-sm font-semibold text-foreground"><%= presenter.guest_name %></p><% [("VIP" if presenter.vip?), ("Blacklisted" if presenter.blacklisted?), ("Repeat" if presenter.repeat?)].compact.each do |marker| %><span class="shrink-0 text-xs font-medium text-muted-foreground"><%= marker %></span><% end %></div>
              <p class="mt-0.5 truncate font-mono text-xs text-muted-foreground"><%= presenter.confirmation_token %></p>
            </div>
            <%= render "card_action_menu", actions: %>
          </header>
          <section class="mx-3 mt-3 flex items-stretch gap-2 rounded-lg bg-muted px-3 py-2 text-sm"><div class="min-w-0 flex flex-1 flex-col justify-center"><p class="text-xs font-medium text-muted-foreground">Arrival</p><p class="mt-1 truncate"><%= presenter.check_in_formatted %></p></div><span class="-my-2 self-stretch border-l border-border" aria-hidden="true"></span><div class="flex shrink-0 flex-col justify-center text-center"><p class="text-xs font-medium text-muted-foreground">Stay</p><p class="mt-1 font-semibold text-foreground"><%= nights ? pluralize(nights, "night") : "—" %></p></div><span class="-my-2 self-stretch border-l border-border" aria-hidden="true"></span><div class="flex min-w-0 flex-1 flex-col justify-center text-right"><p class="text-xs font-medium text-muted-foreground">Departure</p><p class="mt-1 truncate"><%= presenter.check_out_formatted %></p></div></section>
          <div class="flex items-center justify-between gap-2 px-3 pt-3"><div class="flex min-w-0 items-center gap-1.5"><span class="<%= presenter.mobile_status_badge_class %>"><%= presenter.mobile_status_label %></span><%= render "booking_source_icon", source: booking.source %></div><%= render "occupancy", adults: booking.adults, children: booking.children %></div>
          <dl class="grid grid-cols-2 gap-3 px-3 py-3 text-sm"><div class="min-w-0"><dt class="text-xs font-medium text-muted-foreground">Checked in</dt><dd class="mt-1 break-words text-foreground"><%= presenter.checked_in_at_formatted %></dd></div><div class="min-w-0"><dt class="text-xs font-medium text-muted-foreground">Booking date</dt><dd class="mt-1 text-foreground"><%= booking.created_at.in_time_zone(current_hotel.hotel_time_zone).strftime("%d %b %Y") %></dd></div><div class="col-span-2 min-w-0"><dt class="text-xs font-medium text-muted-foreground">Rooms</dt><dd class="mt-1 break-words text-foreground"><%= presenter.rooms_summary.join(", ").presence || "No rooms assigned" %></dd></div></dl>
          <dl class="mx-3 mb-3 grid grid-cols-3 gap-2 rounded-lg bg-muted px-3 py-2 text-sm tabular-nums"><div class="min-w-0"><dt class="text-xs font-medium text-muted-foreground">Total</dt><dd class="mt-1 whitespace-nowrap text-xs font-semibold text-foreground"><%= number_to_currency(total, unit: "RM ") %></dd></div><div class="min-w-0"><dt class="text-xs font-medium text-muted-foreground">Paid</dt><dd class="mt-1 whitespace-nowrap text-xs font-semibold text-foreground"><%= number_to_currency(paid, unit: "RM ") %></dd></div><div class="min-w-0 text-right"><dt class="text-xs font-medium text-muted-foreground">Balance</dt><dd class="mt-1 whitespace-nowrap text-xs font-semibold <%= balance.positive? ? 'text-destructive' : 'text-foreground' %>"><%= number_to_currency(balance, unit: "RM ") %></dd></div></dl>
        </article>
      <% end %>
    </div>
  <% else %>
    <div class="rounded-xl border border-border bg-card px-4 py-12 text-center text-sm text-muted-foreground shadow-sm">No guests are currently checked in.</div>
  <% end %>
  <div class="flex justify-center rounded-xl border border-border bg-card p-4 shadow-sm"><%= paginate @bookings, param_name: @page_param %></div>
</section>
