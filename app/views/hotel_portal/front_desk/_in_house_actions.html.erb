<%= link_to "View booking", hotel_booking_control_panel_path(current_hotel, booking, tab: "booking_details"), class: "inline-flex min-h-9 items-center rounded-lg border border-slate-200 px-3 py-1.5 text-sm font-semibold text-slate-700 hover:bg-slate-50 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-600 focus-visible:ring-offset-2" %>
<% if presenter.status == "review_due_out" %>
  <%= link_to "Review late checkout", hotel_booking_transaction_late_checkout_path(current_hotel, booking, return_to: request.fullpath), data: { turbo_frame: "offcanvas_drawer", offcanvas_variant: "right" }, class: "ml-2 inline-flex min-h-9 items-center rounded-lg border border-slate-200 px-3 py-1.5 text-sm font-semibold text-slate-700 hover:bg-slate-50 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-600 focus-visible:ring-offset-2" %>
<% elsif presenter.status == "checkout_required" %>
  <%= link_to "Complete checkout", hotel_booking_transaction_check_out_path(current_hotel, booking, return_to: request.fullpath), data: { turbo_frame: "offcanvas_drawer", offcanvas_variant: "fullscreen-bottom" }, class: "ml-2 inline-flex min-h-9 items-center rounded-lg bg-blue-600 px-3 py-1.5 text-sm font-semibold text-white hover:bg-blue-700 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-600 focus-visible:ring-offset-2" %>
<% else %>
  <%= button_to "Check out", check_out_hotel_booking_path(current_hotel, booking), method: :post, class: "ml-2 inline-flex min-h-9 items-center rounded-lg bg-blue-600 px-3 py-1.5 text-sm font-semibold text-white hover:bg-blue-700 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-600 focus-visible:ring-offset-2", data: { turbo_confirm: "Are you sure you want to check out this guest?" } %>
<% end %>
