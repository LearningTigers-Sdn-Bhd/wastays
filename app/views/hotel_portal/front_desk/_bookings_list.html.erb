<section aria-label="Booking list" class="overflow-hidden rounded-xl border border-border bg-card shadow-sm">
  <div class="hidden overflow-x-auto lg:block">
    <table class="min-w-full divide-y divide-border">
      <thead class="bg-muted">
        <tr>
          <% ["Reference", "Status", "Guest", "Stay Dates", "Amount"].each do |header| %>
            <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-muted-foreground"><%= header %></th>
          <% end %>
          <th scope="col" class="px-6 py-3 text-right text-xs font-medium text-muted-foreground">Action</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-border bg-card">
        <% if @bookings.any? %>
          <% @bookings.each do |booking| %>
            <% presenter = HotelPortal::BookingPresenter.new(booking, current_hotel) %>
            <tr class="group <%= booking.blacklisted? ? 'bg-muted' : 'transition-colors hover:bg-muted' %>">
              <th scope="row" class="px-6 py-3 text-left"><span class="block text-sm font-semibold text-foreground"><%= presenter.confirmation_token %></span><span class="text-xs font-medium text-muted-foreground"><%= presenter.created_at_date %></span></th>
              <td class="px-6 py-3"><span class="inline-flex rounded-md border px-1.5 py-1 text-xs font-medium <%= presenter.status_variant_class %>"><%= presenter.status_label_humanized %></span></td>
              <td class="px-6 py-3"><div class="flex items-center gap-1.5"><span class="text-sm font-semibold text-foreground"><%= presenter.guest_name %></span><% if presenter.vip? %><%= cached_icon "crown-simple", library: "phosphor", variant: "duotone", class: "size-4 text-warning" %><% end %><% if presenter.blacklisted? %><%= cached_icon "ban", class: "size-4 text-destructive" %><% end %><% if presenter.repeat? %><%= cached_icon "repeat", class: "size-4 text-info" %><% end %></div><div class="mt-1 text-xs text-muted-foreground"><%= presenter.guest_email_display %> · <span class="font-mono"><%= presenter.guest_phone_display %></span></div></td>
              <td class="px-6 py-3"><span class="text-sm font-semibold text-foreground"><%= presenter.check_in_short %> — <%= presenter.check_out_date_year %></span><span class="mt-1 block text-xs text-muted-foreground"><%= presenter.nights_label %></span></td>
              <td class="whitespace-nowrap px-6 py-3 text-sm font-semibold text-foreground"><%= presenter.formatted_currency_total %></td>
              <td class="whitespace-nowrap px-6 py-3 text-right"><%= link_to "Open", hotel_booking_workspace_path(current_hotel, booking, tab: "booking_details"), class: "inline-flex min-h-9 items-center rounded-lg border border-border-interactive bg-card px-3 py-1.5 text-xs font-medium text-foreground shadow-sm hover:bg-muted", data: { turbo_frame: "_top" } %></td>
            </tr>
          <% end %>
        <% else %>
          <tr><td colspan="6" class="px-6 py-10 text-center"><p class="text-sm font-semibold text-foreground">No bookings found</p><p class="mt-1 text-xs text-muted-foreground">Try adjusting your filters or search keywords.</p><%= link_to "Reset Filters", hotel_front_desk_path(current_hotel, tab: "bookings", view: "list"), class: "mt-4 inline-flex rounded-lg border border-border-interactive px-3 py-1.5 text-xs font-medium text-foreground", aria: { label: "Reset booking filters" } if @query.present? || @booking_status.present? || @start_date.present? || @end_date.present? %></td></tr>
        <% end %>
      </tbody>
    </table>
  </div>

  <div class="space-y-3 p-3 lg:hidden">
    <% if @bookings.any? %>
      <% @bookings.each do |booking| %>
        <% presenter = HotelPortal::BookingPresenter.new(booking, current_hotel) %>
        <article class="rounded-xl border border-border p-4 shadow-sm <%= booking.blacklisted? ? 'border-t-4 border-t-destructive bg-muted' : 'bg-card' %>">
          <div class="flex items-start justify-between gap-3"><div><p class="text-xs font-medium text-muted-foreground"><%= presenter.confirmation_token %></p><p class="mt-1 text-sm font-semibold text-foreground"><%= presenter.guest_name %></p></div><span class="inline-flex rounded-md border px-1.5 py-1 text-xs font-medium <%= presenter.status_variant_class %>"><%= presenter.status_label_humanized %></span></div>
          <dl class="mt-4 grid grid-cols-2 gap-4 text-sm"><div><dt class="text-xs font-medium text-muted-foreground">Stay Dates</dt><dd class="mt-1 font-semibold"><%= presenter.check_in_short %> — <%= presenter.check_out_date_year %><br><span class="text-xs text-muted-foreground"><%= presenter.nights_label %></span></dd></div><div class="text-right"><dt class="text-xs font-medium text-muted-foreground">Amount</dt><dd class="mt-1 font-semibold"><%= presenter.formatted_currency_total %></dd></div></dl>
          <div class="mt-4 flex justify-end border-t border-border pt-4"><%= link_to "Open", hotel_booking_workspace_path(current_hotel, booking, tab: "booking_details"), class: "inline-flex min-h-9 items-center rounded-lg border border-border-interactive bg-card px-4 py-1.5 text-xs font-medium text-foreground shadow-sm", data: { turbo_frame: "_top" } %></div>
        </article>
      <% end %>
    <% else %>
      <div class="py-10 text-center text-sm text-muted-foreground"><p>No bookings found.</p><%= link_to "Reset Filters", hotel_front_desk_path(current_hotel, tab: "bookings", view: "list"), class: "mt-4 inline-flex rounded-lg border border-border-interactive px-3 py-1.5 text-xs font-medium text-foreground", aria: { label: "Reset booking filters" } if @query.present? || @booking_status.present? || @start_date.present? || @end_date.present? %></div>
    <% end %>
  </div>

  <% if @bookings.total_pages > 1 %><div class="flex justify-center border-t border-border p-3"><%= paginate @bookings, param_name: @page_param %></div><% end %>
</section>
