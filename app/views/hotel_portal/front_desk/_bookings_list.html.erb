<section aria-label="Booking list" class="overflow-hidden rounded-xl border border-slate-200 bg-white shadow-sm">
  <div class="hidden overflow-x-auto lg:block">
    <table class="min-w-full divide-y divide-slate-200">
      <thead class="bg-slate-50/50">
        <tr>
          <% ["Reference", "Status", "Guest", "Stay Dates", "Amount"].each do |header| %>
            <th scope="col" class="px-6 py-3 text-left text-[10px] font-bold uppercase tracking-widest text-slate-500"><%= header %></th>
          <% end %>
          <th scope="col" class="px-6 py-3 text-right text-[10px] font-bold uppercase tracking-widest text-slate-500">Action</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-slate-100 bg-white">
        <% if @bookings.any? %>
          <% @bookings.each do |booking| %>
            <% presenter = HotelPortal::BookingPresenter.new(booking, current_hotel) %>
            <tr class="group <%= booking.blacklisted? ? 'bg-rose-100' : 'transition-colors hover:bg-slate-50/80' %>">
              <th scope="row" class="px-6 py-3 text-left"><span class="block text-sm font-bold text-slate-900"><%= presenter.confirmation_token %></span><span class="text-[10px] font-medium text-slate-400"><%= presenter.created_at_date %></span></th>
              <td class="px-6 py-3"><span class="inline-flex rounded-md border px-1.5 py-0.5 text-[10px] font-black uppercase tracking-wider <%= presenter.status_variant_class %>"><%= presenter.status_label_humanized %></span></td>
              <td class="px-6 py-3"><div class="flex items-center gap-1.5"><span class="text-sm font-bold text-slate-900"><%= presenter.guest_name %></span><% if presenter.vip? %><%= cached_icon "crown-simple", library: "phosphor", variant: "duotone", class: "size-4 text-amber-500" %><% end %><% if presenter.blacklisted? %><%= cached_icon "ban", class: "size-4 text-rose-600" %><% end %><% if presenter.repeat? %><%= cached_icon "repeat", class: "size-4 text-blue-500" %><% end %></div><div class="mt-0.5 text-[11px] text-slate-500"><%= presenter.guest_email_display %> · <span class="font-mono"><%= presenter.guest_phone_display %></span></div></td>
              <td class="px-6 py-3"><span class="text-sm font-bold text-slate-900"><%= presenter.check_in_short %> — <%= presenter.check_out_date_year %></span><span class="mt-0.5 block text-[11px] font-bold uppercase tracking-wide text-slate-500"><%= presenter.nights_label %></span></td>
              <td class="whitespace-nowrap px-6 py-3 text-sm font-black text-slate-900"><%= presenter.formatted_currency_total %></td>
              <td class="whitespace-nowrap px-6 py-3 text-right"><%= link_to "Open", hotel_booking_control_panel_path(current_hotel, booking, tab: "booking_details"), class: "inline-flex min-h-9 items-center rounded-lg border border-slate-200 bg-white px-3 py-1.5 text-xs font-bold text-slate-700 shadow-sm hover:border-slate-900 hover:bg-slate-50", data: { turbo_frame: "_top" } %></td>
            </tr>
          <% end %>
        <% else %>
          <tr><td colspan="6" class="px-6 py-12 text-center"><p class="text-sm font-bold text-slate-900">No bookings found</p><p class="mt-1 text-xs text-slate-500">Try adjusting your filters or search keywords.</p><%= link_to "Reset Filters", hotel_front_desk_path(current_hotel, tab: "bookings", view: "list"), class: "mt-4 inline-flex rounded-lg border border-slate-200 px-3 py-1.5 text-xs font-bold text-slate-700", aria: { label: "Reset booking filters" } if @query.present? || @booking_status.present? || @start_date.present? || @end_date.present? %></td></tr>
        <% end %>
      </tbody>
    </table>
  </div>

  <div class="space-y-3 p-4 lg:hidden">
    <% if @bookings.any? %>
      <% @bookings.each do |booking| %>
        <% presenter = HotelPortal::BookingPresenter.new(booking, current_hotel) %>
        <article class="rounded-xl border border-slate-200 p-4 shadow-sm <%= booking.blacklisted? ? 'border-t-4 border-t-rose-600 bg-rose-100' : 'bg-white' %>">
          <div class="flex items-start justify-between gap-3"><div><p class="text-xs font-black text-slate-500"><%= presenter.confirmation_token %></p><p class="mt-1 text-sm font-bold text-slate-900"><%= presenter.guest_name %></p></div><span class="inline-flex rounded-md border px-1.5 py-0.5 text-[10px] font-black uppercase <%= presenter.status_variant_class %>"><%= presenter.status_label_humanized %></span></div>
          <dl class="mt-4 grid grid-cols-2 gap-4 text-sm"><div><dt class="text-[10px] font-bold uppercase text-slate-400">Stay Dates</dt><dd class="mt-1 font-semibold"><%= presenter.check_in_short %> — <%= presenter.check_out_date_year %><br><span class="text-xs text-slate-500"><%= presenter.nights_label %></span></dd></div><div class="text-right"><dt class="text-[10px] font-bold uppercase text-slate-400">Amount</dt><dd class="mt-1 font-black"><%= presenter.formatted_currency_total %></dd></div></dl>
          <div class="mt-4 flex justify-end border-t border-slate-100 pt-4"><%= link_to "Open", hotel_booking_control_panel_path(current_hotel, booking, tab: "booking_details"), class: "inline-flex min-h-9 items-center rounded-lg border border-slate-200 bg-white px-4 py-1.5 text-xs font-bold text-slate-700 shadow-sm", data: { turbo_frame: "_top" } %></div>
        </article>
      <% end %>
    <% else %>
      <div class="py-10 text-center text-sm text-slate-500"><p>No bookings found.</p><%= link_to "Reset Filters", hotel_front_desk_path(current_hotel, tab: "bookings", view: "list"), class: "mt-4 inline-flex rounded-lg border border-slate-200 px-3 py-1.5 text-xs font-bold text-slate-700", aria: { label: "Reset booking filters" } if @query.present? || @booking_status.present? || @start_date.present? || @end_date.present? %></div>
    <% end %>
  </div>

  <% if @bookings.total_pages > 1 %><div class="flex justify-center border-t border-slate-200 bg-slate-50/70 p-4"><%= paginate @bookings, param_name: @page_param %></div><% end %>
</section>
