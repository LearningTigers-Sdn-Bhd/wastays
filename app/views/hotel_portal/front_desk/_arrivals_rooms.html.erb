<section aria-label="Reservation view" class="space-y-4 rounded-xl border border-slate-200 bg-slate-50/70 p-4 shadow-sm">
  <% if @bookings.any? %>
    <div class="grid grid-cols-1 gap-4 md:grid-cols-2 2xl:grid-cols-3">
      <% @bookings.each do |booking| %>
        <% presenter = HotelPortal::ArrivalPresenter.new(booking, current_hotel) %>
        <% room_numbers = booking.booking_rooms.filter_map { |room| room.room_number.presence }.join(" · ").presence || "Unassigned" %>
        <% nights = booking.check_in && booking.check_out ? (booking.check_out.to_date - booking.check_in.to_date).to_i : nil %>
        <% transactions = booking.booking_folios.flat_map { |folio| folio.folio_transactions.to_a } %>
        <% balance = transactions.sum { |transaction| transaction.amount.to_d } %>
        <% total = booking.total_amount.to_d %>
        <% paid = [total - balance, 0].max %>
        <% actions = [{ label: "View booking", path: hotel_booking_control_panel_path(current_hotel, booking, tab: "booking_details") }] %>
        <% if presenter.status == "confirmed" && current_user.has_permission?("manage_bookings", hotel: current_hotel) %><% actions << { label: "Check in", path: hotel_booking_transaction_check_in_reservation_path(current_hotel, booking, return_to: request.fullpath), data: { turbo_frame: "offcanvas_drawer", offcanvas_variant: "right" } } %><% elsif presenter.status == "checked_in" && current_user.has_permission?("manage_bookings", hotel: current_hotel) %><% actions << { label: "Edit check-in time", path: hotel_booking_transaction_check_in_reservation_path(current_hotel, booking, return_to: request.fullpath), data: { turbo_frame: "offcanvas_drawer", offcanvas_variant: "right" } } %><% end %>
        <article class="front-desk-stay-card min-w-0 overflow-hidden rounded-xl border border-slate-200 bg-white shadow-sm">
          <header class="flex min-w-0 items-stretch gap-3 border-b border-slate-200 p-4">
            <span class="flex max-w-[35%] shrink-0 items-center truncate border-r border-slate-200 pr-3 <%= room_numbers == 'Unassigned' ? 'text-xs font-semibold text-slate-600' : 'text-lg font-black tracking-tight text-blue-700' %>"><span class="<%= 'inline-flex rounded-md bg-slate-100 px-2 py-1' if room_numbers == 'Unassigned' %>"><%= room_numbers %></span></span>
            <div class="min-w-0 flex-1">
              <div class="flex min-w-0 items-center gap-1.5"><p class="truncate text-sm font-bold text-slate-950"><%= presenter.guest_name %></p><% [("VIP" if presenter.vip?), ("Blacklisted" if presenter.blacklisted?), ("Repeat" if presenter.repeat?)].compact.each do |marker| %><span class="shrink-0 text-[9px] font-bold uppercase text-slate-400"><%= marker %></span><% end %></div>
              <p class="mt-0.5 truncate font-mono text-xs text-slate-500"><%= presenter.confirmation_token %></p>
            </div>
            <%= render "card_action_menu", actions: %>
          </header>
          <section class="mx-4 mt-4 flex items-center gap-3 rounded-lg bg-slate-50 px-3 py-2 text-sm">
            <div class="min-w-0 flex-1"><p class="text-[10px] font-bold uppercase tracking-widest text-slate-500">Arrival</p><p class="mt-1 truncate"><%= booking.check_in&.strftime("%d %b") || "—" %></p></div>
            <span class="-my-2 self-stretch border-l border-slate-300" aria-hidden="true"></span>
            <div class="shrink-0 text-center"><p class="text-[10px] font-bold uppercase tracking-widest text-slate-500">Stay</p><p class="mt-1 font-semibold text-slate-950"><%= nights ? pluralize(nights, "night") : "—" %></p></div>
            <span class="-my-2 self-stretch border-l border-slate-300" aria-hidden="true"></span>
            <div class="min-w-0 flex-1 text-right"><p class="text-[10px] font-bold uppercase tracking-widest text-slate-500">Departure</p><p class="mt-1 truncate"><%= booking.check_out&.strftime("%d %b") || "—" %></p></div>
          </section>
          <section class="px-4 py-3 text-sm text-slate-700"><span class="font-semibold text-slate-950">Pre-check-in:</span> <%= presenter.pre_checkin_status_label %></section>
          <dl class="grid grid-cols-2 gap-x-6 gap-y-4 px-4 pb-4 text-sm">
            <div class="min-w-0"><dt class="text-[10px] font-bold uppercase tracking-widest text-slate-500">Rooms</dt><dd class="mt-1 break-words text-slate-950"><%= presenter.rooms_summary.join(", ").presence || "No rooms assigned" %></dd></div>
            <div class="min-w-0"><dt class="text-[10px] font-bold uppercase tracking-widest text-slate-500">Occupancy</dt><dd class="mt-1 text-slate-950"><%= presenter.adults %> adults, <%= presenter.children %> children</dd></div>
            <div class="min-w-0"><dt class="text-[10px] font-bold uppercase tracking-widest text-slate-500">Guarantee</dt><dd class="mt-1 break-words text-slate-950"><%= presenter.guarantee_method_display %> · <%= presenter.deposit_status_label %></dd></div>
            <div class="min-w-0"><dt class="text-[10px] font-bold uppercase tracking-widest text-slate-500">Docs / Notes</dt><dd class="mt-1 break-words text-slate-950"><%= presenter.document_uploaded? ? "Documents uploaded" : "No documents" %><%= "; #{presenter.notes_count_label}" if presenter.has_notes? %></dd></div>
          </dl>
          <dl class="mx-4 mb-4 grid grid-cols-3 gap-3 rounded-lg bg-slate-50 px-3 py-2 text-sm tabular-nums">
            <div><dt class="text-[10px] font-bold uppercase tracking-widest text-slate-500">Total</dt><dd class="mt-1 font-semibold text-slate-950"><%= number_to_currency(total, unit: "RM ") %></dd></div>
            <div><dt class="text-[10px] font-bold uppercase tracking-widest text-slate-500">Paid</dt><dd class="mt-1 font-semibold text-slate-950"><%= number_to_currency(paid, unit: "RM ") %></dd></div>
            <div class="text-right"><dt class="text-[10px] font-bold uppercase tracking-widest text-slate-500">Balance</dt><dd class="mt-1 font-semibold <%= balance.positive? ? 'text-rose-600' : 'text-slate-950' %>"><%= number_to_currency(balance, unit: "RM ") %></dd></div>
          </dl>
        </article>
      <% end %>
    </div>
  <% else %>
    <div class="rounded-xl border border-slate-200 bg-white px-4 py-12 text-center text-sm text-slate-500 shadow-sm">No arrivals scheduled for this date.</div>
  <% end %>
  <div class="flex justify-center rounded-xl border border-slate-200 bg-white p-4 shadow-sm"><%= paginate @bookings, param_name: @page_param %></div>
</section>
