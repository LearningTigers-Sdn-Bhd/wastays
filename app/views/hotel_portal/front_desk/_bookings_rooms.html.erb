<section aria-label="Booking room view" class="space-y-4 rounded-xl border border-border bg-muted p-4 shadow-sm">
  <% if @bookings.any? %>
    <div class="grid grid-cols-1 gap-3 md:grid-cols-2 xl:grid-cols-4">
      <% @bookings.each do |booking| %>
        <% presenter = HotelPortal::BookingPresenter.new(booking, current_hotel) %>
        <% room_numbers = booking.booking_rooms.filter_map { |room| room.room_number.presence }.join(" · ").presence || "Unassigned" %>
        <% room_details = booking.booking_rooms.group_by { |room| room.room_type_snapshot["name"].presence || room.room_type.name }.map { |name, rooms| "#{rooms.size}x #{name}" }.join(", ").presence || "No rooms assigned" %>
        <% nights = booking.check_in && booking.check_out ? (booking.check_out.to_date - booking.check_in.to_date).to_i : nil %>
        <% transactions = booking.booking_folios.flat_map { |folio| folio.folio_transactions.to_a } %>
        <% balance = transactions.sum { |transaction| transaction.amount.to_d } %>
        <% total = booking.total_amount.to_d %>
        <% paid = [total - balance, 0].max %>
        <% actions = [{ label: "Open booking", path: hotel_booking_control_panel_path(current_hotel, booking, tab: "booking_details") }] %>
        <% if current_user.has_permission?("view_bookings", hotel: current_hotel) && current_hotel.feature_enabled?("full_audit_trail") %><% actions << { label: "Audit trail", path: audit_trail_hotel_booking_control_panel_path(current_hotel, booking), data: { turbo_frame: "offcanvas_drawer", offcanvas_variant: "right" } } %><% end %>
        <article class="front-desk-stay-card min-w-0 overflow-hidden rounded-xl border border-border bg-card shadow-sm <%= 'border-destructive bg-muted' if presenter.blacklisted? %>">
          <header class="flex min-w-0 items-stretch gap-2 border-b border-border p-3">
            <span class="flex max-w-[35%] shrink-0 items-center border-r border-border pr-3 <%= room_numbers == 'Unassigned' ? 'flex-col justify-center text-xs font-medium leading-tight text-muted-foreground' : 'truncate text-lg font-semibold tracking-tight text-primary' %>"><span><%= room_numbers %></span><% if room_numbers == "Unassigned" %><span class="mt-0.5">Room</span><% end %></span>
            <div class="min-w-0 flex-1">
              <div class="flex min-w-0 flex-wrap items-start gap-1.5"><p class="min-w-0 flex-1 break-words text-sm font-semibold text-foreground"><%= presenter.guest_name %></p><% [("VIP" if presenter.vip?), ("Blacklisted" if presenter.blacklisted?), ("Repeat" if presenter.repeat?)].compact.each do |marker| %><span class="shrink-0 text-xs font-medium text-muted-foreground"><%= marker %></span><% end %></div>
              <p class="mt-0.5 truncate font-mono text-xs text-muted-foreground"><%= presenter.confirmation_token %></p>
            </div>
            <%= render "card_action_menu", actions: %>
          </header>
          <section class="mx-3 mt-3 flex items-center gap-2 rounded-lg bg-muted px-3 py-2 text-sm">
            <div class="min-w-0 flex-1"><p class="text-xs font-medium text-muted-foreground">Arrival</p><p class="mt-1 truncate"><%= booking.check_in&.strftime("%d %b") || "—" %></p></div>
            <span class="-my-2 self-stretch border-l border-border" aria-hidden="true"></span>
            <div class="shrink-0 text-center"><p class="text-xs font-medium text-muted-foreground">Stay</p><p class="mt-1 font-semibold text-foreground"><%= nights ? pluralize(nights, "night") : "—" %></p></div>
            <span class="-my-2 self-stretch border-l border-border" aria-hidden="true"></span>
            <div class="min-w-0 flex-1 text-right"><p class="text-xs font-medium text-muted-foreground">Departure</p><p class="mt-1 truncate"><%= booking.check_out&.strftime("%d %b") || "—" %></p></div>
          </section>
          <section class="px-3 py-3">
            <div class="flex min-w-0 items-center justify-between gap-3">
              <span class="inline-flex shrink-0 rounded-md border px-2 py-0.5 text-xs font-medium <%= presenter.status_variant_class %>"><%= presenter.status_label_humanized %></span>
              <div class="flex items-center gap-2 text-sm font-semibold text-muted-foreground">
                <span class="inline-flex items-center gap-1" aria-label="<%= pluralize(booking.adults, "adult") %>"><%= cached_icon "user", class: "size-4", aria: { hidden: true } %><span aria-hidden="true"><%= booking.adults %></span></span>
                <span class="inline-flex items-center gap-1" aria-label="<%= pluralize(booking.children, "child") %>"><%= cached_icon "baby", class: "size-4", aria: { hidden: true } %><span aria-hidden="true"><%= booking.children %></span></span>
              </div>
            </div>
            <dl class="mt-3 grid grid-cols-2 gap-3 text-sm">
              <div class="min-w-0"><dt class="text-xs font-medium text-muted-foreground">Room type</dt><dd class="mt-1 break-words text-muted-foreground"><%= room_details %></dd></div>
              <div class="min-w-0"><dt class="text-xs font-medium text-muted-foreground">Booking date</dt><dd class="mt-1 text-foreground"><%= booking.created_at.in_time_zone(current_hotel.hotel_time_zone).strftime("%d %b %Y") %></dd></div>
            </dl>
          </section>
          <dl class="mx-3 mb-3 grid grid-cols-3 gap-2 rounded-lg bg-muted px-3 py-2 text-sm tabular-nums">
            <div class="min-w-0"><dt class="text-xs font-medium text-muted-foreground">Total</dt><dd class="mt-1 whitespace-nowrap text-xs font-semibold text-foreground"><%= number_to_currency(total, unit: "RM ") %></dd></div>
            <div class="min-w-0"><dt class="text-xs font-medium text-muted-foreground">Paid</dt><dd class="mt-1 whitespace-nowrap text-xs font-semibold text-foreground"><%= number_to_currency(paid, unit: "RM ") %></dd></div>
            <div class="min-w-0 text-right"><dt class="text-xs font-medium text-muted-foreground">Balance</dt><dd class="mt-1 whitespace-nowrap text-xs font-semibold <%= balance.positive? ? 'text-destructive' : 'text-foreground' %>"><%= number_to_currency(balance, unit: "RM ") %></dd></div>
          </dl>
        </article>
      <% end %>
    </div>
  <% else %>
    <div class="rounded-xl border border-border bg-card px-4 py-12 text-center text-sm text-muted-foreground shadow-sm"><p>No bookings found.</p><%= link_to "Reset Filters", hotel_front_desk_path(current_hotel, tab: "bookings", view: "rooms"), class: "mt-4 inline-flex rounded-lg border border-border-interactive px-3 py-1.5 text-xs font-medium text-foreground", aria: { label: "Reset booking filters" } if @query.present? || @booking_status.present? || @start_date.present? || @end_date.present? %></div>
  <% end %>
  <% if @bookings.total_pages > 1 %><div class="flex justify-center rounded-xl border border-border bg-card p-4 shadow-sm"><%= paginate @bookings, param_name: @page_param %></div><% end %>
</section>
