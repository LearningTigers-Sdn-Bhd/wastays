<section aria-label="Booking room view" class="space-y-4 rounded-xl border border-slate-200 bg-slate-50/70 p-4 shadow-sm">
  <% if @bookings.any? %>
    <div class="grid grid-cols-1 gap-4 md:grid-cols-2 2xl:grid-cols-3">
      <% @bookings.each do |booking| %>
        <% presenter = HotelPortal::BookingPresenter.new(booking, current_hotel) %>
        <% room_numbers = booking.booking_rooms.filter_map { |room| room.room_number.presence }.join(" · ").presence || "Unassigned" %>
        <% room_details = booking.booking_rooms.group_by { |room| room.room_type_snapshot["name"].presence || room.room_type.name }.map { |name, rooms| "#{rooms.size}x #{name}" }.join(", ").presence || "No rooms assigned" %>
        <% nights = booking.check_in && booking.check_out ? (booking.check_out.to_date - booking.check_in.to_date).to_i : nil %>
        <% transactions = booking.booking_folios.flat_map { |folio| folio.folio_transactions.to_a } %>
        <% balance = transactions.sum { |transaction| transaction.amount.to_d } %>
        <% total = booking.total_amount.to_d %>
        <% paid = [total - balance, 0].max %>
        <% actions = [{ label: "Open booking", path: hotel_booking_control_panel_path(current_hotel, booking, tab: "booking_details") }] %>
        <article class="front-desk-stay-card min-w-0 overflow-hidden rounded-xl border border-slate-200 bg-white shadow-sm <%= 'border-rose-300 bg-rose-50/30' if presenter.blacklisted? %>">
          <header class="flex min-w-0 items-stretch gap-3 border-b border-slate-200 p-4">
            <span class="flex max-w-[35%] shrink-0 items-center truncate border-r border-slate-200 pr-3 <%= room_numbers == 'Unassigned' ? 'text-xs font-semibold text-slate-600' : 'text-lg font-black tracking-tight text-blue-700' %>"><span class="<%= 'inline-flex rounded-md bg-slate-100 px-2 py-1' if room_numbers == 'Unassigned' %>"><%= room_numbers %></span></span>
            <div class="min-w-0 flex-1">
              <div class="flex min-w-0 items-center gap-1.5"><p class="truncate text-sm font-bold text-slate-950"><%= presenter.guest_name %></p><% [("VIP" if presenter.vip?), ("Blacklisted" if presenter.blacklisted?), ("Repeat" if presenter.repeat?)].compact.each do |marker| %><span class="shrink-0 text-[9px] font-bold uppercase text-slate-400"><%= marker %></span><% end %></div>
              <p class="mt-0.5 truncate font-mono text-xs text-slate-500"><%= presenter.confirmation_token %></p>
            </div>
            <%= render "card_action_menu", actions: %>
          </header>
          <section class="mx-4 mt-4 flex items-center gap-3 rounded-lg bg-slate-50 px-3 py-2 text-sm">
            <div class="min-w-0 flex-1"><p class="text-[10px] font-bold uppercase tracking-widest text-slate-500">Arrival</p><p class="mt-1 truncate"><%= booking.check_in&.strftime("%d %b %Y") || "—" %></p></div>
            <span class="-my-2 self-stretch border-l border-slate-300" aria-hidden="true"></span>
            <div class="shrink-0 text-center"><p class="text-[10px] font-bold uppercase tracking-widest text-slate-500">Stay</p><p class="mt-1 font-semibold text-slate-950"><%= nights ? pluralize(nights, "night") : "—" %></p></div>
            <span class="-my-2 self-stretch border-l border-slate-300" aria-hidden="true"></span>
            <div class="min-w-0 flex-1 text-right"><p class="text-[10px] font-bold uppercase tracking-widest text-slate-500">Departure</p><p class="mt-1 truncate"><%= booking.check_out&.strftime("%d %b %Y") || "—" %></p></div>
          </section>
          <section class="px-4 py-4">
            <div class="flex min-w-0 items-center justify-between gap-3">
              <span class="inline-flex shrink-0 rounded-md border px-2 py-0.5 text-xs font-black uppercase tracking-wider <%= presenter.status_variant_class %>"><%= presenter.status_label_humanized %></span>
              <p class="truncate text-sm font-semibold text-slate-700"><%= pluralize(booking.adults, "adult") %> · <%= pluralize(booking.children, "child") %></p>
            </div>
            <dl class="mt-4 grid grid-cols-1 gap-x-6 gap-y-3 text-sm sm:grid-cols-2">
              <div class="min-w-0 sm:col-span-2"><dt class="text-[10px] font-bold uppercase tracking-widest text-slate-500">Room type</dt><dd class="mt-1 break-words text-slate-700"><%= room_details %></dd></div>
              <div class="min-w-0"><dt class="text-[10px] font-bold uppercase tracking-widest text-slate-500">Email</dt><dd class="mt-1 break-all text-slate-950"><%= presenter.guest_email_display %></dd></div>
              <div class="min-w-0"><dt class="text-[10px] font-bold uppercase tracking-widest text-slate-500">Phone</dt><dd class="mt-1 break-words text-slate-950"><%= presenter.guest_phone_display %></dd></div>
            </dl>
          </section>
          <dl class="mx-4 mb-4 grid grid-cols-3 gap-3 rounded-lg bg-slate-50 px-3 py-2 text-sm tabular-nums">
            <div><dt class="text-[10px] font-bold uppercase tracking-widest text-slate-500">Total</dt><dd class="mt-1 font-semibold text-slate-950"><%= number_to_currency(total, unit: "RM ") %></dd></div>
            <div><dt class="text-[10px] font-bold uppercase tracking-widest text-slate-500">Paid</dt><dd class="mt-1 font-semibold text-slate-950"><%= number_to_currency(paid, unit: "RM ") %></dd></div>
            <div class="text-right"><dt class="text-[10px] font-bold uppercase tracking-widest text-slate-500">Balance</dt><dd class="mt-1 font-semibold <%= balance.positive? ? 'text-rose-600' : 'text-slate-950' %>"><%= number_to_currency(balance, unit: "RM ") %></dd></div>
          </dl>
        </article>
      <% end %>
    </div>
  <% else %>
    <div class="rounded-xl border border-slate-200 bg-white px-4 py-12 text-center text-sm text-slate-500 shadow-sm"><p>No bookings found.</p><%= link_to "Reset Filters", hotel_front_desk_path(current_hotel, tab: "bookings", view: "rooms"), class: "mt-4 inline-flex rounded-lg border border-slate-200 px-3 py-1.5 text-xs font-bold text-slate-700", aria: { label: "Reset booking filters" } if @query.present? || @booking_status.present? || @start_date.present? || @end_date.present? %></div>
  <% end %>
  <% if @bookings.total_pages > 1 %><div class="flex justify-center rounded-xl border border-slate-200 bg-white p-4 shadow-sm"><%= paginate @bookings, param_name: @page_param %></div><% end %>
</section>
