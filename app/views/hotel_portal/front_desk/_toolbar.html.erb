<% view_state = state.merge(tab: @tab) %>
<div class="rounded-xl border border-slate-200 bg-white p-4 shadow-sm">
  <%= form_with url: hotel_front_desk_path(current_hotel), method: :get, class: "flex flex-col gap-3 lg:flex-row lg:items-center", data: { controller: "auto-submit" } do |form| %>
    <% search_key = @tab == "bookings" ? :booking_query : @tab == "arrivals" ? :arrival_q : @tab == "in_house" ? :in_house_query : :departure_query %>
    <% excluded = [search_key, @page_param] + (@tab.in?(["bookings", "arrivals", "departures"]) ? [:start_date, :end_date] : []) %>
    <% state.except(*excluded).merge(tab: @tab, view: @view).each { |key, value| concat hidden_field_tag(key, value) } %>
    <div class="relative min-w-72 flex-1">
      <%= cached_icon "magnifying-glass", class: "pointer-events-none absolute left-3 top-1/2 size-4 -translate-y-1/2 text-slate-400" %>
      <%= form.search_field search_key, value: @query, placeholder: "Search guest, contact, or booking reference", class: "w-full rounded-lg border border-slate-200 bg-white py-2 pl-9 pr-3 text-sm text-slate-950 placeholder:text-slate-400 focus:border-blue-600 focus:outline-none focus:ring-2 focus:ring-blue-600/20", data: { action: "input->auto-submit#submit" } %>
    </div>
    <nav class="inline-flex shrink-0 rounded-lg border border-slate-200 bg-slate-50 p-1" aria-label="Reservation view">
      <% { "list" => "List", "rooms" => "Rooms" }.each do |view, label| %>
        <%= link_to hotel_front_desk_path(current_hotel, view_state.merge(view:)), class: "inline-flex items-center gap-2 rounded-md px-3 py-2 text-sm font-semibold transition-colors #{view == @view ? 'bg-blue-600 text-white shadow-sm' : 'text-slate-600 hover:bg-white'}" do %>
          <%= cached_icon(view == "list" ? "list" : "bed", class: "size-4") %><%= label %>
        <% end %>
      <% end %>
    </nav>
    <% if @tab.in?(["bookings", "arrivals", "departures"]) %>
      <div class="relative shrink-0" data-controller="front-desk-date-range">
        <%= form.hidden_field :start_date, value: @start_date, data: { front_desk_date_range_target: "start" } %>
        <%= form.hidden_field :end_date, value: @end_date, data: { front_desk_date_range_target: "end" } %>
        <button type="button" class="inline-flex min-h-10 items-center gap-2 rounded-lg border border-slate-200 bg-white px-3 py-2 text-sm font-semibold text-slate-700 shadow-sm hover:bg-slate-50 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-600" data-front-desk-date-range-target="button" data-action="click->front-desk-date-range#toggle" aria-label="Select date range" aria-controls="front-desk-date-range-panel" aria-expanded="false">
          <%= cached_icon "calendar-range", class: "size-4 text-slate-400" %>
          <span data-front-desk-date-range-target="display"><%= @start_date ? "#{@start_date.strftime("%d %b %Y")} - #{@end_date.strftime("%d %b %Y")}" : "All stay dates" %></span>
        </button>
        <div id="front-desk-date-range-panel" class="absolute right-0 top-full z-[200] mt-2 hidden w-[min(42rem,calc(100vw-2rem))] rounded-2xl border border-slate-200 bg-white p-4 shadow-2xl" data-front-desk-date-range-target="panel">
          <div class="mb-4 flex items-center justify-between border-b border-slate-200 pb-3">
            <button type="button" class="rounded-lg p-2 text-slate-500 hover:bg-slate-100" data-action="click->front-desk-date-range#previousMonth" aria-label="Previous month"><%= cached_icon "chevron-left", class: "size-4" %></button>
            <span class="text-xs font-semibold text-slate-500">Select date range</span>
            <button type="button" class="rounded-lg p-2 text-slate-500 hover:bg-slate-100" data-action="click->front-desk-date-range#nextMonth" aria-label="Next month"><%= cached_icon "chevron-right", class: "size-4" %></button>
          </div>
          <div class="grid gap-6 lg:grid-cols-2" data-front-desk-date-range-target="months"></div>
          <div class="mt-4 flex justify-center gap-4 border-t border-slate-200 pt-3">
            <button type="button" class="text-sm font-bold text-blue-600 hover:text-blue-800" data-action="click->front-desk-date-range#selectToday">Today</button>
            <button type="button" class="text-sm font-bold text-slate-600 hover:text-slate-950" data-action="click->front-desk-date-range#clearDates">Clear dates</button>
          </div>
        </div>
      </div>
    <% end %>
  <% end %>
  <% if @tab == "bookings" %>
    <div class="mt-4 flex items-center gap-2 overflow-x-auto py-1">
      <% [[nil, "All"]].concat(HotelPortal::FrontDesk::BookingsQuery::STATUSES.map { |status| [status, status.humanize] }).each do |status, label| %>
        <%= link_to hotel_front_desk_path(current_hotel, state.except(:booking_status, :booking_page).merge(tab: "bookings", view: "list", booking_status: status).compact), class: "inline-flex shrink-0 items-center gap-1.5 rounded-full border px-4 py-1.5 text-xs font-bold uppercase tracking-wider shadow-sm #{status == @booking_status ? 'border-slate-900 bg-slate-900 text-white' : 'border-slate-200 bg-white text-slate-600 hover:bg-slate-50'}" do %>
          <%= cached_icon(status ? booking_status_icon(status) : "filter", class: "size-3.5") %><%= label %>
        <% end %>
      <% end %>
    </div>
  <% end %>
</div>
