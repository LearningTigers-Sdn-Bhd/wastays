<%= render PanelsUI::Table.new(caption: "Checked out guests", header_style: :sentence, hoverable: true, bordered: true) do |table| %>
  <% table.with_header do %>
    <tr>
      <th scope="col">Guest / Reference</th>
      <th scope="col">Contact</th>
      <th scope="col">Stay dates</th>
      <th scope="col">Checked in</th>
      <th scope="col">Checked out</th>
      <th scope="col">Rooms</th>
      <th scope="col" class="text-right">Actions</th>
    </tr>
  <% end %>
  <% table.with_body do %>
    <% @bookings.each do |booking| %>
      <% presenter = HotelPortal::BookingPresenter.new(booking, current_hotel) %>
      <% rooms_summary = booking.booking_rooms.group_by { |room| room.room_type_snapshot["name"].presence || room.room_type.name }.map { |name, rooms| "#{rooms.size}x #{name}" }.join(", ").presence || "No rooms assigned" %>
      <tr class="align-top <%= "bg-muted" if presenter.blacklisted? %>" data-booking-token="<%= booking.confirmation_token %>">
        <th scope="row">
          <div class="flex items-center gap-1.5">
            <span class="font-semibold text-foreground"><%= booking.guest_name %></span>
            <%= render "guest_markers", presenter:, labelled: true %>
          </div>
          <span class="font-mono text-xs font-normal text-muted-foreground"><%= booking.confirmation_token %></span>
        </th>
        <td><%= booking.guest_email %><br><span class="text-xs text-muted-foreground"><%= booking.guest_phone %></span></td>
        <td><%= booking.check_in.strftime("%d %b %Y") %> to <%= booking.check_out.strftime("%d %b %Y") %></td>
        <td><%= booking.checked_in_at&.in_time_zone(current_user.time_zone)&.strftime("%d %b %Y, %I:%M %p") || "—" %></td>
        <td><%= booking.checked_out_at&.in_time_zone(current_user.time_zone)&.strftime("%d %b %Y, %I:%M %p") || "—" %></td>
        <td><%= rooms_summary %></td>
        <td class="whitespace-nowrap text-right">
          <%= link_to "View booking", hotel_booking_workspace_path(current_hotel, booking, tab: "booking_details"), class: "inline-flex min-h-9 items-center rounded-lg border border-border-interactive px-3 py-1.5 text-sm font-semibold text-foreground hover:bg-muted focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2" %>
        </td>
      </tr>
    <% end %>
  <% end %>
<% end %>
