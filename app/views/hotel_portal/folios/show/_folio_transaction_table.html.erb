<% folio = booking.booking_folio %>
<% projected_lines = Array(local_assigns[:projected_lines]) %>
<% header_action = local_assigns[:header_action] %>
<% transaction_count = (folio&.folio_transactions&.count || 0) + projected_lines.size %>

<div class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">
  <div class="border-b border-slate-200 bg-slate-50/70 px-6 py-4 flex items-center justify-between">
    <h3 class="text-sm font-black text-slate-900 uppercase tracking-widest">Transaction Ledger</h3>
    <div class="flex items-center gap-3">
      <% if header_action.present? %>
        <%= header_action %>
      <% end %>
      <div class="text-[10px] font-bold text-slate-400 uppercase tracking-widest">
        <%= transaction_count %> entries
      </div>
    </div>
  </div>
  <div class="p-0 overflow-x-auto">
    <table class="w-full text-left text-sm">
      <thead>
        <tr class="bg-slate-50/50 border-b border-slate-200">
          <th class="px-6 py-3 font-bold text-slate-900 uppercase tracking-wider text-[10px]">ID</th>
          <th class="px-6 py-3 font-bold text-slate-900 uppercase tracking-wider text-[10px]">Date</th>
          <th class="px-6 py-3 font-bold text-slate-900 uppercase tracking-wider text-[10px]">Description</th>
          <th class="px-6 py-3 font-bold text-slate-900 uppercase tracking-wider text-[10px]">General Ledger Code (GL Code)</th>
          <th class="px-6 py-3 font-bold text-slate-900 uppercase tracking-wider text-[10px]">Staff / Source</th>
          <th class="px-6 py-3 font-bold text-slate-900 uppercase tracking-wider text-[10px] text-right">Amount</th>
          <th class="px-6 py-3"></th>
        </tr>
      </thead>
      <tbody class="divide-y divide-slate-100">
        <% if folio&.folio_transactions&.any? || projected_lines.any? %>
          <% if projected_lines.any? %>
            <% projected_lines.each do |line| %>
              <tr class="border-l-4 border-amber-300 bg-amber-50/60">
                <td class="px-6 py-4 font-mono text-[10px] text-amber-600 uppercase tracking-widest">Pending</td>
                <td class="px-6 py-4 text-slate-600 whitespace-nowrap font-medium text-[12px]"><%= line[:date].strftime("%d %b %Y") %></td>
                <td class="px-6 py-4">
                  <div class="flex items-center gap-2">
                    <p class="font-bold text-slate-900"><%= line[:description] %></p>
                    <span title="This projected line is expected to post during night audit." class="inline-flex size-5 items-center justify-center rounded-full bg-amber-100 text-amber-700">
                      <%= cached_icon "info", stroke_width: 2.5, class: "size-3" %>
                    </span>
                  </div>
                  <div class="flex items-center gap-2 mt-0.5">
                    <span class="text-[9px] font-bold uppercase tracking-widest px-1.5 py-0.5 rounded bg-amber-100 text-amber-700">charge</span>
                    <span class="text-[9px] font-bold uppercase tracking-widest text-amber-600"><%= line[:category].to_s.tr("_", " ") %></span>
                  </div>
                </td>
                <td class="px-6 py-4 font-mono text-[11px] text-slate-500">-</td>
                  <td class="px-6 py-4">
                    <p class="text-[12px] font-bold text-amber-800">Forecast</p>
                    <p class="text-[10px] text-amber-500 uppercase tracking-widest font-bold">Pending</p>
                  </td>
                <td class="px-6 py-4 text-right font-black text-amber-900 text-[15px]">
                  + <%= booking.currency.presence || "MYR" %> <%= number_with_precision(line[:amount].to_d, precision: 2) %>
                </td>
                <td class="px-6 py-4 text-right"></td>
              </tr>
            <% end %>
          <% end %>

          <% if folio&.folio_transactions&.any? %>
          <% folio.folio_transactions.order(posting_date: :asc, created_at: :asc).each do |tx| %>
            <tr class="<%= "opacity-50 bg-slate-50/30" if tx.reversed? %>">
              <td class="px-6 py-4 font-mono text-[10px] text-slate-400">#<%= tx.id.to_s.last(6) %></td>
              <td class="px-6 py-4 text-slate-600 whitespace-nowrap font-medium text-[12px]"><%= tx.posting_date.strftime("%d %b %Y") %></td>
              <td class="px-6 py-4">
                <div class="flex items-center gap-2">
                  <p class="font-bold text-slate-900 <%= "line-through text-slate-400" if tx.reversed? %>"><%= tx.description %></p>
                  <% if tx.reversed? %>
                    <span class="inline-flex items-center px-1.5 py-0.5 rounded text-[9px] font-black bg-slate-100 text-slate-500 uppercase tracking-tighter">REVERSED</span>
                  <% elsif tx.reversal_of_transaction_id.present? %>
                    <span class="inline-flex items-center px-1.5 py-0.5 rounded text-[9px] font-black bg-amber-100 text-amber-700 uppercase tracking-tighter">REVERSAL</span>
                  <% end %>
                </div>
                <div class="flex items-center gap-2 mt-0.5">
                  <span class="text-[9px] font-bold uppercase tracking-widest px-1.5 py-0.5 rounded bg-slate-100 text-slate-500"><%= tx.transaction_type %></span>
                  <span class="text-[9px] font-bold uppercase tracking-widest text-slate-400"><%= tx.category.tr("_", " ") %></span>
                </div>
              </td>
              <td class="px-6 py-4 font-mono text-[11px] text-slate-500"><%= tx.gl_code || "-" %></td>
              <td class="px-6 py-4">
                <% if tx.user %>
                  <p class="text-[12px] font-bold text-slate-700"><%= tx.user.name %></p>
                  <p class="text-[10px] text-slate-400 uppercase tracking-widest font-bold">Manual</p>
                <% else %>
                  <p class="text-[12px] font-bold text-slate-500">Night Audit</p>
                  <p class="text-[10px] text-slate-400 uppercase tracking-widest font-bold">System</p>
                <% end %>
              </td>
              <td class="px-6 py-4 text-right font-black <%= folio_transaction_amount_class(tx) %> <%= "line-through" if tx.reversed? %> text-[15px]">
                <%= folio_transaction_amount_label(tx) %>
              </td>
              <td class="px-6 py-4 text-right"></td>
            </tr>
          <% end %>
          <% end %>
        <% else %>
          <tr>
            <td colspan="7" class="px-6 py-20 text-center">
              <div class="flex flex-col items-center">
                <div class="size-12 rounded-full bg-slate-50 flex items-center justify-center mb-4 text-slate-300">
                  <%= cached_icon "circle-alert", stroke_width: 2, class: "size-6" %>
                </div>
                <p class="text-sm font-bold text-slate-400 uppercase tracking-widest">No transactions recorded yet.</p>
              </div>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>
