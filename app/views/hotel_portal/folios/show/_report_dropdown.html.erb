<% folio_show = local_assigns.fetch(:folio_show) %>
<% booking = local_assigns.fetch(:booking) %>
<% hotel = local_assigns.fetch(:hotel) %>

<div class="relative inline-block text-left" data-controller="dropdown" data-dropdown-align="right">
  <button type="button" class="inline-flex items-center gap-1.5 rounded-lg border border-border bg-card px-3 py-2 text-xs font-black text-foreground shadow-sm transition hover:border-border-interactive hover:bg-muted" data-dropdown-target="button" data-action="click->dropdown#toggle keydown->dropdown#handleKeydown" aria-expanded="false" aria-haspopup="true">
    <%= cached_icon "file-text", class: "size-3" %>
    Generate Report
    <%= cached_icon "chevron-down", class: "size-3" %>
  </button>
  <div data-dropdown-target="menu" class="hidden absolute right-0 z-50 mt-2 w-60 origin-top-right rounded-2xl border border-border bg-card p-1.5 shadow-xl shadow-foreground/10 focus:outline-none" role="menu" aria-orientation="vertical" tabindex="-1">
    <div class="group relative">
      <button type="button" role="menuitem" aria-haspopup="true" class="flex w-full items-center gap-3 rounded-lg px-3 py-2.5 text-left text-sm font-semibold text-foreground hover:bg-muted focus-visible:bg-muted focus-visible:outline-none">
        <%= cached_icon "receipt-text", class: "size-4 text-muted-foreground" %>
        <span>Folio Ledger</span>
        <%= cached_icon "chevron-right", class: "ml-auto size-4 text-muted-foreground" %>
      </button>
      <div class="hidden absolute right-full top-0 z-50 mr-1 w-44 rounded-2xl border border-border bg-card p-1.5 shadow-xl shadow-foreground/10 group-hover:block group-focus-within:block" role="menu" aria-label="Folio Ledger exports">
        <%= link_to ledger_hotel_folio_path(hotel, booking, format: :pdf), role: "menuitem", target: "_blank", class: "flex w-full items-center gap-3 rounded-lg px-3 py-2.5 text-left text-sm font-semibold text-foreground hover:bg-muted focus-visible:bg-muted focus-visible:outline-none", data: { turbo: false } do %>
          <%= cached_icon "file-text", class: "size-4 text-muted-foreground" %>
          <span>Download PDF</span>
        <% end %>
        <%= link_to ledger_hotel_folio_path(hotel, booking, format: :csv), role: "menuitem", class: "flex w-full items-center gap-3 rounded-lg px-3 py-2.5 text-left text-sm font-semibold text-foreground hover:bg-muted focus-visible:bg-muted focus-visible:outline-none", data: { turbo: false } do %>
          <%= cached_icon "table", class: "size-4 text-muted-foreground" %>
          <span>Download CSV</span>
        <% end %>
      </div>
    </div>

    <% if folio_show.booking_invoice_report_available? %>
      <%= link_to invoice_hotel_folio_path(hotel, booking, format: :pdf), role: "menuitem", target: "_blank", class: "flex w-full items-center gap-3 rounded-lg px-3 py-2.5 text-left text-sm font-semibold text-foreground hover:bg-muted focus-visible:bg-muted focus-visible:outline-none", data: { turbo: false } do %>
        <%= cached_icon "file-text", class: "size-4 text-muted-foreground" %>
        <span>Booking Invoices</span>
      <% end %>
    <% else %>
      <button type="button" role="menuitem" disabled class="flex w-full cursor-not-allowed items-start gap-3 rounded-lg px-3 py-2.5 text-left text-sm font-semibold text-muted-foreground">
        <%= cached_icon "file-text", class: "mt-0.5 size-4 text-primary-foreground" %>
        <span>
          <span class="block">Booking Invoices</span>
          <span class="mt-0.5 block text-xs font-medium text-muted-foreground">Available after checkout.</span>
        </span>
      </button>
    <% end %>
  </div>
</div>
