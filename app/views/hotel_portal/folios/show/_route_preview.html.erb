<section class="overflow-hidden rounded-md border border-slate-200 bg-white">
  <div class="flex flex-col gap-2 border-b border-slate-200 p-4 sm:flex-row sm:items-center sm:justify-between">
    <div>
      <div class="flex items-center gap-2">
        <span class="inline-flex size-7 items-center justify-center rounded-md bg-slate-100 text-slate-700">
          <%= cached_icon "map", class: "size-3.5" %>
        </span>
        <h2 class="text-sm font-black uppercase tracking-[0.18em] text-slate-700">Route Preview</h2>
      </div>
      <p class="mt-1 text-sm font-medium text-slate-500">Preview only. This does not move posted transactions.</p>
    </div>
    <span class="text-xs font-medium tabular-nums text-slate-500"><%= pluralize(folio_show.route_preview_line_count, "expected line") %></span>
  </div>

  <div class="divide-y divide-slate-200">
    <% if folio_show.route_preview_groups.any? %>
      <% folio_show.route_preview_groups.each do |group| %>
        <section>
          <div class="flex items-center justify-between gap-4 bg-slate-50 px-4 py-3">
            <div>
              <p class="text-xs font-black uppercase tracking-wider text-slate-500">Target Folio</p>
              <p class="mt-0.5 text-sm font-bold text-slate-900"><%= group.target_label %></p>
              <% if group.target_reference.present? %>
                <p class="mt-0.5 font-mono text-[11px] text-slate-500"><%= group.target_reference %></p>
              <% end %>
            </div>
            <p class="text-sm font-black tabular-nums text-slate-950"><%= folio_show.money(group.total) %></p>
          </div>

          <div class="overflow-x-auto">
            <table class="w-full min-w-[760px] table-fixed text-left text-xs">
              <thead class="bg-white text-[10px] font-semibold uppercase tracking-wider text-slate-500">
                <tr class="border-b border-slate-100">
                  <th class="w-24 px-4 py-2">Date</th>
                  <th class="w-24 px-4 py-2">Code</th>
                  <th class="px-4 py-2">Expected Charge</th>
                  <th class="w-28 px-4 py-2 text-right">Amount</th>
                  <th class="w-28 px-4 py-2">Source</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-slate-100">
                <% group.rows.each do |row| %>
                  <tr>
                    <td class="px-4 py-3 font-medium tabular-nums text-slate-600"><%= row.date_label %></td>
                    <td class="px-4 py-3 font-mono text-xs font-bold text-slate-900"><%= row.code %></td>
                    <td class="px-4 py-3">
                      <p class="font-semibold text-slate-900"><%= row.description %></p>
                      <% if row.warning.present? %>
                        <p class="mt-0.5 text-[11px] font-bold text-amber-700"><%= row.warning %></p>
                      <% end %>
                    </td>
                    <td class="px-4 py-3 text-right font-black tabular-nums text-slate-950"><%= row.amount %></td>
                    <td class="px-4 py-3 text-xs font-semibold text-slate-600"><%= row.source %></td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          </div>
        </section>
      <% end %>
    <% else %>
      <div class="px-4 py-10 text-center text-sm font-medium text-slate-500">No expected future postings.</div>
    <% end %>
  </div>
</section>
