<% folio = booking.booking_folio %>
<% redirect_to_folio = local_assigns[:redirect_to_folio] || false %>
<% can_post = folio&.status == "open" %>
<% can_post_payment = can_post && current_user.has_permission?("post_folio_payments", hotel: hotel) %>
<% can_post_charge = can_post && current_user.has_permission?("post_folio_charges", hotel: hotel) %>
<% can_execute_refund = can_post && current_user.has_permission?("execute_folio_refunds", hotel: hotel) %>
<% adjustment_category_options = [] %>
<% adjustment_category_options += %w[adjustment discount other] if can_post && current_user.has_permission?("post_folio_adjustments", hotel: hotel) %>
<% adjustment_category_options << "correction" if can_post && current_user.has_permission?("post_folio_corrections", hotel: hotel) %>
<% adjustment_category_options << "write_off" if can_post && current_user.has_permission?("post_folio_write_offs", hotel: hotel) %>
<% can_post_adjustment = adjustment_category_options.any? %>

<% if can_post_payment || can_post_charge || can_post_adjustment || can_execute_refund %>
  <div class="flex flex-wrap items-center gap-2">
    <% if can_post_payment %>
      <button type="button" class="rounded-lg bg-slate-900 px-3 py-2 text-xs font-semibold text-white transition hover:bg-slate-700" onclick="document.getElementById('folio-payment-modal-<%= booking.id %>').showModal()">Add Payment</button>
    <% end %>
    <% if can_post_charge %>
      <button type="button" class="rounded-lg border border-slate-300 bg-white px-3 py-2 text-xs font-semibold text-slate-700 transition hover:bg-slate-50" onclick="document.getElementById('folio-charge-modal-<%= booking.id %>').showModal()">Add Charge</button>
    <% end %>
    <% if can_post_adjustment %>
      <button type="button" class="rounded-lg border border-slate-300 bg-white px-3 py-2 text-xs font-semibold text-slate-700 transition hover:bg-slate-50" onclick="document.getElementById('folio-adjustment-modal-<%= booking.id %>').showModal()">Add Adjustment</button>
    <% end %>
    <% if can_execute_refund %>
      <button type="button" class="rounded-lg border border-amber-300 bg-white px-3 py-2 text-xs font-semibold text-amber-800 transition hover:bg-amber-50" onclick="document.getElementById('folio-refund-modal-<%= booking.id %>').showModal()">Issue Refund</button>
    <% end %>
  </div>

  <% if can_post_payment %>
    <%= render "hotel_portal/folios/transactions/modal",
        booking: booking,
        hotel: hotel,
        modal_id: "folio-payment-modal-#{booking.id}",
        title: "Add Payment",
        description: "Record a staff-posted cash payment against this folio.",
        transaction_type: "payment",
        category: "cash",
        signed_amount: false,
        submit_label: "Add Payment",
        redirect_to_folio: redirect_to_folio %>
  <% end %>

  <% if can_post_charge %>
    <%= render "hotel_portal/folios/transactions/modal",
        booking: booking,
        hotel: hotel,
        modal_id: "folio-charge-modal-#{booking.id}",
        title: "Add Charge",
        description: "Record a manual other charge. Accommodation and tax are posted by audit flows.",
        transaction_type: "charge",
        category: "other",
        signed_amount: false,
        submit_label: "Add Charge",
        redirect_to_folio: redirect_to_folio %>
  <% end %>

  <% if can_post_adjustment %>
    <%= render "hotel_portal/folios/transactions/modal",
        booking: booking,
        hotel: hotel,
        modal_id: "folio-adjustment-modal-#{booking.id}",
        title: "Add Adjustment",
        description: "Record an authorized adjustment, correction, discount, write-off, or other adjustment.",
        transaction_type: "adjustment",
        category: nil,
        category_options: adjustment_category_options,
        signed_amount: true,
        submit_label: "Add Adjustment",
        redirect_to_folio: redirect_to_folio %>
  <% end %>

  <% if can_execute_refund %>
    <%= render "hotel_portal/folios/transactions/modal",
        booking: booking,
        hotel: hotel,
        modal_id: "folio-refund-modal-#{booking.id}",
        title: "Issue Refund",
        description: "Enter a positive refund amount. It will be recorded as a negative refund payment.",
        transaction_type: "payment",
        category: "refund",
        signed_amount: false,
        submit_label: "Issue Refund",
        redirect_to_folio: redirect_to_folio %>
  <% end %>
<% end %>

<%# E-Invoice Submission — shown for closed folios when e-invoice is enabled %>
<% if folio&.status == "closed" && current_hotel.e_invoice_setting&.enabled? %>
  <% current_scenario = booking.direct_hotel_payment? ? "hotel_intermediary_guest_invoice" : "guest_invoice" %>
  <% existing_submission = booking.e_invoice_submissions.select { |submission| submission.document_scenario == current_scenario }.max_by(&:created_at) %>
  <div class="mt-2 border-t border-slate-100 pt-3">
    <% if booking.resolved_fund_collector == "unknown" %>
      <div class="mb-3 rounded-xl border border-amber-200 bg-amber-50 px-4 py-3">
        <p class="text-xs font-semibold text-amber-900">Before sending this e-invoice, confirm who received the guest payment.</p>
        <p class="mt-1 text-xs text-amber-700">This decides whether WAStays or the hotel issues the guest e-invoice.</p>

        <%= form_with model: booking, url: update_payment_receiver_hotel_e_invoice_submissions_path(current_hotel, booking_id: booking.id), method: :patch, local: true, class: "mt-3 flex flex-col gap-3 sm:flex-row sm:items-end" do |f| %>
          <div class="sm:min-w-[260px]">
            <%= f.label :fund_collector, "Who received the guest payment?", class: "mb-1.5 block text-xs font-medium text-amber-900" %>
            <%= f.select :fund_collector,
                [["WAStays received the payment", "wastays"], ["Hotel received the payment directly", "hotel"]],
                { selected: nil, prompt: "Select one" },
                class: "w-full rounded-xl border border-amber-200 bg-white px-4 py-2.5 text-sm text-slate-700 focus:border-amber-300 focus:outline-none focus:ring-0" %>
          </div>
          <%= f.submit "Save payment receiver",
              class: "rounded-lg border border-amber-300 bg-white px-3 py-2 text-xs font-semibold text-amber-900 hover:bg-amber-100 cursor-pointer" %>
        <% end %>
      </div>
      <div class="rounded-lg border border-dashed border-amber-200 bg-white px-3 py-2 text-xs text-amber-800">
        Save the payment receiver above first. Then the correct e-invoice action will appear here.
      </div>
    <% else %>
      <p class="mb-2 text-xs text-slate-500">
        <% if booking.direct_hotel_payment? %>
          Guest paid hotel directly, so the hotel issues this e-invoice. WAStays only helps submit it.
        <% else %>
          Guest paid through WAStays, so WAStays issues this e-invoice.
        <% end %>
      </p>

      <div class="flex items-center gap-2">
      <% if existing_submission&.validated? %>
        <span class="inline-flex items-center gap-1.5 rounded-full bg-emerald-50 px-3 py-1 text-xs font-semibold text-emerald-700">
          <%= cached_icon "circle-check", class: "size-3" %> E-invoice ready
        </span>
        <%= link_to "View", hotel_e_invoice_submission_path(current_hotel, existing_submission),
            class: "text-xs font-semibold text-blue-600 hover:underline" %>
      <% elsif existing_submission&.submitted? %>
        <span class="inline-flex items-center gap-1.5 rounded-full bg-blue-50 px-3 py-1 text-xs font-semibold text-blue-700">
          Waiting for LHDN confirmation
        </span>
        <%= link_to "Check Status", hotel_e_invoice_submission_path(current_hotel, existing_submission),
            class: "text-xs font-semibold text-blue-600 hover:underline" %>
      <% elsif existing_submission&.invalid? %>
        <span class="inline-flex items-center gap-1.5 rounded-full bg-red-50 px-3 py-1 text-xs font-semibold text-red-700">
          E-invoice rejected
        </span>
        <%= button_to "Resubmit", hotel_e_invoice_submissions_path(current_hotel, booking_id: booking.id),
            method: :post,
            class: "rounded-lg border border-slate-300 bg-white px-3 py-1.5 text-xs font-semibold text-slate-700 hover:bg-slate-50 cursor-pointer" %>
      <% else %>
        <%= button_to "Send e-invoice to LHDN",
            hotel_e_invoice_submissions_path(current_hotel, booking_id: booking.id),
            method: :post,
            data: { turbo_confirm: "Send this e-invoice to LHDN for this booking?" },
            class: "rounded-lg border border-emerald-300 bg-emerald-50 px-3 py-2 text-xs font-semibold text-emerald-800 hover:bg-emerald-100 transition cursor-pointer" %>
      <% end %>
      </div>
    <% end %>
  </div>
<% end %>
