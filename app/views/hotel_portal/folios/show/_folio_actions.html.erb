<% redirect_to_folio = local_assigns[:redirect_to_folio] || false %>
<% folio_origin = local_assigns[:folio_origin] %>
<% folio_show = local_assigns[:folio_show] %>
<% offcanvas_data = { turbo_frame: "offcanvas_drawer", offcanvas_variant: "right" } %>

<section class="space-y-3">
  <div class="flex items-center gap-2">
    <span class="inline-flex size-7 items-center justify-center rounded-md bg-muted text-foreground">
      <%= cached_icon "settings", class: "size-3.5" %>
    </span>
    <h2 class="text-sm font-black uppercase tracking-[0.18em] text-foreground">Ledger Actions</h2>
  </div>

  <div class="flex flex-wrap items-center gap-2">
    <% if folio_show.actions_blocked? %>
      <div class="max-w-2xl">
        <p class="text-sm font-black text-foreground"><%= folio_show.actions_blocked_title %></p>
        <p class="mt-1 text-sm font-medium text-muted-foreground"><%= folio_show.actions_blocked_reason %></p>
        <% if folio_show.actions_blocked_url.present? %>
          <%= link_to folio_show.actions_blocked_link_label, folio_show.actions_blocked_url, class: "mt-3 inline-flex items-center justify-center rounded-lg border border-border bg-card px-3 py-2 text-xs font-black text-foreground shadow-sm transition hover:border-border-interactive hover:bg-muted" %>
        <% end %>
      </div>
    <% elsif folio_show.action_section_state == :closed %>
      <span class="text-sm font-medium text-muted-foreground"><%= folio_show.closed_folio_action_message %></span>
    <% elsif folio_show.normal_folio_actions_available? %>
    <% if folio_show.can_post_payment? %>
      <%= link_to new_hotel_folio_transaction_path(hotel, booking,
          transaction_type: "payment",
          active_folio_id: folio_show.active_folio_id,
          redirect_to_folio: redirect_to_folio,
          folio_origin: folio_origin),
          data: offcanvas_data,
          class: "inline-flex items-center gap-1.5 rounded-lg bg-primary px-3 py-2 text-xs font-black text-primary-foreground shadow-sm transition hover:bg-primary-hover" do %>
        <%= cached_icon "credit-card", class: "size-3" %>
        Post Payment
      <% end %>
    <% end %>
    <% if folio_show.can_post_charge? %>
      <%= link_to new_hotel_folio_transaction_path(hotel, booking,
          transaction_type: "charge",
          active_folio_id: folio_show.active_folio_id,
          redirect_to_folio: redirect_to_folio,
          folio_origin: folio_origin),
          data: offcanvas_data,
          class: "inline-flex items-center gap-1.5 rounded-lg border border-border bg-card px-3 py-2 text-xs font-black text-foreground shadow-sm transition hover:border-border-interactive hover:bg-muted" do %>
        <%= cached_icon "plus", class: "size-3" %>
        Post Charge
      <% end %>
    <% end %>
    <% if folio_show.can_post_adjustment? %>
      <%= link_to new_hotel_folio_transaction_path(hotel, booking,
          transaction_type: "adjustment",
          active_folio_id: folio_show.active_folio_id,
          redirect_to_folio: redirect_to_folio,
          folio_origin: folio_origin),
          data: offcanvas_data,
          class: "inline-flex items-center gap-1.5 rounded-lg border border-amber-300 bg-card px-3 py-2 text-xs font-black text-amber-800 shadow-sm transition hover:bg-amber-50" do %>
        <%= cached_icon "receipt-text", class: "size-3" %>
        Post Adjustment
      <% end %>
    <% end %>

    <div class="relative inline-block text-left" data-controller="dropdown" data-dropdown-align="right">
      <button type="button" class="inline-flex items-center gap-1.5 rounded-lg border border-border bg-card px-3 py-2 text-xs font-black text-foreground shadow-sm transition hover:border-border-interactive hover:bg-muted" data-dropdown-target="button" data-action="click->dropdown#toggle keydown->dropdown#handleKeydown" aria-expanded="false" aria-haspopup="true">
        More Actions
        <%= cached_icon "chevron-down", class: "size-3" %>
      </button>
      <div data-dropdown-target="menu" class="hidden absolute right-0 z-50 mt-2 w-56 origin-top-right rounded-2xl border border-border bg-card p-1.5 shadow-xl shadow-foreground/10 focus:outline-none" role="menu" aria-orientation="vertical" tabindex="-1">
        <% if folio_show.can_execute_refund? %>
          <%= link_to new_hotel_folio_transaction_path(hotel, booking,
              transaction_type: "payment",
              category: "refund",
              active_folio_id: folio_show.active_folio_id,
              redirect_to_folio: redirect_to_folio,
              folio_origin: folio_origin),
              role: "menuitem",
              data: offcanvas_data,
              class: "flex w-full items-center gap-3 rounded-lg px-3 py-2.5 text-left text-sm font-semibold text-foreground hover:bg-muted focus-visible:bg-muted focus-visible:outline-none" do %>
            <%= cached_icon "rotate-ccw", class: "size-4 text-amber-600" %>
            Issue Refund
          <% end %>
        <% end %>
        <% [ [ "Transfer Charge", "arrow-right" ], [ "Print Folio", "file-text" ], [ "Void / Reverse", "rotate-ccw" ] ].each do |label, icon| %>
          <button type="button" role="menuitem" disabled class="flex w-full cursor-not-allowed items-center gap-3 rounded-lg px-3 py-2.5 text-left text-sm font-semibold text-muted-foreground">
            <%= cached_icon icon, class: "size-4 text-primary-foreground" %>
            <span><%= label %></span>
          </button>
        <% end %>
      </div>
    </div>
    <% else %>
      <span class="text-sm font-medium text-muted-foreground">No posting actions available</span>
    <% end %>
  </div>
</section>
