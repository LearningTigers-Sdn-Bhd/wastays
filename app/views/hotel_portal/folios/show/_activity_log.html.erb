<section class="overflow-hidden rounded-md border border-slate-200 bg-white">
  <div class="flex items-center justify-between border-b border-slate-200 p-4">
    <div class="flex items-center gap-2">
      <span class="inline-flex size-7 items-center justify-center rounded-md bg-slate-100 text-slate-700">
        <%= cached_icon "history", class: "size-3.5" %>
      </span>
      <h2 class="text-sm font-black uppercase tracking-[0.18em] text-slate-700">Activity Log</h2>
    </div>
    <span class="text-xs font-medium tabular-nums text-slate-500"><%= pluralize(folio_show.activity_log_rows.size, "entry") %></span>
  </div>

  <div class="overflow-x-auto">
    <table class="w-full min-w-[760px] table-fixed text-left text-xs">
      <thead class="bg-slate-50 text-[10px] font-semibold uppercase tracking-wider text-slate-500">
        <tr class="border-b border-slate-200">
          <th class="w-36 px-4 py-2">Time</th>
          <th class="w-52 px-4 py-2">Action</th>
          <th class="w-40 px-4 py-2">User</th>
          <th class="px-4 py-2">Details</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-slate-100">
        <% if folio_show.activity_log_rows.any? %>
          <% folio_show.activity_log_rows.each do |row| %>
            <tr>
              <td class="px-4 py-3 font-medium tabular-nums text-slate-600"><%= row.time_label %></td>
              <td class="px-4 py-3 font-bold text-slate-900"><%= row.action_label %></td>
              <td class="px-4 py-3 font-semibold text-slate-700"><%= row.actor_label %></td>
              <td class="px-4 py-3 font-medium text-slate-600"><%= row.details %></td>
            </tr>
          <% end %>
        <% else %>
          <tr>
            <td colspan="4" class="px-4 py-10 text-center text-sm font-medium text-slate-500">No folio activity recorded yet.</td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</section>
