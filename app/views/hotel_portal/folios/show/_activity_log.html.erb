<section class="overflow-hidden rounded-md border border-border bg-card">
  <div class="flex items-center justify-between border-b border-border p-4">
    <div class="flex items-center gap-2">
      <span class="inline-flex size-7 items-center justify-center rounded-md bg-muted text-foreground">
        <%= cached_icon "history", class: "size-3.5" %>
      </span>
      <h2 class="text-sm font-black uppercase tracking-[0.18em] text-foreground">Activity Log</h2>
    </div>
    <span class="text-xs font-medium tabular-nums text-muted-foreground"><%= pluralize(folio_show.activity_log_rows.size, "entry") %></span>
  </div>

  <div class="overflow-x-auto">
    <table class="w-full min-w-[760px] table-fixed text-left text-xs">
      <thead class="bg-muted text-[10px] font-semibold uppercase tracking-wider text-muted-foreground">
        <tr class="border-b border-border">
          <th class="w-36 px-4 py-2">Time</th>
          <th class="w-52 px-4 py-2">Action</th>
          <th class="w-40 px-4 py-2">User</th>
          <th class="px-4 py-2">Details</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-border">
        <% if folio_show.activity_log_rows.any? %>
          <% folio_show.activity_log_rows.each do |row| %>
            <tr>
              <td class="px-4 py-3 font-medium tabular-nums text-muted-foreground"><%= row.time_label %></td>
              <td class="px-4 py-3 font-bold text-foreground"><%= row.action_label %></td>
              <td class="px-4 py-3 font-semibold text-foreground"><%= row.actor_label %></td>
              <td class="px-4 py-3 font-medium text-muted-foreground"><%= row.details %></td>
            </tr>
          <% end %>
        <% else %>
          <tr>
            <td colspan="4" class="px-4 py-10 text-center text-sm font-medium text-muted-foreground">No folio activity recorded yet.</td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</section>
