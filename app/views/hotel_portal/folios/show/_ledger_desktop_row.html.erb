<% forecasted = row.row_kind == :forecasted %>
<% can_move = row.row_kind == :posted && row.movement_allowed && folio_show.can_manage_folio_movements? %>
<% can_reverse = row.action_kind == :reverse %>
<% has_actions = can_move || can_reverse %>
<% split_modal_id = "folio-split-modal-#{row.transaction_id}" %>
<% reverse_modal_id = "folio-reverse-modal-#{row.transaction_id}" %>
<tr class="align-top <%= "bg-warning/10" if forecasted %> <%= "text-muted-foreground" if row.reversed %>">
  <td class="whitespace-nowrap">
    <span class="tabular-nums text-foreground"><%= row.date_label %></span>
    <span class="ml-1 text-muted-foreground"><%= row.weekday_label %></span>
  </td>
  <td class="whitespace-nowrap font-mono text-[11px] font-semibold uppercase tracking-wide text-muted-foreground"><%= row.code %></td>
  <td>
    <div class="flex items-start gap-1.5">
      <span class="font-medium text-foreground <%= "line-through text-muted-foreground" if row.reversed %>"><%= row.description %></span>
      <% if row.info_rows.present? %>
        <%= render PanelsUI::Popover.new(id: "ledger-info-#{row.transaction_id || row.forecast_id}", trigger_on: :hover, placement: :top_start, arrow: true) do |popover| %>
          <% popover.with_trigger(unstyled: true, aria_label: "Transaction details", class: "mt-px inline-flex shrink-0 rounded text-muted-foreground transition hover:text-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring") do %>
            <%= cached_icon row.info_icon.to_s, class: "size-3.5", aria: { hidden: true } %>
          <% end %>
          <dl class="grid w-64 grid-cols-[auto_1fr] gap-x-3 gap-y-1.5 text-left text-xs">
            <% row.info_rows.each do |label, value| %>
              <dt class="font-medium text-muted-foreground"><%= label %></dt>
              <dd class="text-foreground"><%= value %></dd>
            <% end %>
          </dl>
        <% end %>
      <% end %>
    </div>
  </td>
  <td class="whitespace-nowrap text-right font-semibold tabular-nums text-foreground"><%= row.debit %></td>
  <td class="whitespace-nowrap text-right font-semibold tabular-nums text-success"><%= row.credit %></td>
  <td class="text-right">
    <% if has_actions %>
      <%= render PanelsUI::DropdownMenu.new(id: "folio-row-actions-#{row.transaction_id}", placement: :bottom_end) do |menu| %>
        <% menu.with_trigger(variant: :ghost, size: :icon_sm, aria_label: "Row actions") do %>
          <%= cached_icon "ellipsis-vertical", class: "size-4", aria: { hidden: true } %>
        <% end %>
        <% if can_move %>
          <% menu.with_item(href: move_hotel_folio_transaction_path(hotel, booking, row.transaction_id, folio_origin: folio_origin), data: { turbo_frame: "offcanvas_drawer", offcanvas_variant: "right" }) do %>
            <%= cached_icon "arrow-right", class: "size-4 text-muted-foreground", aria: { hidden: true } %>
            Move
          <% end %>
          <% menu.with_item(command: "show-modal", commandfor: split_modal_id) do %>
            <%= cached_icon "split", class: "size-4 text-muted-foreground", aria: { hidden: true } %>
            Split
          <% end %>
        <% end %>
        <% if can_reverse %>
          <% menu.with_item(command: "show-modal", commandfor: reverse_modal_id) do %>
            <%= cached_icon "rotate-ccw", class: "size-4 text-muted-foreground", aria: { hidden: true } %>
            <%= row.action_label %>
          <% end %>
        <% end %>
      <% end %>

      <% if can_move %>
        <%= render PanelsUI::Dialog.new(id: split_modal_id, size: :sm, title: "Split transaction", description: "Split part of this posted charge to another open folio window.") do |dialog| %>
          <% dialog.with_body do %>
            <%= form_with scope: :folio_operation, url: split_hotel_folio_transaction_path(hotel, booking, row.transaction_id), method: :post, id: "#{split_modal_id}-form", class: "space-y-4 text-left" do |form| %>
              <%= hidden_field_tag "redirect_to_folio", "true" %>
              <%= hidden_field_tag "folio_origin", folio_origin if folio_origin.present? %>
              <%= render PanelsUI::FormField.new(form:, attribute: :target_folio_id, label: "Target folio", required: true) do |field| %>
                <% field.with_select_menu(folio_show.other_open_folios.map { |candidate| [ candidate.display_option_label, candidate.id ] }, prompt: "Select a folio") %>
              <% end %>
              <div class="grid gap-3 sm:grid-cols-2">
                <%= render PanelsUI::FormField.new(form:, attribute: :amount, label: "Amount") do |field| %>
                  <% field.with_input(type: :number, step: "0.01", min: "0.01", placeholder: "Optional") %>
                <% end %>
                <%= render PanelsUI::FormField.new(form:, attribute: :percent, label: "Percent") do |field| %>
                  <% field.with_input(type: :number, step: "0.01", min: "0.01", max: "99.99", placeholder: "Optional") %>
                <% end %>
              </div>
              <%= render PanelsUI::FormField.new(form:, attribute: :reason, label: "Reason", required: true) do |field| %>
                <% field.with_input(placeholder: "e.g., Split room charge with company") %>
              <% end %>
            <% end %>
          <% end %>
          <% dialog.with_footer do %>
            <%= render PanelsUI::Button.new(as: :button, variant: :secondary, size: :sm, data: { action: "panels-ui--dialog#close" }) do %>Cancel<% end %>
            <%= render PanelsUI::Button.new(as: :button, type: :submit, form: "#{split_modal_id}-form", variant: :primary, size: :sm) do %>Split transaction<% end %>
          <% end %>
        <% end %>
      <% end %>

      <% if can_reverse %>
        <%= render PanelsUI::Dialog.new(id: reverse_modal_id, size: :sm, title: row.modal_title, description: "Post an immutable correction row with the opposite amount.") do |dialog| %>
          <% dialog.with_body do %>
            <%= form_with scope: :folio_transaction, url: reverse_hotel_folio_transaction_path(hotel, booking, row.transaction_id), method: :post, id: "#{reverse_modal_id}-form", class: "space-y-4 text-left" do |form| %>
              <%= hidden_field_tag "redirect_to_folio", "true" %>
              <%= hidden_field_tag "folio_origin", folio_origin if folio_origin.present? %>
              <%= render PanelsUI::FormField.new(form:, attribute: :correction_reason, label: "Reason", required: true) do |field| %>
                <% field.with_input(placeholder: "e.g., Posting error") %>
              <% end %>
              <%= render PanelsUI::FormField.new(form:, attribute: :correction_note, label: "Note", required: true) do |field| %>
                <% field.with_text_area(rows: 3, placeholder: "Explain why this correction is needed.") %>
              <% end %>
            <% end %>
          <% end %>
          <% dialog.with_footer do %>
            <%= render PanelsUI::Button.new(as: :button, variant: :secondary, size: :sm, data: { action: "panels-ui--dialog#close" }) do %>Cancel<% end %>
            <%= render PanelsUI::Button.new(as: :button, type: :submit, form: "#{reverse_modal_id}-form", variant: :primary, size: :sm) do %><%= row.action_label %><% end %>
          <% end %>
        <% end %>
      <% end %>
    <% end %>
  </td>
</tr>
