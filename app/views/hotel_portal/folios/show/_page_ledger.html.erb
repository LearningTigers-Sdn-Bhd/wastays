<% folio = booking.booking_folio %>
<% currency = booking.currency.presence || "MYR" %>
<% projected_lines = Array(local_assigns[:projected_lines]) %>
<% posted_transactions = folio&.folio_transactions&.order(posting_date: :asc, created_at: :asc) || [] %>
<% posted_charges = (folio&.total_charges || 0).to_d %>
<% posted_payments = (folio&.total_payments || 0).to_d %>
<% forecasted_total = projected_lines.sum { |line| line[:amount].to_d } %>
<% transaction_count = posted_transactions.size + projected_lines.size %>

<section class="overflow-hidden rounded-md border border-slate-200 bg-white" data-controller="folio-ledger">
  <div class="flex items-center justify-between border-b border-slate-200 px-4 py-3">
    <h2 class="text-sm font-bold text-slate-950">Transaction Ledger</h2>
    <span class="text-xs font-medium tabular-nums text-slate-500"><%= pluralize(transaction_count, "entry") %></span>
  </div>

  <div class="overflow-x-auto">
    <table class="w-full min-w-[860px] table-fixed text-left text-xs">
      <thead class="sticky top-0 z-[1] bg-slate-50 text-[10px] font-semibold uppercase tracking-wider text-slate-500">
        <tr class="border-b border-slate-200">
          <th class="w-24 px-4 py-2">ID</th>
          <th class="w-32 px-4 py-2">Date</th>
          <th class="px-4 py-2">Description</th>
          <th class="w-28 px-4 py-2">GL Code</th>
          <th class="w-36 px-4 py-2">Source</th>
          <th class="w-36 px-4 py-2 text-right">Amount</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-slate-100">
        <tr class="border-y border-slate-200 bg-slate-50">
          <td colspan="6" class="p-0">
            <button type="button"
                    class="flex w-full items-center justify-between gap-4 px-4 py-2.5 text-left transition hover:bg-slate-100"
                    aria-expanded="true"
                    data-action="folio-ledger#toggle"
                    data-folio-ledger-section-param="posted">
              <span class="flex min-w-0 items-center gap-2">
                <span class="w-3 text-slate-500" data-folio-ledger-target="chevron" data-section="posted">▾</span>
                <span class="font-semibold text-slate-800">Posted Transactions</span>
              </span>
              <span class="truncate text-[11px] font-medium tabular-nums text-slate-500">
                <%= posted_transactions.size %> posted · <%= currency %> <%= number_with_precision(posted_charges, precision: 2) %> charges · <%= currency %> <%= number_with_precision(posted_payments, precision: 2) %> payments
              </span>
            </button>
          </td>
        </tr>

        <% posted_transactions.each do |transaction| %>
          <tr class="transition hover:bg-slate-50/70 <%= "text-slate-400" if transaction.reversed? %>"
              data-folio-ledger-target="row"
              data-section="posted">
            <td class="px-4 py-2 font-mono text-[11px] tabular-nums text-slate-500">#<%= transaction.id %></td>
            <td class="px-4 py-2 whitespace-nowrap text-slate-600"><%= transaction.posting_date.strftime("%d %b %Y") %></td>
            <td class="px-4 py-2">
              <p class="font-medium text-slate-900 <%= "line-through text-slate-400" if transaction.reversed? %>"><%= transaction.description %></p>
              <p class="mt-0.5 text-[10px] font-medium text-slate-500"><%= transaction.transaction_type.humanize %> · <%= transaction.category.humanize %></p>
            </td>
            <td class="px-4 py-2 font-mono text-[11px] text-slate-600"><%= transaction.gl_code.presence || "—" %></td>
            <td class="px-4 py-2">
              <p class="font-medium text-slate-700"><%= transaction.user&.name || "System" %></p>
              <p class="mt-0.5 text-[10px] text-slate-500"><%= transaction.user ? "Manual" : "Night Audit" %></p>
            </td>
            <td class="px-4 py-2 text-right font-semibold tabular-nums <%= folio_transaction_amount_class(transaction) %>">
              <%= folio_transaction_amount_label(transaction, currency: currency) %>
            </td>
          </tr>
        <% end %>

        <% if posted_transactions.empty? %>
          <tr data-folio-ledger-target="row" data-section="posted">
            <td colspan="6" class="px-4 py-6 text-center text-xs text-slate-500">No posted transactions.</td>
          </tr>
        <% end %>

        <tr class="border-y border-slate-200 bg-slate-50">
          <td colspan="6" class="p-0">
            <button type="button"
                    class="flex w-full items-center justify-between gap-4 px-4 py-2.5 text-left transition hover:bg-slate-100"
                    aria-expanded="true"
                    data-action="folio-ledger#toggle"
                    data-folio-ledger-section-param="forecasted">
              <span class="flex min-w-0 items-center gap-2">
                <span class="w-3 text-slate-500" data-folio-ledger-target="chevron" data-section="forecasted">▾</span>
                <span class="font-semibold text-slate-800">Upcoming / Forecasted Charges</span>
              </span>
              <span class="truncate text-[11px] font-medium tabular-nums text-slate-500">
                <%= projected_lines.size %> pending · <%= currency %> <%= number_with_precision(forecasted_total, precision: 2) %> · Posted by night audit
              </span>
            </button>
          </td>
        </tr>

        <% projected_lines.each do |line| %>
          <tr class="transition hover:bg-slate-50/70"
              data-folio-ledger-target="row"
              data-section="forecasted">
            <td class="px-4 py-2 text-[10px] font-semibold uppercase tracking-wider text-slate-500">Pending</td>
            <td class="px-4 py-2 whitespace-nowrap text-slate-600"><%= line[:date].strftime("%d %b %Y") %></td>
            <td class="px-4 py-2">
              <p class="font-medium text-slate-900"><%= line[:description] %></p>
              <p class="mt-0.5 text-[10px] font-medium text-slate-500">Charge · <%= line[:category].to_s.humanize %></p>
            </td>
            <td class="px-4 py-2 font-mono text-[11px] text-slate-500">—</td>
            <td class="px-4 py-2">
              <p class="font-medium text-slate-700">Forecast</p>
              <p class="mt-0.5 text-[10px] text-slate-500">Pending</p>
            </td>
            <td class="px-4 py-2 text-right font-semibold tabular-nums text-slate-800">
              +<%= currency %> <%= number_with_precision(line[:amount].to_d, precision: 2) %>
            </td>
          </tr>
        <% end %>

        <% if projected_lines.empty? %>
          <tr data-folio-ledger-target="row" data-section="forecasted">
            <td colspan="6" class="px-4 py-6 text-center text-xs text-slate-500">No upcoming forecasted charges.</td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</section>
