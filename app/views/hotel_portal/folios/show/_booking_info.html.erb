<% folio_show = local_assigns.fetch(:folio_show) %>
<% ready = folio_show.checkout_readiness_label == "Ready" %>

<section class="overflow-hidden rounded-md border border-border bg-card shadow-sm">
  <div class="flex items-center gap-2 border-b border-border px-4 py-3">
    <span class="inline-flex size-7 items-center justify-center rounded-md bg-blue-50 text-blue-700">
      <%= cached_icon "book-open", class: "size-3.5" %>
    </span>
    <h2 class="text-sm font-black uppercase tracking-[0.18em] text-foreground">Booking Info</h2>
  </div>

  <div class="grid gap-0 lg:grid-cols-[minmax(0,1.35fr)_minmax(20rem,0.65fr)]">
    <table class="w-full table-fixed text-sm">
      <tbody class="divide-y divide-border">
        <% folio_show.folio_detail_rows.each do |label, value| %>
          <tr>
            <th class="w-40 bg-muted px-4 py-2 text-left text-[11px] font-black uppercase tracking-wider text-muted-foreground sm:w-48"><%= label %></th>
            <td class="px-4 py-2 font-semibold tabular-nums text-foreground"><%= value %></td>
          </tr>
        <% end %>
      </tbody>
    </table>

    <div class="flex min-h-full flex-col justify-center border-t border-border bg-muted/70 p-4 lg:border-l lg:border-t-0">
      <div class="flex items-center gap-2">
        <span class="inline-flex size-8 items-center justify-center rounded-md <%= ready ? "bg-emerald-50 text-emerald-700" : "bg-amber-50 text-amber-700" %>">
          <%= cached_icon "door-open", class: "size-4" %>
        </span>
        <div>
          <p class="text-[11px] font-black uppercase tracking-[0.18em] text-muted-foreground">Checkout Readiness</p>
          <p class="text-base font-black text-foreground"><%= folio_show.checkout_readiness_label %></p>
        </div>
      </div>

      <p class="mt-4 text-sm font-black text-foreground"><%= folio_show.checkout_status_label %></p>
      <p class="mt-1 text-sm font-semibold text-muted-foreground"><%= folio_show.checkout_status_description %></p>
    </div>
  </div>
</section>
