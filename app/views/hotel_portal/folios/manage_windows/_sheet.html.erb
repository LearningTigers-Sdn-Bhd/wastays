<% already_primary = @folio.persisted? && @folio.is_primary? %>

<div class="flex h-full flex-col bg-card">
  <%= form_with url: @form_url, method: @form_method, local: true, class: "flex h-full flex-col" do |f| %>
    <%= hidden_field_tag "folio_origin", @folio_origin if @folio_origin.present? %>

    <%= render "hotel_portal/bookings/board/partials/content_header",
      title: @sheet_title,
      subtitle: "#{@booking.confirmation_token} · #{@folio.display_name}",
      icon: cached_icon("book-open", stroke_width: 2.5, class: "size-5") %>

    <div class="flex-1 overflow-y-auto bg-card p-6">
      <div class="mx-auto max-w-[1000px] space-y-6">
        <div>
          <p class="text-sm font-bold text-foreground"><%= @sheet_description %></p>
          <p class="mt-1 text-xs font-semibold text-muted-foreground">Primary folio changes affect where new untargeted transactions are posted.</p>
        </div>

        <div class="space-y-4" data-controller="folio-window-payer" data-folio-window-payer-requires-company-account-value="<%= (@folio.new_record? || @folio.hotel_corporate_account_id.present?).to_s %>" data-folio-window-payer-original-payer-value="<%= @folio.payer_type.presence || "company" %>">
          <div>
            <label class="mb-2 block text-[11px] font-bold uppercase tracking-wider text-muted-foreground">Name</label>
            <%= text_field_tag "booking_folio[name]", @folio.name, required: true, placeholder: "External Folio", class: "w-full rounded-xl border border-border px-4 py-2.5 text-sm text-foreground shadow-sm focus:border-border-interactive focus:outline-none focus:ring-0" %>
          </div>

          <div class="grid gap-3 sm:grid-cols-2">
            <div>
              <label class="mb-2 block text-[11px] font-bold uppercase tracking-wider text-muted-foreground">Type</label>
              <%= select_tag "booking_folio[folio_type]",
                options_for_select([ [ "Guest", "guest" ], [ "External", "external" ], [ "House", "house" ] ], @folio.folio_type.presence || "external"),
                data: { folio_window_payer_target: "folioType", action: "change->folio-window-payer#sync" },
                class: "w-full rounded-xl border border-border bg-card px-4 py-2.5 text-sm text-foreground shadow-sm focus:border-border-interactive focus:outline-none focus:ring-0" %>
            </div>
            <div>
              <label class="mb-2 block text-[11px] font-bold uppercase tracking-wider text-muted-foreground">Payer</label>
              <%= hidden_field_tag "booking_folio[payer_type]", @folio.payer_type.presence || "company", id: "booking_folio_locked_payer_type", disabled: true, data: { folio_window_payer_target: "lockedPayer" } %>
              <%= select_tag "booking_folio[payer_type]",
                options_for_select([ [ "Guest", "guest" ], [ "Company & Government", "company" ], [ "Agent", "agent" ], [ "Hotel", "hotel" ], [ "Custom", "custom" ] ], @folio.payer_type.presence || "company"),
                data: { folio_window_payer_target: "payerType", action: "change->folio-window-payer#sync" },
                class: "w-full rounded-xl border border-border bg-card px-4 py-2.5 text-sm text-foreground shadow-sm focus:border-border-interactive focus:outline-none focus:ring-0 disabled:bg-muted disabled:text-muted-foreground" %>
            </div>
          </div>

          <div data-folio-window-payer-target="companyAccountWrapper">
            <label class="mb-2 block text-[11px] font-bold uppercase tracking-wider text-muted-foreground">Company & Government Account</label>
            <% account_options = Array(@company_government_accounts).map do |relationship|
              label = relationship.corporate_account.name
              label = "#{label} - Direct bill enabled" if relationship.direct_bill_enabled?
              [ label, relationship.id ]
            end %>
            <%= select_tag "booking_folio[hotel_corporate_account_id]",
              options_for_select(account_options, @folio.hotel_corporate_account_id),
              include_blank: "Select account",
              data: { folio_window_payer_target: "companyAccountSelect" },
              class: "w-full rounded-xl border border-border bg-card px-4 py-2.5 text-sm text-foreground shadow-sm focus:border-border-interactive focus:outline-none focus:ring-0 disabled:bg-muted disabled:text-muted-foreground" %>
            <% if account_options.empty? %>
              <p class="mt-2 text-xs font-semibold text-amber-700">Create or reactivate a Company & Government Account before saving this folio.</p>
            <% else %>
              <p class="mt-2 text-xs font-semibold text-muted-foreground">Standard accounts can be selected, but only direct-bill accounts can be kept open at checkout.</p>
            <% end %>
          </div>

          <div>
            <label class="mb-2 block text-[11px] font-bold uppercase tracking-wider text-muted-foreground">Reason</label>
            <%= text_field_tag "booking_folio[reason]", nil, placeholder: "Optional internal reason", class: "w-full rounded-xl border border-border px-4 py-2.5 text-sm text-foreground shadow-sm placeholder:text-muted-foreground focus:border-border-interactive focus:outline-none focus:ring-0" %>
          </div>

          <div data-controller="folio-primary-toggle" class="rounded-2xl border border-border bg-muted p-4">
            <div class="flex items-start justify-between gap-4">
              <div>
                <p class="text-sm font-black text-foreground">Set this folio as primary</p>
                <p class="mt-1 text-xs font-semibold text-muted-foreground">
                  <% if already_primary %>
                    This is already the primary folio.
                  <% else %>
                    When saved, all other folios for this booking become non-primary.
                  <% end %>
                </p>
              </div>
              <label class="relative inline-flex cursor-pointer items-center">
                <%= hidden_field_tag "booking_folio[is_primary]", already_primary ? "1" : "0" %>
                <%= check_box_tag "booking_folio[is_primary]", "1", already_primary,
                  disabled: already_primary,
                  data: { folio_primary_toggle_target: "switch", action: "change->folio-primary-toggle#toggle", already_primary: already_primary.to_s },
                  class: "peer sr-only" %>
                <span class="h-6 w-11 rounded-full bg-muted after:absolute after:left-0.5 after:top-0.5 after:size-5 after:rounded-full after:bg-card after:transition-all peer-checked:bg-blue-600 peer-checked:after:translate-x-5 peer-disabled:cursor-not-allowed peer-disabled:opacity-70"></span>
              </label>
            </div>

            <div data-folio-primary-toggle-target="reasonWrapper" class="mt-4 hidden">
              <label class="mb-2 block text-[11px] font-bold uppercase tracking-wider text-muted-foreground">Reason for setting as primary</label>
              <%= text_field_tag "booking_folio[set_folio_as_primary_reason]", nil,
                placeholder: "e.g., Company & Government folio is now responsible for settlement",
                data: { folio_primary_toggle_target: "reasonInput" },
                class: "w-full rounded-xl border border-border bg-card px-4 py-2.5 text-sm text-foreground shadow-sm placeholder:text-muted-foreground focus:border-border-interactive focus:outline-none focus:ring-0" %>
            </div>
          </div>
        </div>
      </div>
    </div>

    <%= render "hotel_portal/bookings/board/partials/content_footer",
      show_full_page_link: false,
      submit_button: f.submit(@submit_label, class: "rounded-xl bg-primary px-6 py-2.5 text-sm font-bold text-primary-foreground shadow-sm transition-colors hover:bg-primary-hover") %>
  <% end %>
</div>
