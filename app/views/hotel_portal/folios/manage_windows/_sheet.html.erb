<% already_primary = @folio.persisted? && @folio.is_primary? %>

<div class="flex h-full flex-col bg-white">
  <%= form_with url: @form_url, method: @form_method, local: true, class: "flex h-full flex-col" do |f| %>
    <%= hidden_field_tag "folio_origin", @folio_origin if @folio_origin.present? %>

    <%= render "hotel_portal/bookings/board/partials/content_header",
      title: @sheet_title,
      subtitle: "#{@booking.confirmation_token} · #{@folio.display_name}",
      icon: cached_icon("book-open", stroke_width: 2.5, class: "size-5") %>

    <div class="flex-1 overflow-y-auto bg-white p-6">
      <div class="mx-auto max-w-[1000px] space-y-6">
        <div>
          <p class="text-sm font-bold text-slate-900"><%= @sheet_description %></p>
          <p class="mt-1 text-xs font-semibold text-slate-500">Primary folio changes affect where new untargeted transactions are posted.</p>
        </div>

        <div class="space-y-4">
          <div>
            <label class="mb-2 block text-[11px] font-bold uppercase tracking-wider text-slate-500">Name</label>
            <%= text_field_tag "booking_folio[name]", @folio.name, required: true, placeholder: "Company Folio", class: "w-full rounded-xl border border-slate-200 px-4 py-2.5 text-sm text-slate-700 shadow-sm focus:border-slate-300 focus:outline-none focus:ring-0" %>
          </div>

          <div class="grid gap-3 sm:grid-cols-2">
            <div>
              <label class="mb-2 block text-[11px] font-bold uppercase tracking-wider text-slate-500">Type</label>
              <%= select_tag "booking_folio[folio_type]", options_for_select([["Guest", "guest"], ["Company", "company"], ["Custom", "custom"]], @folio.folio_type.presence || "custom"), class: "w-full rounded-xl border border-slate-200 bg-white px-4 py-2.5 text-sm text-slate-700 shadow-sm focus:border-slate-300 focus:outline-none focus:ring-0" %>
            </div>
            <div>
              <label class="mb-2 block text-[11px] font-bold uppercase tracking-wider text-slate-500">Payer</label>
              <%= select_tag "booking_folio[payer_type]", options_for_select([["Guest", "guest"], ["Company", "company"], ["Custom", "custom"]], @folio.payer_type.presence || "guest"), class: "w-full rounded-xl border border-slate-200 bg-white px-4 py-2.5 text-sm text-slate-700 shadow-sm focus:border-slate-300 focus:outline-none focus:ring-0" %>
            </div>
          </div>

          <div>
            <label class="mb-2 block text-[11px] font-bold uppercase tracking-wider text-slate-500">Reason</label>
            <%= text_field_tag "booking_folio[reason]", nil, placeholder: "Optional internal reason", class: "w-full rounded-xl border border-slate-200 px-4 py-2.5 text-sm text-slate-700 shadow-sm placeholder:text-slate-400 focus:border-slate-300 focus:outline-none focus:ring-0" %>
          </div>

          <div data-controller="folio-primary-toggle" class="rounded-2xl border border-slate-200 bg-slate-50 p-4">
            <div class="flex items-start justify-between gap-4">
              <div>
                <p class="text-sm font-black text-slate-900">Set this folio as primary</p>
                <p class="mt-1 text-xs font-semibold text-slate-500">
                  <% if already_primary %>
                    This is already the primary folio.
                  <% else %>
                    When saved, all other folios for this booking become non-primary.
                  <% end %>
                </p>
              </div>
              <label class="relative inline-flex cursor-pointer items-center">
                <%= hidden_field_tag "booking_folio[is_primary]", already_primary ? "1" : "0" %>
                <%= check_box_tag "booking_folio[is_primary]", "1", already_primary,
                  disabled: already_primary,
                  data: { folio_primary_toggle_target: "switch", action: "change->folio-primary-toggle#toggle", already_primary: already_primary.to_s },
                  class: "peer sr-only" %>
                <span class="h-6 w-11 rounded-full bg-slate-300 after:absolute after:left-0.5 after:top-0.5 after:size-5 after:rounded-full after:bg-white after:transition-all peer-checked:bg-blue-600 peer-checked:after:translate-x-5 peer-disabled:cursor-not-allowed peer-disabled:opacity-70"></span>
              </label>
            </div>

            <div data-folio-primary-toggle-target="reasonWrapper" class="mt-4 hidden">
              <label class="mb-2 block text-[11px] font-bold uppercase tracking-wider text-slate-500">Reason for setting as primary</label>
              <%= text_field_tag "booking_folio[set_folio_as_primary_reason]", nil,
                placeholder: "e.g., Company folio is now responsible for settlement",
                data: { folio_primary_toggle_target: "reasonInput" },
                class: "w-full rounded-xl border border-slate-200 bg-white px-4 py-2.5 text-sm text-slate-700 shadow-sm placeholder:text-slate-400 focus:border-slate-300 focus:outline-none focus:ring-0" %>
            </div>
          </div>
        </div>
      </div>
    </div>

    <%= render "hotel_portal/bookings/board/partials/content_footer",
      show_full_page_link: false,
      submit_button: f.submit(@submit_label, class: "rounded-xl bg-slate-900 px-6 py-2.5 text-sm font-bold text-white shadow-sm transition-colors hover:bg-slate-700") %>
  <% end %>
</div>
