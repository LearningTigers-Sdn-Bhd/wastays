<tr>
  <td colspan="<%= colspan %>" class="px-6 py-12 text-center">
    <%= cached_icon "book-open", class: "mx-auto size-6 text-slate-400" %>
    <h3 class="mt-3 text-sm font-black text-slate-900">No folios found</h3>
    <p class="mx-auto mt-1 max-w-xs text-xs font-medium text-slate-500">Try adjusting your filters or search keywords to find the folio.</p>
    <% if folio_index.filters_active? %>
      <%= link_to "Reset Filters", hotel_folios_path(current_hotel), class: "mt-4 inline-flex items-center rounded-lg border border-slate-200 bg-white px-3 py-1.5 text-xs font-black text-slate-700 shadow-sm transition hover:bg-slate-50", data: { turbo_frame: "_top" } %>
    <% end %>
  </td>
</tr>
