<div class="space-y-3 lg:hidden">
  <% if folio_index.paginated_rows.any? %>
    <% folio_index.paginated_rows.each do |row| %>
      <article class="rounded-md border border-border bg-card p-4 shadow-sm">
        <div class="flex items-start justify-between gap-3">
          <div class="min-w-0">
            <p class="truncate text-sm font-black text-foreground"><%= row.booking.guest_name %></p>
            <p class="mt-1 text-xs font-semibold text-muted-foreground"><%= row.booking.confirmation_token %> · <%= row.folio_reference %></p>
            <p class="mt-1 text-xs font-medium text-muted-foreground">Primary Folio</p>
          </div>
          <span class="inline-flex items-center gap-1 rounded-md border px-2 py-0.5 text-[10px] font-black uppercase tracking-wider <%= row.folio_status_badge_class %>">
            <%= cached_icon row.folio_status_icon, class: "size-3" %>
            <%= row.folio.status.humanize %>
          </span>
        </div>

        <p class="mt-3 text-xs font-semibold text-muted-foreground"><%= row.room_label %> · <%= row.stay_label.html_safe %></p>

        <dl class="mt-4 grid grid-cols-[90px_minmax(0,1fr)] gap-y-2 text-sm">
          <dt class="text-xs font-black uppercase tracking-wider text-muted-foreground">Balance</dt>
          <dd class="font-black tabular-nums text-foreground"><%= row.amount_label %></dd>
          <dt class="text-xs font-black uppercase tracking-wider text-muted-foreground">Financials</dt>
          <dd class="inline-flex items-center gap-1 font-bold <%= row.financial_status_class %>">
            <%= cached_icon row.financial_icon, class: "size-3" %>
            <%= row.financial_status %>
          </dd>
        </dl>

        <% if row.status_badges.any? %>
          <div class="mt-4 flex flex-wrap gap-1.5">
            <% row.status_badges.each do |badge| %>
              <span class="inline-flex items-center gap-1 rounded-md border px-2 py-0.5 text-[10px] font-black uppercase tracking-wider <%= badge[:class] %>">
                <%= cached_icon badge[:icon], class: "size-3" %>
                <%= badge[:label] %>
              </span>
            <% end %>
          </div>
        <% end %>

        <div class="mt-4 flex items-center justify-end border-t border-border pt-4">
          <%= render "hotel_portal/folios/index/row_actions", row: row %>
        </div>
      </article>
    <% end %>
  <% else %>
    <div class="rounded-md border border-dashed border-border bg-card p-6 text-center shadow-sm">
      <%= cached_icon "book-open", class: "mx-auto size-6 text-muted-foreground" %>
      <h3 class="mt-3 text-sm font-black text-foreground">No folios found</h3>
      <p class="mx-auto mt-1 max-w-xs text-xs font-medium text-muted-foreground">Try adjusting your filters or search keywords to find the folio.</p>
      <% if folio_index.filters_active? %>
        <%= link_to "Reset Filters", local_assigns[:reset_path] || hotel_folios_path(current_hotel), class: "mt-4 inline-flex items-center rounded-lg border border-border bg-card px-3 py-1.5 text-xs font-black text-foreground shadow-sm transition hover:bg-muted", data: { turbo_frame: "_top" } %>
      <% end %>
    </div>
  <% end %>
</div>
