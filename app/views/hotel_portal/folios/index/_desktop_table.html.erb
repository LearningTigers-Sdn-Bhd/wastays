<div class="hidden overflow-x-auto rounded-md border border-slate-200 bg-white shadow-sm lg:block">
  <table class="min-w-[1100px] w-full divide-y divide-slate-200 text-left">
    <thead class="bg-slate-50/70">
      <tr>
        <th class="px-5 py-3 text-[10px] font-black uppercase tracking-[0.18em] text-slate-500">Guest / Booking</th>
        <th class="px-5 py-3 text-[10px] font-black uppercase tracking-[0.18em] text-slate-500">Folio Reference</th>
        <th class="px-5 py-3 text-[10px] font-black uppercase tracking-[0.18em] text-slate-500">Stay / Room</th>
        <th class="px-5 py-3 text-[10px] font-black uppercase tracking-[0.18em] text-slate-500">Financials</th>
        <th class="px-5 py-3 text-[10px] font-black uppercase tracking-[0.18em] text-slate-500">Status</th>
        <th class="sticky right-0 z-10 border-l border-slate-200/70 bg-slate-50/95 px-5 py-3 text-right text-[10px] font-black uppercase tracking-[0.18em] text-slate-500 shadow-[-4px_0_6px_-1px_rgba(15,23,42,0.08)]">Action</th>
      </tr>
    </thead>
    <tbody class="divide-y divide-slate-100 bg-white">
      <% if folio_index.paginated_rows.any? %>
        <% folio_index.paginated_rows.each do |row| %>
          <tr class="group transition hover:bg-slate-50/80">
            <td class="px-5 py-4">
              <p class="text-sm font-black text-slate-950"><%= row.booking.guest_name %></p>
              <p class="mt-0.5 font-mono text-xs font-semibold text-slate-500"><%= row.booking.confirmation_token %></p>
            </td>
            <td class="px-5 py-4">
              <p class="font-mono text-sm font-black text-slate-950"><%= row.folio_reference %></p>
              <p class="mt-0.5 text-xs font-semibold text-slate-500">Primary Folio</p>
            </td>
            <td class="px-5 py-4">
              <p class="text-sm font-bold text-slate-900"><%= row.stay_label.html_safe %></p>
              <p class="mt-0.5 text-xs font-semibold text-slate-500"><%= row.room_label %></p>
            </td>
            <td class="px-5 py-4">
              <p class="text-sm font-black tabular-nums text-slate-950"><%= row.amount_label %></p>
              <p class="mt-0.5 inline-flex items-center gap-1 text-xs font-bold <%= row.financial_status_class %>">
                <%= cached_icon row.financial_icon, class: "size-3" %>
                <%= row.financial_status %>
              </p>
            </td>
            <td class="px-5 py-4">
              <span class="inline-flex items-center gap-1 rounded-md border px-2 py-0.5 text-[10px] font-black uppercase tracking-wider <%= row.folio_status_badge_class %>">
                <%= cached_icon row.folio_status_icon, class: "size-3" %>
                <%= row.folio.status.humanize %>
              </span>
              <div class="mt-1 flex flex-wrap gap-1">
                <% row.status_badges.first(2).each do |badge| %>
                  <span class="inline-flex items-center gap-1 rounded-md border px-2 py-0.5 text-[10px] font-black uppercase tracking-wider <%= badge[:class] %>">
                    <%= cached_icon badge[:icon], class: "size-3" %>
                    <%= badge[:label] %>
                  </span>
                <% end %>
              </div>
            </td>
            <td class="sticky right-0 z-10 border-l border-slate-100 bg-white px-5 py-4 text-right shadow-[-4px_0_6px_-1px_rgba(15,23,42,0.08)] group-hover:bg-slate-50">
              <div class="flex flex-col items-end gap-1.5">
                <%= link_to hotel_booking_control_panel_path(current_hotel, row.booking, tab: "folio_operations", folio_id: row.folio.id), class: "inline-flex items-center gap-1.5 rounded-lg bg-slate-900 px-3 py-1.5 text-xs font-black text-white shadow-sm transition hover:bg-slate-700", data: { turbo_frame: "_top" } do %>
                  <%= cached_icon "book-open", class: "size-3" %>
                  View Folio
                <% end %>
                <%= link_to hotel_booking_control_panel_path(current_hotel, row.booking, tab: "booking_details"), class: "inline-flex items-center gap-1.5 rounded-lg border border-slate-200 bg-white px-3 py-1.5 text-xs font-black text-slate-700 shadow-sm transition hover:border-slate-900 hover:bg-slate-50", data: { turbo_frame: "_top" } do %>
                  <%= cached_icon "calendar-days", class: "size-3" %>
                  View Booking
                <% end %>
              </div>
            </td>
          </tr>
        <% end %>
      <% else %>
        <%= render "hotel_portal/folios/index/empty_state", colspan: 6, folio_index: folio_index %>
      <% end %>
    </tbody>
  </table>
</div>
