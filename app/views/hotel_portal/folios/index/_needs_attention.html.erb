<section class="mb-4 overflow-hidden rounded-md border border-border bg-card shadow-sm">
  <div class="flex items-center justify-between border-b border-border bg-muted/70 px-4 py-3">
    <h2 class="inline-flex items-center gap-2 text-sm font-semibold text-foreground">
      <span class="inline-flex size-6 items-center justify-center rounded-md bg-amber-50 text-amber-700">
        <%= cached_icon "triangle-alert", class: "size-3.5" %>
      </span>
      Needs Attention
    </h2>
    <% if folio_index.attention_rows.size == 5 && !folio_index.show_all_attention? %>
      <%= link_to hotel_folios_path(current_hotel, attention: "all"), class: "text-xs font-bold text-muted-foreground transition hover:text-foreground", data: { turbo_frame: "_top" } do %>
        View all &rsaquo;
      <% end %>
    <% end %>
  </div>

  <% if folio_index.visible_attention_rows.any? %>
    <div class="divide-y divide-border">
      <% folio_index.visible_attention_rows.each do |row| %>
        <article class="grid gap-3 px-4 py-3 lg:grid-cols-[minmax(0,1.6fr)_minmax(0,1.4fr)_minmax(0,0.9fr)_minmax(0,1fr)_auto] lg:items-center">
          <div class="flex min-w-0 items-start gap-3">
            <span class="mt-0.5 inline-flex size-7 shrink-0 items-center justify-center rounded-md bg-amber-50 text-amber-700">
              <%= cached_icon row.attention_icon, stroke_width: 2.25, class: "size-4" %>
            </span>
            <div class="min-w-0">
              <p class="truncate text-sm font-black text-foreground"><%= row.booking.guest_name %></p>
              <p class="mt-0.5 text-xs font-medium text-muted-foreground"><%= row.booking.confirmation_token %> · <%= row.folio_reference %></p>
              <p class="mt-1 text-xs font-semibold text-muted-foreground"><%= row.attention_reason %> · <%= row.folio.status.humanize %> folio</p>
            </div>
          </div>

          <div class="text-xs font-bold text-muted-foreground"><%= row.room_label %></div>
          <div class="text-sm font-black tabular-nums text-foreground"><%= row.amount_label %></div>
          <div class="flex flex-wrap gap-1.5">
            <% row.status_badges.first(3).each do |badge| %>
              <span class="inline-flex items-center gap-1 rounded-md border px-2 py-0.5 text-[10px] font-black uppercase tracking-wider <%= badge[:class] %>">
                <%= cached_icon badge[:icon], class: "size-3" %>
                <%= badge[:label] %>
              </span>
            <% end %>
          </div>
          <div class="flex items-center gap-2 lg:justify-end">
            <%= link_to hotel_booking_control_panel_path(current_hotel, row.booking, tab: "folio_operations", folio_id: row.folio.id), class: "inline-flex items-center gap-1.5 rounded-lg bg-primary px-3 py-1.5 text-xs font-black text-primary-foreground shadow-sm transition hover:bg-primary-hover", data: { turbo_frame: "_top" } do %>
              <%= cached_icon "book-open", class: "size-3" %>
              View Folio
            <% end %>
            <%= link_to hotel_booking_control_panel_path(current_hotel, row.booking, tab: "booking_details"), class: "inline-flex items-center gap-1.5 rounded-lg border border-border bg-card px-3 py-1.5 text-xs font-black text-foreground shadow-sm transition hover:border-border-interactive hover:bg-muted", data: { turbo_frame: "_top" } do %>
              <%= cached_icon "calendar-days", class: "size-3" %>
              View Booking
            <% end %>
          </div>
        </article>
      <% end %>
    </div>
  <% else %>
    <div class="px-4 py-8 text-center">
      <p class="text-sm font-bold text-foreground">No folios need attention.</p>
      <p class="mt-1 text-xs font-medium text-muted-foreground">Balances, due-out folios, and refund syncs look clear for this view.</p>
    </div>
  <% end %>
</section>
