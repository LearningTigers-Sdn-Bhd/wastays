<div class="mx-auto mt-5 max-w-[1600px] space-y-4 px-4 pb-10 md:px-0">
  <%= render "hotel_portal/folios/index/header", folio_index: @folio_index %>
  <%= render "hotel_portal/folios/index/needs_attention", folio_index: @folio_index %>
  <%= render "hotel_portal/folios/index/filters", folio_index: @folio_index %>

  <%= turbo_frame_tag "folios_results" do %>
    <%= render "hotel_portal/folios/index/desktop_table", folio_index: @folio_index %>
    <%= render "hotel_portal/folios/index/mobile_cards", folio_index: @folio_index %>
    <%= render "hotel_portal/folios/index/pagination", folio_index: @folio_index %>
  <% end %>
</div>
