<div data-controller="ui--sheet-frame">
    <%= render PanelsUI::Sheet.new(
          id: "folio-close-window-sheet",
          side: :right,
          size: :sm,
          title: "Close #{@folio.display_name}",
          description: @correction ? "Close the corrected folio and preserve the original invoice and payment history." : @direct_bill_available ? "Close this folio as Direct Bill and create an AR invoice." : "Only settled folios with no pending charges can be closed.",
          body_class: "p-0") do |sheet| %>
      <% sheet.with_body do %>
        <%= form_with scope: :booking_folio,
              url: hotel_folio_action_close_window_path(current_hotel, @booking, @folio),
              method: :post,
              class: "flex h-full min-h-0 flex-col" do |form| %>
          <%= hidden_field_tag :return_to, @return_to if @return_to.present? %>
          <%= form.hidden_field :settlement_method, value: "direct_bill" if @direct_bill_available %>

          <div class="min-h-0 flex-1 space-y-4 overflow-y-auto p-4">
            <% if @correction %>
              <% original = @correction.original_receivable %>
              <% corrected_amount = @folio.outstanding_balance.to_d %>
              <dl class="space-y-2 text-sm">
                <div class="flex justify-between gap-3"><dt>Original invoice</dt><dd><%= original.formatted_invoice_number %></dd></div>
                <div class="flex justify-between gap-3"><dt>Previous amount</dt><dd><%= original.currency %> <%= number_with_precision(original.amount, precision: 2, delimiter: ",") %></dd></div>
                <div class="flex justify-between gap-3"><dt>Corrected amount</dt><dd><%= original.currency %> <%= number_with_precision(corrected_amount, precision: 2, delimiter: ",") %></dd></div>
                <div class="flex justify-between gap-3"><dt>Payment received</dt><dd><%= original.currency %> <%= number_with_precision(original.paid_amount, precision: 2, delimiter: ",") %></dd></div>
                <div class="flex justify-between gap-3"><dt>Remaining due</dt><dd><%= original.currency %> <%= number_with_precision([ corrected_amount - original.paid_amount, 0 ].max, precision: 2, delimiter: ",") %></dd></div>
                <div class="flex justify-between gap-3"><dt>Company credit</dt><dd><%= original.currency %> <%= number_with_precision([ original.paid_amount - corrected_amount, 0 ].max, precision: 2, delimiter: ",") %></dd></div>
              </dl>
              <p class="text-sm text-muted-foreground">Excess payment stays on the company account. No automatic refund is made.</p>
              <% if @company_email.present? %>
                <%= render PanelsUI::Checkbox.new(form: form, attribute: :send_documents,
                      checked: true, label: "Send corrected documents to #{@company_email}") %>
              <% else %>
                <p class="text-sm text-warning-foreground">Company contact email is missing. Save a contact email on the external account to send corrected documents.</p>
              <% end %>
            <% end %>
            <%= render PanelsUI::FormField.new(form: form, attribute: :reason, label: "Reason") do |field| %>
              <% field.with_input(placeholder: "Optional internal reason") %>
            <% end %>
          </div>

          <div class="flex items-center justify-end gap-2 border-t border-border px-4 py-3">
            <%= render PanelsUI::Button.new(as: :button, type: :button, variant: :ghost, data: { action: "ui--sheet#close" }) do %>Keep folio open<% end %>
            <%= render PanelsUI::Button.new(as: :button, type: :submit, variant: :destructive, data: { turbo_submits_with: "Closing…" }) do %><%= @correction ? "Close & correct" : @direct_bill_available ? "Close as Direct Bill" : "Close folio" %><% end %>
          </div>
        <% end %>
      <% end %>
    <% end %>
  </div>
</div>
