<% booking = local_assigns.fetch(:booking) { @booking } %>
<% folio = local_assigns.fetch(:folio) { @folio } %>
<% already_primary = folio.is_primary? %>
<% account_choices = Array(@company_government_accounts).map do |relationship|
     label = relationship.corporate_account.name
     label = "#{label} — Direct bill enabled" if relationship.direct_bill_enabled?
     { label: label, value: relationship.id }
   end %>

<%= form_with scope: :booking_folio,
      url: hotel_folio_action_edit_window_path(current_hotel, booking, folio),
      method: :patch,
      class: "flex h-full min-h-0 flex-col",
      data: {
        controller: "folio-window-payer",
        folio_window_payer_requires_company_account_value: folio.hotel_corporate_account_id.present?.to_s,
        folio_window_payer_original_payer_value: folio.payer_type.presence || "company"
      } do |form| %>
  <%= hidden_field_tag :return_to, @return_to if @return_to.present? %>

  <div class="min-h-0 flex-1 space-y-6 overflow-y-auto p-4">
    <p class="text-sm text-muted-foreground">
      Update folio details or make this the primary folio for the booking.
      Primary folio changes affect where new untargeted transactions are posted.
    </p>

    <%= render PanelsUI::FormField.new(form: form, attribute: :label, label: "Label") do |field| %>
      <% field.with_input(value: folio.label, placeholder: "Optional — defaults to the folio reference") %>
    <% end %>

    <%= hidden_field_tag "booking_folio[payer_type]", folio.payer_type.presence || "company",
          id: "booking_folio_locked_payer_type", disabled: true,
          data: { folio_window_payer_target: "lockedPayer" } %>

    <div class="grid gap-3 sm:grid-cols-2">
      <div data-folio-window-payer-target="folioType" data-action="change->folio-window-payer#sync">
        <%= render PanelsUI::FormField.new(form: form, attribute: :folio_type, label: "Type") do |field| %>
          <% field.with_select_menu(
               [ { label: "Guest", value: "guest" }, { label: "External", value: "external" }, { label: "House", value: "house" } ],
               selected: folio.folio_type.presence || "external") %>
        <% end %>
      </div>
      <div data-folio-window-payer-target="payerType" data-action="change->folio-window-payer#syncCompanyAccount">
        <%= render PanelsUI::FormField.new(form: form, attribute: :payer_type, label: "Payer") do |field| %>
          <% field.with_select_menu(
               [ { label: "Guest", value: "guest" }, { label: "Corporate Account", value: "company" },
                 { label: "Agent", value: "agent" }, { label: "Hotel", value: "hotel" }, { label: "Custom", value: "custom" } ],
               selected: folio.payer_type.presence || "company") %>
        <% end %>
      </div>
    </div>

    <div data-folio-window-payer-target="companyAccount">
      <%= render PanelsUI::FormField.new(form: form, attribute: :hotel_corporate_account_id, label: "Corporate Account",
            hint: account_choices.empty? ? nil : "Standard accounts can be selected, but only direct-bill accounts can be kept open at checkout.") do |field| %>
        <% field.with_select_menu(
             account_choices.presence || [ { label: "No active account", value: "", disabled: true } ],
             prompt: "Select account",
             selected: folio.hotel_corporate_account_id) %>
      <% end %>
      <% if account_choices.empty? %>
        <p class="mt-2 text-xs font-medium text-warning-foreground">Create or reactivate a Corporate Account before saving this folio.</p>
      <% end %>
    </div>

    <%= render PanelsUI::FormField.new(form: form, attribute: :reason, label: "Reason") do |field| %>
      <% field.with_input(placeholder: "Optional internal reason") %>
    <% end %>

    <div data-controller="folio-primary-toggle" class="rounded-lg border border-border bg-muted p-4">
      <div class="flex items-start justify-between gap-4">
        <div>
          <p class="text-sm font-semibold text-foreground">Set this folio as primary</p>
          <p class="mt-1 text-xs text-muted-foreground">
            <%= already_primary ? "This is already the primary folio." : "When saved, all other folios for this booking become non-primary." %>
          </p>
        </div>
        <label class="relative inline-flex cursor-pointer items-center">
          <%= form.hidden_field :is_primary, value: already_primary ? "1" : "0" %>
          <%= check_box_tag "booking_folio[is_primary]", "1", already_primary,
                disabled: already_primary,
                data: { folio_primary_toggle_target: "switch", action: "change->folio-primary-toggle#toggle", already_primary: already_primary.to_s },
                class: "peer sr-only" %>
          <span class="h-6 w-11 rounded-full bg-card after:absolute after:left-0.5 after:top-0.5 after:size-5 after:rounded-full after:bg-muted after:transition-all peer-checked:bg-primary peer-checked:after:translate-x-5 peer-disabled:cursor-not-allowed peer-disabled:opacity-70"></span>
        </label>
      </div>

      <div data-folio-primary-toggle-target="reasonWrapper" class="mt-4 hidden">
        <%= render PanelsUI::FormField.new(form: form, attribute: :set_folio_as_primary_reason, label: "Reason for setting as primary") do |field| %>
          <% field.with_input(
               placeholder: "e.g., Corporate Account folio is now responsible for settlement",
               data: { folio_primary_toggle_target: "reasonInput" }) %>
        <% end %>
      </div>
    </div>
  </div>

  <div class="flex items-center justify-end gap-2 border-t border-border px-4 py-3">
    <%= render PanelsUI::Button.new(as: :button, type: :button, variant: :ghost, data: { action: "panels-ui--sheet#close" }) do %>Cancel<% end %>
    <%= render PanelsUI::Button.new(as: :button, type: :submit, variant: :primary, data: { turbo_submits_with: "Saving…" }) do %>Save changes<% end %>
  </div>
<% end %>
