<% booking = local_assigns.fetch(:booking) { @booking } %>

<div data-controller="panels-ui--sheet-frame">
  <%= render PanelsUI::Sheet.new(
        id: "folio-post-transaction-sheet",
        side: :right,
        size: :lg,
        title: @form_title,
        description: @active_folio ? "#{booking.confirmation_token} · #{@active_folio.display_name}" : booking.confirmation_token,
        body_class: "p-0") do |sheet| %>
    <% sheet.with_body do %>
      <% if @active_folio.blank? %>
        <div class="space-y-4 p-4">
          <%= render PanelsUI::Alert.new(tone: :warning, title: "No open folio window") do |alert| %>
            <% alert.with_description do %>
              This booking has no open folio window to post to. Create or reopen a folio window first.
            <% end %>
          <% end %>
          <div class="flex justify-end">
            <%= render PanelsUI::Button.new(as: :button, type: :button, variant: :ghost, data: { action: "panels-ui--sheet#close" }) do %>Close<% end %>
          </div>
        </div>
      <% else %>
        <%= form_with scope: :folio_transaction,
              url: hotel_folio_action_post_transaction_path(current_hotel, booking),
              method: :post,
              class: "flex h-full min-h-0 flex-col" do |form| %>
          <%= hidden_field_tag :return_to, @return_to if @return_to.present? %>
          <%= form.hidden_field :transaction_type, value: @transaction_type %>

          <div class="min-h-0 flex-1 space-y-6 overflow-y-auto p-4">
            <p class="text-sm text-muted-foreground">
              <%= @form_description %>
              Transactions post to the selected folio window and remain scoped to this booking.
            </p>

            <% if @open_folios.many? %>
              <%= render PanelsUI::FormField.new(form: form, attribute: :booking_folio_id, label: "Target folio", required: true) do |field| %>
                <% field.with_select_menu(
                     @open_folios.map { |folio| { label: folio.display_option_label, value: folio.id } },
                     selected: @active_folio.id,
                     required: true) %>
              <% end %>
            <% else %>
              <%= form.hidden_field :booking_folio_id, value: @active_folio.id %>
              <div>
                <p class="mb-1 text-sm font-medium text-foreground">Target folio</p>
                <p class="rounded-md border border-border bg-muted px-3 py-2 text-sm text-foreground"><%= @active_folio.display_option_label %></p>
              </div>
            <% end %>

            <% if @payment_source_options.present? %>
              <%= render PanelsUI::FormField.new(form: form, attribute: :payment_source, label: "Payment source", required: true) do |field| %>
                <% field.with_select_menu(@payment_source_options, prompt: "Select a payment source", required: true) %>
              <% end %>
            <% elsif @refund_source_options.present? %>
              <%= form.hidden_field :category, value: @category if @category.present? %>
              <%= render PanelsUI::FormField.new(form: form, attribute: :refund_source, label: "Refund source", required: true) do |field| %>
                <% field.with_select_menu(@refund_source_options, prompt: "Select a refund source", required: true) %>
              <% end %>
            <% elsif @transaction_code_options.present? %>
              <%= render PanelsUI::FormField.new(form: form, attribute: :transaction_code_id, label: "Transaction code", required: true,
                    hint: "Keyboard: type to jump, arrows to move, Enter to pick.") do |field| %>
                <% field.with_select_menu(
                     @transaction_code_options.map { |code| { label: "#{code.code} · #{code.name}", value: code.id } },
                     prompt: "Select a transaction code",
                     required: true) %>
              <% end %>
            <% elsif @category.present? %>
              <%= form.hidden_field :category, value: @category %>
            <% else %>
              <%= render PanelsUI::FormField.new(form: form, attribute: :category, label: "Category", required: true) do |field| %>
                <% field.with_select_menu(
                     @category_options.map { |option| { label: option.humanize, value: option } },
                     prompt: "Select a category",
                     required: true) %>
              <% end %>
            <% end %>

            <%= render PanelsUI::FormField.new(form: form, attribute: :amount, label: "Amount", required: true,
                  hint: (@signed_amount ? "Use a negative amount for discounts, write-offs, or rebates." : nil)) do |field| %>
              <% field.with_input(type: :number, step: "0.01", min: (@signed_amount ? nil : "0.01"), value: @amount, required: true) %>
            <% end %>

            <%= render PanelsUI::FormField.new(form: form, attribute: :posting_date, label: "Posting date", required: true) do |field| %>
              <% field.with_input(type: :date, value: current_hotel.current_business_date, required: true) %>
            <% end %>

            <%= render PanelsUI::FormField.new(form: form, attribute: :description, label: "Description", required: true) do |field| %>
              <% field.with_input(placeholder: "e.g., Mini-bar, Late Checkout Fee", required: true) %>
            <% end %>

            <%= render PanelsUI::FormField.new(form: form, attribute: :reference, label: "Reference") do |field| %>
              <% field.with_input(placeholder: "e.g., Receipt or approval number") %>
            <% end %>

            <%= render PanelsUI::FormField.new(form: form, attribute: :note, label: "Note") do |field| %>
              <% field.with_text_area(rows: 3, placeholder: "Optional internal note") %>
            <% end %>
          </div>

          <div class="flex items-center justify-end gap-2 border-t border-border px-4 py-3">
            <%= render PanelsUI::Button.new(as: :button, type: :button, variant: :ghost, data: { action: "panels-ui--sheet#close" }) do %>Cancel<% end %>
            <%= render PanelsUI::Button.new(as: :button, type: :submit, variant: :primary, data: { turbo_submits_with: "Posting…" }) do %><%= @submit_label %><% end %>
          </div>
        <% end %>
      <% end %>
    <% end %>
  <% end %>
</div>
