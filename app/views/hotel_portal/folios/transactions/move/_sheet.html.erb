<div class="flex h-full flex-col bg-card">
  <%= form_with url: move_hotel_folio_transaction_path(current_hotel, @booking, @transaction), method: :post, local: true, class: "flex h-full flex-col" do |f| %>
    <%= hidden_field_tag "redirect_to_folio", "true" %>
    <%= hidden_field_tag "folio_origin", @folio_origin if @folio_origin.present? %>

    <%= render "hotel_portal/bookings/board/partials/content_header",
      title: "Move Transaction",
      subtitle: @booking.confirmation_token,
      icon: cached_icon("arrow-right-left", stroke_width: 2.5, class: "size-5") %>

    <div class="flex-1 overflow-y-auto bg-card p-6">
      <div class="mx-auto max-w-[1000px] space-y-6">
        <div class="rounded-2xl border border-border bg-muted p-4">
          <p class="text-sm font-black text-foreground"><%= @transaction.description %></p>
          <p class="mt-1 text-xs font-semibold text-muted-foreground">
            <%= @transaction.transaction_code&.code || @transaction.category.to_s.humanize %> ·
            <%= @transaction.posting_date.strftime("%d %b %Y") %> ·
            <%= @transaction.currency %> <%= number_with_precision(@transaction.amount, precision: 2) %>
          </p>
          <p class="mt-1 text-xs font-semibold text-muted-foreground">Source folio: <%= @source_folio.display_option_label %></p>
        </div>

        <div class="space-y-4">
          <div>
            <label class="mb-2 block text-[11px] font-bold uppercase tracking-wider text-muted-foreground">Target Folio</label>
            <%= select_tag "folio_operation[target_folio_id]",
              options_from_collection_for_select(@target_folios, :id, ->(folio) { folio.display_option_label }),
              include_blank: "Select a target folio",
              required: true,
              class: "w-full rounded-xl border border-border bg-card px-4 py-2.5 text-sm text-foreground shadow-sm focus:border-border-interactive focus:outline-none focus:ring-0" %>
          </div>

          <% if @tax_transactions.any? %>
            <div class="space-y-3 rounded-2xl border border-border bg-muted p-4">
              <div>
                <p class="text-sm font-black text-foreground">Attached Taxes / Fees</p>
                <p class="mt-1 text-xs font-semibold text-muted-foreground">Leave blank to follow the target folio, or choose a specific open folio.</p>
              </div>

              <div class="space-y-3">
                <% @tax_transactions.each do |tax_transaction| %>
                  <div class="grid gap-3 rounded-xl border border-border bg-card p-3 sm:grid-cols-[1fr_16rem] sm:items-center">
                    <div>
                      <p class="font-mono text-xs font-black text-foreground"><%= tax_transaction.transaction_code&.code || "TAX" %></p>
                      <p class="mt-1 text-xs font-semibold text-muted-foreground"><%= tax_transaction.description %></p>
                      <p class="mt-1 text-[11px] font-bold text-muted-foreground"><%= tax_transaction.currency %> <%= number_with_precision(tax_transaction.amount, precision: 2) %></p>
                    </div>
                    <div>
                      <%= hidden_field_tag "folio_operation[tax_routes][#{tax_transaction.id}][transaction_id]", tax_transaction.id %>
                      <%= select_tag "folio_operation[tax_routes][#{tax_transaction.id}][target_folio_id]",
                        options_from_collection_for_select(@open_folios, :id, ->(folio) { folio.display_option_label }),
                        include_blank: "Follow target folio",
                        class: "w-full rounded-xl border border-border bg-card px-3 py-2 text-xs font-semibold text-foreground shadow-sm focus:border-border-interactive focus:outline-none focus:ring-0" %>
                    </div>
                  </div>
                <% end %>
              </div>
            </div>
          <% end %>

          <div>
            <label class="mb-2 block text-[11px] font-bold uppercase tracking-wider text-muted-foreground">Reason</label>
            <%= text_field_tag "folio_operation[reason]", nil, required: true, placeholder: "e.g., Company pays room charges", class: "w-full rounded-xl border border-border bg-card px-4 py-2.5 text-sm text-foreground shadow-sm placeholder:text-muted-foreground focus:border-border-interactive focus:outline-none focus:ring-0" %>
          </div>
        </div>
      </div>
    </div>

    <%= render "hotel_portal/bookings/board/partials/content_footer",
      show_full_page_link: false,
      submit_button: f.submit("Move Transaction", class: "rounded-xl bg-primary px-6 py-2.5 text-sm font-bold text-primary-foreground shadow-sm transition-colors hover:bg-primary-hover") %>
  <% end %>
</div>
