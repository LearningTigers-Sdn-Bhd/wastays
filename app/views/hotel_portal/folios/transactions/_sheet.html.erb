<div class="flex h-full flex-col bg-card">
  <%= form_with url: hotel_folio_transactions_path(current_hotel, @booking), method: :post, local: true, class: "flex h-full flex-col" do |f| %>
    <%= hidden_field_tag "folio_transaction[transaction_type]", @transaction_type %>
    <%= hidden_field_tag "redirect_to_folio", "true" if @redirect_to_folio %>
    <%= hidden_field_tag "redirect_to_checkout", "true" if @redirect_to_checkout %>
    <%= hidden_field_tag "folio_origin", @folio_origin if @folio_origin.present? %>

    <%= render "hotel_portal/shared/offcanvas/content_header",
      title: @sheet_title,
      subtitle: "#{@booking.confirmation_token} · #{@active_folio.display_name}",
      icon: cached_icon("receipt-text", stroke_width: 2.5, class: "size-5") %>

    <div class="flex-1 overflow-y-auto bg-card p-6">
      <div class="mx-auto max-w-[1000px] space-y-6">
        <div>
          <p class="text-sm font-bold text-foreground"><%= @sheet_description %></p>
          <p class="mt-1 text-xs font-semibold text-muted-foreground">Transactions post to the selected folio window and remain scoped to this booking.</p>
        </div>

        <div>
          <label class="mb-2 block text-[11px] font-bold uppercase tracking-wider text-muted-foreground">Target Folio</label>
          <% if @open_folios.many? %>
            <%= select_tag "folio_transaction[booking_folio_id]",
              options_from_collection_for_select(@open_folios, :id, :display_option_label, @active_folio.id),
              required: true,
              class: "w-full rounded-xl border border-border bg-card px-4 py-2.5 text-sm font-semibold text-foreground shadow-sm focus:border-border-interactive focus:outline-none focus:ring-0" %>
          <% else %>
            <%= hidden_field_tag "folio_transaction[booking_folio_id]", @active_folio.id %>
            <div class="rounded-xl border border-border bg-card px-4 py-2.5 text-sm font-semibold text-foreground"><%= @active_folio.display_option_label %></div>
          <% end %>
        </div>

        <div class="space-y-4">
            <% if @payment_source_options.present? %>
              <div>
                <label class="mb-2 block text-[11px] font-bold uppercase tracking-wider text-muted-foreground">Payment Source</label>
                <%= select_tag "folio_transaction[payment_source]",
                  options_for_select(@payment_source_options),
                  required: true,
                  class: "w-full rounded-xl border border-border bg-card px-4 py-2.5 text-sm text-foreground shadow-sm focus:border-border-interactive focus:outline-none focus:ring-0" %>
              </div>
            <% elsif @refund_source_options.present? %>
              <%= hidden_field_tag "folio_transaction[category]", @category if @category.present? %>
              <div>
                <label class="mb-2 block text-[11px] font-bold uppercase tracking-wider text-muted-foreground">Refund Source</label>
                <%= select_tag "folio_transaction[refund_source]",
                  options_for_select(@refund_source_options),
                  required: true,
                  class: "w-full rounded-xl border border-border bg-card px-4 py-2.5 text-sm text-foreground shadow-sm focus:border-border-interactive focus:outline-none focus:ring-0" %>
              </div>
            <% elsif @transaction_code_options.present? %>
              <div>
                <label class="mb-2 block text-[11px] font-bold uppercase tracking-wider text-muted-foreground">Transaction Code</label>
                <%= select_tag "folio_transaction[transaction_code_id]",
                  options_from_collection_for_select(@transaction_code_options, :id, ->(code) { "#{code.code} · #{code.name}" }),
                  required: true,
                  class: "w-full rounded-xl border border-border bg-card px-4 py-2.5 text-sm text-foreground shadow-sm focus:border-border-interactive focus:outline-none focus:ring-0" %>
              </div>
            <% elsif @category.present? %>
              <%= hidden_field_tag "folio_transaction[category]", @category %>
            <% else %>
              <div>
                <label class="mb-2 block text-[11px] font-bold uppercase tracking-wider text-muted-foreground">Category</label>
                <%= select_tag "folio_transaction[category]",
                  options_for_select(@category_options.map { |option| [ option.humanize, option ] }),
                  required: true,
                  class: "w-full rounded-xl border border-border bg-card px-4 py-2.5 text-sm text-foreground shadow-sm focus:border-border-interactive focus:outline-none focus:ring-0" %>
              </div>
            <% end %>

            <div>
              <label class="mb-2 block text-[11px] font-bold uppercase tracking-wider text-muted-foreground">Amount</label>
              <%= number_field_tag "folio_transaction[amount]", @amount, step: "0.01", min: (@signed_amount ? nil : "0.01"), required: true, class: "w-full rounded-xl border border-border bg-card px-4 py-2.5 text-sm text-foreground shadow-sm focus:border-border-interactive focus:outline-none focus:ring-0" %>
              <% if @signed_amount %>
                <p class="mt-1 text-[11px] font-medium text-muted-foreground">Use a negative amount for discounts, write-offs, or rebates.</p>
              <% end %>
            </div>

            <div>
              <label class="mb-2 block text-[11px] font-bold uppercase tracking-wider text-muted-foreground">Posting Date</label>
              <%= date_field_tag "folio_transaction[posting_date]", current_hotel.current_business_date, required: true, class: "w-full rounded-xl border border-border bg-card px-4 py-2.5 text-sm text-foreground shadow-sm focus:border-border-interactive focus:outline-none focus:ring-0" %>
            </div>

            <div>
              <label class="mb-2 block text-[11px] font-bold uppercase tracking-wider text-muted-foreground">Description</label>
              <%= text_field_tag "folio_transaction[description]", nil, required: true, placeholder: "e.g., Mini-bar, Late Checkout Fee", class: "w-full rounded-xl border border-border bg-card px-4 py-2.5 text-sm text-foreground shadow-sm placeholder:text-muted-foreground focus:border-border-interactive focus:outline-none focus:ring-0" %>
            </div>

            <div>
              <label class="mb-2 block text-[11px] font-bold uppercase tracking-wider text-muted-foreground">Reference</label>
              <%= text_field_tag "folio_transaction[reference]", nil, placeholder: "e.g., Receipt or approval number", class: "w-full rounded-xl border border-border bg-card px-4 py-2.5 text-sm text-foreground shadow-sm placeholder:text-muted-foreground focus:border-border-interactive focus:outline-none focus:ring-0" %>
            </div>

            <div>
              <label class="mb-2 block text-[11px] font-bold uppercase tracking-wider text-muted-foreground">Note</label>
              <%= text_area_tag "folio_transaction[note]", nil, rows: 3, placeholder: "Optional internal note", class: "w-full rounded-xl border border-border bg-card px-4 py-2.5 text-sm text-foreground shadow-sm placeholder:text-muted-foreground focus:border-border-interactive focus:outline-none focus:ring-0" %>
            </div>
        </div>
      </div>
    </div>

    <%= render "hotel_portal/shared/offcanvas/content_footer",
      show_full_page_link: false,
      submit_button: f.submit(@submit_label, class: "rounded-xl bg-primary px-6 py-2.5 text-sm font-bold text-primary-foreground shadow-sm transition-colors hover:bg-primary-hover") %>
  <% end %>
</div>
