<%= form_with url: hotel_corporate_accounts_path(current_hotel), method: :get, class: "space-y-2", data: { controller: "auto-submit", turbo_frame: "corporate_accounts_results", turbo_action: "advance" } do |form| %>
  <div class="relative">
    <div class="pointer-events-none absolute inset-y-0 left-0 flex items-center pl-3">
      <%= cached_icon "search", stroke_width: 2, class: "size-4 text-muted-foreground" %>
    </div>
    <%= form.text_field :query, value: presenter.query, placeholder: "Search name, email, code, or phone...",
      class: "block w-full rounded-lg border border-border bg-card py-2 pl-10 pr-3 text-sm shadow-sm transition-all placeholder:text-muted-foreground focus:border-border-interactive focus:outline-none focus:ring-1 focus:ring-ring/10",
      data: { action: "input->auto-submit#submit" } %>
  </div>

  <div class="flex items-center justify-between gap-3">
    <div class="-mx-0.5 flex min-w-0 flex-1 items-center gap-2 overflow-x-auto px-0.5 py-2 no-scrollbar">
      <div class="shrink-0">
        <input type="radio" name="status" value="" id="corporate_account_status_all" class="peer sr-only" <%= "checked" if presenter.selected_status.blank? %> data-action="change->auto-submit#submitNow">
        <label for="corporate_account_status_all" class="inline-flex cursor-pointer rounded-full border border-border bg-card px-4 py-1.5 text-xs font-bold uppercase tracking-wider text-muted-foreground shadow-sm transition hover:bg-muted hover:text-foreground peer-checked:border-border-interactive peer-checked:bg-primary peer-checked:text-primary-foreground">All</label>
      </div>
      <% presenter.status_options.each do |label, value| %>
        <div class="shrink-0">
          <input type="radio" name="status" value="<%= value %>" id="corporate_account_status_<%= value %>" class="peer sr-only" <%= "checked" if presenter.selected_status == value %> data-action="change->auto-submit#submitNow">
          <label for="corporate_account_status_<%= value %>" class="inline-flex cursor-pointer rounded-full border border-border bg-card px-4 py-1.5 text-xs font-bold uppercase tracking-wider text-muted-foreground shadow-sm transition hover:bg-muted hover:text-foreground peer-checked:border-border-interactive peer-checked:bg-primary peer-checked:text-primary-foreground"><%= label %></label>
        </div>
      <% end %>
    </div>

    <%= render PanelsUI::Button.new(
      as: :a,
      href: new_hotel_corporate_account_path(current_hotel),
      variant: :primary,
      size: :md,
      class: "shrink-0",
      data: { turbo_frame: "offcanvas_drawer", offcanvas_variant: "right" }) do %>
      <%= cached_icon "plus", stroke_width: 2.5, class: "size-4" %>
      Invite Corporate Account
    <% end %>
  </div>
<% end %>
