<div class="mx-auto max-w-6xl space-y-8 pb-20">
  <div class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
    <div>
      <h1 class="text-3xl font-bold tracking-tight text-slate-950">Company & Government Accounts</h1>
      <p class="mt-1 text-sm text-slate-600">Invite external payers and manage direct-billing relationships for this hotel.</p>
    </div>
    <%= link_to new_hotel_corporate_account_path(current_hotel),
      class: "inline-flex items-center justify-center gap-2 rounded-xl bg-slate-900 px-5 py-2.5 text-sm font-bold text-white shadow-sm transition hover:bg-slate-700",
      data: { turbo_frame: "offcanvas_drawer", offcanvas_variant: "right" } do %>
      <%= cached_icon "plus", stroke_width: 2.5, class: "size-4" %>
      Invite Company & Government Account
    <% end %>
  </div>

  <% if @pending_invitations.any? %>
    <section class="overflow-hidden rounded-2xl border border-amber-200 bg-amber-50/60 shadow-sm">
      <div class="border-b border-amber-200 px-6 py-5">
        <h2 class="text-lg font-bold text-slate-950">Pending invitations</h2>
      </div>
      <div class="divide-y divide-amber-100">
        <% @pending_invitations.each do |invitation| %>
          <div class="flex flex-col gap-3 px-6 py-4 sm:flex-row sm:items-center sm:justify-between">
            <div>
              <p class="font-bold text-slate-950"><%= invitation.email %></p>
              <p class="text-sm text-slate-600"><%= invitation.relationship_type.humanize %> · expires <%= l(invitation.expires_at, format: :short) %></p>
            </div>
            <div class="flex gap-2">
              <%= button_to "Resend", resend_hotel_corporate_invitation_path(current_hotel, invitation), method: :post, class: "rounded-lg border border-amber-300 bg-white px-3 py-2 text-sm font-bold text-amber-800" %>
              <%= button_to "Revoke", hotel_corporate_invitation_path(current_hotel, invitation), method: :delete, data: { turbo_confirm: "Revoke this invitation?" }, class: "rounded-lg border border-red-200 bg-white px-3 py-2 text-sm font-bold text-red-700" %>
            </div>
          </div>
        <% end %>
      </div>
    </section>
  <% end %>

  <section class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">
    <div class="border-b border-slate-200 px-6 py-5">
      <h2 class="text-lg font-bold text-slate-950">Linked Company & Government Accounts</h2>
    </div>
    <% if @relationships.any? %>
      <div class="overflow-x-auto">
        <table class="w-full text-left text-sm">
          <thead class="border-b border-slate-200 bg-slate-50 text-xs uppercase tracking-wider text-slate-500">
            <tr>
              <th class="px-6 py-3">Account</th>
              <th class="px-6 py-3">Contact</th>
              <th class="px-6 py-3">Terms</th>
              <th class="px-6 py-3">Status</th>
              <th class="px-6 py-3 text-right">Action</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-100">
            <% @relationships.each do |relationship| %>
              <tr>
                <td class="px-6 py-4 font-bold text-slate-950"><%= relationship.corporate_account.name %></td>
                <td class="px-6 py-4 text-slate-600"><%= relationship.corporate_account.users.first&.email %></td>
                <td class="px-6 py-4 text-slate-600"><%= relationship.relationship_type.humanize %> · <%= relationship.payment_terms_days.present? ? "#{relationship.payment_terms_days} days" : "No terms" %></td>
                <td class="px-6 py-4"><%= relationship.status.humanize %></td>
                <td class="px-6 py-4 text-right">
                  <% if relationship.active? %>
                    <%= button_to "Suspend", suspend_hotel_corporate_account_path(current_hotel, relationship), method: :patch, class: "rounded-lg border border-red-200 px-3 py-2 font-bold text-red-700" %>
                  <% else %>
                    <%= button_to "Reactivate", reactivate_hotel_corporate_account_path(current_hotel, relationship), method: :patch, class: "rounded-lg border border-emerald-200 px-3 py-2 font-bold text-emerald-700" %>
                  <% end %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% else %>
      <p class="px-6 py-10 text-center text-sm text-slate-500">No Company & Government Accounts are linked yet.</p>
    <% end %>
  </section>
</div>
