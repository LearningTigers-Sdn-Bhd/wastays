<div class="w-full space-y-3.5">
  <%= render PanelsUI::PageHeader.new(title: "Corporate Accounts", description: "Manage corporate and government direct-bill accounts for this hotel.") do |header| %>
    <% header.with_actions do %>
      <%= render PanelsUI::Button.new(
            as: :a,
            href: new_hotel_corporate_account_path(current_hotel),
            variant: :primary,
            size: :md,
            class: "w-full lg:w-auto",
            data: { turbo_frame: "offcanvas_drawer", offcanvas_variant: "right" }) do %>
        <%= cached_icon "plus", stroke_width: 2.5, class: "size-4" %>
        Invite Corporate Account
      <% end %>
    <% end %>
  <% end %>

  <% if @pending_invitations.any? %>
    <section class="overflow-hidden rounded-2xl border border-amber-200 bg-amber-50/60 shadow-sm">
      <div class="border-b border-amber-200 px-6 py-5">
        <h2 class="text-lg font-bold text-foreground">Pending invitations</h2>
      </div>
      <div class="divide-y divide-amber-100">
        <% @pending_invitations.each do |invitation| %>
          <div class="flex flex-col gap-3 px-6 py-4 sm:flex-row sm:items-center sm:justify-between">
            <div>
              <p class="font-bold text-foreground"><%= invitation.email %></p>
              <p class="text-sm text-muted-foreground"><%= invitation.relationship_type.humanize %> · expires <%= l(invitation.expires_at, format: :short) %></p>
            </div>
            <div class="flex gap-2">
              <%= button_to "Resend", resend_hotel_corporate_invitation_path(current_hotel, invitation), method: :post, class: "rounded-lg border border-amber-300 bg-card px-3 py-2 text-sm font-bold text-amber-800" %>
              <%= button_to "Revoke", hotel_corporate_invitation_path(current_hotel, invitation), method: :delete, data: { turbo_confirm: "Revoke this invitation?" }, class: "rounded-lg border border-red-200 bg-card px-3 py-2 text-sm font-bold text-red-700" %>
            </div>
          </div>
        <% end %>
      </div>
    </section>
  <% end %>

  <section class="overflow-hidden rounded-2xl border border-border bg-card shadow-sm">
    <div class="border-b border-border px-6 py-5">
        <h2 class="text-lg font-bold text-foreground">Linked Corporate Accounts</h2>
    </div>
    <% if @relationships.any? %>
      <div class="overflow-x-auto">
        <table class="w-full text-left text-sm">
          <thead class="border-b border-border bg-muted text-xs uppercase tracking-wider text-muted-foreground">
            <tr>
              <th class="px-6 py-3">Account</th>
              <th class="px-6 py-3">Contact</th>
              <th class="px-6 py-3">Terms</th>
              <th class="px-6 py-3">Credit</th>
              <th class="px-6 py-3">Status</th>
              <th class="px-6 py-3 text-right">Action</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-border">
            <% @relationships.each do |relationship| %>
              <% credit_exposure = @credit_exposures[relationship] %>
              <tr>
                <td class="px-6 py-4 font-bold text-foreground"><%= relationship.corporate_account.name %></td>
                <td class="px-6 py-4 text-muted-foreground"><%= relationship.corporate_account.users.first&.email %></td>
                <td class="px-6 py-4 text-muted-foreground"><%= relationship.relationship_type.humanize %> · <%= relationship.payment_terms_days.present? ? "#{relationship.payment_terms_days} days" : "No terms" %></td>
                <td class="px-6 py-4 text-muted-foreground">
                  <div class="font-semibold tabular-nums text-foreground"><%= credit_exposure.credit_currency %> <%= number_with_precision(credit_exposure.projected_exposure, precision: 2) %></div>
                  <% if credit_exposure.warning? %>
                    <div class="mt-1 max-w-xs rounded-lg border border-amber-200 bg-amber-50 px-2 py-1 text-xs font-semibold text-amber-800"><%= credit_exposure.warning_message %></div>
                  <% elsif credit_exposure.credit_limit.present? %>
                    <div class="mt-1 text-xs text-muted-foreground">Limit <%= credit_exposure.credit_currency %> <%= number_with_precision(credit_exposure.credit_limit, precision: 2) %></div>
                  <% else %>
                    <div class="mt-1 text-xs text-muted-foreground">No outstanding AR balance</div>
                  <% end %>
                </td>
                <td class="px-6 py-4"><%= relationship.status.humanize %></td>
                <td class="px-6 py-4 text-right">
                  <% if relationship.active? %>
                    <%= button_to "Suspend", suspend_hotel_corporate_account_path(current_hotel, relationship), method: :patch, class: "rounded-lg border border-red-200 px-3 py-2 font-bold text-red-700" %>
                  <% else %>
                    <%= button_to "Reactivate", reactivate_hotel_corporate_account_path(current_hotel, relationship), method: :patch, class: "rounded-lg border border-emerald-200 px-3 py-2 font-bold text-emerald-700" %>
                  <% end %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% else %>
      <p class="px-6 py-10 text-center text-sm text-muted-foreground">No corporate accounts are linked yet.</p>
    <% end %>
  </section>
</div>
