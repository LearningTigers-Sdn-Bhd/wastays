<%= turbo_frame_tag HotelPortal::CorporateAccountsController::WORKSPACE_FRAME, class: "flex min-h-0 flex-1 flex-col" do %>
  <header class="flex shrink-0 flex-wrap items-start justify-between gap-3 px-5 py-3">
    <div class="flex min-w-0 items-start gap-3">
      <%= render PanelsUI::Button.new(as: :a, href: @return_to, variant: :secondary, size: :sm,
        aria_label: "Back to external accounts", data: { turbo_frame: "_top" }) do %>
        <%= cached_icon "arrow-left", class: "size-4", aria: { hidden: true } %>
      <% end %>
      <div class="min-w-0 space-y-1">
        <div class="flex flex-wrap items-center gap-2">
          <h1 class="truncate text-base font-semibold text-foreground"><%= @corporate_account.name %></h1>
          <%= render PanelsUI::Badge.new(label: @relationship.status.humanize, variant: @relationship.active? ? :success : :warning, indicator: true) %>
        </div>
        <p class="text-xs text-muted-foreground">Code <%= @relationship.agent_code %> · <%= @relationship.account_type.humanize %></p>
      </div>
    </div>
    <%= render "workspace_actions" %>
  </header>
  <div class="shrink-0 border-b border-border">
    <%= render PanelsUI::Tabs.new(id: "corporate-account-tabs", active: @active_tab, variant: :line, aria_label: "Account workspace tabs") do |tabs| %>
      <% HotelPortal::CorporateAccountsController::WORKSPACE_TABS.each do |key, label| %>
        <% tabs.with_tab(name: key, label: label, href: edit_hotel_corporate_account_path(current_hotel, @relationship, tab: key, return_to: @return_to),
          data: { turbo_frame: HotelPortal::CorporateAccountsController::WORKSPACE_FRAME, turbo_action: "advance" }) %>
      <% end %>
    <% end %>
  </div>
  <%= render "relationship_form" %>
<% end %>
