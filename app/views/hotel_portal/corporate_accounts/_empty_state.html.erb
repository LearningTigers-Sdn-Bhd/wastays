<div class="flex flex-col items-center justify-center px-4 py-10 text-center">
  <div class="mb-3 rounded-full bg-muted p-3 text-muted-foreground">
    <%= cached_icon "building-2", stroke_width: 2, class: "size-6" %>
  </div>
  <h3 class="text-sm font-semibold text-foreground">
    <%= presenter.filters_active? ? "No external accounts found" : "No external accounts yet" %>
  </h3>
  <p class="mt-1 max-w-[320px] text-xs text-muted-foreground">
    <%= presenter.filters_active? ? "Try adjusting the search, account type, or status filters." : "Invite a company, government body, travel agent, or airline to bill directly to this hotel." %>
  </p>
  <% if presenter.filters_active? %>
    <%= link_to hotel_corporate_accounts_path(current_hotel), class: "mt-4 inline-flex items-center gap-1.5 rounded-lg border border-border bg-card px-3 py-1.5 text-xs font-semibold text-foreground shadow-sm transition hover:bg-muted active:scale-95", data: { turbo_frame: "_top" } do %>
      <%= cached_icon "rotate-ccw", stroke_width: 2.5, class: "size-3" %>
      Reset Filters
    <% end %>
  <% end %>
</div>
