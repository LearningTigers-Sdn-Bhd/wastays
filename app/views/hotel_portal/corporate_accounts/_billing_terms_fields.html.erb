<%# Shared billing-relationship fields. The invite form proposes them; the edit
    form sets them directly. %>
<%# The caller owns the corporate-billing-terms controller, because the fields
    it hides are not all in this partial. %>
<section class="space-y-4">
  <div>
    <h3 class="text-sm font-semibold text-foreground">Billing relationship</h3>
    <p class="mt-0.5 text-xs text-muted-foreground"><%= hint %></p>
  </div>

  <%= render PanelsUI::FormField.new(form: form, attribute: :relationship_type, label: "Relationship",
    hint: "Standard settles at checkout. Direct bill invoices this account instead, against its credit limit and terms.") do |field| %>
    <% field.with_select_menu(
      [ { label: "Standard", value: "standard" }, { label: "Direct bill", value: "direct_bill" } ],
      selected: relationship_type) %>
  <% end %>

  <%# Only a direct-bill account is invoiced, so only it has a currency, a
      credit limit and terms to settle on. %>
  <div data-corporate-billing-terms-target="terms" class="space-y-4">
    <div class="grid gap-3 sm:grid-cols-2">
      <%= render PanelsUI::FormField.new(form: form, attribute: :credit_currency, label: "Credit currency") do |field| %>
        <% field.with_combobox(
          CurrencyCatalog.options.map { |label, code| { label: label, value: code } },
          selected: credit_currency,
          prompt: "Select a currency") %>
      <% end %>

      <%= render PanelsUI::FormField.new(form: form, attribute: :credit_limit, label: "Credit limit") do |field| %>
        <% field.with_input(type: :number, value: credit_limit, min: 0, step: "0.01", placeholder: "No limit") %>
      <% end %>
    </div>

    <%= render PanelsUI::FormField.new(form: form, attribute: :payment_terms_days, label: "Payment terms (days)") do |field| %>
      <% field.with_input(type: :number, value: payment_terms_days, min: 0, placeholder: "No terms") %>
    <% end %>
  </div>

  <%# Booking on a client's behalf is a permission, not something every linked
      account has. Nothing below it means anything until it is granted, so it
      gates the payment hold rather than sitting beside it. %>
  <%= render PanelsUI::Switch.new(
        form: form,
        attribute: :agent_booking_enabled,
        tone: :success,
        checked: agent_booking_enabled,
        label: "Allow bookings for their clients",
        description: "Lets this account reserve rooms at this hotel for its own guests, from its portal.") %>

  <%# The mirror image of the billing fields: only a standard account holds
      rooms against a payment deadline. Deliberately not the payment terms above
      -- those say when an invoice falls due, and sharing them would let an
      invoicing change release inventory. %>
  <%# safe_join rather than interpolation: the hint renders as HTML, and the
      hotel's default is the one thing in it an operator has to be able to pick
      out at a glance. %>
  <div data-corporate-billing-terms-target="hold">
    <%= render "hotel_portal/shared/agent_payment_hold_field",
          form: form,
          record: record,
          label: "Payment hold",
          placeholder: "Hotel default (#{agent_payment_hold_default})",
          hint: safe_join([
            "How long this account's bookings are held before the rooms are released for non-payment. Leave blank to use the hotel default of ",
            tag.strong(agent_payment_hold_default),
            ". A hold never runs past the arrival date."
          ]) %>
  </div>
</section>
