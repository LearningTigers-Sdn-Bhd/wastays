<%= turbo_frame_tag "offcanvas_drawer", data: { offcanvas_variant: "right" } do %>
  <div class="flex h-full min-h-0 flex-col bg-muted">
    <header class="shrink-0 border-b border-border bg-card">
      <div class="flex items-start justify-between gap-4 px-6 py-5">
        <div>
          <p class="text-[10px] font-bold uppercase tracking-[0.2em] text-muted-foreground">Corporate Accounts</p>
          <h2 class="mt-1 text-xl font-bold tracking-tight text-foreground">Invite Corporate Account</h2>
          <p class="mt-1 text-xs font-medium text-muted-foreground">The recipient will choose their account name when accepting.</p>
        </div>
        <button type="button" class="rounded-md p-1.5 text-muted-foreground transition hover:bg-muted hover:text-foreground" data-action="click->offcanvas#close" aria-label="Close invitation form">
          <%= cached_icon "x", stroke_width: 2.5, class: "size-5" %>
        </button>
      </div>
    </header>

    <%= form_with scope: :corporate_invitation,
      url: hotel_corporate_accounts_path(current_hotel),
      class: "flex min-h-0 flex-1 flex-col",
      data: { turbo_stream: true } do |f| %>
      <div class="min-h-0 flex-1 overflow-y-auto p-6">
        <div class="w-full space-y-6">
          <% if @corporate_invitation.errors.any? %>
            <div class="rounded-xl border border-red-200 bg-red-50 px-4 py-3 text-sm font-semibold text-red-800">
              <%= @corporate_invitation.errors.full_messages.to_sentence %>
            </div>
          <% end %>

          <section class="space-y-5 rounded-2xl border border-border bg-card p-5 shadow-sm">
            <div>
              <h3 class="text-sm font-bold text-foreground">Account contact</h3>
              <p class="mt-1 text-xs font-medium text-muted-foreground">Invitations are tied to the recipient email, not a hotel-entered company name.</p>
            </div>
            <div>
              <%= f.label :account_type, "Account type", class: "mb-1.5 block text-sm font-semibold text-foreground" %>
              <%= f.select :account_type,
                HotelCorporateAccount::ACCOUNT_TYPES.map { |type| [ type.humanize, type ] },
                { selected: @corporate_invitation.account_type },
                class: "w-full rounded-xl border border-border bg-card px-4 py-3 text-sm text-foreground focus:border-border-interactive focus:outline-none focus:ring-0" %>
            </div>
            <div>
              <%= f.label :email, "Corporate contact email", class: "mb-1.5 block text-sm font-semibold text-foreground" %>
              <%= f.email_field :email, value: @corporate_invitation.email, required: true, autocomplete: "email", class: "w-full rounded-xl border border-border px-4 py-3 text-sm text-foreground focus:border-border-interactive focus:outline-none focus:ring-0" %>
            </div>
          </section>

          <section class="space-y-5 rounded-2xl border border-border bg-card p-5 shadow-sm">
            <div>
              <h3 class="text-sm font-bold text-foreground">Billing relationship</h3>
              <p class="mt-1 text-xs font-medium text-muted-foreground">These proposed terms become this hotel’s relationship when the invitation is accepted.</p>
            </div>
            <div>
              <%= f.label :relationship_type, "Relationship", class: "mb-1.5 block text-sm font-semibold text-foreground" %>
              <%= f.select :relationship_type,
                [["Standard", "standard"], ["Direct bill", "direct_bill"]],
                { selected: @corporate_invitation.relationship_type },
                class: "w-full rounded-xl border border-border bg-card px-4 py-3 text-sm text-foreground focus:border-border-interactive focus:outline-none focus:ring-0" %>
            </div>
            <div>
              <%= f.label :credit_limit, "Credit limit", class: "mb-1.5 block text-sm font-semibold text-foreground" %>
              <div class="flex gap-2">
                <%= f.text_field :credit_currency, value: @corporate_invitation.credit_currency, class: "w-24 rounded-xl border border-border px-4 py-3 text-sm font-semibold uppercase text-foreground focus:border-border-interactive focus:outline-none focus:ring-0" %>
                <%= f.number_field :credit_limit, value: @corporate_invitation.credit_limit, min: 0, step: "0.01", class: "min-w-0 flex-1 rounded-xl border border-border px-4 py-3 text-sm text-foreground focus:border-border-interactive focus:outline-none focus:ring-0" %>
              </div>
            </div>
            <div>
              <%= f.label :payment_terms_days, "Payment terms (days)", class: "mb-1.5 block text-sm font-semibold text-foreground" %>
              <%= f.number_field :payment_terms_days, value: @corporate_invitation.payment_terms_days, min: 0, class: "w-full rounded-xl border border-border px-4 py-3 text-sm text-foreground focus:border-border-interactive focus:outline-none focus:ring-0" %>
            </div>
            <label class="flex items-center gap-3 rounded-xl border border-border px-4 py-3 text-sm font-semibold text-foreground">
              <%= f.check_box :direct_bill_enabled, { checked: @corporate_invitation.direct_bill_enabled, class: "rounded border-border-interactive" } %>
              Enable direct billing
            </label>
          </section>
        </div>
      </div>

      <div class="shrink-0 border-t border-border bg-card px-6 py-4 shadow-[0_-4px_12px_rgba(0,0,0,0.03)]">
        <div class="flex items-center justify-end gap-3">
          <button type="button" data-action="click->offcanvas#close" class="rounded-xl border border-border bg-card px-5 py-2.5 text-sm font-bold text-foreground shadow-sm transition hover:bg-muted">Cancel</button>
          <%= f.submit "Send invitation", class: "rounded-xl bg-primary px-6 py-2.5 text-sm font-bold text-primary-foreground shadow-sm transition hover:bg-primary-hover" %>
        </div>
      </div>
    <% end %>
  </div>
<% end %>
