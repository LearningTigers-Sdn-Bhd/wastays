<%= turbo_frame_tag "corporate_accounts_results" do %>
  <% if presenter.paginated_rows.any? %>
    <div class="overflow-x-auto">
      <table class="w-full text-left text-sm">
        <thead class="border-b border-slate-200 bg-slate-50 text-xs uppercase tracking-wider text-slate-500">
          <tr>
            <th class="px-6 py-3">Account</th>
            <th class="px-6 py-3">Contact</th>
            <th class="px-6 py-3">Terms</th>
            <th class="px-6 py-3">Credit</th>
            <th class="px-6 py-3">Status</th>
            <th class="px-6 py-3">Created</th>
            <th class="px-6 py-3 text-right">Action</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-100">
          <% presenter.paginated_rows.each do |row| %>
            <% relationship = row.relationship %>
            <% credit_exposure = row.credit_exposure %>
            <tr>
              <td class="px-6 py-4">
                <div class="font-bold text-slate-950"><%= row.account_name %></div>
                <div class="mt-0.5 text-xs text-slate-500">
                  <%= row.account_type_label %>
                  <% if row.agent_code.present? %>
                    · Code <span class="font-mono font-semibold text-slate-700"><%= row.agent_code %></span>
                  <% end %>
                </div>
              </td>
              <td class="px-6 py-4 text-slate-600">
                <div><%= row.contact_email %></div>
                <% if row.contact_phone.present? %>
                  <div class="mt-0.5 text-xs text-slate-500"><%= row.contact_phone %></div>
                <% end %>
              </td>
              <td class="px-6 py-4 text-slate-600"><%= row.terms_label %></td>
              <td class="px-6 py-4 text-slate-600">
                <div class="font-semibold tabular-nums <%= credit_exposure.over_limit? ? "text-red-600" : "text-slate-900" %>"><%= credit_exposure.credit_currency %> <%= number_with_precision(credit_exposure.projected_exposure, precision: 2) %></div>
                <% if credit_exposure.warning_state == "no_limit" %>
                  <div class="mt-1 text-xs text-slate-500">No limit set</div>
                <% elsif credit_exposure.near_limit? %>
                  <div class="mt-1 max-w-xs rounded-lg border border-amber-200 bg-amber-50 px-2 py-1 text-xs font-semibold text-amber-800"><%= credit_exposure.warning_message %></div>
                <% elsif credit_exposure.credit_limit.present? %>
                  <div class="mt-1 text-xs text-slate-500">Limit <%= credit_exposure.credit_currency %> <%= number_with_precision(credit_exposure.credit_limit, precision: 2) %></div>
                <% elsif !credit_exposure.over_limit? %>
                  <div class="mt-1 text-xs text-slate-500">No outstanding AR balance</div>
                <% end %>
              </td>
              <td class="px-6 py-4"><%= row.status_label %></td>
              <td class="px-6 py-4 text-slate-600"><%= row.created_on_label %></td>
              <td class="px-6 py-4 text-right">
                <%= link_to "Edit", edit_hotel_corporate_account_path(current_hotel, relationship),
                  class: "inline-block rounded-lg border border-slate-200 px-3 py-2 font-bold text-slate-700",
                  data: { turbo_frame: "offcanvas_drawer", offcanvas_variant: "right" } %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>

    <% if presenter.pagination.total_pages > 1 %>
      <div class="border-t border-slate-100 px-6 py-4"><%= paginate presenter.pagination %></div>
    <% end %>
  <% else %>
    <p class="px-6 py-10 text-center text-sm text-slate-500">
      <%= presenter.filters_active? ? "No corporate accounts match your search." : "No corporate accounts are linked yet." %>
    </p>
  <% end %>
<% end %>
