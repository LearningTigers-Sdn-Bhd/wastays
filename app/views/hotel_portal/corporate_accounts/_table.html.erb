<div class="overflow-hidden rounded-md border border-border bg-card">
  <% if presenter.any_rows? %>
    <%= render PanelsUI::Table.new(caption: "External accounts", hoverable: true, bordered: false) do |table| %>
      <% table.with_header do %>
        <tr>
          <th scope="col">Account</th>
          <th scope="col">Code</th>
          <th scope="col">Type</th>
          <th scope="col">Terms</th>
          <th scope="col">Credit</th>
          <th scope="col">Status</th>
          <th scope="col">Created</th>
          <th scope="col" class="text-right"><span class="sr-only">Action</span></th>
        </tr>
      <% end %>

      <% table.with_body do %>
        <%# Invitations are pinned above the paginated body: they are few, urgent, and
            must not be able to hide on page three. %>
        <% presenter.pinned_rows.each do |row| %>
          <tr data-testid="<%= row.dom_id %>">
            <%= render "hotel_portal/corporate_accounts/row_identity", row: row %>
            <td class="text-muted-foreground">—</td>
            <td class="text-muted-foreground"><%= row.account_type_label %></td>
            <td class="text-muted-foreground"><%= row.terms_label %></td>
            <td class="text-muted-foreground">
              <%# An invitation proposing a standard relationship proposes no limit. %>
              <% if !row.direct_bill? %>
                —
              <% elsif row.proposed_credit_limit.present? %>
                <div class="text-sm tabular-nums"><%= row.proposed_credit_currency %> <%= format_amount(row.proposed_credit_limit) %></div>
                <div class="mt-0.5 text-xs">Proposed limit</div>
              <% else %>
                <div class="text-sm">No limit set</div>
              <% end %>
            </td>
            <td>
              <%= render PanelsUI::Badge.new(label: row.status_label, variant: row.status_variant, indicator: true) %>
              <div class="mt-1 text-xs text-muted-foreground"><%= row.expiry_label %></div>
            </td>
            <td class="text-muted-foreground"><%= row.created_on_label %></td>
            <td class="text-right"><%= render "hotel_portal/corporate_accounts/invitation_actions", row: row, presenter: presenter %></td>
          </tr>
          <%# A link made for a contact the email cannot reach. Shown once, under its own row. %>
          <% if @revealed_link && @revealed_link[:id] == row.invitation.id %>
            <tr data-testid="external-invitation-link-row-<%= row.id %>">
              <td colspan="8" class="bg-muted/40">
                <div class="flex flex-wrap items-center gap-2" data-controller="clipboard" data-clipboard-success-text-value="Copied">
                  <code data-clipboard-target="source" class="min-w-0 flex-1 break-all rounded-md bg-card px-3 py-2 font-mono text-xs text-foreground"><%= @revealed_link[:url] %></code>
                  <button type="button" data-clipboard-target="button" data-action="clipboard#copy"
                          class="inline-flex items-center gap-x-1 rounded-lg border border-border bg-card px-3 py-2 text-xs font-semibold text-foreground transition hover:border-border-interactive">
                    <%= cached_icon "copy", class: "size-3.5", aria: { hidden: true } %> Copy
                  </button>
                  <span data-clipboard-target="status" class="sr-only" aria-live="polite"></span>
                </div>
                <p class="mt-1 text-xs text-muted-foreground">Send this to <%= row.contact_email %>. Any earlier link or email no longer works.</p>
              </td>
            </tr>
          <% end %>
        <% end %>

        <% if presenter.pinned_rows.any? && presenter.paginated_rows.any? %>
          <tr aria-hidden="true">
            <td colspan="8" class="!p-0"><div class="h-px bg-border"></div></td>
          </tr>
        <% end %>

        <% presenter.paginated_rows.each do |row| %>
          <tr data-testid="<%= row.dom_id %>" role="link" tabindex="0"
            aria-label="Edit <%= row.account_name %>"
            data-controller="clickable-row"
            data-clickable-row-url-value="<%= edit_hotel_corporate_account_path(current_hotel, row.relationship, return_to: request.fullpath) %>"
            data-action="click->clickable-row#visit keydown->clickable-row#visitFromKeyboard">
            <%= render "hotel_portal/corporate_accounts/row_identity", row: row %>
            <td class="font-mono text-xs font-semibold text-foreground"><%= row.agent_code.presence || "—" %></td>
            <td class="text-muted-foreground">
              <%= row.account_type_label %>
              <% if row.relationship.market.present? %>
                <span class="mt-0.5 block text-xs" data-testid="agent-market"><%= row.relationship.market_label %></span>
              <% end %>
            </td>
            <td class="text-muted-foreground"><%= row.terms_label %></td>
            <td><%= render "hotel_portal/corporate_accounts/credit_cell",
                            exposure: row.credit_exposure, direct_bill: row.direct_bill? %></td>
            <td><%= render PanelsUI::Badge.new(label: row.status_label, variant: row.status_variant, indicator: true) %></td>
            <td class="text-muted-foreground"><%= row.created_on_label %></td>
            <td class="text-right"><%= render "hotel_portal/corporate_accounts/account_actions", row: row %></td>
          </tr>
        <% end %>
      <% end %>
    <% end %>

    <% if presenter.pagination.pages > 1 %>
      <div class="border-t border-border px-4 py-3">
        <%= render PanelsUI::Pagination.new(
          pagy: presenter.pagination,
          hide_when_single_page: true,
          link_data: { turbo_action: "advance" }
        ) %>
      </div>
    <% end %>
  <% else %>
    <%= render "hotel_portal/corporate_accounts/empty_state", presenter: presenter %>
  <% end %>
</div>
