<%= form_with model: @relationship, url: hotel_corporate_account_path(current_hotel, @relationship), method: :patch,
  class: "flex min-h-0 flex-1 flex-col", data: { turbo_frame: HotelPortal::CorporateAccountsController::WORKSPACE_FRAME,
    controller: "tin-validation", tin_validation_url_value: hotel_validate_tin_path(current_hotel) } do |form| %>
  <%= hidden_field_tag :return_to, @return_to %>
  <%= hidden_field_tag :tab, @active_tab %>
  <div class="min-h-0 flex-1 space-y-5 overflow-y-auto overscroll-contain p-5 custom-scrollbar">
    <% if @relationship.errors.any? %>
      <%= render PanelsUI::Alert.new(tone: :destructive, title: "This account could not be saved") do |alert| %>
        <% alert.with_description do %><%= @relationship.errors.full_messages.to_sentence %><% end %>
      <% end %>
    <% end %>
    <%= render "#{@active_tab}_fields", form: form %>
  </div>
  <div class="flex shrink-0 items-center justify-end gap-2 border-t border-border bg-muted/50 px-5 py-3">
    <%= render PanelsUI::Button.new(as: :a, href: @return_to, variant: :ghost, data: { turbo_frame: "_top" }) do %>Back to accounts<% end %>
    <%= render PanelsUI::Button.new(as: :button, type: :submit, variant: :primary, data: { turbo_submits_with: "Saving…" }) do %>Save changes<% end %>
  </div>
<% end %>
