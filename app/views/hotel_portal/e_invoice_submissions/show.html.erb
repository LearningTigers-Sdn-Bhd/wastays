<div class="mx-auto max-w-[900px] space-y-6 pb-20 px-4 md:px-0">
  <div class="mt-5">
    <%= link_to "← All Submissions", hotel_e_invoice_submissions_path(current_hotel), class: "text-sm text-slate-500 hover:text-slate-800" %>
    <div class="mt-3 flex items-start justify-between">
      <div>
        <h1 class="text-2xl font-bold tracking-tight text-slate-950">E-Invoice: <%= @submission.internal_id || @submission.booking&.confirmation_token %></h1>
        <p class="mt-1 text-sm text-slate-500">Booking <%= @booking.confirmation_token %> · <%= @booking.guest_name %></p>
      </div>
      <div class="flex items-center gap-2">
        <%= render "status_badge", submission: @submission %>
        <% if @submission.refreshable? %>
          <%= button_to "Refresh Status", refresh_status_hotel_e_invoice_submission_path(current_hotel, @submission),
              method: :post,
              class: "rounded-lg border border-slate-300 bg-white px-3 py-1.5 text-xs font-semibold text-slate-700 hover:bg-slate-50 cursor-pointer" %>
        <% end %>
      </div>
    </div>
  </div>

  <%# Summary card %>
  <div class="rounded-2xl border border-slate-200 bg-white shadow-sm overflow-hidden">
    <div class="border-b border-slate-100 bg-slate-50 px-6 py-4">
      <p class="text-xs font-semibold uppercase tracking-widest text-slate-500">Submission Details</p>
    </div>
    <dl class="grid grid-cols-2 gap-px bg-slate-100 sm:grid-cols-3">
      <% [
        ["Document Type", @submission.document_type_label],
        ["Internal ID", @submission.internal_id || "—"],
        ["LHDN UUID", @submission.uuid&.first(20).then { |u| u ? "#{u}…" : "—" }],
        ["Submission UID", @submission.submission_uid&.first(20).then { |u| u ? "#{u}…" : "—" }],
        ["Submitted At", @submission.submitted_at&.strftime("%d %b %Y %H:%M") || "—"],
        ["Validated At", @submission.validated_at&.strftime("%d %b %Y %H:%M") || "—"]
      ].each do |label, value| %>
        <div class="bg-white px-5 py-4">
          <dt class="text-xs font-medium text-slate-500"><%= label %></dt>
          <dd class="mt-1 text-sm font-semibold text-slate-900 font-mono break-all"><%= value %></dd>
        </div>
      <% end %>
    </dl>
  </div>

  <%# Validation link / QR %>
  <% if @submission.validation_url %>
    <div class="rounded-2xl border border-emerald-200 bg-emerald-50 px-6 py-5">
      <p class="text-sm font-semibold text-emerald-900">LHDN Validation Link</p>
      <p class="mt-1 text-xs text-emerald-700 break-all"><%= @submission.validation_url %></p>
      <%= link_to "Open on MyInvois →", @submission.validation_url, target: "_blank",
          class: "mt-2 inline-flex text-xs font-semibold text-emerald-700 underline" %>
    </div>
  <% end %>

  <%# Error details %>
  <% if @submission.invalid? && @submission.error_details.present? %>
    <div class="rounded-2xl border border-red-200 bg-red-50 px-6 py-5">
      <p class="text-sm font-semibold text-red-900">Validation Errors</p>
      <pre class="mt-2 overflow-x-auto text-xs text-red-700"><%= JSON.pretty_generate(@submission.error_details) %></pre>
    </div>
  <% end %>

  <%# Cancel action %>
  <% if @submission.cancellable? %>
    <div class="rounded-2xl border border-slate-200 bg-white px-6 py-5">
      <p class="text-sm font-semibold text-slate-900">Cancel this E-Invoice</p>
      <p class="mt-1 text-xs text-slate-500">Only valid e-invoices can be cancelled. This action is irreversible.</p>
      <%= form_with url: cancel_hotel_e_invoice_submission_path(current_hotel, @submission), method: :post, local: true, class: "mt-3 flex items-end gap-3" do |f| %>
        <div class="flex-1">
          <%= f.text_field :reason, placeholder: "Reason for cancellation",
              class: "w-full rounded-xl border border-slate-200 px-4 py-2.5 text-sm focus:outline-none focus:ring-0" %>
        </div>
        <%= f.submit "Cancel E-Invoice", data: { turbo_confirm: "Cancel this e-invoice? This cannot be undone." },
            class: "rounded-lg bg-red-600 px-4 py-2.5 text-sm font-semibold text-white hover:bg-red-700 cursor-pointer" %>
      <% end %>
    </div>
  <% end %>
</div>
