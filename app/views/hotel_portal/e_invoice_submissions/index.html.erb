<div class="max-w-[1600px] mx-auto pb-20 space-y-8">
  <div class="px-4 md:px-0">
    <div class="mt-5">
      <div>
        <h1 class="text-2xl font-bold tracking-tight text-slate-950 sm:text-3xl">E-Invoice Workspace</h1>
        <p class="mt-1 text-sm font-medium text-slate-600">Monitor submission health, review guest-requested failures, and follow LHDN validation activity for <%= current_hotel.name %>.</p>
      </div>
    </div>
  </div>

  <div class="grid grid-cols-1 overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm md:grid-cols-4">
    <div class="p-8 md:border-r md:border-slate-200">
      <p class="text-[11px] font-semibold uppercase tracking-wider text-slate-500">Waiting / Pending</p>
      <p class="mt-2 text-3xl font-bold tracking-tight text-slate-950"><%= @summary_counts[:pending] %></p>
      <p class="mt-2 text-sm text-slate-600">Preparing or waiting for LHDN confirmation.</p>
    </div>
    <div class="bg-slate-50/40 p-8 md:border-r md:border-slate-200">
      <p class="text-[11px] font-semibold uppercase tracking-wider text-slate-500">Rejected</p>
      <p class="mt-2 text-3xl font-bold tracking-tight text-red-700"><%= @summary_counts[:rejected] %></p>
      <p class="mt-2 text-sm text-slate-600">Need correction before retry.</p>
    </div>
    <div class="p-8 md:border-r md:border-slate-200">
      <p class="text-[11px] font-semibold uppercase tracking-wider text-slate-500">Valid</p>
      <p class="mt-2 text-3xl font-bold tracking-tight text-emerald-700"><%= @summary_counts[:valid] %></p>
      <p class="mt-2 text-sm text-slate-600">Accepted and validated by LHDN.</p>
    </div>
    <div class="bg-amber-50/60 p-8">
      <p class="text-[11px] font-semibold uppercase tracking-wider text-amber-700">Guest Waiting</p>
      <p class="mt-2 text-3xl font-bold tracking-tight text-amber-900"><%= @summary_counts[:guest_requested_attention] %></p>
      <p class="mt-2 text-sm text-amber-900/80">Guest-requested rejections that should be reviewed first.</p>
    </div>
  </div>

  <div class="grid grid-cols-1 gap-6 lg:grid-cols-[minmax(0,1fr)_320px]">
    <div class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">
      <div class="border-b border-slate-200 bg-slate-50/60 px-8 py-6">
        <h2 class="text-lg font-bold tracking-tight text-slate-950">Submission activity</h2>
        <p class="mt-1 text-sm text-slate-600">Track every invoice, adjustment note, status change, and guest-requested follow-up in one place.</p>
      </div>

      <% if @submissions.empty? %>
        <div class="px-8 py-12 text-center">
          <%= cached_icon "file-text", class: "mx-auto size-10 text-slate-300" %>
          <h3 class="mt-3 text-base font-semibold text-slate-900">No e-invoice records yet</h3>
          <p class="mt-1 text-sm text-slate-500">Records will appear here after your team sends the first e-invoice from a booking folio.</p>

          <div class="mx-auto mt-5 max-w-md rounded-2xl border border-slate-200 bg-slate-50 px-5 py-4 text-left">
            <p class="text-sm font-semibold text-slate-900">Quick start</p>
            <ol class="mt-2 space-y-1 text-xs text-slate-600">
              <li>1. Turn on e-invoice in settings</li>
              <li>2. Complete hotel details if guest may pay the hotel directly</li>
              <li>3. Open a closed folio and send the e-invoice from there</li>
            </ol>
          </div>
        </div>
      <% else %>
        <div class="overflow-x-auto">
          <table class="w-full text-sm">
            <thead class="border-b border-slate-200 bg-slate-50">
              <tr>
                <th class="px-8 py-3 text-left text-xs font-semibold uppercase tracking-wider text-slate-500">Booking / Guest</th>
                <th class="px-8 py-3 text-left text-xs font-semibold uppercase tracking-wider text-slate-500">Document</th>
                <th class="px-8 py-3 text-left text-xs font-semibold uppercase tracking-wider text-slate-500">Status</th>
                <th class="px-8 py-3 text-left text-xs font-semibold uppercase tracking-wider text-slate-500">Flow</th>
                <th class="px-8 py-3 text-left text-xs font-semibold uppercase tracking-wider text-slate-500">Updated</th>
                <th class="px-8 py-3"></th>
              </tr>
            </thead>
            <tbody class="divide-y divide-slate-100">
              <% @submissions.each do |sub| %>
                <tr class="align-top transition hover:bg-slate-50">
                  <td class="px-8 py-4">
                    <p class="font-semibold text-slate-900"><%= sub.booking&.confirmation_token %></p>
                    <p class="mt-0.5 text-sm text-slate-600"><%= sub.booking&.guest_name %></p>
                    <% if sub.requested_by_guest? %>
                      <span class="mt-2 inline-flex items-center rounded-full bg-amber-50 px-2.5 py-1 text-[11px] font-semibold text-amber-800">Guest requested</span>
                    <% end %>
                  </td>
                  <td class="px-8 py-4">
                    <p class="font-semibold text-slate-900"><%= sub.internal_id || "Draft record" %></p>
                    <p class="mt-0.5 text-xs text-slate-500"><%= sub.document_type_label %> · <%= sub.document_scenario_label %></p>
                    <% if sub.invalid? && sub.error_message.present? %>
                      <p class="mt-2 text-xs text-red-600"><%= sub.error_message %></p>
                    <% end %>
                  </td>
                  <td class="px-8 py-4"><%= render "status_badge", submission: sub %></td>
                  <td class="px-8 py-4">
                    <p class="text-sm text-slate-700"><%= sub.requested_by_guest? ? "Guest self-service" : "System / staff flow" %></p>
                    <p class="mt-0.5 text-xs text-slate-500"><%= sub.submission_mode.humanize %> submission</p>
                  </td>
                  <td class="px-8 py-4 text-sm text-slate-500"><%= (sub.validated_at || sub.submitted_at || sub.updated_at)&.strftime("%d %b %Y %H:%M") || "—" %></td>
                  <td class="px-8 py-4 text-right">
                    <%= link_to "Open", hotel_e_invoice_submission_path(current_hotel, sub), class: "text-xs font-semibold text-blue-600 hover:underline" %>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
        <div class="border-t border-slate-200 bg-slate-50/50 px-8 py-4">
          <div class="flex justify-center">
          <%= paginate @submissions %>
          </div>
        </div>
      <% end %>
    </div>

    <div class="space-y-6">
      <div class="rounded-2xl border border-slate-200 bg-white p-8 shadow-sm">
        <h2 class="text-base font-bold text-slate-950">E-Invoice Settings</h2>
        <% if !@setting.enabled? %>
          <p class="mt-2 text-sm text-slate-600">Open E-Invoice Settings to turn this feature on before your team starts sending records.</p>
        <% elsif @missing_config.any? %>
          <p class="mt-2 text-sm text-amber-800">Open E-Invoice Settings to complete the hotel details needed for direct hotel payment cases.</p>
        <% else %>
          <p class="mt-2 text-sm text-emerald-700">Your E-Invoice Settings are ready.</p>
        <% end %>
        <%= link_to "Open E-Invoice Settings", hotel_settings_path(current_hotel, tab: "einvoice"),
            class: "mt-4 inline-flex items-center rounded-xl border border-slate-300 bg-white px-4 py-2.5 text-sm font-semibold text-slate-700 hover:bg-slate-50" %>
      </div>

      <div class="rounded-2xl border border-blue-100 bg-blue-50 p-8">
        <h2 class="text-base font-bold text-blue-950">How to use this workspace</h2>
        <ul class="mt-3 space-y-2 text-sm text-blue-900/80">
          <li>Prioritize guest-requested rejected records first.</li>
          <li>Use each record page to refresh status, retry, cancel, or open LHDN validation links.</li>
          <li>Use Settings only for hotel setup and intermediary tax details.</li>
        </ul>
      </div>
    </div>
  </div>
</div>
