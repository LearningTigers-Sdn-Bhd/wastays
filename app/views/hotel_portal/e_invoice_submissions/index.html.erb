<div class="mx-auto max-w-[1200px] space-y-6 pb-20 px-4 md:px-0">
  <div class="flex items-center justify-between mt-5">
    <div>
      <h1 class="text-2xl font-bold tracking-tight text-slate-950 sm:text-3xl">E-Invoice Submissions</h1>
      <p class="mt-1 text-sm font-medium text-slate-600">LHDN MyInvois submissions for <%= current_hotel.name %>.</p>
    </div>
    <%= link_to "Configure Settings", hotel_settings_path(current_hotel, tab: "einvoice"),
        class: "inline-flex items-center gap-2 rounded-lg border border-slate-300 bg-white px-4 py-2 text-sm font-semibold text-slate-700 hover:bg-slate-50 transition" %>
  </div>

  <% if @submissions.empty? %>
    <div class="rounded-2xl border border-dashed border-slate-300 bg-white p-12 text-center">
      <%= cached_icon "file-text", class: "mx-auto size-10 text-slate-300" %>
      <h3 class="mt-3 text-base font-semibold text-slate-900">No submissions yet</h3>
      <p class="mt-1 text-sm text-slate-500">E-invoices submitted via closed folios will appear here.</p>
    </div>
  <% else %>
    <div class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">
      <table class="w-full text-sm">
        <thead class="bg-slate-50 border-b border-slate-200">
          <tr>
            <th class="px-6 py-3 text-left text-xs font-semibold uppercase tracking-wider text-slate-500">Invoice / Booking</th>
            <th class="px-6 py-3 text-left text-xs font-semibold uppercase tracking-wider text-slate-500">Guest</th>
            <th class="px-6 py-3 text-left text-xs font-semibold uppercase tracking-wider text-slate-500">Submitted</th>
            <th class="px-6 py-3 text-left text-xs font-semibold uppercase tracking-wider text-slate-500">Status</th>
            <th class="px-6 py-3 text-left text-xs font-semibold uppercase tracking-wider text-slate-500">LHDN UUID</th>
            <th class="px-6 py-3"></th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-100">
          <% @submissions.each do |sub| %>
            <tr class="hover:bg-slate-50 transition">
              <td class="px-6 py-3">
                <p class="font-semibold text-slate-900"><%= sub.internal_id || "—" %></p>
                <p class="text-xs text-slate-500"><%= sub.booking&.confirmation_token %></p>
              </td>
              <td class="px-6 py-3 text-slate-700"><%= sub.booking&.guest_name %></td>
              <td class="px-6 py-3 text-slate-500"><%= sub.submitted_at&.strftime("%d %b %Y %H:%M") || "—" %></td>
              <td class="px-6 py-3"><%= render "status_badge", submission: sub %></td>
              <td class="px-6 py-3">
                <span class="font-mono text-xs text-slate-400 truncate block max-w-[140px]"><%= sub.uuid&.first(16) %>…</span>
              </td>
              <td class="px-6 py-3 text-right">
                <%= link_to "View", hotel_e_invoice_submission_path(current_hotel, sub), class: "text-xs font-semibold text-blue-600 hover:underline" %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
    <%= paginate @submissions %>
  <% end %>
</div>
