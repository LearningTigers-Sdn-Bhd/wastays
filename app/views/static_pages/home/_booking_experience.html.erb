              <svg class="w-8 h-8 text-[#25D366]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z"></path></svg>
            </div>
            <div class="absolute -top-2 -right-2 w-7 h-7 rounded-full bg-[#25D366] text-white text-xs font-bold flex items-center justify-center shadow">3</div>
          </div>
          <h4 class="text-lg lg:text-xl font-bold text-foreground mb-2 leading-snug">Payment & confirmation</h4>
          <p class="text-sm lg:text-base text-muted-foreground leading-relaxed max-w-[180px]">Secure payment link sent and confirmed in chat.</p>
        </div>

        <!-- Step 4: Reminder notifications -->
        <div class="group relative flex flex-col items-center text-center" data-animate style="transition-delay: 0.35s">
          <div class="booking-step-connector hidden lg:block absolute top-10 left-[calc(50%+2.5rem)] w-[calc(100%+1rem-5rem)] h-px bg-border/50"></div>
          <div class="relative mb-6">
            <div class="w-20 h-20 rounded-2xl bg-[#fdfbf7] border border-border/50 group-hover:border-primary/30 group-hover:bg-primary/5 transition-all duration-300 flex items-center justify-center shadow-sm">
              <svg class="w-8 h-8 text-primary/70" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9"></path></svg>
