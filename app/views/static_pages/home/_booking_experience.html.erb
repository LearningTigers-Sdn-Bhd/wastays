          </div>
          <h4 class="text-lg lg:text-xl font-bold text-foreground mb-2 leading-snug">Reminder notifications</h4>
          <p class="text-sm lg:text-base text-muted-foreground leading-relaxed max-w-[180px]">Timely nudges sent before arrival and at checkout.</p>
        </div>

