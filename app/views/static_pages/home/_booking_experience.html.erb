          <div class="booking-step-connector hidden lg:block absolute top-10 left-[calc(50%+2.5rem)] w-[calc(100%+1rem-5rem)] h-px bg-border/50"></div>
          <div class="relative mb-6">
            <div class="w-20 h-20 rounded-2xl bg-[#fdfbf7] border border-border/50 group-hover:border-primary/30 group-hover:bg-primary/5 transition-all duration-300 flex items-center justify-center shadow-sm">
              <svg class="w-8 h-8 text-primary/70" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.7" d="M8 3v3"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.7" d="M16 3v3"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.7" d="M4 9h16"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.7" d="M5 5h14a2 2 0 0 1 2 2v10a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V7a2 2 0 0 1 2-2Z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.7" d="m9 14 2 2 4-4"></path></svg>
            </div>
            <div class="absolute -top-2 -right-2 w-7 h-7 rounded-full bg-primary text-white text-xs font-bold flex items-center justify-center shadow">1</div>
          </div>
          <h4 class="text-lg lg:text-xl font-bold text-foreground mb-2 leading-snug">Instant room booking</h4>
          <p class="text-sm lg:text-base text-muted-foreground leading-relaxed max-w-[180px]">Guest selects room and confirms directly in chat.</p>
        </div>

        <!-- Step 2: Automated pre-check-in -->
        <div class="group relative flex flex-col items-center text-center" data-animate style="transition-delay: 0.15s">
          <div class="booking-step-connector hidden lg:block absolute top-10 left-[calc(50%+2.5rem)] w-[calc(100%+1rem-5rem)] h-px bg-border/50"></div>
          <div class="relative mb-6">
            <div class="w-20 h-20 rounded-2xl bg-[#fdfbf7] border border-border/50 group-hover:border-primary/30 group-hover:bg-primary/5 transition-all duration-300 flex items-center justify-center shadow-sm">
