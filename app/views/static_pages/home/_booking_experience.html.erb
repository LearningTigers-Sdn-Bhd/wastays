            </div>
            <div class="absolute -top-2 -right-2 w-7 h-7 rounded-full bg-primary text-white text-xs font-bold flex items-center justify-center shadow">2</div>
          </div>
          <h4 class="text-lg lg:text-xl font-bold text-foreground mb-2 leading-snug">Automated pre-check-in</h4>
          <p class="text-sm lg:text-base text-muted-foreground leading-relaxed max-w-[180px]">Guest details collected via WhatsApp before arrival.</p>
        </div>

        <!-- Step 3: Payment & confirmation -->
        <div class="group relative flex flex-col items-center text-center" data-animate style="transition-delay: 0.25s">
