    <!-- Pipeline flow -->
    <div class="relative">
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-6 lg:gap-4 relative z-10">

        <!-- Step 1: Instant room booking -->
