<!-- Built-In Booking Experience Section -->
<div class="bg-white py-24 lg:py-28 overflow-hidden">
  <div class="max-w-[85rem] px-4 sm:px-6 lg:px-8 mx-auto">

    <!-- Header -->
    <div class="text-center mb-16 max-w-2xl mx-auto">
      <div class="inline-flex items-center gap-x-3 mb-6">
        <span class="w-8 h-px bg-brand-primary/30"></span>
        <span class="text-[10px] font-bold uppercase tracking-[0.3em] text-brand-primary">Booking Experience</span>
        <span class="w-8 h-px bg-brand-primary/30"></span>
      </div>
      <h2 class="text-4xl lg:text-5xl font-serif text-neutral-text-primary mb-5 leading-tight">
        Built-In <span class="italic text-brand-primary">Booking Experience</span>
      </h2>
      <p class="text-lg text-neutral-text-secondary leading-relaxed">
        While WAStays focuses on hospitality, it also enables the full booking journey — all inside WhatsApp, seamlessly.
      </p>
    </div>

    <!-- Pipeline flow -->
    <div class="relative">

      <!-- Connecting line (desktop) -->
      <div class="hidden lg:block absolute top-10 left-0 right-0 h-px bg-gradient-to-r from-transparent via-neutral-border/60 to-transparent z-0"></div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-6 lg:gap-4 relative z-10">

        <!-- Step 1: Instant room booking -->
        <div class="group flex flex-col items-center text-center">
          <div class="relative mb-6">
            <div class="w-20 h-20 rounded-2xl bg-[#fdfbf7] border border-neutral-border/50 group-hover:border-brand-primary/30 group-hover:bg-brand-primary/5 transition-all duration-300 flex items-center justify-center shadow-sm">
              <svg class="w-8 h-8 text-brand-primary/70" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M8 10h.01M12 10h.01M16 10h.01M9 16H5a2 2 0 01-2-2V6a2 2 0 012 2h14a2 2 0 012 2v8a2 2 0 01-2 2h-5l-5 5v-5z"></path></svg>
            </div>
            <div class="absolute -top-2 -right-2 w-6 h-6 rounded-full bg-brand-primary text-white text-[10px] font-bold flex items-center justify-center shadow">1</div>
          </div>
          <h4 class="text-sm font-bold text-neutral-text-primary mb-2">Instant room booking</h4>
          <p class="text-xs text-neutral-text-secondary leading-relaxed max-w-[140px]">Guest selects room and confirms directly in chat.</p>
        </div>

        <!-- Arrow (desktop only) -->
        <div class="hidden lg:flex absolute items-center" style="left: calc(20% - 8px); top: 32px;">
          <svg class="w-4 h-4 text-neutral-border/80" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg>
        </div>

        <!-- Step 2: Automated pre-check-in -->
        <div class="group flex flex-col items-center text-center">
          <div class="relative mb-6">
            <div class="w-20 h-20 rounded-2xl bg-[#fdfbf7] border border-neutral-border/50 group-hover:border-brand-primary/30 group-hover:bg-brand-primary/5 transition-all duration-300 flex items-center justify-center shadow-sm">
              <svg class="w-8 h-8 text-brand-primary/70" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path></svg>
            </div>
            <div class="absolute -top-2 -right-2 w-6 h-6 rounded-full bg-brand-primary text-white text-[10px] font-bold flex items-center justify-center shadow">2</div>
          </div>
          <h4 class="text-sm font-bold text-neutral-text-primary mb-2">Automated pre-check-in</h4>
          <p class="text-xs text-neutral-text-secondary leading-relaxed max-w-[140px]">Guest details collected via WhatsApp before arrival.</p>
        </div>

        <!-- Step 3: Payment & confirmation -->
        <div class="group flex flex-col items-center text-center">
          <div class="relative mb-6">
            <div class="w-20 h-20 rounded-2xl bg-[#fdfbf7] border border-[#25D366]/30 bg-[#25D366]/5 transition-all duration-300 flex items-center justify-center shadow-sm ring-1 ring-[#25D366]/10">
              <svg class="w-8 h-8 text-[#25D366]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z"></path></svg>
            </div>
            <div class="absolute -top-2 -right-2 w-6 h-6 rounded-full bg-[#25D366] text-white text-[10px] font-bold flex items-center justify-center shadow">3</div>
          </div>
          <h4 class="text-sm font-bold text-neutral-text-primary mb-2">Payment & confirmation</h4>
          <p class="text-xs text-neutral-text-secondary leading-relaxed max-w-[140px]">Secure payment link sent and confirmed in chat.</p>
        </div>

        <!-- Step 4: Reminder notifications -->
        <div class="group flex flex-col items-center text-center">
          <div class="relative mb-6">
            <div class="w-20 h-20 rounded-2xl bg-[#fdfbf7] border border-neutral-border/50 group-hover:border-brand-primary/30 group-hover:bg-brand-primary/5 transition-all duration-300 flex items-center justify-center shadow-sm">
              <svg class="w-8 h-8 text-brand-primary/70" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9"></path></svg>
            </div>
            <div class="absolute -top-2 -right-2 w-6 h-6 rounded-full bg-brand-primary text-white text-[10px] font-bold flex items-center justify-center shadow">4</div>
          </div>
          <h4 class="text-sm font-bold text-neutral-text-primary mb-2">Reminder notifications</h4>
          <p class="text-xs text-neutral-text-secondary leading-relaxed max-w-[140px]">Timely nudges sent before arrival and at checkout.</p>
        </div>

        <!-- Step 5: All inside WhatsApp -->
        <div class="group flex flex-col items-center text-center">
          <div class="relative mb-6">
            <div class="w-20 h-20 rounded-2xl bg-[#1e2e2a] border border-white/5 transition-all duration-300 flex items-center justify-center shadow-lg">
              <svg class="w-8 h-8 text-[#d9c5a0]" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/></svg>
            </div>
            <div class="absolute -top-2 -right-2 w-6 h-6 rounded-full bg-[#d9c5a0] text-[#1e2e2a] text-[10px] font-bold flex items-center justify-center shadow">5</div>
          </div>
          <h4 class="text-sm font-bold text-neutral-text-primary mb-2">All inside WhatsApp</h4>
          <p class="text-xs text-neutral-text-secondary leading-relaxed max-w-[140px]">Zero redirects. The entire journey in one thread.</p>
        </div>

      </div>
    </div>

    <!-- Closing strip -->
    <div class="mt-16 flex flex-col sm:flex-row items-center justify-center gap-4 sm:gap-8 py-6 px-8 bg-[#fdfbf7] rounded-2xl border border-neutral-border/40">
      <div class="flex items-center gap-x-3">
        <svg class="w-5 h-5 text-[#25D366] flex-none" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/></svg>
        <p class="text-sm font-semibold text-neutral-text-primary italic font-serif">All inside WhatsApp — seamlessly.</p>
      </div>
      <span class="hidden sm:block w-px h-5 bg-neutral-border/50"></span>
      <p class="text-xs text-neutral-text-secondary">No extra apps. No redirects. No friction.</p>
      <span class="hidden sm:block w-px h-5 bg-neutral-border/50"></span>
      <p class="text-xs text-neutral-text-secondary">From inquiry to confirmed stay in minutes.</p>
    </div>

  </div>
</div>
