<!-- Built-In Booking Experience Section -->
<div class="bg-white py-24 lg:py-28 overflow-hidden">
  <div class="max-w-[85rem] px-4 sm:px-6 lg:px-8 mx-auto">

    <!-- Header -->
    <div class="text-center mb-16 max-w-2xl mx-auto" data-animate>
      <div class="inline-flex items-center gap-x-3 mb-6">
        <span class="w-8 h-px bg-primary/30"></span>
        <span class="text-xs sm:text-sm font-bold uppercase tracking-[0.3em] text-primary">Booking Experience</span>
        <span class="w-8 h-px bg-primary/30"></span>
      </div>
      <h2 class="text-4xl lg:text-5xl font-serif text-foreground mb-5 leading-tight">
        Built-In <span class="italic text-primary">Booking Experience</span>
      </h2>
      <p class="text-xl lg:text-2xl text-muted-foreground leading-relaxed">
        While WAStays focuses on hospitality, it also enables the full booking journey — all inside WhatsApp, seamlessly.
      </p>
