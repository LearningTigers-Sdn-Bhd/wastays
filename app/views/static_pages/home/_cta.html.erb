<!-- CTA Section -->
<div class="bg-[#1e2e2a] py-32 lg:py-40 overflow-hidden relative">

  <div class="absolute inset-0 bg-cover bg-center bg-no-repeat" style="background-image: url('<%= asset_path("landing/cta-bg.jpg") %>');"></div>
  <div class="absolute inset-0 bg-[#0d1a17]/80"></div>

  <!-- Deep radial glow -->
  <div class="absolute inset-0 flex items-center justify-center pointer-events-none">
    <div class="w-[800px] h-[500px] bg-brand-primary/20 rounded-full blur-[140px]"></div>
  </div>

  <!-- Floating star decorations -->
  <div class="absolute top-16 left-[12%] w-1.5 h-1.5 rounded-full bg-[#d9c5a0]/30"></div>
  <div class="absolute top-32 left-[18%] w-1 h-1 rounded-full bg-[#d9c5a0]/20"></div>
  <div class="absolute bottom-24 right-[14%] w-2 h-2 rounded-full bg-[#25D366]/20"></div>
  <div class="absolute top-20 right-[20%] w-1 h-1 rounded-full bg-white/20"></div>
  <div class="absolute bottom-32 left-[10%] w-1.5 h-1.5 rounded-full bg-white/10"></div>

  <div class="max-w-[85rem] px-4 sm:px-6 lg:px-8 mx-auto relative z-10 text-center">

    <!-- Eyebrow -->
    <div class="inline-flex items-center gap-x-3 mb-10">
      <span class="w-8 h-px bg-[#d9c5a0]/30"></span>
      <span class="text-[10px] font-bold uppercase tracking-[0.3em] text-[#d9c5a0]">Get Started</span>
      <span class="w-8 h-px bg-[#d9c5a0]/30"></span>
    </div>

    <h2 class="text-4xl sm:text-5xl lg:text-6xl xl:text-7xl font-serif text-white mb-8 leading-[1.05] max-w-4xl mx-auto">
      Ready to Upgrade Your<br class="hidden sm:inline">
      <span class="italic text-[#d9c5a0]"> Guest Experience?</span>
    </h2>

    <p class="text-xl text-gray-400 mb-14 max-w-xl mx-auto leading-relaxed">
      Turn your hotel into a smart, automated hospitality engine — powered by WhatsApp.
    </p>

    <!-- CTA Buttons -->
    <div class="flex flex-col sm:flex-row items-center justify-center gap-4 mb-16">
      <a href="#" class="group inline-flex items-center justify-center gap-x-2 btn btn-primary px-10 py-4 rounded-xl text-base font-bold shadow-lg shadow-brand-primary/30 w-full sm:w-auto">
        Book a Demo
        <svg class="w-4 h-4 group-hover:translate-x-1 transition-transform duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"></path></svg>
      </a>
      <%= link_to for_hotels_path, class: "group inline-flex items-center justify-center gap-x-2 border border-white/20 text-white hover:bg-white/10 px-10 py-4 rounded-xl text-base font-bold transition-all duration-200 w-full sm:w-auto" do %>
        Start with WAStays
        <svg class="w-4 h-4 group-hover:translate-x-1 transition-transform duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"></path></svg>
      <% end %>
    </div>

    <!-- Trust micro-row -->
    <div class="flex flex-wrap items-center justify-center gap-x-8 gap-y-3">
      <div class="flex items-center gap-x-2 text-sm text-gray-500">
        <svg class="w-4 h-4 text-[#25D366] flex-none" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"></path></svg>
        No subscription fees
      </div>
      <span class="hidden sm:block w-px h-4 bg-white/10"></span>
      <div class="flex items-center gap-x-2 text-sm text-gray-500">
        <svg class="w-4 h-4 text-[#25D366] flex-none" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"></path></svg>
        Set up in minutes
      </div>
      <span class="hidden sm:block w-px h-4 bg-white/10"></span>
      <div class="flex items-center gap-x-2 text-sm text-gray-500">
        <svg class="w-4 h-4 text-[#25D366] flex-none" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"></path></svg>
        Pay only when you earn
      </div>
    </div>

  </div>
</div>
