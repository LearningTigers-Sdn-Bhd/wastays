<!-- Social Proof Section -->
<div id="testimonials" class="scroll-mt-20 bg-[#fdfbf7] py-24 lg:py-32 overflow-hidden relative">

  <!-- Large decorative quote mark -->
  <div class="absolute top-12 left-1/2 -translate-x-1/2 text-[14rem] font-serif leading-none text-primary/5 select-none pointer-events-none">"</div>

  <div class="max-w-[85rem] px-4 sm:px-6 lg:px-8 mx-auto relative z-10">

    <!-- Header -->
    <div class="text-center mb-16" data-animate>
      <div class="inline-flex items-center gap-x-3 mb-6">
        <span class="w-8 h-px bg-primary/30"></span>
        <span class="text-xs sm:text-sm font-bold uppercase tracking-[0.3em] text-primary">Social Proof</span>
        <span class="w-8 h-px bg-primary/30"></span>
      </div>
      <h2 class="text-4xl lg:text-5xl font-serif text-foreground leading-tight">
        What Hotel Partners <span class="italic text-primary">Are Saying</span>
      </h2>
    </div>

    <!-- Testimonials -->
    <div class="grid md:grid-cols-2 gap-6 lg:gap-8 max-w-5xl mx-auto">

      <!-- Testimonial 1 -->
      <div class="relative bg-white rounded-[2rem] p-8 lg:p-10 border border-border/50 shadow-sm hover:shadow-md hover:border-primary/20 transition-all duration-300 flex flex-col" data-animate="from-left" style="transition-delay: 0.1s">
        <!-- Quote mark -->
        <div class="text-5xl font-serif leading-none text-primary/20 mb-4 select-none">"</div>
        <blockquote class="flex-1">
          <p class="text-lg lg:text-xl font-serif text-foreground leading-relaxed italic mb-8">
            We increased direct bookings and upsell revenue within weeks. It genuinely changed how we operate.
          </p>
        </blockquote>
        <div class="flex items-center gap-x-4 pt-6 border-t border-border/40">
          <div class="w-11 h-11 rounded-full bg-primary/10 flex items-center justify-center flex-none">
            <span class="text-base font-bold text-primary">HP</span>
          </div>
          <div>
            <p class="text-base lg:text-lg font-bold text-foreground">Hotel Partner</p>
            <p class="text-sm text-muted-foreground">Independent Hotel, Malaysia</p>
          </div>
          <!-- Stars -->
          <div class="ml-auto flex items-center gap-x-0.5">
            <% 5.times do %>
              <svg class="w-4 h-4 text-[#d9c5a0]" fill="currentColor" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"></path></svg>
            <% end %>
          </div>
        </div>
      </div>

      <!-- Testimonial 2 -->
      <div class="relative bg-[#1e2e2a] rounded-[2rem] p-8 lg:p-10 border border-white/5 shadow-xl flex flex-col" data-animate="from-right" style="transition-delay: 0.2s">
        <!-- Quote mark -->
        <div class="text-5xl font-serif leading-none text-[#d9c5a0]/30 mb-4 select-none">"</div>
        <blockquote class="flex-1">
          <p class="text-lg lg:text-xl font-serif text-white leading-relaxed italic mb-8">
            Guests love the WhatsApp experience — it's fast, it's simple, and it feels personal. We get compliments about it now.
          </p>
        </blockquote>
        <div class="flex items-center gap-x-4 pt-6 border-t border-white/10">
          <div class="w-11 h-11 rounded-full bg-[#d9c5a0]/10 flex items-center justify-center flex-none">
            <span class="text-base font-bold text-[#d9c5a0]">HP</span>
          </div>
          <div>
            <p class="text-base lg:text-lg font-bold text-white">Hotel Partner</p>
            <p class="text-sm text-gray-400">Boutique Resort, Malaysia</p>
          </div>
          <!-- Stars -->
          <div class="ml-auto flex items-center gap-x-0.5">
            <% 5.times do %>
              <svg class="w-4 h-4 text-[#d9c5a0]" fill="currentColor" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"></path></svg>
            <% end %>
          </div>
        </div>
      </div>

    </div>

    <!-- Placeholder notice -->
    <div class="mt-10 text-center">
      <div class="inline-flex items-center gap-x-2 bg-white border border-border/50 rounded-full px-5 py-2.5 shadow-sm">
        <svg class="w-3.5 h-3.5 text-primary/50" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
        <span class="text-sm text-muted-foreground">More stories coming soon — we're just getting started.</span>
      </div>
    </div>

  </div>
</div>
