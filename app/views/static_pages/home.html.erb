        <span class="text-6xl lg:text-8xl font-serif italic text-brand-primary opacity-20 px-12 leading-none">Automation.</span>
        <span class="text-6xl lg:text-8xl font-serif italic text-brand-primary opacity-20 px-12 leading-none">Growth.</span>
        <span class="text-6xl lg:text-8xl font-serif italic text-brand-primary opacity-20 px-12 leading-none">Directly.</span>
        <span class="text-6xl lg:text-8xl font-serif italic text-brand-primary opacity-20 px-12 leading-none">Automatically.</span>
        <!-- Set 2 (for seamless loop) -->
        <span class="text-6xl lg:text-8xl font-serif italic text-brand-primary opacity-20 px-12 leading-none">Control.</span>
        <span class="text-6xl lg:text-8xl font-serif italic text-brand-primary opacity-20 px-12 leading-none">Automation.</span>
        <span class="text-6xl lg:text-8xl font-serif italic text-brand-primary opacity-20 px-12 leading-none">Growth.</span>
        <span class="text-6xl lg:text-8xl font-serif italic text-brand-primary opacity-20 px-12 leading-none">Directly.</span>
        <span class="text-6xl lg:text-8xl font-serif italic text-brand-primary opacity-20 px-12 leading-none">Automatically.</span>
      </div>
    </div>
  </div>

