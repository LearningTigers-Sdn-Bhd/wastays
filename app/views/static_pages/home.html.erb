<div class="relative overflow-hidden">
  <!-- Hero Section -->
  <div class="relative bg-brand-gradient py-24 sm:py-32">
    <div class="absolute inset-0 bg-black/10"></div>
    <div class="relative max-w-[85rem] mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h1 class="text-4xl sm:text-6xl font-extrabold text-white tracking-tight mb-4">
        Discover Better Deals <br>at Local Budget Hotels
      </h1>
      <p class="text-lg sm:text-xl text-white/90 max-w-2xl mx-auto mb-10">
        Direct bookings, transparent pricing, and WhatsApp support for a seamless stay across Malaysia and beyond.
      </p>

      <!-- Search Form -->
      <div class="max-w-5xl mx-auto">
        <div class="p-2 bg-white/20 backdrop-blur-md rounded-2xl shadow-2xl">
          <div class="p-4 sm:p-6 bg-white rounded-xl shadow-sm">
            <%= form_with url: hotels_path, method: :get, local: true, class: "grid grid-cols-1 md:grid-cols-12 gap-4" do |f| %>
              <!-- Destination -->
              <div class="md:col-span-4 text-left">
                <label for="city" class="block text-xs font-bold uppercase tracking-wider text-neutral-text-secondary mb-1 ms-1">Destination</label>
                <div class="relative">
                  <div class="absolute inset-y-0 start-0 flex items-center ps-3 pointer-events-none">
                    <svg class="w-4 h-4 text-neutral-text-secondary" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg>
                  </div>
                  <%= f.text_field :city, id: "city", placeholder: "Where are you going?", class: "form-input py-3 ps-10" %>
                </div>
              </div>

              <!-- Dates -->
              <div class="md:col-span-4 text-left">
                <label class="block text-xs font-bold uppercase tracking-wider text-neutral-text-secondary mb-1 ms-1">Check-in / Check-out</label>
                <div class="grid grid-cols-2 gap-x-px bg-neutral-border rounded-md overflow-hidden border border-neutral-border">
                  <%= f.date_field :check_in, id: "check_in", value: Date.today, class: "py-3 px-3 block w-full border-0 text-sm focus:ring-2 focus:ring-brand-primary" %>
                  <%= f.date_field :check_out, id: "check_out", value: Date.tomorrow, class: "py-3 px-3 block w-full border-0 text-sm focus:ring-2 focus:ring-brand-primary border-s border-neutral-border" %>
                </div>
              </div>

              <!-- Guests/Rooms -->
              <div class="md:col-span-2 text-left">
                <label for="rooms" class="block text-xs font-bold uppercase tracking-wider text-neutral-text-secondary mb-1 ms-1">Rooms</label>
                <div class="relative">
                  <div class="absolute inset-y-0 start-0 flex items-center ps-3 pointer-events-none">
                    <svg class="w-4 h-4 text-neutral-text-secondary" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 7V5a2 2 0 0 1 2-2h2"/><path d="M17 3h2a2 2 0 0 1 2 2v2"/><path d="M21 17v2a2 2 0 0 1-2 2h-2"/><path d="M7 21H5a2 2 0 0 1-2-2v-2"/><rect width="7" height="5" x="7" y="7" rx="1"/><rect width="7" height="5" x="10" y="12" rx="1"/></svg>
                  </div>
                  <%= f.number_field :rooms, id: "rooms", value: 1, min: 1, class: "form-input py-3 ps-10" %>
                </div>
              </div>

              <!-- Submit -->
              <div class="md:col-span-2 flex items-end">
                <%= f.submit "Find Stays", class: "btn btn-gradient w-full py-3 shadow-lg shadow-brand-primary/30" %>
              </div>
            <% end %>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Featured Hotels -->
  <div class="bg-neutral-bg py-16 sm:py-24">
    <div class="max-w-[85rem] px-4 sm:px-6 lg:px-8 mx-auto">
      <div class="flex justify-between items-end mb-10">
        <div>
          <h2 class="text-3xl font-bold text-neutral-text-primary">Featured Stays</h2>
          <p class="text-neutral-text-secondary mt-1">Hand-picked local gems for your next trip.</p>
        </div>
        <a href="<%= hotels_path %>" class="text-brand-primary font-bold hover:underline hidden sm:block">Explore all hotels →</a>
      </div>

      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
        <%# Mocked featured hotels for now %>
        <div class="card group cursor-pointer hover:shadow-xl transition-all duration-300">
          <div class="aspect-video bg-gray-200 relative overflow-hidden">
            <img src="https://images.unsplash.com/photo-1566073771259-6a8506099945?auto=format&fit=crop&q=80&w=800" class="object-cover w-full h-full group-hover:scale-110 transition-transform duration-500" alt="Hotel">
            <div class="absolute top-3 right-3">
              <span class="badge bg-white/90 text-brand-primary backdrop-blur-sm">Featured</span>
            </div>
          </div>
          <div class="p-5">
            <div class="flex justify-between items-start mb-2">
              <h3 class="text-lg font-bold text-neutral-text-primary">Jesselton Cabin</h3>
              <div class="flex items-center text-amber-500">
                <svg class="w-4 h-4 fill-current" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
                <span class="text-sm font-bold ms-1 text-neutral-text-primary">4.8</span>
              </div>
            </div>
            <p class="text-sm text-neutral-text-secondary mb-4 flex items-center">
              <svg class="w-3 h-3 me-1" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg>
              Kota Kinabalu, Sabah
            </p>
            <div class="flex items-center justify-between border-t border-neutral-border pt-4">
              <div>
                <p class="text-[10px] text-neutral-text-secondary uppercase font-bold tracking-wider">Starts from</p>
                <p class="text-xl font-extrabold text-neutral-text-primary">RM 120<span class="text-xs font-normal text-neutral-text-secondary">/night</span></p>
              </div>
              <a href="#" class="btn btn-primary py-2 px-4">Book Now</a>
            </div>
          </div>
        </div>

        <div class="card group cursor-pointer hover:shadow-xl transition-all duration-300">
          <div class="aspect-video bg-gray-200 relative overflow-hidden">
            <img src="https://images.unsplash.com/photo-1520250497591-112f2f40a3f4?auto=format&fit=crop&q=80&w=800" class="object-cover w-full h-full group-hover:scale-110 transition-transform duration-500" alt="Hotel">
          </div>
          <div class="p-5">
            <div class="flex justify-between items-start mb-2">
              <h3 class="text-lg font-bold text-neutral-text-primary">Penang Heritage Inn</h3>
              <div class="flex items-center text-amber-500">
                <svg class="w-4 h-4 fill-current" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
                <span class="text-sm font-bold ms-1 text-neutral-text-primary">4.6</span>
              </div>
            </div>
            <p class="text-sm text-neutral-text-secondary mb-4 flex items-center">
              <svg class="w-3 h-3 me-1" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg>
              George Town, Penang
            </p>
            <div class="flex items-center justify-between border-t border-neutral-border pt-4">
              <div>
                <p class="text-[10px] text-neutral-text-secondary uppercase font-bold tracking-wider">Starts from</p>
                <p class="text-xl font-extrabold text-neutral-text-primary">RM 145<span class="text-xs font-normal text-neutral-text-secondary">/night</span></p>
              </div>
              <a href="#" class="btn btn-primary py-2 px-4">Book Now</a>
            </div>
          </div>
        </div>

        <div class="card group cursor-pointer hover:shadow-xl transition-all duration-300">
          <div class="aspect-video bg-gray-200 relative overflow-hidden">
            <img src="https://images.unsplash.com/photo-1582719478250-c89cae4dc85b?auto=format&fit=crop&q=80&w=800" class="object-cover w-full h-full group-hover:scale-110 transition-transform duration-500" alt="Hotel">
          </div>
          <div class="p-5">
            <div class="flex justify-between items-start mb-2">
              <h3 class="text-lg font-bold text-neutral-text-primary">KL City Hub</h3>
              <div class="flex items-center text-amber-500">
                <svg class="w-4 h-4 fill-current" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
                <span class="text-sm font-bold ms-1 text-neutral-text-primary">4.5</span>
              </div>
            </div>
            <p class="text-sm text-neutral-text-secondary mb-4 flex items-center">
              <svg class="w-3 h-3 me-1" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg>
              Kuala Lumpur
            </p>
            <div class="flex items-center justify-between border-t border-neutral-border pt-4">
              <div>
                <p class="text-[10px] text-neutral-text-secondary uppercase font-bold tracking-wider">Starts from</p>
                <p class="text-xl font-extrabold text-neutral-text-primary">RM 180<span class="text-xs font-normal text-neutral-text-secondary">/night</span></p>
              </div>
              <a href="#" class="btn btn-primary py-2 px-4">Book Now</a>
            </div>
          </div>
        </div>
      </div>
      
      <div class="mt-10 text-center sm:hidden">
        <a href="<%= hotels_path %>" class="btn btn-secondary w-full">Explore all hotels</a>
      </div>
    </div>
  </div>

  <!-- Hotel Owner Promo -->
  <div class="max-w-[85rem] px-4 py-16 sm:px-6 lg:px-8 mx-auto">
    <div class="bg-neutral-text-primary rounded-3xl overflow-hidden shadow-2xl relative">
      <div class="absolute inset-0 opacity-20 bg-[radial-gradient(circle_at_top_right,_var(--tw-gradient-stops))] from-brand-secondary via-brand-primary to-transparent"></div>
      <div class="relative px-6 py-12 text-center sm:px-12 sm:py-20 max-w-3xl mx-auto">
        <h2 class="text-3xl font-extrabold text-white sm:text-4xl mb-6">
          Own an independent or local hotel?
        </h2>
        <p class="text-lg text-white/80 mb-10">
          Join WAStays for free. No monthly subscription, no hidden fees. Only pay a small margin when you get confirmed bookings.
        </p>
        <div class="flex flex-col sm:flex-row justify-center gap-4">
          <%= link_to "Register Your Hotel", register_path, class: "btn btn-gradient py-3 px-8 text-base shadow-xl" %>
          <%= link_to "Login to Dashboard", login_path, class: "btn btn-secondary py-3 px-8 text-base border-white/20 bg-white/10 text-white hover:bg-white/20" %>
        </div>
      </div>
    </div>
  </div>

  <!-- Booking Help / Trust -->
  <div class="max-w-[85rem] px-4 pb-24 sm:px-6 lg:px-8 mx-auto">
    <div class="grid md:grid-cols-2 gap-12 items-center">
      <div>
        <h2 class="text-3xl font-bold text-neutral-text-primary mb-6">Need help with your booking?</h2>
        <p class="text-neutral-text-secondary mb-8 leading-relaxed">
          Our friendly travel assistants are available via WhatsApp to help you find the perfect stay, handle group bookings, or assist with any changes to your reservation.
        </p>
        <div class="space-y-4">
          <div class="flex items-start gap-x-4">
            <div class="bg-green-100 text-green-600 p-2 rounded-lg">
              <svg class="w-5 h-5" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
            </div>
            <div>
              <h4 class="font-bold text-neutral-text-primary">Instant Assistance</h4>
              <p class="text-sm text-neutral-text-secondary">Get answers to your questions in minutes.</p>
            </div>
          </div>
          <div class="flex items-start gap-x-4">
            <div class="bg-blue-100 text-blue-600 p-2 rounded-lg">
              <svg class="w-5 h-5" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14.5 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7.5L14.5 2z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/><polyline points="10 9 9 9 8 9"/></svg>
            </div>
            <div>
              <h4 class="font-bold text-neutral-text-primary">Easy Pre-check-in</h4>
              <p class="text-sm text-neutral-text-secondary">Send documents and complete arrival forms via chat.</p>
            </div>
          </div>
        </div>
        <div class="mt-10">
          <a href="#" class="btn btn-secondary border-green-200 text-green-700 hover:bg-green-50 px-8">
            <svg class="w-5 h-5 me-2" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/></svg>
            Chat with us
          </a>
        </div>
      </div>
      <div class="relative">
        <div class="aspect-square bg-neutral-bg rounded-full p-8 md:p-12 border-8 border-white shadow-2xl overflow-hidden">
          <img src="https://images.unsplash.com/photo-1549443105-2070367f4077?auto=format&fit=crop&q=80&w=800" class="object-cover w-full h-full rounded-full" alt="WhatsApp Support">
        </div>
        <div class="absolute -bottom-6 -left-6 card p-4 shadow-xl max-w-[200px] animate-bounce">
          <p class="text-xs font-bold text-neutral-text-primary italic">"Found a great room in 5 mins via WhatsApp!"</p>
          <p class="text-[10px] text-neutral-text-secondary mt-1">- Ahmad, KL</p>
        </div>
      </div>
    </div>
  </div>
</div>
