<div class="relative overflow-hidden bg-gray-50">
  <!-- Hero -->
  <div class="max-w-[85rem] mx-auto px-4 sm:px-6 lg:px-8 py-20">
    <div class="max-w-2xl text-center mx-auto mb-10 lg:mb-14">
      <h1 class="block text-3xl font-bold text-gray-800 sm:text-4xl md:text-5xl lg:text-6xl">
        Find your next <span class="text-blue-600">WAStays</span>
      </h1>
      <p class="mt-3 text-lg text-gray-800">
        Book small and budget hotels across the region with ease.
      </p>
    </div>

    <!-- Search Form -->
    <div class="max-w-5xl mx-auto">
      <div class="p-4 sm:p-7 bg-white border border-gray-200 rounded-xl shadow-sm">
        <%= form_with url: hotels_path, method: :get, local: true, class: "grid sm:grid-cols-2 lg:grid-cols-4 gap-4" do |f| %>
          <!-- Destination -->
          <div>
            <label for="city" class="block text-sm font-medium mb-2 text-gray-700">Destination</label>
            <%= f.text_field :city, id: "city", placeholder: "Where are you going?", class: "py-3 px-4 block w-full border-gray-200 rounded-lg text-sm focus:border-blue-500 focus:ring-blue-500 disabled:opacity-50 disabled:pointer-events-none border" %>
          </div>

          <!-- Dates -->
          <div class="grid grid-cols-2 gap-2">
            <div>
              <label for="check_in" class="block text-sm font-medium mb-2 text-gray-700">Check-in</label>
              <%= f.date_field :check_in, id: "check_in", value: Date.today, class: "py-3 px-4 block w-full border-gray-200 rounded-lg text-sm focus:border-blue-500 focus:ring-blue-500 disabled:opacity-50 disabled:pointer-events-none border" %>
            </div>
            <div>
              <label for="check_out" class="block text-sm font-medium mb-2 text-gray-700">Check-out</label>
              <%= f.date_field :check_out, id: "check_out", value: Date.tomorrow, class: "py-3 px-4 block w-full border-gray-200 rounded-lg text-sm focus:border-blue-500 focus:ring-blue-500 disabled:opacity-50 disabled:pointer-events-none border" %>
            </div>
          </div>

          <!-- Guests -->
          <div class="grid grid-cols-2 gap-2">
            <div>
              <label for="adults" class="block text-sm font-medium mb-2 text-gray-700">Adults</label>
              <%= f.number_field :adults, id: "adults", value: 2, min: 1, class: "py-3 px-4 block w-full border-gray-200 rounded-lg text-sm focus:border-blue-500 focus:ring-blue-500 disabled:opacity-50 disabled:pointer-events-none border" %>
            </div>
            <div>
              <label for="children" class="block text-sm font-medium mb-2 text-gray-700">Children</label>
              <%= f.number_field :children, id: "children", value: 0, min: 0, class: "py-3 px-4 block w-full border-gray-200 rounded-lg text-sm focus:border-blue-500 focus:ring-blue-500 disabled:opacity-50 disabled:pointer-events-none border" %>
            </div>
          </div>

          <!-- Submit -->
          <div class="flex items-end">
            <%= f.submit "Search Hotels", class: "w-full py-3 px-4 inline-flex justify-center items-center gap-x-2 text-sm font-semibold rounded-lg border border-transparent bg-blue-600 text-white hover:bg-blue-700 disabled:opacity-50 disabled:pointer-events-none" %>
          </div>
        <% end %>
      </div>
    </div>
    <!-- End Search Form -->
  </div>
  <!-- End Hero -->

  <div class="max-w-4xl mx-auto py-10 px-4 sm:px-6 lg:px-8">
    <div class="mt-16 grid grid-cols-1 gap-y-12 gap-x-6 sm:grid-cols-2 lg:grid-cols-4">
      <!-- Booking Engine -->
      <div class="bg-white p-6 rounded-lg shadow-sm border border-gray-100 transition hover:shadow-md">
        <div class="flex items-center justify-center h-12 w-12 rounded-md bg-blue-100 text-blue-600 mb-4">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 11-4 0 2 2 0 014 0z" />
          </svg>
        </div>
        <h3 class="text-lg font-medium text-gray-900">Booking Engine</h3>
        <p class="mt-2 text-sm text-gray-500">Public guest-facing commerce flow. Search, listing, checkout.</p>
      </div>

      <!-- Hotel Operations -->
      <div class="bg-white p-6 rounded-lg shadow-sm border border-gray-100 transition hover:shadow-md">
        <div class="flex items-center justify-center h-12 w-12 rounded-md bg-green-100 text-green-600 mb-4">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" />
          </svg>
        </div>
        <h3 class="text-lg font-medium text-gray-900">Hotel Operations</h3>
        <p class="mt-2 text-sm text-gray-500">Hotel-side management. Rates, inventory, and profile.</p>
      </div>

      <!-- Guest Arrival -->
      <div class="bg-white p-6 rounded-lg shadow-sm border border-gray-100 transition hover:shadow-md">
        <div class="flex items-center justify-center h-12 w-12 rounded-md bg-purple-100 text-purple-600 mb-4">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5.121 17.804A13.937 13.937 0 0112 16c2.5 0 4.847.655 6.879 1.804M15 10a3 3 0 11-6 0 3 3 0 016 0zm6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
        </div>
        <h3 class="text-lg font-medium text-gray-900">Guest Arrival</h3>
        <p class="mt-2 text-sm text-gray-500">Post-booking readiness. Pre-check-in and WhatsApp workflow.</p>
      </div>

      <!-- Platform Control -->
      <div class="bg-white p-6 rounded-lg shadow-sm border border-gray-100 transition hover:shadow-md">
        <div class="flex items-center justify-center h-12 w-12 rounded-md bg-red-100 text-red-600 mb-4">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6V4m0 2a2 2 0 100 4m0-4a2 2 0 110 4m-6 8a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4m6 6v10m6-2a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4" />
          </svg>
        </div>
        <h3 class="text-lg font-medium text-gray-900">Platform Control</h3>
        <p class="mt-2 text-sm text-gray-500">WAStays internal control plane. Approvals and margin rules.</p>
      </div>
    </div>

    <div class="mt-16 bg-blue-600 rounded-lg shadow-xl overflow-hidden sm:mt-24">
      <div class="px-6 py-12 text-center sm:px-12 sm:py-16">
        <h2 class="text-3xl font-extrabold text-white sm:text-4xl">
          <span class="block">Ready to onboard?</span>
        </h2>
        <p class="mt-4 text-lg leading-6 text-blue-100">
          Free hotel signup. No upfront subscription. Monetize based on activity.
        </p>
        <div class="mt-8 flex justify-center">
          <div class="inline-flex rounded-md shadow">
            <%= link_to "Hotel Signup", register_path, class: "inline-flex items-center justify-center px-5 py-3 border border-transparent text-base font-medium rounded-md text-blue-600 bg-white hover:bg-blue-50" %>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
