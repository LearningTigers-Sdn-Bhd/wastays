              </div>
            </li>
          </ul>
        </div>

        <!-- Right Side: Solution -->
        <div class="bg-[#1e2e2a] rounded-[2rem] p-8 lg:p-16 border border-white/5 shadow-xl shadow-brand-primary/5">
          <div class="mb-12">
            <h2 class="text-3xl lg:text-4xl font-serif text-white mb-6 leading-tight">WAStays <span class="italic text-[#d9c5a0]">Fixes This</span></h2>
            <p class="text-gray-400 leading-relaxed">
