<div class="w-full space-y-4">
  <%= render PanelsUI::PageHeader.new(
        title: "Payment History",
        description: "Gateway attempts and payments received from your corporate account.") do |header| %>
    <% header.with_actions do %>
      <%= render PanelsUI::Button.new(as: :a, href: pay_invoices_corporate_ar_payments_path) do %>
        <%= cached_icon "circle-dollar-sign", class: "size-4", aria: { hidden: true } %>
        Pay Invoices
      <% end %>
    <% end %>
  <% end %>

  <%= render "metrics", presenter: @presenter %>
  <%= render "filters", presenter: @presenter %>
  <%= render "table", presenter: @presenter %>
</div>
