<div class="w-full space-y-4">
  <div class="flex flex-col gap-3  sm:flex-row sm:items-end sm:justify-between">
    <div>
      <h1 class="text-3xl font-bold tracking-tight text-foreground">Payment History</h1>
      <p class="mt-1 text-sm text-muted-foreground">Gateway attempts and payments received from your corporate account.</p>
    </div>
    <%= link_to pay_invoices_corporate_ar_payments_path,
                class: "inline-flex items-center justify-center gap-2 rounded-xl bg-primary px-4 py-2.5 text-sm font-bold text-primary-foreground shadow-sm transition hover:bg-primary-hover focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2" do %>
      <%= cached_icon "circle-dollar-sign", class: "size-4", aria: { hidden: true } %>
      Pay Invoices
    <% end %>
  </div>

  <%= render "metrics", presenter: @presenter %>
  <%= render "filters", presenter: @presenter %>
  <%= render "table", presenter: @presenter %>
</div>
