<%= turbo_frame_tag "corporate_ar_payments_results" do %>
  <%# Desktop table %>
  <div class="hidden overflow-x-auto rounded-xl border border-slate-200 bg-white shadow-sm lg:block">
    <table class="min-w-[1100px] w-full text-left text-sm divide-y divide-slate-200">
      <thead class="bg-slate-50/50">
        <tr>
          <th scope="col" class="w-48 whitespace-nowrap px-6 py-3 text-left text-[10px] font-bold uppercase tracking-widest text-slate-500">Reference</th>
          <th scope="col" class="w-56 whitespace-nowrap px-6 py-3 text-left text-[10px] font-bold uppercase tracking-widest text-slate-500">Hotel</th>
          <th scope="col" class="w-36 whitespace-nowrap px-6 py-3 text-left text-[10px] font-bold uppercase tracking-widest text-slate-500">Received</th>
          <th scope="col" class="w-32 whitespace-nowrap px-6 py-3 text-left text-[10px] font-bold uppercase tracking-widest text-slate-500">Method</th>
          <th scope="col" class="w-36 whitespace-nowrap px-6 py-3 text-right text-[10px] font-bold uppercase tracking-widest text-slate-500">Amount</th>
          <th scope="col" class="w-36 whitespace-nowrap px-6 py-3 text-right text-[10px] font-bold uppercase tracking-widest text-slate-500">Allocated</th>
          <th scope="col" class="w-36 whitespace-nowrap px-6 py-3 text-right text-[10px] font-bold uppercase tracking-widest text-slate-500">Unapplied</th>
          <th scope="col" class="w-40 whitespace-nowrap px-6 py-3 text-left text-[10px] font-bold uppercase tracking-widest text-slate-500">Status</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-slate-100 bg-white">
        <% if presenter.rows.any? %>
          <% presenter.rows.each do |row| %>
            <tr
              class="group cursor-pointer transition-colors hover:bg-slate-50/80 focus-visible:bg-slate-50 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-inset focus-visible:ring-slate-900/20"
              role="link"
              tabindex="0"
              data-controller="clickable-row"
              data-clickable-row-url-value="<%= row.path %>"
              data-action="click->clickable-row#visit keydown->clickable-row#visitFromKeyboard">
              <td class="whitespace-nowrap px-6 py-3.5">
                <span class="text-sm font-bold text-slate-900 decoration-slate-400 underline-offset-4 group-hover:underline group-focus-visible:underline"><%= row.reference %></span>
              </td>
              <td class="whitespace-nowrap px-6 py-3.5 text-sm font-bold text-slate-900"><%= row.hotel_name %></td>
              <td class="whitespace-nowrap px-6 py-3.5 text-sm font-semibold text-slate-600"><%= row.received_on %></td>
              <td class="whitespace-nowrap px-6 py-3.5 text-sm text-slate-600"><%= row.method %></td>
              <td class="whitespace-nowrap px-6 py-3.5 text-right text-sm font-semibold tabular-nums text-slate-900"><%= row.amount_label %></td>
              <td class="whitespace-nowrap px-6 py-3.5 text-right text-sm tabular-nums text-slate-600"><%= row.allocated_label %></td>
              <td class="whitespace-nowrap px-6 py-3.5 text-right text-sm font-bold tabular-nums text-slate-950"><%= row.unapplied_label %></td>
              <td class="whitespace-nowrap px-6 py-3.5">
                <span class="inline-flex items-center rounded-md border px-1.5 py-0.5 text-[10px] font-black uppercase tracking-wider bg-slate-100 border-slate-200 text-slate-700"><%= row.status_label %></span>
              </td>
            </tr>
          <% end %>
        <% else %>
          <tr>
            <td colspan="8" class="px-6 py-12 text-center text-sm text-slate-500">
              No payments matching the selected filters were found.
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>

  <% # Mobile cards %>
  <div class="space-y-3 px-4 md:px-0 lg:hidden">
    <% if presenter.rows.any? %>
      <% presenter.rows.each do |row| %>
        <article
          class="group cursor-pointer rounded-xl border border-slate-200 bg-white p-4 shadow-sm transition hover:border-slate-300 hover:bg-slate-50/60 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-slate-900/20"
          role="link"
          tabindex="0"
          data-controller="clickable-row"
          data-clickable-row-url-value="<%= row.path %>"
          data-action="click->clickable-row#visit keydown->clickable-row#visitFromKeyboard">
          <div class="flex items-start justify-between gap-3">
            <div>
              <p class="text-[10px] font-bold uppercase tracking-widest text-slate-400">Reference</p>
              <p class="mt-1 text-sm font-black text-slate-900 decoration-slate-400 underline-offset-4 group-hover:underline group-focus-visible:underline"><%= row.reference %></p>
            </div>
            <span class="inline-flex items-center rounded-md border px-1.5 py-0.5 text-[10px] font-black uppercase tracking-wider bg-slate-100 border-slate-200 text-slate-700"><%= row.status_label %></span>
          </div>

          <div class="mt-4 grid grid-cols-2 gap-4">
            <div class="min-w-0">
              <p class="text-[10px] font-bold uppercase tracking-widest text-slate-400">Hotel</p>
              <p class="mt-1 truncate text-sm font-bold text-slate-900"><%= row.hotel_name %></p>
              <p class="mt-1 truncate text-[11px] font-medium text-slate-500">Method: <%= row.method %></p>
            </div>
            <div class="text-right">
              <p class="text-[10px] font-bold uppercase tracking-widest text-slate-400">Unapplied</p>
              <p class="mt-1 text-sm font-black tabular-nums text-slate-950"><%= row.unapplied_label %></p>
            </div>
          </div>

          <div class="mt-4 grid grid-cols-2 gap-4 border-t border-slate-100 pt-4">
            <div>
              <p class="text-[10px] font-bold uppercase tracking-widest text-slate-400">Received Date</p>
              <p class="mt-1 text-xs font-semibold text-slate-700"><%= row.received_on %></p>
            </div>
            <div class="text-right">
              <p class="text-[10px] font-bold uppercase tracking-widest text-slate-400">Total Amount</p>
              <p class="mt-1 text-xs font-bold text-slate-900"><%= row.amount_label %></p>
            </div>
          </div>
        </article>
      <% end %>
    <% else %>
      <div class="rounded-xl border border-dashed border-slate-200 bg-white p-6 shadow-sm text-center text-sm text-slate-500">
        No payments matching the selected filters were found.
      </div>
    <% end %>
  </div>

  <% if presenter.pagination.total_pages > 1 %>
    <div class="mt-6 flex justify-center">
      <%= paginate presenter.pagination, params: presenter.pagination_params %>
    </div>
  <% end %>
<% end %>
