<%= turbo_frame_tag "corporate_ar_payments_results" do %>
  <%# Desktop table %>
  <div class="hidden overflow-x-auto rounded-xl border border-border bg-card shadow-sm lg:block">
    <table class="min-w-[1100px] w-full text-left text-sm divide-y divide-border">
      <thead class="bg-muted/50">
        <tr>
          <th scope="col" class="w-48 whitespace-nowrap px-6 py-3 text-left text-[10px] font-bold uppercase tracking-widest text-muted-foreground">Reference</th>
          <th scope="col" class="w-56 whitespace-nowrap px-6 py-3 text-left text-[10px] font-bold uppercase tracking-widest text-muted-foreground">Hotel</th>
          <th scope="col" class="w-36 whitespace-nowrap px-6 py-3 text-left text-[10px] font-bold uppercase tracking-widest text-muted-foreground">Received</th>
          <th scope="col" class="w-32 whitespace-nowrap px-6 py-3 text-left text-[10px] font-bold uppercase tracking-widest text-muted-foreground">Method</th>
          <th scope="col" class="w-36 whitespace-nowrap px-6 py-3 text-right text-[10px] font-bold uppercase tracking-widest text-muted-foreground">Amount</th>
          <th scope="col" class="w-36 whitespace-nowrap px-6 py-3 text-right text-[10px] font-bold uppercase tracking-widest text-muted-foreground">Allocated</th>
          <th scope="col" class="w-36 whitespace-nowrap px-6 py-3 text-right text-[10px] font-bold uppercase tracking-widest text-muted-foreground">Unapplied</th>
          <th scope="col" class="w-40 whitespace-nowrap px-6 py-3 text-left text-[10px] font-bold uppercase tracking-widest text-muted-foreground">Status</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-border bg-card">
        <% if presenter.rows.any? %>
          <% presenter.rows.each do |row| %>
            <tr
              class="group cursor-pointer transition-colors hover:bg-muted/80 focus-visible:bg-muted focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-inset focus-visible:ring-ring/20"
              role="link"
              tabindex="0"
              data-controller="clickable-row"
              data-clickable-row-url-value="<%= row.path %>"
              data-action="click->clickable-row#visit keydown->clickable-row#visitFromKeyboard">
              <td class="whitespace-nowrap px-6 py-3.5">
                <span class="text-sm font-bold text-foreground decoration-muted-foreground underline-offset-4 group-hover:underline group-focus-visible:underline"><%= row.reference %></span>
              </td>
              <td class="whitespace-nowrap px-6 py-3.5 text-sm font-bold text-foreground"><%= row.hotel_name %></td>
              <td class="whitespace-nowrap px-6 py-3.5 text-sm font-semibold text-muted-foreground"><%= row.received_on %></td>
              <td class="whitespace-nowrap px-6 py-3.5 text-sm text-muted-foreground"><%= row.method %></td>
              <td class="whitespace-nowrap px-6 py-3.5 text-right text-sm font-semibold tabular-nums text-foreground"><%= row.amount_label %></td>
              <td class="whitespace-nowrap px-6 py-3.5 text-right text-sm tabular-nums text-muted-foreground"><%= row.allocated_label %></td>
              <td class="whitespace-nowrap px-6 py-3.5 text-right text-sm font-bold tabular-nums text-foreground"><%= row.unapplied_label %></td>
              <td class="whitespace-nowrap px-6 py-3.5">
                <span class="inline-flex items-center rounded-md border px-1.5 py-0.5 text-[10px] font-black uppercase tracking-wider bg-muted border-border text-foreground"><%= row.status_label %></span>
              </td>
            </tr>
          <% end %>
        <% else %>
          <tr>
            <td colspan="8" class="px-6 py-12 text-center text-sm text-muted-foreground">
              No payments matching the selected filters were found.
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>

  <% # Mobile cards %>
  <div class="space-y-3  lg:hidden">
    <% if presenter.rows.any? %>
      <% presenter.rows.each do |row| %>
        <article
          class="group cursor-pointer rounded-xl border border-border bg-card p-4 shadow-sm transition hover:border-border-interactive hover:bg-muted/60 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring/20"
          role="link"
          tabindex="0"
          data-controller="clickable-row"
          data-clickable-row-url-value="<%= row.path %>"
          data-action="click->clickable-row#visit keydown->clickable-row#visitFromKeyboard">
          <div class="flex items-start justify-between gap-3">
            <div>
              <p class="text-[10px] font-bold uppercase tracking-widest text-muted-foreground">Reference</p>
              <p class="mt-1 text-sm font-black text-foreground decoration-muted-foreground underline-offset-4 group-hover:underline group-focus-visible:underline"><%= row.reference %></p>
            </div>
            <span class="inline-flex items-center rounded-md border px-1.5 py-0.5 text-[10px] font-black uppercase tracking-wider bg-muted border-border text-foreground"><%= row.status_label %></span>
          </div>

          <div class="mt-4 grid grid-cols-2 gap-4">
            <div class="min-w-0">
              <p class="text-[10px] font-bold uppercase tracking-widest text-muted-foreground">Hotel</p>
              <p class="mt-1 truncate text-sm font-bold text-foreground"><%= row.hotel_name %></p>
              <p class="mt-1 truncate text-[11px] font-medium text-muted-foreground">Method: <%= row.method %></p>
            </div>
            <div class="text-right">
              <p class="text-[10px] font-bold uppercase tracking-widest text-muted-foreground">Unapplied</p>
              <p class="mt-1 text-sm font-black tabular-nums text-foreground"><%= row.unapplied_label %></p>
            </div>
          </div>

          <div class="mt-4 grid grid-cols-2 gap-4 border-t border-border pt-4">
            <div>
              <p class="text-[10px] font-bold uppercase tracking-widest text-muted-foreground">Received Date</p>
              <p class="mt-1 text-xs font-semibold text-foreground"><%= row.received_on %></p>
            </div>
            <div class="text-right">
              <p class="text-[10px] font-bold uppercase tracking-widest text-muted-foreground">Total Amount</p>
              <p class="mt-1 text-xs font-bold text-foreground"><%= row.amount_label %></p>
            </div>
          </div>
        </article>
      <% end %>
    <% else %>
      <div class="rounded-xl border border-dashed border-border bg-card p-6 shadow-sm text-center text-sm text-muted-foreground">
        No payments matching the selected filters were found.
      </div>
    <% end %>
  </div>

  <% if presenter.pagination.total_pages > 1 %>
    <div class="mt-6 flex justify-center">
      <%= paginate presenter.pagination, params: presenter.pagination_params %>
    </div>
  <% end %>
<% end %>
