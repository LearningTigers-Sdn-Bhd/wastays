<section class="overflow-hidden rounded-xl border border-border bg-card shadow-sm" data-testid="payment-allocations-card">
  <header class="flex items-center justify-between border-b border-border bg-muted/60 px-4 py-2.5">
    <h2 class="inline-flex items-center gap-2 text-xs font-bold uppercase tracking-wider text-foreground">
      <span class="inline-flex size-6 items-center justify-center rounded bg-emerald-50 text-emerald-700">
        <%= cached_icon "credit-card", class: "size-3.5", aria: { hidden: true } %>
      </span>
      Payment Allocations
    </h2>
  </header>

  <% if presenter.allocation_rows.any? %>
    <div class="overflow-x-auto">
      <table class="min-w-[720px] w-full text-left text-sm">
        <thead class="border-b border-border bg-muted text-[10px] font-bold uppercase tracking-wider text-muted-foreground">
          <tr>
            <th scope="col" class="whitespace-nowrap px-4 py-3">Received</th>
            <th scope="col" class="whitespace-nowrap px-4 py-3">Reference</th>
            <th scope="col" class="whitespace-nowrap px-4 py-3">Method</th>
            <th scope="col" class="whitespace-nowrap px-4 py-3 text-right">Allocated</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-border">
          <% presenter.allocation_rows.each do |allocation| %>
            <tr class="transition hover:bg-muted/70">
              <td class="whitespace-nowrap px-4 py-3 text-muted-foreground"><%= allocation.received_on %></td>
              <th scope="row" class="whitespace-nowrap px-4 py-3 font-semibold text-foreground"><%= allocation.reference %></th>
              <td class="whitespace-nowrap px-4 py-3 text-muted-foreground"><%= allocation.payment_method %></td>
              <td class="whitespace-nowrap px-4 py-3 text-right font-bold tabular-nums text-foreground"><%= allocation.allocated_amount %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <div class="px-6 py-12 text-center">
      <span class="mx-auto inline-flex size-10 items-center justify-center rounded-full bg-muted text-muted-foreground">
        <%= cached_icon "credit-card", class: "size-5", aria: { hidden: true } %>
      </span>
      <p class="mt-3 text-sm font-semibold text-foreground">No payment allocations yet</p>
      <p class="mt-1 text-xs text-muted-foreground">Received payments allocated to this invoice by hotel finance will appear here.</p>
    </div>
  <% end %>
</section>
