<div>
  <%= render PanelsUI::PageHeader.new(
        title: presenter.invoice_label) do |header| %>
    <% header.with_caption do %>
      <div class="flex flex-wrap items-center gap-2">
        <span><%= presenter.hotel_name %> · Booking <span class="font-mono"><%= presenter.booking_reference %></span></span>
        <span class="inline-flex items-center rounded-md border px-3 py-1.5 text-xs font-bold uppercase tracking-wider <%= presenter.status_class %>">
          <%= presenter.status_label %>
        </span>
      </div>
    <% end %>
    <% if presenter.has_outstanding_balance? %>
      <% header.with_actions do %>
        <%= render PanelsUI::Button.new(
              as: :a,
              variant: :secondary,
              href: new_corporate_ar_payment_submission_path(ar_invoice_id: ar_invoice.id)) do %>
          <%= cached_icon "upload", class: "size-4", aria: { hidden: true } %>
          Submit Bank Transfer
        <% end %>
        <%= render PanelsUI::Button.new(
              as: :a,
              href: pay_invoices_corporate_ar_payments_path(hotel_corporate_account_id: ar_invoice.hotel_corporate_account_id)) do %>
          <%= cached_icon "circle-dollar-sign", class: "size-4", aria: { hidden: true } %>
          Pay Invoice
        <% end %>
      <% end %>
    <% end %>
  <% end %>
</div>
