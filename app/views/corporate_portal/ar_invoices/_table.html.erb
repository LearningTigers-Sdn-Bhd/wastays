<%= turbo_frame_tag "corporate_ar_invoices_results" do %>
  <%# Desktop table %>
  <div class="hidden overflow-x-auto rounded-xl border border-border bg-card shadow-sm lg:block">
    <table class="min-w-[1200px] divide-y divide-border">
      <thead class="bg-muted/50">
        <tr>
          <th scope="col" class="w-40 whitespace-nowrap px-6 py-3 text-left text-[10px] font-bold uppercase tracking-widest text-muted-foreground">Invoice</th>
          <th scope="col" class="w-36 whitespace-nowrap px-6 py-3 text-left text-[10px] font-bold uppercase tracking-widest text-muted-foreground">Status</th>
          <th scope="col" class="w-64 whitespace-nowrap px-6 py-3 text-left text-[10px] font-bold uppercase tracking-widest text-muted-foreground">Hotel</th>
          <th scope="col" class="w-44 whitespace-nowrap px-6 py-3 text-left text-[10px] font-bold uppercase tracking-widest text-muted-foreground">Booking</th>
          <th scope="col" class="w-40 whitespace-nowrap px-6 py-3 text-left text-[10px] font-bold uppercase tracking-widest text-muted-foreground">Issued</th>
          <th scope="col" class="w-40 whitespace-nowrap px-6 py-3 text-left text-[10px] font-bold uppercase tracking-widest text-muted-foreground">Due</th>
          <th scope="col" class="w-48 whitespace-nowrap px-6 py-3 text-right text-[10px] font-bold uppercase tracking-widest text-muted-foreground">Outstanding</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-border bg-card">
        <% if presenter.paginated_rows.any? %>
          <% presenter.paginated_rows.each do |row| %>
            <tr
              class="group cursor-pointer transition-colors hover:bg-muted/80 focus-visible:bg-muted focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-inset focus-visible:ring-ring/20"
              role="link"
              tabindex="0"
              data-controller="clickable-row"
              data-testid="corp-ar-invoice-row-<%= row.invoice.id %>"
              data-clickable-row-url-value="<%= corporate_ar_invoice_path(row.invoice) %>"
              data-action="click->clickable-row#visit keydown->clickable-row#visitFromKeyboard">
              <td class="whitespace-nowrap px-6 py-3">
                <span class="text-sm font-bold text-foreground decoration-muted-foreground underline-offset-4 group-hover:underline group-focus-visible:underline"><%= row.invoice_label %></span>
              </td>
              <td class="whitespace-nowrap px-6 py-3">
                <span class="inline-flex items-center rounded-md border px-1.5 py-0.5 text-[10px] font-black uppercase tracking-wider <%= row.status_class %>"><%= row.status_label %></span>
              </td>
              <td class="whitespace-nowrap px-6 py-3 text-sm font-bold text-foreground"><%= row.hotel_name %></td>
              <td class="whitespace-nowrap px-6 py-3 text-sm font-medium text-foreground"><%= row.booking_reference %></td>
              <td class="whitespace-nowrap px-6 py-3 text-sm font-semibold text-foreground"><%= row.issued_on_label %></td>
              <td class="whitespace-nowrap px-6 py-3 text-sm font-bold text-foreground"><%= row.due_on_label %></td>
              <td class="whitespace-nowrap px-6 py-3 text-right text-sm font-black tabular-nums text-foreground"><%= row.outstanding_amount_label %></td>
            </tr>
          <% end %>
        <% else %>
          <tr>
            <td colspan="7" class="px-6 py-4">
              <%= render "empty_state", presenter: presenter %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>

  <%# Mobile cards %>
  <div class="space-y-3  lg:hidden">
    <% if presenter.paginated_rows.any? %>
      <% presenter.paginated_rows.each do |row| %>
        <article
          class="group cursor-pointer rounded-xl border border-border bg-card p-4 shadow-sm transition hover:border-border-interactive hover:bg-muted/60 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring/20"
          role="link"
          tabindex="0"
          data-controller="clickable-row"
          data-testid="corp-ar-invoice-card-<%= row.invoice.id %>"
          data-clickable-row-url-value="<%= corporate_ar_invoice_path(row.invoice) %>"
          data-action="click->clickable-row#visit keydown->clickable-row#visitFromKeyboard">
          <div class="flex items-start justify-between gap-3">
            <div>
              <p class="text-[10px] font-bold uppercase tracking-widest text-muted-foreground">Invoice</p>
              <p class="mt-1 text-sm font-black text-foreground decoration-muted-foreground underline-offset-4 group-hover:underline group-focus-visible:underline"><%= row.invoice_label %></p>
            </div>
            <span class="inline-flex items-center rounded-md border px-1.5 py-0.5 text-[10px] font-black uppercase tracking-wider <%= row.status_class %>"><%= row.status_label %></span>
          </div>

          <div class="mt-4 grid grid-cols-2 gap-4">
            <div class="min-w-0">
              <p class="text-[10px] font-bold uppercase tracking-widest text-muted-foreground">Hotel</p>
              <p class="mt-1 truncate text-sm font-bold text-foreground"><%= row.hotel_name %></p>
              <p class="mt-1 truncate text-[11px] font-medium text-muted-foreground">Booking <%= row.booking_reference %></p>
            </div>
            <div class="text-right">
              <p class="text-[10px] font-bold uppercase tracking-widest text-muted-foreground">Outstanding</p>
              <p class="mt-1 text-sm font-black tabular-nums text-foreground"><%= row.outstanding_amount_label %></p>
            </div>
          </div>

          <div class="mt-4 grid grid-cols-2 gap-4 border-t border-border pt-4">
            <div>
              <p class="text-[10px] font-bold uppercase tracking-widest text-muted-foreground">Issued</p>
              <p class="mt-1 text-xs font-semibold text-foreground"><%= row.issued_on_label %></p>
            </div>
            <div class="text-right">
              <p class="text-[10px] font-bold uppercase tracking-widest text-muted-foreground">Due</p>
              <p class="mt-1 text-xs font-bold text-foreground"><%= row.due_on_label %></p>
            </div>
          </div>
        </article>
      <% end %>
    <% else %>
      <div class="rounded-xl border border-dashed border-border bg-card p-6 shadow-sm">
        <%= render "empty_state", presenter: presenter %>
      </div>
    <% end %>
  </div>

  <% if presenter.pagination.total_pages > 1 %>
    <div class="mt-6 flex justify-center">
      <%= paginate presenter.pagination, params: presenter.pagination_params %>
    </div>
  <% end %>
<% end %>
