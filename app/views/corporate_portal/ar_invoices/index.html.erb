<div class="mx-auto max-w-7xl space-y-6 pb-20">
  <div>
    <h1 class="text-3xl font-bold tracking-tight text-slate-950">AR Invoices</h1>
    <p class="mt-1 text-sm text-slate-600">Direct Bill invoices issued to your corporate account.</p>
  </div>

  <section class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
    <p class="text-xs font-bold uppercase tracking-[0.2em] text-slate-400">Outstanding balance</p>
    <% if @outstanding_by_currency.any? %>
      <div class="mt-3 flex flex-wrap gap-3">
        <% @outstanding_by_currency.each do |currency, amount| %>
          <span class="rounded-xl bg-slate-950 px-4 py-2 text-lg font-black tabular-nums text-white"><%= currency %> <%= number_with_precision(amount, precision: 2) %></span>
        <% end %>
      </div>
    <% else %>
      <p class="mt-3 text-xl font-black text-slate-950">No outstanding AR balance</p>
    <% end %>
  </section>

  <section class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">
    <div class="border-b border-slate-200 px-6 py-5">
      <h2 class="text-lg font-bold text-slate-950">Invoice Ledger</h2>
    </div>
    <% if @ar_invoices.any? %>
      <div class="overflow-x-auto">
        <table class="w-full min-w-[1050px] text-left text-sm">
          <thead class="border-b border-slate-200 bg-slate-50 text-xs uppercase tracking-wider text-slate-500">
            <tr>
              <th class="px-6 py-3">Invoice</th>
              <th class="px-6 py-3">Hotel</th>
              <th class="px-6 py-3">Booking</th>
              <th class="px-6 py-3">Issued</th>
              <th class="px-6 py-3">Due</th>
              <th class="px-6 py-3 text-right">Amount</th>
              <th class="px-6 py-3 text-right">Paid</th>
              <th class="px-6 py-3 text-right">Outstanding</th>
              <th class="px-6 py-3">Status</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-100">
            <% @ar_invoices.each do |invoice| %>
              <tr>
                <td class="px-6 py-4 font-bold text-slate-950"><%= link_to "AR-#{invoice.invoice_number}", corporate_ar_invoice_path(invoice), class: "underline decoration-slate-300 underline-offset-2 hover:text-slate-600" %></td>
                <td class="px-6 py-4 text-slate-700"><%= invoice.hotel.name %></td>
                <td class="px-6 py-4 font-semibold text-slate-900"><%= invoice.booking.confirmation_token %></td>
                <td class="px-6 py-4 text-slate-600"><%= invoice.issued_on.strftime("%d %b %Y") %></td>
                <td class="px-6 py-4 text-slate-600"><%= invoice.due_on.strftime("%d %b %Y") %></td>
                <td class="px-6 py-4 text-right font-semibold tabular-nums text-slate-900"><%= invoice.currency %> <%= number_with_precision(invoice.amount, precision: 2) %></td>
                <td class="px-6 py-4 text-right tabular-nums text-slate-600"><%= invoice.currency %> <%= number_with_precision(invoice.paid_amount, precision: 2) %></td>
                <td class="px-6 py-4 text-right font-bold tabular-nums text-slate-950"><%= invoice.currency %> <%= number_with_precision(invoice.outstanding_amount, precision: 2) %></td>
                <td class="px-6 py-4"><span class="rounded-md bg-slate-100 px-2 py-1 text-xs font-bold uppercase tracking-wide text-slate-700"><%= invoice.status.humanize %></span></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% else %>
      <p class="px-6 py-10 text-center text-sm text-slate-500">No AR invoices have been issued yet.</p>
    <% end %>
  </section>
</div>
