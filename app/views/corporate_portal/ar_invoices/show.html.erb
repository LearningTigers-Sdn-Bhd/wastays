<div class="mx-auto max-w-5xl space-y-6 pb-20">
  <div class="flex flex-col gap-2 sm:flex-row sm:items-end sm:justify-between">
    <div>
      <p class="text-xs font-bold uppercase tracking-[0.2em] text-slate-400">AR Invoice</p>
      <h1 class="mt-1 text-3xl font-bold tracking-tight text-slate-950">AR-<%= @ar_invoice.invoice_number %></h1>
      <p class="mt-1 text-sm text-slate-600"><%= @ar_invoice.hotel.name %> · Booking <%= @ar_invoice.booking.confirmation_token %></p>
    </div>
    <span class="rounded-md bg-slate-100 px-3 py-2 text-xs font-bold uppercase tracking-wide text-slate-700"><%= @ar_invoice.status.humanize %></span>
  </div>

  <section class="grid gap-4 sm:grid-cols-3">
    <div class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
      <p class="text-xs font-bold uppercase tracking-wider text-slate-500">Amount</p>
      <p class="mt-2 text-xl font-black text-slate-950"><%= @ar_invoice.currency %> <%= number_with_precision(@ar_invoice.amount, precision: 2) %></p>
    </div>
    <div class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
      <p class="text-xs font-bold uppercase tracking-wider text-slate-500">Paid</p>
      <p class="mt-2 text-xl font-black text-slate-950"><%= @ar_invoice.currency %> <%= number_with_precision(@ar_invoice.paid_amount, precision: 2) %></p>
    </div>
    <div class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
      <p class="text-xs font-bold uppercase tracking-wider text-slate-500">Outstanding</p>
      <p class="mt-2 text-xl font-black text-slate-950"><%= @ar_invoice.currency %> <%= number_with_precision(@ar_invoice.outstanding_amount, precision: 2) %></p>
    </div>
  </section>

  <section class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
    <h2 class="text-lg font-bold text-slate-950">Invoice Details</h2>
    <dl class="mt-5 grid gap-4 text-sm sm:grid-cols-2">
      <div>
        <dt class="text-slate-500">Issued</dt>
        <dd class="font-bold text-slate-950"><%= @ar_invoice.issued_on.strftime("%d %b %Y") %></dd>
      </div>
      <div>
        <dt class="text-slate-500">Due</dt>
        <dd class="font-bold text-slate-950"><%= @ar_invoice.due_on.strftime("%d %b %Y") %></dd>
      </div>
      <div>
        <dt class="text-slate-500">Hotel</dt>
        <dd class="font-bold text-slate-950"><%= @ar_invoice.hotel.name %></dd>
      </div>
      <div>
        <dt class="text-slate-500">Booking reference</dt>
        <dd class="font-bold text-slate-950"><%= @ar_invoice.booking.confirmation_token %></dd>
      </div>
    </dl>
  </section>

  <section class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">
    <div class="border-b border-slate-200 px-6 py-5">
      <h2 class="text-lg font-bold text-slate-950">Payment Allocations</h2>
    </div>
    <% active_allocations = @ar_invoice.ar_payment_allocations.reject(&:reversed?) %>
    <% if active_allocations.any? %>
      <div class="overflow-x-auto">
        <table class="w-full min-w-[760px] text-left text-sm">
          <thead class="border-b border-slate-200 bg-slate-50 text-xs uppercase tracking-wider text-slate-500">
            <tr>
              <th class="px-6 py-3">Received</th>
              <th class="px-6 py-3">Reference</th>
              <th class="px-6 py-3">Method</th>
              <th class="px-6 py-3 text-right">Allocated</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-100">
            <% active_allocations.each do |allocation| %>
              <tr>
                <td class="px-6 py-4 text-slate-600"><%= allocation.ar_payment.received_at.strftime("%d %b %Y") %></td>
                <td class="px-6 py-4 font-semibold text-slate-950"><%= allocation.ar_payment.reference_number %></td>
                <td class="px-6 py-4 text-slate-600"><%= allocation.ar_payment.payment_method.humanize %></td>
                <td class="px-6 py-4 text-right font-bold tabular-nums text-slate-950"><%= @ar_invoice.currency %> <%= number_with_precision(allocation.amount, precision: 2) %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% else %>
      <p class="px-6 py-10 text-center text-sm text-slate-500">No payments have been allocated to this invoice yet.</p>
    <% end %>
  </section>
</div>
