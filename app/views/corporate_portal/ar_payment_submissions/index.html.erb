<div class="mx-auto max-w-5xl space-y-6 pb-20">
  <div class="flex flex-col gap-4 sm:flex-row sm:items-start sm:justify-between">
    <div>
      <h1 class="text-3xl font-bold tracking-tight text-slate-950">Payment Submissions</h1>
      <p class="mt-1 text-sm text-slate-600">Upload a transaction slip for the hotel to verify and apply to your account.</p>
    </div>
    <%= link_to "Submit a Payment", new_corporate_ar_payment_submission_path,
      class: "inline-flex items-center justify-center gap-2 rounded-xl bg-slate-900 px-5 py-2.5 text-sm font-bold text-white shadow-sm transition hover:bg-slate-700" %>
  </div>

  <section class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">
    <% if @submissions.any? %>
      <div class="overflow-x-auto">
        <table class="w-full text-left text-sm">
          <thead class="border-b border-slate-200 bg-slate-50 text-xs uppercase tracking-wider text-slate-500">
            <tr>
              <th class="px-6 py-3">Hotel</th>
              <th class="px-6 py-3">Reference</th>
              <th class="px-6 py-3">Amount</th>
              <th class="px-6 py-3">Submitted</th>
              <th class="px-6 py-3">Status</th>
              <th class="px-6 py-3"><span class="sr-only">View</span></th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-100">
            <% @submissions.each do |submission| %>
              <tr>
                <td class="px-6 py-4 font-bold text-slate-950"><%= submission.hotel.name %></td>
                <td class="px-6 py-4 text-slate-600"><%= submission.reference_number %></td>
                <td class="px-6 py-4 font-semibold tabular-nums text-slate-900"><%= submission.currency %> <%= number_with_precision(submission.amount, precision: 2) %></td>
                <td class="px-6 py-4 text-slate-600"><%= l(submission.created_at, format: :short) %></td>
                <td class="px-6 py-4">
                  <% case submission.status %>
                  <% when "pending" %>
                    <span class="rounded-full bg-amber-100 px-2.5 py-1 text-xs font-bold text-amber-800">Pending review</span>
                  <% when "approved" %>
                    <span class="rounded-full bg-emerald-100 px-2.5 py-1 text-xs font-bold text-emerald-800">Approved</span>
                  <% when "rejected" %>
                    <span class="rounded-full bg-red-100 px-2.5 py-1 text-xs font-bold text-red-800" title="Rejected &middot; <%= l(submission.reviewed_at, format: :short) %>&#10;<%= submission.rejection_reason %>">Rejected</span>
                  <% end %>
                </td>
                <td class="px-6 py-4 text-right">
                  <%= link_to "View", corporate_ar_payment_submission_path(submission), class: "font-bold text-slate-700 hover:underline" %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% else %>
      <p class="px-6 py-10 text-center text-sm text-slate-500">No payment submissions yet.</p>
    <% end %>
  </section>
</div>
