<div class="mx-auto w-full max-w-4xl space-y-6">
  <header>
    <h1 class="text-2xl font-bold text-foreground">Book a stay</h1>
    <p class="mt-1 text-sm text-muted-foreground">
      Reserve rooms for your guests at a hotel your account is linked to.
    </p>
  </header>

  <% if @relationships.empty? %>
    <%= render PanelsUI::Alert.new(tone: :warning, title: "No linked hotels") do |alert| %>
      <% alert.with_description do %>
        Your account is not linked to any hotel yet.
      <% end %>
    <% end %>
  <% else %>
    <section class="rounded-2xl border border-border bg-card p-6 shadow-sm">
      <%= form_with url: new_corporate_booking_path, method: :get, class: "space-y-4" do |form| %>
        <div class="grid gap-4 lg:grid-cols-2">
          <%= render PanelsUI::FormField.new(form:, attribute: :hotel_relationship_id,
                label: "Hotel", required: true) do |field| %>
            <% field.with_select_menu(
                 @relationships.map { |r| { label: r.hotel.name, value: r.id } },
                 selected: @relationship&.id) %>
          <% end %>

          <%= render PanelsUI::FormField.new(form:, attribute: :rooms, label: "Rooms",
                hint: "Every room is booked with the same occupancy.") do |field| %>
            <% field.with_select_menu(
                 (1..8).map { |n| { label: pluralize(n, "room"), value: n } },
                 selected: @rooms) %>
          <% end %>
        </div>

        <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
          <%= render PanelsUI::FormField.new(form:, attribute: :check_in, label: "Arrival", required: true) do |field| %>
            <% field.with_date_picker(value: @check_in, linked_to: :check_out, min: Date.current) %>
          <% end %>

          <%= render PanelsUI::FormField.new(form:, attribute: :check_out, label: "Departure", required: true) do |field| %>
            <% field.with_date_picker(value: @check_out, min: @check_in || Date.current) %>
          <% end %>

          <%= render PanelsUI::FormField.new(form:, attribute: :adults, label: "Adults per room") do |field| %>
            <% field.with_input(type: :number, value: @adults, min: 1, max: 10) %>
          <% end %>

          <%= render PanelsUI::FormField.new(form:, attribute: :children, label: "Children per room") do |field| %>
            <% field.with_input(type: :number, value: @children, min: 0, max: 10) %>
          <% end %>
        </div>

        <%= render PanelsUI::Button.new(as: :button, type: :submit, variant: :primary) do %>
          Search availability
        <% end %>
      <% end %>
    </section>

    <% if @search.present? %>
      <% if @search.error.present? %>
        <%= render PanelsUI::Alert.new(tone: :warning, title: "Check the dates") do |alert| %>
          <% alert.with_description do %><%= @search.error %><% end %>
        <% end %>
      <% else %>
        <section class="overflow-hidden rounded-2xl border border-border bg-card shadow-sm">
          <div class="border-b border-border px-6 py-4">
            <h2 class="text-sm font-bold text-foreground">
              <%= pluralize(@rooms, "room") %> · <%= pluralize(@search.nights, "night") %> ·
              <%= @check_in.strftime("%d %b") %> – <%= @check_out.strftime("%d %b %Y") %>
            </h2>
          </div>

          <% if @search.available.empty? %>
            <p class="px-6 py-10 text-center text-sm text-muted-foreground">
              Nothing has <%= pluralize(@rooms, "room") %> free for these dates.
            </p>
          <% else %>
            <ul class="divide-y divide-border">
              <% @search.available.each do |option| %>
                <% chosen = @selected&.room_type&.id == option.room_type.id %>
                <li class="flex flex-wrap items-center justify-between gap-4 px-6 py-4">
                  <div class="min-w-0">
                    <p class="font-bold text-foreground"><%= option.room_type.name %></p>
                    <p class="mt-0.5 text-xs text-muted-foreground">
                      <%= option.rate_plan.name %> · <%= pluralize(option.available_count, "room") %> free
                    </p>
                  </div>
                  <div class="flex items-center gap-4">
                    <p class="text-right font-bold tabular-nums text-foreground">
                      <%= option.currency %> <%= number_with_precision(option.total_amount, precision: 2) %>
                      <span class="block text-xs font-normal text-muted-foreground">
                        <% if @rooms > 1 %>
                          <%= option.currency %> <%= number_with_precision(option.per_room_amount, precision: 2) %> per room
                        <% else %>
                          total stay
                        <% end %>
                      </span>
                    </p>
                    <%= render PanelsUI::Button.new(
                          as: :a, variant: chosen ? :secondary : :primary, size: :sm,
                          href: new_corporate_booking_path(
                            hotel_relationship_id: @relationship.id, check_in: @check_in,
                            check_out: @check_out, adults: @adults, children: @children,
                            rooms: @rooms, room_type_id: option.room_type.id)) do %>
                      <%= chosen ? "Selected" : "Select" %>
                    <% end %>
                  </div>
                </li>
              <% end %>
            </ul>
          <% end %>
        </section>

        <% if @selected.present? %>
          <section class="rounded-2xl border border-border bg-card p-6 shadow-sm">
            <h2 class="text-sm font-bold text-foreground">Guest details</h2>
            <p class="mt-1 text-xs text-muted-foreground">
              <%= pluralize(@rooms, "×") %> <%= @selected.room_type.name %> ·
              <%= @selected.currency %> <%= number_with_precision(@selected.total_amount, precision: 2) %> for the stay.
              Payment is not taken here — this follows your billing relationship with the hotel.
            </p>

            <%= form_with url: corporate_bookings_path, method: :post, scope: :booking,
                          class: "mt-5 space-y-5" do |form| %>
              <%= hidden_field_tag :hotel_relationship_id, @relationship.id %>
              <%= form.hidden_field :room_type_id, value: @selected.room_type.id %>
              <%= form.hidden_field :check_in, value: @check_in %>
              <%= form.hidden_field :check_out, value: @check_out %>
              <%= form.hidden_field :adults, value: @adults %>
              <%= form.hidden_field :children, value: @children %>
              <%= form.hidden_field :rooms, value: @rooms %>

              <%# One block per room, and inside it one per adult sharing that
                  room. The first of each is the lead the room is held under. %>
              <% @rooms.times do |room_index| %>
                <fieldset class="rounded-xl border border-border p-4">
                  <legend class="px-1.5 text-xs font-bold uppercase tracking-wide text-muted-foreground">
                    Room <%= room_index + 1 %>
                  </legend>
                  <div class="space-y-4">
                    <% @adults.times do |guest_index| %>
                      <div class="grid gap-3 sm:grid-cols-3">
                        <%= render PanelsUI::FormField.new(form:, attribute: :name,
                              id: "room-#{room_index}-guest-#{guest_index}-name",
                              label: guest_index.zero? ? "Lead guest" : "Guest #{guest_index + 1} (optional)") do |field| %>
                          <% field.with_input(
                               name: "booking[rooms_detail][#{room_index}][guests][#{guest_index}][name]",
                               value: nil, required: guest_index.zero?, placeholder: "Full name") %>
                        <% end %>
                        <%= render PanelsUI::FormField.new(form:, attribute: :phone,
                              id: "room-#{room_index}-guest-#{guest_index}-phone", label: "Phone") do |field| %>
                          <% field.with_input(
                               type: :tel,
                               name: "booking[rooms_detail][#{room_index}][guests][#{guest_index}][phone]",
                               value: nil, required: guest_index.zero?) %>
                        <% end %>
                        <%= render PanelsUI::FormField.new(form:, attribute: :email,
                              id: "room-#{room_index}-guest-#{guest_index}-email", label: "Email") do |field| %>
                          <% field.with_input(
                               type: :email,
                               name: "booking[rooms_detail][#{room_index}][guests][#{guest_index}][email]",
                               value: nil) %>
                        <% end %>
                      </div>
                    <% end %>
                  </div>
                </fieldset>
              <% end %>

              <%= render PanelsUI::FormField.new(form:, attribute: :special_requests,
                    label: "Special requests", hint: "Applied to every room in this booking.") do |field| %>
                <% field.with_input(placeholder: "Late arrival, adjoining rooms…") %>
              <% end %>

              <%= render PanelsUI::Button.new(as: :button, type: :submit, variant: :primary) do %>
                Confirm <%= pluralize(@rooms, "room") %>
              <% end %>
            <% end %>
          </section>
        <% end %>
      <% end %>
    <% end %>
  <% end %>
</div>
