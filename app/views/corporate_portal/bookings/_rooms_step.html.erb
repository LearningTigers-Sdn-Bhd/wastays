<%# Step two: the rooms. The cart of lines, and the three small stages that add one
    -- a category, who is in it, and a rate for that party. All the stay's state is
    in the URL, so each link below carries the cart. %>
<% base = { hotel_relationship_id: @relationship.id, check_in: @check_in, check_out: @check_out, step: "rooms" } %>
<% cart_params = CorporatePortal::StayLine.to_params(@lines) %>
<% add_party = { add_room_type_id: @add_room_type&.id, add_adults: @add_adults, add_children: @add_children,
                 add_child_ages: @add_child_ages&.join(","), add_quantity: @add_quantity }.compact %>

<% case @stage %>
<% when :cart %>
  <section class="overflow-hidden rounded-2xl border border-border bg-card shadow-sm" data-testid="stay-cart">
    <div class="border-b border-border px-6 py-4">
      <h2 class="text-sm font-bold text-foreground" data-testid="wizard-step-title">Your rooms</h2>
      <p class="mt-0.5 text-xs text-muted-foreground">Rooms can differ in category, rate and who is in them. All share the dates above.</p>
    </div>

    <ul class="divide-y divide-border">
      <% @cart.quotes.each_with_index do |quote, index| %>
        <% line = quote.line %>
        <li class="flex flex-col gap-2 px-4 py-4 sm:flex-row sm:items-start sm:justify-between sm:gap-4 sm:px-6" data-testid="cart-line">
          <div class="min-w-0">
            <p class="font-bold text-foreground">
              <%= pluralize(line.quantity, "room") %> · <%= quote.room_type&.name || "Unknown category" %>
            </p>
            <p class="mt-0.5 text-xs text-muted-foreground">
              <%= quote.rate_plan&.name %> ·
              <%= pluralize(line.adults, "adult") %><%= ", #{pluralize(line.children, 'child')}" if line.children.positive? %> per room
            </p>
            <% if quote.error.present? %>
              <p class="mt-1 text-xs font-semibold text-destructive" data-testid="cart-line-error"><%= quote.error %></p>
            <% end %>
          </div>
          <div class="flex items-center justify-between gap-4 sm:justify-end sm:shrink-0">
            <% if quote.total_amount %>
              <p class="font-bold tabular-nums text-foreground sm:text-right">
                <%= quote.option.currency %> <%= number_with_precision(quote.total_amount, precision: 2, delimiter: ",") %>
                <% if line.quantity > 1 %>
                  <span class="block text-xs font-normal text-muted-foreground"><%= number_with_precision(quote.per_room_amount, precision: 2, delimiter: ",") %> per room</span>
                <% end %>
              </p>
            <% end %>
            <%= link_to "Remove", new_corporate_booking_path(base.merge(lines: CorporatePortal::StayLine.to_params(@lines.reject.with_index { |_, i| i == index }))),
                  class: "text-xs font-bold text-destructive underline-offset-4 hover:underline", data: { testid: "remove-line-#{index}" } %>
          </div>
        </li>
      <% end %>
    </ul>

    <div class="flex flex-wrap items-center justify-between gap-3 border-t border-border bg-muted/30 px-6 py-4">
      <p class="text-sm font-bold text-foreground" data-testid="cart-total">
        <%= pluralize(@cart.rooms, "room") %>
        <% if @cart.success? %> · <%= @cart.currency %> <%= number_with_precision(@cart.total_amount, precision: 2, delimiter: ",") %> for the stay<% end %>
      </p>
      <div class="flex flex-wrap gap-2">
        <%= render PanelsUI::Button.new(as: :a, variant: :secondary, size: :sm,
              href: new_corporate_booking_path(base.merge(lines: cart_params, stage: "category"))) do %>
          Add another room
        <% end %>
        <% if @cart.success? %>
          <%= render PanelsUI::Button.new(as: :a, variant: :primary, size: :sm, data: { testid: "continue-to-guests" },
                href: new_corporate_booking_path(base.merge(lines: cart_params, step: "guests"))) do %>
            Continue to guests
          <% end %>
        <% end %>
      </div>
    </div>
  </section>

<% when :category %>
  <section class="overflow-hidden rounded-2xl border border-border bg-card shadow-sm">
    <div class="border-b border-border px-6 py-4">
      <h2 class="text-sm font-bold text-foreground" data-testid="wizard-step-title">Choose a room category</h2>
    </div>
    <% available = @free_rooms.select { |_room_type, free| free.positive? } %>
    <% if available.empty? %>
      <p class="px-6 py-10 text-center text-sm text-muted-foreground">
        <%= @lines.any? ? "Your stay already holds every room that is free for these dates." : "Nothing is free for these dates." %>
      </p>
    <% else %>
      <ul class="divide-y divide-border" data-testid="agent-room-types">
        <% available.each do |room_type, free| %>
          <li class="flex flex-col gap-3 px-4 py-4 sm:flex-row sm:items-center sm:justify-between sm:gap-4 sm:px-6" data-testid="agent-room-type">
            <div class="min-w-0">
              <p class="font-bold text-foreground"><%= room_type.name %></p>
              <p class="mt-0.5 text-xs text-muted-foreground">
                <%= pluralize(free, "room") %> free · up to <%= pluralize(room_type.max_adults, "adult") %><%= ", #{pluralize(room_type.max_children, 'child')}" if room_type.max_children.to_i.positive? %>
              </p>
              <% if room_type.description.present? %>
                <p class="mt-0.5 line-clamp-2 text-xs text-muted-foreground"><%= room_type.description %></p>
              <% end %>
            </div>
            <%= render PanelsUI::Button.new(as: :a, variant: :primary, size: :sm, class: "shrink-0",
                  href: new_corporate_booking_path(base.merge(lines: cart_params, stage: "occupancy", add_room_type_id: room_type.id))) do %>
              Choose
            <% end %>
          </li>
        <% end %>
      </ul>
    <% end %>
    <% if @lines.any? %>
      <div class="border-t border-border px-6 py-3">
        <%= link_to "Back to your rooms", new_corporate_booking_path(base.merge(lines: cart_params)), class: "text-xs font-bold text-foreground underline-offset-4 hover:underline" %>
      </div>
    <% end %>
  </section>

<% when :occupancy %>
  <% free = @free_rooms.fetch(@add_room_type, 0) %>
  <section class="rounded-2xl border border-border bg-card p-6 shadow-sm" data-testid="occupancy-step">
    <h2 class="text-sm font-bold text-foreground" data-testid="wizard-step-title">Who is in the <%= @add_room_type.name %>?</h2>
    <p class="mt-1 text-xs text-muted-foreground">
      <%= pluralize(free, "room") %> free · up to <%= pluralize(@add_room_type.max_adults, "adult") %><%= ", #{pluralize(@add_room_type.max_children, 'child')}" if @add_room_type.max_children.to_i.positive? %> per room.
      Every room in this line has the same party; a different party is another line.
    </p>
    <% if @add_error.present? %>
      <p class="mt-3 text-sm font-semibold text-destructive" data-testid="occupancy-error"><%= @add_error %></p>
    <% end %>

    <%# A per-guest property prices each child by age, so each child is asked for one. %>
    <% asks_child_ages = @relationship.hotel.sells_per_person? %>
    <%= form_with url: new_corporate_booking_path, method: :get, class: "mt-4 space-y-4",
          data: (asks_child_ages ? { controller: "child-ages", child_ages_name_value: "add_child_ages[]", child_ages_ages_value: @add_child_ages.to_json } : {}) do |form| %>
      <%= hidden_field_tag :hotel_relationship_id, @relationship.id %>
      <%= hidden_field_tag :check_in, @check_in %>
      <%= hidden_field_tag :check_out, @check_out %>
      <%= hidden_field_tag :step, "rooms" %>
      <%= hidden_field_tag :stage, "rate" %>
      <%= hidden_field_tag :add_room_type_id, @add_room_type.id %>
      <% cart_params.each do |index, attrs| %>
        <% attrs.each do |key, value| %><%= hidden_field_tag "lines[#{index}][#{key}]", value %><% end %>
      <% end %>

      <div class="grid grid-cols-3 gap-4">
        <%= render PanelsUI::FormField.new(form:, attribute: :add_quantity, label: "Rooms") do |field| %>
          <% field.with_input(type: :number, name: "add_quantity", value: @add_quantity, min: 1, max: [ free, 1 ].max) %>
        <% end %>
        <%= render PanelsUI::FormField.new(form:, attribute: :add_adults, label: "Adults per room") do |field| %>
          <% field.with_input(type: :number, name: "add_adults", value: @add_adults, min: 1, max: @add_room_type.max_adults) %>
        <% end %>
        <div <%= 'data-child-ages-target="count"'.html_safe if asks_child_ages %>>
          <%= render PanelsUI::FormField.new(form:, attribute: :add_children, label: "Children per room") do |field| %>
            <% field.with_input(type: :number, name: "add_children", value: @add_children, min: 0, max: @add_room_type.max_children.to_i,
                                data: (asks_child_ages ? { action: "input->child-ages#sync change->child-ages#sync" } : {})) %>
          <% end %>
        </div>
      </div>

      <% if asks_child_ages %>
        <div class="<%= 'hidden' if @add_children.zero? %>" data-child-ages-target="wrapper">
          <p class="text-sm font-medium text-foreground">Children's ages</p>
          <p class="mt-0.5 text-xs text-muted-foreground">Children are priced by age, so every child in the room needs one.</p>
          <div class="mt-2 flex flex-wrap gap-2" data-child-ages-target="list"></div>
        </div>
      <% end %>

      <div class="flex flex-wrap items-center gap-3">
        <%= render PanelsUI::Button.new(as: :button, type: :submit, variant: :primary) do %>See rates<% end %>
        <%= link_to "Choose a different category", new_corporate_booking_path(base.merge(lines: cart_params, stage: "category")),
              class: "text-xs font-bold text-foreground underline-offset-4 hover:underline" %>
      </div>
    <% end %>
  </section>

<% when :rate %>
  <section class="overflow-hidden rounded-2xl border border-border bg-card shadow-sm">
    <div class="border-b border-border px-6 py-4">
      <h2 class="text-sm font-bold text-foreground" data-testid="wizard-step-title">Choose a rate</h2>
      <p class="mt-0.5 text-xs text-muted-foreground" data-testid="rate-party">
        <%= pluralize(@add_quantity, "room") %> · <%= @add_room_type.name %> ·
        <%= pluralize(@add_adults, "adult") %><%= ", #{pluralize(@add_children, 'child')}" if @add_children.positive? %> per room
        <%= link_to "Change", new_corporate_booking_path(base.merge(lines: cart_params, stage: "occupancy", **add_party)),
              class: "ms-1 font-bold underline-offset-4 hover:underline" %>
      </p>
    </div>
    <% bookable = @rate_options.select(&:available?) %>
    <% if bookable.empty? && @rate_options.none?(&:restricted?) %>
      <p class="px-6 py-10 text-center text-sm text-muted-foreground">No rate is open to your account for this room.</p>
    <% end %>
    <ul class="divide-y divide-border" data-testid="agent-rates">
      <% bookable.each do |option| %>
        <% new_line = CorporatePortal::StayLine.new(room_type_id: @add_room_type.id, rate_plan_id: option.rate_plan.id, adults: @add_adults,
                                   children: @add_children, child_ages: @add_child_ages, quantity: @add_quantity) %>
        <li class="flex flex-col gap-3 px-4 py-4 sm:flex-row sm:items-center sm:justify-between sm:gap-4 sm:px-6" data-testid="agent-rate">
          <div class="min-w-0">
            <p class="font-semibold text-foreground"><%= option.rate_plan.name %></p>
            <% if option.rate_plan.description.present? %>
              <p class="mt-0.5 text-xs text-muted-foreground"><%= option.rate_plan.description %></p>
            <% end %>
            <% if option.tax_lines.present? %>
              <p class="mt-0.5 text-xs text-muted-foreground">
                Includes <%= option.tax_lines.map { |line| "#{line['name']} (#{option.currency} #{number_with_precision(line['amount'].to_d * option.rooms, precision: 2)})" }.to_sentence %>
              </p>
            <% end %>
          </div>
          <div class="flex items-center justify-between gap-4 sm:justify-end sm:shrink-0">
            <p class="font-bold tabular-nums text-foreground sm:text-right">
              <%= option.currency %> <%= number_with_precision(option.total_amount, precision: 2, delimiter: ",") %>
              <span class="block text-xs font-normal text-muted-foreground">
                <%= @add_quantity > 1 ? "#{number_with_precision(option.per_room_amount, precision: 2, delimiter: ',')} per room" : "total stay" %>
              </span>
            </p>
            <%= render PanelsUI::Button.new(as: :a, variant: :primary, size: :sm, class: "shrink-0", data: { testid: "select-rate" },
                  href: new_corporate_booking_path(base.merge(lines: CorporatePortal::StayLine.to_params(@lines + [ new_line ])))) do %>
              Add to stay
            <% end %>
          </div>
        </li>
      <% end %>
      <% @rate_options.select(&:restricted?).each do |option| %>
        <li class="px-4 py-3 text-xs text-muted-foreground sm:px-6">
          <span class="font-semibold text-foreground"><%= option.rate_plan.name %></span> · <%= option.restriction %>
        </li>
      <% end %>
    </ul>
    <% if (note = @rate_options.first&.tourism_tax_note).present? %>
      <p class="border-t border-border px-6 py-3 text-xs text-muted-foreground"><%= note %></p>
    <% end %>
  </section>
<% end %>
