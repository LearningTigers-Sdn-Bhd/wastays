<%# One room of the stay, as the agent needs to brief their client on it. %>
<section class="overflow-hidden rounded-2xl border border-border bg-card shadow-sm" data-testid="agent-room-detail">
  <div class="flex flex-wrap items-center justify-between gap-3 border-b border-border px-6 py-4">
    <div>
      <h2 class="text-sm font-bold text-foreground">
        <%= "Room #{room_counter + 1} · " if room_count > 1 %><%= room.room_type_name %>
      </h2>
      <p class="mt-0.5 text-xs text-muted-foreground">
        <%= room.rate_plan_name %> · <%= room.booking.formatted_reservation_number %> · Room <%= room.room_number %>
      </p>
    </div>
    <div class="flex items-center gap-2">
      <%= render PanelsUI::Badge.new(label: room.status_label, variant: :neutral, size: :sm) %>
      <% if room.editable? %>
        <%= link_to "Edit guests", edit_corporate_booking_guests_path(room.booking),
              class: "rounded-lg border border-border px-3 py-1.5 text-xs font-bold text-foreground hover:bg-muted" %>
      <% end %>
    </div>
  </div>

  <div class="space-y-5 px-6 py-5 text-sm">
    <dl class="grid grid-cols-2 gap-4 sm:grid-cols-3">
      <div>
        <dt class="text-muted-foreground">Nights</dt>
        <dd class="font-bold"><%= room.nights %></dd>
      </div>
      <div>
        <dt class="text-muted-foreground">Occupancy</dt>
        <dd class="font-bold"><%= pluralize(room.adults, "adult") %><%= ", #{pluralize(room.children, 'child')}" if room.children.to_i.positive? %></dd>
      </div>
      <div>
        <dt class="text-muted-foreground">Room total</dt>
        <dd class="font-bold tabular-nums"><%= room.currency %> <%= number_with_precision(room.booking.total_amount, precision: 2) %></dd>
      </div>
    </dl>

    <div>
      <h3 class="text-xs font-bold uppercase tracking-wide text-muted-foreground">Guests</h3>
      <ul class="mt-2 divide-y divide-border rounded-xl border border-border">
        <% room.guests.each do |guest| %>
          <li class="flex flex-wrap items-start justify-between gap-2 px-4 py-3">
            <div class="min-w-0">
              <p class="font-semibold text-foreground">
                <%= guest.name %>
                <% if guest.lead %><span class="ms-1 text-xs font-normal text-muted-foreground">Lead guest</span><% end %>
              </p>
              <p class="mt-0.5 text-xs text-muted-foreground">
                <%= [ guest.nationality, guest.phone, guest.email ].compact_blank.join(" · ").presence || "No contact details" %>
              </p>
            </div>
            <% if guest.masked_id.present? %>
              <span class="font-mono text-xs text-muted-foreground" title="IC / passport, masked"><%= guest.masked_id %></span>
            <% end %>
          </li>
        <% end %>
      </ul>
    </div>

    <% transfers = room.transfers %>
    <% missing_legs = room.missing_boat_legs %>
    <% if transfers.any? || missing_legs.any? %>
      <div>
        <h3 class="text-xs font-bold uppercase tracking-wide text-muted-foreground">Boat transfers</h3>
        <ul class="mt-2 space-y-1">
          <% transfers.each do |transfer| %>
            <li>
              <span class="font-semibold"><%= transfer.label %></span>
              <%= transfer.display %>
              <% if transfer.meals.any? %>
                <span class="text-xs text-muted-foreground">· Meals: <%= transfer.meals.to_sentence %></span>
              <% end %>
            </li>
          <% end %>
          <% missing_legs.each do |leg| %>
            <li class="text-muted-foreground"><span class="font-semibold text-foreground"><%= leg %></span> not added yet</li>
          <% end %>
        </ul>
        <% if missing_legs.any? && room.editable? %>
          <%= link_to "Add boat times", edit_corporate_booking_guests_path(room.booking),
                class: "mt-2 inline-block text-xs font-bold text-primary hover:underline" %>
        <% end %>
      </div>
    <% end %>

    <% if room.special_requests.present? %>
      <div>
        <h3 class="text-xs font-bold uppercase tracking-wide text-muted-foreground">Special requests</h3>
        <p class="mt-1 whitespace-pre-line"><%= room.special_requests %></p>
      </div>
    <% end %>

    <% if (nights = room.nightly_rates).any? %>
      <details class="group">
        <summary class="cursor-pointer text-xs font-bold uppercase tracking-wide text-muted-foreground">Nightly rates</summary>
        <dl class="mt-2 space-y-1 text-xs">
          <% nights.each do |night| %>
            <div class="flex justify-between">
              <dt><%= night.date.strftime("%a %d %b") %></dt>
              <dd class="tabular-nums"><%= room.currency %> <%= number_with_precision(night.amount, precision: 2) %></dd>
            </div>
          <% end %>
        </dl>
      </details>
    <% end %>
  </div>
</section>
