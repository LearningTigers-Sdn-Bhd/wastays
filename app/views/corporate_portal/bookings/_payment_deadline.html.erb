<%# The payment deadline on an agent's booking. The exact time is rendered
    server-side and carries its timezone, so the line still reads correctly with
    JavaScript off; the Stimulus controller only adds the "2d 4h left" part. %>
<% payment = CorporatePortal::BookingPaymentPresenter.new(booking) %>
<% if payment.awaiting_payment? %>
  <div class="panel-payment-deadline <%= compact ? "text-xs" : "rounded-xl border border-border bg-muted/40 p-4 text-sm" %>"
       data-controller="payment-deadline"
       data-payment-deadline-due-at-value="<%= payment.due_at.iso8601 %>"
       data-state="<%= payment.under_review? ? "review" : "pending" %>">
    <div class="flex flex-wrap items-center gap-x-2 gap-y-1">
      <% if payment.under_review? %>
        <%= cached_icon "hourglass", class: "size-3.5 shrink-0 text-muted-foreground", aria: { hidden: true } %>
        <span class="font-bold text-foreground">Slip under review</span>
      <% else %>
        <%= cached_icon "clock", class: "size-3.5 shrink-0 text-muted-foreground", aria: { hidden: true } %>
        <span class="font-bold text-foreground">Pay <%= payment.amount_label %></span>
        <span class="text-muted-foreground">by <%= payment.due_at_label %></span>
        <span class="font-bold tabular-nums" data-payment-deadline-target="remaining"></span>
      <% end %>
    </div>

    <% unless compact %>
      <p class="mt-1.5 text-xs text-muted-foreground"><%= payment.status_note %></p>
      <% if payment.rejected_submission&.rejection_reason.present? %>
        <p class="mt-1.5 text-xs font-semibold text-destructive">
          A previous slip was rejected: <%= payment.rejected_submission.rejection_reason %>
        </p>
      <% end %>
      <% unless payment.under_review? %>
        <%= link_to new_corporate_ar_payment_submission_path(booking_id: booking.id),
              class: "mt-3 inline-flex items-center gap-2 rounded-xl bg-primary px-4 py-2 text-sm font-bold text-primary-foreground hover:bg-primary-hover" do %>
          <%= cached_icon "upload", class: "size-4", aria: { hidden: true } %>
          <span>Pay now</span>
        <% end %>
      <% end %>
    <% end %>
  </div>
<% end %>
