<%= render PanelsUI::PageHeader.new(
      title: "Corporate dashboard",
      description: "Hotels currently connected to #{current_user.account.name}.") %>

<section class="mt-3.5 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
  <div class="rounded-2xl border border-border bg-card p-6 shadow-sm">
    <p class="text-xs font-bold uppercase tracking-[0.2em] text-muted-foreground">Linked hotels</p>
    <p class="mt-3 text-3xl font-black text-foreground"><%= @relationships.size %></p>
  </div>
  <div class="rounded-2xl border border-border bg-card p-6 shadow-sm sm:col-span-2">
    <p class="text-xs font-bold uppercase tracking-[0.2em] text-muted-foreground">Outstanding balance</p>
    <% if @outstanding_by_currency.any? %>
      <div class="mt-3 flex flex-wrap gap-3">
        <% @outstanding_by_currency.each do |currency, amount| %>
          <span class="rounded-xl bg-primary px-4 py-2 text-lg font-black tabular-nums text-primary-foreground"><%= currency %> <%= format_number(amount, precision: 2) %></span>
        <% end %>
      </div>
    <% else %>
      <p class="mt-3 text-3xl font-black text-foreground">No outstanding AR balance</p>
    <% end %>
  </div>
</section>

<%# Money owed on bookings, kept apart from the AR balance above: an overdue
    invoice is chased, but an unpaid booking loses the rooms. %>
<% if @payments.any? %>
  <section class="mt-5 overflow-hidden rounded-2xl border border-border bg-card shadow-sm">
    <div class="flex flex-wrap items-start justify-between gap-3 border-b border-border px-6 py-4">
      <div>
        <h2 class="text-base font-bold text-foreground">Bookings awaiting payment</h2>
        <p class="mt-0.5 text-sm text-muted-foreground">
          <%= pluralize(@payments.count, "booking") %> with payment outstanding. Each is held for you until its deadline.
        </p>
      </div>
      <div class="flex flex-wrap items-center gap-2">
        <% @payments.totals_by_currency.each do |currency, amount| %>
          <span class="rounded-xl bg-primary px-3 py-1.5 text-sm font-black tabular-nums text-primary-foreground">
            <%= currency %> <%= format_number(amount, precision: 2) %>
          </span>
        <% end %>
        <% if @payments.overdue_count.positive? %>
          <%= render PanelsUI::Badge.new(label: "#{@payments.overdue_count} overdue", variant: :destructive, size: :sm) %>
        <% end %>
        <% if @payments.under_review_count.positive? %>
          <%= render PanelsUI::Badge.new(label: "#{@payments.under_review_count} under review", variant: :info, size: :sm) %>
        <% end %>
      </div>
    </div>

    <ul class="divide-y divide-border">
      <% @payments.preview.each do |booking| %>
        <% payment = @payments.presenter_for(booking) %>
        <li class="flex flex-wrap items-center justify-between gap-4 px-6 py-4">
          <div class="min-w-0">
            <div class="flex flex-wrap items-center gap-2">
              <p class="font-bold text-foreground"><%= booking.guest_name %></p>
              <%= render PanelsUI::Badge.new(label: payment.badge_label, variant: payment.badge_variant, size: :sm) %>
            </div>
            <p class="mt-0.5 text-xs text-muted-foreground">
              <%= booking.hotel.name %> · <%= booking.check_in.to_date.strftime("%d %b") %> –
              <%= booking.check_out.to_date.strftime("%d %b %Y") %>
            </p>
            <p class="mt-0.5 text-xs text-muted-foreground">Due <%= payment.due_at_label %></p>
          </div>
          <div class="flex items-center gap-3">
            <span class="text-sm font-bold tabular-nums text-foreground"><%= payment.amount_label %></span>
            <% if payment.under_review? %>
              <%= link_to "View", corporate_booking_path(booking),
                    class: "rounded-lg border border-border px-3 py-1.5 text-xs font-bold text-foreground hover:bg-muted" %>
            <% else %>
              <%= link_to "Pay now", new_corporate_ar_payment_submission_path(booking_id: booking.id),
                    class: "rounded-lg bg-primary px-3 py-1.5 text-xs font-bold text-primary-foreground hover:bg-primary-hover" %>
            <% end %>
          </div>
        </li>
      <% end %>
    </ul>

    <% if @payments.more_count.positive? %>
      <div class="border-t border-border px-6 py-3">
        <%= link_to "#{@payments.more_count} more awaiting payment", corporate_bookings_path,
              class: "text-sm font-bold text-foreground hover:underline" %>
      </div>
    <% end %>
  </section>
<% end %>

<div class="mt-8 grid gap-5 md:grid-cols-2">
  <% @relationships.each do |relationship| %>
    <article class="rounded-2xl border border-border bg-card p-6 shadow-sm">
      <h2 class="text-xl font-bold"><%= relationship.hotel.name %></h2>
      <p class="mt-1 text-sm text-muted-foreground"><%= relationship.hotel.city %>, <%= relationship.hotel.country %></p>
      <dl class="mt-5 grid grid-cols-2 gap-4 text-sm">
        <div>
          <dt class="text-muted-foreground">Relationship</dt>
          <dd class="font-bold"><%= relationship.relationship_type.humanize %></dd>
        </div>
        <div>
          <dt class="text-muted-foreground">Direct billing</dt>
          <dd class="font-bold"><%= relationship.direct_bill_enabled? ? "Enabled" : "Disabled" %></dd>
        </div>
        <div>
          <dt class="text-muted-foreground">Credit limit</dt>
          <dd class="font-bold"><%= relationship.credit_limit.present? ? "#{relationship.credit_currency} #{relationship.credit_limit}" : "Not set" %></dd>
        </div>
        <div>
          <dt class="text-muted-foreground">Payment terms</dt>
          <dd class="font-bold"><%= relationship.payment_terms_days.present? ? "#{relationship.payment_terms_days} days" : "Not set" %></dd>
        </div>
        <div class="col-span-2">
          <dt class="text-muted-foreground">Outstanding balance</dt>
          <dd class="font-bold"><%= relationship.credit_currency %> <%= format_number(@outstanding_by_relationship.fetch(relationship.id, 0), precision: 2) %></dd>
        </div>
      </dl>
      <%= link_to "View statement", corporate_ar_statement_path(relationship), class: "mt-5 inline-flex items-center text-sm font-bold text-slate-900 hover:text-slate-700" %>
    </article>
  <% end %>
</div>

<% if @relationships.empty? %>
  <div class="mt-8 rounded-2xl border border-dashed border-border-interactive bg-card px-6 py-12 text-center text-muted-foreground">
    No active hotel relationships are available.
  </div>
<% end %>
