<%= render PanelsUI::PageHeader.new(
      title: "Corporate dashboard",
      description: "Hotels currently connected to #{current_user.account.name}.") %>

<section class="mt-3.5 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
  <div class="rounded-2xl border border-border bg-card p-6 shadow-sm">
    <p class="text-xs font-bold uppercase tracking-[0.2em] text-muted-foreground">Linked hotels</p>
    <p class="mt-3 text-3xl font-black text-foreground"><%= @relationships.size %></p>
  </div>
  <div class="rounded-2xl border border-border bg-card p-6 shadow-sm sm:col-span-2">
    <p class="text-xs font-bold uppercase tracking-[0.2em] text-muted-foreground">Outstanding balance</p>
    <% if @outstanding_by_currency.any? %>
      <div class="mt-3 flex flex-wrap gap-3">
        <% @outstanding_by_currency.each do |currency, amount| %>
          <span class="rounded-xl bg-primary px-4 py-2 text-lg font-black tabular-nums text-primary-foreground"><%= currency %> <%= number_with_precision(amount, precision: 2) %></span>
        <% end %>
      </div>
    <% else %>
      <p class="mt-3 text-3xl font-black text-foreground">No outstanding AR balance</p>
    <% end %>
  </div>
</section>

<div class="mt-8 grid gap-5 md:grid-cols-2">
  <% @relationships.each do |relationship| %>
    <article class="rounded-2xl border border-border bg-card p-6 shadow-sm">
      <h2 class="text-xl font-bold"><%= relationship.hotel.name %></h2>
      <p class="mt-1 text-sm text-muted-foreground"><%= relationship.hotel.city %>, <%= relationship.hotel.country %></p>
      <dl class="mt-5 grid grid-cols-2 gap-4 text-sm">
        <div>
          <dt class="text-muted-foreground">Relationship</dt>
          <dd class="font-bold"><%= relationship.relationship_type.humanize %></dd>
        </div>
        <div>
          <dt class="text-muted-foreground">Direct billing</dt>
          <dd class="font-bold"><%= relationship.direct_bill_enabled? ? "Enabled" : "Disabled" %></dd>
        </div>
        <div>
          <dt class="text-muted-foreground">Credit limit</dt>
          <dd class="font-bold"><%= relationship.credit_limit.present? ? "#{relationship.credit_currency} #{relationship.credit_limit}" : "Not set" %></dd>
        </div>
        <div>
          <dt class="text-muted-foreground">Payment terms</dt>
          <dd class="font-bold"><%= relationship.payment_terms_days.present? ? "#{relationship.payment_terms_days} days" : "Not set" %></dd>
        </div>
        <div class="col-span-2">
          <dt class="text-muted-foreground">Outstanding balance</dt>
          <dd class="font-bold"><%= relationship.credit_currency %> <%= number_with_precision(@outstanding_by_relationship.fetch(relationship.id, 0), precision: 2) %></dd>
        </div>
      </dl>
      <%= link_to "View statement", corporate_ar_statement_path(relationship), class: "mt-5 inline-flex items-center text-sm font-bold text-slate-900 hover:text-slate-700" %>
    </article>
  <% end %>
</div>

<% if @relationships.empty? %>
  <div class="mt-8 rounded-2xl border border-dashed border-border-interactive bg-card px-6 py-12 text-center text-muted-foreground">
    No active hotel relationships are available.
  </div>
<% end %>
