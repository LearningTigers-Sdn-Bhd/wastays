<div class="mx-auto max-w-5xl space-y-6 pb-20">
  <div>
    <h1 class="text-3xl font-bold tracking-tight text-slate-950">Corporate Profile</h1>
    <p class="mt-1 text-sm text-slate-600">Your corporate account and linked hotel relationships.</p>
  </div>

  <section class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
    <h2 class="text-lg font-bold text-slate-950"><%= @account.name %></h2>
    <dl class="mt-5 grid gap-4 text-sm sm:grid-cols-2">
      <div>
        <dt class="text-slate-500">Account status</dt>
        <dd class="font-bold text-slate-950"><%= @account.status.humanize %></dd>
      </div>
      <div>
        <dt class="text-slate-500">Account type</dt>
        <dd class="font-bold text-slate-950"><%= @account.account_kind.humanize %></dd>
      </div>
      <div>
        <dt class="text-slate-500">Primary user</dt>
        <dd class="font-bold text-slate-950"><%= current_user.name %></dd>
      </div>
      <div>
        <dt class="text-slate-500">Email</dt>
        <dd class="font-bold text-slate-950"><%= current_user.email %></dd>
      </div>
    </dl>
  </section>

  <section class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">
    <div class="border-b border-slate-200 px-6 py-5">
      <h2 class="text-lg font-bold text-slate-950">Linked Hotels</h2>
    </div>
    <% if @relationships.any? %>
      <div class="overflow-x-auto">
        <table class="w-full min-w-[760px] text-left text-sm">
          <thead class="border-b border-slate-200 bg-slate-50 text-xs uppercase tracking-wider text-slate-500">
            <tr>
              <th class="px-6 py-3">Hotel</th>
              <th class="px-6 py-3">Relationship</th>
              <th class="px-6 py-3">Direct Bill</th>
              <th class="px-6 py-3">Credit Limit</th>
              <th class="px-6 py-3">Status</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-100">
            <% @relationships.each do |relationship| %>
              <tr>
                <td class="px-6 py-4 font-bold text-slate-950"><%= relationship.hotel.name %></td>
                <td class="px-6 py-4 text-slate-600"><%= relationship.relationship_type.humanize %></td>
                <td class="px-6 py-4 text-slate-600"><%= relationship.direct_bill_enabled? ? "Enabled" : "Disabled" %></td>
                <td class="px-6 py-4 text-slate-600"><%= relationship.credit_limit.present? ? "#{relationship.credit_currency} #{number_with_precision(relationship.credit_limit, precision: 2)}" : "Not set" %></td>
                <td class="px-6 py-4"><span class="rounded-md bg-slate-100 px-2 py-1 text-xs font-bold uppercase tracking-wide text-slate-700"><%= relationship.status.humanize %></span></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% else %>
      <p class="px-6 py-10 text-center text-sm text-slate-500">No hotel relationships are available.</p>
    <% end %>
  </section>
</div>
