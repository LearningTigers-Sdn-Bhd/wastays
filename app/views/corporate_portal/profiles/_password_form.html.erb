<section class="space-y-4" aria-labelledby="corporate-password-heading">
  <div>
    <h2 id="corporate-password-heading" class="text-sm font-semibold text-foreground">Change password</h2>
    <p class="text-xs text-muted-foreground">After you change your temporary password, hotel staff can no longer view it.</p>
  </div>
  <%= form_with model: current_user, url: corporate_profile_path, method: :patch, class: "space-y-4" do |form| %>
    <% if current_user.errors.any? %>
      <%= render PanelsUI::Alert.new(tone: :destructive, title: "Password could not be changed") do |alert| %>
        <% alert.with_description do %><%= current_user.errors.full_messages.to_sentence %><% end %>
      <% end %>
    <% end %>
    <div class="grid gap-4 sm:grid-cols-3">
      <% [ [ :current_password, "Current password", "current-password" ], [ :password, "New password", "new-password" ], [ :password_confirmation, "Confirm new password", "new-password" ] ].each do |attribute, label, autocomplete| %>
        <%= render PanelsUI::FormField.new(form: form, attribute: attribute, label: label) do |field| %>
          <% field.with_input(type: :password, required: true, autocomplete: autocomplete, value: nil) %>
        <% end %>
      <% end %>
    </div>
    <%= render PanelsUI::Button.new(as: :button, type: :submit, variant: :primary) do %>Change password<% end %>
  <% end %>
</section>
