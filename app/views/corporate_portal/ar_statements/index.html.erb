<div class="mx-auto max-w-[1600px] space-y-4 pb-10">
  <header class="flex flex-col gap-4 px-4 md:px-0 lg:flex-row lg:items-end lg:justify-between">
    <div>
      <h1 class="text-2xl font-bold tracking-tight text-slate-950 sm:text-3xl">Statements</h1>
      <p class="mt-1 text-sm font-medium text-slate-600">View your running balance, debits, and credits with each hotel.</p>
    </div>
  </header>

  <%= form_with url: corporate_ar_statements_path,
                method: :get,
                class: "px-4 md:px-0",
                data: { controller: "auto-submit", turbo_frame: "ar_statements_results", turbo_action: "advance" } do |form| %>
    <div class="relative">
      <div class="pointer-events-none absolute inset-y-0 left-0 flex items-center pl-3">
        <%= cached_icon "search", stroke_width: 2, class: "size-4 text-slate-400" %>
      </div>
      <%= form.text_field :query,
        value: @presenter.query,
        placeholder: "Search hotel...",
        class: "block w-full rounded-lg border border-slate-200 bg-white py-2.5 pl-10 pr-3 text-sm shadow-sm transition placeholder:text-slate-400 focus:border-slate-900 focus:outline-none focus:ring-1 focus:ring-slate-900/10",
        data: { action: "input->auto-submit#submit" } %>
    </div>
  <% end %>

  <%= turbo_frame_tag "ar_statements_results" do %>
    <div class="hidden overflow-x-auto rounded-xl border border-slate-200 bg-white shadow-sm lg:block">
      <table class="min-w-[1000px] w-full">
        <thead class="border-b border-slate-200 bg-slate-50/70">
          <tr>
            <th class="px-6 py-3 text-left text-[10px] font-bold uppercase tracking-widest text-slate-500">Hotel</th>
            <th class="px-6 py-3 text-left text-[10px] font-bold uppercase tracking-widest text-slate-500">Terms</th>
            <th class="px-6 py-3 text-left text-[10px] font-bold uppercase tracking-widest text-slate-500">Last AR Activity</th>
            <th class="px-6 py-3 text-right text-[10px] font-bold uppercase tracking-widest text-slate-500">Account Balance</th>
            <th class="px-6 py-3 text-right text-[10px] font-bold uppercase tracking-widest text-slate-500">Unapplied Credit</th>
            <th class="px-6 py-3 text-right text-[10px] font-bold uppercase tracking-widest text-slate-500">Action</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-100">
          <% if @presenter.rows.any? %>
            <% @presenter.rows.each do |row| %>
              <tr class="transition hover:bg-slate-50/70" data-testid="ar-statement-row-<%= row.relationship.id %>">
                <td class="px-6 py-4 text-sm font-bold text-slate-950"><%= row.hotel_name %></td>
                <td class="px-6 py-4 text-sm font-semibold text-slate-700"><%= row.payment_terms %></td>
                <td class="px-6 py-4 text-sm text-slate-600"><%= row.last_activity %></td>
                <td class="px-6 py-4 text-right text-sm font-bold tabular-nums text-slate-950">
                  <% row.balance_labels.each do |amount| %><div><%= amount %></div><% end %>
                </td>
                <td class="px-6 py-4 text-right text-sm font-semibold tabular-nums text-emerald-700">
                  <% row.unapplied_labels.each do |amount| %><div><%= amount %></div><% end %>
                </td>
                <td class="px-6 py-4 text-right">
                  <%= link_to "View Statement", corporate_ar_statement_path(row.relationship), class: "inline-flex items-center rounded-lg bg-slate-900 px-3 py-2 text-xs font-bold text-white transition hover:bg-slate-700", data: { turbo_frame: "_top" } %>
                </td>
              </tr>
            <% end %>
          <% else %>
            <tr>
              <td colspan="6" class="px-6 py-16 text-center">
                <p class="text-sm font-semibold text-slate-700">No hotel relationships found</p>
                <p class="mt-1 text-xs text-slate-500">Try another hotel name.</p>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>

    <div class="space-y-3 px-4 md:px-0 lg:hidden">
      <% if @presenter.rows.any? %>
        <% @presenter.rows.each do |row| %>
          <article class="rounded-xl border border-slate-200 bg-white p-4 shadow-sm" data-testid="ar-statement-card-<%= row.relationship.id %>">
            <div class="flex items-start justify-between gap-3">
              <div class="min-w-0">
                <p class="truncate text-sm font-black text-slate-950"><%= row.hotel_name %></p>
                <p class="mt-1 truncate text-xs text-slate-500"><%= row.payment_terms %></p>
              </div>
              <%= link_to "View", corporate_ar_statement_path(row.relationship), class: "shrink-0 rounded-lg bg-slate-900 px-3 py-2 text-xs font-bold text-white", data: { turbo_frame: "_top" } %>
            </div>
            <div class="mt-4 grid grid-cols-2 gap-4 border-t border-slate-100 pt-4">
              <div>
                <p class="text-[10px] font-bold uppercase tracking-widest text-slate-400">Balance</p>
                <% row.balance_labels.each do |amount| %><p class="mt-1 text-xs font-bold tabular-nums text-slate-900"><%= amount %></p><% end %>
              </div>
              <div class="text-right">
                <p class="text-[10px] font-bold uppercase tracking-widest text-slate-400">Unapplied</p>
                <% row.unapplied_labels.each do |amount| %><p class="mt-1 text-xs font-bold tabular-nums text-emerald-700"><%= amount %></p><% end %>
              </div>
            </div>
            <div class="mt-4 flex items-center justify-between text-xs text-slate-500">
              <span><%= row.last_activity %></span>
            </div>
          </article>
        <% end %>
      <% else %>
        <div class="rounded-xl border border-dashed border-slate-200 bg-white p-8 text-center">
          <p class="text-sm font-semibold text-slate-700">No hotel relationships found</p>
          <p class="mt-1 text-xs text-slate-500">Try another hotel name.</p>
        </div>
      <% end %>
    </div>

    <% if @presenter.pagination.pages > 1 %>
      <div class="mt-6 flex justify-center">
        <%= render PanelsUI::Pagination.new(pagy: @presenter.pagination, hide_when_single_page: true) %>
      </div>
    <% end %>
  <% end %>
</div>
