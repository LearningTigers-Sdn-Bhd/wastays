<% start_date = @presenter&.start_date || @start_date %>
<% end_date = @presenter&.end_date || @end_date %>
<% currencies = @presenter&.available_currencies || @available_currencies %>
<% selected_currency = @presenter&.currency || @selected_currency %>

<div class="mx-auto max-w-[1600px] space-y-4 px-4 pb-12 md:px-0">
  <header class="flex flex-col gap-4 lg:flex-row lg:items-end lg:justify-between">
    <div>
      <p class="text-xs font-bold uppercase tracking-[0.2em] text-slate-400">Statements</p>
      <h1 class="mt-1 text-2xl font-bold tracking-tight text-slate-950 sm:text-3xl"><%= @relationship.hotel.name %></h1>
      <p class="mt-1 text-sm font-medium text-slate-600">Agent code <%= @relationship.agent_code %></p>
    </div>
  </header>

  <%= form_with url: corporate_ar_statement_path(@relationship),
                method: :get,
                class: "rounded-xl border border-slate-200 bg-white p-4 shadow-sm",
                data: { controller: "auto-submit", turbo_frame: "ar_statement_results", turbo_action: "advance" } do |form| %>
    <div class="grid gap-3 sm:grid-cols-3">
      <div>
        <%= form.label :start_date, "Start Date", class: "mb-1.5 block text-[10px] font-bold uppercase tracking-widest text-slate-500" %>
        <%= form.date_field :start_date, value: start_date, max: end_date, class: "w-full rounded-lg border border-slate-200 px-3 py-2 text-sm font-semibold text-slate-700", data: { action: "change->auto-submit#submitNow" } %>
      </div>
      <div>
        <%= form.label :end_date, "End Date", class: "mb-1.5 block text-[10px] font-bold uppercase tracking-widest text-slate-500" %>
        <%= form.date_field :end_date, value: end_date, min: start_date, max: (@relationship.hotel.current_business_date || @relationship.hotel.business_date_for(Time.current)), class: "w-full rounded-lg border border-slate-200 px-3 py-2 text-sm font-semibold text-slate-700", data: { action: "change->auto-submit#submitNow" } %>
      </div>
      <div>
        <%= form.label :currency, "Currency", class: "mb-1.5 block text-[10px] font-bold uppercase tracking-widest text-slate-500" %>
        <%= form.select :currency, options_for_select(currencies, selected_currency), {}, class: "w-full rounded-lg border border-slate-200 bg-white px-3 py-2 text-sm font-semibold text-slate-700", data: { action: "change->auto-submit#submitNow" } %>
      </div>
    </div>
  <% end %>

  <%= turbo_frame_tag "ar_statement_results", class: "block space-y-4" do %>
    <% if @statement_error.present? %>
      <div class="rounded-xl border border-red-200 bg-red-50 px-5 py-4 text-sm font-semibold text-red-800">
        <%= @statement_error %>
      </div>
    <% else %>
      <div class="flex justify-end">
        <%= link_to corporate_ar_statement_path(
              @relationship,
              start_date: @presenter.start_date,
              end_date: @presenter.end_date,
              currency: @presenter.currency,
              format: :pdf
            ),
            target: "_blank",
            class: "inline-flex items-center justify-center gap-2 rounded-xl bg-slate-900 px-4 py-2.5 text-sm font-bold text-white shadow-sm transition hover:bg-slate-700",
            data: { turbo: false } do %>
          <%= cached_icon "download", class: "size-4" %>
          Download PDF
        <% end %>
      </div>

      <section class="grid grid-cols-2 overflow-hidden rounded-xl border border-slate-200 bg-white shadow-sm lg:grid-cols-5">
        <% [
          ["Opening Balance", @presenter.opening_balance, "text-slate-950"],
          ["Period Invoices", @presenter.period_invoices, "text-slate-950"],
          ["Period Payments", @presenter.period_payments, "text-emerald-700"],
          ["Closing Balance", @presenter.closing_balance, @presenter.closing_balance.negative? ? "text-emerald-700" : "text-amber-700"],
          ["Unapplied Credit", @presenter.unapplied_credit, "text-emerald-700"]
        ].each_with_index do |(label, amount, color), index| %>
          <div class="p-4 <%= "border-l border-slate-200" unless index.zero? %>">
            <p class="text-[10px] font-bold uppercase tracking-widest text-slate-500"><%= label %></p>
            <p class="mt-1 text-lg font-black tabular-nums <%= color %>"><%= @presenter.money(amount) %></p>
          </div>
        <% end %>
      </section>

      <section class="overflow-hidden rounded-xl border border-slate-200 bg-white shadow-sm">
        <header class="border-b border-slate-200 bg-slate-50/60 px-4 py-3">
          <h2 class="text-xs font-bold uppercase tracking-wider text-slate-700">Statement Activity</h2>
        </header>
        <div class="overflow-x-auto">
          <table class="min-w-[1100px] w-full">
            <thead class="border-b border-slate-200 bg-slate-50 text-[10px] font-bold uppercase tracking-wider text-slate-500">
              <tr>
                <th class="px-4 py-3 text-left">Date</th>
                <th class="px-4 py-3 text-left">Type</th>
                <th class="px-4 py-3 text-left">Reference</th>
                <th class="px-4 py-3 text-left">Description</th>
                <th class="px-4 py-3 text-left">Due Date</th>
                <th class="px-4 py-3 text-right">Debit</th>
                <th class="px-4 py-3 text-right">Credit</th>
                <th class="px-4 py-3 text-right">Running Balance</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-slate-100">
              <% if @presenter.paginated_rows.any? %>
                <% @presenter.paginated_rows.each do |row| %>
                  <tr class="align-top hover:bg-slate-50/60">
                    <td class="whitespace-nowrap px-4 py-3 text-sm text-slate-600"><%= row.effective_date.strftime("%d %b %Y") %></td>
                    <td class="whitespace-nowrap px-4 py-3 text-sm font-semibold text-slate-900"><%= row.record_type %></td>
                    <td class="whitespace-nowrap px-4 py-3 text-sm font-bold text-slate-950"><%= row.reference %></td>
                    <td class="min-w-80 px-4 py-3 text-sm text-slate-600"><%= row.description %></td>
                    <td class="whitespace-nowrap px-4 py-3 text-sm text-slate-600"><%= row.due_on&.strftime("%d %b %Y") || "—" %></td>
                    <td class="whitespace-nowrap px-4 py-3 text-right text-sm tabular-nums text-slate-900"><%= row.debit.zero? ? "—" : @presenter.money(row.debit) %></td>
                    <td class="whitespace-nowrap px-4 py-3 text-right text-sm font-semibold tabular-nums text-emerald-700"><%= row.credit.zero? ? "—" : @presenter.money(row.credit) %></td>
                    <td class="whitespace-nowrap px-4 py-3 text-right text-sm font-black tabular-nums <%= row.balance.negative? ? "text-emerald-700" : "text-slate-950" %>"><%= @presenter.money(row.balance) %></td>
                  </tr>
                <% end %>
              <% else %>
                <tr><td colspan="8" class="px-6 py-16 text-center text-sm font-medium text-slate-500">No AR activity in this statement period.</td></tr>
              <% end %>
            </tbody>
          </table>
        </div>
        <% if @presenter.paginated_rows.total_pages > 1 %>
          <div class="border-t border-slate-100 px-4 py-4">
            <%= paginate @presenter.paginated_rows, params: @presenter.pagination_params %>
          </div>
        <% end %>
      </section>

      <div class="grid gap-4 lg:grid-cols-3">
        <section class="overflow-hidden rounded-xl border border-slate-200 bg-white shadow-sm lg:col-span-2">
          <header class="border-b border-slate-200 bg-slate-50/60 px-4 py-3">
            <h2 class="text-xs font-bold uppercase tracking-wider text-slate-700">Invoice Aging as of <%= @presenter.end_date.strftime("%d %b %Y") %></h2>
          </header>
          <div class="grid grid-cols-2 gap-px bg-slate-200 sm:grid-cols-3 lg:grid-cols-6">
            <% [
              ["Current", @presenter.aging.current],
              ["1–30 Days", @presenter.aging.days_1_30],
              ["31–60 Days", @presenter.aging.days_31_60],
              ["61–90 Days", @presenter.aging.days_61_90],
              ["90+ Days", @presenter.aging.days_over_90],
              ["Total", @presenter.aging.total]
            ].each do |label, amount| %>
              <div class="bg-white p-4">
                <p class="text-[10px] font-bold uppercase tracking-wider text-slate-500"><%= label %></p>
                <p class="mt-1 text-sm font-black tabular-nums text-slate-950"><%= @presenter.money(amount) %></p>
              </div>
            <% end %>
          </div>
        </section>

        <section class="overflow-hidden rounded-xl border border-slate-200 bg-white shadow-sm">
          <header class="border-b border-slate-200 bg-slate-50/60 px-4 py-3">
            <h2 class="text-xs font-bold uppercase tracking-wider text-slate-700">Statement Details</h2>
          </header>
          <dl class="divide-y divide-slate-100">
            <div class="px-4 py-3"><dt class="text-[10px] font-bold uppercase tracking-wider text-slate-500">Contact</dt><dd class="mt-1 text-sm font-semibold text-slate-900"><%= @presenter.contact_email || "—" %></dd></div>
            <div class="px-4 py-3"><dt class="text-[10px] font-bold uppercase tracking-wider text-slate-500">Payment Terms</dt><dd class="mt-1 text-sm font-semibold text-slate-900"><%= @presenter.payment_terms %></dd></div>
            <div class="px-4 py-3"><dt class="text-[10px] font-bold uppercase tracking-wider text-slate-500">Currency</dt><dd class="mt-1 text-sm font-semibold text-slate-900"><%= @presenter.currency %></dd></div>
          </dl>
        </section>
      </div>

      <section class="rounded-xl border border-amber-200 bg-amber-50 px-5 py-4">
        <h2 class="text-xs font-bold uppercase tracking-wider text-amber-900">Statement Notes</h2>
        <ul class="mt-2 space-y-1 text-xs font-medium leading-relaxed text-amber-800">
          <% @presenter.notes.each do |note| %><li>• <%= note %></li><% end %>
        </ul>
      </section>
    <% end %>
  <% end %>
</div>
