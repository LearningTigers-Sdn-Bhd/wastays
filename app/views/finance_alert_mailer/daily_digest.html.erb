<h2>Financial Observability Daily Digest</h2>
<p><strong>Hotel:</strong> <%= @hotel.name %></p>
<p><strong>Date:</strong> <%= Time.current.strftime("%B %d, %Y") %></p>

<hr>

<% if @anomalies[:unbalanced_folios].any? %>
  <h3>Unbalanced Folios (Closed)</h3>
  <table border="1" cellpadding="5" cellspacing="0">
    <thead>
      <tr>
        <th>Booking</th>
        <th>Guest</th>
        <th>Outstanding Balance</th>
      </tr>
    </thead>
    <tbody>
      <% @anomalies[:unbalanced_folios].each do |folio| %>
        <tr>
          <td><%= folio[:confirmation_token] %></td>
          <td><%= folio[:guest_name] %></td>
          <td style="color: red;"><%= number_to_currency(folio[:balance]) %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% else %>
  <p>✅ No unbalanced closed folios detected.</p>
<% end %>

<hr>

<% if @anomalies[:audit_sync_lags].any? %>
  <h3>Audit Sync Lags</h3>
  <ul>
    <% @anomalies[:audit_sync_lags].each do |lag| %>
      <li>
        <strong><%= lag[:business_date] %>:</strong> <%= lag[:status].titleize %> 
        (<span style="color: orange;"><%= lag[:lag_days] %> days behind</span>)
      </li>
    <% end %>
  </ul>
<% else %>
  <p>✅ Audit is up to date.</p>
<% end %>

<hr>

<% if @anomalies[:override_abuse] %>
  <h3>⚠️ Closed-Date Override Warning</h3>
  <p>There have been <strong><%= @anomalies[:override_abuse][:count] %></strong> closed-date overrides in the last 24 hours.</p>
  <p><strong>Latest Actors:</strong> <%= @anomalies[:override_abuse][:latest_actors].join(", ") %></p>
<% else %>
  <p>✅ Closed-date override usage within normal range.</p>
<% end %>

<p style="font-size: 0.8em; color: #666; margin-top: 30px;">
  This is an automated alert generated by Wastays Financial Observability. 
  Frequency: <%= distance_of_time_in_words(@team_config.frequency) %>
</p>
