<div class="max-w-[85rem] mx-auto py-10 px-4 sm:px-6 lg:px-8">
  <div class="mb-5">
    <%= link_to hotel_room_types_path, class: "inline-flex items-center gap-x-1.5 text-sm text-gray-600 hover:text-blue-600" do %>
      <svg class="flex-shrink-0 size-4" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg>
      Back to Room Types
    <% end %>
  </div>

  <div class="flex justify-between items-center mb-5">
    <div>
      <h2 class="text-2xl font-bold text-gray-800">Manage Rates: <%= @room_type.name %></h2>
      <p class="text-sm text-gray-600">Set nightly rates for specific date ranges.</p>
    </div>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
    <!-- Calendar View -->
    <div class="lg:col-span-2">
      <div class="bg-white border border-gray-200 rounded-xl shadow-sm overflow-hidden">
        <div class="p-4 border-b border-gray-200 flex justify-between items-center">
          <h3 class="font-semibold text-gray-800">Rate Calendar</h3>
          <div class="flex items-center gap-x-2">
            <%= link_to hotel_room_type_rates_path(@room_type, start_date: @start_date - 14.days), class: "p-2 inline-flex items-center gap-x-2 text-sm font-medium rounded-lg border border-gray-200 bg-white text-gray-800 shadow-sm hover:bg-gray-50" do %>
              <svg class="flex-shrink-0 size-4" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg>
            <% end %>
            <span class="text-sm font-medium"><%= @start_date.strftime("%b %d") %> - <%= @end_date.strftime("%b %d, %Y") %></span>
            <%= link_to hotel_room_type_rates_path(@room_type, start_date: @start_date + 14.days), class: "p-2 inline-flex items-center gap-x-2 text-sm font-medium rounded-lg border border-gray-200 bg-white text-gray-800 shadow-sm hover:bg-gray-50" do %>
              <svg class="flex-shrink-0 size-4" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg>
            <% end %>
          </div>
        </div>
        <div class="overflow-x-auto">
          <table class="min-w-full divide-y divide-gray-200">
            <thead class="bg-gray-50">
              <tr>
                <% (@start_date..@end_date).each do |date| %>
                  <th scope="col" class="px-4 py-3 text-center text-xs font-medium text-gray-500 uppercase border-r border-gray-200 last:border-r-0">
                    <div class="<%= 'text-blue-600 font-bold' if date == Date.today %>">
                      <%= date.strftime("%a") %><br>
                      <%= date.strftime("%d %b") %>
                    </div>
                  </th>
                <% end %>
              </tr>
            </thead>
            <tbody class="divide-y divide-gray-200">
              <tr>
                <% (@start_date..@end_date).each do |date| %>
                  <td class="px-4 py-6 whitespace-nowrap text-center border-r border-gray-200 last:border-r-0">
                    <% rate = @rates[date] %>
                    <div class="text-sm font-semibold text-gray-800">
                      <%= number_to_currency(rate&.price || @room_type.base_price, unit: '') %>
                    </div>
                    <div class="text-[10px] text-gray-500 uppercase"><%= rate&.currency || 'MYR' %></div>
                    <% unless rate %>
                      <div class="mt-1">
                        <span class="inline-flex items-center gap-x-1 py-0.5 px-1.5 rounded-full text-[10px] font-medium bg-gray-100 text-gray-500">Base</span>
                      </div>
                    <% end %>
                  </td>
                <% end %>
              </tr>
            </tbody>
          </table>
        </div>
      </div>
    </div>

    <!-- Bulk Update Form -->
    <div>
      <div class="bg-white border border-gray-200 rounded-xl shadow-sm">
        <div class="p-4 border-b border-gray-200">
          <h3 class="font-semibold text-gray-800">Bulk Rate Update</h3>
        </div>
        <div class="p-4">
          <%= form_with scope: :rate, url: hotel_room_type_rates_path(@room_type), local: true do |f| %>
            <div class="grid gap-y-4">
              <div>
                <%= f.label :start_date, class: "block text-sm mb-2 font-medium" %>
                <%= f.date_field :start_date, value: @start_date, class: "py-2 px-3 block w-full border border-gray-200 rounded-lg text-sm focus:border-blue-500 focus:ring-blue-500", required: true %>
              </div>
              <div>
                <%= f.label :end_date, class: "block text-sm mb-2 font-medium" %>
                <%= f.date_field :end_date, value: @end_date, class: "py-2 px-3 block w-full border border-gray-200 rounded-lg text-sm focus:border-blue-500 focus:ring-blue-500", required: true %>
              </div>
              <div>
                <%= f.label :price, "Price (MYR)", class: "block text-sm mb-2 font-medium" %>
                <%= f.number_field :price, step: 0.01, value: @room_type.base_price, class: "py-2 px-3 block w-full border border-gray-200 rounded-lg text-sm focus:border-blue-500 focus:ring-blue-500", required: true %>
              </div>
              <%= f.hidden_field :currency, value: 'MYR' %>
              
              <div class="mt-2">
                <%= f.submit "Update Rates", class: "w-full py-2 px-3 inline-flex justify-center items-center gap-x-2 text-sm font-semibold rounded-lg border border-transparent bg-blue-600 text-white hover:bg-blue-700 disabled:opacity-50 disabled:pointer-events-none" %>
              </div>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>
