<div class="max-w-[85rem] mx-auto py-10 px-4 sm:px-6 lg:px-8">
  <div class="mb-5">
    <%= link_to hotel_dashboard_path, class: "inline-flex items-center gap-x-1.5 text-sm text-gray-600 hover:text-blue-600" do %>
      <svg class="flex-shrink-0 size-4" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg>
      Back to Dashboard
    <% end %>
  </div>

  <div class="flex justify-between items-center mb-5">
    <div>
      <h2 class="text-2xl font-bold text-gray-800">Room Types</h2>
      <p class="text-sm text-gray-600">Manage your hotel's room categories and base settings.</p>
    </div>
    <%= link_to "Add Room Type", new_hotel_room_type_path, class: "py-2 px-4 inline-flex items-center gap-x-2 text-sm font-semibold rounded-lg border border-transparent bg-blue-600 text-white hover:bg-blue-700" %>
  </div>

  <div class="flex flex-col">
    <div class="-m-1.5 overflow-x-auto">
      <div class="p-1.5 min-w-full inline-block align-middle">
        <div class="border rounded-lg overflow-hidden">
          <table class="min-w-full divide-y divide-gray-200">
            <thead class="bg-gray-50">
              <tr>
                <th scope="col" class="px-6 py-3 text-start text-xs font-medium text-gray-500 uppercase">Name</th>
                <th scope="col" class="px-6 py-3 text-start text-xs font-medium text-gray-500 uppercase">Occupancy</th>
                <th scope="col" class="px-6 py-3 text-start text-xs font-medium text-gray-500 uppercase">Quantity</th>
                <th scope="col" class="px-6 py-3 text-start text-xs font-medium text-gray-500 uppercase">Base Price</th>
                <th scope="col" class="px-6 py-3 text-end text-xs font-medium text-gray-500 uppercase">Action</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-gray-200">
              <% @room_types.each do |room_type| %>
                <tr>
                  <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-gray-800"><%= room_type.name %></td>
                  <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-800">
                    <%= room_type.max_adults %> Adults, <%= room_type.max_children %> Children
                  </td>
                  <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-800"><%= room_type.quantity %></td>
                  <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-800"><%= number_to_currency(room_type.base_price, unit: 'MYR ') %></td>
                  <td class="px-6 py-4 whitespace-nowrap text-end text-sm font-medium">
                    <%= link_to "Rates", hotel_room_type_rates_path(room_type), class: "text-green-600 hover:text-green-800" %>
                    <span class="text-gray-300 mx-2">|</span>
                    <%= link_to "Inventory", hotel_room_type_inventories_path(room_type), class: "text-orange-600 hover:text-orange-800" %>
                    <span class="text-gray-300 mx-2">|</span>
                    <%= link_to "Edit", edit_hotel_room_type_path(room_type), class: "text-blue-600 hover:text-blue-800" %>
                    <span class="text-gray-300 mx-2">|</span>
                    <%= link_to "Delete", hotel_room_type_path(room_type), data: { turbo_method: :delete, turbo_confirm: "Are you sure?" }, class: "text-red-600 hover:text-red-800" %>
                  </td>
                </tr>
              <% end %>
              <% if @room_types.empty? %>
                <tr>
                  <td colspan="5" class="px-6 py-10 text-center text-sm text-gray-500">
                    No room types added yet.
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </div>
</div>
