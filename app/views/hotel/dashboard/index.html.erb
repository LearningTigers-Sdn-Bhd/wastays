<div class="max-w-[85rem] mx-auto py-10 px-4 sm:px-6 lg:px-8">
  <div class="text-center">
    <h1 class="text-3xl font-bold text-gray-800">Hotel Dashboard</h1>
    <p class="mt-2 text-sm text-gray-600">Property Management</p>
  </div>

  <div class="mt-10 grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
    <!-- Bookings -->
    <div class="bg-white border border-gray-200 rounded-xl p-6 shadow-sm">
      <h3 class="text-lg font-semibold text-gray-800 mb-2">Bookings</h3>
      <p class="text-gray-600 mb-4">View and manage guest reservations.</p>
      <%= link_to "View all bookings", hotel_bookings_path, class: "text-blue-600 font-medium hover:underline" %>
    </div>

    <!-- Inventory & Rates -->
    <div class="bg-white border border-gray-200 rounded-xl p-6 shadow-sm">
      <h3 class="text-lg font-semibold text-gray-800 mb-2">Inventory & Rates</h3>
      <p class="text-gray-600 mb-4">Update room quantities and nightly prices.</p>
      <%= link_to "Manage Room Types", hotel_room_types_path, class: "text-blue-600 font-medium hover:underline block mb-1" %>
      <%= link_to "View Audit Logs", hotel_inventory_audit_logs_path, class: "text-blue-600 font-medium hover:underline" %>
    </div>

    <!-- Arrival Manifest -->
    <div class="bg-white border border-gray-200 rounded-xl p-6 shadow-sm">
      <h3 class="text-lg font-semibold text-gray-800 mb-2">Arrival Manifest</h3>
      <p class="text-gray-600 mb-4">Track pre-check-in and guest arrivals.</p>
      <%= link_to "Arrivals view", hotel_arrivals_path, class: "text-blue-600 font-medium hover:underline" %>
    </div>
    <!-- Financial Reports -->
    <div class="bg-white border border-gray-200 rounded-xl p-6 shadow-sm">
      <h3 class="text-lg font-semibold text-gray-800 mb-2">Financial Reports</h3>
      <p class="text-gray-600 mb-4">Review your earnings and booking activity.</p>
      <%= link_to "View financial reports", hotel_reports_path, class: "text-blue-600 font-medium hover:underline block mb-1" %>
      <%= link_to "Help Center", help_center_path, class: "text-green-600 font-medium hover:underline" %>
    </div>
  </div>
</div>
